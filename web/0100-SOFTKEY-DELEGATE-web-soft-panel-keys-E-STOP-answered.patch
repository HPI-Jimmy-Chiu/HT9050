From fa24243e017b13dae537ee6cae70b4e455fa9c1b Mon Sep 17 00:00:00 2001
From: "HT9045 Machine (V906)" <Claude_RDBC_02@honprec.com>
Date: Sat, 3 Oct 2026 16:45:32 +0800
Subject: [PATCH] SOFTKEY-DELEGATE (web): soft panel keys / E-STOP answered by
 one document-level capture listener (closest('#softEStop, #softKeys
 [data-key]')) -- in the HMI the per-button listeners bound at load did not
 survive the area being re-rendered, so no panel.key ever reached wb_serve
 while the page's other buttons did (EastSun 1003 'still cannot press');
 tested: buttons re-rendered then clicked -> each sent once

---
 page/ht9045_main_softkeys.js | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/page/ht9045_main_softkeys.js b/page/ht9045_main_softkeys.js
index b353253..c77d80e 100644
--- a/page/ht9045_main_softkeys.js
+++ b/page/ht9045_main_softkeys.js
@@ -83,5 +83,16 @@
   }
   if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bind, { once: true });
   else bind();
+  // AI(W906-SOFTKEY-DELEGATE) 20261003: EastSun「一樣不能按」-- in the HMI the main page's other buttons reach wb_serve but not one
+  //   panel.key did: the per-button listeners bound at load do not survive the area being re-rendered later.  One document-level
+  //   listener (capture) answers every soft key / E-STOP however often that area is rebuilt; the per-button listener of an element that
+  //   still has it is skipped via the event's own flag, so a click is never sent twice.
+  document.addEventListener('click', function (ev) {
+    var t = ev.target && ev.target.closest ? ev.target.closest('#softEStop, #softKeys [data-key]') : null;
+    if (!t) return;
+    ev.stopPropagation();                                            // the element's own listener (if still bound) must not send it again
+    if (t.id === 'softEStop') estop();
+    else press(t.getAttribute('data-key'), t.textContent.trim());
+  }, true);
   window.HT9045MainSoftKeys = { press: press, estop: estop };
 })();
