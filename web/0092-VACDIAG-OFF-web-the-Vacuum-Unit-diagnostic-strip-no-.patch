From e4261d41c055daf8719b7fbc964f058de074ad44 Mon Sep 17 00:00:00 2001
From: "HT9045 Machine (V906)" <Claude_RDBC_02@honprec.com>
Date: Sat, 3 Oct 2026 11:48:24 +0800
Subject: [PATCH] VACDIAG-OFF (web): the Vacuum Unit diagnostic strip no longer
 covers the page -- off unless the page is opened with ?vudiag=1 (EastSun 1003
 'it covers the screen, change it back, never cover the screen')

---
 page/ht9045_vacuumunit_c.js | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/page/ht9045_vacuumunit_c.js b/page/ht9045_vacuumunit_c.js
index 96e0c39..50408ed 100644
--- a/page/ht9045_vacuumunit_c.js
+++ b/page/ht9045_vacuumunit_c.js
@@ -237,6 +237,9 @@
   //   Switch a nozzle's suction on and watch which value moves. Click the strip to fold it.
   function renderDiag(s) {
     var d = document.getElementById('vuDiag');
+    // AI(W906-VACDIAG-OFF) 20261003: EastSun「檔到畫面了啦 快點改回來 嚴禁檔到畫面」-- the strip covered the panels. It is now OFF on the
+    //   page: shown only when the page itself is opened with ?vudiag=1 (a separate browser tab, not the HMI window).
+    if (!/[?&]vudiag=1\b/.test(location.search)) { if (d && d.parentNode) d.parentNode.removeChild(d); return; }
     if (!d) {
       d = document.createElement('div');
       d.id = 'vuDiag';
-- 
