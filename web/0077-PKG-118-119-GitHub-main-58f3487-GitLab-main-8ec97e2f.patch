 page/ht9045_testerif_c_wire.js | 35 ++++++++++++++++++++++++++++++----
 1 file changed, 31 insertions(+), 4 deletions(-)

diff --git a/page/ht9045_testerif_c_wire.js b/page/ht9045_testerif_c_wire.js
index 3da646a..e8df15f 100644
--- a/page/ht9045_testerif_c_wire.js
+++ b/page/ht9045_testerif_c_wire.js
@@ -279,7 +279,8 @@
                dioPreview: LAST && LAST.extra ? (LAST.extra.dioPreview || []).length : 0 };   // AI(W906-Q41) 20260927
     },
     showPageControl2: showPageControl2, applyEditable: applyEditable,
-    dioTypeChange: dioTypeChange, testerTcpShow: testerTcpShow, w6Rs232InGpib: w6Rs232InGpib   // AI(W906-Q41) 20260927
+    dioTypeChange: dioTypeChange, testerTcpShow: testerTcpShow, w6Rs232InGpib: w6Rs232InGpib,   // AI(W906-Q41) 20260927
+    vtest: function () { return !!(LAST && LAST.extra && LAST.extra.vtest); }   // AI(W906-TIF-KB) 20261002: IniConfig.bVTESTFunction (block (8))
   };
 })();
 
@@ -289,8 +290,9 @@
  * are customer branches:
  *   edInitialMaxTestClick (:1380-1403) -- OnClick of edMaxTestTime / edInitialMaxTest and their _RT / _EQC copies
  *     (cTesterIF.dfm:2348 / :2366 / :3100 / :3118 / :3380 / :3398): generated INTEGER 60..9999 = CC_ASE_M (:1384);
- *     generic = N_DOUBLE, 2, true, 0, 15000 (:1401).  IniConfig.bVTESTFunction (:1395-1398, 0..36000) is not sent to the
- *     page yet (claim for St01's FileRW extra pending) -- until then the generic branch.
+ *     generic = N_DOUBLE, 2, true, 0, 15000 (:1401).  IniConfig.bVTESTFunction (:1395-1398): N_DOUBLE, 2, true, 0, 36000
+ *     -- the server sends it as editlist.get extra.vtest (FileRW/TestIF_File_TesterIF.cpp:236, St01 OK f86cd74c); the
+ *     keyboards are bound before that answer arrives, so the VTEST range is chosen when the keyboard opens (below).
  *   edtInitStartDelayClick (:1410-1416) -- edtInitStartDelay / _RT / _EQC (dfm :2403 / :3155 / :3435): generated
  *     DOUBLE 2 30..3000 = HiSilicon + CC_ASE_KaohSiung (:1412-1413); generic = N_DOUBLE, 2, false (:1415, no range).
  *   CC_AMKOR_Korea / CC_SCK (:1386-1390) and CC_GIGAS (:1391-1394) are S25 (customer branches, not ported).
@@ -319,5 +321,30 @@
       Object.keys(GOLDEN_KB).forEach(function (id) { kb[id] = GOLDEN_KB[id].slice(); applied.push(id); });
     }
   }
-  window.HT9045TesterIfKb = { golden: GOLDEN_KB, applied: applied };   // probe / ctest TIF_KbGolden
+  // VTEST (golden :1395-1398): when the last editlist.get said extra.vtest, the six max-test-time fields open the keyboard
+  //   with 0..36000.  A capture-phase mousedown runs before the engine's own handler on the field and takes over only then;
+  //   otherwise the engine opens it with the generic entry above.  Same opening as ht9045_wire_engine.js attachKeyboards
+  //   (preventDefault, then input + change after OK).  The other golden branches before VTEST are S25 (customer).
+  var VTEST_IDS = ['edMaxTestTime', 'edMaxTestTime_RT', 'edMaxTestTime_EQC', 'edInitialMaxTest', 'edInitialMaxTest_RT', 'edInitialMaxTest_EQC'];
+  var VTEST_KB = ['DOUBLE', 2, true, 0, 36000];
+  function vtestOn() { var C = window.HT9045TesterIfC; return !!(C && typeof C.vtest === 'function' && C.vtest()); }
+  document.addEventListener('mousedown', function (ev) {
+    var el = ev && ev.target;
+    if (!el || !el.id || VTEST_IDS.indexOf(el.id) < 0 || el.disabled || !vtestOn()) return;
+    var Q = window.HTQwerty;
+    if (!Q || !Q.show) return;
+    ev.preventDefault();
+    ev.stopPropagation();                             // the engine's listener on the field does not open a second keyboard
+    Q.show(el, (Q.N && Q.N[VTEST_KB[0]]) || 0, {
+      dp: VTEST_KB[1], checkRange: VTEST_KB[2], min: VTEST_KB[3], max: VTEST_KB[4],
+      onCommit: function () {
+        ['input', 'change'].forEach(function (evn) {
+          var e2;
+          try { e2 = new Event(evn, { bubbles: true }); } catch (x) { e2 = document.createEvent('Event'); e2.initEvent(evn, true, true); }
+          el.dispatchEvent(e2);
+        });
+      }
+    });
+  }, true);
+  window.HT9045TesterIfKb = { golden: GOLDEN_KB, applied: applied, vtest: VTEST_KB };   // probe / ctest TIF_KbGolden
 })();
