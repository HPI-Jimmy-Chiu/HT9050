From 925369156e6eb581b6c40eb2ab3184ff4466c920 Mon Sep 17 00:00:00 2001
From: "HT9045 Machine (V906)" <Claude_RDBC_02@honprec.com>
Date: Fri, 2 Oct 2026 14:05:16 +0800
Subject: [PATCH] GRIDKB (web): Motor Database / IO Table cells open golden's
 keypad again (INTEGER / DOUBLE / NO_SYMBOL), not the full QWERTY

The grid engine's gridFlags() returned the whole rule ['GearRatio','DOUBLE'] and both callers read flagBits(rule[0]) = the column name, so every
cell got flags 0 (full QWERTY, 0.0.071425 can be typed -- M37 MColorZ has exactly that GearRatio today; atof reads it as 0.0) and 'DOUBLE'
was taken as dp.  gridFlags now returns [flags, dp, checkRange, min, max].  Checked all 29 Mot_Table columns and the IO Table columns
against golden uMotorTest.cpp:2219-2233 (Motorname/Alias/CardModel NO_SYMBOL|NO_SPACE, GearRatio/Acc/Dec DOUBLE, the rest INTEGER): 29/29 + 5/5.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 page/ht9045_wire_engine.js | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/page/ht9045_wire_engine.js b/page/ht9045_wire_engine.js
index 921dc39..3190535 100644
--- a/page/ht9045_wire_engine.js
+++ b/page/ht9045_wire_engine.js
@@ -735,9 +735,12 @@
     var rules = (CFG.sysGrid && CFG.sysGrid.kb) || [], i, r, dflt = null;
     for (i = 0; i < rules.length; i++) {
       r = rules[i];
-      if (r[0] === '*') { dflt = r; continue; }
-      if (String(col).indexOf(r[0]) >= 0) return r;       // golden AnsiPos 子字串語意
+      if (r[0] === '*') { dflt = r.slice(1); continue; }
+      if (String(col).indexOf(r[0]) >= 0) return r.slice(1);   // golden AnsiPos 子字串語意
     }
+    //AI(W906-GRIDKB) 20261002: 回傳 [flags, dp, checkRange, min, max]（去掉規則開頭的欄名）。原本回整條 ['GearRatio','DOUBLE']，
+    //  呼叫端 flagBits(rule[0]) 拿到的是欄名 → flags 一律 0，Motor Database／IO Table 每一格都開完整 QWERTY（golden uMotorTest.cpp:2219-2233
+    //  數字欄是 N_INTEGER／N_DOUBLE），而且 'DOUBLE' 被當成 dp。
     return dflt || ['INTEGER', 0, false, 0, 0];
   }
   function flagBits(names) {
