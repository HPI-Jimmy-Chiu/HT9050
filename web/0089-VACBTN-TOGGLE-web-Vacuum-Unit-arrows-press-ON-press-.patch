From 289fc48a840fe7943c2273b2f77fda42c97bd662 Mon Sep 17 00:00:00 2001
From: "HT9045 Machine (V906)" <Claude_RDBC_02@honprec.com>
Date: Sat, 3 Oct 2026 09:44:01 +0800
Subject: [PATCH] VACBTN-TOGGLE (web): Vacuum Unit arrows -- press = ON, press
 again = OFF (golden btnVaccumOnOffOnClick); a double click / a touch panel's
 second click within 0.7 s no longer switches it straight back OFF, and ON is
 drawn pressed (inset border), not only lighter blue -- EastSun 1003

---
 page/ht9045_vacuumunit_c.js | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/page/ht9045_vacuumunit_c.js b/page/ht9045_vacuumunit_c.js
index a220f35..de46599 100644
--- a/page/ht9045_vacuumunit_c.js
+++ b/page/ht9045_vacuumunit_c.js
@@ -226,6 +226,7 @@
     el = plain(el);
     if (!el) return;
     el.style.background = v === true ? ON_BG : v === false ? OFF_BG : NA_BG;
+    el.style.border = v === true ? '2px inset #fff' : '2px outset #fff';   // AI(W906-VACBTN-TOGGLE) 20261003: ON looks pressed (golden TBtnPanelLane Down), not only a lighter blue -- EastSun pressed again because it "did nothing"
     el.dataset.down = v === true ? '1' : '0';
     el.style.opacity = locked ? '0.55' : '1';
   }
@@ -412,6 +413,7 @@
     press('vacuum.reset', {}, 'Reset（golden sbResetClick）');
   }
 
+  var VU_LASTPRESS = {};   // AI(W906-VACBTN-TOGGLE) 20261003: last accepted arrow press per <panel>_<on|off>
   // capture 階段、掛在 document：比面板自己的 toggle 與頁面內建的 .btnpanel 監聽都先執行，並攔下它們（同 ht9045_io_do.js）
   document.addEventListener('click', function (e) {
     if (e.defaultPrevented || document.body.classList.contains('layoutEdit') || document.body.classList.contains('layoutPlace')) return;
@@ -430,6 +432,14 @@
     if (!hit) return;
     e.stopPropagation(); e.preventDefault();
     var el = hit === 'on' ? $(gb.id + '_bplOn') : hit === 'off' ? $(gb.id + '_bplOff') : hit === 'set' ? panelSetBtn(gb) : $(hit);
+    // AI(W906-VACBTN-TOGGLE) 20261003: EastSun「往上的箭頭觸發是真空ON 關掉是OFF，往下箭頭觸發是破真空ON 沒觸發是OFF」(press = ON, press again = OFF,
+    //   golden btnVaccumOnOffOnClick). The op log showed every press followed 0.44-0.53 s later by a second one (a double click / a touch
+    //   panel firing twice) that switched the output straight back OFF. One toggle per 0.7 s per arrow; the second click of a double click is dropped.
+    if (hit === 'on' || hit === 'off') {
+      var lk = gb.id + '_' + hit;                                        // keyed by id: paintBpl's plain() may swap the element for a clone
+      if (e.detail > 1 || Date.now() - (VU_LASTPRESS[lk] || 0) < 700) return;
+      VU_LASTPRESS[lk] = Date.now();
+    }
     if (el && el.__vuLocked) { var w = el.__vuWhy || '這顆鈕目前不能按'; sayNow(w.indexOf('🔒') === 0 ? w : '🔒 ' + w, '#ffcc66'); return; }
     if (hit === 'on' || hit === 'off') onBpl(gb, hit);
     else if (hit === 'set') onSet(gb);
-- 
