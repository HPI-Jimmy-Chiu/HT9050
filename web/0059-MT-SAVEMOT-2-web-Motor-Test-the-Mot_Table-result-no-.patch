+    setInfo(t.map(function(s){ return s.trim(); }).join('　'), ch.length ? 'ok' : 'warn');
     if(ack.cur && typeof ack.cur==='object' && req.motors && req.motors[0]===curMotorId()) renderSettingsGrid(req.motors[0], ack.cur);
     gridRefresh=2;
