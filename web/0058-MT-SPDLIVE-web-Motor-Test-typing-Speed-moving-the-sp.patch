From e509570a144b26f810a8fb16557ba997e27b6cfd Mon Sep 17 00:00:00 2001
From: "HT9045 Machine (V906)" <Claude_RDBC_02@honprec.com>
Date: Thu, 1 Oct 2026 21:20:46 +0800
Subject: [PATCH] MT-SPDLIVE (web): Motor Test -- typing Speed (%) = moving the
 speed bar to it: the bar follows and setSpeed{jog:true} goes out, so the next
 JOG runs at the typed % (changed from golden's PTP-only edtSpeedChange,
 EastSun 1001)

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 page/HW.MotorTest.html | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/page/HW.MotorTest.html b/page/HW.MotorTest.html
index 75013cb..fad1eb8 100644
--- a/page/HW.MotorTest.html
+++ b/page/HW.MotorTest.html
@@ -1891,7 +1891,16 @@ document.querySelectorAll('.traypos').forEach(function(ph){
       es.setAttribute('data-acc','1');
       es.addEventListener('change', function(){
         if(selectedIndex===-1) return;
-        sendSpeed(parseInt(es.value,10)||0, false);
+        // AI(W906-MT-SPDLIVE) 20261001：EastSun「當我百分比速度有變動時 請要直接改速度 不然每次我按第二次 JOG 速度都不一樣」——
+        //   跟 golden 不同：打 Speed（%）＝拉捲軸到同一格：捲軸跟著移、送 setSpeed{jog:true}（點位＋jog 都設），下一次 JOG 就是這個 %。
+        //   golden edtSpeedChange 只設點位速度、捲軸不動，JOG 照舊用捲軸的 % —— 畫面上兩個 % 不一樣、JOG 跟打的值不一樣。
+        //   HOME 進行中照 golden 捲軸的規則不送（C++ 也會擋）。
+        var v=parseInt(es.value,10); if(isNaN(v)) return;
+        v=v<1?1:(v>100?100:v);
+        var sb=$id('scrlbrMotorSpeed'); if(sb) sb.value=String(v);
+        if(homeRunning()) return;
+        spdLastSent=v;
+        sendSpeed(v, true);
       });
     })();
     // btnRange / btnRate：BCB6 只做 UpdateMotorParameter()
-- 
2.55.0.windows.5

