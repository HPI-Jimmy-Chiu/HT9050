---
 background.html              | 2 +-
 page/ht9045_main_close.js    | 6 +++++-
 page/ht9045_recipe_client.js | 3 ++-
 3 files changed, 8 insertions(+), 3 deletions(-)

diff --git a/background.html b/background.html
index cb229ea..721924b 100644
--- a/background.html
+++ b/background.html
@@ -1263,7 +1263,7 @@ function refreshGuardUi(){
 //   通過後 wb_serve 關站，最後通知程式視窗自己關掉。回 'exit'＝已交給 Exit；'none'＝主畫面還沒載入（程式視窗就直接關）。
 window.HT9045ShellCloseRequest=function(){
   try{
-    var conn=false; try{ conn=!!(window.HT9045Recipe && HT9045Recipe.status().connected); }catch(e){}
+    var conn=false; try{ var rs=window.HT9045Recipe && HT9045Recipe.status(); conn=!!(rs && (rs.live!==undefined ? rs.live : rs.connected)); }catch(e){}   // AI(W906-HMICLOSE) 20261006 (NB2-2, Jimmy 1006 10:5x「網頁如果已經發生斷線，應該要能夠關閉的」): live, not connected -- since RECONNECT-A (ht9045_link.js 20261005) connected stays true while the hub reconnects to a wb_serve that is gone, so this answered 'exit' and the HMI window waited for a quit message that never came
     if(!conn) return 'none';                                   // 程式（wb_serve）已經不在：沒有 Exit 可走，程式視窗直接關
     var mw=document.getElementById('win-main'), mf=mw&&mw.querySelector('iframe'), cw=mf&&mf.contentWindow;
     if(cw && cw.HT9045MainClose && typeof cw.HT9045MainClose.close==='function'){ cw.HT9045MainClose.close({answers:[true,true]}); return 'exit'; }
diff --git a/page/ht9045_main_close.js b/page/ht9045_main_close.js
index 8e0d0a3..a799066 100644
--- a/page/ht9045_main_close.js
+++ b/page/ht9045_main_close.js
@@ -94,7 +94,7 @@
   }
   function recipeConnected() {
     var s = (window.HT9045Recipe && typeof HT9045Recipe.status === 'function') ? HT9045Recipe.status() : null;
-    return !!(s && s.connected);
+    return !!(s && (s.live !== undefined ? s.live : s.connected));   // AI(W906-HMICLOSE) 20261006 (NB2-2): live, not connected -- since RECONNECT-A (ht9045_link.js 20261005) connected stays true while the hub reconnects, so after wb_serve closed this page never showed 已結束 (it said 60 秒了連線還沒關)
   }
   function mkBtn(text, css) {
     var b = el('button', 'margin:6px 8px 0 0;padding:6px 14px;font-size:15px;cursor:pointer;' + (css || ''), text);
@@ -350,6 +350,10 @@
       return Promise.resolve({ executed: false, guard: 'closing-local' });
     }
     if (busy || Date.now() < coolUntil) return Promise.resolve({ executed: false, guard: 'busy-local' });
+    if (window.HT9045Recipe && typeof HT9045Recipe.status === 'function' && HT9045Recipe.status().live === false) {   // AI(W906-HMICLOSE) 20261006 (NB2-2, Jimmy 1006 10:5x「網頁如果已經發生斷線，應該要能夠關閉的」): wb_serve is gone (or not answering) -- nothing to close on its side; the commands below would only come back "失敗" one after another. Say so and let the window be closed.
+      if (!(opts && opts.answers)) alert('與 wb_serve 的連線已經中斷（程式已經結束或沒有回應），沒有東西需要關。\n直接關閉這個視窗即可；要再操作，請重新啟動 wb_serve。');
+      return Promise.resolve({ executed: false, guard: 'link-down' });
+    }
     var b = $('sbCloseProgram');
     var answers = (opts && opts.answers) ? opts.answers.slice() : null;
     function ask(r, fallback) {
diff --git a/page/ht9045_recipe_client.js b/page/ht9045_recipe_client.js
index a0ac507..ad23d80 100644
--- a/page/ht9045_recipe_client.js
+++ b/page/ht9045_recipe_client.js
@@ -584,7 +584,8 @@
     rawCmd: function (name, extra) { return cmd(name, extra); },
 
     status: function () {
-      return {connected: !!(sock && sock.readyState === 1), holdsToken: haveToken};
+      return {connected: !!(sock && sock.readyState === 1), holdsToken: haveToken,
+              live: !!(sock && sock.readyState === 1 && sock.linkState !== 'reconnecting')};   // AI(W906-HMICLOSE) 20261006 (NB2-2, Jimmy 1006 10:5x「網頁如果已經發生斷線，應該要能夠關閉的」): connected stays OPEN while the frame's hub reconnects (ht9045_link.js AI(W906-J11-RECONNECT-A) 20261005 keeps readyState OPEN, the real state is linkState) -- live = really connected now, for "is wb_serve still there" questions (background.html HT9045ShellCloseRequest, ht9045_main_close.js)
     },
 
     // =======================================================================
