diff --git a/page/HW.teach.html b/page/HW.teach.html
index 6877998..3b40b1b 100644
--- a/page/HW.teach.html
+++ b/page/HW.teach.html
@@ -861,13 +861,13 @@ function teachBindMotionButtons(cat){
     if(!teachEditPtr){ teachSetInfo('SetToOffset: 先按一個教導點的 Set 或 Go（golden 的 EditPtr）', 'warn'); return; }
     var e=document.getElementById(teachEditPtr), o=document.getElementById('edtSetToOffset');
     // AI(W906-KB-GOLDEN) 20261004 (2/2): the box is golden's ReadOnly edtSetToOffset (uteach.dfm:1243-1256, no keypad now), filled only
-    //   by a finished HOME (teachFillSetToOffset, golden Timer1Timer :1395 / :1402). Golden copies it unconditionally (:2202), so an
-    //   empty box (no HOME yet) leaves an empty teach point that the next Save stores as atoi('')=0. Kept as golden (refusing it would
-    //   change golden behaviour -- NIGHT_REPORT s0 #103 asks Jimmy); the status line warns when the copied text is empty.
-    var t=o?String(o.value):'';
-    if(e){ e.value=t; e.setAttribute('data-src','cpp-pos'); }   // C++ 的 LastHomePos（golden 同：EditPtr->Text=edtSetToOffset->Text）
-    if(!/^-?\d+$/.test(t.trim())) teachSetInfo('SetToOffset: Reset Offset 是空的（還沒對這一軸按 HOME）—— 照 golden 寫進 '+teachEditPtr+'，存檔會變 0；先按 HOME 再 SetToOffset', 'warn');
-    HTMotorAccess.send('btnSetToOffset',{offset:teachNum('edtSetToOffset',0)});
+    //   by a finished HOME (teachFillSetToOffset, golden Timer1Timer :1395 / :1402). Golden copies it unconditionally (:2202).
+    //   AI(W906-ST02-C23) 20261006 (St02-E): DEVIATION FROM GOLDEN by ruling -- RULINGS_20261005 #23 #103 = B + Steven 1005 23:5x「馬達未歸零的時候，不允許set」:
+    //   refused (nothing copied, nothing sent) while the selected motor's HOME is not done (runtime homeFlag != 1) or the box is empty. STALE: the 1004 "kept as golden, warns" (s0 #103 is answered)
+    var t=o?String(o.value):'', rtA=teachRuntimeById(teachActiveMotorId), cA=(rtA && rtA.cur) || {}, dA=(rtA && rtA.diag) || {}, hf=(typeof cA.homeFlag==='number') ? cA.homeFlag : ((typeof dA.homeFlag==='number') ? dA.homeFlag : null);   // the same HomeFlag teachFillSetToOffset reads (1 done / 2 failed)
+    if(!teachActiveMotorId || hf!==1){ teachSetInfo('SetToOffset: '+(teachActiveMotorId || '（沒有選軸）')+' 還沒回原點（HOME 沒做完）—— 不抄、不送；先對這一軸按 HOME 再 SetToOffset', 'err'); return; }   // AI(W906-ST02-C23): Steven's guard
+    if(!/^-?\d+$/.test(t.trim())){ teachSetInfo('SetToOffset: Reset Offset 是空的（這一軸在教導頁還沒按過 HOME）—— 不抄、不送；先對這一軸按 HOME 再 SetToOffset', 'err'); return; }   // AI(W906-ST02-C23): #103 = B (an empty box would have been saved as atoi('')=0)
+    if(e){ e.value=t; e.setAttribute('data-src','cpp-pos'); }   HTMotorAccess.send('btnSetToOffset',{offset:teachNum('edtSetToOffset',0)});   // C++ 的 LastHomePos（golden 同：EditPtr->Text=edtSetToOffset->Text）
   });
 }
