From 6c1d8b53e50a8bc6afa978df2925beead7e86a0e Mon Sep 17 00:00:00 2001
From: "HT9045 Machine (V906)" <Claude_RDBC_02@honprec.com>
Date: Wed, 30 Sep 2026 16:49:46 +0800
Subject: [PATCH] VACUNIT-MENU (web): Tools -> Vacuum Adj. opens the Vacuum
 Unit window, shown by golden's VacuUnitType rule

EastSun 20260930: VacuUnitType set to 1; Tools must open the Vacuum Unit.
golden main.dfm sbVacuumUnit ('Vacuum Adj.') -> sbVacuumUnitClick ->
fVacuumUnit->Show() (main.cpp:34405-34408), visible only when
VCCU_UNIT_TYPE (Gerneral.ini [System] VacuUnitType, database.cpp:1628) != 0
(main.cpp:23624, after spbTrayMapping). The web menu never had the item.
- main.html: the item, DFM_MAP -> background window 'vacuumunit'
  (page/HW.VacuumUnit.html), and the visibility rule read live from
  /api/system/gerneral. If the value cannot be read the item is shown as
  ruleoff (grey) with the reason in data-rule, never silently hidden.
- ht9045_menu_icons.js: a suction-cup icon so the column stays aligned.
Offline check (faked /api/system/gerneral): 1 -> shown, 0 -> hidden,
404 -> grey with reason; click posts {open:'vacuumunit'}.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 page/ht9045_menu_icons.js |  7 +++++++
 page/main.html            | 29 ++++++++++++++++++++++++++++-
 2 files changed, 35 insertions(+), 1 deletion(-)

diff --git a/page/ht9045_menu_icons.js b/page/ht9045_menu_icons.js
index 52d141d..3643ec3 100644
--- a/page/ht9045_menu_icons.js
+++ b/page/ht9045_menu_icons.js
@@ -151,6 +151,13 @@
                       '<rect x="3" y="14.5" width="18" height="7" rx="1.2"/>' +
                       '<path d="M9 14.5v7M15 14.5v7"/>'),
 
+    // Vacuum Adj.：吸嘴（上方管子＋下方吸盤）＋右上真空錶  // AI(W906-VACUNIT-MENU) 20260930
+    sbVacuumUnit: S('<path d="M9 3h4v6H9z"/>' +
+                    '<path d="M11 9v3M5 17c0-2.8 2.7-5 6-5s6 2.2 6 5z"/>' +
+                    '<path d="M4 20h14"/>' +
+                    '<circle cx="18.5" cy="6.5" r="3"/>' +
+                    '<path d="M18.5 6.5l1.4-1.4"/>'),
+
     // 1203 Setting：EtherCAT 卡 —— 三個互連的節點
     sbPci1203Setting: S('<circle cx="12" cy="5" r="3"/>' +
                         '<circle cx="4.5" cy="19" r="3"/>' +
diff --git a/page/main.html b/page/main.html
index 9da8135..c54b51f 100644
--- a/page/main.html
+++ b/page/main.html
@@ -98,6 +98,10 @@
     <div class="smi" title="spbLaser">Laser</div>
     <div class="smi" title="spbAutoRetest">Auto Retest</div>
     <div class="smi" title="spbTrayMapping">Tray Function</div>
+    <!-- AI(W906-VACUNIT-MENU) 20260930：EastSun「我需要tool 可以開啟此項目」—— golden main.dfm sbVacuumUnit（Caption 'Vacuum Adj.'）
+         → sbVacuumUnitClick → fVacuumUnit->Show()（main.cpp:34405-34408）。golden 只在 VCCU_UNIT_TYPE（Gerneral.ini [System] VacuUnitType）
+         不是 0 時顯示（main.cpp:23624 SBPtr 表，排在 spbTrayMapping 後面）；顯示規則在檔尾 VACUNIT-MENU 那段。 -->
+    <div class="smi" id="sbVacuumUnit" title="sbVacuumUnit">Vacuum Adj.</div>
     <!-- AI(W906-IOWEB-P29) 20260925: 使用者 20260925「把 D 槽 1203 資料夾的 1203 設定頁面加進主畫面 Tools」。
          ⚠ 這**不是** golden 的選單項（main.dfm 沒有 sbPci1203Setting）—— 它開的是 EastSun 的
          web/pci1203.html（PCIE-1203 監看／控制頁），走跟其他項目完全一樣的路：
@@ -334,7 +338,8 @@ var DFM_MAP={sbSelete:'countersel',sbClear:'counterclear',sbBuilder:'builder',
   spbAutoRetest:'sckart',sbYield:'yieldmon',sbPlateForm:'hotplate',
   sbSetup:'setup',sbStartMode:'startcond',sbTempOffset:'tempset',sbBin:'binsel',sbTeaching:'teach',sbMotorTest:'motortest',sbHomeMonitor:'home',sbTrayAssign:'trayassign',
   // AI(W906-IOWEB-P29) 20260925: Tools ▾ → 1203 Setting → background 視窗 'pci1203'（EastSun 的 pci1203.html，非 golden 表單）
-  sbPci1203Setting:'pci1203'};
+  sbPci1203Setting:'pci1203',
+  sbVacuumUnit:'vacuumunit'};   // AI(W906-VACUNIT-MENU) 20260930：Tools ▾ → Vacuum Adj. → background 視窗 'vacuumunit'（page/HW.VacuumUnit.html）
 // 元件 id：release 版 title 被移到 data-htitle，統一由此取得（分派邏輯不受 mode 影響）
 function comp(el){return el.getAttribute('title')||el.getAttribute('data-htitle')||'';}
 // 轉換狀態標色：shot=僅有實機截圖（未 dfm 轉換）、todo=尚無任何頁面
@@ -610,6 +615,28 @@ document.querySelectorAll('#palConfig .smi').forEach(function(el){
 <script src="ht9045_wire_engine.js"></script>
 <script src="ht9045_wire_main.js"></script>
 <script src="ht9045_nonstop_alarm.js"></script>
+<script>
+/* AI(W906-VACUNIT-MENU) 20260930：Tools 的 Vacuum Adj. 照 golden 顯示規則 —— main.cpp:23624 {sbVacuumUnit, VCCU_UNIT_TYPE}：
+ *   VCCU_UNIT_TYPE＝CheckAndReadIniDataGeneral("System","VacuUnitType",0)（database.cpp:1628，int；讀不成數字＝0）。0 ⇒ Visible=false。
+ *   值從 wb_serve /api/system/gerneral 即時讀（同 ht9045_wire_livesettings.js 的來源）。讀不到時不靜默藏起來：
+ *   照 livesettings 的原則顯示成 ruleoff（灰字＋⛔）並把原因放在 title，操作員看得到「這裡有東西但狀態不明」。 */
+(function(){
+  var mi=document.getElementById('sbVacuumUnit'); if(!mi) return;
+  mi.style.display='none';
+  function unknown(why){
+    // title／data-htitle 不動：它是 comp() 查 DFM_MAP 的鍵，改了就開不了視窗；原因放 data-rule
+    mi.style.display=''; mi.classList.add('ruleoff'); mi.setAttribute('data-rule','讀不到 Gerneral.ini [System] VacuUnitType：'+why);
+  }
+  if(!window.HT9045System || !HT9045System.read){ unknown('HT9045System 不存在'); return; }
+  HT9045System.read('gerneral').then(function(d){
+    var e=d && d.available!==false && d.sections && d.sections.System ? d.sections.System.VacuUnitType : undefined;
+    var v=(e && typeof e==='object' && 'value' in e) ? e.value : e;
+    if(v===undefined || v===null){ unknown('Gerneral.ini 沒有這個鍵'); return; }
+    var n=parseInt(String(v),10); if(isNaN(n)) n=0;
+    mi.style.display=(n!==0)?'':'none';
+  }).catch(function(e){ unknown((e && e.message) || String(e)); });
+})();
+</script>
 <script src="ht9045_busy_util.js"></script><!-- AI(W906-CMDGUARD-UI) 20260926（Steven 團隊）：伺服器 busy: 回覆的共用判斷，下面兩段（換配方、登入）用 --><script src="ht9045_main_close.js"></script><script src="ht9045_main_st01_ev.js"></script><!-- AI(W906-EVB6) 20260928 [W906]：主畫面圖示／按鈕／Site 格事件（批次 B6＋B9，WS act.main.*；本體 FileRW/MainClick.cpp 檔尾）；接在同一行，不移動行號 --><!-- AI(W906-PROD-S95) 20260926（Steven 團隊）：Exit 鈕 sbCloseProgram＝golden sbCloseProgramClick → FormClose 生產資料段（WS act.main.closeProgram；存完不關站）；接在同一行，不移動行號 -->
 <script>
 /* AI(W906-PROD-S112) 20260926（Steven 團隊）：狀態列時鐘改用機台的時間（tag clock.text），不再用瀏覽器自己的時鐘。
