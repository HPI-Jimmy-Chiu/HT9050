From e92353852d76ff29d31dc59855c09d6fd529d06c Mon Sep 17 00:00:00 2001
From: "HT9045 Machine (V906)" <Claude_RDBC_02@honprec.com>
Date: Wed, 30 Sep 2026 21:10:28 +0800
Subject: [PATCH] NOOVERLAP-A (web): Speed, Handler System and Security
 overlaps removed (golden aligns, lpLeft labels)

EastSun 20260930: overlapping controls are not allowed.
- Setup.Speed.html (21 -> 0): the 19 TLabeledEdit labels are
  LabelPosition=lpLeft / LabelSpacing=3 in golden (cSpeed.dfm:4026..),
  so they now sit left of the edit instead of 13px above it; Panel1 is
  alBottom (bottom:0, full width); palInArmLeft is alLeft (full sheet
  height) so the layout-base offsets no longer push gbInArmCylinderDelay
  out of it.
- HW.HandlerSys.html (27 -> 1): Panel3 alBottom; pnlLoader1 alLeft full
  height; Label30 hidden (a form TLabel under the alClient Panel2, never
  visible in golden); rgIOCard has 5 rows for its 5 items; compact 12px
  radios; rgCustomerList rows fit their 1fr share (216 items, 72 rows).
  Left: pnlLoader6 is an empty borderless alLeft panel that golden clips
  the same way (1125+210 > 1254).
- Status.Security.html (7 -> 6): RichEditJamCode is alBottom. Left: the
  6 MySecurity panels cut at the TScrollBox edge are scrolled content.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 page/HW.HandlerSys.html   | 17 ++++++++++++++++-
 page/Setup.Speed.html     |  5 ++++-
 page/Status.Security.html |  2 +-
 3 files changed, 21 insertions(+), 3 deletions(-)

diff --git a/page/HW.HandlerSys.html b/page/HW.HandlerSys.html
index fbcc8a7..1fcf4f0 100644
--- a/page/HW.HandlerSys.html
+++ b/page/HW.HandlerSys.html
@@ -49,11 +49,26 @@
   .lled{box-sizing:border-box;}
   .lled:hover{outline:1px dotted var(--gbx-border,#9aa);outline-offset:1px;}
   .lledCap{line-height:1.3;}
+  /* AI(W906-NOOVERLAP) 20260930：EastSun「很多頁面都有重疊的情況 這是不被允許的」——
+     (1) 瀏覽器預設 radio 是 13px＋上下 3px 邊界，rgRotateKit_Type（7 項塞 124px 內框）、rgMagBinDispType 等最後一項
+         被擠出 RadioGroup 下框；改成跟 .ckb 一樣的緊湊排法（12px 圓鈕、13px 行高，同 HW.MotorTest.html）。
+     (2) Label30「NUDN1 qty」是 HandlerSystem 表單本身的 TLabel（HandlerSys.dfm:23），被 alClient 的 Panel2 整個蓋住，
+         golden 畫面上看不到；網頁把它畫在頁籤內容底下，一換頁就跟 Sub-model 等選項疊在一起 → 同 golden 不顯示。 */
+  .rg .rgi{display:flex;align-items:center;line-height:13px;}
+  .rg .rgi input{flex:none;margin:0 4px 0 1px;width:12px;height:12px;}
+  #Label30{display:none;}
+  /* AI(W906-NOOVERLAP) 20260930：rgCustomerList（HandlerSys.dfm，Columns=3、alClient）216 項＝72 列，golden 每列只有 797/72≈11px；
+     網頁 11px 字＋radio 的最小行高撐破 1fr，最後一列掉出框外、被頁面裁掉 → 列高鎖在 1fr 之內（10px 字、行高 11px、10px 圓鈕），
+     72 列剛好放進框內（11px 字的中文＋下伸字母墨跡 13px，比 11.6px 列距高，會壓到上下列）；
+     每項 overflow:hidden 同 VCL（每顆 TRadioButton 是自己的視窗，字比列高還高時裁在自己框內）。 */
+  #rgCustomerList .cli{grid-template-rows:repeat(72,minmax(0,1fr)) !important;}
+  #rgCustomerList .rgi{font-size:10px;line-height:11px;overflow:hidden;}
+  #rgCustomerList .rgi input{width:10px;height:10px;}
 </style>
 </head>
