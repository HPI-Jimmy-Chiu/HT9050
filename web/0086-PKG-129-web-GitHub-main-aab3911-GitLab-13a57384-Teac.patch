+      .then(function () { return raw('act.lotInfo.' + op, { value: JSON.stringify(v) }).then(unwrap, function (e) { return parseErr(e); }); })
+      .then(function (r) { return release().then(function () { return r; }); });
+  }
+  function describe(r) {
