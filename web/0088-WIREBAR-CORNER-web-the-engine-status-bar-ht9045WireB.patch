From 8ea4d5be22914b9d391d003b797206449329aaf9 Mon Sep 17 00:00:00 2001
From: "HT9045 Machine (V906)" <Claude_RDBC_02@honprec.com>
Date: Sat, 3 Oct 2026 09:42:07 +0800
Subject: [PATCH] WIREBAR-CORNER (web): the engine status bar (#ht9045WireBar,
 44 pages) moves to a small bottom-right box and a clean read hides after 6 s
 -- EastSun 1003 'this box covers what I need to see, move it where it does
 not block'

---
 page/ht9045_wire_engine.js | 3 ++-
 page/theme.css             | 7 ++++++-
 2 files changed, 8 insertions(+), 2 deletions(-)

diff --git a/page/ht9045_wire_engine.js b/page/ht9045_wire_engine.js
index 3190535..dfd54da 100644
--- a/page/ht9045_wire_engine.js
+++ b/page/ht9045_wire_engine.js
@@ -1250,7 +1250,8 @@
       var unf = Object.keys(GB_UNFILL); if (unf.length) lines.push('❌ 填不進畫面的值 (' + unf.length + ')：' + unf.map(function (k) { return k + ' ' + GB_UNFILL[k]; }).join('；') + '\n   → 這一頁目前不能存檔（存了會把畫面上的預設值寫回檔案）');   // AI(W906-R33) 20260926
       if (miss.length) lines.push('⚠ 頁面上沒有的 id (' + miss.length + ')：' + miss.slice(0, 40).join(', ') + (miss.length > 40 ? ' ...' : ''));
       if (prefix) lines.unshift(prefix, '— 重讀 —');
-      say(lines.join('\n'), prefixColour || ((mustMiss.length || unf.length) ? '#ffcc66' : '#9f9'));
+      say(lines.join('\n'), prefixColour || ((mustMiss.length || unf.length) ? '#ffcc66' : '#9f9'),
+          (prefix || mustMiss.length || unf.length || miss.length) ? 'sticky' : 'transient');   // AI(W906-WIREBAR-CORNER) 20261003: a clean read hides after 6 s (EastSun「擋到我看的位子」); ❌ / ⚠ / save results stay until ×
       return d;
     }, function (e) {
       say('❌ C 路讀取失敗（editlist.get ' + st + '）：' + e.message + tokenHint(e.message), '#f88');   // AI(W906-SCREEN-TOKEN) 20261001: tokenHint
diff --git a/page/theme.css b/page/theme.css
index 411a282..8f4c505 100644
--- a/page/theme.css
+++ b/page/theme.css
@@ -195,7 +195,12 @@ code{background:var(--code-bg,#eef1f6);border-color:var(--code-border,#dfe3ec);c
 /* AI(W906-WIREBAR-THRU) 20261001：EastSun「圖片上的擋到視窗了 我很難操控」—— 開頁的「✓ 讀取完成（C 路…）」狀態條（#ht9045WireBar，
    引擎與七支頁面補件各自建同一個 id，fixed 在右上角）蓋住頁籤與按鈕。改成滑鼠點穿（底下照樣能按），只有右邊的 × 收得起來。
    訊息照樣顯示、照樣自動收（startup／transient 6 秒；錯誤照舊不自動收）。 */
-#ht9045WireBar{pointer-events:none!important;opacity:.92;}
+/* AI(W906-WIREBAR-CORNER) 20261003：EastSun「你這視窗都擋到我看的位子了 你可以把這視窗移到不會擋到的地方嗎」—— 點穿還是看不到底下的字，
+   改放右下角的小框（限寬 420px、高最多 30vh），避開 Teach 頁右下 bottom:6px 的小標籤（HW.teach.html:159）。
+   !important 才蓋得過引擎與七支補件 bar() 的 inline cssText（top:8px;left:614px;right:8px）。 */
+#ht9045WireBar{pointer-events:none!important;opacity:.85;
+  top:auto!important;left:auto!important;right:8px!important;bottom:28px!important;
+  width:auto!important;max-width:420px!important;min-width:0!important;max-height:30vh!important;}
 #ht9045WireBar>span{pointer-events:auto!important;cursor:pointer;}
 /* AI(W906-CLIPFIX) 20261001：GroupBox 標題（legend）。產生器頁的 <style> 都寫 .gbx legend{top:-2px;line-height:12px}，11px 字的字框約 15px，
    字框上緣比 GroupBox 上緣高約 3.5px —— GroupBox 貼在 TabSheet／面板最上面（Top=0）時被 .pcPane 等的 overflow:hidden 切掉約 4px
-- 
2.55.0.windows.5

