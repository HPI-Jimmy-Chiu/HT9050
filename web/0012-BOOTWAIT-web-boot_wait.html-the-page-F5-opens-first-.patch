From 7090832b2cdbcccea273f5943d7cb1f2909f58cf Mon Sep 17 00:00:00 2001
From: "HT9045 Machine (V906)" <Claude_RDBC_02@honprec.com>
Date: Tue, 29 Sep 2026 18:16:59 +0800
Subject: [PATCH] BOOTWAIT (web): boot_wait.html -- the page F5 opens first; it
 switches to the HMI when wb_serve answers

See the C++ commit BOOTWAIT (.vscode tasks/launch). file:// page, no server needed to show it; ?port= / ?target= for tests.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 boot_wait.html | 99 ++++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 99 insertions(+)
 create mode 100644 boot_wait.html

diff --git a/boot_wait.html b/boot_wait.html
new file mode 100644
index 0000000..5dc5ebb
--- /dev/null
+++ b/boot_wait.html
@@ -0,0 +1,99 @@
+<!DOCTYPE html>
+<html lang="zh-Hant">
+<head>
+<meta charset="utf-8">
+<title>HT9050 軟體啟動中</title>
+<!--
+  AI(W906-BOOTWAIT) 20260929: EastSun「軟體開起來時 請你先把操作頁面HTML 開起來 不然我按F5後 又等你非常久 才會把畫面開起來
+  我根本不知道軟體有沒有執行」。
+  F5 的前置步驟第一件事就用 file:// 開這一頁（.vscode/tasks.json「IOWEB(這台): 開啟等待畫面」），然後才編譯、啟動 wb_serve。
+  這一頁每秒問一次 http://127.0.0.1:<port>/，一回應就切到操作畫面（原本 launch.json 的 serverReadyAction 要等 wb_serve 開機
+  約 1 分鐘、印出網址才開瀏覽器，那段時間什麼都看不到）。
+  ?port=8055（預設）、?target=<網址>（預設 http://127.0.0.1:<port>/background.html?mode=debug&machine=HT9050）—— 測試用。
+  偵測方式：fetch(no-cors) 能連上就算起來了（讀不到內容沒關係）；另外用一張 web 裡本來就有的圖當備援。
+  頁面一打開就已經有東西回應 ⇒ 多半是上一次的 wb_serve 沒關（新的那支會綁不到 8055），先警告、不立刻切過去。
+-->
+<style>
+  :root { --bg:#eef2f5; --fg:#1f2d3a; --muted:#5a6b7a; --card:#ffffff; --line:#c9d3dc; --ok:#1d7a3a; --warn:#a15c00; --bad:#b00020; --accent:#517b91; }
+  @media (prefers-color-scheme: dark) { :root { --bg:#1b2126; --fg:#e6edf3; --muted:#9fb0bf; --card:#242c33; --line:#37424c; --ok:#5cc27e; --warn:#e0a24a; --bad:#ff6b7f; --accent:#7fb0c8; } }
+  html,body { margin:0; height:100%; background:var(--bg); color:var(--fg); font-family:"Microsoft JhengHei","Segoe UI",sans-serif; }
+  .wrap { max-width:720px; margin:0 auto; padding:48px 16px; }
+  .card { background:var(--card); border:1px solid var(--line); border-radius:10px; padding:28px 28px 22px; }
+  h1 { margin:0 0 6px; font-size:26px; }
+  .sub { color:var(--muted); margin:0 0 22px; }
+  .big { font-size:44px; font-weight:bold; font-variant-numeric:tabular-nums; letter-spacing:1px; }
+  .state { margin-top:14px; font-size:18px; }
+  .state.ok { color:var(--ok); } .state.warn { color:var(--warn); } .state.bad { color:var(--bad); }
+  .bar { height:6px; background:var(--line); border-radius:3px; overflow:hidden; margin:18px 0 6px; }
+  .bar > i { display:block; height:100%; width:30%; background:var(--accent); animation:run 1.4s linear infinite; }
+  @keyframes run { from { margin-left:-30%; } to { margin-left:100%; } }
+  ul { margin:18px 0 0; padding-left:20px; color:var(--muted); line-height:1.7; }
+  a { color:var(--accent); }
+  button { margin-top:16px; font-size:15px; padding:6px 14px; }
+</style>
+</head>
+<body>
+<div class="wrap">
+  <div class="card">
+    <h1>HT9050 軟體啟動中</h1>
+    <p class="sub">F5 已經按下：先編譯、再啟動 wb_serve。伺服器一回應，這一頁會自動切到操作畫面。</p>
+    <div class="big" id="elapsed">0 秒</div>
+    <div class="bar"><i></i></div>
+    <div class="state" id="state">等待伺服器回應…</div>
+    <ul>
+      <li>平常大約 1～1.5 分鐘（讀設定、建立畫面、開 1203 卡）；有改程式時要先編譯，會更久。</li>
+      <li><b>編譯中不要關掉程式或 VS Code</b>，檔案會寫壞（0929 的 libht9045_sm.a 就是這樣）。</li>
+      <li>超過 3 分鐘還沒好：看 VS Code 是否跳出「preLaunchTask 錯誤」，或下方「偵錯主控台」的最後幾行。</li>
+      <li>要直接開：<a id="direct" href="#">操作畫面</a></li>
+    </ul>
+    <button id="go" style="display:none">切到操作畫面</button>
+  </div>
+</div>
+<script>
+(function () {
+  var q = {};
+  location.search.replace(/^\?/, '').split('&').forEach(function (kv) { if (kv) { var i = kv.indexOf('='); q[decodeURIComponent(i < 0 ? kv : kv.slice(0, i))] = i < 0 ? '' : decodeURIComponent(kv.slice(i + 1)); } });
+  var port = /^\d{2,5}$/.test(q.port || '') ? q.port : '8055';
+  var base = 'http://127.0.0.1:' + port + '/';
+  var target = q.target || (base + 'background.html?mode=debug&machine=HT9050');
+  var t0 = Date.now(), done = false, polls = 0;
+  var elEl = document.getElementById('elapsed'), stEl = document.getElementById('state'), goEl = document.getElementById('go');
+  document.getElementById('direct').href = target;
+  document.title = 'HT9050 軟體啟動中';
+
+  function say(text, cls) { stEl.textContent = text; stEl.className = 'state' + (cls ? ' ' + cls : ''); }
+  function secs() { return Math.floor((Date.now() - t0) / 1000); }
+  function tick() {
+    if (done) return;
+    var s = secs();
+    elEl.textContent = (s >= 60 ? Math.floor(s / 60) + ' 分 ' + (s % 60) + ' 秒' : s + ' 秒');
+    if (s >= 180) say('已經超過 3 分鐘還沒回應：請看 VS Code 有沒有跳出錯誤，或偵錯主控台的最後幾行。', 'bad');
+  }
+  function jump() { done = true; say('伺服器已回應，切換到操作畫面…', 'ok'); location.replace(target); }
+  function up() {
+    if (done) return;
+    if (secs() < 3 && polls <= 2) {
+      done = true;
+      say('一打開就已經有程式在 ' + port + ' 回應：可能是上一次的 wb_serve 沒有關（新的會綁不到這個埠）。確認後再按下面的按鈕。', 'warn');
+      goEl.style.display = ''; goEl.onclick = function () { location.replace(target); };
+      return;
+    }
+    jump();
+  }
+  function probe() {
+    if (done) return;
+    polls++;
+    var fired = false;
+    function once() { if (!fired) { fired = true; up(); } }
+    try { fetch(base + '?bootwait=' + Date.now(), { mode: 'no-cors', cache: 'no-store' }).then(once, function () {}); } catch (e) {}
+    var img = new Image();                                          // 備援：web 裡本來就有的檔
+    img.onload = once;
+    img.src = base + 'img/homemode/MODE2_Lmt.png?bootwait=' + Date.now();
+  }
+  setInterval(tick, 250);
+  probe();
+  setInterval(probe, 1000);
+})();
+</script>
+</body>
+</html>
-- 
