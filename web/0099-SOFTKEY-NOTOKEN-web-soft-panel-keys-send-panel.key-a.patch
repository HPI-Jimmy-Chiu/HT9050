From 1912c0dcce929dbb04e5dfbcd871afb1abd8f594 Mon Sep 17 00:00:00 2001
From: "HT9045 Machine (V906)" <Claude_RDBC_02@honprec.com>
Date: Sat, 3 Oct 2026 16:41:29 +0800
Subject: [PATCH] SOFTKEY-NOTOKEN (web): soft panel keys send panel.key at once
 (no keepAlive / control.acquire step that could hang with holdsToken=false),
 show 'sending...' immediately and a 3 s no-reply note -- EastSun 1003

---
 page/ht9045_main_softkeys.js | 13 ++++++++-----
 1 file changed, 8 insertions(+), 5 deletions(-)

diff --git a/page/ht9045_main_softkeys.js b/page/ht9045_main_softkeys.js
index e5d0095..b353253 100644
--- a/page/ht9045_main_softkeys.js
+++ b/page/ht9045_main_softkeys.js
@@ -34,10 +34,13 @@
     if (BUSY[key]) { msg(label + '：上一下還在處理，這一下略過', 'warn'); return; }
     if (COOL[key] && now < COOL[key]) return;                       // 400 ms 內的第二下（雙擊）
     BUSY[key] = true;
-    var took = false;
-    var st = R.status ? R.status() : null;
-    var pre = (st && !st.holdsToken && R.keepAlive) ? R.keepAlive().then(function () { took = true; }, function () {}) : Promise.resolve();
-    pre.then(function () { return R.rawCmd('panel.key', { value: key }); })
+    // AI(W906-SOFTKEY-NOTOKEN) 20261003: EastSun「沒反映啦 我感覺點不下去」-- the live page had holdsToken=false, so every press first waited
+    //   for keepAlive (control.acquire) and only then sent; when that never settled, nothing was sent and the line stayed blank.  A panel
+    //   key is a press, like the E-STOP: sent at once (the server is token-exempt for it), with immediate feedback and a 3 s no-reply note.
+    msg(label + '：送出中…', 'warn');
+    var answered = false;
+    var to = setTimeout(function () { if (!answered) { BUSY[key] = false; msg(label + '：3 秒沒有回覆（wb_serve 有在跑嗎？）', 'err'); } }, 3000);
+    R.rawCmd('panel.key', { value: key })
       .then(function (m) {
         var d = (m && (m.detail || m.message)) || '';
         msg(label + '：已送出' + (d ? '（' + d + '）' : ''), 'ok');
@@ -45,9 +48,9 @@
         msg(label + '：沒有送出 —— ' + detailOf(e), 'err');
       })
       .then(function () {
+        answered = true; clearTimeout(to);
         BUSY[key] = false;
         COOL[key] = Date.now() + COOL_MS;
-        if (took && R.release) { var s2 = R.status ? R.status() : null; if (s2 && s2.holdsToken) R.release().catch(function () {}); }
       });
   }
 
-- 
