From d758607564fb5d7a792b5e81419ae05990ae5761 Mon Sep 17 00:00:00 2001
From: "HT9045 Machine (V906)" <Claude_RDBC_02@honprec.com>
Date: Thu, 1 Oct 2026 23:43:27 +0800
Subject: [PATCH] HOMEMON (web): Home Monitor is live -- the 33 hard-coded mock
 rows are gone; rows, lamps, positions, the log and Panel2 come from golden's
 runtime TfHome (home.* tags), and Abort Home runs golden sbAbortHomeClick

* page/ht9045_home_c.js (new): builds the rows with HTWidgets.makeHomeRow at golden's positions (uhome.cpp:61-104 labName /
  edPos / lamp; ShowLed :664-680 lime / red / yellow, clSilver off) from home.rows, the ListBox1 log from home.log (newest
  first), Panel2 from home.resetOk; Abort Home sends act.home.abort at once -- no confirm box (golden has none), no token --
  and is locked only when home.fShow is explicitly false.
* page/HW.home.html: the mock rows removed; loads ht9045_recipe_client.js + ht9045_home_c.js.
* background.html: MODAL_POLICY.home modeless (golden case 20 uhome.cpp:2368 is fHome->Show(), not ShowModal) and not full
  screen, so PAUSE / START stay usable while homing.
C++ side: machine commit 37117e3 (JsonBridge/ChanHome, act.home.abort only while fHome->fShow).

Verified: page scripts syntax OK (background.html #6 is a "<script>" inside an HTML comment, same in the original).

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 background.html       |   3 +-
 page/HW.home.html     |   4 +-
 page/ht9045_home_c.js | 216 ++++++++++++++++++++++++++++++++++++++++++
 3 files changed, 221 insertions(+), 2 deletions(-)
 create mode 100644 page/ht9045_home_c.js

diff --git a/background.html b/background.html
index e56bf59..ff0c2a8 100644
--- a/background.html
+++ b/background.html
@@ -584,7 +584,7 @@ var MODAL_POLICY={
   motortest:   {level:1},                      // 政策表 #2  疊在 teach 之上 uteach.cpp:2442
   io:          {level:0},                      // 政策表 #3  比 golden 嚴格，見 §3.2
   contact:     {level:0, onlyWhenContactMode:true},  // 政策表 #4  僅 iContactMode!=0
-  home:        {level:0},                      // 政策表 #5  ⚠ 入口歸屬未決，見 §3.4
+  home:        {level:0, modeless:true},       // 政策表 #5  ⚠ 入口歸屬未決，見 §3.4   //AI(W906-HOMEMON) 20261001: modeless -- golden 用 fHome->Show() 叫出 Home Monitor（uhome.cpp:2368，非 ShowModal），回原點時主畫面的 PAUSE／START 照樣按得到（PAUSE 中止回原點＝MainProc 停機臂 fHome->sbAbortHomeClick）；所以不全螢幕、不 inert 其他視窗（isFullscreenFor）。操作員自己開的守衛（decideOpen）不變
   shuttlemove: {level:0, needEmpty:true}       // 政策表 #6  兩道守衛 main.cpp:33658
 };
 
@@ -638,6 +638,7 @@ function contactIsExclusive(){
 function isFullscreenFor(id){
   var p=MODAL_POLICY[id];
   if(!p) return false;
+  if(p.modeless) return false;   //AI(W906-HOMEMON) 20261001: home（golden Show()，非 ShowModal）
   if(p.onlyWhenContactMode) return contactIsExclusive();
   return true;
 }
