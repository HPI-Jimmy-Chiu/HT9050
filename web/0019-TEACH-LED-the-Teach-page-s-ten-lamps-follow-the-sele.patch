EastSun 20260930: "你這頁面是不是有很多功能都還沒完善? 我看燈號就都沒對上". golden ScanNowMotorStatus (uteach.cpp:1349-1350)
sets pLed[0..9] = MOT[ActiveMotorIndex].Led[0..9] every Timer1, all off when ActiveMotorIndex==-1 (:1326-1329); the page
only updated Now Position. teachScanNow now also paints ALed1..10 from the runtime's state.led (the same Led[0..9] that
Motor Test shows: CW, HOME, CCW, EMG Stop, Alarm, Soft CW, Soft CCW, Servo Alarm, InPos, Servo On), and teachSelectNone
turns them off. Checked: the page loads headless without script errors.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 page/HW.teach.html | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/page/HW.teach.html b/page/HW.teach.html
index 6c959b9..433ec5a 100644
--- a/page/HW.teach.html
+++ b/page/HW.teach.html
@@ -336,6 +336,21 @@ function teachScanNow(id){
   var enc=document.getElementById('pnlEncoderPos');
   if(np) np.value=(pos.cmdPos!=null?String(pos.cmdPos):'—');
   if(enc) enc.textContent=(pos.encPos!=null?String(pos.encPos):'—');
+  teachSetLeds(teachRuntimeLive ? ((teachRuntimeById(id).state||{}).led) : null);   // AI(W906-TEACH-LED) 20260930
+}
+// AI(W906-TEACH-LED) 20260930：EastSun「我看燈號就都沒對上」—— golden ScanNowMotorStatus（uteach.cpp:1349-1350）
+//   `for(i<10) pLed[i]->Value=MOT[ActiveMotorIndex].Led[i];`，ActiveMotorIndex==-1 時全滅（:1326-1329）。原本這頁只更新位置，燈永遠是灰的。
+//   C++ runtime 的 state.led 就是同一組 Led[0..9]（JsonBridge/ChanMotorPoints.cpp，1203 軸照 TMyEtherCatMotor::ScanMotorStatus 解），
+//   與 HW.MotorTest.html setLeds 同一個順序：CW、HOME、CCW、EMG Stop、Alarm、Soft CW、Soft CCW、Servo Alarm、InPos、Servo On。
+//   null（沒有樣本）＝顯示「不知道」，不是「沒亮」。
+var TEACH_LED_KEYS=['cw','home','ccw','emg','alarm','softCw','softCcw','sAlarm','inPos','servoOn'];
+function teachSetLeds(led){
+  for(var i=0;i<TEACH_LED_KEYS.length;i++){
+    var el=document.getElementById('ALed'+(i+1)); if(!el) continue;
+    var v=led?led[TEACH_LED_KEYS[i]]:null;
+    el.classList.toggle('on', v===true);
+    el.classList.toggle('unknown', led!==undefined && led!==null && typeof v!=='boolean');
+  }
 }
 // 對應 UpdateMotorTeachMonitor：Panel2=NumberAlias、edtSpeed=1
 function teachUpdateMotorMonitor(id){
@@ -361,6 +376,7 @@ function teachSelectNone(){
   var p2=document.getElementById('Panel2'); if(p2) p2.textContent='';
   var np=document.getElementById('edtNowPosition'); if(np) np.value='—';
   var enc=document.getElementById('pnlEncoderPos'); if(enc) enc.textContent='—';
+  teachSetLeds(null);                                // AI(W906-TEACH-LED) 20260930：golden :1326-1329 ActiveMotorIndex==-1 ⇒ 10 顆全滅
 }
 function teachAttachMotorButtons(){
   var nodes=document.querySelectorAll('[title]');
