From 627eeeb5f9a6d78527050b3082849f6b2d53c20d Mon Sep 17 00:00:00 2001
From: "HT9045 Machine (V906)" <Claude_RDBC_02@honprec.com>
Date: Wed, 30 Sep 2026 08:59:50 +0800
Subject: [PATCH] TEACH-SEL / TEACH-UNWIRED (web): the Teach page's motor
 buttons bind in release mode; controls that do nothing are greyed with a
 reason
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

EastSun 20260930: "你這頁面是不是有很多功能都還沒完善? 我看燈號就都沒對上".
- Motor select buttons: teachAttachMotorButtons matched only `title`, but theme.js (release, the background window's default)
  moves every title to data-htitle at DOMContentLoaded, before the motor table loads -> 0 buttons bound, the right panel
  stayed on M00. Now reads title or data-htitle (same as HW.MotorTest.html:295 htitle()); the Set/Go lookup too.
- Buttons whose axis is not in the C++ motor table (this machine: 58 of 106) are greyed, not hidden, and a click says
  which axis is missing. Selecting an Enable=0 axis says JOG/Move/HOME will be refused.
- MotorInRotateKit/MotorInRA/MotorOutRotateKit/MotorOutRA: golden selects motor #41/#42 (uteach.cpp:830-831, :846, :854);
  this machine's M41/M42 are aliased MInRotate/MOutRotate, so an alias miss falls back to the golden number. The other
  60 alias misses were checked: their numbers are not in this Mot_Table either.
- Greyed with a reason on click: BtnPanelLane1-3 (Suck On/Off, Tray X U/D -- golden drives IO, the page only changed
  colour; no longer toggles), btnIO, btnAutoTeachZ (ruling: not wired, FileRW/Zteach.cpp:19-20), ScrollBar1.
- Lamps: no sample now shows the "unknown" hatch; only golden's ActiveMotorIndex==-1 turns all ten off.
Headless Edge against a fake /api/struct/motor from this machine's Mot_Table, ?mode=release: inline scripts parse;
48 buttons bound (was 0), 64 marked; lamps HOME + Servo On lit for the sample. Not yet clicked on the machine.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 page/HW.teach.html | 85 +++++++++++++++++++++++++++++++++++++++++-----
 1 file changed, 76 insertions(+), 9 deletions(-)

diff --git a/page/HW.teach.html b/page/HW.teach.html
index 433ec5a..907b2d9 100644
--- a/page/HW.teach.html
+++ b/page/HW.teach.html
@@ -110,7 +110,11 @@ document.querySelectorAll('.exitbtn').forEach(function(b){
   });
 });
 // TBtnPanel/TBtnPanelLane：點擊切換 Down（=SetPanelStatus）
+// AI(W906-TEACH-UNWIRED) 20260930：這頁的 .btnpanel 只有 Tray Arm 頁的 BtnPanelLane1-3（Suck On／Suck Off／Tray X U/D），
+//   golden（uteach.cpp:3074-3129）按下去會直接 IOBitOn/Off；網頁沒接 IO，只變色 —— 看起來像吸了、其實沒動。
+//   不再切換 Down（不假裝有動作），由 teachMarkUnwired 灰掉並在點擊時說明。
 document.querySelectorAll('.btnpanel').forEach(function(b){
+  if(/^BtnPanelLane[123]$/.test(b.id)) return;
   b.addEventListener('click',function(){b.classList.toggle('down');});
 });
 // TTMyTray：以 hwidgets 模板建格盤
@@ -158,6 +162,34 @@ function teachSetInfo(msg, cls){
   else { el.style.background='#f4f4f4'; el.style.color='#333'; }
 }
 
+// AI(W906-TEACH-UNWIRED) 20260930：EastSun「你這頁面是不是有很多功能都還沒完善?」—— 看得到、按了什麼都不發生的元件，
+//   一律灰掉（不藏：藏掉的東西沒有人會發現它本來該在），點下去在右下角說明原因。只是畫面標記，不送任何命令。
+var TEACH_UNWIRED_CSS='.teach-unwired{opacity:.4 !important;filter:grayscale(1);cursor:not-allowed !important;}';
+function teachUnwiredStyle(){
+  if(document.getElementById('teachUnwiredCss')) return;
+  var st=document.createElement('style'); st.id='teachUnwiredCss'; st.textContent=TEACH_UNWIRED_CSS;
+  document.head.appendChild(st);
+}
+function teachMarkUnwiredEl(el, why){
+  if(!el || el.getAttribute('data-unwired')) return;
+  teachUnwiredStyle();
+  el.classList.add('teach-unwired');
+  el.setAttribute('data-unwired', why);
+  el.addEventListener('click', function(ev){ ev.stopImmediatePropagation(); teachSetInfo(why, 'warn'); }, true);
+}
+var TEACH_UNWIRED=[
+  ['BtnPanelLane1','Suck On：golden 會直接開吸嘴 IO，網頁還沒接 IO，按了不會吸。要吸請到 IO 頁操作'],
+  ['BtnPanelLane2','Suck Off：golden 會直接關吸嘴 IO，網頁還沒接 IO。要關請到 IO 頁操作'],
+  ['BtnPanelLane3','Tray X U/D：golden 會直接切 Tray X 上下 IO，網頁還沒接 IO。要動請到 IO 頁操作'],
+  ['btnIO','IO Check：還沒接（golden 會開 IO 視窗）。請從主選單開 IO 頁'],
+  ['btnAutoTeachZ','Auto Teach Z：自動教導 Z 會讓機台自己動，依裁決這版不接（FileRW/Zteach.cpp:19-20）'],
+  ['ScrollBar1','Speed Adjust 捲軸還沒接 —— 請直接改上面的 Now Speed 欄位']
+];
+function teachMarkUnwired(){
+  for(var i=0;i<TEACH_UNWIRED.length;i++) teachMarkUnwiredEl(document.getElementById(TEACH_UNWIRED[i][0]), TEACH_UNWIRED[i][1]);
+}
+if(document.readyState==='loading') document.addEventListener('DOMContentLoaded', teachMarkUnwired); else teachMarkUnwired();
+
 function teachDelay(ms){ return new Promise(function(r){ setTimeout(r, ms); }); }
 function teachHttpGetText(url){
   return new Promise(function(resolve,reject){
@@ -303,7 +335,18 @@ var TEACH_MOTOR_BTN_MAP={
   MotorInSh2LtcZ1:'MInSh2LtcSenZ1', MotorInSh2LtcZ2:'MInSh2LtcSenZ2'
 };
 function teachPad2(n){ return (n<10?'0':'')+n; }
-function teachResolveMotorId(name){ return TEACH_MOTOR_BTN_MAP[name] || ('M'+name.slice(5)); }
+// AI(W906-TEACH-SEL) 20260930：golden 的選取鈕指的是馬達「編號」（uteach.cpp:830-831、:846、:854 TECH_MotorAxle(MInRotateKit=41, …)），
+//   網頁用別名找。這台 M41／M42 的別名是 MInRotate／MOutRotate（不是 MInRotateKit）—— 別名找不到時照 golden 的編號找
+//   （cmydef.cpp:2376-2377）。20260930 對過其餘 60 個找不到的別名：編號在這台的 Mot_Table 都不存在，只有這兩個會撞到。
+var TEACH_MOTOR_NUM={ MInRotateKit:41, MOutRotateKit:42 };
+function teachResolveMotorId(name){
+  var id=TEACH_MOTOR_BTN_MAP[name] || ('M'+name.slice(5));
+  if(!teachMotorById(id) && TEACH_MOTOR_NUM[id]!=null && teachMotorConfig && teachMotorConfig.motors){
+    for(var i=0;i<teachMotorConfig.motors.length;i++)
+      if(teachMotorConfig.motors[i].motorIndex===TEACH_MOTOR_NUM[id]) return teachMotorConfig.motors[i].motorId;
+  }
+  return id;
+}
 function teachMotorById(id){
   if(!teachMotorConfig || !teachMotorConfig.motors) return null;
   for(var i=0;i<teachMotorConfig.motors.length;i++)
@@ -342,14 +385,16 @@ function teachScanNow(id){
 //   `for(i<10) pLed[i]->Value=MOT[ActiveMotorIndex].Led[i];`，ActiveMotorIndex==-1 時全滅（:1326-1329）。原本這頁只更新位置，燈永遠是灰的。
 //   C++ runtime 的 state.led 就是同一組 Led[0..9]（JsonBridge/ChanMotorPoints.cpp，1203 軸照 TMyEtherCatMotor::ScanMotorStatus 解），
 //   與 HW.MotorTest.html setLeds 同一個順序：CW、HOME、CCW、EMG Stop、Alarm、Soft CW、Soft CCW、Servo Alarm、InPos、Servo On。
-//   null（沒有樣本）＝顯示「不知道」，不是「沒亮」。
+//   led==='none'（golden ActiveMotorIndex==-1）＝全滅；沒有樣本（runtime 讀不到、那一軸沒有 led、某一顆不是 true/false）
+//   ＝斜線「不知道」，不是「沒亮」—— 原本這兩種都畫成熄滅，讀不到跟「確定沒觸發」看起來一樣。
 var TEACH_LED_KEYS=['cw','home','ccw','emg','alarm','softCw','softCcw','sAlarm','inPos','servoOn'];
 function teachSetLeds(led){
+  var none=(led==='none');
   for(var i=0;i<TEACH_LED_KEYS.length;i++){
     var el=document.getElementById('ALed'+(i+1)); if(!el) continue;
-    var v=led?led[TEACH_LED_KEYS[i]]:null;
+    var v=(led && !none)?led[TEACH_LED_KEYS[i]]:null;
     el.classList.toggle('on', v===true);
-    el.classList.toggle('unknown', led!==undefined && led!==null && typeof v!=='boolean');
+    el.classList.toggle('unknown', !none && typeof v!=='boolean');
   }
 }
 // 對應 UpdateMotorTeachMonitor：Panel2=NumberAlias、edtSpeed=1
@@ -369,6 +414,7 @@ function teachSelectMotor(id, fromGolden){
   teachActiveMotorId=id;
   teachUpdateMotorMonitor(id);
   if(!fromGolden) teachSpeedPending=1;
+  if(teachMotorEnabled(id)===false) teachSetInfo(id+'：這一軸在馬達表是 Enable=0，JOG／Move／HOME 會被拒絕', 'warn');   // AI(W906-TEACH-SEL) 20260930
 }
 // golden ActiveMotorIndex 變成 -1（C++ 回 activeMotor ""）：golden ScanNowMotorStatus 在 -1 時不顯示位置
 function teachSelectNone(){
@@ -376,20 +422,41 @@ function teachSelectNone(){
   var p2=document.getElementById('Panel2'); if(p2) p2.textContent='';
   var np=document.getElementById('edtNowPosition'); if(np) np.value='—';
   var enc=document.getElementById('pnlEncoderPos'); if(enc) enc.textContent='—';
-  teachSetLeds(null);                                // AI(W906-TEACH-LED) 20260930：golden :1326-1329 ActiveMotorIndex==-1 ⇒ 10 顆全滅
+  teachSetLeds('none');                              // AI(W906-TEACH-LED) 20260930：golden :1326-1329 ActiveMotorIndex==-1 ⇒ 10 顆全滅
 }
+// AI(W906-TEACH-SEL) 20260930：release 版 theme.js 在 DOMContentLoaded 就把 title 搬到 data-htitle（theme.js:13-24），
+//   而這裡是在馬達表載入之後才跑 ⇒ 只看 title 的話一顆馬達鈕都綁不到，點了沒反應、右邊永遠停在 M00。
+//   同 HW.MotorTest.html:295 的 htitle()：兩個屬性都看。
+function teachHTitle(el){ return el.getAttribute('title')||el.getAttribute('data-htitle')||''; }
 function teachAttachMotorButtons(){
-  var nodes=document.querySelectorAll('[title]');
+  var nodes=document.querySelectorAll('[title],[data-htitle]');
   for(var i=0;i<nodes.length;i++){
-    var t=nodes[i].getAttribute('title')||'';
+    var t=teachHTitle(nodes[i]);
     var m=/^(Motor[A-Za-z0-9]+) : TSpeedButton/.exec(t);
     if(!m) continue;
+    // AI(W906-TEACH-SEL) 20260930：這台 Mot_Table 沒有的軸（C++ 載入的馬達表裡找不到）——golden FormShow 在這台多半是藏起來的，
+    //   網頁照 .dfm 全部顯示，點了什麼都不發生。灰掉＋點擊說明（20260930 實測 106 顆裡 45 顆是這種）。只看 C++ 的表，不寫死清單。
+    var mid=teachResolveMotorId(m[1]);
+    if(teachMotorConfig && teachMotorConfig.motors && !teachMotorById(mid)){
+      teachMarkUnwiredEl(nodes[i], m[1]+'：這台的馬達表（Mot_Table）沒有 '+mid+' 這一軸，無法選取');
+      continue;
+    }
+    if(nodes[i].getAttribute('data-motor-bound')) continue;          // bind() 可能跑兩次（C++ 讀不到退回靜態檔）
+    nodes[i].setAttribute('data-motor-bound','1');
     (function(name, el){
       el.style.cursor='pointer';
       el.addEventListener('click',function(){ teachSelectMotor(teachResolveMotorId(name)); });
     })(m[1], nodes[i]);
   }
 }
+// AI(W906-TEACH-SEL) 20260930：Enable=0 的軸（這台是 MN200／SMC 那些）golden 選得到、動作由 C++ 拒絕（WebMotorAccess.cpp「Enable=0」）；
+//   選到的時候先講清楚，免得按了 JOG 才發現。enable 取 C++ runtime 的 cur.enable，沒有才看馬達表的 Enable 欄（同 HW.MotorTest.html motorEnabled）。
+function teachMotorEnabled(id){
+  var rt=teachRuntimeById(id), c=(rt && rt.cur && typeof rt.cur==='object')?rt.cur:null;
+  if(c && typeof c.enable==='boolean') return c.enable;
+  var mo=teachMotorById(id);
+  return mo && typeof mo.enabledByDefault==='boolean' ? mo.enabledByDefault : null;
+}
 // AI(W906-W5-b) 20260925：W5B-7 —— 比照 W4-c 的 HW.MotorTest.html（:211-217）：由 wb_serve 供應時先讀 C++ 實際載入的馬達表與
 //   MOT[]／1203 監看器的即時值（/api/struct/motor/config|runtime）。原本讀 ../JSON/Motor-runtime.json：wb_serve 不供應這個路徑
 //   （worktree 沒有這個檔 ⇒ Promise.all 失敗、.catch 吞掉 ⇒ teachInitAccess 從不執行、運動鈕一個都沒綁；部署目錄有的是
@@ -639,9 +706,9 @@ function teachOnAck(req, ack, err){
 function teachBindTechButtons(){
   var pts=(teachAccessPoints&&teachAccessPoints.techPoints)||[];
   function elByTitle(name){
-    var nodes=document.querySelectorAll('[title]');
+    var nodes=document.querySelectorAll('[title],[data-htitle]');   // AI(W906-TEACH-SEL) 20260930：release 版 title 在 data-htitle
     for(var i=0;i<nodes.length;i++){
-      var t=nodes[i].getAttribute('title')||'';
+      var t=teachHTitle(nodes[i]);
       if(t.split(' :')[0]===name) return nodes[i];
     }
     return document.getElementById(name);
-- 
