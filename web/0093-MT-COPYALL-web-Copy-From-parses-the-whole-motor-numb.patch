From d444bf07947cbdd8873af4e784f889ba65d396c0 Mon Sep 17 00:00:00 2001
From: "HT9045 Machine (V906)" <Claude_RDBC_02@honprec.com>
Date: Sat, 3 Oct 2026 13:48:57 +0800
Subject: [PATCH] MT-COPYALL (web): Copy From parses the whole motor number
 (M35 = 35) instead of golden's 2nd/3rd characters with the 0..24 limit --
 EastSun 1003

---
 page/HW.MotorTest.html | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/page/HW.MotorTest.html b/page/HW.MotorTest.html
index 3dbea7b..bfd46a2 100644
--- a/page/HW.MotorTest.html
+++ b/page/HW.MotorTest.html
@@ -1844,9 +1844,10 @@ document.querySelectorAll('.traypos').forEach(function(ph){
     on('BitBtn1','click',function(){
       var id=curMotorId(); if(!id) return;
       var s=$id('cbbMotorName'), t=(s && s.selectedIndex>=0) ? String(s.value||'') : '';
-      function ch(i){ return i<t.length ? t.charCodeAt(i) : 0; }            // strncpy 在字串後補 '\0'
-      var src=(ch(1)-48)*10+(ch(2)-48);
-      if(src>24 || src<0){ setInfo('Copy From：'+(t||'(沒有選)')+' → Source='+src+'，golden 只接受 0~24，不做', 'warn'); return; }
+      // AI(W906-MT-COPYALL) 20261003：EastSun「我複製M35的參數但是為啥沒作用」—— golden 只收 M00~M24（:1392 Source>24 return），
+      //   HT9050 有 M35~M42，選 M35 就被這一行默默擋掉。改成照完整編號（M35＝35、M108＝108），存不存在由 C++ 判（MOT[n] 沒物件就拒絕）。
+      var mm=/^M(\d+)/.exec(t), src=mm ? parseInt(mm[1],10) : -1;
+      if(src<0){ setInfo('Copy From：'+(t||'(沒有選)')+' → 不是 Mxx，不做', 'warn'); return; }
       HTMotorAccess.sendLater('BitBtn1',{source:src},[id],null);
     });
     // AI(W906-MT-SAVEMOT) 20260930：「回寫 Mot_Table」（EastSun：「圖片上也幫我新增回寫至 MOT_table的按鈕」）—— 不是 golden
-- 
