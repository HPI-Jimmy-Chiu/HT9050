After a GO the C++ ack reports the active motor and the page ran teachSelectMotor -> teachUpdateMotorMonitor, which (golden UpdateMotorTeachMonitor :1282) put edtSpeed and the speed bar back to 1 -- the move itself already ran at the page's 65 % (14:21:42, s=3900), only the field went back to 1. Now page/HW.teach.html (same lines): edtSpeed / the bar keep their value (1 only when blank or invalid); every change of the active motor (operator pick, or a C++ handler's echo) queues the remembered speed as the next command's speedEvent (golden: 1 on an operator pick, nothing on an echo), so C++ -- whose Set / select-only handlers still do golden's SetSpeed(1) -- runs at what the page shows; SetButton020 / 064 no longer show 1. Backup D:\HT9045\_review\HW.teach.html.bak_speedmem_*.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 page/HW.teach.html | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/page/HW.teach.html b/page/HW.teach.html
index 10abcfe..26f843c 100644
--- a/page/HW.teach.html
+++ b/page/HW.teach.html
@@ -570,8 +570,8 @@ function teachUpdateMotorMonitor(id){
   var motor=teachMotorById(id); if(!motor) return;
   var p2=document.getElementById('Panel2');
   if(p2){ p2.textContent='M'+teachPad2(motor.motorIndex)+' '+(motor.alias||id); }
-  var spd=document.getElementById('edtSpeed'); if(spd) spd.value='1';
-  teachSpeedBarSet(1);                               // AI(W906-TEACH-SPEEDBAR) 20261001：golden UpdateMotorTeachMonitor :1282 ScrollBar1->Position=1
+  var spd=document.getElementById('edtSpeed'); if(spd && !(+spd.value>=1)) spd.value='1';   // AI(W906-TEACH-SPDMEM) 20261007：EastSun「speed 可以不要我每go 一次 就1%嗎 可以記憶住?」—— 不再照 golden UpdateMotorTeachMonitor 把 edtSpeed 設回 1；保留操作員設的值（空白或不合法才給 1）
+  teachSpeedBarSet(teachNum('edtSpeed',1));          // AI(W906-TEACH-SPDMEM) 20261007：捲軸跟著記住的速度（golden :1282 是 ScrollBar1->Position=1）
   teachScanNow(id);
 }
 // AI(W906-W5-b) 20260925：覆核 R-W5B-4 —— 操作員在頁面上選馬達＝golden UpdateMotorTeachMonitor（uteach.cpp:1275）的 SetSpeed(1)；
@@ -582,7 +582,7 @@ function teachSelectMotor(id, fromGolden){
   if(!teachMotorById(id)) return;
   teachActiveMotorId=id;
   teachUpdateMotorMonitor(id);
-  if(!fromGolden) teachSpeedPending=1;
+  teachSpeedPending=teachNum('edtSpeed',1);   // AI(W906-TEACH-SPDMEM) 20261007：換了作用中馬達（操作員選的，或 C++ 的處理函式回報的——Set 鈕／只選馬達在 C++ 仍照 golden 設 1%）之後，下一個命令把畫面上記住的速度報給 C++，兩邊一致（golden：操作員選馬達報 1、fromGolden 不報）
   if(teachMotorEnabled(id)===false) teachSetInfo(id+'：這一軸在馬達表是 Enable=0，JOG／Move／HOME 會被拒絕', 'warn');   // AI(W906-TEACH-SEL) 20260930
 }
 // golden ActiveMotorIndex 變成 -1（C++ 回 activeMotor ""）：golden ScanNowMotorStatus 在 -1 時不顯示位置
@@ -951,7 +951,7 @@ function teachOnAck(req, ack, err){
   }
   if(ack && ack.teachActive){                     // 開始：golden fTeachShow->ShowModal()
     // AI(W906-W5-b) 20260925：覆核 R-W5B-4 —— SetButton020／064 不改 ActiveMotorIndex，但 golden UpdateMotorTeachMonitor／TwoMonitor 照樣把 edtSpeed 顯示成 1
-    if(ack.teachHandler==='SetButton020Click' || ack.teachHandler==='SetButton064Click'){ var sp=document.getElementById('edtSpeed'); if(sp) sp.value='1'; teachSpeedBarSet(1); }
+    if(ack.teachHandler==='SetButton020Click' || ack.teachHandler==='SetButton064Click'){ teachSpeedPending=teachNum('edtSpeed',1); }   // AI(W906-TEACH-SPDMEM) 20261007：不再把 edtSpeed 顯示成 1（golden 會）；記住的速度在下一個命令報給 C++
     teachShowHand(p.btn||ack.teachBtn||'?'); return;
   }
   // AI(W906-TEACH-SVON) 20261001：激磁教導（start:true、沒勾手動教導）—— C++ 不開對話框、直接回 positions：照「確定」那一段寫進 EditPtr
