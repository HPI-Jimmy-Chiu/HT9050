diff --git a/page/ht9045_teach_kb_c.js b/page/ht9045_teach_kb_c.js
new file mode 100644
index 0000000..3c995b8
--- /dev/null
+++ b/page/ht9045_teach_kb_c.js
@@ -0,0 +1,104 @@
+/* ht9045_teach_kb_c.js -- Teach（HW.teach.html）每一個欄位的小鍵盤照 golden：範圍、夾法、事後修正。
+ *
+ * //AI(W906-TEACH-KB) 20261002（EastSun 1002 裁決「C」：照 golden，這台走 9046LS 那一臂）
+ *   產生的接線檔 ht9045_wire_hwteach.js 的 kb 表把 golden 的範圍抄成 ['INTEGER',0,false,0,0]（筆電 INBOX 140），
+ *   所以網頁 Teach 欄位打什麼都照存。範圍由 C++ 開頁時照 golden 處理器算好（FileRW/TeachKb.cpp，
+ *   editlist.get tag=Teach 的 extra.kb ／ extra.motorSoft），這支只負責照 golden 開小鍵盤：
+ *   - golden uteach.dfm 每個 TEdit 的 OnClick → ShowQwertyKey(Sender, N_INTEGER, 0, true, a, b)；
+ *     extra.kb[id] === null ＝ golden 處理器在這台不開小鍵盤（例 setEditFix4X：AUTO_EMPTY_COLOR<3，uteach.cpp:4086），點了沒反應。
+ *   - golden 小鍵盤（myQwertyKeyBoard.cpp:285-291）：OK 時夾到範圍；**Cancel 也夾** —— Cancel 先把原值放回（:364），
+ *     ShowModal 回來後一樣跑 CheckRange。所以原值在範圍外時，點開再按 Abort 也會變成邊界值（照 golden）。
+ *     ⚠ 機台實測 docs/TEACH_KB_RANGE_HT9050_20261002.md：這台有 11 個在用的位置在範圍外，點一下就會被夾；EastSun 看過後選 C。
+ *   - edtMoveTo（:5159-5165）：用目前選取的馬達的軟體極限；沒有選馬達（ActiveMotorIndex==-1）就不開。
+ *   - setEditWaitTestZDown（:3736-3740）：小鍵盤之後 CheckEditNumber(0, iMinDis)，再不能大於 TestZSafePos；
+ *     setEditTestZSafePos（:3753-3756）：不能小於 WaitTestZDown。
+ *   C++ 沒送 extra（舊伺服器、開頁失敗）或欄位不在表裡 ⇒ 不攔，照舊由引擎開通用小鍵盤（不猜範圍）。
+ *   偏離：網頁小鍵盤的 ✕／點外面也當成 Abort（golden 只有 Cancel 鍵）。
+ */
+(function () {
+  'use strict';
+  function $(id) { return document.getElementById(id); }
+  function extra() {
+    var g = window.HT9045Page && HT9045Page.golden ? HT9045Page.golden() : null;
+    return (g && g.struct === 'Teach' && g.page && g.page.extra) || null;
+  }
+  function atof(s) { var v = parseFloat(String(s == null ? '' : s).replace(/^\s+/, '')); return isFinite(v) ? v : 0; }     // C atof：讀不到＝0
+  function atoi(s) { var v = parseInt(String(s == null ? '' : s).replace(/^\s+/, ''), 10); return isFinite(v) ? v : 0; }  // C atoi
+  function vcl(x) { return String(Number(Number(x).toPrecision(15))); }   // AnsiString(double)＝FloatToStr
+  function checkRange(v, mx, mn) {                                         // golden MachineDefine.h CheckRange（大小相反也照夾）
+    if (mx < mn) { if (v > mn) return mn; if (v < mx) return mx; return v; }
+    if (v > mx) return mx; if (v < mn) return mn; return v;
+  }
+  function fire(el) {                                                      // 同引擎小鍵盤 onCommit（ht9045_wire_engine.js attachKeyboards）
+    ['input', 'change'].forEach(function (evn) {
+      var e2; try { e2 = new Event(evn, { bubbles: true }); } catch (x) { e2 = document.createEvent('Event'); e2.initEvent(evn, true, true); }
+      el.dispatchEvent(e2);
+    });
+  }
+  function setTxt(el, s, changed) { if (!el || el.value === s) return; el.value = s; changed.push(el); }   // VCL：Text 沒變就不觸發 OnChange
+
+  // golden setEditLimitClick 在 ShowQwertyKey 之後（OK 或 Cancel 都會跑到）
+  var POST = {
+    setEditWaitTestZDown: function (t, k, changed) {                       // :3736-3740
+      var mx = 0, mn = k[4], cur = atoi(t.value);                         // CheckEditNumber(0, iMinDis, Text) :3702-3723
+      if (mn > mx) { var tmp = mx; mx = mn; mn = tmp; }
+      if (cur > mx) setTxt(t, String(mx), changed); else if (cur < mn) setTxt(t, String(mn), changed);
+      var safe = $('setEditTestZSafePos');
+      if (safe && atoi(t.value) > atoi(safe.value)) setTxt(t, safe.value, changed);
+    },
+    setEditTestZSafePos: function (t, k, changed) {                        // :3753-3756
+      var wait = $('setEditWaitTestZDown');
+      if (wait && atoi(t.value) < atoi(wait.value)) setTxt(t, wait.value, changed);
+    }
+  };
+
+  function activeMotorIndex() {                                            // golden TfTeach::ActiveMotorIndex（頁面的選取＝C++ 回報的那一軸）
+    try {
+      if (typeof teachActiveMotorId === 'undefined' || teachActiveMotorId == null || typeof teachMotorById !== 'function') return -1;
+      var m = teachMotorById(teachActiveMotorId);
+      return (m && m.motorIndex != null) ? Number(m.motorIndex) : -1;
+    } catch (e) { return -1; }
+  }
+
+  function specOf(id, e) {                                                 // undefined＝不攔；null＝golden 不開；陣列＝範圍
+    if (id === 'edtMoveTo') {
+      var mi = activeMotorIndex();
+      if (mi < 0) return null;                                             // :5161-5162 ActiveMotorIndex==-1 → return
+      var s = e.motorSoft && e.motorSoft[String(mi)];
+      return (s && s.length === 2) ? ['INTEGER', 0, true, s[0], s[1]] : undefined;
+    }
+    if (!e.kb || !Object.prototype.hasOwnProperty.call(e.kb, id)) return undefined;
+    var k = e.kb[id];
+    if (k === null) return null;
+    return (k && k.length === 5) ? k : undefined;
+  }
+
+  document.addEventListener('mousedown', function (ev) {
+    var t = ev.target;
+    if (!t || !t.id || t.tagName !== 'INPUT' || ev.button > 0 || ev.defaultPrevented) return;
+    var e = extra(); if (!e) return;
+    if (!window.HTQwerty || t.disabled || t.getAttribute('aria-disabled') === 'true' || t.getAttribute('data-unwired')) return;
+    for (var p = t.parentElement; p; p = p.parentElement) if (p.getAttribute && p.getAttribute('aria-disabled') === 'true') return;
+    var k = specOf(t.id, e);
+    if (k === undefined) return;
+    ev.preventDefault(); ev.stopPropagation();                             // 引擎掛在欄位上的通用小鍵盤（沒有範圍）不跑
+    if (k === null) return;                                                // golden 處理器不開小鍵盤
+    var orig = t.value;
+    function after(changed) {
+      if (POST[t.id]) POST[t.id](t, k, changed);
+      changed.forEach(function (el) { fire(el); });
+    }
+    HTQwerty.show(t, HTQwerty.N.INTEGER, {
+      dp: k[1], checkRange: !!k[2], min: k[3], max: k[4],
+      rangeHook: function () { return k[2] ? { min: k[3], max: k[4] } : null; },   // qwerty.js：範圍是機台（C++）給的 ⇒ 顯示「上下限來源：機台」
+      onCommit: function () { var ch = [t]; after(ch); },                  // 同引擎：OK 一律觸發（qwerty.js commit 已夾好、寫進欄位）
+      onAbort: function () {                                               // golden Cancel：放回原值再 CheckRange（:364 → :285-291）
+        var ch = [];
+        if (k[2]) setTxt(t, vcl(checkRange(atof(orig), k[3], k[4])), ch); else setTxt(t, orig, ch);
+        after(ch);
+      }
+    });
+  }, true);
+
+  window.HT9045TeachKb = { specOf: function (id) { var e = extra(); return e ? specOf(id, e) : undefined; }, checkRange: checkRange, vcl: vcl };
+})();
-- 
