From 215b80607f98d619178165ff607d1733f22c0691 Mon Sep 17 00:00:00 2001
From: "HT9045 Machine (V906)" <Claude_RDBC_02@honprec.com>
Date: Wed, 30 Sep 2026 11:56:57 +0800
Subject: [PATCH] CAPTION (web): the main window's title bar follows C++ tag
 machine.caption (was the literal 'HT-9132')
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

EastSun 20260930: "圖片上應該是要對應機型顯示 目前機台是9050".
- page/main.html: HT9045Tags.on('machine.caption') -> parent.postMessage({setMainCaption}); null / "" is not sent.
- background.html: {setMainCaption} accepted only from the main window's own iframe; sets WINDOWS main title to
  caption+'（main.dfm）' (release still strips the parentheses) and the taskbar entry. No tag / old wb_serve -> the static
  title stays.
C++ side: CAPTION commit in the Cpp tree (W906_MainCaption, WebBridgeTags.cpp). Inline scripts parse (Electron vm);
the 3rd "script" background.html matches is an HTML comment, the same before this change.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 background.html | 15 +++++++++++++++
 page/main.html  |  8 ++++++++
 2 files changed, 23 insertions(+)

diff --git a/background.html b/background.html
index 975fa07..f05081a 100644
--- a/background.html
+++ b/background.html
@@ -1227,6 +1227,21 @@ window.addEventListener('message',function(e){
     var zp=applyUiZoom(e.data.setZoom);
     broadcastAll({type:'HT_ZOOM',zoom:zp});
   }
+  // AI(W906-CAPTION) 20260930：EastSun「圖片上應該是要對應機型顯示 目前機台是9050」—— 主視窗標題原本寫死 'HT-9132（main.dfm）'。
+  //   golden 的 fMain->Caption 依機型設定（main.cpp:9216-9253／:9590-9607），C++ 照翻成 tag machine.caption（WebBridgeTags.cpp 檔尾），
+  //   main.html 收到就送 {setMainCaption}。只收主視窗自己的 iframe 送來的；空字串／null（C++ 還沒載入設定、或不認得的機型）＝保持原標題。
+  if(e.data.setMainCaption!==undefined){
+    var mw=document.getElementById('win-main'), mf=mw&&mw.querySelector('iframe');
+    var cap=(typeof e.data.setMainCaption==='string')?e.data.setMainCaption.trim():'';
+    if(mf && mf.contentWindow===e.source && cap){
+      var mcfg=WINDOWS.filter(function(c){return c.id==='main';})[0];
+      if(mcfg){
+        mcfg.title=cap+'（main.dfm）';
+        var mt=mw.querySelector('.tbar .ttl'); if(mt) mt.textContent=dispTitle(mcfg.title);
+        if(mw._task) mw._task.textContent=dispTitle(mcfg.title);
+      }
+    }
+  }
   if(e.data.setFont!==undefined){
     window.HTFont.set(e.data.setFont);
     broadcastAll({type:'HT_FONT',font:e.data.setFont});
diff --git a/page/main.html b/page/main.html
index 95472b7..ac5f10f 100644
--- a/page/main.html
+++ b/page/main.html
@@ -609,6 +609,14 @@ document.querySelectorAll('#palConfig .smi').forEach(function(el){
  *     只在 pump 在跑時才有值（wb_serve 開機 PumpInit 成功＝ARMED）。
  *   null（pump 沒在跑、或還沒連上）→ "---"。 */
 (function(){
+  /* AI(W906-CAPTION) 20260930：EastSun「圖片上應該是要對應機型顯示 目前機台是9050」—— 主視窗標題＝golden fMain->Caption，
+   *   C++ 照 golden 機型規則算好送 tag machine.caption（WebBridgeTags.cpp 檔尾 W906_MainCaption），這裡轉給 background.html 改標題列。
+   *   null／空字串（設定還沒載入、不認得的機型）不送 ⇒ 保持原標題。 */
+  if(window.HT9045Tags && window.parent!==window){
+    HT9045Tags.on('machine.caption',function(v){
+      if(typeof v==='string' && v!=='') window.parent.postMessage({setMainCaption:v},'*');
+    });
+  }
   var el=document.getElementById('clock'); if(!el||!window.HT9045Tags) return;
   HT9045Tags.on('clock.text',function(v){
     if(v===null||v===undefined||v===''){ el.textContent='---'; return; }
-- 
2.55.0.windows.5

