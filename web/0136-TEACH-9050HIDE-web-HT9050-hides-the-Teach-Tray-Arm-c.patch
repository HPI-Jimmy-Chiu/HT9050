page/ht9045_teach_3axes_c.js (end of file + one same-line call after the axis blocks settle): on HT9050 only (parent.MACHINE.id / ?machine=HT9050) hide Tray X OCR / Clean / Color (Set, GO, field), Tray X U/D, Suck On, Suck Off (BtnPanelLane1-3) and Tray Mapping Function (gbTrayMapping); then the Tray Arm pane (data-p 7) collapses: from the ORIGINAL tops (data-otop) it finds the height bands covered only by hidden direct children and moves every shown child up by the bands above it; a MutationObserver re-runs it when another script later shows / hides a block (no overlap). Other machines untouched. Checked in headless Edge (?machine=HT9050): hidden as listed, gbOCRYMot 612 -> 348; showing gbTrayZ afterwards re-flows it to 321 and gbOCRYMot to 465. Backup D:\HT9045\_review\ht9045_teach_3axes_c.js.bak_9050hide_*.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 page/ht9045_teach_3axes_c.js | 72 +++++++++++++++++++++++++++++++++++-
 1 file changed, 71 insertions(+), 1 deletion(-)

diff --git a/page/ht9045_teach_3axes_c.js b/page/ht9045_teach_3axes_c.js
index 7afb82b..df3d2b7 100644
--- a/page/ht9045_teach_3axes_c.js
+++ b/page/ht9045_teach_3axes_c.js
@@ -122,7 +122,7 @@
       if (!r.cfg || !r.cfg.motors || typeof r.cfg.motors.length !== 'number') throw new Error('馬達表回應沒有 motors');
       var have = compute(r.cfg), lost = applyHave(have);
       ST.ok = true; ST.reason = ''; ST.have = have; ST.missingIds = lost; ST.at = Date.now();
-      document.documentElement.setAttribute('data-teach3axes', 'ok');
+      document.documentElement.setAttribute('data-teach3axes', 'ok');  if (global.W906Teach9050Layout) { try { global.W906Teach9050Layout(); } catch (e) {} }   // AI(W906-TEACH-9050HIDE) 20261007: HT9050 hides + the pane collapses after the axis blocks settled (end of file)
       if (lost.length) info('三軸教導點：頁面上找不到 ' + lost.join(', ') + '（頁面改版？）', 'warn');
       return ST;
     }).catch(function (e) {
@@ -162,3 +162,73 @@
 
   global.HT9045Teach3Axes = { AXES: AXES, GROUPS: GROUPS, compute: compute, formShow: formShow, state: ST };
 })(window);
+
+/* AI(W906-TEACH-9050HIDE) 20261007：EastSun「這些用不到 用9050分支 隱藏調」「這也都沒用先隱藏」「你整個畫面可以像 dockpanel 嗎? 我隱藏一個方塊 下面往上移」。
+ *   HT9050 才做（同上 isHT9050：background.html 的 parent.MACHINE.id，或 ?machine=HT9050）；別的機型完全不動。
+ *   ① 藏：Tray Arm 頁 Tray X 的 OCR／Clean／Color（Set、GO、欄位）、Tray X U/D、Suck On、Suck Off（BtnPanelLane1～3）、Tray Mapping Function（gbTrayMapping）。
+ *   ② 往上補（像 DockPanel）：Tray Arm 頁（pcPane data-p=7）的直屬元件，照「原始」座標算出只被隱藏元件佔用、沒有任何顯示中元件佔用的高度帶，
+ *      顯示中的元件把它上方這些帶的總高度扣掉往上移。原始座標記在 data-otop，每次都從原始座標重算（重複執行結果一樣）。 */
+(function (global) {
+  'use strict';
+  var HIDE_9050 = ['SetButton147', 'GoButton147', 'setEditTrayOCRX', 'SetButton146', 'GoButton146', 'setEditTrayCleanX',
+                   'SetButton142', 'GoButton142', 'setEditTrayColorX', 'BtnPanelLane1', 'BtnPanelLane2', 'BtnPanelLane3', 'gbTrayMapping'];
+  function isHT9050() {
+    try { if (global.parent && global.parent.MACHINE && global.parent.MACHINE.id) return global.parent.MACHINE.id === 'HT9050'; } catch (e) {}
+    return /[?&]machine=HT9050\b/.test(global.location.search);
+  }
+  function holder(el) { return (el && el.tagName === 'INPUT' && el.parentNode && el.parentNode.tagName === 'SPAN') ? el.parentNode : el; }
+  function collapse(pane) {
+    var kids = [], i, k;
+    for (i = 0; i < pane.children.length; i++) {
+      var el = pane.children[i];
+      if (!el.style || el.style.position !== 'absolute') continue;
+      if (!el.hasAttribute('data-otop')) el.setAttribute('data-otop', String(parseFloat(el.style.top) || 0));
+      var top = parseFloat(el.getAttribute('data-otop')) || 0, h = parseFloat(el.style.height) || el.offsetHeight || 0;
+      kids.push({ el: el, top: top, bot: top + h, shown: el.style.display !== 'none' });
+    }
+    var shown = kids.filter(function (x) { return x.shown; }), bands = [];
+    kids.forEach(function (x) { if (!x.shown) bands.push([x.top, x.bot]); });
+    bands.sort(function (a, b) { return a[0] - b[0]; });
+    var merged = [];                                      // 合併重疊的隱藏帶
+    bands.forEach(function (b) { var last = merged[merged.length - 1]; if (last && b[0] <= last[1]) last[1] = Math.max(last[1], b[1]); else merged.push([b[0], b[1]]); });
+    var free = [];                                        // 扣掉任何顯示中元件佔用的部分
+    merged.forEach(function (b) {
+      var segs = [[b[0], b[1]]];
+      shown.forEach(function (s) {
+        var next = [];
+        segs.forEach(function (g) { if (s.bot <= g[0] || s.top >= g[1]) next.push(g); else { if (s.top > g[0]) next.push([g[0], s.top]); if (s.bot < g[1]) next.push([s.bot, g[1]]); } });
+        segs = next;
+      });
+      segs.forEach(function (g) { if (g[1] - g[0] > 0.5) free.push(g); });
+    });
+    shown.forEach(function (s) {
+      var shift = 0;
+      for (k = 0; k < free.length; k++) if (free[k][1] <= s.top) shift += free[k][1] - free[k][0];
+      s.el.style.top = (s.top - shift) + 'px';
+    });
+  }
+  var busy = false, observed = false, timer = null;
+  global.W906Teach9050Layout = function () {
+    if (!isHT9050()) return;
+    busy = true;
+    try {
+      HIDE_9050.forEach(function (id) { var el = holder(document.getElementById(id)); if (el) el.style.display = 'none'; });
+      var panes = document.querySelectorAll('.pcPane[data-p="7"]');
+      for (var i = 0; i < panes.length; i++) {
+        collapse(panes[i]);
+        for (var j = 0; j < panes[i].children.length; j++) panes[i].children[j].setAttribute('data-odisp', panes[i].children[j].style.display || '');
+        if (!observed && global.MutationObserver) {   // 別的程式之後才顯示／隱藏某一塊（例 golden 依設定開 gbTrayZ）：重新補位，不重疊
+          new MutationObserver(function (recs) {
+            if (busy) return;
+            var changed = recs.some(function (r) { var t = r.target; return t.parentNode && t.parentNode.matches && t.parentNode.matches('.pcPane[data-p="7"]') && (t.style.display || '') !== (t.getAttribute('data-odisp') || ''); });
+            if (changed) { clearTimeout(timer); timer = setTimeout(global.W906Teach9050Layout, 0); }
+          }).observe(panes[i], { subtree: true, attributes: true, attributeFilter: ['style'] });
+        }
+      }
+      observed = true;
+    } finally { busy = false; }
+  };
+  function boot() { setTimeout(global.W906Teach9050Layout, 0); }
+  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot, { once: true });
+  else boot();
+})(window);
