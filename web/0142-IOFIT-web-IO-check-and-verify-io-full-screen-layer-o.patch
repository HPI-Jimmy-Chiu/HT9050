--- a/background.html
+++ b/background.html
@@ -108,6 +108,13 @@
   :root{--uiz:1;}
   #desktop{zoom:var(--uiz);}
   .win.htFull{width:calc(100vw / var(--uiz)) !important;height:calc(100vh / var(--uiz)) !important;}
+  /* AI(W906-IOFIT) 20261009：EastSun「這個畫面右邊的空位太大可否變成第二張圖這樣」—— MODAL_POLICY 標 fitWidth 的頁（目前只有 io）
+     全螢幕時只佔自己的寬（視窗宣告的 w，--fitw），高度照舊滿版；右邊露出的主畫面加暗，表示不能操作。
+     擋輸入的仍是 applyInert() 的 inert，這裡只改外觀。 */
+  .win.htFull.htFit{width:var(--fitw) !important;}
+  #htFitShade{display:none;position:fixed;left:0;top:0;width:calc(100vw / var(--uiz));height:calc(100vh / var(--uiz));
+    background:rgba(0,0,0,.35);z-index:9999;}   /* 全螢幕層 10000+ 的正下方；用元件不用 box-shadow：連滑鼠點擊也一起擋在暗幕上（headless 實測右側 235→153 變暗、IO 本身不變） */
+  #htFitShade.on{display:block;}
   /* ⚠ 刻意醒目：這是「訊號不存在所以暫時放寬」的標示。一個靜默的放寬比擋住更危險。 */
   .htGuardBanner{flex:none;background:#7a2b00;color:#ffd9b0;font-size:13px;font-weight:bold;
     padding:6px 10px;border-bottom:2px solid #ff8c1a;white-space:pre-wrap;}
@@ -582,7 +589,7 @@ var GUARD_STRICT_WHEN_SIGNAL_ABSENT = false;
 var MODAL_POLICY={
   teach:       {level:0},                      // 政策表 #1  golden main.cpp:28804
   motortest:   {level:1},                      // 政策表 #2  疊在 teach 之上 uteach.cpp:2442
-  io:          {level:0},                      // 政策表 #3  比 golden 嚴格，見 §3.2
+  io:          {level:0, fitWidth:true},       // 政策表 #3  比 golden 嚴格，見 §3.2   //AI(W906-IOFIT) 20261009: fitWidth -- 全螢幕時寬度只到內容（.htFit）
   contact:     {level:0, onlyWhenContactMode:true},  // 政策表 #4  僅 iContactMode!=0
   home:        {level:0, modeless:true},       // 政策表 #5  ⚠ 入口歸屬未決，見 §3.4   //AI(W906-HOMEMON) 20261001: modeless -- golden 用 fHome->Show() 叫出 Home Monitor（uhome.cpp:2368，非 ShowModal），回原點時主畫面的 PAUSE／START 照樣按得到（PAUSE 中止回原點＝MainProc 停機臂 fHome->sbAbortHomeClick）；所以不全螢幕、不 inert 其他視窗（isFullscreenFor）。操作員自己開的守衛（decideOpen）不變
   shuttlemove: {level:0, needEmpty:true}       // 政策表 #6  兩道守衛 main.cpp:33658
@@ -734,10 +741,18 @@ function applyInert(){
     if(top) n.setAttribute('inert',''); else n.removeAttribute('inert');
   });
 }
+//AI(W906-IOFIT) 20261009: 窄的全螢幕頁（.htFit）右邊露出的主畫面加一層暗幕 —— 跟視窗同一層（#desktop），疊序才比得過其他視窗
+function setFitShade(parent){
+  var sh=document.getElementById('htFitShade');
+  if(!sh && parent){ sh=document.createElement('div'); sh.id='htFitShade'; parent.appendChild(sh); }
+  if(sh) sh.classList.toggle('on', !!document.querySelector('.win.htFull.htFit'));
+}
 function enterFullscreen(id,banner){
   var win=document.getElementById('win-'+id); if(!win) return;
   if(modalStack.indexOf(id)<0) modalStack.push(id);
   win.classList.add('htFull');
+  if(MODAL_POLICY[id] && MODAL_POLICY[id].fitWidth){ win.style.setProperty('--fitw', win.style.width); win.classList.add('htFit'); }   //AI(W906-IOFIT) 20261009: 宣告寬（background.html cfg.w，inline width）
+  setFitShade(win.parentNode);
   win.style.zIndex=10000+modalStack.indexOf(id);   // ⚠ 必須留在 20000 以下（政策 §4.2）
   setBanner(win,banner);
   document.body.classList.add('htModal');
@@ -749,7 +764,7 @@ function exitFullscreen(id){
   if(k<0) return;
   modalStack.splice(k,1);
   var win=document.getElementById('win-'+id);
-  if(win){ win.classList.remove('htFull'); setBanner(win,''); win.style.zIndex=(++zTop); }
+  if(win){ win.classList.remove('htFull'); win.classList.remove('htFit'); setBanner(win,''); win.style.zIndex=(++zTop); setFitShade(win.parentNode); }
   if(!modalStack.length) document.body.classList.remove('htModal');
   // 剩下的層重新編號，免得 splice 之後留下空洞
   modalStack.forEach(function(mid,i){
