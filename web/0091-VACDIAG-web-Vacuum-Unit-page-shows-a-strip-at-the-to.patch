From bd4cb033cda7bc74e341276ec7633252d4631697 Mon Sep 17 00:00:00 2001
From: "HT9045 Machine (V906)" <Claude_RDBC_02@honprec.com>
Date: Sat, 3 Oct 2026 11:37:53 +0800
Subject: [PATCH] VACDIAG (web): Vacuum Unit page shows a strip at the top with
 every readable input of each vacuum station (raw bytes, kPa per VC with the
 panels that use it, OK bits); click to fold -- EastSun 1003

---
 page/ht9045_vacuumunit_c.js | 35 +++++++++++++++++++++++++++++++++++
 1 file changed, 35 insertions(+)

diff --git a/page/ht9045_vacuumunit_c.js b/page/ht9045_vacuumunit_c.js
index de46599..96e0c39 100644
--- a/page/ht9045_vacuumunit_c.js
+++ b/page/ht9045_vacuumunit_c.js
@@ -231,9 +231,44 @@
     el.style.opacity = locked ? '0.55' : '1';
   }
 
+  // AI(W906-VACDIAG) 20261003: EastSun「我G的數值 都不會變動 … 不然幫我可讀取的位置數值 都列出來顯示在上面」-- a strip at the top of the
+  //   page with every input C++ can read from each vacuum station (stations[].raw / kpa / okBits, FileRW/TestIF_File_VacuumUnit.cpp
+  //   VuSnapshot_): raw bytes 0..15, each pair as kPa (pair n = VC n = the panel whose VC is n: InArm A/C/E/G = VC0..3), OK bits.
+  //   Switch a nozzle's suction on and watch which value moves. Click the strip to fold it.
+  function renderDiag(s) {
+    var d = document.getElementById('vuDiag');
+    if (!d) {
+      d = document.createElement('div');
+      d.id = 'vuDiag';
+      d.style.cssText = 'position:fixed;left:4px;right:4px;top:2px;z-index:9000;font:11px/1.35 monospace;background:rgba(255,255,224,.95);' +
+                        'color:#111;border:1px solid #888;border-radius:3px;padding:2px 6px;white-space:pre;overflow:auto;max-height:40vh;cursor:pointer;';
+      d.title = '可讀取的位置（每秒更新）。點一下收起／展開';
+      d.addEventListener('click', function () { d.dataset.fold = d.dataset.fold === '1' ? '0' : '1'; renderDiag(VU.snap); });
+      document.body.appendChild(d);
+    }
+    var st = (s && s.stations) || [];
+    if (d.dataset.fold === '1') { d.textContent = '▸ 可讀取位置（點一下展開）'; return; }
+    var used = {};
+    (s.panels || []).forEach(function (p) { var k = p.st + ':' + p.vc; (used[k] = used[k] || []).push(p.id.replace(/^myPal/, '')); });
+    var lines = ['▾ 可讀取位置（每秒更新，點一下收起）'];
+    st.forEach(function (x, k) {
+      var head = 'ring ' + x.ring + ' 站 ' + x.station + '：';
+      if (!x.raw) { lines.push(head + '讀不到（' + (x.why || '這一站不是 ECAT-VC8／VC4') + '）'); return; }
+      var raw = x.raw.map(function (v, b) { return '[' + b + ']' + (v == null ? '--' : ('00' + v.toString(16).toUpperCase()).slice(-2)); }).join(' ');
+      var kpa = (x.kpa || []).map(function (v, n) { return 'VC' + n + '=' + (v == null ? '--' : v) + (used[k + ':' + n] ? '(' + used[k + ':' + n].join(',') + ')' : ''); }).join('  ');
+      var ok = (x.okBits || []).filter(function (o) { return o.v != null; }).map(function (o) { return o.ch + ':' + o.v; }).join(' ');
+      lines.push(head + '原始位元組 ' + raw);
+      lines.push('    kPa（每兩個位元組一組＝VC）' + kpa);
+      lines.push('    OK 位元 ' + (ok || '--'));
+    });
+    if (!st.length) lines.push('（C++ 還沒有回站點資料）');
+    d.textContent = lines.join('\n');
+  }
+
   function render(s) {
     if (!s || !s.panels) return;
     VU.snap = s;
+    try { renderDiag(s); } catch (e) {}   // AI(W906-VACDIAG) 20261003
     var armOk = { myPalInArm: false, myPalArm1: false, myPalArm2: false, myPalOutArm: false };
     var firstWhy = {};
     s.panels.forEach(function (p) {
