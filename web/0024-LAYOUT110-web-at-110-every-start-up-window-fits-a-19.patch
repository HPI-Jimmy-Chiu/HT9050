 //   **C++ 的 join key**（WINDOW_REGISTRY_CONTRACT.md §5）。
@@ -421,17 +423,24 @@ function winHeight(cfg){ var h=(MODE==='debug' && cfg.hDebug)?cfg.hDebug:cfg.h;
 //   logs、tasklist…，它們是 fMain 上的 TTabSheet，填 fMain 會讓 join key 一對多）
