-function winHeight(cfg){ var h=(MODE==='debug' && cfg.hDebug)?cfg.hDebug:cfg.h; return (MODE==='release' && cfg.footerH) ? h - cfg.footerH : h; }
+function winHeight(cfg){ var h=(MODE==='debug' && cfg.hDebug)?cfg.hDebug:cfg.h; return cfg.footerH ? h - cfg.footerH : h; }   // AI(W906-LAYOUT110) 20260930：footer 一律隱藏 ⇒ 一律扣
