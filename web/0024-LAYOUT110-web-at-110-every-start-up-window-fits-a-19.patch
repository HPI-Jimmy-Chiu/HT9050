   {id:'logs', form:null,        title:'Logs（main.dfm tsLogs＋ tsMNetLog）',        src:'page/Main.Logs.html',          x:160, y:40,  w:900,  h:560, hidden:true},
   {id:'shuttlesensor', form:null,title:'Shuttle Sensor（main.dfm tsShuttleSensor）',  src:'page/Main.ShuttleSensor.html', x:200, y:60,  w:880,  h:640, hidden:true},
