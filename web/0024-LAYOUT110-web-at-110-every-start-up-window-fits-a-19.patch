 var WINDOWS=[
   // main：主畫面鎖定——座標固定左上、尺寸不可調、隱藏縮小/關閉鈕（locked）；h=內容 602+狀態列 24+標題 24 → 無捲軸
   {id:'main', form:'fMain',      title:'HT-9132（main.dfm）',               src:'page/Main.html',          x:0,   y:0,   w:925, h:720, fixed:true, locked:true},
-  {id:'sortct', form:'fSortCT',    title:'Sort Count（cSortCT）',              src:'page/Data.SortCT.html',       x:925, y:0,   w:310, h:400, footerH:28},
-  {id:'contactct', form:'fContactCT', title:'Contact Counter Kinds（cContactCT）',src:'page/Data.ContactCT.html',    x:925, y:400, w:390, h:450, footerH:43},
-  {id:'lotinfo', form:'fLotInfo',   title:'Lot Info（uLotInfo）',               src:'page/Data.LotInfo.html',      x:1050,y:930, w:440, h:330, footerH:28},
-  {id:'temperf', form:'fTemperFrom',   title:'機況監視列（cTemperFrom / fTemperF）',src:'page/Status.TemperFrom.html',   x:0,   y:720, w:925, h:210, footerH:28},
+  {id:'sortct', form:'fSortCT',    title:'Sort Count（cSortCT）',              src:'page/Data.SortCT.html',       x:925, y:346, w:310, h:272},
+  {id:'contactct', form:'fContactCT', title:'Contact Counter Kinds（cContactCT）',src:'page/Data.ContactCT.html',    x:925, y:0,   w:390, h:346},
+  {id:'lotinfo', form:'fLotInfo',   title:'Lot Info（uLotInfo）',               src:'page/Data.LotInfo.html',      x:925, y:618, w:390, h:318},
+  {id:'temperf', form:'fTemperFrom',   title:'機況監視列（cTemperFrom / fTemperF）',src:'page/Status.TemperFrom.html',   x:0,   y:720, w:925, h:140},
   {id:'observer', form:'fObserver',  title:'Observer（cObserver / fObserver）',  src:'page/Data.Observer.html',     x:330, y:120, w:994, h:801, hidden:true, fixed:true},
-  {id:'showmsg', form:'fShowMessage',   title:'Show Message（uShowMessage / fShowMessage）',src:'page/Status.ShowMessage.html', x:0,   y:930, w:218, h:262, fixed:true, footerH:88},
-  {id:'testcat', form:'fTestCategory',   title:'Tester Category（cTestCategory）',   src:'page/Data.TestCategory.html', x:330, y:860, w:270, h:240, footerH:58},
-  {id:'binselect', form:'fShowBinSelect', title:'BinSelect（cShowBinSelect）',        src:'page/Status.ShowBinSelect.html',x:610, y:860, w:440, h:290, footerH:43},
+  {id:'showmsg', form:'fShowMessage',   title:'Show Message（uShowMessage / fShowMessage）',src:'page/Status.ShowMessage.html', x:1315,y:0,   w:218, h:225, fixed:true},
+  {id:'testcat', form:'fTestCategory',   title:'Tester Category（cTestCategory）',   src:'page/Data.TestCategory.html', x:1315,y:225, w:245, h:185},
+  {id:'binselect', form:'fShowBinSelect', title:'BinSelect（cShowBinSelect）',        src:'page/Status.ShowBinSelect.html',x:1315,y:410, w:245, h:526},
   {id:'offset', form:'fOffSet',    title:'Offset（cOffSet / fOffSet）',         src:'page/Setup.OffSet.html',       x:60,  y:40,  w:1240, h:720, hidden:true},
   // fixed：dfm 固定尺寸表單，視窗鎖定為內容最佳尺寸（內容寬+2 邊框 / 內容高+26 標題列）不可縮放
   // ■ 尺寸上限：設備螢幕解析度 1920×1080，fixed 視窗寬≤ 1920、高≤ 1080−Windows 工作列(約48px)≈1032
@@ -504,7 +513,7 @@ var WINDOWS=[
   // 確認對話框 → 密碼 27025312 → HandlerSystem->ShowModal()，CC_HONPREC_QC 免密碼）。
   {id:'handlersys', form:'HandlerSystem',  title:'Handler System（HandlerSys / HandlerSystem）',      src:'page/HW.HandlerSys.html',     x:60,  y:0,   w:1272, h:972, hidden:true, fixed:true, debugOnly:true},
   {id:'motorview', form:null, title:'Motor View（main.dfm tsMotorView）',  src:'page/Main.MotorView.html',     x:120, y:20,  w:1025, h:823, hidden:true, fixed:true},
