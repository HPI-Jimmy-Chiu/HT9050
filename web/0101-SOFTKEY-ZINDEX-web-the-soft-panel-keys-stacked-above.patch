From e1bbcaf82c540c0c03d5c155e6e59ad3642ad266 Mon Sep 17 00:00:00 2001
From: "HT9045 Machine (V906)" <Claude_RDBC_02@honprec.com>
Date: Sat, 3 Oct 2026 16:50:26 +0800
Subject: [PATCH] SOFTKEY-ZINDEX (web): the soft panel keys stacked above
 #imgLogo -- at the HMI main-window size (923x696) the translated logo box
 (ht9xxx-layout-base.js) covered the keys, so every click hit the logo and no
 panel.key was sent (EastSun 1003 'HOME still cannot be clicked'); probed
 inside background.html at HMI size: all 11 keys (E-STOP + 10) now hit their
 own button

---
 page/main.html | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/page/main.html b/page/main.html
index a97089c..6ae2019 100644
--- a/page/main.html
+++ b/page/main.html
@@ -43,6 +43,10 @@
   /* AI(W906-NOOVERLAP) 20260930：EastSun「很多頁面都有重疊的情況，這是不被允許的」—— ht9xxx-layout-base.js 把 #imgLogo 移到 FAN 右邊（translate 124,-156，同 golden main.dfm:2198 imgLogo L=143 T=314），
      裡面的 IMG 再 translate(-55,56)；版本字 905.2 沒跟著動，壓在 logo 圖右下角。版本字跟 IMG 同一個位移、只佔字寬 → 落在 logo 正下方。 */
   #imgLogo small{transform:translate(-55px,56px);width:max-content;margin:2px auto 0;}
+  /* AI(W906-SOFTKEY-ZINDEX) 20261003: EastSun「HOME 一樣點不下去啊」-- at the HMI's main-window size (923x696) the translated #imgLogo box
+     (ht9xxx-layout-base.js) lies over the soft panel keys: elementFromPoint at the HOME button = DIV#imgLogo, so every click hit the logo
+     (it has no click handler) and no panel.key was ever sent.  The key panel is stacked above it; the logo itself is unchanged. */
+  #softKeys{position:relative;z-index:30;}
 </style>
 </head>
 <body class="winpage" style="padding:0;overflow:hidden;display:flex;flex-direction:column;height:100vh;">
