From 15544726d1f7deeaced2ac73cbb6e2d164927ff4 Mon Sep 17 00:00:00 2001
From: "HT9045 Machine (V906)" <Claude_RDBC_02@honprec.com>
Date: Sun, 4 Oct 2026 14:56:25 +0800
Subject: [PATCH] TEACH-1PICKZ (web): Teach Input Arm Pick Up / Place and
 Output Arm Pick Up / Place Z points shown again on a single-picker machine
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

EastSun 1004: grpInArmPick 怎麼看不到，我的ZA需要校正，In Arm 跟 Out Arm的Z軸的校正點位麻煩Show出.

golden puts these points on MInArmZE / MOutArmZE (uteach.cpp:476-494) and this machine has ZE Enable=0,
so TEACH-HIDEPT hid every one and collapsed both group boxes. But golden's Set/Go turn 7/26 into ZA when
USE_PICKER_COUNT==ep1Picker (uteach.cpp:3372/:3409, Ifor 20260109) and C++ already does
(WebMotorAccessLive.cpp:740 GoldenTeachRemap, single-axis TECH_PARA only). The hide check now applies the
same remap (USE_PICKER_COUNT read from Gerneral.ini via HT9045System; unreadable -> no remap, hides as
before); the Go hover hint names the axis that really moves (MInArmZA).

Checked headless against the live wb_serve 8055 (mock transport): In Arm Loader / Hot Plate / AutoClean /
In Shuttle and Out Arm Auto / Fix / Fix2 / Out Shuttle visible; Rotate / NG Bin / Preciser still hidden by
golden FormShow; Loader Cassette stays hidden; GoButtonPick1 hint = MInArmZA=-1600.
---
 page/HW.teach.html | 30 ++++++++++++++++++++++++++----
 1 file changed, 26 insertions(+), 4 deletions(-)

diff --git a/page/HW.teach.html b/page/HW.teach.html
index c1c32ce..093a6d0 100644
--- a/page/HW.teach.html
+++ b/page/HW.teach.html
@@ -1034,10 +1034,32 @@ function teachBindTechButtons(){
 //     motorIds 空的點（不動馬達）算有用、不藏；只要有一點有一軸能用就留著（照舊由 C++ 照 golden 決定哪一列）。
 //   * 一個數值格：掛著它的每一個點都被藏了才藏（存檔照樣送它的值：存檔讀的是 DOM，藏起來的格子值不變）。
 //   * 之後群組框裡看得到的按鈕／欄位都沒了，就整框藏（teachCollapseHiddenGroups）。
+// AI(W906-TEACH-1PICKZ) 20261004：EastSun 1004「grpInArmPick 怎麼看不到，我的ZA需要校正，In Arm 跟 Out Arm的Z軸的校正點位麻煩Show出」。
+//   Pick Up／Place 這些 Z 點 golden 掛在 MInArmZE／MOutArmZE（uteach.cpp:476-494），這台 ZE 是 Enable=0 ⇒ 上面的規則整組藏掉。
+//   但 golden 按 Set／Go 時單吸嘴（USE_PICKER_COUNT==ep1Picker=4）把 7／26 減 4 改成 ZA（uteach.cpp:3372／:3409 Ifor 20260109），
+//   C++ 已照做（WebMotorAccessLive.cpp:740 GoldenTeachRemap，只有單軸 TECH_PARA，兩軸那兩支沒有）。這裡判斷能不能用時套同一條換算。
+//   USE_PICKER_COUNT 讀 Gerneral.ini（HT9045System.read）；讀不到就不換（照舊藏），不猜。
+var teachOnePicker;                                   // undefined＝還沒讀；true／false＝已讀
+function teachGoldenTeachRemap(mid, pt){
+  if(teachOnePicker!==true || !pt || pt.type!=='TECH_PARA') return mid;
+  return mid==='MInArmZE' ? 'MInArmZA' : (mid==='MOutArmZE' ? 'MOutArmZA' : mid);
+}
 function teachHidePointsWithoutAxes(pts, elByTitle){
   if(!teachHideAxesOk()) return;
+  if(teachOnePicker===undefined){
+    var sys=window.HT9045System, again=function(){ teachHidePointsWithoutAxes(pts, elByTitle); };
+    if(!sys){ teachOnePicker=false; }
+    else{
+      sys.read('gerneral').then(function(doc){
+        var s=doc && doc.sections && doc.sections.System, v=s ? s.USE_PICKER_COUNT : null;
+        if(v && typeof v==='object') v=(v.raw!==undefined && v.raw!==null) ? v.raw : v.value;
+        teachOnePicker=(parseInt(String(v),10)===4);  // ep1Picker（MachineType.h ePickCount）
+      }, function(){ teachOnePicker=false; }).then(again);
+      return;
+    }
+  }
   var live=function(mid){ var mo=teachMotorById(mid); return !!mo && mo.enabledByDefault!==false; };
-  var ptLive=function(pt){ var ids=pt.motorIds||[]; if(!ids.length) return true; for(var i=0;i<ids.length;i++) if(live(ids[i])) return true; return false; };
+  var ptLive=function(pt){ var ids=pt.motorIds||[]; if(!ids.length) return true; for(var i=0;i<ids.length;i++) if(live(teachGoldenTeachRemap(ids[i], pt))) return true; return false; };
   var btnLive={}, fieldLive={};
   pts.forEach(function(pt){
     var l=ptLive(pt);
@@ -1079,8 +1101,8 @@ function teachBindGoHints(pts, elByTitle){
   pts.forEach(function(pt){
     [[pt.setButton,'Set'],[pt.goButton,'Go']].forEach(function(p){
       if(!p[0]) return;
-      var o=byBtn[p[0]]||(byBtn[p[0]]={kind:p[1], setBtn:pt.setButton, edits:[], motors:[]});
-      (pt.edits||[]).forEach(function(id,k){ if(o.edits.indexOf(id)<0){ o.edits.push(id); o.motors.push((pt.motorIds||[])[k]||''); } });
+      var o=byBtn[p[0]]||(byBtn[p[0]]={kind:p[1], setBtn:pt.setButton, edits:[], motors:[], pts:[]});
+      (pt.edits||[]).forEach(function(id,k){ if(o.edits.indexOf(id)<0){ o.edits.push(id); o.motors.push((pt.motorIds||[])[k]||''); o.pts.push(pt); } });
     });
   });
   Object.keys(byBtn).forEach(function(b){
@@ -1092,7 +1114,7 @@ function teachBindGoHints(pts, elByTitle){
     var cells=function(){ return o.edits.map(function(id){ return document.getElementById(id); }).filter(Boolean); };
     var show=function(){
       cells().forEach(function(e){ e.classList.add('teach-gohint'); });
-      var parts=o.edits.map(function(id,k){ var e=document.getElementById(id); return (o.motors[k]||id)+'='+(e?String(e.value):'?'); });
+      var parts=o.edits.map(function(id,k){ var e=document.getElementById(id); return (teachGoldenTeachRemap(o.motors[k], o.pts[k])||id)+'='+(e?String(e.value):'?'); });   // AI(W906-TEACH-1PICKZ) 20261004：寫真正會動的軸（單吸嘴 ZE→ZA）
       teachSetInfo(o.kind+' → '+label+'：'+(parts.join('、')||'（沒有欄位）')+'　['+b+']', 'warn');
     };
     var hide=function(){ cells().forEach(function(e){ e.classList.remove('teach-gohint'); }); };
-- 
