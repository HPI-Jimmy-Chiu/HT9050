From a35ec22233182743bc8edc8d88333d1ef0468694 Mon Sep 17 00:00:00 2001
From: "HT9045 Machine (V906)" <Claude_RDBC_02@honprec.com>
Date: Wed, 30 Sep 2026 16:22:45 +0800
Subject: [PATCH] TEACH-SH2 (web): ComputeInSh2 computes the placement offset
 like golden instead of being sent as a Set button

Button audit 20260930. golden SetComputeInSh2Click (uteach.cpp:5147-5157):
X/Y Offset = MOT[MInArmX/MInArmY].ReadPos() - atoi(setEditInSht2X/Y), written
into the two offset boxes only (Save writes the file). golden registers the
button as a TechTwoPara funButton, but that only sets GroupIndex/Tag
(:1491-1498); its OnClick stays SetComputeInSh2Click. The page bound it as a
generic SetButton* and C++ refused it ("not a teach Set/Go handler"), so the
button did nothing.
Now a page-side calculation: ReadPos = the Now Position value = runtime
cmdPos; golden atoi (blank/non-numeric = 0); if either position is unknown
nothing is written. No command is sent, no axis moves.
Offline check: Sh2 X=100, Y="abc", positions 0/0 -> X Offset -100, Y Offset 0,
no HTMotorAccess.send call.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 page/HW.teach.html | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/page/HW.teach.html b/page/HW.teach.html
index e6ab329..955e411 100644
--- a/page/HW.teach.html
+++ b/page/HW.teach.html
@@ -588,6 +588,23 @@ function teachBindMotionButtons(cat){
     HTMotorAccess.send('btnHome',{start:!(hb&&hb.classList.contains('down'))});
   });
   teachOn('btnStop','click',function(){ HTMotorAccess.send('btnStop'); });
+  //AI(W906-TEACH-SH2) 20260930: 按鈕稽核 —— SetComputeInSh2（Pickup Error Placement 頁「ComputeInSh2」）golden OnClick＝SetComputeInSh2Click
+  //   （uteach.cpp:5147-5157）：X/Y Offset＝MOT[MInArmX／MInArmY].ReadPos() − atoi(setEditInSht2X／Y)，只填兩個欄位（按存檔才寫檔）。
+  //   golden 雖然把它登記成 TechTwoPara 的 funButton，但登記只設 GroupIndex/Tag（:1491-1498），OnClick 沒被換掉；
+  //   原本這裡被 teachBindTechButtons 當成一般 Set 送 C++，C++ 回「不是教導點的 Set／Go 處理函式 —— 不做」，按了沒作用。
+  //   ReadPos＝畫面 Now Position 那個值（ScanNowMotorStatus :1342 edtNowPosition）＝runtime 的 cmdPos。讀不到就不寫（不寫 0：0 是合法座標）。
+  //   純畫面計算：不送任何命令給 C++、不動軸。teachOn 先標 data-acc，teachBindTechButtons 就不會再把它綁成 Set。
+  teachOn('SetComputeInSh2','click',function(){
+    var gAtoi=function(id){ var e=document.getElementById(id), m=/^\s*([+-]?\d+)/.exec(e?String(e.value):''); return m?parseInt(m[1],10):0; };   // golden atoi：空白／非數字＝0
+    var px=teachRuntimeLive ? ((teachRuntimeById('MInArmX').position)||{}).cmdPos : null;
+    var py=teachRuntimeLive ? ((teachRuntimeById('MInArmY').position)||{}).cmdPos : null;
+    if(typeof px!=='number' || typeof py!=='number'){ teachSetInfo('ComputeInSh2：讀不到 MInArmX／MInArmY 目前位置，沒有寫入', 'err'); return; }
+    var sx=gAtoi('setEditInSht2X'), sy=gAtoi('setEditInSht2Y');
+    var ex=document.getElementById('setEditInarmPlacementXOffsetByBasicSuck'), ey=document.getElementById('setEditInarmPlacementYOffsetByBasicSuck');
+    if(ex){ ex.value=String(px-sx); ex.setAttribute('data-src','ComputeInSh2'); }
+    if(ey){ ey.value=String(py-sy); ey.setAttribute('data-src','ComputeInSh2'); }
+    teachSetInfo('ComputeInSh2：X Offset='+(px-sx)+'（'+px+'−'+sx+'）、Y Offset='+(py-sy)+'（'+py+'−'+sy+'）（記得按存檔）', 'ok');
+  });
   teachOn('btnServo','click',function(){ HTMotorAccess.send('btnServo'); });   // AI(W906-W4-MOTOR) 20260925: 不再固定送 servoOn:true（那樣只能開不能關）；golden uteach btnServoClick 是 ServoOnOff(!Led[iServoOn])，由 C++ 依實際狀態取反
   //AI(W906-TEACH-ALMRST) 20260930: EastSun「圖片上 也幫我新增alarm reset 的按鈕」—— 清「Active Motor 選的那一軸」的警報，同 HW.MotorTest.html
   //   的 btnAlarmReset：送同一個 C++ 動作 resetAlarm（WebMotorAccess.cpp DoResetAlarm = Acm_AxResetError，只有 PCI1203 軸；C++ 不分頁面來源）。
