From fd75fc85daafb1af59fc990123d32b451ffa73c7 Mon Sep 17 00:00:00 2001
From: "HT9045 Machine (V906)" <Claude_RDBC_02@honprec.com>
Date: Thu, 1 Oct 2026 17:05:52 +0800
Subject: [PATCH] TEACH-TRAYZ (web): the Teach page shows golden's Tray Z teach
 points (Loader / Empty / Auto1-3 ...) when Gerneral.ini [TrayZ] *_Z_USE_MOTOR
 says so
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

EastSun 1001 (Tray Arm screenshot): "是不是有loader auto1 auto2 auto3 empty 的校正畫面 都幫我弄出來". golden TfTeach has them: tab Tray Arm,
group gbTrayZ 'Tray Z Motor' (panels pnlLoaderZ / pnlEmptyZ / pnlColorZ / pnlAuto1Z..6Z: Set / GO / value), and on Axle Control
grpTrayZAxis + grpAuto456 (jog). The page already had them, wired, but hard-coded display:none; nothing ever showed them.
New hand-written page\ht9045_teach_trayz_c.js applies golden FormShow (uteach.cpp:1823-1826 gbTrayZ / grpTrayZAxis = any flag,
:1844-1852 each pnl*Z = its own flag, :1853-1855 grpAuto456 = Auto4..6; jog buttons :821-829) from the live [TrayZ] flags
(read-only HT9045System.read('gerneral'), as the Vacuum Adj. menu rule), on every open of the Teach window; a failed read
keeps everything hidden (golden's DFM default) and says why. HW.teach.html: one <script> line. Today all nine flags are 0
-> nothing changes until EastSun ticks them in HandlerSys 'Tray Z Use Motor'.
Offline tests (headless Edge, stubbed reader): all 0 -> hidden; Loader/Empty/Auto1-3 = 1 -> those five + groups shown,
Color / Auto4-6 hidden; read failure -> hidden + reason; reopen re-applies. Syntax check exit 0.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 page/HW.teach.html           |   1 +
 page/ht9045_teach_trayz_c.js | 210 +++++++++++++++++++++++++++++++++++
 2 files changed, 211 insertions(+)
 create mode 100644 page/ht9045_teach_trayz_c.js

diff --git a/page/HW.teach.html b/page/HW.teach.html
index 58de733..e2124cb 100644
--- a/page/HW.teach.html
+++ b/page/HW.teach.html
@@ -892,5 +892,6 @@ function teachBindTechButtons(){
 <script src="ht9045_wire_livesettings.js"></script>
 <script src="ht9045_wire_engine.js"></script>
 <script src="ht9045_wire_hwteach.js"></script>
+<script src="ht9045_teach_trayz_c.js"></script><!-- AI(W906-TEACH-TRAYZ) 20261001: golden FormShow Tray Z visibility (uteach.cpp:1823-1826 gbTrayZ/grpTrayZAxis, :1844-1852 pnl*Z, :1853-1855 grpAuto456; jog buttons :821-829) from Gerneral.ini [TrayZ] *_Z_USE_MOTOR (database.cpp:760-768), re-applied on every window show (HT_WIN). Hand-written, not generated. -->
 </body>
 </html>
diff --git a/page/ht9045_teach_trayz_c.js b/page/ht9045_teach_trayz_c.js
new file mode 100644
index 0000000..4fc4441
--- /dev/null
+++ b/page/ht9045_teach_trayz_c.js
@@ -0,0 +1,210 @@
+/* ht9045_teach_trayz_c.js -- HW.teach.html（golden TfTeach，uteach.cpp／uteach.dfm V906）Tray Z 群組的顯示規則。
+ * ---------------------------------------------------------------------------
+ * AI(W906-TEACH-TRAYZ) 20261001: 手寫，不是 gen_wire.py 產物；檔名刻意不叫 ht9045_wire_<slug>.js，免得產生器覆蓋
+ *   （gen_wire.py 只寫 ht9045_wire_<slug>.js，見 scratchpad/gen_wire.py:1073-1074／:1095-1096）。
+ *
+ * 問題：頁面上 Tray Arm 頁的 gbTrayZ（Tray Z Motor）、Axle Control 頁的 grpTrayZAxis／grpAuto456（Tray Z 軸選取鈕）
+ *   照 .dfm 寫死 display:none（uteach.dfm:10685／:12205／:12306 Visible = False），從來沒有東西把它們打開；
+ *   引擎的 visible 只改 style.visibility（ht9045_wire_engine.js:1183），蓋不過 display:none。
+ *
+ * golden（每次 Show 都跑，uteach.cpp:1413 TfTeach::FormShow）：
+ *   uteach.cpp:1823-1825  gbTrayZ->Visible = LOAD_Z_USE_MOTOR[0] || ... || LOAD_Z_USE_MOTOR[8]
+ *   uteach.cpp:1826       grpTrayZAxis->Visible = gbTrayZ->Visible
+ *   uteach.cpp:1844-1852  pnlLoaderZ／pnlEmptyZ／pnlColorZ／pnlAuto1Z..pnlAuto6Z ->Visible = LOAD_Z_USE_MOTOR[0..8]
+ *   uteach.cpp:1853-1855  grpAuto456->Visible = LOAD_Z_USE_MOTOR[6] || [7] || [8]
+ *   另外 grpTrayZAxis／grpAuto456 裡的軸選取鈕：uteach.cpp:821-829（建構子 TfTeach::TfTeach :254）
+ *     TECH_MotorAxle(MLoaderZ, MotorLoaderZ, LOAD_Z_USE_MOTOR[0]) ... (MAuto6Z, MotorAuto6Z, LOAD_Z_USE_MOTOR[8])
+ *     → uteach.cpp:217 SelButton->Visible = Visible。也照同一組旗標顯示／隱藏
+ *     （golden 只在建構時算一次；這裡每次開窗重算 —— 旗標沒變時結果一樣，HandlerSys 改了旗標之後不必重開程式）。
+ * 旗標：database.cpp:760-768 LOAD_Z_USE_MOTOR[i] = CheckAndReadIniDataGeneral("TrayZ", <KEY>, false)
+ *   （bool 版，common.cpp:1457-1464：鍵不在＝寫入預設 false 並回 false；在＝TIniFile::ReadBool ＝ ReadInteger(...) <> 0）。
+ *   值從 wb_serve 的 GET /api/system/gerneral 即時讀（HT9045System.read，同 main.html Vacuum Adj. 的規則，唯讀）。
+ *
+ * gbTrayZ 是 Align = alTop（uteach.dfm:10676），排在 pnlTrayArm（alTop，0～321）與 gbTrayArmZ（alTop，321～438，
+ *   uteach.cpp:1827 只在 TRAY_ARM_MODE==eUnderCoveyor 顯示）之後。VCL 排 alTop 時跳過看不見的控制項，
+ *   所以 gbTrayArmZ 藏著時 gbTrayZ 在執行期是貼在 321，不是 .dfm 的 438。顯示時照這個規則算 top。
+ *
+ * 失敗（讀不到／回應不對）＝照 golden .dfm 預設全部藏起來，原因寫在右下角狀態（teachSetInfo）與三個群組的 data-rule；
+ *   不改任何 id／title（title 是 theme.js／teachAttachMotorButtons 查元件的鍵）。不送任何命令、不寫任何檔。
+ *
+ * 「開窗」＝外框 background.html postWinState 的 HT_WIN {type, id, open, state, initial}（background.html:686-698）：
+ *   關→開（含 initial 時視窗本來就開著）跑一次＝golden FormShow；最小化 open 仍是 true，不重跑（golden 最小化不跑 FormShow）。
+ *   單獨開這一頁（沒有外框）＝載入時跑一次；嵌在別的頁面 3 秒沒收到 HT_WIN＝照舊跑一次（同 ht9045_wire_engine.js H4）。
+ * ---------------------------------------------------------------------------
+ */
+(function (global) {
+  'use strict';
+
+  // AI(W906-TEACH-TRAYZ) 20261001: database.cpp:760-768 的鍵，索引＝LOAD_Z_USE_MOTOR[i]
+  var KEYS = ['LOAD_Z_USE_MOTOR', 'EMPTY_Z_USE_MOTOR', 'COLOR_Z_USE_MOTOR',
+              'AUTO1_Z_USE_MOTOR', 'AUTO2_Z_USE_MOTOR', 'AUTO3_Z_USE_MOTOR',
+              'AUTO4_Z_USE_MOTOR', 'AUTO5_Z_USE_MOTOR', 'AUTO6_Z_USE_MOTOR'];
+  // AI(W906-TEACH-TRAYZ) 20261001: uteach.cpp:1844-1852
+  var PANELS = ['pnlLoaderZ', 'pnlEmptyZ', 'pnlColorZ', 'pnlAuto1Z', 'pnlAuto2Z', 'pnlAuto3Z',
+                'pnlAuto4Z', 'pnlAuto5Z', 'pnlAuto6Z'];
+  // AI(W906-TEACH-TRAYZ) 20261001: uteach.cpp:821-829
+  var JOGS = ['MotorLoaderZ', 'MotorEmptyZ', 'MotorColorZ', 'MotorAuto1Z', 'MotorAuto2Z', 'MotorAuto3Z',
+              'MotorAuto4Z', 'MotorAuto5Z', 'MotorAuto6Z'];
+  var GROUPS = ['gbTrayZ', 'grpTrayZAxis', 'grpAuto456'];
+  // AI(W906-TEACH-TRAYZ) 20261001: gbTrayZ 前面的 alTop 兄弟（.dfm 順序 pnlTrayArm Top=0、gbTrayArmZ Top=321）
+  var ALTOP_BEFORE_GBTRAYZ = ['pnlTrayArm', 'gbTrayArmZ'];
+  var GBTRAYZ_DFM_TOP = 438;                                     // uteach.dfm:10673
+
+  // ---- 旗標解讀：照 BCB6 TIniFile::ReadBool ＝ StrToIntDef(ReadString, Ord(Default)) <> 0 ----
+  // AI(W906-TEACH-TRAYZ) 20261001: Delphi Val：前導空白可、+/- 號、'$'／'x'／'0x' 十六進位；其餘（空字串、尾巴有字、溢位）＝預設值。
+  function strToIntDef(s, dflt) {
+    if (typeof s !== 'string') return dflt;
+    var m = /^ *([+-]?)(?:(?:\$|0?[xX])([0-9a-fA-F]+)|([0-9]+))$/.exec(s);
+    if (!m) return dflt;
+    var n;
+    if (m[2] !== undefined) {
+      if (m[2].length > 8) return dflt;
+      n = parseInt(m[2], 16) | 0;                                // 32 位元環繞（$FFFFFFFF＝-1）
+    } else {
+      n = parseInt(m[3], 10);
+      if (n > 2147483648 || (n === 2147483648 && m[1] !== '-')) return dflt;
+    }
+    return m[1] === '-' ? -n : n;
+  }
+  // 回應一筆是 {value,type,raw,bcb}（ht9045_recipe_client.js:412）；bcb＝GetPrivateProfileString 讀到的字（WebBridgeRecipeDoc.cpp:173），優先用它
+  function iniBool(e) {
+    if (e && typeof e === 'object') {
+      if (typeof e.bcb === 'string') return strToIntDef(e.bcb, 0) !== 0;
+      if (typeof e.raw === 'string') return strToIntDef(e.raw, 0) !== 0;
+      e = e.value;
+    }
+    if (typeof e === 'boolean') return e;
+    if (typeof e === 'number') return e !== 0;
+    if (e === undefined || e === null) return false;
+    return strToIntDef(String(e), 0) !== 0;
+  }
+  // INI 的區段名／鍵名不分大小寫（GetPrivateProfileString）
+  function pick(obj, name) {
+    if (!obj || typeof obj !== 'object') return undefined;
+    if (Object.prototype.hasOwnProperty.call(obj, name)) return obj[name];
+    var low = name.toLowerCase(), ks = Object.keys(obj);
+    for (var i = 0; i < ks.length; i++) if (ks[i].toLowerCase() === low) return obj[ks[i]];
+    return undefined;
+  }
+
+  // ---- golden FormShow 的規則（純函式，給測試用）----
+  function compute(flags) {
+    var f = [], i, v = {};
+    for (i = 0; i < 9; i++) f.push(!!(flags && flags[i]));
+    v.gbTrayZ = f[0] || f[1] || f[2] || f[3] || f[4] || f[5] || f[6] || f[7] || f[8];   // uteach.cpp:1823-1825
+    v.grpTrayZAxis = v.gbTrayZ;                                                        // uteach.cpp:1826
+    v.grpAuto456 = f[6] || f[7] || f[8];                                               // uteach.cpp:1853-1855
+    for (i = 0; i < 9; i++) { v[PANELS[i]] = f[i]; v[JOGS[i]] = f[i]; }               // :1844-1852／:821-829
+    return v;
+  }
+
+  function $(id) { return document.getElementById(id); }
+  function shownNow(el) {
+    if (!el || el.style.display === 'none') return false;
+    try { return global.getComputedStyle(el).display !== 'none'; } catch (e) { return true; }
+  }
+  function px(el, prop) { var n = el ? parseInt(el.style[prop], 10) : NaN; return isNaN(n) ? 0 : n; }
+  // AI(W906-TEACH-TRAYZ) 20261001: VCL alTop（uteach.dfm:10676）—— gbTrayZ 的 top＝前面看得見的 alTop 兄弟高度總和
+  function alignTopGbTrayZ() {
+    var gb = $('gbTrayZ'); if (!gb) return;
+    var y = 0, all = true;
+    for (var i = 0; i < ALTOP_BEFORE_GBTRAYZ.length; i++) {
+      var s = $(ALTOP_BEFORE_GBTRAYZ[i]);
+      if (!s) { all = false; continue; }
+      if (shownNow(s)) y += px(s, 'height');
+    }
+    gb.style.top = (all ? y : GBTRAYZ_DFM_TOP) + 'px';           // 找不到兄弟（頁面改版）就留 .dfm 座標
+  }
+
+  function setDisp(id, show) { var el = $(id); if (el) el.style.display = show ? '' : 'none'; return !!el; }
+  function info(msg, cls) {
+    if (typeof global.teachSetInfo === 'function') { try { global.teachSetInfo(msg, cls); return; } catch (e) {} }
+    if (global.console) console.warn('[TrayZ] ' + msg);
+  }
+
+  var ST = { ok: null, reason: '', flags: null, missing: [], seq: 0, at: 0, visible: null, why: '' };
+
+  function applyVisible(v) {
+    var missingIds = [];
+    GROUPS.concat(PANELS, JOGS).forEach(function (id) { if (!setDisp(id, v[id])) missingIds.push(id); });
+    if (v.gbTrayZ) alignTopGbTrayZ();
+    GROUPS.forEach(function (id) { var el = $(id); if (el) el.removeAttribute('data-rule'); });
+    return missingIds;
+  }
+  function hideAll(reason) {
+    GROUPS.concat(PANELS, JOGS).forEach(function (id) { setDisp(id, false); });
+    var g = $('gbTrayZ'); if (g) g.style.top = GBTRAYZ_DFM_TOP + 'px';
+    GROUPS.forEach(function (id) { var el = $(id); if (el) el.setAttribute('data-rule', 'Tray Z 顯示規則未套用：' + reason); });
+  }
+
+  function readFlags() {
+    if (!global.HT9045System || typeof global.HT9045System.read !== 'function')
+      return Promise.reject(new Error('HT9045System 不存在（ht9045_recipe_client.js 沒載入）'));
+    return global.HT9045System.read('gerneral').then(function (d) {
+      if (!d || typeof d !== 'object') throw new Error('回應不是 JSON 物件');
+      if (d.available === false) throw new Error('伺服器回報 Gerneral.ini 不在（available:false' + (d.path ? '，' + d.path : '') + '）');
+      if (!d.sections || typeof d.sections !== 'object') throw new Error('回應沒有 sections');
+      var sec = pick(d.sections, 'TrayZ'), flags = [], missing = [];
+      for (var i = 0; i < KEYS.length; i++) {
+        var e = pick(sec, KEYS[i]);
+        if (e === undefined || e === null) { missing.push(KEYS[i]); flags.push(false); }   // golden common.cpp:1460 鍵不在＝false
+        else flags.push(iniBool(e));
+      }
+      return { flags: flags, missing: missing, path: d.path || '' };
+    });
+  }
+
+  // AI(W906-TEACH-TRAYZ) 20261001: 一次 golden FormShow（uteach.cpp:1823-1855 這一段）
+  function formShow(why) {
+    var my = ++ST.seq, wasFailed = (ST.ok === false);
+    ST.why = why || '';
+    return readFlags().then(function (r) {
+      if (my !== ST.seq) return ST;                                // 較新的一次開窗已經在讀，這一次作廢
+      var v = compute(r.flags), lost = applyVisible(v);
+      ST.ok = true; ST.reason = ''; ST.flags = r.flags; ST.missing = r.missing; ST.at = Date.now(); ST.visible = v;
+      document.documentElement.setAttribute('data-trayz', 'ok');
+      if (lost.length) info('Tray Z：頁面上找不到 ' + lost.join(', ') + '（頁面改版？）', 'warn');
+      else if (r.missing.length) info('Tray Z：Gerneral.ini [TrayZ] 沒有 ' + r.missing.join(', ') + ' —— 照 golden 當成 0（不顯示）', 'warn');
+      else if (wasFailed) info('Tray Z：已照 Gerneral.ini [TrayZ] 套用顯示規則', 'ok');
+      return ST;
+    }, function (e) {
+      if (my !== ST.seq) return ST;
+      var reason = (e && e.message) || String(e);
+      hideAll(reason);
+      ST.ok = false; ST.reason = reason; ST.flags = null; ST.missing = []; ST.at = Date.now(); ST.visible = null;
+      document.documentElement.setAttribute('data-trayz', 'fail');
+      var msg = 'Tray Z：讀不到 Gerneral.ini [TrayZ]（' + reason + '）—— Tray Z Motor／Tray Z 軸選取照 golden 預設不顯示';
+      info(msg, 'warn');
+      // 狀態列是共用的，頁面載入時其他初始化可能接著蓋掉；3 秒後還是這一次失敗就再講一次
+      setTimeout(function () { if (my === ST.seq && ST.ok === false) info(msg, 'warn'); }, 3000);
+      return ST;
+    });
+  }
+
+  // ---- 開窗時機（HT_WIN），同 ht9045_wire_engine.js H4（:2064-2072／:2137-2141）----
+  var W = { hosted: false, shown: false, timer: null };
+  global.addEventListener('message', function (ev) {
+    var m = ev && ev.data;
+    if (!m || m.type !== 'HT_WIN') return;
+    if (global.parent === global || ev.source !== global.parent) return;
+    W.hosted = true;
+    if (W.timer) { clearTimeout(W.timer); W.timer = null; }
+    if (m.open && !W.shown) { W.shown = true; formShow('HT_WIN open' + (m.initial ? ' (initial)' : '')); }
+    else if (!m.open) W.shown = false;
+  });
+  function boot() {
+    if (global.parent === global) { formShow('standalone'); return; }
+    if (!W.hosted && !W.timer) W.timer = setTimeout(function () {
+      W.timer = null;
+      if (!W.hosted) formShow('no HT_WIN in 3 s');
+    }, 3000);
+  }
+  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot, { once: true });
+  else boot();
+
+  global.HT9045TeachTrayZ = {
+    KEYS: KEYS, PANELS: PANELS, JOGS: JOGS, GROUPS: GROUPS,
+    compute: compute, iniBool: iniBool, strToIntDef: strToIntDef,
+    formShow: formShow, state: ST
+  };
+})(window);
-- 
