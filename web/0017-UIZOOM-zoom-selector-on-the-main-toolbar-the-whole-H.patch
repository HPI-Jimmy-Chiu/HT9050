EastSun 20260930: "我覺得ui畫面太小 你有辦法做選項 讓我選全部放大幾趴嗎".
- page/main.html: select #selZoom (80/90/100/110/125/150/175/200 %) next to the theme / language selectors; posts
  {setZoom:pct} to background.html, shows HT_ZOOM.
- background.html: --uiz on :root, #desktop{zoom:var(--uiz)} -- windows, title bars and the iframes' content scale together
  (Chromium applies a parent's CSS zoom to iframe content; measured 20260930 with headless Edge). Full-screen layers
  (.win.htFull, fixed 100vw/100vh inside the canvas) are divided by the factor so they still fill the screen. Window drag /
  resize deltas are divided by the factor so a window follows the mouse. Saved in localStorage('ht9xxx-ui-zoom');
  ?zoom=N overrides for a test.
Checked: headless Edge screenshots of background.html at 100 % and 125 % (everything scaled, canvas scrolls).

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 background.html | 23 ++++++++++++++++++++++-
 page/main.html  | 23 +++++++++++++++++++++++
 2 files changed, 45 insertions(+), 1 deletion(-)

diff --git a/background.html b/background.html
index 7f75bbc..975fa07 100644
--- a/background.html
+++ b/background.html
@@ -101,6 +101,12 @@
     height:20px;font-size:12px;background:#a33;color:#fff;border-color:#722;}
   .win.htFull .tbar button.hmExit:hover{background:#c44;}
   .win.htFull .tbar{cursor:default;}
+  /* AI(W906-UIZOOM) 20260930：EastSun「我覺得ui畫面太小 你有辦法做選項 讓我選全部放大幾趴嗎」—— main.html 工具列的 🔍 下拉。
+     整張畫布（#desktop）CSS zoom：視窗、標題列、iframe 裡的內容一起放大（Chromium 對 iframe 內容也套用，20260930 實測）。
+     全螢幕層（position:fixed 100vw／100vh）在畫布裡面，先除以倍率，放大後剛好等於畫面。倍率存 localStorage('ht9xxx-ui-zoom')。 */
+  :root{--uiz:1;}
+  #desktop{zoom:var(--uiz);}
+  .win.htFull{width:calc(100vw / var(--uiz)) !important;height:calc(100vh / var(--uiz)) !important;}
   /* ⚠ 刻意醒目：這是「訊號不存在所以暫時放寬」的標示。一個靜默的放寬比擋住更危險。 */
   .htGuardBanner{flex:none;background:#7a2b00;color:#ffd9b0;font-size:13px;font-weight:bold;
     padding:6px 10px;border-bottom:2px solid #ff8c1a;white-space:pre-wrap;}
@@ -1045,12 +1051,23 @@ function refreshTasks(){
   });
 }
 
+// AI(W906-UIZOOM) 20260930：畫面縮放（main.html 🔍）。pct＝80..200；存 localStorage，套在 :root 的 --uiz（CSS 見 #desktop）。
+var UIZ_KEY='ht9xxx-ui-zoom', UIZ_LIST=[80,90,100,110,125,150,175,200];
+function uiZoom(){ var v=parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--uiz')); return (v>0)?v:1; }
+function applyUiZoom(pct){
+  pct=parseInt(pct,10); if(UIZ_LIST.indexOf(pct)<0) pct=100;
+  document.documentElement.style.setProperty('--uiz', String(pct/100));
+  try{ if(pct===100) localStorage.removeItem(UIZ_KEY); else localStorage.setItem(UIZ_KEY, String(pct)); }catch(e){}
+  return pct;
+}
+(function(){ var s=null; try{ s=localStorage.getItem(UIZ_KEY); }catch(e){}; var m=/[?&]zoom=(\d+)/.exec(location.search); if(m) s=m[1]; if(s) applyUiZoom(s); })();
+
 // 共用拖曳器：drag 期間停用 iframe 滑鼠事件
 function startDrag(e,onMove,org){
   e.preventDefault();
   document.body.classList.add('dragging');
   var sx=e.clientX,sy=e.clientY;
-  function mv(ev){onMove(ev.clientX-sx,ev.clientY-sy,org);}
+  function mv(ev){var z=uiZoom(); onMove((ev.clientX-sx)/z,(ev.clientY-sy)/z,org);}   // AI(W906-UIZOOM) 20260930：滑鼠位移是螢幕像素、視窗位置是畫布像素 ⇒ 除以倍率，視窗才跟著滑鼠走
   function up(){
     document.body.classList.remove('dragging');
     document.removeEventListener('mousemove',mv);
@@ -1206,6 +1223,10 @@ window.addEventListener('message',function(e){
     try{localStorage.setItem('ht9xxx-lang',e.data.setLang);}catch(err){}
     broadcastAll({type:'HT_LANG',lang:e.data.setLang});
   }
+  if(e.data.setZoom!==undefined){                     // AI(W906-UIZOOM) 20260930：main.html 🔍 畫面縮放
+    var zp=applyUiZoom(e.data.setZoom);
+    broadcastAll({type:'HT_ZOOM',zoom:zp});
+  }
   if(e.data.setFont!==undefined){
     window.HTFont.set(e.data.setFont);
     broadcastAll({type:'HT_FONT',font:e.data.setFont});
diff --git a/page/main.html b/page/main.html
