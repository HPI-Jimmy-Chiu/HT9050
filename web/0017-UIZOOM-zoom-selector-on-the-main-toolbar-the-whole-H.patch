@@ -50,6 +50,17 @@
     <option value="ja">日本語</option>
     <option value="ko">한국어</option>
   </select>
+  <!-- AI(W906-UIZOOM) 20260930：EastSun「我覺得ui畫面太小 你有辦法做選項 讓我選全部放大幾趴嗎」—— 整個操作畫面放大（background.html #desktop） -->
+  <select id="selZoom" class="tbSel" title="畫面縮放 Zoom">
+    <option value="80">🔍 80%</option>
+    <option value="90">🔍 90%</option>
+    <option value="100">🔍 100%</option>
+    <option value="110">🔍 110%</option>
+    <option value="125">🔍 125%</option>
+    <option value="150">🔍 150%</option>
+    <option value="175">🔍 175%</option>
+    <option value="200">🔍 200%</option>
+  </select>
 
   <!-- Tools 子選單：palSetup（sbSettingClick → palSetup->Visible=true） -->
   <div class="submenu" id="palSetup" title="palSetup">
@@ -535,6 +546,18 @@ document.querySelectorAll('#palConfig .smi').forEach(function(el){
     if(ev.data&&ev.data.type==='HT_THEME') sel.value=ev.data.theme;
   });
 })();
+// ===== AI(W906-UIZOOM) 20260930：畫面縮放 —— 請 background.html 放大整張畫布（它存 localStorage('ht9xxx-ui-zoom')，重開也記得）=====
+(function(){
+  var sel=document.getElementById('selZoom'); if(!sel) return;
+  var cur='100'; try{ cur=localStorage.getItem('ht9xxx-ui-zoom')||'100'; }catch(e){}
+  sel.value=cur; if(sel.selectedIndex<0) sel.value='100';
+  sel.addEventListener('change',function(){
+    if(window.parent!==window) window.parent.postMessage({setZoom:parseInt(sel.value,10)},'*');
+  });
+  window.addEventListener('message',function(ev){
+    if(ev.data&&ev.data.type==='HT_ZOOM') sel.value=String(ev.data.zoom);
+  });
+})();
