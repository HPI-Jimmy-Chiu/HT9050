Subject: [PATCH] =?UTF-8?q?VACUNIT-OPENFAIL=20(web):=20when=20C++=20refuse?=
 =?UTF-8?q?s=20to=20open=20Vacuum=20Unit,=20the=20page=20says=20why=20inst?=
 =?UTF-8?q?ead=20of=20"=E7=AD=89=20C++=20=E7=9A=84=E5=8D=B3=E6=99=82?=
 =?UTF-8?q?=E5=BF=AB=E7=85=A7"=20forever?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

EastSun 1001 14:49 (screenshot, "這是在鎖啥?"): oplog "editlist.get not-authorized: 等級不足：工具選單需要等級 0 ... 目前登入
Operator(0)" (golden sbSettingClick fSecurity->Insufficient(0)). A refused open never sends vacuum.open, so every hardware
button kept the wait note. Now the refusal locks the buttons with the C++ reason (+ "請用 Engineer 以上登入，再從 Tools 開一次"
for a level refusal) and shows it on the bar; the rejection still reaches the engine as before.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 page/ht9045_vacuumunit_c.js | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/page/ht9045_vacuumunit_c.js b/page/ht9045_vacuumunit_c.js
index fcf0f19..ea2efbc 100644
--- a/page/ht9045_vacuumunit_c.js
+++ b/page/ht9045_vacuumunit_c.js
@@ -145,6 +145,18 @@
       buildMissing(d);                       // 引擎在這個 promise 的 then 裡才套值：元件要先在
       setTimeout(vuOpen, 0);                 // (3) golden FormShow 跑完（editlist.get）→ 即時畫面開始
       return d;
+    }, function (e) {
+      // AI(W906-VACUNIT-OPENFAIL) 20261001: the open itself was refused (EastSun 1001 14:49, screenshot "這是在鎖啥?":
+      // oplog `editlist.get not-authorized: 等級不足：工具選單需要等級 0 ... 目前登入 Operator(0)` -- golden
+      // sbSettingClick fSecurity->Insufficient(0)). Without this the buttons kept WAIT_NOTE ("等 C++ 的即時快照")
+      // forever: vacuum.open is never sent when the open is refused. Now the lock and the bar say the real reason.
+      var m = String(e && e.message || e);
+      var why = /not-authorized|等級不足|權限/.test(m)
+        ? '權限不足，Vacuum Unit 沒有打開：' + m.replace(/^not-authorized:\s*/, '') + '\n→ 請用 Engineer 以上登入，再從 Tools 開一次'
+        : 'Vacuum Unit 沒有打開（C++ 拒絕開頁）：' + m;
+      lockStatic(why);
+      sayNow('🔒 ' + why, '#f88');
+      throw e;
     });
   };
 
