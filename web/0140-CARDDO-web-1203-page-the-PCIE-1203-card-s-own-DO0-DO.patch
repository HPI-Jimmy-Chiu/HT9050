From 2685b772945a7b3cfd5cc33f1bcaf1d41e945de9 Mon Sep 17 00:00:00 2001
From: "HT9045 Machine (V906)" <Claude_RDBC_02@honprec.com>
Date: Thu, 8 Oct 2026 19:05:58 +0800
Subject: [PATCH] CARDDO (web): 1203 page -- the PCIE-1203 card's own DO0 /
 DO1, explicit ON / OFF buttons (pci1203.carddo.setBit) -- EastSun 1008 'add
 DO0 DO1 buttons on the 1203 page'.

js/pci1203/view.js: the default view appends sectionCardDo (end of file) after sectionDO; no read-back is published for these two bits, so ON / OFF instead of a toggle. Not yet confirmed on the machine that the channel is the card's own DO.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 js/pci1203/view.js | 37 ++++++++++++++++++++++++++++++++++++-
 1 file changed, 36 insertions(+), 1 deletion(-)

diff --git a/js/pci1203/view.js b/js/pci1203/view.js
index e9c8b8f..e985bf9 100644
--- a/js/pci1203/view.js
+++ b/js/pci1203/view.js
@@ -5511,7 +5511,7 @@ export function buildReport(tags, linkState, opts) {
   /* Default and ?view=io: every attributed byte, grouped by station. This is
      the landing pane because "IO 可以讀" is the first thing asked of the page. */
   root.appendChild(sectionIO(tags, o));
-  root.appendChild(sectionDO(tags));
+  root.appendChild(sectionDO(tags));  root.appendChild(sectionCardDo(tags));   /* AI(W906-CARDDO) 20261008: the PCIE-1203 card own DO0 / DO1 (end of file) */
   return root;
 }
 
@@ -5639,3 +5639,38 @@ function motRailText(addr, sub, dial) {
   const names = list.map(x => `${x.no} ${x.alias}${x.on ? "" : " (停用)"}`.trim()).join(" / ");
   return `${names ? names : "Mot_Table 沒有這軸"} · 站 ${station} · `;
 }
+
+/* AI(W906-CARDDO) 20261008: EastSun 1008「你1203 頁面 可以幫我多加 DO0 DO1 按鈕嗎?」→「按鈕先寫上 我去測試就對了」.
+   The PCIE-1203 CARD's OWN digital outputs (device DIO -- no ring, no station): Advantech example Examples\Windows\BCB\Device DIO
+   writes them with Acm_DaqDoSetBit(device, channel, value). The C++ side (EtherCAT/Pci1203Control.cpp kCmdDevDoSetBit,
+   wire "pci1203.carddo.setBit" target "pci1203.carddo.bit<0|1>") accepts channel 0 and 1 only. No read-back is published for
+   these two bits, so the controls are explicit ON / OFF buttons, not a toggle (a toggle cannot know what to send); the result of
+   each press is in the page's last-command record. ⚠ Not yet confirmed on the machine that channel N here is the card's own DO
+   and not channel N of the ring's flat numbering -- that is what this button is for. */
+function sectionCardDo(tags) {
+  const armed = controlArmed(tags);
+  const dry   = controlDry(tags);
+  const s = el("section");
+  s.appendChild(el("h2", null, "卡片本機 DO（PCIE-1203 本身，沒有站號）"));
+  s.appendChild(el("p", null,
+    (!armed ? "1203 控制沒有開啟：按了也不會送出（後端會拒絕）。"
+            : dry ? "DRY RUN：只記錄會呼叫什麼，不會真的輸出。"
+                  : "LIVE：會真的輸出到卡片本身的 DO。") +
+    " 送出 Acm_DaqDoSetBit(卡片, 通道, 值)。這兩點沒有讀回，結果看「最後一筆指令」。"));
+  const t = el("table");
+  for (const ch of [0, 1]) {
+    const tr = el("tr");
+    tr.appendChild(el("td", null, `DO${ch}`));
+    const on = el("td");
+    on.appendChild(cmdButton("ON", "pci1203.carddo.setBit", `pci1203.carddo.bit${ch}`,
+                             { value: 1, title: `卡片本機 DO${ch} → ON` }));
+    const off = el("td");
+    off.appendChild(cmdButton("OFF", "pci1203.carddo.setBit", `pci1203.carddo.bit${ch}`,
+                              { value: 0, title: `卡片本機 DO${ch} → OFF` }));
+    tr.appendChild(on);
+    tr.appendChild(off);
+    t.appendChild(tr);
+  }
+  s.appendChild(t);
+  return s;
+}
\ No newline at end of file
