From 45dd338d019607296ebe5ab5af11e2a3d22d6d7c Mon Sep 17 00:00:00 2001
From: "HT9045 Machine (V906)" <Claude_RDBC_02@honprec.com>
Date: Sat, 3 Oct 2026 16:15:38 +0800
Subject: [PATCH] TEMPSET-CLIP (web): Temperature setting page -- (1) the three
 grey PreOffset / PreOfsTime / AfterOfs boxes golden hides
 (MyTempPanel.cpp:225/237/249 Visible=false; C++ ELKeep forced them visible)
 hidden again, so Plate/SH/Head/Chamber values are no longer cut to '57.'; (2)
 the Panel17 column titles filled from golden uTemp_Set.dfm:10548-10638 (By
 Setup OffSet / Single Limit / Individual Temperature / Initial Temp. Offset /
 EOT Extra Temp Offset, #517A91 white centred); (3) the engine status bar
 docked in the empty part of the Save/Exit strip instead of over the offset
 table (EastSun: nothing may cover the screen); offset panes scroll instead of
 clipping -- EastSun 1003

---
 page/Setup.Temp_Set.html | 24 ++++++++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/page/Setup.Temp_Set.html b/page/Setup.Temp_Set.html
index a6d897a..54073f3 100644
--- a/page/Setup.Temp_Set.html
+++ b/page/Setup.Temp_Set.html
@@ -52,6 +52,17 @@
   /* AI(W906-CLIPFIX) 20261001：ATC FFC 頁的「Point10」勾選框（edFFC_Arm1Enable_10／edFFC_Arm2Enable_10，dfm Width=54）——
      替代字型比 golden 的 MS Sans Serif 寬，字尾「0」被自己的框切掉 1～2px；右邊 5px 內沒有其他元件，讓字超出框一點點（不裁）。 */
   #edFFC_Arm1Enable_10,#edFFC_Arm2Enable_10{overflow:visible;}
+  /* AI(W906-TEMPSET-PREOFS) 20261003: EastSun「這畫面都被截掉了」-- golden MyTempPanel.cpp:225/237/249 sets edPreOffset/edPreOfsTime/edAfterOfs
+     Visible=false and no golden code shows them again. C++ ELKeep (FileRW/_EditList.cpp:79) forces Visible=true, so the page showed three grey
+     boxes at 212/273/334 covering edLowbase/edBase/edHighBase ("57." clipped). Hidden as golden (!important: after() resets display). */
+  .tpPal input[id$="_edPreOffset"],.tpPal input[id$="_edPreOfsTime"],.tpPal input[id$="_edAfterOfs"]{display:none!important;}
+  /* the offset table may grow (Tri-Temp adds rows): scroll, never clip */
+  #pgcTempOffset .pcPane{overflow:auto;}
+  /* AI(W906-TEMPSET-BARDOCK) 20261003: EastSun rule「嚴禁擋到畫面」-- the engine status bar sits in the empty part of the Save/Exit strip
+     (Panel7 937..987, free from x=740), not over the offset table (theme.css puts it bottom-right = on the table on this full-window form). */
+  html body #ht9045WireBar{top:941px!important;left:740px!important;right:auto!important;bottom:auto!important;
+    width:520px!important;max-width:520px!important;height:auto!important;max-height:44px!important;overflow:auto!important;
+    pointer-events:auto!important;opacity:1;font-size:11px!important;line-height:1.3!important;padding:2px 22px 2px 6px!important;}
 </style>
 </head>
 <body class="winpage">
@@ -353,6 +364,19 @@ document.querySelectorAll('.traypos').forEach(function(ph){
         if (c !== undefined) el.textContent = c;
       }
     });
+    // AI(W906-TEMPSET-MEMOCAP) 20261003: golden uTemp_Set.dfm:10548-10638 Panel17 column titles (TMemo Lines, Color 9534289 = #517A91,
+    //   clWhite, taCenter). The generated page dropped Lines/Color (blank white boxes); the server Text is empty unless golden set it at
+    //   run time (palIndiTemp :5239 "Cal Offset" / :5303 "Set Temp"), so its non-empty text wins. readOnly: a header must not open the keypad.
+    var MEMO_CAP = { Memo2: 'By Setup\nOffSet', Memo1: 'Single \nLimit', palIndiTemp: 'Individual \nTemperatur\ne',
+                     memoInitialTempOffset: 'Initial Temp.\nOffset', Memo3: 'EOT Extra \nTemp Offset' };
+    Object.keys(MEMO_CAP).forEach(function (id) {
+      var m = $(id); if (!m) return;
+      var t = px[id] && px[id].text;
+      m.value = (t !== undefined && t !== '') ? t : MEMO_CAP[id];
+      m.readOnly = true;
+      m.style.background = '#517a91'; m.style.color = '#fff'; m.style.textAlign = 'center';
+      m.style.fontSize = '12px'; m.style.lineHeight = '13px'; m.style.overflow = 'hidden'; m.style.padding = '0';
+    });
     reselect.forEach(function (tab) {
       var first = tab.parentElement.querySelector(':scope > .tab:not([style*="display: none"])');
       if (first && first !== tab) first.click();
-- 
