From b76649b347234ca7bb7aec041610e63f04c04945 Mon Sep 17 00:00:00 2001
From: "HT9045 Machine (V906)" <Claude_RDBC_02@honprec.com>
Date: Thu, 1 Oct 2026 09:05:33 +0800
Subject: [PATCH] IOWIDGET-3 (web): IO buttons that need the safe door are
 orange / yellow like golden; TestSuck's Suck() / Destroy() said as such
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

EastSun 20261001: 「填安全門表＋橘黃色」, 「TestSuck 走 Suck() 流程」 (C++ 407ce3f).
- page/ht9045_io_widgets.js: a bound, enabled output panel button gets golden SetCompomentIO's
  runtime colours (iosetview.cpp:2244-2258 / :2322-2330): hw.needSafeDoor (C++ ChanIoPoints.cpp,
  golden bIdleNeedCheckSafeDoor) = FalseColor #ea6518 / TrueColor #fddf03, black text, plus a line in
  its tooltip; any other bound one = #01479d / #05b5dc, white text. On the element only, never the
  source; on HW.IoSetView (the page binds by itself) the same, still no style injected.
- page/ht9045_io_do.js: an ack with "sequence" (TestSuck while the Index holds an IC) is shown as
  golden's Suck() / Destroy() flow on the named sucker, not as a coil write.

Offline (fake /api/struct/io, WebSocket replaced, headless Edge, no wb_serve): HW.teach -- the
door one rgb(234,101,24) with black text and the tooltip line, the others blue; the sequence ack
shown as "照 golden 走 Suck() 流程 ... 吸嘴：FTestSuckAA". HW.IoSetView -- bplCatchSuck_On orange /
yellow + tooltip, bplCatchSuck_Off blue, no style element added, no page error.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 page/ht9045_io_do.js      |  5 +++++
 page/ht9045_io_widgets.js | 19 +++++++++++++++++++
 2 files changed, 24 insertions(+)

diff --git a/page/ht9045_io_do.js b/page/ht9045_io_do.js
index 63123ff..080cc8f 100644
--- a/page/ht9045_io_do.js
+++ b/page/ht9045_io_do.js
@@ -133,6 +133,11 @@
 
   // ------------------------------------------------------------------ click
   function describe(a, ack) {
+    // AI(W906-IOWIDGET-3) 20261001: TestSuck while the Index holds an IC -- C++ runs golden's Suck() / Destroy() sequence
+    //   (iosetview.cpp:1040-1083 + Timer1Timer :159-173) instead of switching the coil; nothing is "sent" by this click itself
+    if (ack.sequence)
+      return { level: 'ok', text: a + '：Index 上有 IC，照 golden 走 ' + (ack.sequence === 'suck' ? 'Suck() 流程（開真空，等到吸住或出錯）' : 'Destroy() 流程（破真空吹氣，等到放開或出錯）') +
+               '\n吸嘴：' + (ack.sucker || '?') + '\n吸嘴自己的流程會切它的線圈，看燈號確認' };
     var ad = ack.address || {};
     var where = 'ring ' + ad.ring + '・站 ' + ad.station + '・通道 ' + ad.port +
                 '（IO 表 Lane ' + ad.lane + ' / IP ' + ad.ip + ' / Port ' + ad.port + '）';
diff --git a/page/ht9045_io_widgets.js b/page/ht9045_io_widgets.js
index 987904f..ea78162 100644
--- a/page/ht9045_io_widgets.js
+++ b/page/ht9045_io_widgets.js
@@ -98,6 +98,23 @@
 
   function mark(el, cls, on) { if (on) el.classList.add(cls); else el.classList.remove(cls); }
 
+  /* AI(W906-IOWIDGET-3) 20261001: golden SetCompomentIO's colours for a bound panel button (iosetview.cpp:2244-2258
+     TBtnPanelLane, :2322-2330 TBtnPanel) -- the .dfm's colours are only what it has before the form binds it:
+       an output that needs the safe door closed while idle (bIdleNeedCheckSafeDoor -> hw.needSafeDoor, C++
+       ChanIoPoints.cpp)  FalseColor 0x001865EA / TrueColor 0x0003DFFD, black text  = orange / yellow
+       any other bound one                FalseColor 0x009D4701 / TrueColor 0x00DCB505, white text  = blue / light blue
+     not bound / not enabled = grey (golden clSilver; ht9045_io_do.js greys it). Set on the element only, never the source. */
+  var SAFE_DOOR = { '--bp-false': '#ea6518', '--bp-true': '#fddf03', '--bp-false-font': '#000000', '--bp-true-font': '#000000' };
+  var BOUND = { '--bp-false': '#01479d', '--bp-true': '#05b5dc', '--bp-false-font': '#ffffff', '--bp-true-font': '#ffffff' };
+  function colorButton(el, pt) {
+    if (!el.classList || !el.classList.contains('btnpanel') || !pt || pt.direction !== 'output' || !pt.hw || pt.hw.enable !== 1) return;
+    var c = pt.hw.needSafeDoor ? SAFE_DOOR : BOUND;
+    for (var k in c) if (c.hasOwnProperty(k) && String(el.style.getPropertyValue(k)).trim().toLowerCase() !== c[k]) el.style.setProperty(k, c[k]);
+    var tAttr = el.hasAttribute('title') ? 'title' : 'data-htitle';
+    var t = el.getAttribute(tAttr) || '';
+    if (pt.hw.needSafeDoor && t.indexOf('待機時要先關安全門') < 0) el.setAttribute(tAttr, t + '\n（待機時要先關安全門才能動：門開著按了會被擋下）');
+  }
+
   /* one component: its IO state as a class, the golden hint in its tooltip (the original title kept) */
   function paint(el, pt, runtime) {
     mark(el, 'io-on', false); mark(el, 'io-off', false); mark(el, 'io-unknown', false);
@@ -141,6 +158,7 @@
           var tAttr = el.hasAttribute('title') ? 'title' : 'data-htitle';
           var h = hintOf(pt, a), cur = el.getAttribute(tAttr) || '';
           if (cur.indexOf(h) !== 0) el.setAttribute(tAttr, h + '\n' + cur);
+          colorButton(el, pt);
         }
       } catch (e) { /* a hint that cannot be added never stops the page's own painting */ }
       return r;
@@ -160,6 +178,7 @@
       var a = aliasOf(nodes[i]);
       if (!a) continue;                        // (Alias= empty: the page's own button, e.g. Alert.Note's)
       paint(nodes[i], map[a], runtime);
+      colorButton(nodes[i], map[a]);
       if (map[a]) hit++; else miss++;
     }
     window.HT9045IoWidgets.last = { mapped: hit, noData: miss, connected: runtime.connected === true, provider: runtime.provider || '' };
-- 
