From aaf06947bbeb36cf08f2e9effe7f0682c0722c2d Mon Sep 17 00:00:00 2001
From: "HT9045 Machine (V906)" <Claude_RDBC_02@honprec.com>
Date: Fri, 25 Sep 2026 17:08:05 +0800
Subject: [PATCH 1/7] MT-E1 (web): Motor Test grid follows golden bView --
 unused motors not shown, rows repacked by motor number (12 per column, pitch
 28/192); cbbMotorName still lists all M00.. like golden FormShow

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 page/HW.MotorTest.html | 52 ++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 52 insertions(+)

diff --git a/page/HW.MotorTest.html b/page/HW.MotorTest.html
index b2752e5..8ce19c0 100644
--- a/page/HW.MotorTest.html
+++ b/page/HW.MotorTest.html
@@ -391,6 +391,57 @@ document.querySelectorAll('.traypos').forEach(function(ph){
     });
   }
 
+  // AI(W906-MT-E1) 20260925: golden TfMotorTest::Init（uMotorTest.cpp:145-390）的 bView ——
+  //   bView==false 的馬達整列不建立（Steven 20240822「沒用到的馬達不new」），其餘依馬達編號
+  //   由上往下重新排位：iTop=4、iTPitch=28、iLeft=4、iLPitch=192、每欄 12 列（fMotorTest.cpp:567-589）。
+  //   bView 由 C++ 算（ChanMotorPoints.cpp motorTestVisible）；沒有這個欄位（離線 JSON）就保留靜態排版不動。
+  //   cbbMotorName 不受影響：golden FormShow（uMotorTest.cpp:1062-1067）照樣列出全部 M00..。
+  function applyGoldenGridVisibility(){
+    var host=document.getElementById('pnlMotor');
+    if(!host || !motorConfig || !motorConfig.motors) return;
+    var ms=motorConfig.motors, known=false, vis={}, i;
+    for(i=0;i<ms.length;i++) if(typeof ms[i].motorTestVisible==='boolean'){ known=true; break; }
+    if(!known) return;
+    for(i=0;i<ms.length;i++) if(ms[i].motorTestVisible===true) vis[ms[i].motorIndex]=true;
+    var rows={}, nodes=host.querySelectorAll('[title]');
+    for(i=0;i<nodes.length;i++){
+      var t=nodes[i].getAttribute('title')||'', m;
+      if(m=/^(cbUsing|labName|edPos1_|edPos2_)(\d+)\b/.exec(t)){
+        var k=+m[2]; (rows[k]=rows[k]||{})[m[1]]=nodes[i];
+      }
+    }
+    var proto=rows[Object.keys(rows)[0]]||null;
+    function make(kind, idx){
+      var src=proto && proto[kind], el;
+      if(src){ el=src.cloneNode(false); }
+      else { el=document.createElement(kind==='labName'?'span':'input'); if(kind==='cbUsing') el.type='checkbox'; else if(kind!=='labName') el.className='ed'; }
+      el.setAttribute('title', kind+idx+' : '+(kind==='labName'?'TLabel':kind==='cbUsing'?'TCheckBox':'TEdit')+'（執行期建立）');
+      if(kind==='labName') el.textContent='M'+pad2(idx);
+      else if(kind!=='cbUsing') el.value='0';
+      else el.checked=false;
+      host.appendChild(el);
+      return el;
+    }
+    var X={cbUsing:4, labName:20, edPos1_:54, edPos2_:121}, Y={cbUsing:0, labName:0, edPos1_:-3, edPos2_:-3};
+    var order=Object.keys(vis).map(Number).sort(function(a,b){return a-b;});
+    var row=0, col=0, shown={};
+    order.forEach(function(idx){
+      var r=rows[idx]=rows[idx]||{};
+      ['cbUsing','labName','edPos1_','edPos2_'].forEach(function(kind){
+        var el=r[kind]||(r[kind]=make(kind, idx));
+        el.style.display='';
+        el.style.left=(X[kind]+192*col)+'px';
+        el.style.top=(4+28*row+Y[kind])+'px';
+      });
+      shown[idx]=true;
+      if(++row>=12){ row=0; col++; }
+    });
+    Object.keys(rows).forEach(function(k){
+      if(shown[k]) return;
+      ['cbUsing','labName','edPos1_','edPos2_'].forEach(function(kind){ if(rows[k][kind]) rows[k][kind].style.display='none'; });
+    });
+  }
+
   function ensureMotorListStyle(){
     if(document.getElementById('motorListStyle')) return;
     var st=document.createElement('style');
@@ -485,6 +536,7 @@ document.querySelectorAll('.traypos').forEach(function(ph){
       motorConfig=pair.cfg; motorRuntime=pair.rt; modeSource=src;
       document.body.setAttribute('data-motor-src', src);   // AI(W906-MOTOR-POINTS) 20260924: 實際來源，給探針／除錯看（資訊列會被後續訊息蓋掉）
       buildMotorSelector();
+      applyGoldenGridVisibility();                  // AI(W906-MT-E1) 20260925: golden bView，必須在綁定點擊之前（可能新建列）
       attachStaticGridHandlers();
       renderMotorDb();
       attachMotorDbHandlers();
-- 
