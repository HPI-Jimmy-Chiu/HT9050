+        $('err').textContent = '';
+        if (s.unchanged || s.seq === lastSeq) { if (snap) { snap.busy = s.busy; showState(s.busy); } }
+        else { lastSeq = s.seq; render(s); }
+      })
+      .catch(function (e) { var st = $('st'); st.className = 'state down'; st.textContent = '離線'; $('err').textContent = String(e.message || e); });
+  }
+
+  $('q').addEventListener('click', function () {
