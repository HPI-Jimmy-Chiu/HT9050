+  }
+
+  function render(s) {
+    snap = s;
+    showState(s.busy);
+    $('history').textContent = (s.history || []).join('\n');
+    $('config').textContent = JSON.stringify(s.config || {}, null, 1);
+    var r = s.result;
+    if (!r) return;
+    $('info').textContent = '查詢 ' + (r.range || []).join(' ~ ') + '（' + (r.queryAt || '') + '）';
