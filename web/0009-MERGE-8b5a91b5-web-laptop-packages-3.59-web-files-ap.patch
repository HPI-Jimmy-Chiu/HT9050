+    $('exceptions').textContent = (r.exceptions || []).join('\n');
+    $('files').textContent = (r.filesRead || []).join('\n');
+  }
+
+  function poll() {
+    fetch(API + (lastSeq >= 0 ? '?since=' + lastSeq : '')).then(function (x) { return x.ok ? x.json() : x.json().then(function (e) { throw new Error(e.error || x.status); }); })
