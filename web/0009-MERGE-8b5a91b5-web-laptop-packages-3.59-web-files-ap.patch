+      h += '</tr>';
+    });
+    t.innerHTML = h;
+    if (onRow) Array.prototype.forEach.call(t.querySelectorAll('tr[data-i]'), function (tr) {
+      tr.addEventListener('click', function () { onRow(+tr.getAttribute('data-i') + 1); });
+    });
+  }
+  function esc(s) { return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }
