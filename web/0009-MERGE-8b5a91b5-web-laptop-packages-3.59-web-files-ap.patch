+  var demo = { gpib: false, rs232: false, tcpip: false };
+
+  // ---------- tabs ----------
+  Array.prototype.forEach.call(document.querySelectorAll('.tabs .tab'), function (t) {
+    t.addEventListener('click', function () {
+      Array.prototype.forEach.call(document.querySelectorAll('.tabs .tab'), function (x) { x.classList.remove('act'); });
