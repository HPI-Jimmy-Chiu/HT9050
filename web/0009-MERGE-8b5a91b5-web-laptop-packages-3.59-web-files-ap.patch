+    });
+  });
+
+  // ---------- 32 site panels (shared maker, ruling 10) ----------
+  function buildSites(hostId, key) {
+    var host = document.getElementById(hostId), arr = [];
+    for (var i = 0; i < 32; i++) {
+      var p = HTWidgets.makeDutPanel({ index: i, left: (i % 8) * 154, top: Math.floor(i / 8) * 110 });
+      host.appendChild(p);
+      arr.push(p);
+      (function (idx, panel) {
+        var on = panel.querySelector('input[type=checkbox]'), bin = panel.querySelector('select');
+        if (key) {
+          on.addEventListener('change', function () { post(key, 'site ' + idx + ' on ' + (on.checked ? 1 : 0)); });
+          bin.addEventListener('change', function () { post(key, 'site ' + idx + ' bin ' + bin.selectedIndex); });
+        }
+      })(i, p);
+    }
+    return arr;
+  }
+  var sites = { gpib: buildSites('g-sites', 'gpib'), rs232: buildSites('r-sites', 'rs232'), tcpip: buildSites('t-sites', null) };
+
+  function bgr(c) {   // VCL TColor (BGR) -> CSS
+    if (c == null || c <= 0) return null;
+    var r = c & 0xff, g = (c >> 8) & 0xff, b = (c >> 16) & 0xff;
+    return 'rgb(' + r + ',' + g + ',' + b + ')';
+  }
+  function applySites(key, list) {
+    if (!list) return;
+    for (var i = 0; i < 32 && i < list.length; i++) {
+      var s = list[i], p = sites[key][i];
+      if (!s || !p) continue;
+      p.setSite(s.site, bgr(s.color));
+      if (s.binText) p.setBin(s.binText);
+      p.setOn(s.on);
+      p.setOcr(s.ocr);
+    }
+  }
+
+  // ---------- helpers ----------
+  function $(id) { return document.getElementById(id); }
+  function setText(id, v) { var e = $(id); if (e) e.textContent = v == null ? '' : v; }
+  function fillCombo(sel, c, key, name) {
+    if (!sel || !c) return;
+    if (sel.options.length !== (c.items || []).length) {
+      sel.innerHTML = '';
+      (c.items || []).forEach(function (t, i) { var o = document.createElement('option'); o.value = i; o.textContent = t; sel.appendChild(o); });
+    }
+    if (document.activeElement !== sel) sel.selectedIndex = c.index;
+    sel.disabled = c.enabled === false;
+    if (!sel._wired) {
+      sel._wired = true;
+      sel.addEventListener('change', function () { post(key, 'combo ' + name + ' ' + sel.selectedIndex); });
+    }
+  }
+  // AI(W906-GB-P6) 20260926: a VCL csDropDown combo (golden reads its Text): free text plus the item list.
+  function fillText(inp, list, c) {
+    if (!inp || !c) return;
+    var items = c.items || [];
+    if (list && list.children.length !== items.length) {
+      list.innerHTML = '';
+      items.forEach(function (t) { var o = document.createElement('option'); o.value = t; list.appendChild(o); });
+    }
+    if (document.activeElement !== inp) inp.value = c.text == null ? '' : c.text;
+    inp.disabled = c.enabled === false;
+  }
+  // several commands whose order matters (separate fetches may reach the server in any order)
+  function postChain(key, cmds) {
+    if (demo[key]) { cmds.forEach(function (c) { console.log('[demo] ' + key + ': ' + c); }); return; }
+    cmds.reduce(function (p, c) {
+      return p.then(function () { return fetch(API + key + '?cmd=' + encodeURIComponent(c), { method: 'POST' }); });
+    }, Promise.resolve()).catch(function () {});
+  }
+  function tail(id, lines) {
+    var e = $(id); if (!e || !lines) return;
+    var atEnd = e.scrollTop + e.clientHeight >= e.scrollHeight - 4;
+    e.textContent = lines.join('\n');
+    if (atEnd) e.scrollTop = e.scrollHeight;
+  }
+  function statusRow(id, arr) {
+    var host = $(id);
+    if (host.children.length !== 8) { host.innerHTML = ''; for (var i = 0; i < 8; i++) host.appendChild(document.createElement('div')); }
+    for (var j = 0; j < 8; j++) { host.children[j].textContent = (arr && arr[j]) || ''; host.children[j].title = host.children[j].textContent; }
+  }
+  function stateBadge(id, snap, ok) {
+    var e = $(id);
+    e.className = 'tcState ' + (!ok ? 'off' : (snap && snap.up ? 'up' : 'down'));
+    e.textContent = !ok ? '離線（/api/testercomm 未接）' : (snap && snap.up ? '連線中' : ('已停止' + (snap && snap.closeReason ? '：' + snap.closeReason : '')));
+  }
+  function post(key, cmd) {
