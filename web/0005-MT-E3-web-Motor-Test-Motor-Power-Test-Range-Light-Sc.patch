+  postWinState(id,false);                          // AI(W906-MT-E3) 20260925
   scheduleRegistry();
 }
+// AI(W906-MT-E3) 20260925：把「這個視窗現在開著還是關著」告訴它自己的 iframe —— golden 的 FormShow／FormClose。
+//   非 lazy 的視窗關閉時只是藏起來（iframe 不卸載），頁面自己不會知道；golden 每次 Show 都跑 FormShow（例：Motor Test
+//   重讀 MotorTest.ini、不選馬達、Motor Power 同步）、每次 Close 都跑 FormClose（例：寫回 MotorTest.ini）。
+//   訊息：{type:'HT_WIN', id, open, state, initial}
+//     open    = state 是 open 或 minimized（最小化不是關閉 —— 契約 §3；golden 最小化也不跑 FormClose）
+//     initial = true：iframe 剛載入完成時補送的目前狀態（頁面若是在視窗開著時重新載入，靠它補跑 FormShow）
+//   頁面自己比較 open 的前後值決定要不要跑 FormShow／FormClose；不認得這個 type 的頁面照舊忽略。
+function postWinState(id,initial){
+  var win=document.getElementById('win-'+id); if(!win) return;
+  var f=win.querySelector('iframe'); if(!f||!f.contentWindow) return;
+  var st=WIN_STATE[id];
+  try{ f.contentWindow.postMessage({type:'HT_WIN',id:id,open:(st==='open'||st==='minimized'),state:st,initial:!!initial},'*'); }catch(e){}
+}
 
