From eabef6655b5cc3fe09183f6f79af26a9c154537b Mon Sep 17 00:00:00 2001
From: "HT9045 Machine (V906)" <Claude_RDBC_02@honprec.com>
Date: Fri, 9 Oct 2026 22:25:09 +0800
Subject: [PATCH] PKG230 (web): laptop package 230 web half -- Lot Info FTP
 page "Upload to Server" button enabled (page/Data.FTPClient.html,
 page/ht9045_ftpclient.js; St02 W-202 (2) F2-3, MR !398). Enable FTP=0 on
 HT9050.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 page/Data.FTPClient.html | 3 +--
 page/ht9045_ftpclient.js | 5 ++++-
 2 files changed, 5 insertions(+), 3 deletions(-)

diff --git a/page/Data.FTPClient.html b/page/Data.FTPClient.html
index 3496d1d..645d811 100644
--- a/page/Data.FTPClient.html
+++ b/page/Data.FTPClient.html
@@ -86,13 +86,12 @@
       </fieldset>
       <fieldset class="ftpGrp" id="GroupBox6" style="width:250px;">
         <div class="ftpRow"><button class="btn3d ftpBtn" id="plLoad" type="button" title="plLoadClick（FTPClient.cpp:1575-1653）：從本機換工作檔">Load from HD</button></div>
-        <div class="ftpRow"><button class="btn3d ftpBtn" id="plUnload" type="button" disabled title="plUnloadClick（卡片 F2：上傳到 FTP 伺服器）">Upload to Server</button></div>
+        <div class="ftpRow"><button class="btn3d ftpBtn" id="plUnload" type="button" disabled title="plUnloadClick（golden 913 FTPClient.cpp:1128-1229，卡片 LI-9 F2-3）：把選好的工作檔壓縮後上傳到 FTP 伺服器（照 golden 同步執行，完成前畫面會等）">Upload to Server</button></div>
         <div class="ftpRow"><button class="btn3d ftpBtn" id="plUnloadALL" type="button" disabled hidden title="plUnloadALLClick（CC_GIGAS；卡片 F2）">Upload All to Server</button></div>
         <div class="ftpRow" id="rowHdPaths" hidden><span id="labN06_DownloadPath1">Download Path:</span></div>
         <div class="ftpRow" id="rowHdPaths1" hidden><input type="text" class="ftpPath" id="FTP_DownPath1" disabled></div>
         <div class="ftpRow" id="rowHdPaths2" hidden><span id="labN06_UploadPath1">Upload Path:</span></div>
         <div class="ftpRow" id="rowHdPaths3" hidden><input type="text" class="ftpPath" id="FTP_UpLdPath1" disabled></div>
-        <div class="ftpF2">Upload to Server 是卡片 LI-9 F2，尚未提供</div>
       </fieldset>
     </div>
 
diff --git a/page/ht9045_ftpclient.js b/page/ht9045_ftpclient.js
index ffcb8e6..7091fd0 100644
--- a/page/ht9045_ftpclient.js
+++ b/page/ht9045_ftpclient.js
@@ -11,6 +11,8 @@
  *     filter {edit:'hd', text}               typing in edtHDWaferName (golden OnChange -> FilterList), 200 ms after the last key
  *     pick {list:'hd', index, name}          lstHDFile double click (golden lstHDFileDblClick)
  *     loadHD                                 plLoad 'Load from HD' (golden plLoadClick)
+ *     upload                                 plUnload 'Upload to Server' (golden 913 plUnloadClick; card LI-9 F2-3, AI(W906-W202) 20261009
+ *                                            (St02-E)): C++ runs the whole FTP upload before it replies (W-203 = B, as golden)
  *     enterHD                                Enter in edtHDWaferName (golden edtHDWaferNameKeyPress)
  *     testerType / testerId {index}|{text}   cbTesterType / cbTesterID OnChange (picked from the list = index; typed = text)
  *     inputMethod {index}                    rgInputMethod OnClick
@@ -183,7 +185,7 @@
     if (e) e.readOnly = !!s.barcodeKeys;                                // golden KeyPress swallows keys in barcode mode
     drawList('lstHDFile', hd.lstHDFile, hd.lstHDFile && hd.lstHDFile.enabled);
     setBtn('plLoad', hd.plLoad, false);
-    setBtn('plUnload', hd.plUnload, true);
+    setBtn('plUnload', hd.plUnload, false);                           // F2-3: C++ decides (golden plUnload->Enabled)
     setBtn('plUnloadALL', hd.plUnloadALL, true);
     var pv = !!(hd.labN06_DownloadPath1 && hd.labN06_DownloadPath1.visible);
     ['rowHdPaths', 'rowHdPaths1', 'rowHdPaths2', 'rowHdPaths3'].forEach(function (id) { show($(id), pv); });
@@ -271,6 +273,7 @@
       b.addEventListener('click', function (ev) { if (!trusted(ev) || b.disabled) return; fn(); });
     };
     bind('plLoad', function () { flushFilter(); send('loadHD', {}); });
+    bind('plUnload', function () { flushFilter(); send('upload', {}); });  // F2-3
     bind('btSafeTasterName', function () {
       var en = $('edTesterName');
       send('saveTester', (en && !en.disabled) ? { edTesterName: en.value } : {});
-- 
