+  function paint(s) {
+    if (!s || !s.items) return;
+    P.snap = s;
+    var why = s.mode !== 1 ? 'ControlPanelMode ' + s.mode + '：這台沒有通訊面板（golden 這時 IO 頁不顯示 Pad 鈕，視窗打不開）'
+            : !P.open ? 'Pad 視窗在 wb_serve 那邊沒有開著（pad.open 沒有成功）——關掉再開一次這個視窗' : '';
+    s.items.forEach(function (it) {
