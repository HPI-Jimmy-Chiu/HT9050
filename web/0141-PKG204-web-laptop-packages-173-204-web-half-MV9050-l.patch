+        if (h.call(changed, 'lastset.tester') || h.call(changed, 'lastset.testerWarnStyle') ||
+            h.call(changed, 'n07.alarm')) renderSoon();
+      });
+    }
+    if (window.HT9045Tags && typeof HT9045Tags.connect === 'function') HT9045Tags.connect().catch(function () {});
+  }
