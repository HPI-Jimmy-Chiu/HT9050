diff --git a/page/ht9045_lotinfo_testertcp.js b/page/ht9045_lotinfo_testertcp.js
new file mode 100644
index 0000000..70ffc8b
--- /dev/null
+++ b/page/ht9045_lotinfo_testertcp.js
@@ -0,0 +1,42 @@
+/* ht9045_lotinfo_testertcp.js -- Lot Info「Tester Log」分頁的 Tester TCP Show 鈕（golden TfLotInfo::btTesterTCPShowClick）。
+ * ---------------------------------------------------------------------------
+ * AI(W906-LI12) 20261002 (St02-E) 新檔（手寫）。E-019 LI-12（HT9011UC_Cpp_V3.33.906.0/docs/E019_DATA_STATUS_EVENTS_20261001.md）。
+ *
+ * golden（906_0625_Steven uLotInfo.cpp:13841-13844；V912 :14116）：
+ *     void __fastcall TfLotInfo::btTesterTCPShowClick(TObject *Sender) { fTesterTCP->Show(); }
+ *   非 modal 開 TfTesterTCP。這顆鈕在 tsTesterLog 分頁上，而 tsTesterLog 只在 TestIF_File.iTestType==TCP_IP_MODE 時看得到
+ *   （uLotInfo.cpp:7124；網頁的頁籤由 tag lot.tab.tsTesterLog 套，ht9045_lotinfo_wire.js）。
+ *
+ * 網頁：TfTesterTCP＝testercomm.html 的 TCP/IP 分頁（background.html WINDOWS 表 id 'testercomm'）。做法同 Q41 TI-3
+ *   （ht9045_testerif_c_wire.js (6)、ht9045_contact_q41.js）：localStorage 'ht9045.testercomm.tab'＝'tcpip'，再
+ *   postMessage {open:'testercomm'}（background.html 的開窗守衛照舊）；單獨開這一頁時開新分頁 testercomm.html#tcpip。
+ *   testercomm.html 已經開著時靠 storage 事件換分頁。
+ *   出貨版 testercomm 只留使用中的介面（testercomm.html applyBuildTabs）：不是 TCP/IP 時沒有 TCP/IP 分頁，會停在 Test Result
+ *   ——golden 這時候看不到這顆鈕（tsTesterLog 藏起來），網頁只有在頁籤可見度還不知道時才按得到。
+ * 沒有 C++、不送 WS 指令、不寫檔。
+ * ---------------------------------------------------------------------------
+ */
+(function () {
+  'use strict';
+
+  if (window.HT9045LotInfoTesterTcp) return;
+
+  var TC_KEY = 'ht9045.testercomm.tab';             // testercomm.html 讀（同 origin 的 localStorage）
+
+  function show(ev) {                                // golden fTesterTCP->Show()
+    var b = ev && ev.currentTarget;
+    if (b && (b.disabled || b.getAttribute('aria-disabled') === 'true')) return;
+    try { localStorage.setItem(TC_KEY, 'tcpip'); } catch (e) { /* 私密視窗等：開視窗但停在預設分頁 */ }
+    if (window.parent && window.parent !== window) window.parent.postMessage({ open: 'testercomm' }, '*');   // background.html id 'testercomm'
+    else window.open('testercomm.html#tcpip', '_blank');                                                       // 單獨開這一頁時
+  }
+  function hook() {
+    var b = document.getElementById('btTesterTCPShow');
+    if (!b || b.__w906Li12) return;
+    b.__w906Li12 = true;
+    b.addEventListener('click', show);
+  }
+  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', hook); else hook();
+
+  window.HT9045LotInfoTesterTcp = { show: function () { show(null); } };   // 探針／除錯用
+})();
diff --git a/page/ht9045_testerif_c_wire.js b/page/ht9045_testerif_c_wire.js
index 8d510aa..3da646a 100644
--- a/page/ht9045_testerif_c_wire.js
+++ b/page/ht9045_testerif_c_wire.js
@@ -282,3 +282,42 @@
     dioTypeChange: dioTypeChange, testerTcpShow: testerTcpShow, w6Rs232InGpib: w6Rs232InGpib   // AI(W906-Q41) 20260927
   };
 })();
+
+/* ---- (8) AI(W906-TIF-KB) 20261002 (St02-E): the keyboard limits of 9 fields = golden's generic branch --------------
+ * docs/TESTERIF_FIELD_AUDIT_20261002.md P1 / P2 (St02-M routing (a)).  The generated ht9045_wire_setuptesterif.js
+ * (gen_wire.py) took the FIRST ShowQwertyKey call of each click handler; in golden 906_0625_Steven cTesterIF.cpp those
+ * are customer branches:
+ *   edInitialMaxTestClick (:1380-1403) -- OnClick of edMaxTestTime / edInitialMaxTest and their _RT / _EQC copies
+ *     (cTesterIF.dfm:2348 / :2366 / :3100 / :3118 / :3380 / :3398): generated INTEGER 60..9999 = CC_ASE_M (:1384);
+ *     generic = N_DOUBLE, 2, true, 0, 15000 (:1401).  IniConfig.bVTESTFunction (:1395-1398, 0..36000) is not sent to the
+ *     page yet (claim for St01's FileRW extra pending) -- until then the generic branch.
+ *   edtInitStartDelayClick (:1410-1416) -- edtInitStartDelay / _RT / _EQC (dfm :2403 / :3155 / :3435): generated
+ *     DOUBLE 2 30..3000 = HiSilicon + CC_ASE_KaohSiung (:1412-1413); generic = N_DOUBLE, 2, false (:1415, no range).
+ *   CC_AMKOR_Korea / CC_SCK (:1386-1390) and CC_GIGAS (:1391-1394) are S25 (customer branches, not ported).
+ * ht9045_wire_engine.js attachKeyboards reads cfg.kb once, at DOMContentLoaded (register defers attach while the page
+ * parses); this file loads after the wire data (Setup.TesterIF.html:125 / :128), so replacing the 9 entries here is in time.
+ * Nothing else changes: the other kb entries, the values, the save path.
+ */
+(function () {
+  'use strict';
+  var GOLDEN_KB = {                                   // [type, decimals, checkRange, min, max] (attachKeyboards)
+    edMaxTestTime:         ['DOUBLE', 2, true, 0, 15000],   // golden :1401
+    edMaxTestTime_RT:      ['DOUBLE', 2, true, 0, 15000],
+    edMaxTestTime_EQC:     ['DOUBLE', 2, true, 0, 15000],
+    edInitialMaxTest:      ['DOUBLE', 2, true, 0, 15000],
+    edInitialMaxTest_RT:   ['DOUBLE', 2, true, 0, 15000],
+    edInitialMaxTest_EQC:  ['DOUBLE', 2, true, 0, 15000],
+    edtInitStartDelay:     ['DOUBLE', 2, false, 0, 0],      // golden :1415 (no range)
+    edtInitStartDelay_RT:  ['DOUBLE', 2, false, 0, 0],
+    edtInitStartDelay_EQC: ['DOUBLE', 2, false, 0, 0]
+  };
+  var P = window.HT9045Page, kb = P && P.cfg && P.cfg.kb, applied = [];
+  if (kb) {
+    if (window.HT9045KbAudit) {                       // attach already ran (the page was not parsing any more): too late
+      if (window.console) console.warn('[TesterIF] keyboards already attached -- golden limits (8) not applied');
+    } else {
+      Object.keys(GOLDEN_KB).forEach(function (id) { kb[id] = GOLDEN_KB[id].slice(); applied.push(id); });
+    }
+  }
+  window.HT9045TesterIfKb = { golden: GOLDEN_KB, applied: applied };   // probe / ctest TIF_KbGolden
+})();
