   .idxFn label{display:flex;align-items:center;gap:3px;font-size:12px;}
   .idxFn .btn3d{background:var(--panel);border:2px outset #cfcfcf;border-radius:3px;padding:2px 4px;font-size:12px;cursor:pointer;}
   .idxFn .btn3d:active{border-style:inset;}
