@@ -14,6 +14,8 @@
     font-family:Batang,"MS Sans Serif",sans-serif;font-size:11px;}
   table.ctgrid td.drawn{font-family:"MS Sans Serif",sans-serif;}
   #ctStatus{font-size:11px;margin-top:4px;min-height:14px;}
+  /* AI(W906-NOOVERLAP) 20260930: ht9xxx-layout-base.js moves btClearCount to the bottom right (translate 203,291); there it ended 3px below the 320px window content (background.html contactct h:346). Lifted 4px so it stays inside the window. */
+  #btClearCount{position:relative;top:-4px;}
 </style>
 </head>
 <body class="winpage">
diff --git a/page/Data.LotInfo.html b/page/Data.LotInfo.html
index 71a9662..84c7894 100644
--- a/page/Data.LotInfo.html
+++ b/page/Data.LotInfo.html
@@ -22,6 +22,12 @@
   .liImg{display:inline-block;width:190px;height:96px;border:1px dashed #888;margin:2px;text-align:center;line-height:96px;color:var(--text-dim,#667);}
   #mmTesterLog{width:100%;height:220px;box-sizing:border-box;font-family:Consolas,monospace;font-size:11px;white-space:pre;overflow:auto;border:1px inset #aaa;background:var(--input-bg,#fff);color:var(--text,#222);padding:2px;}
   table.yield td.liL{text-align:left;}
+  /* AI(W906-NOOVERLAP) 20260930: EastSun「很多頁面都有重疊的情況，這是不被允許的」—— golden fLotInfo is 658x624 (uLotInfo.dfm:1); this window is
+     390x318 (background.html LAYOUT110), so a tab sheet taller than the window scrolled the whole page, tabs included. The tabs stay
