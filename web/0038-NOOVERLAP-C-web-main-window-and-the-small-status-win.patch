diff --git a/page/Status.ShowBinSelect.html b/page/Status.ShowBinSelect.html
index 3ac8241..4cbf8e6 100644
--- a/page/Status.ShowBinSelect.html
+++ b/page/Status.ShowBinSelect.html
@@ -19,6 +19,17 @@
   /* AI(W906-LAYOUT110) 20260930：EastSun（BinSelect 截圖）「圖片上的 不用有」—— .sbsNote 是給開發看的 golden／移植說明，客戶畫面一律不顯示 */
   .sbsNote{display:none !important;}
   #sbsStatus{font-size:11px;margin-top:4px;min-height:14px;}
+  /* AI(W906-NOOVERLAP) 20260930: EastSun「很多頁面都有重疊的情況，這是不被允許的」.
+     - Test Bin lists 33 rows (640px) in a 500px window, so the whole page scrolled away under the tabs. golden keeps them in a
+       TScrollBox (cShowBinSelect.dfm:100 ScrollBox1 Align=alClient): the pane scrolls inside the window, the tabs stay.
+     - Index: four columns with 8px padding and 60px value cells were 299px wide in the 231px pane (the window is 245 wide,
+       background.html LAYOUT110; golden tsIndex is 423). Tighter cells, table fills the pane, long captions may wrap. */
+  body.winpage{display:flex;flex-direction:column;height:100vh;}
+  body.winpage>.tabs{flex:none;}
+  body.winpage>.tabPane{flex:0 1 auto;min-height:0;overflow:auto;}
+  .sbsIdx{width:100%;border-collapse:collapse;}
+  .sbsIdx td{padding:2px 3px;}
+  .sbsIdx td.v{min-width:28px;}
 </style>
 </head>
 <body class="winpage">
diff --git a/page/Status.ShowMessage.html b/page/Status.ShowMessage.html
index 4ef88ca..53dba0d 100644
--- a/page/Status.ShowMessage.html
+++ b/page/Status.ShowMessage.html
@@ -11,6 +11,14 @@
 html,body{margin:0;overflow:hidden;}
 .smWrap{position:relative;width:802px;height:353px;background:var(--panel,#ece9d8);overflow:hidden;}
 .smWrap .lbl{position:absolute;font:bold 14px var(--font-ui,sans-serif);color:var(--navy,#036);white-space:nowrap;}
+/* AI(W906-NOOVERLAP) 20260930: the window (background.html showmsg 218x225) shows the post-initialisation column only, as golden does once
+   the machine is up: lblInitialMessage / ProgressBar1 are hidden by UpdateForm(100) (uShowMessage.cpp:344-345); imgTray / imgDevice /
+   imgTrayHere / imgDeviceHere are Visible=False in uShowMessage.dfm:75-361 and only ShowTrayDeviceDir (bShowTrayAndDeviceDir, not wired here)
+   shows them (imgDevice overlapped imgTrayHere); btnBackToMain only calls SetFormLayer (OnMouseUp=FormMouseUp) to lift the other forms
+   above the full-screen golden form, which never covers them here. The wrapper is the window's size, so nothing sits outside it. */
+#lblInitialMessage,#ProgressBar1,#btnBackToMain,#imgTray,#imgDevice,#imgTrayHere,#imgDeviceHere{display:none;}
+body.winpage{padding-bottom:0;}   /* body.winpage has 6px padding; the speed table ends 2px above the window bottom */
+.smWrap{width:100%;height:calc(100vh - 6px);}
 </style>
 </head>
 <body class="winpage">
diff --git a/page/ht9045_counterclear_wire.js b/page/ht9045_counterclear_wire.js
index 4af113a..60dc55a 100644
--- a/page/ht9045_counterclear_wire.js
+++ b/page/ht9045_counterclear_wire.js
@@ -38,8 +38,17 @@
     if (!s) {
       s = document.createElement('div');
       s.id = 'ccStatus';
-      s.style.cssText = 'font-size:11px;padding:2px 6px;color:#234;white-space:pre-wrap;width:258px;';
-      document.body.appendChild(s);
+      // AI(W906-NOOVERLAP) 20260930: the status line was appended under the 559px form, i.e. below the window (background.html counterclear h:585),
+      //   where nobody could read it. It now sits inside gbItems, in the free strip between cbSelectAll (golden T=396 H=17) and spbExe (T=441).
+      var host = document.querySelector('#gbItems > .cli');
+      if (host) {
+        s.style.cssText = 'position:absolute;left:2px;top:415px;width:203px;height:24px;overflow:hidden;box-sizing:border-box;padding:0 4px;' +
+                          'font-size:10px;line-height:12px;color:#234;white-space:pre-wrap;';
+        host.appendChild(s);
+      } else {
+        s.style.cssText = 'font-size:11px;padding:2px 6px;color:#234;white-space:pre-wrap;width:258px;';
+        document.body.appendChild(s);
+      }
     }
     return s;
   }
