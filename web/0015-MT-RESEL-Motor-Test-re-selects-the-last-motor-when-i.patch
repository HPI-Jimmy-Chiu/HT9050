From fd2ec5479f922bf1fc31b7a52659721f300b4191 Mon Sep 17 00:00:00 2001
From: "HT9045 Machine (V906)" <Claude_RDBC_02@honprec.com>
Date: Tue, 29 Sep 2026 22:08:46 +0800
Subject: [PATCH] MT-RESEL: Motor Test re-selects the last motor when its
 window is shown again

EastSun 20260929: after the Tools 1203 page, Motor Test stopped updating until another motor was clicked and back.
Switching windows = golden FormShow, which sets ActiveIndex=-1, so Timer1 had no axis to show. formShowPage now clicks
the previous motor again (selectMotor: C++ selectMotor after formShow, SetSpeed(1), the grid, Rate/Range -- the same as
the operator's own click). Deviation from golden, tagged AI(W906-MT-RESEL).

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 page/HW.MotorTest.html | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/page/HW.MotorTest.html b/page/HW.MotorTest.html
index 2e88e1b..df89123 100644
--- a/page/HW.MotorTest.html
+++ b/page/HW.MotorTest.html
@@ -1062,6 +1062,7 @@ document.querySelectorAll('.traypos').forEach(function(ph){
   // golden FormShow（uMotorTest.cpp:985-1077）的頁面這一側；C++ 那一側（fShow=true、bSingleHome=false、Motor Power 同步、
   //   ActiveIndex=-1）由 action formShow 做。
   function formShowPage(){
+    var reselect=selectedIndex;                      // AI(W906-MT-RESEL) 20260929：見本函式最後
     winShown=true; showQueued=false;
     loadMotorTestIni();                              // :995-1002 重讀 MotorTest.ini（Visible 的列）
     allBtnUp();                                      // :1003-1004 btnHome／btnLoopMove Down=false
@@ -1076,6 +1077,11 @@ document.querySelectorAll('.traypos').forEach(function(ph){
     //   偏離 golden：保留這個分頁（lead 決定；引擎的 sysGrid 在它上面讀寫 Mot_Table.csv）。
     setPnlStop(false);                               // :1076 pnlStop->Color=0x00DFD9CC
     syncCppForm();                                   // AI(W906-MT-FIX1) 20260925：原本 sendCpp 只送一次
+    // AI(W906-MT-RESEL) 20260929：EastSun「我到tool 1203的介面設定完成後 再到config MOT test 他的介面就沒再更新了
+    //   我需要切換到別的馬達後切回來 才會更新」—— 切到別的視窗再回來＝golden FormShow，上面照 golden 把 ActiveIndex 設 -1，
+    //   之後 Timer1 沒有軸可更新（golden 的畫面也是這樣，只是那一列還紅著）。偏離 golden：自動把上一次選的那一軸再點一次
+    //   （＝操作員自己點：C++ selectMotor 在 formShow 之後依序送出，SetSpeed(1)、參數表、Rate／Range 都照點選那一套重來）。
+    if(reselect!==-1 && getMotorByIndex(reselect)) selectMotor(reselect);
     loadRuntimeOnly();
   }
   // golden FormClose（uMotorTest.cpp:1347-1362）：fShow=false（C++ formClose）→ 寫回 MotorTest.ini（頁面）。
-- 
2.55.0.windows.5

