+(function () {
+  'use strict';
+  var NO_ADAM = '這個移植樹的 ADAM-6024 EP 介面是空的替身（atester_shims.h 的 ADAM_DirectWriteData；ADAM_ReadPA 沒有移植）—— 沒有送到 EP 的路徑';
