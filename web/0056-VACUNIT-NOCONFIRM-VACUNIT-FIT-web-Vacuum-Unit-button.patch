From 59c6cb5936b5b437b7741e71053bd051e445fc67 Mon Sep 17 00:00:00 2001
From: "HT9045 Machine (V906)" <Claude_RDBC_02@honprec.com>
Date: Thu, 1 Oct 2026 20:32:10 +0800
Subject: [PATCH] VACUNIT-NOCONFIRM / VACUNIT-FIT (web): Vacuum Unit buttons
 send at once (golden has no confirm box), and the InArm / Index / OutArm
 group boxes grow to hold their panels (no scroll bars, the second row no
 longer cut)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

EastSun 1001: 「我按下不要有提醒視窗 只是觸發IO爾已 幹嘛幫我加視窗」 / 「我畫面被截掉了」.
golden VacuumUnit\*.cpp has 0 MessageBox -> the page's four confirm() calls (Set, ^/v, Set All, Reset) removed.
golden Initial sizes the groups so the ScrollBox never scrolls; page-widgets.js puts the panels 10px lower
(padTop) -> the group box now grows to its host (headless check: 4 ScrollBoxes, client == scroll size).

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 page/ht9045_vacuumunit_c.js | 35 +++++++++++++++++++++++++----------
 1 file changed, 25 insertions(+), 10 deletions(-)

diff --git a/page/ht9045_vacuumunit_c.js b/page/ht9045_vacuumunit_c.js
index ea2efbc..a220f35 100644
--- a/page/ht9045_vacuumunit_c.js
+++ b/page/ht9045_vacuumunit_c.js
@@ -28,7 +28,7 @@
  *          讀不到的燈與 DO 畫成灰色（不知道），不畫成「關」。
  *        * 一顆鈕只在快照說 available 時才能按；不能按的鈕鎖住，滑鼠停在上面看得到 C++ 給的原因（例如「ring 1 站 0x50 回報的模組是
  *          ECx-P32-HON …，不在 ECAT-VC8 身分表」）。瀏覽器不做互鎖判斷 —— 互鎖、身分檢查、範圍檢查都在 C++，這裡只是不讓人按注定被拒的鈕。
- *        * 每一次寫入先跳確認框，送出後把回應講清楚：已送到卡片／DRY RUN（沒有真的寫）／被拒（原因）／卡片回錯誤。
+ *        * 按了就送（golden 沒有確認框；20261001 拿掉頁面自己加的那四個），送出後把回應講清楚：已送到卡片／DRY RUN（沒有真的寫）／被拒（原因）／卡片回錯誤。
  *        * 視窗關掉（外框 HT_WIN open=false）就停止輪詢並送 vacuum.close；golden FormClose 也把 tmr1 關掉。
  *      ⚠ 今天這台的 ring 上沒有 ECAT-VC8（EastSun 20260930「沒有，先把軟體做好」）：每顆面板會顯示 golden 的 999.0／Error3／Error5，
  *        每顆硬體鈕鎖住並寫明原因。這是預期，不是故障。
@@ -116,6 +116,26 @@
       HTQwerty.show(el, HTQwerty.N[KB_SV[0]] || 0, { dp: KB_SV[1], checkRange: KB_SV[2], min: KB_SV[3], max: KB_SV[4] });
     });
   }
+  // AI(W906-VACUNIT-FIT) 20261001: EastSun 1001「我畫面被截掉了」(InArm 第二排 B/D/F/H 只看得到一半，兩條捲軸).
+  // golden Initial (VacuumUnit.cpp:91-99) sizes grpInarm / grpOutarm / grpIndexArm1/2 to (81+2)*cols x (177+12)*2 so the
+  // panels at Top=177*row exactly fit and the ScrollBox never scrolls. The page keeps those numbers (332x378) but
+  // page-widgets.js puts every panel 10px lower (padTop:10, so the caption at top:-8 is not clipped) -> the host is
+  // 324x370 in a ~326x353 ScrollBox -> both scroll bars, the second row cut. So the group box grows to the host it
+  // holds (golden intent: no scrolling). Index Arm1 stays right under Index Arm2 (golden :57 Top = grpIndexArm2->Height).
+  var GROUPS = [['grpInarm', 'scrlbxInArm'], ['grpOutarm', 'scrlbxOutArm'], ['grpIndexArm2', 'scrlbxIndexArm2'], ['grpIndexArm1', 'scrlbxIndexArm1']];
+  var FIT_W = 4 + 2 + 4, FIT_H = 21 + 2 + 6;          // ScrollBox left:2 + its 1px borders + fieldset borders / top:21 + borders + slack
+  function fitGroups() {
+    GROUPS.forEach(function (g) {
+      var grp = $(g[0]), sb = $(g[1]), host = sb && sb.querySelector('.htWidgetHost');
+      if (!grp || !host) return;
+      var hw = parseInt(host.style.width, 10) || 0, hh = parseInt(host.style.height, 10) || 0;
+      if (!hw || !hh) return;
+      grp.style.width = Math.max(parseInt(grp.style.width, 10) || 0, hw + FIT_W) + 'px';
+      grp.style.height = Math.max(parseInt(grp.style.height, 10) || 0, hh + FIT_H) + 'px';
+    });
+    var a2 = $('grpIndexArm2'), a1 = $('grpIndexArm1');
+    if (a2 && a1) a1.style.top = ((parseInt(a2.style.top, 10) || 0) + (parseInt(a2.style.height, 10) || 0) + 3) + 'px';
+  }
   function buildMissing(d) {
     var made = [];
     var W = window.HTWidgets;
@@ -134,6 +154,7 @@
       if ($(e.id)) kbAttach($(e.id));
       made.push(arr + '_' + col + '_' + row);
     });
+    if (made.length) fitGroups();
     if (made.length) setTimeout(function () {
       say2('ⓘ 後端 golden Initial 建了 ' + made.length + ' 個頁面沒有的面板（Index 8 欄機種），已補上：' + made.join(', '));
     }, 0);
@@ -360,9 +381,8 @@
     if (!p || !p.available) { sayNow('❌ ' + gb.id + ' 不能寫：' + (p ? p.reason : '還沒有快照'), '#f88'); return; }
     var n = numOf($(gb.id + '_edSV'));
     if (!kpaOk(n)) { sayNow('❌ 閥值要是 -116 ~ 148 kPa 的數字（golden 小鍵盤範圍）', '#f88'); return; }
-    if (!window.confirm('寫入 ECAT-VC8 真空閥值\n面板 ' + captionOf(gb) + '（' + gb.id + '）\n' + addrText(VU.snap, p) +
-                        '\n閥值 = ' + n + ' kPa（SDO ' + (0x8000 + 0x10 * p.vc).toString(16).toUpperCase() + 'h:13h）' +
-                        (p.modeOk ? '' : '\n（這一格的閥值模式還沒寫成功：下一個 tick 照 golden 寫 02h = 1）') + '\n\n確定送出？')) return;
+    // AI(W906-VACUNIT-NOCONFIRM) 20261001: no confirm box -- golden btnSVClick / btnVaccumOnOffOnClick / btnSetInArmClick /
+    // sbResetClick have none (VacuumUnit\*.cpp: 0 MessageBox). EastSun 1001「我按下不要有提醒視窗 只是觸發IO爾已 幹嘛幫我加視窗」.
     press('vacuum.setSV', { panel: gb.id, kPa: n }, 'Set（golden btnSVClick）' + captionOf(gb) + ' → ' + n + ' kPa');
   }
   function onBpl(gb, which) {
@@ -372,15 +392,11 @@
     if (cur !== true && cur !== false) { sayNow('❌ 讀不到這個輸出目前的狀態，不知道要切成什麼，所以不送', '#f88'); return; }
     var down = cur ? 0 : 1;                              // golden Ptr->Down = !Ptr->Down
     var name = which === 'on' ? '吸真空（^ bplOn）' : '破真空（v bplOff）';
-    if (!window.confirm(name + ' → ' + (down ? 'ON' : 'OFF') + '\n面板 ' + captionOf(gb) + '（' + gb.id + '）\n' + addrText(VU.snap, p) +
-                        '\nDO 通道 ' + (which === 'on' ? p.onCh : p.offCh) + '\n\n確定送出？')) return;
     press('vacuum.do', { panel: gb.id, which: which, value: down }, name + ' ' + (down ? 'ON' : 'OFF') + '：' + captionOf(gb));
   }
   function onSetAll(arm, editId, label) {
     var n = numOf($(editId));
     if (!kpaOk(n)) { sayNow('❌ Set All 的值要是 -116 ~ 148 kPa 的數字（golden 小鍵盤範圍）', '#f88'); return; }
-    if (!window.confirm('Set All Value：' + label + ' 的每一格閥值都寫成 ' + n + ' kPa\n（golden btnSetInArmClick：先把每一格的 edSV 改成 ' + Math.trunc(n) +
-                        '，再逐格寫 ECAT-VC8；不是 VC8 的站會被 C++ 拒絕並列出原因）\n\n確定送出？')) return;
     var prefix = arm === 'in' ? ['myPalInArm'] : arm === 'out' ? ['myPalOutArm'] : ['myPalArm1', 'myPalArm2'];
     press('vacuum.setAll', { arm: arm, kPa: n }, 'Set All（' + label + '）→ ' + n + ' kPa');
     // golden :563 / :575-576 / :590 fVacuumUnit->myPal*->edSV->Text=(int)dValue —— 頁面的 edSV 也跟著改（按 Save 才存檔）
@@ -393,7 +409,6 @@
     });
   }
   function onReset() {
-    if (!window.confirm('Reset（golden sbResetClick）\n清掉每一格面板的事件；下一個 tick 重新讀值，並照 golden 重寫閥值模式（SDO 02h = 1）\n\n確定？')) return;
     press('vacuum.reset', {}, 'Reset（golden sbResetClick）');
   }
 
@@ -425,7 +440,7 @@
   }, true);
 
   /* ---- 面板由 page-widgets.js 在 DOMContentLoaded 建立（它的監聽器先註冊）；本監聽器排在它之後、引擎 attach 之前 ---- */
-  function onReady() { lockStatic(WAIT_NOTE); }
+  function onReady() { fitGroups(); lockStatic(WAIT_NOTE); }
   if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', onReady);
   else onReady();
 
