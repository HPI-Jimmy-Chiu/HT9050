From af589363e90dc840ba6144ae21ce146dc797792a Mon Sep 17 00:00:00 2001
From: "HT9045 Machine (V906)" <Claude_RDBC_02@honprec.com>
Date: Wed, 30 Sep 2026 16:11:47 +0800
Subject: [PATCH] JOGBLUR (web): a held JOG no longer stops when some input
 loses focus

The release listeners are registered in the capture phase, and a capture
listener for 'blur' on window receives the blur of EVERY element, not just
the window. Pressing JOG while an input (e.g. the speed box) had focus
blurred that input at the same moment -> treated as release -> stop sent
right after the jog started (Teach and Motor Test, both use this module).
Only a blur whose target is the window itself counts as release now;
pointerup / mouseup / pointercancel / hidden page still stop as before.

Offline A/B check (headless Edge, no C++): old version: input blur -> stop;
new version: input blur -> still jogging, pointerup -> stop, window blur ->
stop.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 page/motor-access.js | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/page/motor-access.js b/page/motor-access.js
index 3211cf5..69d1a72 100644
--- a/page/motor-access.js
+++ b/page/motor-access.js
@@ -254,6 +254,10 @@
                  [window, 'blur'], [document, 'visibilitychange']];
       var up = function (ev) {
         if (ev && ev.type === 'visibilitychange' && document.visibilityState !== 'hidden') return;
+        // AI(W906-JOGBLUR) 20260930：blur 是用捕捉階段（第三參數 true）掛在 window 上的 —— 捕捉階段會收到「任何元件」的 blur，
+        //   不只是視窗失焦。按下 JOG 的那一刻，原本有焦點的輸入框（例：速度欄）失焦 → 被當成放開 → 寸動一開始就停。
+        //   只有視窗本身失焦才算放開（ev.target===window）；放開滑鼠／手指、pointercancel、頁面被藏起來照舊都送停止。
+        if (ev && ev.type === 'blur' && ev.target !== window) return;
         for (var i = 0; i < evs.length; i++) evs[i][0].removeEventListener(evs[i][1], up, true);
         release(button);
       };
