From 7ad6f42b0cc4f02d18516aadf59ec1ebe724f203 Mon Sep 17 00:00:00 2001
From: "HT9045 Machine (V906)" <Claude_RDBC_02@honprec.com>
Date: Sat, 10 Oct 2026 20:40:44 +0800
Subject: [PATCH] TEACH-IOCHECK (web): the Teach page's IO Check button opens
 the same IO screen as the main IO button -- EastSun 1010 (two screenshots)
 'the red-framed button must show the same screen as the second picture'.
 btnIO was on TEACH_UNWIRED (grey, explanation only). Golden
 uteach.cpp:2942-2946 btnIOClick = fiosetview->ShowModal(), the screen
 main.cpp sbIOClick opens. Now off the list and, like btnMotorTest next to it,
 a click posts {open:'io'} -- the exact message main.html sbIO sends -- so
 background.html openWin('io') applies the same MODAL_POLICY guard, stacks the
 full-screen layer over Teach and returns to Teach on close. Fake-DOM test on
 the page's own list and handler: 7/7; the previous file: 2 red. Backup
 D:\HT9045\_backup\HW.teach.html.bak_btnio_20261010.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 page/HW.teach.html | 13 ++++++++++++-
 1 file changed, 12 insertions(+), 1 deletion(-)

diff --git a/page/HW.teach.html b/page/HW.teach.html
index 26f843c..d4ae679 100644
--- a/page/HW.teach.html
+++ b/page/HW.teach.html
@@ -185,8 +185,8 @@ function teachMarkUnwiredEl(el, why){
 //   SetCompomentIO／ScanLed（uteach.cpp:1598／:1372），按下＝BtnPanelLane1Click（uteach.cpp:3074）IOBitOn/Off；網頁版同樣借用
 //   ht9045_io_widgets.js（Alias 對 IO 表、依卡片回讀上色）＋ht9045_io_do.js（io.btnPanelClick），所以從這張清單拿掉。
 // AI(W906-TEACH-SPEEDBAR) 20261001：ScrollBar1（Speed Adjust）接上了（下面 teachSpeedBar），從這張清單拿掉。
+// AI(W906-TEACH-IOCHECK) 20261010：btnIO（IO Check）接上了（下面 btnMotorTest 那段旁邊），從這張清單拿掉。
 var TEACH_UNWIRED=[
-  ['btnIO','IO Check：還沒接（golden 會開 IO 視窗）。請從主選單開 IO 頁'],
   ['btnAutoTeachZ','Auto Teach Z：自動教導 Z 會讓機台自己動，依裁決這版不接（FileRW/Zteach.cpp:19-20）']
 ];
 // AI(W906-TEACH-UNWIRED-2) 20261001：EastSun「一堆按鈕沒功能」「用枚舉 每個東西都檢查」—— Teach 檢查（幫手枚舉 1490 個元件）找到 75 顆
@@ -1239,6 +1239,17 @@ function teachBindGoHints(pts, elByTitle){
     if (window.parent !== window) window.parent.postMessage({open: 'motortest'}, '*');
   });
 })();
+/* AI(W906-TEACH-IOCHECK) 20261010：EastSun「第一張紅框處的按鈕要跟第二張圖案下去Show的畫面一樣」——
+   btnIO（IO Check）＝ golden uteach.cpp:2942-2946 TfTeach::btnIOClick -> fiosetview->ShowModal()，也就是主畫面 IO 按鈕開的同一個畫面。
+   做法同上面的 btnMotorTest：請 background.html 開 'io'（openWin：同一個 MODAL_POLICY 守衛、全螢幕層疊在 Teach 之上、關掉彈回 Teach）。 */
+(function(){
+  var b = document.getElementById('btnIO');
+  if (!b) return;
+  b.style.cursor = 'pointer';
+  b.addEventListener('click', function(){
+    if (window.parent !== window) window.parent.postMessage({open: 'io'}, '*');
+  });
+})();
 </script>
 <script src="qwerty.js"></script>
 <script src="ht9045_recipe_client.js"></script>
