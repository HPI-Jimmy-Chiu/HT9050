From b1f0d95a19fba91d7d6f329f7bb2d35cc381c557 Mon Sep 17 00:00:00 2001
From: "HT9045 Machine (V906)" <Claude_RDBC_02@honprec.com>
Date: Fri, 2 Oct 2026 10:13:12 +0800
Subject: [PATCH] TAGS-RECONNECT: the main frame reconnects its tag stream --
 Teaching was refused as 'machine running / signal unknown' after wb_serve
 restarted

EastSun 20261002: pressing Tools > Teaching kept showing the page-access refusal (machine running or the status signal unknown / stale).
The machine was stopped (SystemStart 0, pump ARMED).  background.html opened the tag stream once at load; when the wb_serve the page
had connected to ended (09:53, ended by VS Code), the socket closed and nothing reconnected (the registry heartbeat only runs while
connected), so guard.systemStart stayed unknown and decideOpen refused every guarded page -- also against the wb_serve restarted at
10:01.  Now: not connected -> HT9045Tags.connect() every 2 s, then refreshGuardUi (a new connection gets the full snapshot first).

Verified: headless Edge, fake socket: connected, socket closed by the 'server', a new socket opened and connected within 3.5 s, 0 JS
errors.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 background.html | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/background.html b/background.html
index 23a9552..8f04a25 100644
--- a/background.html
+++ b/background.html
@@ -1163,6 +1163,15 @@ function applyPageTable(v){
     .forEach(function(t){ HT9045Tags.on(t,function(){ refreshGuardUi(); }); });
   // AI(W906-PAGETAB-Q51) 20260928 [W906] H3：聽 C++ 的頁面表（本體 applyPageTable，定義在這一段前面）。
   if(window.HT9045Tags) HT9045Tags.on('ui.pages',function(v){ applyPageTable(v); });
+  // AI(W906-TAGS-RECONNECT) 20261002：EastSun「Teaching 還是跳『機台運轉中（或機台狀態訊號不可知／已 stale）』」——
+  //   tag 串流只在開頁時連一次；wb_serve 結束（或被重開）後 socket 關了就再也沒人重連（下面那支心跳只在「連著」時才送），
+  //   guard.systemStart 從此不可知 ⇒ decideOpen 一律擋（09:53 的 wb_serve 結束後，10:01 重開的那支也接不回來）。
+  //   沒連著就每 2 秒重連一次；新連線先收完整 snapshot（WebBridgeServer），guard.* 就回來了。
+  if(window.HT9045Tags) setInterval(function(){
+    var c=false;
+    try{ c=window.HT9045Recipe && HT9045Recipe.status().connected; }catch(e){}
+    if(!c){ try{ HT9045Tags.connect().then(function(){ refreshGuardUi(); },function(){}); }catch(e){} }
+  },2000);
   // 新連線 -> 重送全量（契約 §4：連線建立時送全量）。
   setInterval(function(){
     var c=false;
