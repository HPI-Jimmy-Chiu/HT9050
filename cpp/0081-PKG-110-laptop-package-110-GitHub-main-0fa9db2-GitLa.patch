+        Check(had == g.had && now == g.bytes, "real machine file unchanged: " + g.path);
+    }
+    std::printf("test_eboot005_customername: %d passed, %d failed\n", g_pass, g_fail);
+    return g_fail ? 1 : 0;
+}
