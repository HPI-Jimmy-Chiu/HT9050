             if(flag1==false)                                                    //Steven 20230109 : 修正Shuttle在正負一時可能會死雞
-                flag1=MOT[MTestZ1].Gali_Two_ZAxis_Move(Prod.TestZ1_Safe, 30000, "ProcessMotorHome 1520");               //JerryYang 20160905 10 --> Prod.TestZ1_Safe
+                flag1=W906_HomeTwoZ(W906_HomePos(Prod.TestZ1_Safe), 30000, "ProcessMotorHome 1520");               //JerryYang 20160905 10 --> Prod.TestZ1_Safe
             #endif
             if(flag2==false)
                 flag2=W906_HomeMove(MInShuttle1, W906_HomePos(Prod.InSHT[0].iLeft));
@@ -4717,7 +4749,7 @@ bool ProcessMotorHome(bool Flag2)
             }
             return true;
         case 2000:                                                              //Steven 20140828 Start: 歸零後檢查Index位置
-            if(MOT[MTestZ1].Gali_Two_ZAxis_Move(Prod.TestZ1_Safe, 30000, "ProcessMotorHome 2000"))                      //JerryYang 20160905 10 --> Prod.TestZ1_Safe
+            if(W906_HomeTwoZ(W906_HomePos(Prod.TestZ1_Safe), 30000, "ProcessMotorHome 2000"))                      //JerryYang 20160905 10 --> Prod.TestZ1_Safe
                 fHome->iHomeStep=2010;
             break;
         case 2010:
@@ -4781,7 +4813,7 @@ bool ProcessMotorHome(bool Flag2)
                 fHome->iHomeStep=2100;                                          //kevin 20210908 index arm 沒有在 Shuttle Up
             break;
         case 2100:
-            if(MOT[MTestZ1].Gali_Two_ZAxis_Move(-10, 30000, "ProcessMotorHome 2100"))                                   //Steven 20140828
+            if(W906_HomeTwoZ(-10, 30000, "ProcessMotorHome 2100"))                                   //Steven 20140828
             {
                 flag1=true;
                 ResetOKDeleyTime.SetMSAndOn(100);
@@ -4822,7 +4854,7 @@ bool ProcessMotorHome(bool Flag2)
             }
             break;
