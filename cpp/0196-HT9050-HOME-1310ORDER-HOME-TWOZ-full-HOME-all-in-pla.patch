diff --git a/uhome.cpp b/uhome.cpp
index 8c5f75a..dc68165 100644
--- a/uhome.cpp
+++ b/uhome.cpp
@@ -716,6 +716,15 @@ static bool W906_AxisOff(int i) { return W906_IsHT9050() && (MOT[i].Motor==NULL
 static int  W906_HomeMove(int i, int p) { return W906_AxisOff(i) ? 1 : MOT[i].MotorMove(p); }
 static bool W906_HomeTwoY(int p1, int p2, int t, AnsiString s) { return W906_AxisOff(MTestY1) || MOT[MTestY1].GalilTwoY_Move(p1, p2, t, s); }
 static bool W906_HomeTrayArm(int p) { return W906_AxisOff(MTrayX) || TrayArmMotorMove(p); }
+//AI(W906-HOME-TWOZ) 20261003: Gali_Two_ZAxis_Move only reports done without a motor object in this tree (Motor/mymotor.cpp), so on HT9050 --
+//  where MTestZ1 is a PCI-1203 axis -- the full HOME's Index Z moves (steps 700 / 1260 / 1520 / 2000-3000) would wait for ever. HT9050: the
+//  single-axis move of MTestZ1 (speed from the axis). Other machines: golden.
+static bool W906_HomeTwoZ(int p, int sp, AnsiString s)
+{
+    if(W906_AxisOff(MTestZ1)) return true;
+    if(W906_IsHT9050()) return MOT[MTestZ1].MotorMove(p)!=0;
+    return MOT[MTestZ1].Gali_Two_ZAxis_Move(p, sp, s);
+}
 #define W906_HomePos(x) (W906_IsHT9050() ? 0 : (x))
 static TQPF_Timer s_W906HomeResetWait;
 static int        s_W906HomeAfterReset = 310;
@@ -3437,7 +3446,7 @@ bool ProcessMotorHome(bool Flag2)
             #ifdef DEBUG_HOME                                                   //wei (Steven) 20170317 快速回Home開關
             fHome->iHomeStep=710;
             #else
-            if(MOT[MTestZ1].Gali_Two_ZAxis_Move(Prod.TestZ1_Safe, 30000, "ProcessMotorHome 700"))                       //Steven 20140828 : 歸零後檢查Index位置    //JerryYang 20160905 10 --> Prod.TestZ1_Safe
+            if(W906_HomeTwoZ(W906_HomePos(Prod.TestZ1_Safe), 30000, "ProcessMotorHome 700"))                       //Steven 20140828 : 歸零後檢查Index位置    //JerryYang 20160905 10 --> Prod.TestZ1_Safe
                 fHome->iHomeStep=710;
             #endif
             break;
@@ -3789,7 +3798,7 @@ bool ProcessMotorHome(bool Flag2)
             #endif
             break;
         case 1260:
-            if(MOT[MTestZ1].Gali_Two_ZAxis_Move(Prod.TestZ1_Safe, 30000, "ProcessMotorHome 1260"))                      //Steven 20140828 : 歸零後檢查Index位置    //JerryYang 20160905 10 --> Prod.TestZ1_Safe
+            if(W906_HomeTwoZ(W906_HomePos(Prod.TestZ1_Safe), 30000, "ProcessMotorHome 1260"))                      //Steven 20140828 : 歸零後檢查Index位置    //JerryYang 20160905 10 --> Prod.TestZ1_Safe
             {
                 fHome->iHomeStep=1270;
             }
@@ -4090,7 +4099,12 @@ bool ProcessMotorHome(bool Flag2)
             if(W906_AxisOff(MAuto1Z))      flag18[1]=true;
             if(W906_AxisOff(MAuto2Z))      flag18[2]=true;
 
-            if(ResetOKDeleyTime.Off())                                          //Kevin  20110525 start
+            //AI(W906-HOME-1310ORDER) 20261003: EastSun「都完成了 就是hang up」(23:00:11 timeout with no axis listed): golden tests the timeout before
+            //  "all in place", and the 30 s timer is started back at step 1250 / 1270, so arriving with it spent stopped HOME although every axis was
+            //  there. HT9050: all in place wins over the timeout. Other machines: golden order.
+            if(ResetOKDeleyTime.Off() &&                                        //Kevin  20110525 start
+               !(W906_IsHT9050() && flag1 && flag2 && flag3 && flag4 && flag5 && flag6 && flag7 && flag8 && flag9 && flag10 &&
+                 flag14[0] && flag14[1] && flag14[2] && flag14[3] && flag18[0] && flag18[1] && flag18[2]))
             {
                 if(flag1==false)
                     sBuffer+=" MTestY1,";
@@ -4170,7 +4184,25 @@ bool ProcessMotorHome(bool Flag2)
                         bCyflag[3]=(Cylinder[C_TrayXFloodgate4].Enable==false || Cylinder[C_TrayXFloodgate4].Pop());
 
                     if(!(bCyflag[0] && bCyflag[1] && bCyflag[2] && bCyflag[3]))
+                    {
+                        //AI(W906-HOME-1310ORDER) 20261003: HT9050 -- a floodgate that never pops up is named instead of waiting silently
+                        //  (a cylinder with Enable false is not checked: golden's `Enable==false ||` above).
+                        if(W906_IsHT9050() && ResetOKDeleyTime.Off())
+                        {
+                            std::string w906Cy;
+                            for(int j=0; j<4; j++) if(!bCyflag[j]) w906Cy+=" C_TrayXFloodgate"+std::to_string(j+1)+",";
+                            W906_HomeNote("step 1310 timeout, Tray Arm floodgate not up:" + w906Cy + " -> HT9050: HOME stopped");
+                            fHome->ListBox1->Items->Insert(0, AnsiString(("Step 1310 timeout, floodgate not up:" + w906Cy).c_str()));
+                            StopAllMotor();
+                            SystemStart=false;
+                            ShowMyMessage(AnsiString(("Home step 1310 timeout, Tray Arm floodgate not up:" + w906Cy).c_str()), AnsiString(("回原點第 1310 步逾時，Tray Arm 閘門氣缸沒上來：" + w906Cy).c_str()));
+                            fHome->fAbort=false;
+                            fHome->iHomeStep=1;
+                            SoftStop=true;
+                            return true;
+                        }
                         break;
+                    }
 
                     if(!W906_IsHT9050() &&                                      //AI(W906-HT9050-HOMEPOS0) 20261003: HT9050 skips this check -- the Tray Arm is sent to 0 (its
                        (((iTrayArmPos-100>=MOT[MTrayX].ReadEncoderPos()) &&      //  origin), so its origin lamp can be on and golden would stop HOME here (EastSun「其他軸也歸原點 不要跳出0移動視窗」)
@@ -4198,7 +4230,7 @@ bool ProcessMotorHome(bool Flag2)
                 flag1=true;                                                     //Steven 20260612 : Fix == to = (was comparison, not assignment)
