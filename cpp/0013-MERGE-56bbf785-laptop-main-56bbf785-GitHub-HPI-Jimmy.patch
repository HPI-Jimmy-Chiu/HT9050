+    // ---- captions (the golden panels, after golden wrote them) -------------
+    std::string j;
+    j.reserve(8192);
+    j += "{\"form\":\"TfObserver\",\"caption\":\"Observer\",\"act\":" + W906Obs_QS(open ? "open" : act);
