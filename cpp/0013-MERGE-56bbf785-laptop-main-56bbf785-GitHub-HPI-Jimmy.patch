+bool NumbersOk(std::string* bad)
+{
+    for (const char* n : kTIF_ToDoubleTexts) {
+        TCustomEdit* e = dynamic_cast<TCustomEdit*>(filerw::ELFind("TFTestIF", n));
+        if (!e) { *bad += std::string(bad->empty() ? "" : ", ") + n + "(no proxy)"; continue; }
