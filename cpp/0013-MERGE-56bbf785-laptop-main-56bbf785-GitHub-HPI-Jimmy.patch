+              'D  %s：%s 畫出 %d 列 × %s 欄 ＝ tag %r×%r（null 時 dfm 3x3）' % (label, g, len(d['rows']), shape, rows, cols))
+        bad, badbg = [], []
+        for r in range(min(er, len(d['rows']))):
+            for c in range(min(ec, len(d['rows'][r]))):
+                base = 'tcat.%s.r%d.c%d' % (g, r, c)
+                t, bg = v[base], v[base + '.bg']
