+# ---- golden V912 SplitEventLogCsvLine（:3812-3846） --------------------------------------------------
+def trim(bs):
+    b, e = 0, len(bs)
+    while b < e and bs[b] <= 0x20:
+        b += 1
+    while e > b and bs[e - 1] <= 0x20:
+        e -= 1
+    return bs[b:e]
