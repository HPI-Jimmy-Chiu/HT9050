+def disk_mailbox(web_root):
+    try:
+        return json.loads(open(os.path.join(web_root, 'JSON', 'runtime', 'Message-dialog-request.json'), 'rb').read().decode('utf-8'))
+    except Exception:                                              # noqa: BLE001
+        return {}
+
