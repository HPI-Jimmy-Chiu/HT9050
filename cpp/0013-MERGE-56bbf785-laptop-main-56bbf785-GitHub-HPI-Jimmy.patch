+                            bad_cell.append('%s="X" 但 bCloseSiteByIndexArm=0（golden :229/:277/:322 只在 A09 時畫 X）' % base)
+                        # 註：空白格可以是黃底 —— golden ProcessStartTestData（atester_ProcessCount.cpp:2012）
