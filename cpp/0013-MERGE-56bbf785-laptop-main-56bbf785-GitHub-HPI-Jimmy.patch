+class Buf:
+    """UTF-8 位元組緩衝，以 (lineno, col_offset) 定位。"""
+    def __init__(self, text):
+        self.b = text.encode('utf-8')
+        self.starts = [0]
+        for i, ch in enumerate(self.b):
+            if ch == 0x0A:
