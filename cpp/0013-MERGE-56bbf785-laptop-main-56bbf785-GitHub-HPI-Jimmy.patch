+        s = state(cdp)
+        check(s['created'] is True, 'O  W906_Create 已跑（golden 開機建立表單的 ctor＋OnCreate）')
+        verify_open(s)
+        # 本行程第一次開窗才能拿 Summary 跟檔案比（golden 只在建立表單時讀一次）；wb_serve 剛啟動時才成立
