+def fmt(v):
+    """引擎 tagFmt：null→'---'；數字依小數位（sort.loading 是 0 位）；其他 String(v)。"""
+    if v is None:
+        return '---'
+    if isinstance(v, bool):
+        return 'true' if v else 'false'
+    if isinstance(v, (int, float)):
+        return str(int(round(v)))
+    return str(v)
