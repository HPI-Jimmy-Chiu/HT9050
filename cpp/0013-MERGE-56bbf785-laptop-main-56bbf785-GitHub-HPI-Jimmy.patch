+    std::snprintf(b, sizeof(b), "%04u-%02u-%02uT%02u:%02u:%02u.%03u",
+                  (unsigned)t.wYear, (unsigned)t.wMonth, (unsigned)t.wDay,
+                  (unsigned)t.wHour, (unsigned)t.wMinute, (unsigned)t.wSecond, (unsigned)t.wMilliseconds);
