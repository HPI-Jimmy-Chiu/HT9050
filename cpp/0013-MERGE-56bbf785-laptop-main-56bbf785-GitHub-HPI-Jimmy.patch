+    data = open(main, 'rb').read()
+    if os.path.exists(back) and open(back, 'rb').read() != data:
+        data = open(back, 'rb').read()
+    size = len(data)
+    if size == 2432:
+        per, nb, ifx = 19, 15, 18
+    elif size == 12800:
+        per, nb, ifx = 100, bincount, bincount + 3
+    elif size == 13312:
