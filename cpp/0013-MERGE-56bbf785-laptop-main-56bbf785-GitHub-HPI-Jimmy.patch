+bool StrItem(const cJSON* root, const char* key, std::string* out, bool* present)
+{
+    const cJSON* j = cJSON_GetObjectItemCaseSensitive(root, key);
+    if (present) *present = (j != 0);
+    if (!j) return true;
+    if (!cJSON_IsString(j) || !j->valuestring) return false;
+    *out = j->valuestring;
+    return true;
+}
