+        check(not bad, 'D  %s：%s 每格文字＝tag（null→"---"；不符 %d：%s）' % (label, g, len(bad), bad[:4]))
+        check(not badbg, 'D  %s：%s 明確底色格的 computed background＝TColor RGB（不符：%s）' % (label, g, badbg[:4]))
+
+
