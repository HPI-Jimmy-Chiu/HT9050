+    rec.from    = from.c_str();
+    rec.to      = to.c_str();
+    rec.flags   = (int)o.fFlags;
+    rec.ret     = ret;
+    rec.aborted = (o.fAnyOperationsAborted != FALSE);
+    f->vW906ShOps.push_back(rec);
+    return ret;
