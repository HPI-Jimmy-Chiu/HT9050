+                    if(CosFunction.bBarcodeErrNoTestAndShowH==true &&           //jou 20191007 : Barcode Error No Test & Show "H"
+                       TestIF_File.bEnableBarCode==true &&
+                       (TestSocket.cDeviceInf[ARow-1][ACol-1]==asBarCodeErrorSend ||
