+# ---- C 語意的整數運算（golden 是 32-bit long／int） ------------------------------------------------
+def cdiv(a, b):
+    q = abs(a) // abs(b)
+    return q if (a >= 0) == (b >= 0) else -q
+
+
+def cmod(a, b):
+    return a - b * cdiv(a, b)
