+namespace {
+void W906IdxRelease(TMyMotor& m)                                                // golden: the Z1 / Z2 interlock is given back on arrival
+{
+    if (m.Mot_Name == MTestZ1) IndexZCanMove[1] = true;
+    else if (m.Mot_Name == MTestZ2) IndexZCanMove[0] = true;
+}
+
+void W906IdxStop(TMyMotor& z, const char* why)                                  // golden "ST" on the Index: decelerate, the next move re-issues
+{
+    if (z.Motor == NULL) return;
+    z.Motor->DecStop();
+    z.fCMD = false;
+    z.MovFlag = false;
+    std::printf("[IDX1203] %s stop (%s)\n", z.Alias.c_str(), why ? why : "");
+}
+
+int W906IdxJamMot(int motName)
+{
+    return motName == MTestY1 ? 13 : motName == MTestZ1 ? 14 : motName == MTestZ2 ? 15 : 16;   // golden GaliAxisAlarm[0..3] -> jam 13..16
+}
+
+bool W906IdxFieldValue(const std::string& args, long* v)                        // "Y=n" or a Galil field list "a,b,c,d" (Y = the 2nd field)
+{
+    std::string::size_type e = args.find('=');
+    if (e != std::string::npos) {
+        if (args.substr(0, e).find('Y') == std::string::npos && args.substr(0, e).find('y') == std::string::npos) return false;
+        *v = std::atol(args.c_str() + e + 1);
+        return true;
+    }
+    std::string::size_type c1 = args.find(',');
+    if (c1 == std::string::npos) return false;
+    *v = std::atol(args.c_str() + c1 + 1);
+    return true;
+}
+}  // namespace
