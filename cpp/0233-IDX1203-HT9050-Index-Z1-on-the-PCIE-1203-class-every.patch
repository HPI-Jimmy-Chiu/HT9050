+bool W906_IndexMove(TMyMotor& m, int pos, int speed, int mode, const char* who)
+{
+    const AnsiString sWho(who ? who : "");
+    if (!W906_IdxIs1203(m)) {                                                   // the Galil Index: golden's function of that mode
+        switch (mode) {
+        case kIdxMoveNoWait:      return m.Gali_MotMoveNoWait(pos, speed, 0, true);
+        case kIdxMoveSkipEncoder: return m.Gali_MotMoveSkipEncoder(pos, speed);
+        case kIdxMoveTwoZ:        return m.Gali_Two_ZAxis_Move(pos, speed, sWho);
+        default:                  return m.Gali_MotMove(pos, speed, sWho);
+        }
+    }
+    const AnsiString sFunc = AnsiString("W906_IndexMove_") + sWho;
+    if (m.Motor->CheckIsSafeDoorOpen()) return false;                           // golden: every Gali_* move refuses while the door is open
+    if (m.Mot_Name == MTestZ1 && IndexZCanMove[0] == false) return false;       // golden Gali_MotMove: the Z1 / Z2 interlock
+    if (m.Mot_Name == MTestZ2 && IndexZCanMove[1] == false) return false;
+    if (m.MovFlag && m.TargetPosition != pos) m.MovFlag = false;                // golden :2010-2015: a new target re-issues the move
+    if (!m.MovFlag) {                                                           // golden's first call of a move
+        if (m.Mot_Name == MTestZ1 && CheckTestZ1(sFunc) == false) return false; // golden: command vs encoder of Z1 (and the Y axes) before a Z1 move
+        if (m.Mot_Name == MTestZ2 && CheckTestZ2(sFunc) == false) return false;
+        if (ScanIndexMotorCanMove() == false) return false;                    // golden: an Index alarm refuses (its jam popup); reads the 1203 through Gali_ScanAlarmStatus
+        if (speed > 0) m.Motor->SetSpeed((unsigned int)speed);                  // the 1203 class's own speed (TMyMotor::SetSpeed is not used for the Index names)
+        m.TargetPosition = pos;
+        m.MovFlag = true;
+        m.bScanFlag = false;
+        m.GaliSofDelayCount = 0;
+        m.Led[iInposLed] = true;                                                // golden sets it when the move is sent
+        if (m.Mot_Name == MTestZ1) IndexZCanMove[1] = false;                    // golden: Z2 may not move while Z1 does
+        else if (m.Mot_Name == MTestZ2) IndexZCanMove[0] = false;
+    }
+    const int rc = m.MotorMove(pos);                                            // the 1203 class: 1 arrived, 0 moving, < 0 refused / failed (its own message)
+    if (rc == 0) return false;
+    if (rc < 0) {
+        if (rc == -1) return false;                                             // safe door opened: the move stays armed (golden returns false the same way)
+        m.MovFlag = false;                                                      // -2 / -3 soft limit, -5 encoder WAR1639, -6 home sensor: never an arrival
+        m.bScanFlag = false;
+        m.GaliSofDelayCount = 0;
+        std::printf("[IDX1203] %s MotorMove(%d) = %d (%s) -- not arrived\n", m.Alias.c_str(), pos, rc, sFunc.c_str());
+        return false;
+    }
+    if (mode == kIdxMoveWait || mode == kIdxMoveTwoZ) {                         // golden Gali_MotMove :2018-2041: the encoder range check
+        const bool flag = (m.Mot_Name == MTestY1 || m.Mot_Name == MTestY2 || pos == 0) ? m.Gali_ReadEncoderInRandge(pos)
+                                                                                      : m.Gali_ReadEncoderMaxRandge(pos);
+        if (flag == false) {
+            iHome = 1;
+            JamCode = MotorIndexToJamCode(W906IdxJamMot(m.Mot_Name));
+            ShowMotorErrorMessage(JamCode, MotErrPos+1, sFunc);
+            m.bScanFlag = false;
+            m.GaliSofDelayCount = 0;
+            m.MovFlag = false;
+            return false;                                                       // golden keeps the interlock taken here too
+        }
+    }
+    m.bScanFlag = false;
+    m.GaliSofDelayCount = 0;
+    m.MovFlag = false;
+    W906IdxRelease(m);
+    return true;
+}
+
+bool W906_Idx1203Command(int receiver, const char* data, long* reply)
+{
+    (void)receiver;                                                             // a Galil string addresses the axes by letter, whoever sends it
+    if (!W906_Idx1203Machine()) return false;
+    TMyMotor& z = MOT[MTestZ1];
+    long rv = 0;
+    bool stopped = false;                                                       // one stop per string ("VS0;SP0,0,0,0;" is one halt)
+    const std::string s(data ? data : "");
+    std::string::size_type i = 0;
+    while (i < s.size()) {
+        std::string::size_type j = s.find(';', i);
+        if (j == std::string::npos) j = s.size();
+        std::string t = s.substr(i, j - i);
+        i = j + 1;
+        while (!t.empty() && (t[0] == ' ' || t[0] == '\t')) t.erase(0, 1);
+        if (t.size() < 2) continue;
+        const std::string c = t.substr(0, 2);
+        const std::string a = t.substr(2);
+        const bool y = a.empty() || a.find('Y') != std::string::npos || a.find('y') != std::string::npos;   // Galil Y = MTestZ1 (Gali_GetMOT)
+        if (c == "ST") { if (y && !stopped) { W906IdxStop(z, s.c_str()); stopped = true; } }
+        else if (c == "AB") { if (!stopped) { W906IdxStop(z, s.c_str()); stopped = true; } }                       // AB / AB1: every axis
+        else if (c == "VS") { if (std::atol(a.c_str()) == 0 && !stopped) { W906IdxStop(z, s.c_str()); stopped = true; } }   // "VS0;SP0,0,0,0": golden's halt
+        else if (c == "SP") {                                                   // SP0,0,0,0 = halt; a speed alone moves nothing on the 1203
+            if (a.find_first_not_of("0,=XYZWxyzw ") == std::string::npos && a.find('0') != std::string::npos && !stopped) { W906IdxStop(z, s.c_str()); stopped = true; }
+        }
+        else if (c == "SH") { if (y) z.Motor->SetServoOn(true); }
+        else if (c == "MO") { if (y) z.Motor->SetServoOn(false); }
+        else if (c == "DP" || c == "DE") {                                      // golden sets the Galil position; the 1203 route writes only "command := encoder"
+            long v = 0;                                                         //   (Q1: a ResetPos(p) more than 1 pulse from the encoder is refused -- mymotor.cpp PCIL132_ResetPos, R230)
+            if (W906IdxFieldValue(a, &v)) z.PCIL132_ResetPos();
+        }
+        else if (c == "TP") { if (y) rv = z.Motor->ReadEnCoderRealPos(); }      // as the Galil route: TP = + actual
+        else if (c == "TD") { if (y) rv = -z.Motor->ReadRealPos(); }            //                      TD = - command
+        else if (c == "TI") { z.ScanMotorStatus(); rv = (z.Led[iAlarmLed] || z.Led[iServoalarmLed]) ? 0x08 : 0; }   // MyLongMask[3] = Z1's TI bit
+        else if (c == "MG") {
+            const std::string op = (a.size() >= 3 && a[0] == '_') ? a.substr(1) : a;
+            if (op.size() >= 3 && (op[2] == 'Y' || op[2] == 'y')) {
+                if (op.compare(0, 2, "BG") == 0) rv = z.Motor->MotionDone() ? 0 : 1;
+                else if (op.compare(0, 2, "MO") == 0) { z.ScanMotorStatus(); rv = z.Led[iServoOn] ? 0 : 1; }
+            }
+        }
+        else if (y && (c == "PA" || c == "PR" || c == "BG" || c == "JG" || c == "HM" || c == "FI" || c == "LM")) {
+            static bool s_said = false;                                         // a raw Galil motion string: the Gali_* move members take the 1203 branch instead
+            if (!s_said) { s_said = true; std::printf("[IDX1203] Galil motion string '%s' not executed: the Index runs on the 1203 class (use the Gali_* move members)\n", s.c_str()); }
+        }
+        // KS / VT / AC / DC / XQ / TS / SC ...: no 1203 counterpart -> golden's no-card answer 0
+    }
+    if (reply) *reply = rv;
+    return true;
+}
+
+void W906_Idx1203ScanStatus(TMyMotor& m)
+{
+    m.ScanMotorStatus();                                                        // INDEX_MOTION_CARD != 0: the 1203 class's lamps + the HT9050 ORG rule (mymotor.cpp)
+    if ((m.Led[iAlarmLed] || m.Led[iServoalarmLed]) && m.MovFlag == true) {     // golden's latch (Gali_ScanMotStatusTIMO / Gali_ScanAlarmStatus)
+        m.Gali_MotorAlarm = true;
+        if (Alarm) Alarm->Set(ALM_MOTOR_MOVE);
+    } else {
+        m.Gali_MotorAlarm = false;
+    }
+}
+
+bool W906_Idx1203SingalHome(TMyMotor& m)
+{
+    bool checkflag = false;
+    int  TestZSafePos = Prod.TestZ1_Safe;                                       //kevin 20160905
+    int& Task = m.iGali_SingalHomeTask;
+    switch (Task)
+    {
+        case 200:                                                               // golden Gali_MotHome -> the 1203 class's home
+        {
+            m.MotorInitial();                                                   // arms MotorHome (its task = 1, ResetTime, HomeFlag = 0), as HOME's ProcessMotorHome does for the other axes
+            const int rc = m.MotorHome(true);
+            m.MovFlag = true;
+            Task = (rc == 1) ? 400 : 250;
+            if (rc >= 2) { m.Gali_MotorAlarm = true; if (Alarm) Alarm->Set(ALM_MOTOR_MOVE); Task = 1; }   // MotorHome wrote why (op log HOME line)
+            break;
+        }
+        case 250:                                                               // golden 250 / 300 / 350
+        {
+            const int rc = m.MotorHome(false);
+            if (rc == 1) Task = 400;
+            else if (rc >= 2) { m.Gali_MotorAlarm = true; if (Alarm) Alarm->Set(ALM_MOTOR_MOVE); Task = 1; }
+            break;
+        }
+        case 400:                                                               // golden :3797-3823 (as W906_GaliRoutedSingalHome)
+            m.Motor->LastHomePos = m.Gali_ReadEncoderPos();
+            m.bScanFlag = false;
+            m.MovFlag = false;
+            m.GaliSofDelayCount = 0;
+            m.HomeFlag = 1;
+            if (m.Alias == "MTestZ1" || m.Alias == "MTestZ2")
+            {
+                if (m.Alias == "MTestZ1") checkflag = CheckTestZ1("Gali_SingalHome400");
+                if (m.Alias == "MTestZ2") checkflag = CheckTestZ2("Gali_SingalHome400");
+                Task = checkflag ? 450 : 500;
+            }
+            else
+            {
+                Task = 500;
+            }
+            break;
+        case 450:                                                               // golden :3824-3835
+            if (m.Alias == "MTestZ1" || m.Alias == "MTestZ2") TestZSafePos = Prod.TestZ1_Safe;
+            else TestZSafePos = 10;
+            if (m.Gali_MotMove(W906_Ht9050OrgHome(MTrayX) != -2 ? 0 : TestZSafePos, m.Motor->PHomeHighSpeed, "Gali_SingalHome_450"))   // HT9050: safe position 0 until taught (AI(W906-HT9050-HOMEPOS0)); the 1203 branch of Gali_MotMove
+                Task = 500;
+            break;
+        case 500:                                                               // golden :3836-3847
+            Task = 900;
+            return true;
+        case 900:                                                               // golden: done, nothing until the caller re-arms Task = 1
+            break;
+        default:                                                                // golden 1 / 5 / 8: the axis idle and servo on, then the home
+            if (m.Motor->MotionDone() == false) break;
+            W906_Idx1203ScanStatus(m);
+            if (m.Led[iServoOn] == false) { Task = 1; return false; }           // golden case 8: servo off -> back to 1
+            Task = 200;
+            break;
+    }
+    return false;
+}
