+            std::printf("index Z -> 1203 CLASS: INDEX_MOTION_CARD=%d -- MOT[%d] is a TMyEtherCatMotor; every Gali_* branches to the 1203 class (no Galil route); IndexZCanMove={1,1}; torque hook %s\n",
+                        INDEX_MOTION_CARD, MTestZ1, tq1203 ? "installed" : "NOT installed");
+            return;
+        }
         std::printf("index Z -> 1203: NOT routed -- %s. MTestZ1 stays on golden's no-card Galil branch (M13/M15/M16 stay as golden built them); torque hook NOT installed\n", why.c_str());
