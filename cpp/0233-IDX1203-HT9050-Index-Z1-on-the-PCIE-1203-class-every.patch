+//==============================================================================
+//  AI(W906-IDX1203) 20261006: the Index axis on the PCIE-1203 CLASS (Motor/GaliRoute.h, end; plan
+//  D:\HT9045\_idxmove_1006\PLAN_IDX1203_CLASS.md).  EastSun 1006: Q130 "INDEX_MOTION_CARD 改成非 0（用 MyMotor）",
+//  「gali 是不是有單獨class ? 可以用1203 class 分支?」, 「你可以統一 index 寫成一個移動函式 裡面再分支呼叫?」.
+//  With INDEX_MOTION_CARD != 0 golden builds the Index axes from the Mot_Table (cinitial.cpp InitialMotorParameter):
+//  HT9050's M14 MTestZ1 is a TMyEtherCatMotor, M13 / M15 / M16 are disabled, and no Galil card or route exists.  Each
+//  Gali_* member above calls in here at its top ONLY when W906_IdxIs1203(*this); its golden Galil body is not touched.
+//  NOT GOLDEN (golden has no 1203 Index); the golden flags (MovFlag, TargetPosition, IndexZCanMove, Gali_MotorAlarm,
+//  iGali_SingalHomeTask, HomeFlag) are kept so every golden caller reads them as before.
+//==============================================================================
+bool W906_IdxIs1203(const TMyMotor& m)
+{
+#if defined(W906_IDX1203_GALI_BRANCH)
+    if (INDEX_MOTION_CARD == 0) return false;                                   // golden's Galil Index (every machine today)
+    if (m.Mot_Name != MTestY1 && m.Mot_Name != MTestZ1 && m.Mot_Name != MTestZ2 && m.Mot_Name != MTestY2) return false;
+    if (m.Motor == NULL || m.Motor->Enable == false) return false;              // absent axis: W906_GaliRouteAbsentAxis
+    return m.CardType == AnsiString("PCI1203");                                 // cinitial.cpp: the row's CardModel -> new TMyEtherCatMotor
+#else
+    (void)m;
+    return false;
+#endif
+}
+
+bool W906_Idx1203Machine()
+{
+    return W906_IdxIs1203(MOT[MTestZ1]);
+}
