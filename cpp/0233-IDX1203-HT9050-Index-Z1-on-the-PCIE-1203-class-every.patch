index 95abb26..b99becf 100644
--- a/MachineType.h
+++ b/MachineType.h
@@ -1943,4 +1943,11 @@ bool W906_Ds402ZAtOrigin(int motIndex, bool lamp);
 //  W906_PCI1203_IO_THREAD_GAP_MS＝兩輪掃描之間休息多久（預設 10 ms）。
 #define W906_PCI1203_IO_THREAD
 //------------------------------------------------------------------------------
+//  AI(W906-IDX1203) 20261006: HT9050 的 Index Z1 走 1203 類別（EastSun 1006 Q130「INDEX_MOTION_CARD 改成非 0（用 MyMotor）」、
+//  「可以用1203 class 分支?」）。INDEX_MOTION_CARD≠0 時 golden 照馬達表建 Index 軸（M14 → TMyEtherCatMotor），Galil 轉送不安裝；
+//  每個 TMyMotor::Gali_* 開頭依類別分流：Index 軸是 1203 → 1203 類別（MotorMove／MotorHome／ScanMotorStatus／ReadPos／DecStop），
+//  否則原 Galil 程式不動（Motor/GaliRoute.h 檔尾、Motor/myGALILmotor.cpp 檔尾）。INDEX_MOTION_CARD=0＝不成立＝原本行為。
+//  註解掉＝INDEX_MOTION_CARD≠0 時 Gali_* 也照原版（沒有 Galil 卡 → 不動不停，HOME 1250 卡住），只供對照。
+#define W906_IDX1203_GALI_BRANCH
+//------------------------------------------------------------------------------
 #endif
