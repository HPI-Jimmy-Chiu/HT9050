+int main(int argc, char** argv)
+{
+    std::setvbuf(stdout, 0, _IONBF, 0);
+    if (!W906TestRequireCtestRedirects("NB2_W188InspectOut"))
+        return 2;
+    std::printf("==== W-188 #9 InspectOutArmPosition -> golden 913 ====\n");
