+    EnsureArmOffsetObjects();
+    for (int i = 0; i < eTrayCount; ++i) AutoForm[i] = &TrayForm.Auto[i];
+    OutArmSuck.iPickStep = 1;
+    OutArmSuck.Item[iOutArmYBase][iOutArmXBase] = HAS_IC;
+    InputLimit.iOffsetXYHigh = 1;                     // +-100 pulses
