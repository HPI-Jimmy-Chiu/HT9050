+    // ---------------------------------------------------------------- [1] place to the out rotator
+    std::printf("-- [1] place to rotator --\n");
+    tRotate.ColCount = 2;
+    iRotateKIT_Start_X_H = 1000;  iRotateKIT_Pitch_X_H = 2000;
