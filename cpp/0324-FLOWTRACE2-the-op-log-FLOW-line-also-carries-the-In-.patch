+// ===========================================================================
+//  [FT] AI(W906-FLOWTRACE2) 20261008: the op-log FLOW line carries the values EastSun asked for (csystem.cpp W906_FlowTraceTick).
+// ===========================================================================
+void W906_FlowTraceTick(); extern void (*g_W906FlowNote)(const char*);
+extern int iPickFromLoadStageTask, CatchTrayTask, iCatchFromEmpty9050Task;
+static std::string s_ftLast;
+static void FtCapture(const char* s) { s_ftLast = s ? s : ""; }
+void FlowTraceTail()
+{
+    printf("[FT] FLOW line tail: pick / Tray Arm / Empty cursors, layer counts, InArmSuckUse and InArm IC bits\n");
+    void (*saved)(const char*) = g_W906FlowNote;
+    g_W906FlowNote = &FtCapture;
+    const int sPick = iPickFromLoadStageTask, sCatch = CatchTrayTask, sEmp = iCatchFromEmpty9050Task;
+    bool sUse[MAX_ARM_Row][MAX_ARM_Col];
+    for (int i = 0; i < MAX_ARM_Row; ++i) for (int j = 0; j < MAX_ARM_Col; ++j) { sUse[i][j] = InArmSuckUse[i][j]; InArmSuckUse[i][j] = false; }
+    InArmSuck.ClearAll();
+    iPickFromLoadStageTask = 1100; CatchTrayTask = 500; iCatchFromEmpty9050Task = 20;
+    iLoaderLayerCount_9050 = 0; iEmptyLayerCount_9050 = 4; iAuto1LayerCount_9050 = 1; iAuto2LayerCount_9050 = 0; iAuto3LayerCount_9050 = 2;
+    InArmSuckUse[0][0] = true; InArmSuckUse[1][3] = true;
+    s_ftLast.clear();
+    W906_FlowTraceTick();
+    CHECK(s_ftLast.find(" | pickLd=1100 trayArm=500 empPick=20 | layer L=0 E=4 A=1/0/2 | suckUse=1000/0001 suckIC=0000/0000") != std::string::npos,
+          "FLOW tail: cursors, layer counts, InArmSuckUse rows 1000/0001, no IC on the In Arm");
+    if (s_ftLast.find("pickLd=") == std::string::npos) printf("    got: %s\n", s_ftLast.c_str());
+    g_W906FlowNote = saved;
+    iPickFromLoadStageTask = sPick; CatchTrayTask = sCatch; iCatchFromEmpty9050Task = sEmp;
+    for (int i = 0; i < MAX_ARM_Row; ++i) for (int j = 0; j < MAX_ARM_Col; ++j) InArmSuckUse[i][j] = sUse[i][j];
+    iLoaderLayerCount_9050 = -1; iEmptyLayerCount_9050 = -1; iAuto1LayerCount_9050 = 0; iAuto2LayerCount_9050 = 0; iAuto3LayerCount_9050 = 0;
 }
