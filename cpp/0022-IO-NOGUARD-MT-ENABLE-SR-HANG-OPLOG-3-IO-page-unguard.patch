+//  ⚠ 在命令列的 gdb --batch 底下重現不出來（同樣的 SHFileOperation → 批次 → system(7z) 都正常），只有 VS Code 的
+//    MIEngine 驅動 gdb 時發生 —— 所以這裡修的是「會讓它卡住的環境差異」與「卡住時沒有上限」，不是一個重現到的單一行。
+//  差異：golden 是 VCL 視窗程式、自己沒有主控台，它用 CreateProcess(SW_HIDE) 叫起來的 cmd／7z 會各自拿到一個新的隱藏主控台；
+//        wb_serve 是主控台程式，子程式跟它（在 F5 底下＝跟除錯器）共用同一個主控台環境。
+//  所以：
+//    * 子程式一律 CREATE_NO_WINDOW（自己的隱藏主控台 = golden 的效果）、不繼承任何 handle（同 golden 的 bInheritHandles=false）；
+//    * 放進一個 job（JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE），逾時就 TerminateJobObject —— cmd 底下的 7z／robocopy 一起結束，
+//      背景工作一定會走到最後、放掉 W906_StateRecordWorkerBusy（以前 system() 沒有上限，一卡就永遠 busy）；
+//    * 背景執行緒開頭 CoInitializeEx（STA），結尾 CoUninitialize：SHFileOperation／ShellExecute 走 shell 的 COM 元件，
+//      Microsoft 的 ShellExecute 文件要求呼叫端的執行緒先初始化 COM。ole32 用 LoadLibrary 取（wb_serve 沒有連 ole32）。
+//  g_W906StateRecordNote：tools/wb_serve.cpp 的操作 LOG（W906_OpLogInit）裝上，把背景工作的每一步寫成 SREC 行；0 = 不記。
+// =============================================================================
+void (*g_W906StateRecordNote)(const char*) = 0;
+
+namespace {
+
+// 回傳 -1 = 起不來，0 = 在時限內結束（*exitCode = 它的離開碼），1 = 逾時，已連同子程式一起結束
+int W906_SrRunAndWait(const char* cmdline, const char* cwd, DWORD ms, DWORD* exitCode)
+{
+    STARTUPINFOA si;
+    PROCESS_INFORMATION pi;
+    ZeroMemory(&si, sizeof(si));
+    ZeroMemory(&pi, sizeof(pi));
+    si.cb = sizeof(si);
+    si.dwFlags = STARTF_USESHOWWINDOW;                                          // golden ExecZipCommand：SW_HIDE
+    si.wShowWindow = SW_HIDE;
+    std::string c(cmdline ? cmdline : "");
+    if (c.empty()) return -1;
+    HANDLE job = ::CreateJobObjectA(NULL, NULL);
+    if (job) {
+        JOBOBJECT_EXTENDED_LIMIT_INFORMATION li;
+        ZeroMemory(&li, sizeof(li));
+        li.BasicLimitInformation.LimitFlags = JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE;
+        ::SetInformationJobObject(job, JobObjectExtendedLimitInformation, &li, sizeof(li));
+    }
+    if (!::CreateProcessA(NULL, &c[0], NULL, NULL, FALSE, NORMAL_PRIORITY_CLASS | CREATE_NO_WINDOW | CREATE_SUSPENDED,
+                          NULL, (cwd && *cwd) ? cwd : NULL, &si, &pi)) {
+        if (job) ::CloseHandle(job);
+        return -1;
+    }
+    if (job && !::AssignProcessToJobObject(job, pi.hProcess)) { ::CloseHandle(job); job = 0; }   // 外層 job 不准巢狀時照跑，只是逾時只能結束它自己
+    ::ResumeThread(pi.hThread);
+    const DWORD w = ::WaitForSingleObject(pi.hProcess, ms);
+    int r = 0;
+    if (w != WAIT_OBJECT_0) {
+        r = 1;
+        if (job) ::TerminateJobObject(job, 1); else ::TerminateProcess(pi.hProcess, 1);
+        ::WaitForSingleObject(pi.hProcess, 5000);
+    }
+    DWORD code = 1;
+    ::GetExitCodeProcess(pi.hProcess, &code);
+    if (exitCode) *exitCode = code;
+    ::CloseHandle(pi.hThread);
+    ::CloseHandle(pi.hProcess);
+    if (job) ::CloseHandle(job);                                                // KILL_ON_JOB_CLOSE：批次留下來還在跑的子程式也在這裡結束
+    return r;
+}
+
+// 背景執行緒的 COM（STA）。同一時間只有一條背景工作（W906_StateRecordWorkerBusy），所以一個旗標就夠。
+void W906_SrComInit(bool on)
+{
+    typedef HRESULT (WINAPI *CoInitExFn)(LPVOID, DWORD);
+    typedef void (WINAPI *CoUninitFn)(void);
+    static bool inited = false;
+    HMODULE ole = ::LoadLibraryA("ole32.dll");                                  // 不 FreeLibrary：ole32 留著（每筆紀錄多兩次參考計數，無害）
+    if (!ole) return;
+    if (on) {
+        CoInitExFn f = (CoInitExFn)(void*)::GetProcAddress(ole, "CoInitializeEx");
+        inited = (f != 0) && SUCCEEDED(f(NULL, 0x2 /* COINIT_APARTMENTTHREADED */ | 0x4 /* COINIT_DISABLE_OLE1DDE */));
+    } else if (inited) {
+        CoUninitFn f = (CoUninitFn)(void*)::GetProcAddress(ole, "CoUninitialize");
+        if (f) f();
+        inited = false;
+    }
+}
+
+}  // namespace
