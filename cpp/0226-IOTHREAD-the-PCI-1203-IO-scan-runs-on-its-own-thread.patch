+// =============================================================================
+//  AI(W906-IOTHREAD) 20261005: THE IO THREAD -- EastSun「你可以把掃描IO 辦到一個新的執行續嗎? 並且可以跟原本執行續 互通有無」,
+//  design C (D:\HT9045\_iothread_1005\PLAN_IOTHREAD.md; the shared state + the contract are in EtherCAT/Pci1203IoMark.h).
+//
+//  * The IO thread is the only caller of the vendor API while it runs: it loops Poll() (back to back, g_w906IoGapMs apart)
+//    and serves the main thread's requests -- at every Poll yield point (within one vendor call) and between two polls.
+//  * A request is submitted by the main thread with Pci1203IoThreadRunSync and waited for (TPci1203Control::Execute,
+//    Vc8SdoReadI16, SetTorqueFocusAxis are proxied that way), so every caller keeps its synchronous result and the command
+//    path never runs on two threads at once. Only the main thread submits, one request at a time.
+//  * Every return path of a poll on the IO thread stages a copy (W906IoStage_); the main thread adopts the newest staged
+//    copy at its own safe points (Pci1203IoThreadAdopt: tools/wb_serve.cpp where it used to call Poll) by copy-assignment
+//    into the same vectors, so element references stay where they were (as with the old in-place Poll).
+//  * Not started (ctests, tools, a monitor that did not open) = nothing here runs and every accessor reads the monitor
+//    directly, exactly as before.
+// =============================================================================
+namespace {
+struct W906IoReq { void (*fn)(void*); void* arg; bool boundaryOnly; HANDLE done; };
+CRITICAL_SECTION g_w906IoQcs;                     // the request queue
+CRITICAL_SECTION g_w906IoScs;                     // the staged / published copies and their sequence numbers
+bool             g_w906IoCsInit = false;
+std::vector<W906IoReq*> g_w906IoQ;
+HANDLE           g_w906IoWake = 0;                // auto-reset: a request was queued, or stop
+HANDLE           g_w906IoThread = 0;
+volatile long    g_w906IoStop = 0;
+unsigned long    g_w906IoGapMs = 10;
+volatile long    g_w906IoHeart = 0;
+volatile long    g_w906IoServingMain = 0;         // a main-thread request is running (the main thread is blocked in RunSync)
+Pci1203IoSnap*   g_w906IoStagedP = 0;             // registered by the first stage
+Pci1203IoSnap*   g_w906IoPubP = 0;
+unsigned long    g_w906IoStagedSeq = 0;
+unsigned long    g_w906IoPubSeq = 0;
+
+void W906IoCsInit_()
+{
+    if (g_w906IoCsInit) return;
+    ::InitializeCriticalSection(&g_w906IoQcs);
+    ::InitializeCriticalSection(&g_w906IoScs);
+    g_w906IoCsInit = true;
+}
+
+DWORD WINAPI W906IoThreadMain_(void*)
+{
+    for (;;) {
+        W906IoServe_(true);
+        if (g_w906IoStop) break;
+        if (TPci1203Monitor* m = Pci1203Monitor()) {
+            try { m->Poll(); } catch (...) {}          // Poll never throws; a vendor surprise must not end the thread
+        }
+        ::InterlockedIncrement(&g_w906IoHeart);
+        W906IoServe_(true);
+        if (g_w906IoStop) break;
+        ::WaitForSingleObject(g_w906IoWake, (DWORD)g_w906IoGapMs);
+    }
+    W906IoServe_(true);                                // nobody is left waiting on a request
+    return 0;
+}
+}  // namespace
+
+bool Pci1203OnIoThread()
+{
+    return Pci1203IoThreadRunning() && ::GetCurrentThreadId() == g_w906IoTid;
+}
+
+unsigned long Pci1203IoThreadHeartbeat() { return (unsigned long)g_w906IoHeart; }
+
+void W906IoStage_(Pci1203IoSnap*& staged, Pci1203IoSnap*& pub, const Pci1203CardSample& c, const std::vector<Pci1203AxisSample>& a,
+                  const std::vector<Pci1203DiSample>& di, const std::vector<Pci1203DoSample>& dq, const std::vector<Pci1203SlaveSample>& sl,
+                  bool opened, bool disabled, const std::string& why)
+{
+    if (!g_w906IoCsInit) return;
+    ::EnterCriticalSection(&g_w906IoScs);
+    if (staged == 0) { staged = new Pci1203IoSnap(); pub = new Pci1203IoSnap(); }   // the first IO-thread poll; owned by the monitor's Impl for the process
+    staged->cardS = c;  staged->axes = a;  staged->dis = di;  staged->dos = dq;  staged->slaves = sl;
+    staged->opened = opened;  staged->disabled = disabled;  staged->disabledWhy = why;
+    ++g_w906IoStagedSeq;
+    g_w906IoStagedP = staged;
+    g_w906IoPubP = pub;
+    ::LeaveCriticalSection(&g_w906IoScs);
+}
+
+void W906IoPatchDo_(Pci1203IoSnap* pub, Pci1203IoSnap* staged, std::size_t port, const Pci1203DoSample& s)
+{
+    if (!g_w906IoCsInit || !Pci1203OnIoThread() || g_w906IoServingMain == 0) return;
+    ::EnterCriticalSection(&g_w906IoScs);
+    if (pub != 0 && port < pub->dos.size()) pub->dos[port] = s;          // the main thread is blocked in RunSync: nobody reads it now
+    if (staged != 0 && port < staged->dos.size()) staged->dos[port] = s; // so an adopt before the next stage keeps it
+    ::LeaveCriticalSection(&g_w906IoScs);
+}
+
+void W906IoServe_(bool boundary)
+{
+    if (!g_w906IoCsInit) return;
+    for (;;) {
+        W906IoReq* r = 0;
+        ::EnterCriticalSection(&g_w906IoQcs);
+        for (std::size_t i = 0; i < g_w906IoQ.size(); ++i) {
+            if (boundary || !g_w906IoQ[i]->boundaryOnly) { r = g_w906IoQ[i]; g_w906IoQ.erase(g_w906IoQ.begin() + (std::ptrdiff_t)i); break; }
+        }
+        ::LeaveCriticalSection(&g_w906IoQcs);
+        if (r == 0) return;
+        ::InterlockedExchange(&g_w906IoServingMain, 1);
+        try { r->fn(r->arg); } catch (...) {}
+        ::InterlockedExchange(&g_w906IoServingMain, 0);
+        ::SetEvent(r->done);
+    }
+}
+
+void Pci1203IoThreadRunSync(void (*fn)(void*), void* arg, bool boundaryOnly)
+{
+    if (fn == 0) return;
+    if (!Pci1203IoThreadRunning() || Pci1203OnIoThread() || !g_w906IoCsInit || g_w906IoThread == 0) { fn(arg); return; }
+    W906IoReq r;
+    r.fn = fn;  r.arg = arg;  r.boundaryOnly = boundaryOnly;
+    r.done = ::CreateEventA(NULL, TRUE, FALSE, NULL);
+    if (r.done == 0) { std::printf("[IOTHREAD] CreateEvent failed -- request run on the IO thread by polling\n"); }
+    ::EnterCriticalSection(&g_w906IoQcs);
+    g_w906IoQ.push_back(&r);
+    ::LeaveCriticalSection(&g_w906IoQcs);
+    ::SetEvent(g_w906IoWake);
+    for (;;) {
+        if (r.done != 0) {
+            HANDLE hs[2] = { r.done, g_w906IoThread };
+            const DWORD w = ::WaitForMultipleObjects(2, hs, FALSE, INFINITE);
+            if (w == WAIT_OBJECT_0) break;
+        } else {
+            bool queued = false;
+            ::EnterCriticalSection(&g_w906IoQcs);
+            for (std::size_t i = 0; i < g_w906IoQ.size(); ++i) if (g_w906IoQ[i] == &r) { queued = true; break; }
+            ::LeaveCriticalSection(&g_w906IoQcs);
+            if (!queued && g_w906IoServingMain == 0) break;
+            if (::WaitForSingleObject(g_w906IoThread, 1) != WAIT_OBJECT_0) continue;
+        }
+        //  The IO thread ended. If it never took the request, run it here: the card has one caller again.
+        bool mine = false;
+        ::EnterCriticalSection(&g_w906IoQcs);
+        for (std::size_t i = 0; i < g_w906IoQ.size(); ++i) if (g_w906IoQ[i] == &r) { g_w906IoQ.erase(g_w906IoQ.begin() + (std::ptrdiff_t)i); mine = true; break; }
+        ::LeaveCriticalSection(&g_w906IoQcs);
+        if (mine) fn(arg);
+        break;                                         // otherwise it was served before the thread returned (the drain on exit)
+    }
+    if (r.done != 0) ::CloseHandle(r.done);
+}
+
+bool Pci1203IoThreadAdopt()
+{
+    if (!Pci1203IoThreadRunning() || !g_w906IoCsInit || Pci1203OnIoThread()) return false;
+    bool fresh = false;
+    ::EnterCriticalSection(&g_w906IoScs);
+    if (g_w906IoStagedP != 0 && g_w906IoPubP != 0 && g_w906IoStagedSeq != g_w906IoPubSeq) {
+        *g_w906IoPubP = *g_w906IoStagedP;               // copy-assign: same vectors, element references stay put
+        g_w906IoPubSeq = g_w906IoStagedSeq;
+        fresh = true;
+    }
+    ::LeaveCriticalSection(&g_w906IoScs);
+    return fresh;
+}
+
+bool Pci1203IoThreadSnapshotReady()
+{
+    if (!Pci1203IoThreadRunning() || !g_w906IoCsInit) return false;
+    ::EnterCriticalSection(&g_w906IoScs);
+    const bool r = g_w906IoStagedP != 0 && g_w906IoStagedSeq != g_w906IoPubSeq;
+    ::LeaveCriticalSection(&g_w906IoScs);
+    return r;
+}
+
+bool Pci1203IoThreadStart(unsigned long gapMs, char* why, int whyLen)
+{
+    struct Say_ { char* w; int n; void operator()(const char* s) const { if (w != 0 && n > 0) std::snprintf(w, (std::size_t)n, "%s", s); } } say = { why, whyLen };
+    TPci1203Monitor* m = Pci1203Monitor();
+    if (m == 0 || !m->Open_() || m->Disabled()) { say("the 1203 monitor is not open -- the IO stays on the main thread"); return false; }
+    if (Pci1203IoThreadRunning()) { say("already running"); return true; }
+    W906IoCsInit_();
+    g_w906IoGapMs = gapMs;
+    ::InterlockedExchange(&g_w906IoStop, 0);
+    if (g_w906IoWake == 0) g_w906IoWake = ::CreateEventA(NULL, FALSE, FALSE, NULL);
+    if (g_w906IoWake == 0) { say("CreateEvent failed -- the IO stays on the main thread"); return false; }
+    ::InterlockedExchange(&Pci1203IoState().passMark, (long)m->card().pollCount);
+    DWORD tid = 0;
+    g_w906IoThread = ::CreateThread(NULL, 0, &W906IoThreadMain_, NULL, CREATE_SUSPENDED, &tid);
+    if (g_w906IoThread == 0) { say("CreateThread failed -- the IO stays on the main thread"); return false; }
+    g_w906IoTid = tid;                                 // before it runs: its first Poll must know it is the IO thread
+    ::InterlockedExchange(&Pci1203IoState().running, 1);
+    ::ResumeThread(g_w906IoThread);
+    //  Wait for its first completed poll and adopt it; only then do the main thread's readers switch to the published copy.
+    //  The main thread does nothing else meanwhile, so nobody reads the monitor while the IO thread writes it.
+    for (int i = 0; i < 300; ++i) {
+        ::EnterCriticalSection(&g_w906IoScs);
+        const bool have = g_w906IoStagedP != 0;
+        ::LeaveCriticalSection(&g_w906IoScs);
+        if (have) break;
+        ::Sleep(50);
+    }
+    if (!Pci1203IoThreadAdopt()) {
+        Pci1203IoThreadStop(5000);
+        say("the IO thread published no poll within 15 s -- stopped, the IO stays on the main thread");
+        return false;
+    }
+    ::InterlockedExchange(&g_w906IoPubReady, 1);
+    char b[160];
+    std::snprintf(b, sizeof(b), "started (thread %lu, %lu ms between polls)", (unsigned long)tid, gapMs);
+    say(b);
+    return true;
+}
+
+void Pci1203IoThreadStop(unsigned long waitMs)
+{
+    if (g_w906IoThread == 0) return;
+    ::InterlockedExchange(&g_w906IoStop, 1);
+    ::SetEvent(g_w906IoWake);
+    if (::WaitForSingleObject(g_w906IoThread, (DWORD)waitMs) != WAIT_OBJECT_0) {
+        std::printf("[IOTHREAD] stop: the IO thread did not end within %lu ms -- left as it is (the process exit ends it)\n", waitMs);
+        std::fflush(stdout);
+        return;
+    }
+    ::CloseHandle(g_w906IoThread);
+    g_w906IoThread = 0;
+    ::InterlockedExchange(&g_w906IoPubReady, 0);       // readers go back to the monitor itself (the IO thread's last poll is there)
+    ::InterlockedExchange(&Pci1203IoState().running, 0);
+    g_w906IoTid = 0;
+}
 }  // namespace ht9045
