+// =============================================================================
+//  EtherCAT/Pci1203IoMark.h -- the PCI-1203 IO thread's shared state, as seen by every module.
+//
+//  AI(W906-IOTHREAD) 20261005: EastSun「你可以把掃描IO 辦到一個新的執行續嗎? 並且可以跟原本執行續 互通有無」-> design C
+//  「IO 執行緒獨佔 1203 卡，兩邊用輸入映像＋命令佇列交換資料」(D:\HT9045\_iothread_1005\PLAN_IOTHREAD.md):
+//    * the IO thread (EtherCAT/Pci1203Monitor.cpp, Pci1203IoThreadStart) is the ONLY thread that calls the vendor API while
+//      it runs: it polls, and it runs every command the main thread submits (TPci1203Control::Execute and the monitor's
+//      Vc8SdoReadI16 / SetTorqueFocusAxis are proxied to it, synchronously, served at Poll's yield points = within one
+//      vendor call);
+//    * the main thread reads the last COMPLETED poll from a published copy (TPci1203Monitor accessors), adopted at its own
+//      safe points (Pci1203IoThreadAdopt), so every reader keeps its field names and stays on the main thread.
+//  Not started = exactly the old single-thread behaviour: every function below passes through.
+//
+//  This header is self-contained ON PURPOSE (no TU to link): the state lives in a function-local static of an inline
+//  function, which C++ guarantees is ONE object across translation units. So WebMotorAccess.cpp, the routes and their
+//  ctests can include it without linking the monitor.
+// =============================================================================
+#ifndef PCI1203_IO_MARK_H
+#define PCI1203_IO_MARK_H
+
+namespace ht9045 {
+
+struct Pci1203IoShared {
+    volatile long running;    // 1 while the IO thread runs (InterlockedExchange)
+    volatile long passMark;   // IO side: inside a poll = its index (pollCount + 1), between polls = pollCount
+};
+
+inline Pci1203IoShared& Pci1203IoState()
+{
+    static Pci1203IoShared s = { 0, 0 };
+    return s;
+}
+
+inline bool Pci1203IoThreadRunning() { return Pci1203IoState().running != 0; }
+
+//  THE "WAIT FOR A NEWER SAMPLE" MARK. The tree's rule is "pending while pollCount <= mark" (Pci1203MotorRoute Pending,
+//  WebMotorAccess SampleStale, the Index Z1 route, the Q44 read-back). With the IO thread a poll can be IN PROGRESS when a
+//  command executes, and that poll's sample of the axis may be from before the command; the main thread's pollCount can
+//  also lag the IO thread's. So a mark taken by the main thread is raised to the IO thread's pass in progress: a sample is
+//  only counted as newer when it comes from a poll that STARTED after the mark. Call it AFTER the command was executed
+//  (Execute returns only then) or at the "from now on" moment. Not running = the value unchanged (old behaviour).
+inline unsigned long Pci1203IoFreshMark(unsigned long pc)
+{
+    if (!Pci1203IoThreadRunning()) return pc;
+    const unsigned long m = (unsigned long)Pci1203IoState().passMark;
+    return m > pc ? m : pc;
+}
+
+// --- IO thread control (EtherCAT/Pci1203Monitor.cpp) --------------------------------------------------------------------
+bool Pci1203IoThreadStart(unsigned long gapMs, char* why, int whyLen);   // after Pci1203MonitorEnable; false + why if not started
+void Pci1203IoThreadStop(unsigned long waitMs);                          // joins (bounded); the monitor is direct again
+bool Pci1203IoThreadAdopt();                                             // main: take the newest completed poll; true = new
+bool Pci1203IoThreadSnapshotReady();                                     // main: a newer completed poll is waiting
+bool Pci1203OnIoThread();
+//  Run fn(arg) on the IO thread and wait for it. Inline (fn called here) when the thread does not run or when already on
+//  it. boundaryOnly = only between two polls (Rescan / anything that reopens the card).
+void Pci1203IoThreadRunSync(void (*fn)(void*), void* arg, bool boundaryOnly);
+unsigned long Pci1203IoThreadHeartbeat();                                // passes completed by the thread (watchdog)
+
+}  // namespace ht9045
+
+#endif
