+        be.clockMs = 10000.0; be.cmdPos[3] = 0.0;
+        MotorAccessDispatch(wl, 1, be);
+        MotorAccessPollTick(be);
+        be.clockMs = 10300.0; be.cmdPos[3] = 400.0; MotorAccessPollTick(be);
