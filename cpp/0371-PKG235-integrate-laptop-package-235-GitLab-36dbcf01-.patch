+int W906_ReconcileHPLedger913(const char* szWho);                              //AI(W906-W188) 20261009 (NB2-1): Public/HTEditList.cpp EOF
+//------------------------------------------------------------------------------
+//AI(ht9045-inarm-flow) 20260827 (RogerYang) : HotPlate取料帳本對帳 - 只做減法(刪幽靈/去重複), 不重建
+//AI : 吸嘴綁定(哪支放的哪支取)保存在存活的那筆booking裡, 全程不重新推導slot -> 無資料丟失
+//AI : ASM取料走SearchPickPlateXItem_AutoSiteMap不消耗帳本, 結束後帳本會殘留指向空格的booking
+//AI : 回傳 修正筆數(>=0), -1=機構忙(旗標保留下個pass再試)
+//------------------------------------------------------------------------------
+int ReconcilePickFromHPList(const char* szWho)
+{
+
+    if(PickFromHPList==NULL)
+        return 0;
+
+    if(InArmSuck.HasIC()==true                   ||                             //AI : 手上有料 = 取放進行中
+       bPlaceToHotplate==true                    ||
+       bPickFromHotplate==true                   ||
+       iInArmPickFromHotPlateTask!=1             ||
+       iInArmTryPickFromHotPlateTask!=1          ||
+       bRunAutoSiteMapping==true                 ||                             //AI : ASM期間取料不經帳本
+       LastSet.iRunStartMode==rsmAutoSiteMap     )                              //AI : Site Mapping模式一律不對帳
+    {
+        return -1;
+    }
+
+    return W906_ReconcileHPLedger913(szWho);                                    //AI(W906-W188) 20261009 (NB2-1): golden :1508-1635 (Pass 1 / Pass 2 / save + log)
+}
