+//AI(W906-W188) 20261009 (NB2-1): W-188 #5 -- golden 913 Public/HTEditList.cpp:2939-2946 verbatim (RogerYang 20260822).
+uHPSuckTeam* uHPSuckGroup::RemoveSuckTeam(int iIndex)                           //AI(ht9045-staterecord-analysis) 20260822 (RogerYang) : 取出指標不刪物件
+{
+    if(this==NULL || iIndex<0 || iIndex>=HPSuckTeamList->Count)
+        return NULL;
+    uHPSuckTeam* HPTeam=(uHPSuckTeam*)HPSuckTeamList->Items[iIndex];
+    HPSuckTeamList->Delete(iIndex);                                             //TList::Delete只移除指標, 物件由呼叫端接手
+    return HPTeam;
+}
+//---------------------------------------------------------------------------
+//AI(W906-W188) 20261009 (NB2-1): W-188 #5 -- the ledger passes of golden 913 ainarm_SearchPickPlate.cpp ReconcilePickFromHPList, verbatim:
+//   locals :1489-1492, Pass 1 / Pass 2 / save + log :1508-1635.  The entry point (NULL check + busy gate, :1494-1506) stays
+//   in ainarm_SearchPickPlate.cpp, whose TU only sees the zero-data uPlateInfo facade; this TU has the real class.
+#include "Motor/mymotor.h"   //AI(W906-W188) 20261009 (NB2-1): MOT[] (MMPlate1 Tray.Data) for Pass 1
+#ifndef __FUNC__
+#define __FUNC__ __func__   //AI(W906-W188) 20261009 (NB2-1): BCB __FUNC__ (canary_support.h:45 spelling)
+#endif
+int W906_ReconcileHPLedger913(const char* szWho)
+{
+    static bool bSeen[2][50][50];                                               //AI : 只在MainProc執行, 用static避免5KB堆疊框
+    AnsiString Str;
+    int iPhantom=0, iDup=0, iDelTeam=0, iDelGroup=0;
+    int ip=0, ic=0, ir=0, ig=0, it=0, i=0, j=0;
+
+    for(ip=0; ip<2; ip++)
+        for(ic=0; ic<50; ic++)
+            for(ir=0; ir<50; ir++)
+                bSeen[ip][ic][ir]=false;
+
+    //---- Pass 1 : 正向掃(只改bSuck不動索引), 清掉「指到空格」與「重複登記」的slot ----
+    for(ig=0; ig<PickFromHPList->GetHPSuckGroupCount(); ig++)
+    {
+        uHPSuckGroup* HPGroup=PickFromHPList->ExtractSuckGroup(ig);
+        if(HPGroup==NULL)
+            continue;
+
+        for(it=0; it<HPGroup->GetTeamCount(); it++)
+        {
+            uHPSuckTeam* HPTeam=HPGroup->ExtractSuckTeam(it);
+            if(HPTeam==NULL)
+                continue;
+
+            for(i=0; i<MAX_ARM_Row; i++)
+            {
+                for(j=0; j<MAX_ARM_Col; j++)
+                {
+                    if(HPTeam->bSuck[i][j]==false)
+                        continue;
+
+                    ip=HPTeam->iP;
+                    ic=HPTeam->iPlateC[i][j];
+                    ir=HPTeam->iPlateR[i][j];
+
+                    if(ip<0 || ip>=2 || ic<0 || ic>=50 || ir<0 || ir>=50)       //AI : 座標本身壞掉
+                    {
+                        HPTeam->bSuck[i][j]  =false;
+                        HPTeam->iPlateC[i][j]=-1;
+                        HPTeam->iPlateR[i][j]=-1;
+                        HPTeam->iSite[i][j]  =-1;
+                        iPhantom++;
+                        continue;
+                    }
+
+                    if(MOT[MMPlate1+ip].Tray.Data[ic][ir]==NULL_IC)             //AI : 帳本有、加熱盤沒有 = 幽靈帳
+                    {
+                        Str.sprintf("Reconcile phantom : G%d T%d Suck%d%d P%d C%d R%d Site%d",
+                                    ig, it, i+1, j+1, ip, ic, ir, HPTeam->iSite[i][j]);
+                        MyDBIProcess("Exception", Str);
+                        HPTeam->bSuck[i][j]  =false;
+                        HPTeam->iPlateC[i][j]=-1;
+                        HPTeam->iPlateR[i][j]=-1;
+                        HPTeam->iSite[i][j]  =-1;
+                        iPhantom++;
+                        continue;
+                    }
+
+                    if(bSeen[ip][ic][ir]==true)                                 //AI : 同格被登記兩次以上, 只留最靠隊首那筆
+                    {
+                        Str.sprintf("Reconcile duplicate : G%d T%d Suck%d%d P%d C%d R%d Site%d",
+                                    ig, it, i+1, j+1, ip, ic, ir, HPTeam->iSite[i][j]);
+                        MyDBIProcess("Exception", Str);
+                        HPTeam->bSuck[i][j]  =false;
+                        HPTeam->iPlateC[i][j]=-1;
+                        HPTeam->iPlateR[i][j]=-1;
+                        HPTeam->iSite[i][j]  =-1;
+                        iDup++;
+                        continue;
+                    }
+
+                    bSeen[ip][ic][ir]=true;
+                }
+            }
+        }
+    }
+
+    //---- Pass 2 : 由下往上刪掉「全空的team」與「被清空的group」 ----
+    for(ig=PickFromHPList->GetHPSuckGroupCount()-1; ig>=0; ig--)
+    {
+        uHPSuckGroup* HPGroup=PickFromHPList->ExtractSuckGroup(ig);
+        if(HPGroup==NULL)
+            continue;
+
+        for(it=HPGroup->GetTeamCount()-1; it>=0; it--)
+        {
+            uHPSuckTeam* HPTeam=HPGroup->ExtractSuckTeam(it);
+            if(HPTeam==NULL)
+                continue;
+
+            bool bAnySuck=false;
+            for(i=0; i<MAX_ARM_Row && bAnySuck==false; i++)
+            {
+                for(j=0; j<MAX_ARM_Col; j++)
+                {
+                    if(HPTeam->bSuck[i][j]==true)
+                    {
+                        bAnySuck=true;
+                        break;
+                    }
+                }
+            }
+
+            if(bAnySuck==false)
+            {
+                uHPSuckTeam* HPDel=HPGroup->RemoveSuckTeam(it);                 //AI : TList::Delete只移除指標, 物件由呼叫端接手
+                if(HPDel!=NULL)
+                {
+                    delete HPDel;
+                    iDelTeam++;
+                }
+            }
+        }
+
+        if(HPGroup->GetTeamCount()==0)                                          //AI : 空group留著會讓DataForwardAndNextTeam空轉(同20260823c)
+        {
+            PickFromHPList->DelHPSuckGroup(ig);
+            delete HPGroup;
+            iDelGroup++;
+        }
+    }
+
+    if(PickFromHPList->GetHPSuckGroupCount()==0)                                //AI : 補一個開放group給ExtractLastGroup/SetArrPlateXY寫入
+        PickFromHPList->AddHPSuckGroup();
+
+    if(iPhantom>0 || iDup>0 || iDelTeam>0 || iDelGroup>0)
+    {
+        PickFromHPList->SaveFile(sHPPickRec);                                   //AI : 一定要落地, 否則重開機又讀回爛帳
+        Str.sprintf("ReconcilePickFromHPList by %s : phantom=%d dup=%d delTeam=%d delGroup=%d groupLeft=%d",
+                    szWho, iPhantom, iDup, iDelTeam, iDelGroup, PickFromHPList->GetHPSuckGroupCount());
+        RecordProcess(Str, __FUNC__);
+    }
+
+    return iPhantom+iDup;
+}
