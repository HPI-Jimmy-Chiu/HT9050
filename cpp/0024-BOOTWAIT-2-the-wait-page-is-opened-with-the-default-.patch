From 4bbcec85ec7bfa538d69c4827eac63d2285a89a5 Mon Sep 17 00:00:00 2001
From: "HT9045 Machine (V906)" <Claude_RDBC_02@honprec.com>
Date: Tue, 29 Sep 2026 18:46:32 +0800
Subject: [PATCH] BOOTWAIT-2: the wait page is opened with the default http
 browser's exe (the .html association starts no browser here)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

EastSun 20260929 after the first BOOTWAIT: "你一樣是當 橘色這行 出現時 好幾分鐘都沒反應" -- wb_serve was up (18:38:22 start,
listening on 8055) but no browser had opened: measured, Start-Process <file>.html and explorer.exe <file>.html start no browser on
this machine (.html UserChoice = ChromeHTML, yet no chrome.exe ever appeared), while chrome.exe <file URL> works.
- tools/open_boot_wait.ps1: resolves HKCU ...\UrlAssociations\http\UserChoice ProgId -> HKCR\<ProgId>\shell\open\command -> exe
  (Chrome here), falls back to Chrome / Edge, starts it with file:///.../web/boot_wait.html; -DryRun only prints.
- .vscode/tasks.json "IOWEB(這台): 開啟等待畫面" runs that script.
Dry run on this machine: chrome.exe via ChromeHTML. JSONC re-checked.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 .vscode/tasks.json       |  2 +-
 tools/open_boot_wait.ps1 | 29 +++++++++++++++++++++++++++++
 2 files changed, 30 insertions(+), 1 deletion(-)
 create mode 100644 tools/open_boot_wait.ps1

diff --git a/.vscode/tasks.json b/.vscode/tasks.json
index 9f77437..ad85f8c 100644
--- a/.vscode/tasks.json
+++ b/.vscode/tasks.json
@@ -115,7 +115,7 @@
       "detail": "opens ../web/boot_wait.html in the default browser (it switches to the HMI when wb_serve answers on 8055)",
       "type": "process",
       "command": "powershell",
-      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", "Start-Process -FilePath (Join-Path '${workspaceFolder}' '..\\web\\boot_wait.html')"],
+      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\tools\\open_boot_wait.ps1"],   // AI(W906-BOOTWAIT) 20260929: was Start-Process <file>.html -- on this machine the .html association starts NO browser (measured), so nothing opened; the script starts the default http browser's exe (Chrome here) with the file URL
       "presentation": { "reveal": "silent", "panel": "shared" },
       "problemMatcher": []
     },
diff --git a/tools/open_boot_wait.ps1 b/tools/open_boot_wait.ps1
new file mode 100644
index 0000000..fde96b0
--- /dev/null
+++ b/tools/open_boot_wait.ps1
@@ -0,0 +1,29 @@
+# AI(W906-BOOTWAIT) 20260929: F5's first step (.vscode/tasks.json "IOWEB(這台): 開啟等待畫面") -- open ../web/boot_wait.html in the
+#   DEFAULT HTTP BROWSER'S EXE. Measured on this machine: Start-Process <file>.html and explorer.exe <file>.html (the .html file
+#   association) start NO browser at all, so the first version of the task opened nothing and EastSun waited minutes with no screen
+#   ("你一樣是當 橘色這行 出現時 好幾分鐘都沒反應"); starting chrome.exe with the file URL works.
+#   Resolution: HKCU ...\UrlAssociations\http\UserChoice ProgId -> HKCR\<ProgId>\shell\open\command -> the exe; else Chrome / Edge.
+#   -DryRun prints what it would start and starts nothing.
+param([string]$Page = '', [switch]$DryRun)
+if (-not $Page) { $Page = Join-Path $PSScriptRoot '..\..\web\boot_wait.html' }
+$full = (Resolve-Path -LiteralPath $Page -ErrorAction SilentlyContinue)
+if (-not $full) { Write-Output "boot_wait.html not found: $Page"; exit 1 }
+$url = 'file:///' + ($full.Path -replace '\\', '/')
+$exe = $null; $how = ''
+try {
+    $prog = (Get-ItemProperty -Path 'HKCU:\Software\Microsoft\Windows\Shell\Associations\UrlAssociations\http\UserChoice' -ErrorAction Stop).ProgId
+    $cmd = (Get-ItemProperty -Path "Registry::HKEY_CLASSES_ROOT\$prog\shell\open\command" -ErrorAction Stop).'(default)'
+    if ($cmd -match '^\s*"([^"]+?\.exe)"') { $exe = $matches[1] } elseif ($cmd -match '^\s*(\S+?\.exe)') { $exe = $matches[1] }
+    $how = "default http browser ($prog)"
+} catch {}
+if (-not $exe -or -not (Test-Path -LiteralPath $exe)) {
+    $exe = $null
+    foreach ($c in @((Join-Path $env:ProgramFiles 'Google\Chrome\Application\chrome.exe'),
+                     (Join-Path ${env:ProgramFiles(x86)} 'Microsoft\Edge\Application\msedge.exe'),
+                     (Join-Path $env:ProgramFiles 'Microsoft\Edge\Application\msedge.exe'))) {
+        if (Test-Path -LiteralPath $c) { $exe = $c; $how = 'fallback'; break }
+    }
+}
+if (-not $exe) { Write-Output "no browser found; open by hand: $url"; exit 1 }
+Write-Output "open $url with $exe [$how]"
+if (-not $DryRun) { Start-Process -FilePath $exe -ArgumentList $url }
-- 
