     bool        gearReadDue;
     bool        gearReadForce;  std::vector<unsigned> cfgDue; std::vector<unsigned> cfgFailed; std::vector<int> cfgTries; std::vector<Pci1203CfgExpect> cfgExpect; std::vector<unsigned> cfgWritten; bool inPoll; bool cfgRetryDue; bool retryArmed; unsigned long retryTick; void (*yieldHook)(); bool inYield; unsigned long yieldMs;   //AI(W906-IOWEB-P25) 20260925: per-axis configuration groups still to read (cfgDue, armed by OpenAxes_ = open / rescan / re-attach, and by a write), groups whose last read failed (cfgFailed, retried on the 30 s window at most 3 times), written values awaiting agreement (cfgExpect), and the output-first yield hook. Same line, no line below moves
-    unsigned    maxAxes;  struct Pci1203IoSnap* ioPub = 0; struct Pci1203IoSnap* ioStaged = 0;   // maxAxes: remembered so a re-attach can redo them   //AI(W906-IOTHREAD) 20261005: the published copy the main thread reads (ioPub) and the one the IO thread fills at the end of every poll (ioStaged); 0 until the IO thread's first poll. Same line, no line below moves
+    unsigned    maxAxes;  struct Pci1203IoSnap* ioPub = 0; struct Pci1203IoSnap* ioStaged = 0;  int cfgRetryAxis = -1; bool cfgRoundOn = false; std::size_t cfgRoundNext = 0; unsigned long cfgRoundTick = 0;   //AI(W906-CFGRETRY) 20261006: the failed-group retry round (EastSun 1006 「參數重試一定要一直重試 只是秒數可以拉長」→ 1 分鐘): which axis retries THIS Poll (-1 none), whether a round is open, the next axis to look at, when the last round opened; same line   // maxAxes: remembered so a re-attach can redo them   //AI(W906-IOTHREAD) 20261005: the published copy the main thread reads (ioPub) and the one the IO thread fills at the end of every poll (ioStaged); 0 until the IO thread's first poll. Same line, no line below moves
     unsigned    diPorts;
     unsigned    doPorts;              //AI(W906-1203MON-18) 20260910
     //AI(W906-1203COLD-2) 20260924: when the last ring sweep ran, so a zero scan
@@ -2228,7 +2228,7 @@ bool TPci1203Monitor::Poll()
         // Nothing was ever discovered: the ring state is unknown, not good.
         impl_->cardS.slaveValid = false;
     }  const double segStationsMs_ = segClock_.Lap();   //AI(W906-LAT-1) 20260925: end of the station-state segment, start of the axis segment
-    { const unsigned long nr = (unsigned long)::GetTickCount(); const bool due = !impl_->retryArmed || (nr - impl_->retryTick) >= 30000ul; if (due) { impl_->retryArmed = true; impl_->retryTick = nr; } impl_->alarmRetryDue = due; impl_->cfgRetryDue = due; }   //AI(W906-IOWEB-P25) 20260925: the 30 s retry window (failed 603Fh reads, failed configuration reads) is decided ONCE HERE, before the axis loop. It used to be decided inside the loop at axis index 0, so an unopened axis 0 skipped the decision; and `(long)(now - 0) >= 0` is false for an uptime of 24.8-49.7 days. Unsigned subtraction from an armed tick is wrap-correct. On the old blank line, so no line below moves
+    { const unsigned long nr = (unsigned long)::GetTickCount(); const bool due = !impl_->retryArmed || (nr - impl_->retryTick) >= 30000ul; if (due) { impl_->retryArmed = true; impl_->retryTick = nr; } impl_->alarmRetryDue = due; impl_->cfgRetryDue = due; }  { const unsigned long nr = (unsigned long)::GetTickCount(); impl_->cfgRetryAxis = -1; if (impl_->cfgRoundTick == 0) impl_->cfgRoundTick = nr | 1ul; else if (!impl_->cfgRoundOn && (nr - impl_->cfgRoundTick) >= 60000ul) { impl_->cfgRoundOn = true; impl_->cfgRoundNext = 0; impl_->cfgRoundTick = nr | 1ul; } if (impl_->cfgRoundOn) { std::size_t k = impl_->cfgRoundNext; while (k < impl_->cfgFailed.size() && impl_->cfgFailed[k] == 0u) ++k; if (k < impl_->cfgFailed.size()) { impl_->cfgRetryAxis = (int)k; impl_->cfgRoundNext = k + 1; } else impl_->cfgRoundOn = false; } }   //AI(W906-CFGRETRY) 20261006: failed configuration groups are retried WITHOUT a try limit, one axis per Poll, in a round that opens every 60 s (was: every failed axis on the one 30 s Poll, at most 3 times -- measured 1.26 s per 30 s on ax14-18 / stations 35-40, DI not read meanwhile). The 30 s window above still drives the 603Fh and torque retries. Same line   //AI(W906-IOWEB-P25) 20260925: the 30 s retry window (failed 603Fh reads, failed configuration reads) is decided ONCE HERE, before the axis loop. It used to be decided inside the loop at axis index 0, so an unopened axis 0 skipped the decision; and `(long)(now - 0) >= 0` is false for an uptime of 24.8-49.7 days. Unsigned subtraction from an armed tick is wrap-correct. On the old blank line, so no line below moves
     // --- axes --------------------------------------------------------------
     for (std::size_t i = 0; i < impl_->axHandles.size(); ++i) {
         Pci1203AxisSample& s = impl_->axes[i];
@@ -2442,7 +2442,7 @@ bool TPci1203Monitor::Poll()
         //  re-attach (OpenAxes_ arms cfgDue), after a write (ExpectCfg_ / MarkCfgDue_), and a FAILED group on
         //  the 30 s window at most 3 times. This overrides CTL-47 / GEAR-1 and 20260923 ruling #2's "as shipped".
         unsigned cfgWant = (i < impl_->cfgDue.size()) ? impl_->cfgDue[i] : 0u;
-        if (impl_->cfgRetryDue && i < impl_->cfgFailed.size()) { for (unsigned g = 0; g < 5u; ++g) if ((impl_->cfgFailed[i] & (1u << g)) != 0u && impl_->cfgTries[i * 5u + g] < 3) cfgWant |= (1u << g); }   //AI(W906-IOWEB-P25b) 20260925: retry budget PER GROUP (was per axis: one group that always fails used up every group's retries)
+        const unsigned cfgDueNow = cfgWant;  if ((int)i == impl_->cfgRetryAxis && i < impl_->cfgFailed.size()) { for (unsigned g = 0; g < 5u; ++g) if ((impl_->cfgFailed[i] & (1u << g)) != 0u) cfgWant |= (1u << g); }   //AI(W906-IOWEB-P25b) 20260925: retry budget PER GROUP (was per axis: one group that always fails used up every group's retries)   //AI(W906-CFGRETRY) 20261006: no try limit any more (was `&& cfgTries < 3`, on cfgRetryDue for every axis); only the round's axis (cfgRetryAxis); cfgDueNow = the groups due for a real reason (open / rescan / write), which are read in full
         if (s.station < 0) cfgWant &= (unsigned)(kCfgSpeed | kCfgLimit | kCfgHome);   // the drive groups are station-keyed SDO reads
         unsigned cfgBad = 0u;                                                        // groups with a failed read this pass
         const bool doSpeedRead = (cfgWant & (unsigned)(kCfgSpeed | kCfgLimit | kCfgHome)) != 0;
@@ -2579,7 +2579,7 @@ bool TPci1203Monitor::Poll()
                                                       Pci1203GearSub(q),
                                                       6 /*ECAT_TYPE_U32*/, 4, &v);
                     if (rr == SUCCESS) s.gearVal[q] = (unsigned long)v;
-                    s.gearValid[q] = (rr == SUCCESS);  if (rr != SUCCESS) cfgBad |= kCfgGear;  Yield_();
+                    s.gearValid[q] = (rr == SUCCESS);  if (rr != SUCCESS) cfgBad |= kCfgGear;  Yield_();  if (rr != SUCCESS && (cfgDueNow & (unsigned)kCfgGear) == 0u) break;   //AI(W906-CFGRETRY) 20261006: a pure retry stops at the group's first failure (the group stays failed; the next round asks again)
                 }
                 if (cfgWant & kCfgGear) calls += Pci1203AxisSample::kGearReadCount;
 
@@ -2596,7 +2596,7 @@ bool TPci1203Monitor::Poll()
                                                 (U16)(0x221D + base), 0,
                                                 4 /*ECAT_TYPE_U16*/, 2, &v16);
                     s.encValid[0] = (rr == SUCCESS);  if (rr != SUCCESS) cfgBad |= kCfgDrive;
-                    if (rr == SUCCESS) s.encVal[0] = (unsigned long)v16;  Yield_();
+                    if (rr == SUCCESS) s.encVal[0] = (unsigned long)v16;  Yield_();  if (rr != SUCCESS && (cfgDueNow & (unsigned)kCfgDrive) == 0u) goto W906_cfgDriveSkip_;   //AI(W906-CFGRETRY) 20261006: a pure retry whose first drive-group read (Pn21D) fails skips the rest of the group (~25 mailbox reads, ~8.7 ms each when they fail)
 
                     v16 = 0;
                     rr = Acm_DevReadSDOData(impl_->dev, 0, st,
@@ -2708,7 +2708,7 @@ bool TPci1203Monitor::Poll()
                         if (mr == SUCCESS) s.driveHomeMethod = (long)method;
                         ++calls;  Yield_();
                     }
-                }
+                }  W906_cfgDriveSkip_: ;   //AI(W906-CFGRETRY) 20261006: the pure-retry skip lands here (same line)
             }
         }
 
