+std::string PadSnapshot_(const std::string& op, size_t memo0, const std::string& note)
+{
+    TfPadInterface* p=fPadInterface;
+    cJSON* o=cJSON_CreateObject();
+    cJSON_AddStringToObject(o, "op", op.c_str());
+    cJSON_AddNumberToObject(o, "mode", (double)iControlPanelMode);
+    cJSON_AddBoolToObject(o, "rs232Ok", p->bRs232Ok ? 1 : 0);
+    cJSON_AddStringToObject(o, "com", HSys.TrayStepMotor_ComPort.c_str());
+    cJSON_AddBoolToObject(o, "show", p->bShow ? 1 : 0);   // direct on purpose (FShow_Audit baseline +3, W-155 MR B): bShow is golden TfPadInterface's own FormShow / FormClose flag, set and cleared here by pad.open / pad.close; W906_FormShowing would OR in the web window state, which the W155-D3 watchdog must not trust
+    cJSON_AddBoolToObject(o, "bling", p->bPadLedBling ? 1 : 0);
+    cJSON_AddBoolToObject(o, "requestVer", p->bRequestVer ? 1 : 0);
+    cJSON_AddBoolToObject(o, "sendLampOnly", kPadSendLampOnly ? 1 : 0);
+    cJSON_AddNumberToObject(o, "showTimeoutMs", (double)kPadShowTimeoutMs);
+    cJSON_AddNumberToObject(o, "watchdogCloses", (double)g_padWatchdogCloses);
+    cJSON_AddNumberToObject(o, "droppedT07T08", (double)W906_PadDroppedT07T08());
+    cJSON* items=cJSON_CreateArray();
+    for(int i=0; i<p->CheckPadItem && i<31; i++)
+    {
+        cJSON* it=cJSON_CreateObject();
+        cJSON_AddNumberToObject(it, "i", i);
+        cJSON_AddStringToObject(it, "sb", kPadSb[i]);
+        cJSON_AddStringToObject(it, "ml", (std::string("ml_") + (kPadSb[i] + 3)).c_str());
+        cJSON_AddStringToObject(it, "pad", p->PadItem[i].PadName.c_str());
+        cJSON_AddStringToObject(it, "key", p->PadItem[i].InputName.c_str());
+        cJSON_AddNumberToObject(it, "tag", p->PadItem[i].btnEvent->Tag);
+        cJSON_AddBoolToObject(it, "down", p->PadItem[i].btnEvent->Down ? 1 : 0);
+        cJSON_AddBoolToObject(it, "led", p->PadItem[i].mlEvent->Value ? 1 : 0);
+        cJSON_AddBoolToObject(it, "lamp", p->bPadStatus[i] ? 1 : 0);
+        cJSON_AddItemToArray(items, it);
+    }
+    cJSON_AddItemToObject(o, "items", items);
+    const size_t n=p->MemoLines.size();
+    cJSON* memo=cJSON_CreateArray();
+    for(size_t i=(n>kPadMemoTail ? n-kPadMemoTail : 0); i<n; i++)
+        cJSON_AddItemToArray(memo, cJSON_CreateString(PadLine_(p->MemoLines[i]).c_str()));
+    cJSON_AddItemToObject(o, "memo", memo);
+    cJSON_AddNumberToObject(o, "memoCount", (double)n);
+    if(memo0!=(size_t)-1)
+    {
+        cJSON* fr=cJSON_CreateArray();
+        for(size_t i=(memo0<=n ? memo0 : 0); i<n; i++)                         // RecordCommunication rolls at 1000 lines
+            cJSON_AddItemToArray(fr, cJSON_CreateString(PadLine_(p->MemoLines[i]).c_str()));
+        cJSON_AddItemToObject(o, "frames", fr);
+    }
+    if(!note.empty())
+        cJSON_AddStringToObject(o, "note", note.c_str());
+    char* t=cJSON_PrintUnformatted(o);
+    std::string out=t ? t : "{\"error\":\"cJSON print failed\"}";
+    if(t) cJSON_free(t);
+    cJSON_Delete(o);
+    return out;
+}
+bool PadRefuse_(const std::string& op, const std::string& why, std::string& ack)
+{
+    std::printf("pad.%s REFUSED -- %s\n", op.c_str(), why.c_str());
+    ack=why;
+    return false;
+}
+}  // namespace
