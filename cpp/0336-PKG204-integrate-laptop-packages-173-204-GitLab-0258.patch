+    check(read("D:/HT9045/system/Gerneral.ini")==realGeneral && read("D:/HT9045/config/config.ini")==realConfig,
+          "T10 real Gerneral.ini and config.ini contents unchanged");
+    std::printf("POOL2_LotInfo2: %d failure(s)\n", failures);
+    return failures ? 1 : 0;
+}
