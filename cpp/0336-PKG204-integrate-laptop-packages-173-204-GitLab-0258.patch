+    W906_DestroyLogObjects();
+    Check(W906_TriTempDoorLogObj() == nullptr && W906_DewPointLogObj(0) == nullptr && W906_LotInfoLogObj() != nullptr,   // golden never deletes slLotInfolog (LogObjects.cpp destroy note)
