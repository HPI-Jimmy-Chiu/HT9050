+    j.Key("alias").String(alias);
+    j.Key("down").Number((wb_int64)desiredDown);
+    j.Key("raw").Number((wb_int64)(pb.Down ? 1 : 0));
+    j.Key("guardsBypassed").BeginArray();
+    for (std::size_t bi = 0; bi < bypassed.size(); ++bi) j.String(bypassed[bi]);
+    j.EndArray();
+    j.Key("pad").Bool(true);
+    j.Key("padStatus").Bool(padStatus);
+    j.Key("rs232Ok").Bool(p->bRs232Ok);
+    j.Key("frames").BeginArray();
