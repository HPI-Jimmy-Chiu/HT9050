+// tools/wb_serve.cpp, on the tick thread under FormLock.  false + `ack` = a plain-text refusal (nothing was sent).
+bool W906_PadWire(const std::string& cmd, const std::string& value, std::string& ack)
+{
+    const std::string op=cmd.compare(0, 4, "pad.")==0 ? cmd.substr(4) : cmd;
+    cJSON* root=value.empty() ? 0 : cJSON_Parse(value.c_str());
+    if(!value.empty() && !root) return PadRefuse_(op, "value 不是 JSON", ack);
+    struct Del_ { cJSON* r; ~Del_() { if(r) cJSON_Delete(r); } } del={ root };
+    TfPadInterface* p=fPadInterface;
+    const size_t m0=p->MemoLines.size();
+
+    if(op=="get")
+    {
+        if(p->bShow && PadBeat_(root)) g_padLastBeatMs=PadNowMs_();            // W155-D3 heartbeat (beat:true only); direct on purpose (FShow_Audit baseline +3, W-155 MR B): bShow is golden TfPadInterface's own FormShow / FormClose flag, set and cleared here by pad.open / pad.close; W906_FormShowing would OR in the web window state, which the W155-D3 watchdog must not trust
+        ack=PadSnapshot_(op, (size_t)-1, "");
+        return true;
+    }
+    if(op=="close")                                                             // golden FormClose :940-944
+    {
+        p->bShow=false;
+        ack=PadSnapshot_(op, (size_t)-1, "golden FormClose：bShow=false");
+        return true;
+    }
+    if(op!="open" && op!="exit" && op!="button" && op!="send" && op!="bling")
+        return PadRefuse_(op, "不認得的 pad 指令（open / get / close / exit / button / send / bling）", ack);
+    if(iControlPanelMode!=1)
+        return PadRefuse_(op, "ControlPanelMode 不是 1（沒有通訊面板）——golden 這時 IO 頁不顯示 Pad 鈕（iosetview.cpp:1012），這個視窗打不開", ack);
+
+    if(op=="open")
+    {
+        PadFormShow_();
+        g_padLastBeatMs=PadNowMs_();
+        std::printf("pad.open -- golden FormShow (6 init lamp frames, bShow=true), pad RS-232 %s\n", p->bRs232Ok ? "open" : "NOT open");
+        ack=PadSnapshot_(op, m0, "golden FormShow：送 6 個初始化燈號封包、所有按鈕 Down=false、bShow=true");
+        return true;
+    }
+    if(op=="exit")
+    {
+        PadExitClick_();
+        ack=PadSnapshot_(op, m0, "golden sb_PadInterface_ExitClick：bShow=false、所有 bPadStatus=false，關視窗");
+        return true;
+    }
+    if(op=="button")
+    {
+        const std::string name=PadStr_(root, "name");
+        const int i=PadIndexOfSb_(name);
+        if(i<0 || i>=p->CheckPadItem)
+            return PadRefuse_(op, "name 不是面板按鈕（sb_PadInterface_Front*／Rear*）：「" + name + "」——不送", ack);
+        PAD_BTN_W906* b=p->PadItem[i].btnEvent;
+        b->Down=!b->Down;                                                       // golden :955-961 FrontPowerOffMouseDown
+        PadButtonClick_(b);                                                     // golden OnClick :86-150
+        std::printf("pad.button %s -> Down=%d, %s lamp frame\n", name.c_str(), b->Down ? 1 : 0, b->Tag==1 ? "rear (t052 + t051)" : "front");
+        ack=PadSnapshot_(op, m0, "");
+        return true;
+    }
+    if(op=="send")
+    {
+        const std::string text=PadStr_(root, "text");
+        if(kPadSendLampOnly && !PadIsLampFrame_(text))
+            return PadRefuse_(op, "手動送只收燈號封包 t05{0|1|2}49{0|1}XXXXXX（13 個字，X＝0-9 A-F；RULINGS_20261007 #10）：「" + text + "」——不送", ack);
+        p->SendCommand(AnsiString(text.c_str()));                               // golden :385-389
+        ack=PadSnapshot_(op, m0, "");
+        return true;
+    }
+    // bling
+    cJSON* on=cJSON_GetObjectItem(root, "on");
+    if(!on || !cJSON_IsBool(on))
+        return PadRefuse_(op, "on 要是 true / false", ack);
+    p->bPadLedBling=cJSON_IsTrue(on) ? true : false;                            // cb_PadInterface_PadLedBling->Checked
+    ack=PadSnapshot_(op, m0, "");
+    return true;
+}
+
+// W155-D3: called by W906_PadThreadTick (the pad job, ControlPanelMode 1) every pass.
+void W906_PadShowWatchdog_St02()
+{
+    TfPadInterface* p=fPadInterface;
+    if(kPadShowTimeoutMs==0 || !p->bShow)   // direct on purpose (FShow_Audit baseline +3, W-155 MR B): bShow is golden TfPadInterface's own FormShow / FormClose flag, set and cleared here by pad.open / pad.close; W906_FormShowing would OR in the web window state, which the W155-D3 watchdog must not trust
+        return;
+    if(PadNowMs_()-g_padLastBeatMs<kPadShowTimeoutMs)
+        return;
+    p->bShow=false;                                                             // golden FormClose :940-944
+    g_padWatchdogCloses++;
+    std::printf("pad window: no pad.get for %lu ms -- golden FormClose (bShow=false), DEVIATION W155-D3\n", kPadShowTimeoutMs);
+}
+void W906_PadShowAgeForTest(unsigned long ms)                                   // ctest only: the heartbeat is `ms` older
+{
+    g_padLastBeatMs-=ms;
+}
