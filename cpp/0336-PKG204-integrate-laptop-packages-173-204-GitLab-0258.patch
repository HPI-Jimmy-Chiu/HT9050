+                       ReadAll(src + "/cpublic.cpp", &cp) && ReadAll(src + "/JsonBridge/actions/MainClarnData.cpp", &mcd) &&
+                       ReadAll(src + "/TTLLog.cpp", &ttl) && ReadAll(src + "/IndexPosLog.cpp", &ipl) && ReadAll(src + "/CMakeLists.txt", &cm);
