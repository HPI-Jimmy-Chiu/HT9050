+    }
+
+    // ---------------------------------------------------------------- [6]
+    std::printf("[6] source pins\n");
+    {
+        std::string tri, lot;
+        const bool r = ReadAll(src + "/TempCtrl/TriTemp.cpp", &tri) && ReadAll(src + "/forms/fLotInfo.cpp", &lot);
