+bool PadIsLampFrame_(const std::string& s)                                     // t05{0|1|2}49{0|1}XXXXXX
+{
+    if(s.size()!=13 || s.compare(0, 3, "t05")!=0) return false;
+    if(s[3]<'0' || s[3]>'2' || s[4]!='4' || s[5]!='9' || (s[6]!='0' && s[6]!='1')) return false;
+    for(size_t i=7; i<13; i++)
+        if(!((s[i]>='0' && s[i]<='9') || (s[i]>='A' && s[i]<='F'))) return false;
+    return true;
+}
+bool PadBeat_(cJSON* root)                                                     // pad.get {"beat":true} = the opener's heartbeat (W155-D3)
+{
+    cJSON* v = root ? cJSON_GetObjectItem(root, "beat") : 0;
+    return v && cJSON_IsTrue(v);
+}
+std::string PadStr_(cJSON* root, const char* key)
+{
+    cJSON* v = root ? cJSON_GetObjectItem(root, key) : 0;
+    return (v && cJSON_IsString(v) && v->valuestring) ? std::string(v->valuestring) : std::string();
+}
+std::string PadLine_(const AnsiString& a)                                      // a memo line without its CR / LF
+{
+    std::string s(a.c_str()), t;
+    for(size_t k=0; k<s.size(); k++) if(s[k]!='\r' && s[k]!='\n') t+=s[k];
+    return t;
+}
