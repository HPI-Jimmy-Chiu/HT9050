+// lines that contain `code` and do not start with a comment
+static int LiveLines(const std::string& src, const char* code)
+{
+    int n = 0;
+    std::string cur;
+    for (size_t i = 0; i <= src.size(); ++i) {
+        if (i == src.size() || src[i] == '\n') {
+            const size_t q = cur.find_first_not_of(" \t");
