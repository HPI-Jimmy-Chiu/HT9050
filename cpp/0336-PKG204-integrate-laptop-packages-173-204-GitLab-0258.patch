+}
+const els = {};
+NAMES.forEach((n) => { els['sb_PadInterface_' + n] = mkEl('sb_PadInterface_' + n, 'DIV', ['btnpanel']); els['ml_PadInterface_' + n] = mkEl('ml_PadInterface_' + n, 'SPAN', ['aled']); });
