+                  " (rest of golden InitialMotorParameter() not re-run -- gap; home every axis again)");
     AckHead(w, r, failed ? "partial" : "reloaded", "pci1203", std::string(b) + (firstFail.empty() ? "" : "; first failure " + firstFail));
     w.Key("axesZeroed").Number((wb_int64)done);
