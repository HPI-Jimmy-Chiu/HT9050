+    if (cancelled) v += ",\"cancelled\":true}";
+    else v += ",\"credentials\":{\"userId\":" + (user ? "\"" + std::string(user) + "\"" : std::string("null")) + ",\"password\":\"" + pw + "\"}}";
+    Reply r;
+    r.ok = W906_NoteAuthVerify("a-" + rid, v, current, blocking, &r.raw);
+    Out(r.raw);
+    cJSON* o = r.ok ? cJSON_Parse(r.raw.c_str()) : 0;
