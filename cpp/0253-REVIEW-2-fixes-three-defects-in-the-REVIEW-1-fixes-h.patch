diff --git a/EtherCAT/Pci1203Monitor.cpp b/EtherCAT/Pci1203Monitor.cpp
index d9fe4b6..dcf1ce2 100644
--- a/EtherCAT/Pci1203Monitor.cpp
+++ b/EtherCAT/Pci1203Monitor.cpp
@@ -4432,7 +4432,7 @@ DWORD WINAPI W906IoThreadMain_(void*)
         if (TPci1203Monitor* m = Pci1203Monitor()) {
             try { m->Poll(); } catch (...) {}          // Poll never throws; a vendor surprise must not end the thread
         }
-        ::InterlockedIncrement(&g_w906IoHeart);  g_w906IoHeartAt = ::GetTickCount() | 1u;   //AI(W906-IOFIX-2) 20261007: heartbeat time, same line
+        ::InterlockedIncrement(&g_w906IoHeart);  { const DWORD t = ::GetTickCount(); g_w906IoHeartAt = t ? t : 1u; }   //AI(W906-IOFIX-3) 20261007: heartbeat time; never later than "now" (IOFIX-2's |1u could be 1 ms ahead -> unsigned wrap), 0 stays "no heartbeat yet"
         W906IoServe_(true);
         if (g_w906IoStop) break;
         ::WaitForSingleObject(g_w906IoWake, (DWORD)g_w906IoGapMs);
@@ -4508,7 +4508,7 @@ void Pci1203IoThreadRunSync(void (*fn)(void*), void* arg, bool boundaryOnly)
         static unsigned long s_said = 0;
         if (s_said++ == 0) std::printf("[IOTHREAD] card request refused: the IO thread did not stop in time and still owns the card\n");
         return;
-    }   { const DWORD hbA = g_w906IoHeartAt; if (hbA != 0 && (DWORD)(::GetTickCount() - hbA) >= kW906IoStallMs) { static unsigned long s_frozen = 0; if ((s_frozen++ % 50) == 0) { std::printf("[IOTHREAD] card request refused at once: no poll for %lu ms (heartbeat frozen; %lu refused so far)\n", (unsigned long)((DWORD)::GetTickCount() - hbA), s_frozen); std::fflush(stdout); } return; } }   //AI(W906-IOFIX-2) 20261007: review 20261006 #1 -- the thread is already stuck: refuse BEFORE queueing, so a caller that asks every 100 ms (Motor Test page W906_TorqueFocus -> SetTorqueFocusAxis) no longer freezes the tick loop 5 s per ask
+    }   //AI(W906-IOFIX-3) 20261007: the IOFIX-2 "refuse at once when the heartbeat is frozen" that was here is REMOVED (review 20261007: with GetTickCount()|1 the unsigned difference wrapped and refused normal requests incl. STOPs at random; and a legitimately long Poll -- re-attach ScanSlaves_+OpenAxes_ up to ~8 s -- would refuse STOPs too). The Motor Test caller skips itself instead (WebMotorAccessLive.cpp W906_TorqueFocus).
     W906IoReq r;
     r.fn = fn;  r.arg = arg;  r.boundaryOnly = boundaryOnly;
     r.done = ::CreateEventA(NULL, TRUE, FALSE, NULL);
@@ -4526,7 +4526,7 @@ void Pci1203IoThreadRunSync(void (*fn)(void*), void* arg, bool boundaryOnly)
     //  on this stack frame), so keep waiting -- and say so every 5 s.
     const DWORD t0 = ::GetTickCount();
     long hb0 = g_w906IoHeart;
-    DWORD hbAt = (g_w906IoHeartAt != 0) ? (DWORD)g_w906IoHeartAt : t0, noteAt = t0;   //AI(W906-IOFIX-2) 20261007: the freeze clock starts at the last heartbeat, not at this request (was hbAt = t0)
+    DWORD hbAt = t0, noteAt = t0;   //AI(W906-IOFIX-3) 20261007: back to the request time (IOFIX-2 started it at the last heartbeat; review 20261007: a long but alive Poll then refused queued STOPs)
     for (;;) {
         HANDLE hs[2] = { r.done, g_w906IoThread };
         const DWORD w = ::WaitForMultipleObjects(2, hs, FALSE, 500);
@@ -4672,3 +4672,14 @@ void Pci1203IoThreadStop(unsigned long waitMs)
     g_w906IoTid = 0;
 }
 }  // namespace ht9045
+//AI(W906-IOFIX-3) 20261007: how long since the IO thread's last heartbeat (end of a Poll), for callers that ask the card on every
+//  beat and must not queue behind a stuck thread (WebMotorAccessLive.cpp W906_TorqueFocus). 0 = thread not running or no heartbeat
+//  yet (nothing to judge). Signed difference: a heartbeat stamped in this same tick reads 0, never a wrapped 4294967295.
+unsigned long W906_Pci1203IoHeartAgeMs()
+{
+    if (!ht9045::Pci1203IoThreadRunning()) return 0;
+    const DWORD at = ht9045::g_w906IoHeartAt;
+    if (at == 0) return 0;
+    const long d = (long)(::GetTickCount() - at);
+    return d > 0 ? (unsigned long)d : 0ul;
+}
