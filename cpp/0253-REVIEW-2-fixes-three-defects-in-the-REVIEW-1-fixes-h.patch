                     bIOPowered=true;
 
-                bPLCIOEffect=true;                                              //完成過一次 (completed at least once)   { void W906_SafePlcFrameMark(); W906_SafePlcFrameMark(); }   //AI(W906-PLCLOST) 20261007: frame time for the link-lost alarm (end of file)
+                bPLCIOEffect=true;  { void W906_SafePlcFrameMark(); W906_SafePlcFrameMark(); }   //完成過一次 (completed at least once)   //AI(W906-PLCLOST-2) 20261007: a frame arrived -> the link-lost miss count is reset (end of file). The first version put this call AFTER the line's `//` comment, so it was never compiled (review 20261007)
                 iSlave++;
                 iTransactionID++;
                 Task=1;
@@ -292,7 +292,7 @@ void PLCIOTaskCycle()
             {
                 if(hCheckTime.Off())
                 {
-                    iSlave++;
+                    iSlave++;  { void W906_SafePlcFrameMiss(); W906_SafePlcFrameMiss(); }   //AI(W906-PLCLOST-2) 20261007: this request got no reply within hCheckTime (1 s) -> one miss (end of file)
                     iTransactionID++;
                     Task=1;
                 }
@@ -457,27 +457,27 @@ void W906_PlcM1SAllDoors(int slave)
 //AI(W906-PLCLOST) 20261007: EastSun 1006 (asked whether a PLC link loss should clear the door data) 「Plc斷線額外寫異常」.
 //  Review 20261006: after a link loss golden keeps the last frame (its clear block in PLCStatusCheck is commented out, Ken 20250428),
 //  so doors / EMG keep reading "closed", and bCheckPLCConnet only notices once the socket itself is down -- a pulled cable can stay
-//  "connected" for tens of seconds. This is the separate alarm: the link is LOST when SafePlcIO=1 and either the socket is not
-//  connected or no reply frame has arrived for kW906PlcLostMs (from the first ask, so "never answered since boot" counts too).
-//  csystem.cpp DoSystem raises WAR16155 on it while running (same place as golden's G12 check). The door / EMG data are not touched.
-#include <chrono>
-static const long kW906PlcLostMs = 2000;
-static long long s_w906PlcFrameAt = 0, s_w906PlcSince = 0;
-static long long W906_PlcNowMs()
+//  "connected" for tens of seconds. This is the separate alarm, WAR16156 (csystem.cpp DoSystem, while running, after golden's G12).
+//AI(W906-PLCLOST-2) 20261007: review 20261007 -- (a) the first version's frame mark was swallowed by a `//` comment, so the alarm fired
+//  2 s after every START with a healthy PLC; (b) it judged by wall-clock age (no frame for 2 s), so a tick-loop stall of 2 s blamed the
+//  PLC; (c) WAR16155 was already given to "1203 card command failed" (RULINGS_20261005 #96) -> now WAR16156. Judged by REQUESTS now:
+//      lost = SafePlcIO=1 and (socket not connected, or the last kW906PlcLostMisses requests each got no reply within hCheckTime=1 s)
+//  A reply resets the count (PLCIOTaskCycle case 100). A tick stall makes at most one request time out before the next one is
+//  answered, so it no longer trips; a pulled cable trips after 2 timeouts (~2 s of polling); "never answered since boot" trips too
+//  (the misses pile up) and so does "never connected" (socket down). The door / EMG data are not touched.
+static const int kW906PlcLostMisses = 2;
+static int s_w906PlcMisses = 0;
+void W906_SafePlcFrameMark()
 {
-    return (long long)std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+    s_w906PlcMisses = 0;
 }
-void W906_SafePlcFrameMark()
+void W906_SafePlcFrameMiss()
 {
-    s_w906PlcFrameAt = W906_PlcNowMs();
+    if(s_w906PlcMisses < 1000000) ++s_w906PlcMisses;
 }
 bool W906_SafePlcLinkLost()
 {
     if(!Enable_PLCSafety_IO)
         return false;
-    const long long now = W906_PlcNowMs();
-    if(s_w906PlcSince == 0)
-        s_w906PlcSince = now;
-    const long long ref = s_w906PlcFrameAt ? s_w906PlcFrameAt : s_w906PlcSince;
-    return !PlcComm.IsConnected() || (now - ref) > kW906PlcLostMs;
+    return !PlcComm.IsConnected() || s_w906PlcMisses >= kW906PlcLostMisses;
 }
