 =?UTF-8?q?--=20position=200=20=3D=20done,=20elsewhere=20=3D=20failed;=20n?=
 =?UTF-8?q?o=20HOMING=20sample,=20no=20timing=20(same=20rule=20as=20Pci120?=
 =?UTF-8?q?3MotorRoute=20RouteHomeDone)=20--=20EastSun=201003=20'=E9=80=99?=
 =?UTF-8?q?=E6=98=AF=E6=80=8E=E5=9B=9E=E4=BA=8B=E4=B8=8D=E6=98=AF=E9=83=BD?=
