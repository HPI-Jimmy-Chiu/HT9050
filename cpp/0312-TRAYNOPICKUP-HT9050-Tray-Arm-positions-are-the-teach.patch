+    extern AnsiString W906_GpibModel; const bool w906Ht9050Arm=(W906_GpibModel=="9050GPIB" || MachineTypeChoice==Type_HT9050); if(w906Ht9050Arm && bCheckPos) { const int ld=Prod.iXTrayLoad, em=Prod.iXTrayEmpty; const bool ldHigh=(ld>em); const int lo=ldHigh?em:ld, hi=ldHigh?ld:em; bool bad=false; const char* why=""; for(int a=0; a<3; a++) { const int ax=Prod.iXTrayAuto[a]; if(ax==0) continue; if(iTrayArmTarget==eTrayArmLoader && (ldHigh ? p<=ax : p>=ax)) { bad=true; why="loader"; } if((iTrayArmTarget==eTrayArmEmpty || iTrayArmTarget==eTrayArmColor) && (ldHigh ? p>=ax : p<=ax)) { bad=true; why="empty"; } } if(iTrayArmTarget==eTrayArmAuto && (p<=lo || p>=hi)) { bad=true; why="auto"; } if(iTrayArmTarget==-1 && (p<lo || p>hi)) { bad=true; why="other"; } if(bad) { sMsg.sprintf("TrayArm moves %d out of the HT9050 order (%s): Loader %d / Auto %d %d %d / Empty %d. Please check the Tray Arm teach positions.", p, why, ld, Prod.iXTrayAuto[0], Prod.iXTrayAuto[1], Prod.iXTrayAuto[2], em); recordTeachGuard(); ShowMyMessage(sMsg); return bResult; } }  if(iSafePos>0 && bCheckPos && !w906Ht9050Arm)   //AI(W906-TRAYSAFE9050) 20261007: EastSun 1007「寫HT9050的自己判斷 Loader在最左邊，Empty在最右邊，Auto在中間」-- golden's safe line (Empty+Color)/2+6500 assumes the 9046 layout and refused every move to Empty (7532) and Loader (191213) on HT9050 ("TrayArm moves 7532 to the left error", 22:23:45). HT9050: Loader beyond every Auto, Empty beyond every Auto on the other side, an Auto between Empty and Loader, anything else inside [Empty, Loader] -- sides taken from the teach values, not hard-coded. HOME still passes bCheckPos=false. Other machines: golden below. Same line. 20261008 EastSun 00:04 box "TrayArm moves 6800 out of the HT9050 order (other)": HT9050 has no Color track -- Color X = teach 0 + pickup 6800, golden waits / clears there -- so Color follows the Empty rule (beyond every Auto on the Empty side)
     {
