From 4e1569ec7a3932a26f15e2509f65fd3729c69409 Mon Sep 17 00:00:00 2001
From: "HT9045 Machine (V906)" <Claude_RDBC_02@honprec.com>
Date: Sat, 3 Oct 2026 09:50:26 +0800
Subject: [PATCH] TEACH-ROTATE: Teach Axle Control shows the Rotate box (In X =
 M41 MInRotate, Out X = M42 MOutRotate) on HT9050 by Mot_Table Enable, not by
 USE_ROTATE_KIT (0 here; turning it on would arm the rotate kit in production)
 -- EastSun 1003 'add the rotate motor buttons so I can drive them; you can
 see which are enabled in Mot_Table'

---
 FileRW/TeachFormShow_File.cpp | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/FileRW/TeachFormShow_File.cpp b/FileRW/TeachFormShow_File.cpp
index 8014111..9ae2ba2 100644
--- a/FileRW/TeachFormShow_File.cpp
+++ b/FileRW/TeachFormShow_File.cpp
@@ -26,6 +26,7 @@
 // ===========================================================================
 #include "JsonBridge/FormBridge.h"
 #include "cmydef.h"
+#include "database.h"     //AI(W906-TEACH-ROTATE) 20261003: HSys.MotTable / W906_GpibModel (the HT9050 Rotate box below)
 #include "Config.h"
 #include "MachineType.h"
 #include "CosFunction.h"
@@ -119,6 +120,19 @@ static void B_FormShow(FormState& J)
 
     J.SetVisible("grpRotate_Axis", ((USE_ROTATE_KIT==1) && (iRotate_Type==e1MotRotate || iRotate_Type==e1MotRotate1Dut || iRotate_Type==eInOutArm1Motor)));   // :1651
     J.SetVisible("grpRotate_Kit", ((USE_ROTATE_KIT==1) && (iRotate_Type==e1MotRotate || iRotate_Type==e1MotRotate1Dut || iRotate_Type==eInOutArm1Motor)));
+    //AI(W906-TEACH-ROTATE) 20261003: EastSun「這個畫面幫我加入rotate 的馬達按鈕 讓我可以操控 你應該可以看到MOT_TABLE 哪顆是enable」--
+    //  HT9050 (9050GPIB): the Axle Control "Rotate" box (MotorInRotateKit = M41 MInRotate, MotorOutRotateKit = M42 MOutRotate; the page
+    //  finds them by number, HW.teach.html TEACH_MOTOR_NUM) shows by Mot_Table Enable instead of USE_ROTATE_KIT (0 on this machine --
+    //  turning that on would arm the rotate kit in the production flow, not only these two buttons).
+    if (W906_GpibModel == "9050GPIB") {
+        struct EnabledRow { static bool Of(const char* no) {
+            for (std::size_t i = 0; i < HSys.MotTable.size(); ++i) { const TMOTDATA* r = HSys.MotTable[i]; if (r && r->No == no) return r->iEnable == 1; }
+            return false; } };
+        const bool inEn = EnabledRow::Of("M41"), outEn = EnabledRow::Of("M42");
+        J.SetVisible("grpRotate_Axis", inEn || outEn);
+        J.SetVisible("MotorInRotateKit", inEn);
+        J.SetVisible("MotorOutRotateKit", outEn);
+    }
 
     J.SetVisible("pnlInRot_Go", (((USE_ROTATE_KIT==1) && (iRotate_Type!=eCynRotate)) || (USE_DIE_CLEAN==1)));   // :1654
     J.SetVisible("pnlInRot_XY", (((USE_ROTATE_KIT==1) && (iRotate_Type!=eCynRotate)) || (USE_DIE_CLEAN==1)));
-- 
