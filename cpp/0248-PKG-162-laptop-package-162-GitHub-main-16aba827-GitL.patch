     if(W906_ShtAxisOff(MTestZ1)) return true;
     return MOT[MTestZ1].HomeFlag==1 && MOT[MTestZ1].Motor->MotionDone() && abs(MOT[MTestZ1].ReadEncoderPos())<=W906_HT9050_DRYRUN_Z1_HOME_TOL;
 }
+static bool W906_ShtCcdYHome();                                                 //AI(W906-FRNB2-2) 20261006: FR-NB2 (2), defined after W906_Ht9050Z1AtSafe (below)
+static bool W906_Ht9050ShtToSocketBlocked(int mi);                              //AI(W906-FRNB2-2) 20261006: ditto
 // Out Shuttle 2 to its Left (Tech.iOutShuttle2Left = Prod.OutSHT[1].iLeft, cinitial.cpp:6225) = the safe point for Out Shuttle 1
 // going in / out of the Index area. true = there; false = not yet (moving it, or waiting for the Out Arm ZA at home; *why says which).
 bool W906_Ht9050OutSht2ToLeft(std::string *why)
@@ -3310,6 +3312,21 @@ bool W906_Ht9050OutSht2ToLeft(std::string *why)
         if(why) *why="Out Arm ZA not at home / Out Arm ZA 不在原點";
         return false;
     }
+    //AI(W906-FRNB2-2) 20261006: spec §5.2 M18 (1) Out Shuttle 1 (M17) at Right and still, (4) M108 at home -- Type_HT9050 only (the 9046_LS
+    //  flow's W906_Ht9050OutSht1ToRight moves M18 to Left BEFORE M17 leaves the Index, so it keeps the old rule). The HOME lamp of M17 the
+    //  spec also names is not asked: on this machine a 1203 axis can rest at 0 with the lamp off after HOME (Out Arm ZA, F9050-FIX2).
+    if(MachineTypeChoice==Type_HT9050 && !W906_ShtAt(MOutShuttle1, Prod.OutSHT[0].iRight))
+    {
+        W906_ShtStopIfMoving(MOutShuttle2);
+        if(why) *why="Out Shuttle 1 not at Right / Out Shuttle 1 不在右邊";
+        return false;
+    }
+    if(MachineTypeChoice==Type_HT9050 && !W906_ShtCcdYHome())
+    {
+        W906_ShtStopIfMoving(MOutShuttle2);
+        if(why) *why="M108 CCD Y not at home / M108 CCD Y 不在原點";
+        return false;
+    }
     MOT[MOutShuttle2].MotorMove(Prod.OutSHT[1].iLeft);
     if(why) *why="Out Shuttle 2 moving to Left / Out Shuttle 2 移往 Left";
     return false;
@@ -3367,14 +3384,13 @@ bool W906_Ht9050OutSht1NotClearShuttle1CanNotMove()
 //  W906_Ht9050OutSht1NotClearShuttle1CanNotMove would fight OutSH case 100 tick by tick).
