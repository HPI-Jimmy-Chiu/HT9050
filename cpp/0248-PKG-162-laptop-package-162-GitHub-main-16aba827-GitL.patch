 // IsTestZ1NotSafeShuttle1CanNotMove, which 910's case 200 does not call). true = wait (In Shuttle 1 stopped).
+//AI(W906-FRNB2-2) 20261006: Frank 1006 15:3x 1A -- Out Shuttle 1 in its SAFE ZONE (not only parked at Right), plus the Index Z1 at its safe
+//  height and still: W906_Ht9050ShtToSocketBlocked (below). Was: Out Shuttle 1 at Right +-W906_HT9050_SHT_POS_TOL and still.
 bool W906_Ht9050InSht1ToIndexBlocked(int &iRetryCT)
 {
     if(!W906_ShtIsHT9050()) return false;
-    if(!W906_ShtAt(MOutShuttle1, Prod.OutSHT[0].iRight))
-    {
-        W906_ShtStopIfMoving(MInShuttle1);
+    if(W906_Ht9050ShtToSocketBlocked(MInShuttle1))
         return true;
-    }
     if(IsTestZ1NotSafeShuttle1CanNotMove(iRetryCT))
         return true;
     iRetryCT=0;
@@ -3383,10 +3399,18 @@ bool W906_Ht9050InSht1ToIndexBlocked(int &iRetryCT)
 // Out Shuttle 1 into (Left) or out of (Right) the Index area (OutSH cases 100 / 200 / 201): unless it is already at the target,
 // Out Shuttle 2 must be at Left (moved there when the Out Arm ZA is at home) and the Out Arm ZA at home -- checked every tick of
 // the move, so Out Shuttle 1 stops if the Out Arm ZA leaves home. true = do not move this tick.
+//AI(W906-FRNB2-2) 20261006: + spec §5.2 M17 (5) M108 at home (every M17 move), and (4) into the Index (target = Left): the Index Z1 at its
+//  safe height and still + In Shuttle 1 in its safe zone (W906_Ht9050ShtToSocketBlocked). Type_HT9050 only.
 bool W906_Ht9050OutSht1MoveBlocked(int target)
 {
     if(!W906_ShtIsHT9050()) return false;
     if(W906_ShtAt(MOutShuttle1, target)) return false;
+    if(MachineTypeChoice==Type_HT9050 &&
+       (!W906_ShtCcdYHome() || (target==Prod.OutSHT[0].iLeft && W906_Ht9050ShtToSocketBlocked(MOutShuttle1))))
+    {
+        W906_ShtStopIfMoving(MOutShuttle1);
+        return true;
+    }
     std::string why;
     if(W906_ShtOutArmZAHome() && W906_Ht9050OutSht2ToLeft(&why))
         return false;
@@ -3403,6 +3427,68 @@ bool W906_Ht9050Z1AtSafe()
     const int d=MOT[MTestZ1].ReadPos()-Prod.TestZ1_Safe;
     return d<=W906_HT9050_Z1_SAFE_TOL && -d<=W906_HT9050_Z1_SAFE_TOL;
 }
+//AI(W906-FRNB2-2) 20261006: FR-NB2 (2) -- the SHUTTLE side of W-44 (RULINGS_20261006 #11; spec docs/spec/modules/motion-priority-interlock.spec.md
+//  §4.1 / §5.2; Frank 1006 15:3x "1A2A3A", FROM_FRANK §2). The Index side is St01's (ST01-C 1b); it asks through the hook installed below.
+//  Safe zone: a shuttle is out of the socket area while it is on its home side of "home + W906_HT9050_SHT_SAFE_BAND toward the socket"
+//  (In Shuttle 1: home = Left, socket = Right; Out Shuttle 1: home = Right, socket = Left). The direction is each shuttle's own
+//  sign(socket - home), i.e. the spec's sign(Right - Left): this machine has In Shuttle 1 Left 0 / Right -69123 and Out Shuttle 1 Right 0 /
+//  Left 91850, so the spec's literal "Left + 1000 / Right - 1000" would land outside home. Beyond home is always safe (the HT9050 shake,
+//  DoShakeShuttle iLeft + iShakeDistance*100, swings that way). Left == Right (not taught) = no direction = not safe.
+//  Frank 2A: the band is Steven's default 1000 (about 1 cm) until EastSun measures (a teach key later). Moving: safe only if the commanded
+//  target (MotorMove / MotorMoveShuttleShake keep it in iOldPos) is in the zone too. Positions = ReadEncoderPos, as the helpers above (St01's
+//  1b reads ReadPos -- to be unified, FROM_FRANK §3 1006 15:3x). St01's IndexZTorqueCore.h ShuttleInSafeZone (parked branch
+//  v906/st01-c-1b) is the same rule; once it is on main this one should call it.
+#ifndef W906_HT9050_SHT_SAFE_BAND
+#define W906_HT9050_SHT_SAFE_BAND 1000
+#endif
+bool W906_ShtPosInSafeZone(int pos, int home, int socket)
+{
+    if(socket==home) return false;
+    const long d=(long)pos-(long)home;
+    return (socket>home) ? (d<=W906_HT9050_SHT_SAFE_BAND) : (d>=-W906_HT9050_SHT_SAFE_BAND);
+}
+static bool W906_ShtClearOfSocket(int mi, int home, int socket)                 // no motor object / Enable 0 = clear (as W906_ShtAt)
+{
+    if(W906_ShtAxisOff(mi)) return true;
+    if(!W906_ShtPosInSafeZone(MOT[mi].ReadEncoderPos(), home, socket)) return false;
+    if(MOT[mi].Motor->MotionDone()) return true;
+    return W906_ShtPosInSafeZone(MOT[mi].iOldPos, home, socket);
+}
+static bool W906_ShtInSht1Clear()  { return W906_ShtClearOfSocket(MInShuttle1,  Prod.InSHT[0].iLeft,   Prod.InSHT[0].iRight); }
+static bool W906_ShtOutSht1Clear() { return W906_ShtClearOfSocket(MOutShuttle1, Prod.OutSHT[0].iRight, Prod.OutSHT[0].iLeft); }
+//  M108 (MCCDY, the CCD's Y) at home -- Frank 3A: HOME lamp on AND encoder within +-W906_HT9050_SHT_POS_TOL of 0; Enable 0 = at home.
+//  (910's own CCD-Y interlock before an Index Z descent, atester_FinePitch.cpp MoveIndexZ: ReadPos()==0 with the HOME lamp on.)
+static bool W906_ShtCcdYHome()
+{
+    if(W906_ShtAxisOff(MCCDY)) return true;
+    MOT[MCCDY].ScanMotorStatus();
+    return MOT[MCCDY].Led[iHomeLed] && abs(MOT[MCCDY].ReadEncoderPos())<=W906_HT9050_SHT_POS_TOL;
+}
+//  The Index side asks (St01: atester_FinePitch.h W906_Ht9050ShuttlesClearOfIndexHook, "Frank's code registers ... here"; null = not clear):
+//  may Index Z1 press to the socket now? = both shuttles clear of the socket area. Installed at static-init time (the hook is
+//  constant-initialised to 0 in atester_FinePitch.cpp, so the order of the two files does not matter). Today nothing on main calls
+//  St01's press path (ST01-C slice 1 has no caller), so installing it changes nothing at run time yet.
+extern bool (*W906_Ht9050ShuttlesClearOfIndexHook)(AnsiString* why);   // atester_FinePitch.h:42 verbatim -- not #included: ctest FP9050_Index [F2] keeps that header to St01's own file
+bool W906_Ht9050ShuttlesClearOfIndex(AnsiString *why)
+{
+    if(why) *why="";
+    if(!W906_ShtInSht1Clear())  { if(why) *why="W-44: In Shuttle 1 not in its safe zone / In Shuttle 1 不在安全區";  return false; }
+    if(!W906_ShtOutSht1Clear()) { if(why) *why="W-44: Out Shuttle 1 not in its safe zone / Out Shuttle 1 不在安全區"; return false; }
+    return true;
+}
+static const bool s_W906ShuttlesClearHookSet=(W906_Ht9050ShuttlesClearOfIndexHook=&W906_Ht9050ShuttlesClearOfIndex, true);
+//  A shuttle about to go INTO the socket area (In Shuttle 1 to Right, Do_Auto_InSH case 200; Out Shuttle 1 to Left, Do_Auto_OutSH case 100):
+//  spec §5.2 "Index Arm 1 不是壓在 socket 區域" = the Index Z1 at its safe height (W906_Ht9050Z1AtSafe, the rule case 1 already waits for)
+//  and still -- the press itself is St01's W44PressGate, not on main yet -- and the OTHER shuttle in its safe zone (Frank 1A).
+//  true = wait this tick (the shuttle is stopped if it was moving).
+static bool W906_Ht9050ShtToSocketBlocked(int mi)
+{
+    const bool otherClear=(mi==MInShuttle1) ? W906_ShtOutSht1Clear() : W906_ShtInSht1Clear();
+    const bool z1Clear=W906_ShtAxisOff(MTestZ1) || (W906_Ht9050Z1AtSafe() && !W906_ShtMoving(MTestZ1));
+    if(otherClear && z1Clear) return false;
+    W906_ShtStopIfMoving(mi);
+    return true;
+}
 //  (2)「Out Shuttle Y 要在右邊才能讓Out Arm取到料」「要的」（W-92 ①，NB2-1 設計 B1）：910 的 Do_Auto_OutSH 只動 MOutShuttle1；Out Shuttle 的
 //  Y 軸（MOutShuttle2，M18）要推到 Prod.OutSHT[1].iRight（Out Arm 取料位）。推之前 Out Shuttle 1 要在 Right（已退出 Index）、Out Arm ZA 在原點
 //  （同 W906_Ht9050OutSht2ToLeft 的規則）。推回 Left 不用另外寫：Out Shuttle 1 要再進 Index 前，W906_Ht9050OutSht1MoveBlocked 會先把它推回 Left。
@@ -3423,6 +3509,12 @@ bool W906_Ht9050OutShtYToRight(std::string *why)
         if(why) *why="Out Arm ZA not at home / Out Arm ZA 不在原點";
         return false;
     }
+    if(!W906_ShtCcdYHome())                                                     //AI(W906-FRNB2-2) 20261006: spec §5.2 M18 (4) M108 at home (Frank 3A)
+    {
+        W906_ShtStopIfMoving(MOutShuttle2);
+        if(why) *why="M108 CCD Y not at home / M108 CCD Y 不在原點";
+        return false;
+    }
     MOT[MOutShuttle2].MotorMove(Prod.OutSHT[1].iRight);
     if(why) *why="Out Shuttle Y moving to Right / Out Shuttle Y 移往 Right";
     return false;
