diff --git a/EtherCAT/Pci1203MotorRoute.cpp b/EtherCAT/Pci1203MotorRoute.cpp
index bc66f1f..6b6340c 100644
--- a/EtherCAT/Pci1203MotorRoute.cpp
+++ b/EtherCAT/Pci1203MotorRoute.cpp
@@ -13,6 +13,7 @@
 #include "MachineType.h"   // SOFT_SIMULTE / INSTALL_1203_MONITOR / WB_PUMP_1203_CONTROL / WB_PUMP_1203_START_RING / WB_ENGINE_MOTOR_1203 decided BEFORE the #if below (tools/macro_order_gate.ps1)
 #include "EtherCAT/Pci1203MotorRoute.h"
 
+#include <chrono>     // AI(W906-HOME-TIMEOUT) 20261003: steady_clock (the per-axis home time limit)
 #include <cstdio>
 #include <cstring>
 #include <map>
@@ -112,6 +113,7 @@ struct AxisRec {
     bool          stopSkipped;                           // the StopDec of this DecStop was skipped (Q7) -> skip its ExtDrive(0)
     bool          homeActive, homeSent, homeSawHoming, homeCardSide, homeNoHomingNoted;   int homeReadyNoHoming;   //AI(W906-HOME-FAILVISIBLE) 20261003: RouteHomeDone calls that read READY with no HOMING seen
     unsigned long homeCmdPoll = 0;   //AI(W906-HOME-SEEN) 20261003: card pollCount when the home command was issued
+    std::chrono::steady_clock::time_point homeCmdTime;   //AI(W906-HOME-TIMEOUT) 20261003: wall clock at the home command
     double        spd[kSpd];    // last SUCCESSFUL write per Pci1203SpeedParam (Q7)
     bool          spdOk[kSpd];
     unsigned long bindTries;
@@ -657,6 +659,7 @@ int RouteHomeStart(int board, int port, bool homeDir, double hi, double lo, doub
     }
     rec->homeSent = ok;
     rec->homeCmdPoll = Env().PollCount();                              //AI(W906-HOME-SEEN) 20261003: a HOMING sample from a poll that ENDS after this counts (RouteHomeDone)
+    rec->homeCmdTime = std::chrono::steady_clock::now();               //AI(W906-HOME-TIMEOUT) 20261003
     //AI(W906-HOME-READYDONE) 20261003: the HOME-WATCH short polls after the command (0178) and the HOME-POLL poll before it (0175) are
     //  removed -- EastSun「為神魔要間格讀取狀態?…之後好幾百台機台 已定會有幾台迴圈比較久 一定出問題」; RouteHomeDone's DS402 rule needs no HOMING sample.
     if (ok) rec->stuck = false;      // Exec() re-marks it when the home command itself was not issued OK
@@ -703,6 +706,16 @@ int RouteHomeDone(int board, int port)
         Say(board, port, "HomeDone", "FAILED", "the home command was never sent (see the HomeStart line) -> reported as a failed home");
         return -1;
     }
+    //AI(W906-HOME-TIMEOUT) 20261003: EastSun「剛剛一直沒有歸原點完成 也沒有叫異常」-- 20:34 MLoaderZ homed 54 s without finding its origin
+    //  and nothing alarmed: golden's 90 s MotorHome timeout (mymotor.cpp RESET_TIMES) never expires in the full HOME, because uhome calls
+    //  MotorHome(flag1) with flag1 true on every pass and a true Flag re-arms ResetTime each call. So the route bounds its own home: 90 s of
+    //  wall clock (golden's RESET_TIMES, independent of how fast the loop runs) after the command without the home ending = failed ->
+    //  TMyEtherCatMotor home fault -> MotorHome 2 -> uhome's motor-alarm path (StopAllMotor + that axis's jam popup).
+    if (std::chrono::steady_clock::now() - rec->homeCmdTime > std::chrono::seconds(90)) {
+        rec->homeActive = false;
+        Say(board, port, "HomeDone", "FAILED", "the home did not end within 90 s of the command (golden RESET_TIMES) -> reported as a failed home");
+        return -1;
+    }
     if (!e.CardUsable()) return 0;
     int hits = 0;
     const int slot = Pci1203MotorRouteFindSlot(e, board, port, &hits);
