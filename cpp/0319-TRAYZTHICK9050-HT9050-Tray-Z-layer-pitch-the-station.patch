+//==============================================================================
+//AI(W906-TRAYZTHICK9050) 20261008: EastSun 1008 (Teach > Tray Arm「9050 Tray Z」pitch column, Tray Form Type1 Thickness 7.62)
+//  「第一張圖紅框處的設定值請使用第二張圖黃框處的資訊帶入」. The layer pitch of zone z is that station's tray-type thickness in golden's
+//  Z units: UserDefForm_File[type].ZDepth (mm) * 100, the same conversion as golden's dbTrayThick (InitialSet Loader / Auto arm Z).
+//  Station -> tray type: 0 Loader = TrayForm.Loader, 1 Empty = TrayForm.Empty, 2-4 Auto1-3 = TrayForm.Auto[eAuto1..eAuto3].
+//  A thickness of 0 or a bad type keeps the taught Tech.iTrayZ9050Pitch[z]. W906_TrayZ9050PitchSync (csystem.cpp DoAllProcess, every
+//  pass, HT9050 only) copies the value in use into Tech.iTrayZ9050Pitch[] so the Teach page shows it (a typed pitch is replaced while a
+//  thickness is set; a Teach-page save stores the thickness value).
+int W906_TrayZ9050Pitch(int zone)
+{
+    if(zone < 0 || zone > 4)
+        return 0;
+    int t = -1;
+    if(zone == 0)
+        t = TrayForm.Loader.iTrayType;
+    else if(zone == 1)
+        t = TrayForm.Empty.iTrayType;
+    else
+        t = TrayForm.Auto[eAuto1 + zone - 2].iTrayType;
+    if(t >= 0 && t < 4)
+    {
+        const double d = UserDefForm_File[t].ZDepth * 100.0;
+        if(d >= 1.0)
+            return (int)(d + 0.5);
+    }
+    return Tech.iTrayZ9050Pitch[zone];
+}
+void W906_TrayZ9050PitchSync()
+{
+    extern AnsiString W906_GpibModel;
+    if(!(W906_GpibModel == "9050GPIB" || MachineTypeChoice == Type_HT9050))
+        return;
+    for(int z = 0; z < 5; z++)
+        Tech.iTrayZ9050Pitch[z] = W906_TrayZ9050Pitch(z);
+}
