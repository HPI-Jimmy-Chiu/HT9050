+// ===========================================================================
+//  [TT] AI(W906-TRAYZTHICK9050) 20261008: EastSun 1008「第一張圖紅框處的設定值請使用第二張圖黃框處的資訊帶入」-- the Teach page's
+//       9050 Tray Z pitch = the station's Tray Form thickness x100 (golden dbTrayThick units); thickness 0 keeps the taught pitch.
+// ===========================================================================
+int W906_TrayZ9050Pitch(int zone); void W906_TrayZ9050PitchSync();
+void TrayZThicknessPitch()
+{
+    printf("[TT] Tray Z pitch from the Tray Form thickness (Type1 7.62 mm -> 762)\n");
+    extern AnsiString W906_GpibModel;
+    const AnsiString savedModel = W906_GpibModel;
+    double savedDepth[4];
+    for (int k = 0; k < 4; ++k) { savedDepth[k] = UserDefForm_File[k].ZDepth; UserDefForm_File[k].ZDepth = 0; }
+    const int savedType[5] = { TrayForm.Loader.iTrayType, TrayForm.Empty.iTrayType, TrayForm.Auto[eAuto1].iTrayType,
+                               TrayForm.Auto[eAuto1 + 1].iTrayType, TrayForm.Auto[eAuto1 + 2].iTrayType };
+    for (int z = 0; z < 5; ++z) { Tech.iTrayZ9050UpBase[z] = 21000; Tech.iTrayZ9050DownBase[z] = 20000; Tech.iTrayZ9050Pitch[z] = 2300; }
+    TrayForm.Loader.iTrayType = 0; TrayForm.Empty.iTrayType = 0; TrayForm.Auto[eAuto1].iTrayType = 0;
+    TrayForm.Auto[eAuto1 + 1].iTrayType = 1; TrayForm.Auto[eAuto1 + 2].iTrayType = 2;
+
+    CHECK(W906_TrayZ9050Pitch(0) == 2300 && W906_TrayZ9050(0, 1, 1) == 18700, "thickness 0 (not set): the taught pitch 2300 is kept");
+    UserDefForm_File[0].ZDepth = 7.62; UserDefForm_File[1].ZDepth = 12.19; UserDefForm_File[2].ZDepth = 0;
+    CHECK(W906_TrayZ9050Pitch(0) == 762, "Loader on Type1 7.62 mm -> pitch 762 (x100, 7.62*100 = 761.99.. rounds to 762)");
+    CHECK(W906_TrayZ9050(0, 1, 0) == 21000 && W906_TrayZ9050(0, 1, 1) == 20238 && W906_TrayZ9050(0, 1, 2) == 19476,
+          "Loader Up: layer 1 = 21000 - 762, layer 2 = 21000 - 2*762");
+    CHECK(W906_TrayZ9050(0, 0, 3) == 20000 - 3 * 762, "Loader Down uses the same pitch");
+    CHECK(W906_TrayZ9050Pitch(1) == 762 && W906_TrayZ9050Pitch(2) == 762, "Empty / Auto1 on Type1 -> 762");
+    CHECK(W906_TrayZ9050Pitch(3) == 1219, "Auto2 on Type2 12.19 mm -> 1219 (each station follows its own tray type)");
+    CHECK(W906_TrayZ9050Pitch(4) == 2300, "Auto3 on Type3 with thickness 0 -> its taught pitch");
+    TrayForm.Loader.iTrayType = 9;
+    CHECK(W906_TrayZ9050Pitch(0) == 2300, "a bad tray type -> the taught pitch, never another type's value");
+    TrayForm.Loader.iTrayType = 0;
+
+    W906_GpibModel = "9050GPIB";
+    W906_TrayZ9050PitchSync();
+    CHECK(Tech.iTrayZ9050Pitch[0] == 762 && Tech.iTrayZ9050Pitch[3] == 1219 && Tech.iTrayZ9050Pitch[4] == 2300,
+          "HT9050 sync: the Teach page's pitch fields show the value in use");
+    UserDefForm_File[0].ZDepth = 7.0;
+    W906_TrayZ9050PitchSync();
+    CHECK(Tech.iTrayZ9050Pitch[0] == 700, "a Tray Form change reaches the Teach page on the next pass");
+    W906_GpibModel = "";
+    const int savedMt = MachineTypeChoice; if (MachineTypeChoice == Type_HT9050) MachineTypeChoice = 0;
+    Tech.iTrayZ9050Pitch[0] = 2300; W906_TrayZ9050PitchSync();
+    CHECK(Tech.iTrayZ9050Pitch[0] == 2300, "not HT9050: the sync writes nothing");
+    MachineTypeChoice = savedMt;
+
+    W906_GpibModel = savedModel;
+    for (int k = 0; k < 4; ++k) UserDefForm_File[k].ZDepth = savedDepth[k];
+    TrayForm.Loader.iTrayType = savedType[0]; TrayForm.Empty.iTrayType = savedType[1]; TrayForm.Auto[eAuto1].iTrayType = savedType[2];
+    TrayForm.Auto[eAuto1 + 1].iTrayType = savedType[3]; TrayForm.Auto[eAuto1 + 2].iTrayType = savedType[4];
 }
