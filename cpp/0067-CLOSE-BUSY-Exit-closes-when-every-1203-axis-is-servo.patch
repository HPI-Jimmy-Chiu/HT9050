+const unsigned long kSvon = 0x00004000ul, kAlm = 0x00000002ul;   // AX_MOTION_IO_SVON／AX_MOTION_IO_ALM（EtherCAT/vendor/AdvMotDrv.h:2037／:2024）
+
+AxisFact IoAxis(int index, unsigned state, double vel, unsigned long motionIO, bool ioValid = true)
+{
+    AxisFact a = Axis(index, state, vel);
+    a.ioValid = ioValid; a.motionIO = motionIO;
+    return a;
+}
+
+// 19:11 那一刻的 Facts：卡開著、命令面 LIVE、停止命令 38 筆全部廠商回錯；19 軸 BUSY（11）、伺服 OFF、驅動器警報、命令速度 0；繼電器正常關掉
+Facts BusyAfterPowerLoss()
+{
+    Facts f = Base1203();
+    f.axes.clear();
+    for (int i = 0; i < 19; ++i) {
+        AxisFact a = IoAxis(i, 11, 0.0, kAlm);                       // SVON 0、ALM 1
+        a.driveErr = 0x80005115ul; a.driveErrText = "Alarm happened.";
+        f.axes.push_back(a);
+    }
+    f.axes[0].station = 14;
+    f.stopIssued = 38; f.stopVendorErr = 38; f.stopRefused = 0;
+    f.stopVendorRet = 0x80001234ul;                                  // 測試值（現場那 38 筆的碼沒有留在 oplog）
+    return f;
+}
+
+void T20_CloseBusyServoOff()
+{
+    // 純判斷
+    CHECK(AxisUndrivable(true, 0, 11, 0.0));                         // BUSY、伺服 OFF、命令速度 0
+    CHECK(AxisUndrivable(true, kSvon | kAlm, 11, 0.0));              // BUSY、伺服 ON 但驅動器警報
+    CHECK(AxisUndrivable(true, kAlm, 0x010Bu, 0.0));                 // 高位元不看（同 AxisStopped）
+    CHECK(!AxisUndrivable(true, kSvon, 11, 0.0));                    // 伺服 ON、沒有警報 ⇒ 卡片還能驅動
+    CHECK(!AxisUndrivable(false, 0, 11, 0.0));                       // 伺服讀不到 ⇒ 不知道 ⇒ 不算
+    CHECK(!AxisUndrivable(true, 0, 11, 25.0));                       // 命令速度不是 0
+    CHECK(!AxisUndrivable(true, 0, 11, -0.5));
+    const unsigned motion[] = { 2, 4, 5, 6, 7, 8, 9, 10, 12, 13, 14, 15 };   // STOPPING／HOMING／PTP／CONTI／SYNC／EXT_JOG／EXT_MPG／PAUSE／WAIT_*／EXT_JOG_READY
+    for (unsigned k = 0; k < sizeof(motion) / sizeof(motion[0]); ++k) CHECK(!AxisUndrivable(true, kAlm, motion[k], 0.0));
+    CHECK(AxisFact().ioValid == false);                              // 預設＝伺服不知道（fail-safe：沒填的呼叫端照舊）
+
+    // (a) 現場那一刻：全部伺服 OFF＋警報、BUSY、命令速度 0，停止命令全部廠商回錯 ⇒ 不擋、關站繼續
