+    { extern void W906_FlowTraceTick(); W906_FlowTraceTick(); }   //AI(W906-FLOWTRACE) 20261007: EastSun 1007「要由資料流來判斷是否能吸放料…看看哪邊會卡住」-- one op-log FLOW line whenever the IC data / engine cursors change (end of file; read only). Replaces a blank line
     static bool bDoProcess=true;                                                //Steven 20110608 : 降低CPU負載
 
     fMain->ProcessSensorScan();                                                //ChungHung 20140815 測試用
@@ -34060,3 +34060,23 @@ bool W906_DoAllProcessLadder(bool &flag)
     return false;                                                               // golden fell through to :10049
 }
 // (end W906_DoAllProcessLadder -- golden csystem.cpp:9165-10047)
+//==============================================================================
+//AI(W906-FLOWTRACE) 20261007: EastSun 1007「程式模擬不是用Step By Step，是要由資料流來判斷是否能吸放料，在一次模擬正常的動作看看哪邊會卡住」
+//  Called at the top of DoAllProcess. Builds one line -- machine state, where the IC data is (tray / In Arm / In Shuttle kit / Index /
+//  Out Shuttle kit / Out Arm) and every engine cursor of the HT9050 flow -- and hands it to the op log (tools/wb_serve.cpp W906_OpLogInit
+//  sets g_W906FlowNote; 0 = nothing, ctests) only when it changed. Reads only.
+void (*g_W906FlowNote)(const char*) = 0;
+void W906_FlowTraceTick()
+{
+    if(g_W906FlowNote==0) return;
+    extern int LoadTask_9050, iCatchFromLoader9050Task, iArmTask, iInArmPlaceToShuttleTask, AutoSHT1Task, AutoSHT2Task, iTestHeadMotorTask,
+               iTestYFinePitchTask, iTestYFrontTask, iFrontTestSuckICTask, iFrontTestDestroyICTask, OutArmTask, iPickFromShuttle1Task;
+    char b[600];
+    std::snprintf(b, sizeof(b), "run=%d stop=%d homed=%d | IC tray=%d inArm=%d inSht=%d index=%d outSht=%d outArm=%d | load=%d catch=%d inArm=%d inPlace=%d inSH=%d outSH=%d head=%d fp=%d testY=%d idxSuck=%d idxPlace=%d outArm=%d outPick=%d",
+                  SystemStart?1:0, SoftStop?1:0, fAllMotorHome?1:0,
+                  MOT[MMTrayY].HasIC()?1:0, InArmSuck.HasIC()?1:0, FLCarryKit.HasIC()?1:0, FTestSuck.HasIC()?1:0, FRCarryKit.HasIC()?1:0, OutArmSuck.HasIC()?1:0,
+                  LoadTask_9050, iCatchFromLoader9050Task, iArmTask, iInArmPlaceToShuttleTask, AutoSHT1Task, AutoSHT2Task, iTestHeadMotorTask,
+                  iTestYFinePitchTask, iTestYFrontTask, iFrontTestSuckICTask, iFrontTestDestroyICTask, OutArmTask, iPickFromShuttle1Task);
+    static std::string s_last;
+    if(s_last!=b) { s_last=b; g_W906FlowNote(b); }
+}
