+int IndexOf(const simnet::Row& r)
+{
+    for (std::size_t i = 0; i < g_n; ++i)
+        if (std::strcmp(g_rows[i].code, r.code) == 0 && std::strcmp(g_rows[i].section, r.section) == 0 &&
+            std::strcmp(g_rows[i].key, r.key) == 0)
+            return (int)i;
+    return -1;
+}
