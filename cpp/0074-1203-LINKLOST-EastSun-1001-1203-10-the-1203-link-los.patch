+// =============================================================================
+//  AI(W906-1203-LINKLOST) 20261001: EastSun 1001「1203 如果斷線10秒 要跳出異常」-- the host of
+//    EtherCAT/Pci1203LinkWatch.h. The DECISION (which signal, which stations, when it arms, the 10 s timer, "once")
+//    and the reason for every rule are in that header; this only feeds it and does what it asks.
+//
+//  WHERE: called right after every Pci1203Monitor()->Poll() -- the main loop's IO clock (kIoTickMs) and the native
+//    window drag keepalive (W906_NativeKeepaliveMain) -- on the tick thread. One sample per call, one static watch.
+//    Not called while a blocking dialog waits (no Poll runs there either); see the header on gaps.
+//
+//  RAISING = golden's own call for an EtherCAT ring disconnect, same arguments:
+//      ShowErrorMessage("WAR16152", 0, MMSystem, 0, S)        golden EtherCAT/MyEtherCAT.cpp:333 (port :511)
+//    (AlarmCodeList.txt WAR16152 "EtherCAT ring 1 was disconnected."; golden raises the same code for ring 0 and
+//    for "Ring Error" too, with the detail in errPart S. errPart here = the watch's reason: the signal, since when,
+//    the per-ring tally, the first stations not in OP.)  KCode 0 = a NOTICE, so through canary_support.cpp
+//    ShowErrorMessage -> W906_ShowErrorMessage_Hook = ForwardShowErrorMessage (this file) it does exactly what every
+//    kcode==0 alarm in this tree does, nothing more:
+//      * W906_AlarmStopLikeGolden (this file): StopAllMotor(true), SoftStop = SoftStart = SystemStart = false
+//        (golden note.cpp:795-801), W906_MotorAccessOnAlarm (DecStop to every 1203 axis the monitor opened,
+//        Motor Test HOME / LoopMove / jog cancelled -- WebMotorAccess.cpp MotorAccessOnAlarm);
+//      * the golden alarm record (forms/fNote_ShowError.cpp W906_ShowErrorMessageRecordLikeGolden: bOpenAllDoor,
+//        MyDBIEvent -> event log / HANDLER LOG / EventTracker WITH errPart, ProductionLog, fNote->ErrShowToForm);
+//      * the dialog-mailbox notice = the HMI popup (one 確認 button, WS dialog.notifyAck) + the alarm.* ring entry;
+//      * it returns at once (AI(W906-Q30-KZERO): no wait loop; no buzzer / Alarm Reset lamp -- that is the blocking
+//        path's W906ModalWaitScope).
+//    NOT done: golden follows WAR16152 with OpenEtherCatMastCard() (MyEtherCAT.cpp:584-591, close + re-open the
+//    card). The monitor is read-only and a re-open is the operator's Refresh (kCmdCardRescan). No START latch other
+//    than SystemStart=false (golden: the operator presses START again).
+//  GOLDEN DIFFERENCES, both from EastSun's request: golden alarms on the FIRST disconnect event its Timer1 check sees
+//    (main.cpp:3033-3040, every 200 x 30 ms), this one after kPci1203LinkLostAlarmMs of continuous loss; golden asks
+//    Acm_DevCheckEvent, this reads what the read-only monitor already samples (no new vendor call).
+//  LOG: stdout "[1203-link] ..." and an oplog LINK line (runcfg\logs\oplog_YYYYMMDD.txt) on arm / first lost sample /
+//    alarm / restore, Chinese + English. The alarm's own text (errPart) stays ASCII: it lands in the csv logs.
+// =============================================================================
+#ifdef INSTALL_1203_MONITOR
+#include "EtherCAT/Pci1203LinkWatch.h"
+void W906_Pci1203LinkWatchTick()
+{
+    ht9045::TPci1203Monitor* mon = ht9045::Pci1203Monitor();
+    if (!mon) return;
+    static ht9045::Pci1203LinkWatch s_watch;
+    SYSTEMTIME st;
+    ::GetLocalTime(&st);
+    char clock[16];
+    std::snprintf(clock, sizeof(clock), "%02d:%02d:%02d", st.wHour, st.wMinute, st.wSecond);
+    const ht9045::Pci1203LinkWatch::Result r =
+        s_watch.Step(ht9045::Pci1203LinkInputFromMonitor(*mon), (unsigned long)::GetTickCount(), clock);
+    const std::string sec = std::to_string((int)(ht9045::kPci1203LinkLostAlarmMs / 1000));   // the header's one constant
+    switch (r.event) {
+    case ht9045::Pci1203LinkWatch::kArmed:
+        std::printf("[1203-link] %s\n", r.text.c_str());
+        OpLine("LINK", "1203 連線正常，開始監看（斷線 " + sec + " 秒跳 WAR16152） / " + r.text);
+        break;
+    case ht9045::Pci1203LinkWatch::kLost:
+        std::printf("[1203-link] %s\n", r.text.c_str());
+        OpLine("LINK", "1203 斷線，開始計時（滿 " + sec + " 秒跳 WAR16152） / " + r.text);
+        break;
+    case ht9045::Pci1203LinkWatch::kAlarm:
+        std::printf("[1203-link] ALARM WAR16152: %s\n", r.text.c_str());
+        std::fflush(stdout);
+        OpLine("LINK", "1203 斷線滿 " + sec + " 秒 -> 跳 WAR16152（停機同其他告警） / " + r.text);
+        WdMark("1203 link lost -> ShowErrorMessage(WAR16152)");
+        ShowErrorMessage("WAR16152", 0, MMSystem, false, AnsiString(r.text.c_str()));   // golden EtherCAT/MyEtherCAT.cpp:333
+        break;
+    case ht9045::Pci1203LinkWatch::kRestored:
+        std::printf("[1203-link] %s\n", r.text.c_str());
+        OpLine("LINK", "1203 連線恢復 / " + r.text);
+        break;
+    default:
+        break;
+    }
+}
+#endif
