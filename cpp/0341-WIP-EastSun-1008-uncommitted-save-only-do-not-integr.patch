                 if(MOT[MEmptyZ].MotorMove(W906_TrayZ9050(1, 1, iEmptyLayerCount_9050-1) + W906_TrayZ9050Lift(1))==1)   //AI(W906-TRAYZ-PITCH) 20261006: was Prod.EmptyZ_Up[..] + Prod.iEmptyCatchExtraLift_9050
                     Task=30;
@@ -2674,7 +2675,7 @@ int DoCatchFromEmpty_9050()
             iEmptyLayerCount_9050--; Task=40;   //AI(W906-TRAYFLOW9050) 20261007: the pick takes the TOP tray (Up[n-1], above) and the stack is n-1 -- the inverse of DoPlaceTrayToEmpty_9050 (Up[n], n+1); 910 never changed the count
             break;
         case 40:                                                                //Step 5: MZ 回下方待命
-            if(Cylinder[C_MobileTrayTableSelect].Pop())
+            if(Cylinder[C_MobileTrayTableSelect].Push())
             {
                 if(MOT[MEmptyZ].MotorMove(W906_TrayZ9050(1, 0, iEmptyLayerCount_9050))==1)   //AI(W906-TRAYZ-PITCH) 20261006: was Prod.EmptyZ_Down[iEmptyLayerCount_9050]
                     Task=70;
@@ -9945,7 +9946,8 @@ int W906_ProbeEmpty9050()
         case 100:
             if(s_iEmptyProbeCylOk9050 || Cylinder[C_EmptyEdgeClip].Pop() &&   /* AI(W906-PROBECYL9050) 20261008: set already -> skip the chain (&& binds before ||) */
                Cylinder[C_EmptyEdgePush].Pop() &&
-               Cylinder[C_EmptyLoaderZ_Select].Push())
+               Cylinder[C_EmptyLoaderZ_Select].Pop() &&
+               Cylinder[C_Empty_Up].Push())
             {   s_iEmptyProbeCylOk9050 = 1;   /* AI(W906-PROBECYL9050) 20261008: cylinders in place -- the next layers only move Z */
                 if(MOT[MEmptyZ].MotorMove(W906_TrayZ9050(1, 1, L)) == 1)
                 {
