+//==============================================================================
+//AI(W906-BOOTCLEAR9050) 20261008: EastSun 1008 (after「重新開啟後應該是MMTrayY上沒有資訊才對」-- golden restores the machine model from
+//  machinerecord.dat at boot, LoadMachineRecord :9717, whenever the last SaveMachineRecord saw material) 「請跳出可選擇的動作，每次開啟
+//  若是機台有料的話跳出是否要清除的畫面，以利後續驗證 若選擇Yes則清除 若選擇No則繼續」.
+//  csystem.cpp DoAllProcess calls this every pass; it runs ONCE, on the first pass after wb_serve has installed the YES / NO hook (at
+//  boot the browser cannot be asked yet -- ShowMyMessageBox_YES_NO would answer 0). HT9050 only. "Has material" = SaveMachineRecord's
+//  own list (:17166-17188, the one that makes the record restore at the next boot) or HasICUnderMachine(). Yes = golden InitialMachine
+//  (the same wipe LoadMachineRecord starts with) + the HT9050 stack counts (Loader / Empty unknown -1, Auto1-3 empty 0) + SaveMachineRecord,
+//  so the next boot starts empty too. No = keep everything, carry on. A box already open (3) asks again on the next pass.
+static bool s_W906BootClearAsked = false;
+void W906_BootAskClearMachineReset()                                            // tests
+{
+    s_W906BootClearAsked = false;
+}
+static bool W906_MachineHasMaterial9050()
+{
+    return MOT[MManualTray1].HasIC() || MOT[MManualTray2].HasIC() || MOT[MManualTray3].HasIC() ||
+           MOT[MManualTray4].HasIC() || MOT[MManualTray5].HasIC() || MOT[MManualTray6].HasIC() ||
+           MOT[MMTrayY].HasIC() || MOT[MMTrayY].fHasTray || MOT[MMTrayY_Car].fHasTray ||
+           MOT[MMPlate1].Tray.HasIC() || MOT[MMPlate2].HasIC() ||
+           MOT[MMAuto1].fHasTray || MOT[MMAuto2].fHasTray || MOT[MMAuto3].fHasTray ||
+           MOT[MMAuto4].fHasTray || MOT[MMAuto5].fHasTray || MOT[MMAuto6].fHasTray ||
+           MOT[MMAuto1_Car].fHasTray || MOT[MMAuto2_Car].fHasTray || MOT[MMAuto3_Car].fHasTray ||
+           MOT[MMAuto4_Car].fHasTray || MOT[MMAuto5_Car].fHasTray || MOT[MMAuto6_Car].fHasTray ||
+           HasICUnderMachine();
+}
+void W906_BootAskClearMachine9050()
+{
+    if(s_W906BootClearAsked)
+        return;
+    if(W906_ShowMyMessageBoxYesNo_Hook == 0)                                    // no browser to ask yet (boot sequence, ctests)
+        return;
+    s_W906BootClearAsked = true;
+    extern AnsiString W906_GpibModel;
+    if(!(W906_GpibModel == "9050GPIB" || MachineTypeChoice == Type_HT9050))
+        return;
+    if(SystemStart || !W906_MachineHasMaterial9050())
+        return;
+    const AnsiString where = sHasICUnderMachine();
+    RecordProcess(AnsiString("W906 boot: the machine model restored from machinerecord.dat has material (TrayY ") +
+                  (MOT[MMTrayY].fHasTray ? "tray" : "-") + ") " + where + " -- asking whether to clear");
+    const int r = ShowMyMessageBox_YES_NO("機台上有上次留下的料／盤資料，是否清除？ Yes＝清除，No＝保留並繼續 "
+                                          "(The machine still holds the last run's tray / IC data. Clear it? Yes = clear, No = keep)",
+                                          "機台有料，是否清除？");
+    if(r == 3)                                                                  // another box is open: ask on a later pass
+    {
+        s_W906BootClearAsked = false;
+        return;
+    }
+    if(r != 1)
+    {
+        RecordProcess("W906 boot: machine data kept (No)");
+        return;
+    }
+    InitialMachine();
+    iLoaderLayerCount_9050 = -1;
+    iEmptyLayerCount_9050  = -1;
+    iAuto1LayerCount_9050  = 0;
+    iAuto2LayerCount_9050  = 0;
+    iAuto3LayerCount_9050  = 0;
+    SaveMachineRecord();
+    RecordProcess("W906 boot: machine data cleared (Yes) -- InitialMachine + HT9050 stack counts + SaveMachineRecord");
+}
