+// ===========================================================================
+//  [BC] AI(W906-BOOTCLEAR9050) 20261008: EastSun 1008「每次開啟若是機台有料的話跳出是否要清除的畫面 … Yes則清除 … No則繼續」
+//       (cinitial.cpp EOF, called from csystem.cpp DoAllProcess). Answers come from a fake YES / NO hook.
+// ===========================================================================
+void W906_BootAskClearMachine9050(); void W906_BootAskClearMachineReset();
+static int s_bcAnswer = 0, s_bcAsked = 0;
+static int BcFakeYesNo(const char*, const char*, const char*) { ++s_bcAsked; return s_bcAnswer; }
+void TrayBootClearAsk()
+{
+    printf("[BC] boot: machine has material -> Yes clears / No keeps, asked once, only with a browser, HT9050 only\n");
+    extern AnsiString W906_GpibModel;
+    const AnsiString savedModel = W906_GpibModel;
+    int (*savedHook)(const char*, const char*, const char*) = W906_ShowMyMessageBoxYesNo_Hook;
+    W906_GpibModel = "9050GPIB";
+
+    // no browser yet (boot sequence): nothing asked, and it is NOT used up
+    W906_BootAskClearMachineReset(); W906_ShowMyMessageBoxYesNo_Hook = 0; s_bcAsked = 0;
+    MOT[MMTrayY].fHasTray = true; iLoaderLayerCount_9050 = 3; iAuto1LayerCount_9050 = 2;
+    W906_BootAskClearMachine9050();
+    CHECK(s_bcAsked == 0 && MOT[MMTrayY].fHasTray, "before the YES / NO hook exists nothing is asked or cleared");
+
+    // No = keep, and it is asked only once
+    W906_ShowMyMessageBoxYesNo_Hook = &BcFakeYesNo; s_bcAnswer = 2;
+    W906_BootAskClearMachine9050();
+    CHECK(s_bcAsked == 1 && MOT[MMTrayY].fHasTray && iLoaderLayerCount_9050 == 3 && iAuto1LayerCount_9050 == 2,
+          "No: asked once, Tray Y tray and the stack counts kept");
+    W906_BootAskClearMachine9050();
+    CHECK(s_bcAsked == 1, "the next pass does not ask again");
+
+    // a box already open (3): asked again on a later pass
+    W906_BootAskClearMachineReset(); s_bcAsked = 0; s_bcAnswer = 3;
+    W906_BootAskClearMachine9050();
+    s_bcAnswer = 1;
+    W906_BootAskClearMachine9050();
+    CHECK(s_bcAsked == 2, "answer 3 (another box open) -> asked again on the next pass");
+    CHECK(MOT[MMTrayY].fHasTray == false && iLoaderLayerCount_9050 == -1 && iEmptyLayerCount_9050 == -1 &&
+          iAuto1LayerCount_9050 == 0 && iAuto2LayerCount_9050 == 0 && iAuto3LayerCount_9050 == 0 &&
+          MOT[MMAuto1].fHasTray == false,
+          "Yes: InitialMachine (Tray Y / Auto trays gone) + Loader / Empty -1 (re-probe) + Auto counts 0");
+
+    // nothing on the machine -> no box
+    W906_BootAskClearMachineReset(); s_bcAsked = 0;
+    W906_BootAskClearMachine9050();
+    CHECK(s_bcAsked == 0, "after the clear the machine is empty: no box");
+
+    // other machines: golden, never asked
+    W906_BootAskClearMachineReset(); s_bcAsked = 0; MOT[MMTrayY].fHasTray = true; W906_GpibModel = "";
+    const int savedMt = MachineTypeChoice; if (MachineTypeChoice == Type_HT9050) MachineTypeChoice = 0;
+    W906_BootAskClearMachine9050();
+    CHECK(s_bcAsked == 0 && MOT[MMTrayY].fHasTray, "not HT9050: no box, nothing cleared");
+    MachineTypeChoice = savedMt;
+
+    MOT[MMTrayY].fHasTray = false; iLoaderLayerCount_9050 = -1; iEmptyLayerCount_9050 = -1;
+    W906_ShowMyMessageBoxYesNo_Hook = savedHook; W906_GpibModel = savedModel; W906_BootAskClearMachineReset();
 }
