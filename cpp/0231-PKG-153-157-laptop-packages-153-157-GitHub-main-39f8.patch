+//  P7 (Steven 1004 07:5x 「io 馬達的裝置有異常error的時候，機台就不可以動」): E-042's decision W906_IndexZDriveFault
+//  (ALM / ERROR_STOP / servo off / 3 invalid samples / poll frozen 2 s / route-latched failure / no health hook), the same
+//  "ST" first as E-042's W906_IndexZDriveFaultStop, with a message that names the production Index flow (E-042's says
+//  "Auto Height stopped").  true -> the caller takes its exit in the same tick.
+static bool g_fpP7Shown = false;
+//  P7 class-level part: golden's own Index alarm rule (ScanIndexMotorCanMove, myGALILmotor.cpp: Led[iAlarmLed] && Enable &&
+//  PServoAlarmOn) on the motor object's own scan -- Gali_ScanAlarmStatus ("TI") for Galil-API Index axes, TMyMotor::ScanMotorStatus
+//  (alarm + servo-on lamp) for any other HTMotor class.  Works for a DMC card, the Galil route, EtherCAT or MotionNet axes alike.
+static bool FP9050ClassFault(AnsiString* why)
+{
+    TMyMotor& z = MOT[MTestZ1];
+    if(z.Motor==NULL || z.Motor->Enable==false) return false;          // no axis object / Mot_Table Enable 0: golden simulates it
+    if(FP9050IndexOnGalilApi()) z.Gali_ScanAlarmStatus(); else z.ScanMotorStatus();
+    if((z.Led[iAlarmLed] || z.Led[iServoalarmLed]) && z.Motor->PServoAlarmOn)
+    {
+        if(why) *why = z.Alias + " alarm (motor object Led[iAlarmLed] / Led[iServoalarmLed])";
+        return true;
+    }
+    if(!FP9050IndexOnGalilApi() && z.Led[iServoOn]==false)
+    {
+        if(why) *why = z.Alias + " servo is OFF (motor object Led[iServoOn])";
+        return true;
+    }
+    return false;
+}
+bool W906_FP9050DriveFaultStop(const char* where)
+{
+    AnsiString why;
+    if(!FP9050ProtectLive()) return false;
+    const bool fault = FP9050ClassFault(&why) || W906_IndexZDriveFault(&why);   // class level first; then E-042's 1203 health (reused as is)
+    if(!fault) { g_fpP7Shown = false; return false; }
+    MOT[MTestZ1].Gali_Command("ST", "W906_FP9050DriveFaultStop");      // golden's own stop string; never gated
+    if(!g_fpP7Shown)
+    {
+        g_fpP7Shown = true;
+        std::printf("[fp9050] P7 %s: Index Z1 drive error -> ST + exit: %s\n", where ? where : "", why.c_str());
+        std::fflush(stdout);
+        ShowMyMessage("Index Z1 drive error -- Index (FinePitch) stopped: " + why,
+                      "Index Z1 驅動器異常 -- Index (FinePitch) 已停止: " + why, where ? where : "W906_FP9050DriveFaultStop");
+    }
+    return true;
+}
