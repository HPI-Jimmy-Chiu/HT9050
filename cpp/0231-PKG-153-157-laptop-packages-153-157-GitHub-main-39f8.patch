+//  W-44 (Steven 1005 23:1x, relayed by ST01-M / ST01-E 23:2x): 「Out shuttle 可能在執行5s的動作，所以應該是有個安全的x座標，在安全位置之外,
+//  index就可以下壓到socket」(「5s是 ccd的五面檢查」 = the CCD five-side inspection) -- Index Z1 may press to the SOCKET while each shuttle's
+//  X is OUTSIDE the index's safe zone; NOT "both shuttles at origin" (the 1004 wording, E-042's W906_IndexZShuttlesAtHome, no longer
+//  used here). The decision is Frank's guard (FR-NB2 (2), RULINGS_20261005 #19); it does not exist yet, so this file only CALLS it
+//  through W906_Ht9050ShuttlesClearOfIndexHook. Hook missing in a SHIP build = NOT clear (fail-safe: refuse / stop).
+bool (*W906_Ht9050ShuttlesClearOfIndexHook)(AnsiString* why) = 0;
+bool W906_FP9050ShuttlesClearOfIndex(AnsiString* why)
+{
+    if(why) *why = "";
+    if(!FP9050ProtectLive()) return true;                              // SOFT_SIMULTE: 910, no check
+    if(W906_Ht9050ShuttlesClearOfIndexHook == 0)
+    {
+        if(why) *why = "W-44: no shuttle safe-zone guard installed (Frank FR-NB2 (2) not in this build) -- Index Z1 may not press (fail-safe)";
+        return false;
+    }
+    return W906_Ht9050ShuttlesClearOfIndexHook(why);
+}
+
+//  W-44 entry (beside 910's own DoTestYFrontFP case-130 gate): refuse, send nothing.
+bool W906_FP9050ShuttlesClearRefused(const char* where)
+{
+    AnsiString why;
+    if(W906_FP9050ShuttlesClearOfIndex(&why)) return false;
+    std::printf("[fp9050] W-44 %s: press refused: %s\n", where ? where : "", why.c_str());
+    std::fflush(stdout);
+    ShowMyMessage("Index Z press refused (FinePitch): " + why, "Index Z 不能下壓 (FinePitch): " + why,
+                  where ? where : "W906_FP9050ShuttlesClearRefused");
+    return true;
+}
+
+//  W-44 per tick on the press / hold tasks (IndexZFinePitchCore.h W44PressTaskFP): a shuttle inside the index's safe zone (or no
+//  guard) while Z1 presses / is held at the socket -> "ST" Z1 + message once, true -> the caller takes its exit.
+static bool g_fpW44Shown[ht9045::fp9050::kSmCount] = { false, false };
+bool W906_FP9050ShuttleClearStop(int sm, int task, const char* where)
+{
+    if(sm < 0 || sm >= ht9045::fp9050::kSmCount) return false;
+    if(!FP9050ProtectLive()) return false;
+    if(!ht9045::fp9050::W44PressTaskFP(sm, task)) { g_fpW44Shown[sm] = false; return false; }   // not a press tick: the next trip shows again
+    AnsiString why;
+    if(W906_FP9050ShuttlesClearOfIndex(&why)) { g_fpW44Shown[sm] = false; return false; }
+    MOT[MTestZ1].Gali_Command("ST", "W906_FP9050ShuttleClearStop");    // golden's own stop string; never gated
+    if(!g_fpW44Shown[sm])
+    {
+        g_fpW44Shown[sm] = true;
+        std::printf("[fp9050] W-44 %s task %d: %s -> ST + exit\n", where ? where : "", task, why.c_str());
+        std::fflush(stdout);
+        ShowMyMessage("Index Z press stopped (FinePitch): " + why, "Index Z 下壓已停止 (FinePitch): " + why,
+                      where ? where : "W906_FP9050ShuttleClearStop");
+    }
+    return true;
+}
+
+//  Q4b (plan F2): 910's CCD-Y interlock in MoveIndexZ refuses silently; after kCcdYHoldMs one message, nothing moves.
+static ht9045::fp9050::CcdYHold g_fpCcdY;
+static unsigned long FP9050NowMs() { return W906_IndexZNowMsHook ? W906_IndexZNowMsHook() : (unsigned long)::GetTickCount(); }
+void W906_FP9050CcdYHeld(int iPos)
+{
+    if(!FP9050ProtectLive()) return;
+    if(!ht9045::fp9050::CcdYHoldStep(g_fpCcdY, FP9050NowMs())) return;
+    const AnsiString why = "target " + AnsiString(iPos) + " is below All_TestZ_Test_Safe " + AnsiString(Prod.All_TestZ_Test_Safe) +
+                           " and CCD Y (M108) reads " + AnsiString(MOT[MCCDY].ReadPos()) +
+                           (MOT[MCCDY].Led[iHomeLed] ? AnsiString(" (home LED on)") : AnsiString(" (home LED off)"));
+    std::printf("[fp9050] Q4b MoveIndexZ held 5 s by the CCD-Y interlock (910 Motor/mymotor.cpp:6631): %s\n", why.c_str());
+    std::fflush(stdout);
+    ShowMyMessage("Index Z1 descent is waiting for CCD Y (M108) at 0 with its home LED on: " + why,
+                  "Index Z1 等待 CCD Y (M108) 回到 0 且原點燈亮才會下降: " + why, "MoveIndexZ");
+}
+void W906_FP9050CcdYHeldReset() { ht9045::fp9050::CcdYHoldReset(g_fpCcdY); }
+void W906_FP9050Reset()
+{
+    g_fpW44Shown[0] = g_fpW44Shown[1] = false;
+    g_fpP7Shown = false;
+    ht9045::fp9050::CcdYHoldReset(g_fpCcdY);
+    W906_FP9050LeafCount = 0;
+}
