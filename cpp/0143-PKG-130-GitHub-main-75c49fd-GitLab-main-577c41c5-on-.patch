+    std::vector<std::string> live = LiveLines(text);
+    std::size_t i = 0;
+    bool on = false;
+    while (std::getline(in, l)) {
+        if (!l.empty() && l.back() == '\r') l.pop_back();
+        if (!on && l == head) { on = true; ++i; continue; }
+        if (on) {
+            if (l == "}") break;
+            if (i < live.size()) out += live[i] + "\n";
+        }
+        ++i;
+    }
+    return out;
+}
