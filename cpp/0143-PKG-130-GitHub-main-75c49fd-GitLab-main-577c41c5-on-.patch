+// whole number in [-1e6, 1e6]
+bool E022_Whole(const cJSON *v, int *out)
+{
+    if (!v || !cJSON_IsNumber(v)) return false;
+    const double d = v->valuedouble;
+    if (d != std::floor(d) || d < -1e6 || d > 1e6) return false;
+    *out = (int)d;
+    return true;
+}
