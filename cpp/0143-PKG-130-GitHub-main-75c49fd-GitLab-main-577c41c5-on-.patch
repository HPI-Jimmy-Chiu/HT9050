+      if ((m = /^\[([\w-]+)="([^"]*)"\]$/.exec(s))) return n.attrs[m[1]] === m[2];
+      if ((m = /^\[([\w-]+)\]$/.exec(s))) return Object.prototype.hasOwnProperty.call(n.attrs, m[1]);
