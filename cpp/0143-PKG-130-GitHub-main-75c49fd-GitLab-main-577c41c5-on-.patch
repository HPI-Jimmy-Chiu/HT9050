+// ---- 假的 DOM（只做這支 js 在按鈕這條路上用到的）
+function makeEl(id, tag) {
+  const attrs = {};
+  const listeners = {};
+  return {
+    id, tagName: tag, nodeType: 1, disabled: false, title: '', style: {}, parentElement: null, children: [],
