+//  and the SOFT_SIMULTE-only PickFromHPList->SaveFile calls in ainarm_SearchPickPlate.cpp (SIM build only).
+//------------------------------------------------------------------------------
+AnsiString W906_MachineRecordRedirect(const AnsiString& goldenPath)
+{
+    const char* dir=getenv("W906_MACHINERECORD_DIR");
+    if(dir==NULL || dir[0]=='\0')
+        return goldenPath;                                                      // production: golden literal
+    const std::string g(goldenPath.c_str());
+    const std::string::size_type k=g.find_last_of("\\/");
+    const std::string base=(k==std::string::npos) ? g : g.substr(k+1);
+    return AnsiString((std::string(dir)+"\\"+base).c_str());
+}
+unsigned W906_MachineRecordSize()                                               // sizeof(struct MachineRecord), for the ctest and the size report
+{
+    return (unsigned)sizeof(struct MachineRecord);
+}
