+//AI(W906-MT-E3b) 20260925: PORT-ONLY cross-tick form of DoMotorPowerOn() above (golden csystem.cpp:19102-19126).
+//  Lead default 20260925: the Motor Power button's 1 s power-on wait runs as a cross-tick job -- same outputs,
+//  same 1 s, but the single tick thread is not frozen (golden freezes its UI thread for that second; here the
+//  same thread also runs the 1203 Poll, the output-first queue and motor.stop).
+//  Semantics, statement for statement against the golden loop:
+//    Begin() = `MotorPowerOnDelay.SetSecAndOn(1);` + the FIRST loop body.
+//    Step()  = golden's `if(MotorPowerOnDelay.Off()) break;` (returns true = break, the 1 s is over),
+//              otherwise the next loop body -- so the order body,check,body,check... is golden's.
+//  The loop body is golden's, copied (not shared with DoMotorPowerOn, so DoMotorPowerOn stays verbatim for its
+//  two golden callers): relay not on (OutPortData cache) -> relay On + the three brake holds.
+//  SOFT_SIMULTE: golden only switches the relay on and returns -> Begin() does that, Step() returns true.
+//  The caller does what golden does AFTER DoMotorPowerOn returns (btnMotorPowerClick: SW[SwServerON].On()
+//  and the caption) only once Step() has returned true.
+static TQPF_Timer W906_MotorPowerOnJobDelay;
+static void W906_DoMotorPowerOnIteration()
+{
+    #ifndef SOFT_SIMULTE
+    if(!SW[SwMotorRelay].Status())                                              //Steven 20100225
+    {
+        SW[SwMotorRelay].On();
+        IndexMotorBreakerOFF();
+        MagazineBreakerOFF();                                                   //JerryYang 20220909 : add magazine
+        CassetteBreakerOFF();                                                   //Ifor 20251216 add:Boat Carrier
+    }
+    #endif
+}
+void W906_DoMotorPowerOnBegin()
+{
+    #ifdef SOFT_SIMULTE
+        SW[SwMotorRelay].On();
+    #else
+        W906_MotorPowerOnJobDelay.SetSecAndOn(1);
+        W906_DoMotorPowerOnIteration();
+    #endif
+}
+bool W906_DoMotorPowerOnStep()
+{
+    #ifdef SOFT_SIMULTE
+        return true;
+    #else
+        if(W906_MotorPowerOnJobDelay.Off())
+            return true;                                                        // golden `break`
+        W906_DoMotorPowerOnIteration();
+        return false;
+    #endif
+}
