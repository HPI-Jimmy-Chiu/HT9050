+# --- AI(W906-T1-PILOT) 20261006 (Ifor01; W-131, MainNB-GPT MAINNB-T1 docs/handoff/MAINNB_T1_TEST_EXE_GROUPING_20261006.md s4.1) ---------
+#   Test executable bundles.  F-Secure holds every freshly linked exe for tens of seconds the first time it is opened (the gate
+#   relinks ~380 of them), so several low-coupling tests share ONE exe.  Each CTest still starts its own process -- the shared exe
+#   only picks the test with its first argument `--w906-entry=<name>` (consumed; the rest of argv is handed on unchanged) -- so test
+#   names, arguments, TIMEOUT, ENVIRONMENT etc. stay exactly as they were.  Each member .cpp is still its own translation unit; its
+#   `main` is renamed to w906_entry_<name> by a per-source definition (only on those sources).  An unknown or missing entry exits
+#   2 (never 0 / 77).  OFF = the old one-exe-per-test layout, for an A/B comparison or a rollback.
+option(W906_TEST_BUNDLES "Link the T1 pilot tests into shared dispatcher executables" ON)
+function(w906_test_bundle bundle)
+    # usage: w906_test_bundle(<exe> ENTRIES <name>=<source.cpp>... [EXTRA <sources>...] [LINK <libs>...])
+    cmake_parse_arguments(B "" "" "ENTRIES;EXTRA;LINK" ${ARGN})
+    set(_decl "")
+    set(_rows "")
+    set(_srcs "")
+    foreach(_e IN LISTS B_ENTRIES)
+        string(REPLACE "=" ";" _kv "${_e}")
+        list(GET _kv 0 _name)
+        list(GET _kv 1 _src)
+        string(APPEND _decl "int w906_entry_${_name}();\n")
+        string(APPEND _rows "    { \"${_name}\", &w906_entry_${_name} },\n")
+        list(APPEND _srcs ${_src})
+        set_source_files_properties(${_src} PROPERTIES COMPILE_DEFINITIONS "main=w906_entry_${_name}")
+    endforeach()
+    set(_gen "${CMAKE_CURRENT_BINARY_DIR}/${bundle}_dispatch.cpp")
+    file(WRITE "${_gen}.in"
+"// generated by tests/CMakeLists.txt w906_test_bundle() -- AI(W906-T1-PILOT); do not edit\n\
+#include <cstdio>\n#include <cstring>\n${_decl}\
+struct W906Entry { const char* name; int (*fn)(); };\n\
+static const W906Entry kEntries[] = {\n${_rows}};\n\
+int main(int argc, char** argv)\n{\n\
+    const char* kPre = \"--w906-entry=\";\n\
+    if (argc < 2 || std::strncmp(argv[1], kPre, std::strlen(kPre)) != 0) {\n\
+        std::fprintf(stderr, \"${bundle}: first argument must be --w906-entry=<name>; entries:\");\n\
+        for (const W906Entry& e : kEntries) std::fprintf(stderr, \" %s\", e.name);\n\
+        std::fprintf(stderr, \"\\n\");\n\
+        return 2;\n    }\n\
+    const char* want = argv[1] + std::strlen(kPre);\n\
+    for (const W906Entry& e : kEntries)\n\
+        if (std::strcmp(e.name, want) == 0) {\n\
+            for (int i = 1; i + 1 < argc; ++i) argv[i] = argv[i + 1];   // hand the remaining arguments on unchanged\n\
+            argv[argc - 1] = 0;\n\
+            (void)argc;\n\
+            return e.fn();\n\
+        }\n\
+    std::fprintf(stderr, \"${bundle}: unknown entry '%s'\\n\", want);\n\
+    return 2;\n}\n")
+    configure_file("${_gen}.in" "${_gen}" COPYONLY)
+    add_executable(${bundle} "${_gen}" ${_srcs} ${B_EXTRA})
+    if(B_LINK)
+        target_link_libraries(${bundle} PRIVATE ${B_LINK})
+    endif()
+endfunction()
