diff --git a/EtherCAT/Pci1203Monitor.cpp b/EtherCAT/Pci1203Monitor.cpp
index dcf1ce2..cc19845 100644
--- a/EtherCAT/Pci1203Monitor.cpp
+++ b/EtherCAT/Pci1203Monitor.cpp
@@ -4683,3 +4683,22 @@ unsigned long W906_Pci1203IoHeartAgeMs()
     const long d = (long)(::GetTickCount() - at);
     return d > 0 ? (unsigned long)d : 0ul;
 }
+//AI(W906-1203REOPEN) 20261007: after Acm_MasResetRing (issued by Pci1203Control kCmdRingReset -- this READ-ONLY module makes no
+//  vendor write): the drives / IO modules on the reset ring came back through INIT..OP, their axis handles are stale. Close the
+//  axis handles, re-scan the slaves and re-open the axes on the SAME device handle (no Acm_DevClose / Acm_DevOpen), then publish
+//  at once like Rescan() does. Refused inside Poll() (same wall as Rescan) or when the card is not open (the caller then falls
+//  back to the whole-card Rescan()).
+namespace ht9045 {
+bool TPci1203Monitor::RescanRing(std::string& why)
+{
+    why.clear();
+    if (!impl_) { why = "monitor not constructed"; return false; }
+    if (impl_->inPoll) { why = "refused: RescanRing() called from inside Poll()"; return false; }
+    if (!Open_()) { why = "the card is not open -- use the whole-card Rescan()"; return false; }
+    CloseAxes_();
+    ScanSlaves_();
+    OpenAxes_();
+    if (Pci1203OnIoThread()) W906IoStage_(impl_->ioStaged, impl_->ioPub, impl_->cardS, impl_->axes, impl_->dis, impl_->dos, impl_->slaves, impl_->opened, impl_->disabled, impl_->disabledWhy);
+    return true;
+}
+}  // namespace ht9045
