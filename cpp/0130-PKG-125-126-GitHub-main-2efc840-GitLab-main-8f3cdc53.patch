+    for (std::size_t i = 0; i < s.size(); ++i) {
+        if (s[i] == '\r') continue;
+        if (s[i] == '\n') { v.push_back(cur); cur.clear(); continue; }
+        cur += s[i];
+    }
+    if (!cur.empty()) v.push_back(cur);
+    return v;
