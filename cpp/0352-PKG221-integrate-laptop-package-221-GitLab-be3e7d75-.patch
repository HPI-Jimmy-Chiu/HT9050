+static char g_got[900];
+#define GOT(...) std::snprintf(g_got, sizeof(g_got), __VA_ARGS__)
+#define CHECK(cond, msg)                                                                                   \
+    do {                                                                                                   \
+        if (cond) { printf("  PASS: %s   [%s]\n", msg, g_got); ++g_pass; }                                 \
+        else      { printf("  FAIL: %s   [got %s]  (line %d)\n", msg, g_got, __LINE__); ++g_fail; }        \
