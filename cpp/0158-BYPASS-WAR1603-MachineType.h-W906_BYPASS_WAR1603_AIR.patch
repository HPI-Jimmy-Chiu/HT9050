From a44759b5a29d9865153ebe1785266427167e2f9c Mon Sep 17 00:00:00 2001
From: "HT9045 Machine (V906)" <Claude_RDBC_02@honprec.com>
Date: Sat, 3 Oct 2026 17:00:51 +0800
Subject: [PATCH] BYPASS-WAR1603: MachineType.h W906_BYPASS_WAR1603_AIR
 (defined = ON, temporary) skips golden DoSystem's 'Air not enough' arm
 (Sen[SnAirIsEnough].IsOff() -> StopAllMotor + WAR1603 K_RETRY +
 SystemStart=false); the rest of the chain (WAR16446 / WAR1610 ...) runs as
 golden; comment the define out to re-enable -- EastSun 1003 'pass WAR1603 for
 now, record it, it must be enabled later'; verified: csystem.cpp.obj no
 longer contains WAR1603, still contains WAR16446

---
 MachineType.h | 14 ++++++++++++++
 csystem.cpp   |  2 +-
 2 files changed, 15 insertions(+), 1 deletion(-)

diff --git a/MachineType.h b/MachineType.h
index d5554cd..4bb5c20 100644
--- a/MachineType.h
+++ b/MachineType.h
@@ -1861,4 +1861,18 @@ inline void vec_clr(vector<T> & v)
 //  Only the heater has a switch; the bin panel (30 ms) and GM-2 (30 ms) jobs are always on the fast clock (FastClockWbServe.cpp).
 #define W906_FASTCLK_HEATER
 //------------------------------------------------------------------------------
+//AI(W906-BYPASS-WAR1603) 20261003: EastSun 20261003「WAR1603 先幫我PASS 掉 並且記錄起來 之後要開啟」.
+//  WAR1603 = "Air not enough." -- golden DoSystem (csystem.cpp, the `else if(Sen[SnAirIsEnough].IsOff())` arm after CheckIonFan):
+//  StopAllMotor + ShowErrorMessage("WAR1603", K_RETRY) + SystemStart=false, every DoSystem pass while the main-air sensor reads OFF.
+//  ON (defined)            = that arm is skipped; the next checks of the same chain (WAR16446 chamber dry air, WAR1610 dry air ...)
+//                            still run as golden.
+//  OFF (comment the line)  = golden: the air check stops the machine again.
+//  ⚠ TEMPORARY: the main air supply is NOT supervised while this is on.  Open it again (comment the line out and rebuild) as soon as
+//    the air sensor / supply is fixed -- recorded in docs/WORKLOG_MACHINE.md (open items).
+#define W906_BYPASS_WAR1603_AIR
+#ifdef W906_BYPASS_WAR1603_AIR
+#define W906_War1603Armed() false
+#else
+#define W906_War1603Armed() true
+#endif
 #endif
diff --git a/csystem.cpp b/csystem.cpp
index cce8c10..616fbfa 100644
--- a/csystem.cpp
+++ b/csystem.cpp
@@ -16650,7 +16650,7 @@ void DoSystem()
                 StopAllMotor();
                 fMain->Pause("DoSystem ION Fan");
             }
-            else if(Sen[SnAirIsEnough].IsOff())
+            else if(Sen[SnAirIsEnough].IsOff() && W906_War1603Armed())   //AI(W906-BYPASS-WAR1603) 20261003: EastSun「WAR1603 先幫我PASS 掉 之後要開啟」-- MachineType.h W906_BYPASS_WAR1603_AIR (defined = this arm skipped, the chain goes on); golden: else if(Sen[SnAirIsEnough].IsOff())
             {
                 StopAllMotor();
                 ShowErrorMessage("WAR1603", K_RETRY, MMSystem);
-- 
