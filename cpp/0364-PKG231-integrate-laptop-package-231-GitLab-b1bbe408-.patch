+// AI(W906-W195) 20261009 (St02-E) TESNA T1: golden 913 MyStringList.cpp:410-431 (RogerYang 20260707, AI(ht9045-config)), the
+//   by-day duplicate of a "Per month" event log (iO15_SaveFilePeriod 8 -> TByMonth main file <Path>\YYYY\<FN>_YYYYMM.csv) for
+//   TfObserver::StatisticalJamCount, which reads only <Path>\YYYY\MM\<FN>_YYYYMMDD.csv.  Called from MySaveToFileShareMode (:654) when
+//   bDupYMDFile && !HTSaveFixedFile, after the main write and before MyList->Clear() -- golden's position.  Golden 913 :412-430 below,
+//   verbatim; the 0618 -> 912 change (912 == 913 byte for byte).
+//   [W906] D7 (Steven 20261009, RULINGS_20261009 #11 "每月跟每天不影響，各存一行"): when the duplicate is the main file itself (N10
+//   daily upload + period 8: SaveType TByDay while bDupYMDFile is still true), golden writes every block twice into that file; here
+//   it is skipped, so each file gets each row once.  The 913 quirk is reported to RogerYang (TO_ROGER, laptop 20:0x).
+void TMyStringList::W906_SaveDupYMDFile()
+{
+        AnsiString sDupPath, sDupFile, sDupStr;
+        sDupPath.sprintf("%s\\%04d\\%02d", HTPath, SystemYear, SystemMonth);         //年\月 資料夾
+        MyForceDirectories(sDupPath, "TMyStringList::DupYMD");
+        //按天分割(TByDay命名): FileName_YYYYMMDD.csv, 與StatisticalJamCount/fObserver讀取路徑一致
+        sDupFile.sprintf("%s\\%s_%04d%02d%02d.csv", sDupPath, HTFileName, SystemYear, SystemMonth, SystemDate);
+        if(sDupFile.LowerCase()==sLastFileName.LowerCase())                     //[W906] D7 (above): the main file already has this block
+            return;
+
+        if(FileExists(sDupFile)==false && HTFirstRow!="")
+            sDupStr = HTFirstRow + "\r\n" + MyList->Text;
+        else
+            sDupStr = MyList->Text;
+
+        HANDLE hDup = CreateFile(sDupFile.c_str(), GENERIC_WRITE, FILE_SHARE_READ, NULL, OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+        if(hDup != INVALID_HANDLE_VALUE)
+        {
+            SetFilePointer(hDup, 0, NULL, FILE_END);
+            DWORD dwDup;
+            WriteFile(hDup, sDupStr.c_str(), sDupStr.Length(), &dwDup, NULL);
+            CloseHandle(hDup);
+        }
+}
