+// =============================================================================
+//  AI(W906-EXIT-ORDER) 20261003: EastSun 「為啥我按exit 好像都沒有全部正常關完?」-- review: the HMI window closed before the shutdown
+//  finished, nothing ended a hung shutdown, and the oplog never said whether it completed.  golden FormClose ends with a 10 s taskkill
+//  batch (main.cpp:11936-11950); here a watchdog thread starts when the main loop breaks and ends the process if the shutdown is not done
+//  in 15 s (written to stdout + oplog first).  ExitProcess releases the card handle like any process end.
+// =============================================================================
+static DWORD WINAPI W906_ExitWatchdogThread(LPVOID)
+{
+    ::Sleep(15000);
+    std::printf("[EXIT] shutdown not finished within 15 s -> ExitProcess(3) (golden FormClose: taskkill after 10 s, main.cpp:11936-11950)\n");
+    std::fflush(stdout);
+    OpLine("EXIT", "關站 15 秒還沒結束 -> 強制結束程式（原版 10 秒後 taskkill） / shutdown watchdog fired -> ExitProcess(3)");
+    ::ExitProcess(3);
+    return 0;
+}
+void W906_ExitWatchdogStart()
+{
+    OpLine("EXIT", "主迴圈結束，開始關站（15 秒內沒收完會強制結束） / shutdown begins");
+    HANDLE h = ::CreateThread(0, 0, &W906_ExitWatchdogThread, 0, 0, 0);
+    if (h) ::CloseHandle(h);
+}
+void W906_ExitDoneLog()
+{
+    OpLine("EXIT", "關站完成：伺服器、TesterComm、1203 卡都已關閉，最後才關 HMI 視窗 / shutdown complete");
+}
