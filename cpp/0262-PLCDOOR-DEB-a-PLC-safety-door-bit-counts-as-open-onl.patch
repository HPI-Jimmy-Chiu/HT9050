     printf("\n-------------------------------------------------------------\n");
     printf(" RESULT: %d passed, %d failed\n", g_pass, g_fail);
@@ -431,7 +431,7 @@ static void m1s_feed(unsigned char in1, unsigned char in2)
 void test_m1s_alldoors()
 {
     printf("\n[5] SafePlcModel=1: all-doors-closed input (Port 310 / Bit 0) made from the PLC doors of the IO table\n");
-    iSafePlcModel = 1;
+    iSafePlcModel = 1;  extern int g_w906PlcDoorOpenMs; g_w906PlcDoorOpenMs = 0;   // AI(W906-PLCDOOR-DEB) 20261007: this block tests the MAPPING frame by frame -> no 0.5 s hold here ([8] tests the hold); same line
     for (int i = 0; i < MAX_SAFE_DOOR_CNT; ++i) Sen[iSafeDoor[i]].ISABase = 0;
 
     m1s_feed(0x15, 0x55);
@@ -465,7 +465,7 @@ void test_m1s_alldoors()
     CHECK(bPLCInData[0][17][0] == false, "a PLC door outside the 16 Input status bytes counts as open");
 
     for (int i = 0; i < MAX_SAFE_DOOR_CNT; ++i) Sen[iSafeDoor[i]].ISABase = 0;
-    iSafePlcModel = 0;
+    iSafePlcModel = 0;  g_w906PlcDoorOpenMs = 500;   // AI(W906-PLCDOOR-DEB) 20261007: back to the production value; same line
 }
 
 // ===========================================================================
@@ -545,3 +545,40 @@ void test_plc_link_lost()
     iSafePlcModel = 0;
     Enable_PLCSafety_IO = savedPlc;
 }
+// ===========================================================================
+//  [8] AI(W906-PLCDOOR-DEB) 20261007: EastSun「你開安全門 有偵測連續開0.5秒才異常嗎? 不然訊號可能會瞬間閃爍」-- a PLC door bit counts
+//      as open only after 0.5 s open on every frame (W906_PlcM1SDoorDebounce, MyPLC_IO_Modbus.cpp EOF). Driven through the REAL
+//      PLCIOTaskCycle -> W906_PlcM1SFill path (m1s_feed), real time. Door 3 = Port 301 / Bit 4 = Input byte 1 bit 4 = bPLCInData[0][2][4].
+// ===========================================================================
+void test_plc_door_debounce()
+{
+    printf("\n[8] PLC door open must last 0.5 s before it counts (flicker filter); closing counts at once; Port 310 follows\n");
+    extern int g_w906PlcDoorOpenMs;
+    iSafePlcModel = 1;  g_w906PlcDoorOpenMs = 500;
+    const int sn[7]   = { SnSafeDoor1, SnSafeDoor2, SnSafeDoor3, SnSafeDoor4, SnSafeDoor5, SnSafeDoor6, SnSafeDoor7 };
+    const int port[7] = { 0x301, 0x302, 0x301, 0x302, 0x302, 0x301, 0x302 };
+    const int bit[7]  = { 0, 6, 4, 0, 2, 2, 4 };
+    for (int i = 0; i < 7; ++i) { Sen[sn[i]].ISABase = ePLCbase; Sen[sn[i]].Port = port[i]; Sen[sn[i]].Bit = bit[i]; }
+    const unsigned char closed1 = 0x15, open3 = 0x05;      // Input byte 1 with door 3 (bit 4) closed / open
+    m1s_feed(closed1, 0x55);
+    CHECK(bPLCInData[0][2][4] == true && bPLCInData[0][17][0] == true, "all doors closed: door 3 = 1, Port 310 = 1");
+    m1s_feed(open3, 0x55);
+    CHECK(bPLCInData[0][2][4] == true && bPLCInData[0][17][0] == true, "door 3 reads open for one frame: still closed (held)");
+    std::this_thread::sleep_for(std::chrono::milliseconds(250));
+    m1s_feed(open3, 0x55);
+    CHECK(bPLCInData[0][2][4] == true, "open for ~250 ms: still held");
+    m1s_feed(closed1, 0x55);
+    CHECK(bPLCInData[0][2][4] == true, "back to closed (a flicker): closed, the open timer is cleared");
+    m1s_feed(open3, 0x55);
+    std::this_thread::sleep_for(std::chrono::milliseconds(300));
+    m1s_feed(open3, 0x55);
+    CHECK(bPLCInData[0][2][4] == true && bPLCInData[0][17][0] == true, "open again, 300 ms since the restart (550 ms since the first open): still held -- the timer restarted");
+    std::this_thread::sleep_for(std::chrono::milliseconds(300));
+    m1s_feed(open3, 0x55);
+    CHECK(bPLCInData[0][2][4] == false && bPLCInData[0][17][0] == false, "open on every frame for 600 ms: door 3 = 0 and Port 310 = 0 (MES1613 / WAR16125 can fire)");
+    m1s_feed(closed1, 0x55);
+    CHECK(bPLCInData[0][2][4] == true && bPLCInData[0][17][0] == true, "closed: counts at once (no delay on closing)");
+    CHECK(bPLCInData[0][1][0] == true, "EMG (Port 300 / Bit 0, not a door) is passed straight through");
+    for (int i = 0; i < MAX_SAFE_DOOR_CNT; ++i) Sen[iSafeDoor[i]].ISABase = 0;
+    iSafePlcModel = 0;
+}
