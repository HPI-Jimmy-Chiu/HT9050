@@ -421,7 +421,7 @@ static void W906_PlcM1SFill(int slave, const VTBYTEDATA& data)
         InPortData_Byte[slave][1+n]=m[2+n];                                     // Input status byte n
     InPortData_Byte[slave][20]=m[30];                                           // OSSD status byte 0
     InPortData_Byte[slave][21]=m[31];                                           // OSSD status byte 1
-    W906_PlcM1SAllDoors(slave);                                                 // AI(W906-PLCDOOR) 20261006: byte 17 bit 0 = all PLC safety doors closed (end of file)
+    void W906_PlcM1SDoorDebounce(int); W906_PlcM1SDoorDebounce(slave);  W906_PlcM1SAllDoors(slave);   // AI(W906-PLCDOOR-DEB) 20261007: EastSun「有偵測連續開0.5秒才異常嗎? 不然訊號可能會瞬間閃爍」-- a PLC door bit counts as open only after 0.5 s open in a row (end of file), before the all-doors bit is made; same line.  AI(W906-PLCDOOR) 20261006: byte 17 bit 0 = all PLC safety doors closed (end of file)
 }
 //------------------------------------------------------------------------------
 //AI(W906-PLCDOOR) 20261006: EastSun 1006「門警報不用看其他地方 看PLC通訊就好 請把IO_TABLE 做修正 寫出對應rear PLC的設定 並且功能要齊全」.
@@ -481,3 +481,39 @@ bool W906_SafePlcLinkLost()
         return false;
     return !PlcComm.IsConnected() || s_w906PlcMisses >= kW906PlcLostMisses;
 }
+//------------------------------------------------------------------------------
+//AI(W906-PLCDOOR-DEB) 20261007: EastSun 1007「你開安全門 有偵測連續開0.5秒才異常嗎? 不然訊號可能會瞬間閃爍」-- after MES1613 (door 3)
+//  came at 09:32:02 while the PLC read door 3 closed before and after. Runs on every model-1 frame (W906_PlcM1SFill), so the time is
+//  measured where the data arrives, not in CheckSafeDoorIsClosed (that one is also called ONCE by START / a manual move / the tray
+//  clamp -- a delay there would let a door that is really open pass such a one-shot check).
+//      door bit 1 (closed) -> passes at once, its open timer is cleared
+//      door bit 0 (open)   -> held at 1 until it has read 0 on every frame for g_w906PlcDoorOpenMs (500 ms), then passes as 0
+//  Only the door bits of golden's iSafeDoor[] list that the IO table puts on the PLC (ISABase 4) -- the same set W906_PlcM1SAllDoors
+//  uses, which runs right after on the held bits, so Port 310 (WAR16125) gets the same 0.5 s. EMG (Port 300) and every other bit are
+//  untouched (an E-stop is never delayed). The safety PLC's own door / OSSD reaction is hardware and not affected by this.
+int g_w906PlcDoorOpenMs = 500;
+void W906_PlcM1SDoorDebounce(int slave)
+{
+    static DWORD s_openSince[INPUT_MAX_Slave][17][8] = {};                     // 0 = not open; index j = 1..16 (Input byte j-1)
+    if(slave<0 || slave>=INPUT_MAX_Slave)
+        return;
+    DWORD now=::GetTickCount();  if(now==0) now=1;
+    for(int i=0; i<MAX_SAFE_DOOR_CNT; i++)
+    {
+        const int s=iSafeDoor[i];
+        if(s<0 || s>=MAX_SENSOR_ITEM || Sen[s].ISABase!=ePLCbase)
+            continue;
+        const int j=Sen[s].Port-PLCIO_INPUT_START_PORT_NUMBER+1, b=Sen[s].Bit;
+        if(j<1 || j>16 || b<0 || b>7)
+            continue;                                                           // W906_PlcM1SAllDoors counts it as open, unchanged
+        if(InPortData_Byte[slave][j] & MyBitMask[b])
+            s_openSince[slave][j][b]=0;
+        else
+        {
+            if(s_openSince[slave][j][b]==0)
+                s_openSince[slave][j][b]=now;
+            if((long)(now-s_openSince[slave][j][b]) < (long)g_w906PlcDoorOpenMs)
+                InPortData_Byte[slave][j]|=MyBitMask[b];                        // not open long enough yet: still "closed"
+        }
+    }
+}
