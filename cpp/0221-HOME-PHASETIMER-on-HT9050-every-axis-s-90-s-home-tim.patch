diff --git a/uhome.cpp b/uhome.cpp
index 92d3164..d6bd17c 100644
--- a/uhome.cpp
+++ b/uhome.cpp
@@ -748,6 +748,23 @@ static int        s_W906Home1300Loops = 0;   //AI(W906-HOME-AUDIT1005) 20261005:
 //AI(W906-HOME-AUDIT1005) 20261005: EastSun「你檢查一下全機回HOME 還有沒有BUG」-> 「一律 180 秒」: the HT9050 HOME steps that wait for a home or a
 //  move with no timeout of their own (golden: step 375 / 600's first unfinished axis restarts its 90 s ResetTime on every tick, Pci1203 route
 //  HOMING / not READY answers busy for ever; steps 700 / 710 / 1250 / 1520 / 1540 have no timer). Held 180 s = HOME stops and names what waits.
+//AI(W906-HOME-PHASETIMER) 20261005: EastSun「為什麼剛剛回home 已經回完了 還是叫異常?」→「修」-- 14:23:35 MCCDY MotorHome returned 2
+//  (home timeout, origin LED 1, servo 1, no alarm): every axis's 90 s ResetTime is armed once at step 300 (MotorInitial), and golden passes
+//  Flag=true (re-arm) only to the first unfinished axis of each tick, so a THREE_HOME axis like MCCDY started its home 91 s after step 300
+//  (the SECOND_HOME Z axes took ~74 s) and failed on its first check. HT9050: each axis gets Flag=true on its FIRST MotorHome call of its
+//  own home phase (FIRST / SECOND / THREE_HOME), i.e. its own 90 s from when its home really starts; later calls get golden's flag1.
+//  A stuck axis still times out 90 s after its own start (plus the 180 s step watchdog). Other machines: golden flag1.
+static std::vector<char> s_W906HomeArmed;
+static int               s_W906HomeArmedTask = -1;
+static void W906_HomeArmReset() { s_W906HomeArmedTask = -1; }
+static bool W906_HomeArmFlag(int i, bool flag1)
+{
+    if(!W906_IsHT9050()) return flag1;
+    if(MotorTask != s_W906HomeArmedTask) { s_W906HomeArmed.assign(TOTAL_MOTOR, 0); s_W906HomeArmedTask = MotorTask; }
+    if(i < 0 || i >= (int)s_W906HomeArmed.size() || s_W906HomeArmed[i]) return flag1;
+    s_W906HomeArmed[i] = 1;
+    return true;
+}
 static bool W906_HomeWatchdogStep(int s) { return s==375 || s==600 || s==700 || s==710 || s==1250 || s==1520 || s==1540; }
 static std::string W906_HomeWaitingAxes(int step, const bool* f)   // f = flag1..flag6
 {
@@ -2310,6 +2327,7 @@ bool ProcessMotorHome(bool Flag2)
             { extern std::string g_W906MotorErrorReason; g_W906MotorErrorReason.clear(); }   //AI(W906-ALARM-WHY) 20261003 (review): no stale reason from an earlier failure
             fAllMotorHome=false;                                                //AI(W906-HOME-READYDONE) 20261003: EastSun「按下全機回home 就是所有軸都還沒有回home的狀態」-- the machine is not homed from here (every MOT[].HomeFlag=0 below); golden left fAllMotorHome as it was until the end
             s_W906Home1300Loops=0;                                              //AI(W906-HOME-AUDIT1005) 20261005
+            W906_HomeArmReset();                                                //AI(W906-HOME-PHASETIMER) 20261005: a new HOME -- every axis re-arms on its first call of its phase
             if(W906_IsHT9050())                                                 //AI(W906-HOME-AUDIT1005) 20261005: EastSun「要，回原點就重設」-- a dry run paused mid-cycle
             {                                                                   //  (e.g. step 12 / 22 In Arm Z down, 102 Out Arm Z down) must not resume there after the axes went home:
                 extern void W906_Ht9050DryRunReset();                           //  START after this HOME begins the dry run at its step 10. The dry run itself is unchanged.
@@ -2849,7 +2867,7 @@ bool ProcessMotorHome(bool Flag2)
                                 }
                                 else
                                 {
-                                    ret=MOT[i].MotorHome(flag1);
+                                    ret=MOT[i].MotorHome(W906_HomeArmFlag(i, flag1));   //AI(W906-HOME-PHASETIMER) 20261005
                                 }
                             }
                             else
@@ -2859,7 +2877,7 @@ bool ProcessMotorHome(bool Flag2)
                         }
                         else
                         {
-                            ret=MOT[i].MotorHome(flag1);
+                            ret=MOT[i].MotorHome(W906_HomeArmFlag(i, flag1));   //AI(W906-HOME-PHASETIMER) 20261005
                         }
                     }
 
@@ -3253,7 +3271,7 @@ bool ProcessMotorHome(bool Flag2)
                     }
                     else
                     {
-                        ret=MOT[i].MotorHome(flag1);
+                        ret=MOT[i].MotorHome(W906_HomeArmFlag(i, flag1));   //AI(W906-HOME-PHASETIMER) 20261005
                     }
 
                     if(i==MLoaderY)                                             //RogerYang 20251105 : 修正撞機問題
