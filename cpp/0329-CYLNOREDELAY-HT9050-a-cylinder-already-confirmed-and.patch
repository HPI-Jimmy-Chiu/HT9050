@@ -895,3 +895,25 @@ int W906_CylinderRowsShown()
 //  0 = nothing (ctests, other machines' builds without the bridge). The hook itself decides HT9050 and whether "<name>Off" exists.
 void (*g_W906PairedCoilHook)(const AnsiString&, bool) = 0;
 //---------------------------------------------------------------------------
+//AI(W906-CYLNOREDELAY) 20261008: EastSun 1008「目前的狀況是等待太久，若同一個判斷式導致每次呼叫都要等待確認的時間，有什麼辦法可以解決」
+//  -> B (AskUserQuestion: change the cylinder, HT9050 only). golden Push / Pop end with Task=1 after their on / off delay, so the
+//  next call -- every scan of a step like `A.Pop() && B.Pop() && C_Empty_Up.Push()` -- serves the whole delay again although
+//  nothing moved: measured 1008 MEmptyZ, 78 stop -> next move gaps, min 1015 ms / median 1594 ms (C_Empty_Up OnDelayTime 10).
+//  Here a Push / Pop that completed marks the cylinder "confirmed on / off"; the opposite command (OnSwitch / OffSwitch, i.e.
+//  On / Push / Off / Pop) clears the other mark. While marked, a Push / Pop returns true at once -- only when the cylinder HAS
+//  that sensor and it still reads in position (a cylinder that drifted or lost air takes golden's path: wait, alarm); a
+//  cylinder without the sensor keeps golden's delay (nothing proves it is still there). Only Cylinder[] members (an index,
+//  no class layout change -- mycylin.h is in ~every object); g_W906CylNoReDelayHook = 0 (other machines, ctests) = golden.
+bool (*g_W906CylNoReDelayHook)() = 0;
+static unsigned char s_w906CylOk[MaxCylinderItem];                              // bit 0 = confirmed on (Push), bit 1 = confirmed off (Pop)
+static int W906_CylIdx(const TMyCylinder* c) { const int i = (int)(c - &Cylinder[0]); return (i >= 0 && i < MaxCylinderItem) ? i : -1; }
+void W906_CylMark(const TMyCylinder* c, bool on)   { const int i = W906_CylIdx(c); if (i >= 0) s_w906CylOk[i] = (unsigned char)(s_w906CylOk[i] | (on ? 1 : 2)); }
+void W906_CylUnmark(const TMyCylinder* c, bool on) { const int i = W906_CylIdx(c); if (i >= 0) s_w906CylOk[i] = (unsigned char)(s_w906CylOk[i] & ~(on ? 1 : 2)); }
+bool W906_CylConfirmed(TMyCylinder* c, bool on)
+{
+    if (!g_W906CylNoReDelayHook || !g_W906CylNoReDelayHook()) return false;
+    const int i = W906_CylIdx(c);
+    if (i < 0 || !c->Enable || !(s_w906CylOk[i] & (on ? 1 : 2))) return false;
+    return on ? (c->OnSenEnable && c->OnStatus()) : (c->OffSenEnable && c->OffStatus());
+}
