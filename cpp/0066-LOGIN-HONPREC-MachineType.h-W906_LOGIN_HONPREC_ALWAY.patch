From 7eb2008ea1823d1d8ffce4156ea382d4d1a00483 Mon Sep 17 00:00:00 2001
From: "HT9045 Machine (V906)" <Claude_RDBC_02@honprec.com>
Date: Thu, 1 Oct 2026 19:55:16 +0800
Subject: [PATCH] LOGIN-HONPREC: MachineType.h W906_LOGIN_HONPREC_ALWAYS -- the
 shipping build logs in as HonPrec at boot and A01 does not drop it (on-site
 test)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

EastSun 20261001 (on-site testing): "我現在是現場測試 請幫我權限 一開始直接調成 最高". After every wb_serve restart the level was
Operator(0), so Tools / Teach pages were refused on open (oplog editlist.get not-authorized), and this machine's config.ini has A01
on (bAutoSwitchToOperatorMode=1, iChangeOpTime=180: back to Operator after 3 min idle).
New switch at the end of MachineType.h, ON: WebLogin_Boot takes golden FormShow's SOFT_SIMULTE / DEBUG arm (main.cpp:11062-11069,
HonPrec at boot, btLogin Logout / caption HonPrec), and FileRW/Main_A01AutoLogout.cpp StepCount resets the idle count every tick
as golden's SOFT_SIMULTE arm does (golden :26026-26028) -- no A01 idle logout. Manual logout / user switch and customer-specific
forced logouts are unchanged. OFF (comment the line) = golden shipping behaviour. Must be commented out before hand-over.
tests/test_d015_a01_autologout.cpp: the switch follows the SIM expectations (count reset, never logs out); its source check
follows the new #if line. ctest D015_A01AutoLogout passes; no test calls WebLogin_Boot. The user's own MachineType.h
SOFT_SIMULTE line is not in this commit.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 FileRW/Main_A01AutoLogout.cpp      |  2 +-
 MachineType.h                      |  8 ++++++++
 WebLogin.cpp                       |  4 ++--
 tests/test_d015_a01_autologout.cpp | 12 ++++++------
 4 files changed, 17 insertions(+), 9 deletions(-)

diff --git a/FileRW/Main_A01AutoLogout.cpp b/FileRW/Main_A01AutoLogout.cpp
index cc59a93..f005475 100644
--- a/FileRW/Main_A01AutoLogout.cpp
+++ b/FileRW/Main_A01AutoLogout.cpp
@@ -174,7 +174,7 @@ bool StepCount()
     {
         iOperatorModeCount++;
 
-        #ifdef SOFT_SIMULTE
+        #if defined(SOFT_SIMULTE) || defined(W906_LOGIN_HONPREC_ALWAYS)   //AI(W906-LOGIN-HONPREC) 20261001: + MachineType.h W906_LOGIN_HONPREC_ALWAYS（EastSun 現場測試）——golden 模擬組態的作法：閒置計數每拍歸零，A01 不自動登出
         iOperatorModeCount=0;
         #endif
 
diff --git a/MachineType.h b/MachineType.h
index 1bc1f20..db559e3 100644
--- a/MachineType.h
+++ b/MachineType.h
@@ -1806,4 +1806,12 @@ inline void vec_clr(vector<T> & v)
 //  關（註解掉）= 完全回到今天：開機不建面板、不對應、不登記閘門（面板在頁面第一次打開時才建，用 golden 建構子的位址表）。
 #define W906_VC8_SUCKER_REMAP
 //------------------------------------------------------------------------------
+//AI(W906-LOGIN-HONPREC) 20261001: 登入等級。EastSun 20261001（現場測試）：「我現在是現場測試 請幫我權限 一開始直接調成 最高」。
+//  開 = 出貨組態開機就登入 HonPrec（最高權限），跟 SOFT_SIMULTE／DEBUG 組態一樣（WebLogin.cpp 開機那一段，golden FormShow
+//       main.cpp:11062-11069 的模擬分支）；而且 A01「閒置自動切回 Operator」不會把它降下來（FileRW/Main_A01AutoLogout.cpp StepCount，
+//       照 golden SOFT_SIMULTE 的作法每一拍把計數歸零）。自己按登出／切換使用者、客戶專屬的強制登出照 golden。
+//  關（註解掉）= golden 出貨組態：開機 Operator（沒有密碼本時），要登入才有 Engineer 以上。
+//  ⚠ 現場測試用：交機給客戶前一定要註解掉。
+#define W906_LOGIN_HONPREC_ALWAYS
+//------------------------------------------------------------------------------
 #endif
diff --git a/WebLogin.cpp b/WebLogin.cpp
index 401fdfb..e2d7aac 100644
--- a/WebLogin.cpp
+++ b/WebLogin.cpp
@@ -115,12 +115,12 @@ void WebLogin_Boot()
     }
 
     // golden FormShow main.cpp:11062-11069：模擬／除錯組態預設 HonPrec（使用者 20260924「debug 模式，預設就是登入 HonPrec 權限」）
-#if defined(SOFT_SIMULTE) || defined(DEBUG)
+#if defined(SOFT_SIMULTE) || defined(DEBUG) || defined(W906_LOGIN_HONPREC_ALWAYS)   //AI(W906-LOGIN-HONPREC) 20261001: + MachineType.h W906_LOGIN_HONPREC_ALWAYS（EastSun 現場測試「權限 一開始直接調成 最高」）
     AccessLevel=iDefHonPrecLevel;
     s_itemIndex=3;
     fMain->cbUserSelect->Text="HonPrec";
     ChangeLevelAttr();
-    #ifdef SOFT_SIMULTE
+    #if defined(SOFT_SIMULTE) || defined(W906_LOGIN_HONPREC_ALWAYS)
     // golden :10869-10872（密碼本模式時 btLogin 顯示 Logout、spbUserName 顯示 HonPrec）
     s_btLoginIsLogout=WebLogin_UsesBook();
     s_userCaption="HonPrec";
diff --git a/tests/test_d015_a01_autologout.cpp b/tests/test_d015_a01_autologout.cpp
index 683e1f0..856729f 100644
--- a/tests/test_d015_a01_autologout.cpp
+++ b/tests/test_d015_a01_autologout.cpp
@@ -254,7 +254,7 @@ void SetEnv(const char* kv) { HT9045_TEST_PUTENV(kv); }   // Windows：putenv("K
 int main(int argc, char** argv)
 {
     std::printf("test_d015_a01_autologout -- golden [A01] idle logout (V912 main.cpp:25957-26096, cOffSet.cpp:2811); build: %s\n",
-#ifdef SOFT_SIMULTE
+#if defined(SOFT_SIMULTE) || defined(W906_LOGIN_HONPREC_ALWAYS)   // AI(W906-LOGIN-HONPREC) 20261001: MachineType.h W906_LOGIN_HONPREC_ALWAYS = the SIM rule (count reset every tick, never logs out)
                 "SIM (SOFT_SIMULTE defined)"
 #else
                 "SHIPPING (SOFT_SIMULTE undefined)"
@@ -343,7 +343,7 @@ int main(int argc, char** argv)
     Check(W906_A01OperatorModeCount() == 0 && g_logouts == 0, "[3] A01 on, AccessLevel 0 -> 0, no logout");
 
     std::printf("[4] count and logout (golden :26022-26072)\n");
-#ifdef SOFT_SIMULTE
+#if defined(SOFT_SIMULTE) || defined(W906_LOGIN_HONPREC_ALWAYS)   // AI(W906-LOGIN-HONPREC) 20261001
     {
         Baseline();
         IniConfig.iA01ChangeOpTime = 10;
@@ -504,7 +504,7 @@ int main(int argc, char** argv)
         Check(cm.find("    FileRW/Main_A01AutoLogout.cpp\n") != std::string::npos && integ.find("\nMain_A01AutoLogout\n") != std::string::npos,
               "[8] FileRW/_editlist_sources.cmake lists the file; tools/editlist/_integrated.txt has the name");
         Check(CodeCount(me, "iOperatorModeCount=0;") >= 1 &&
-              me.find("        #ifdef SOFT_SIMULTE\n        iOperatorModeCount=0;\n        #endif\n") != std::string::npos,
+              me.find("        #if defined(SOFT_SIMULTE) || defined(W906_LOGIN_HONPREC_ALWAYS)") != std::string::npos && me.find("\n        iOperatorModeCount=0;\n        #endif\n") != std::string::npos,   // AI(W906-LOGIN-HONPREC) 20261001
               "[8] Main_A01AutoLogout.cpp keeps golden :26026-26028 (#ifdef SOFT_SIMULTE iOperatorModeCount=0)");
 
         // AI(W906-D015-A01b) 20260930：阻塞框的等待迴圈（Jimmy 20260930：golden VCL Timer3 在 ShowModal 裡照跑）
@@ -602,7 +602,7 @@ int main(int argc, char** argv)
         bool held = true;
         for (int s = 1; s <= 30; ++s) {
             W906_A01RunStepsForTest(7);
-#ifdef SOFT_SIMULTE
+#if defined(SOFT_SIMULTE) || defined(W906_LOGIN_HONPREC_ALWAYS)   // AI(W906-LOGIN-HONPREC) 20261001
             if (W906_A01OperatorModeCount() != 0) held = false;
 #else
             if (W906_A01OperatorModeCount() != 1) held = false;      // 第 1 段歸 0、第 2 段 +1
@@ -614,7 +614,7 @@ int main(int argc, char** argv)
         W906_A01SetCountsForTest(0, 0);
         int at = 0;
         for (int s = 1; s <= 20 && at == 0; ++s) { W906_A01RunStepsForTest(7); if (g_logouts == 1) at = s; }
-#ifdef SOFT_SIMULTE
+#if defined(SOFT_SIMULTE) || defined(W906_LOGIN_HONPREC_ALWAYS)   // AI(W906-LOGIN-HONPREC) 20261001
         Check(at == 0 && g_logouts == 0, "[9] SIM: menu closed -> still never logs out (#ifdef SOFT_SIMULTE)");
 #else
         Check(at == 15, "[9] SHIP: menu closed -> the count climbs again, logout at second 15 (got " + Num(at) + ")");
@@ -627,7 +627,7 @@ int main(int argc, char** argv)
         g_open.insert("fMain");
         MenuOp("{\"setup\":true,\"config\":true}");
         for (int s = 1; s <= 10; ++s) W906_A01RunStepsForTest(7);
-#ifdef SOFT_SIMULTE
+#if defined(SOFT_SIMULTE) || defined(W906_LOGIN_HONPREC_ALWAYS)   // AI(W906-LOGIN-HONPREC) 20261001
         Check(g_logouts == 0 && W906_A01MenuStateForTest() == 3, "[9] SIM: SJ + both menus open, 10 s -> no logout, flags kept");
 #else
         Check(g_logouts == 1 && AccessLevel == 0 && W906_A01MenuStateForTest() == 0,
