diff --git a/WebMotorAccessLive.cpp b/WebMotorAccessLive.cpp
index 2344a03..d3b55be 100644
--- a/WebMotorAccessLive.cpp
+++ b/WebMotorAccessLive.cpp
@@ -192,7 +192,7 @@ bool BrakeReleaseAxisIfReady(const std::string& alias, const char* group)
     const int sw = BrakeSwOf(alias);
     if (sw < 0 || SW[sw].OutValue) return false;                                // no brake output here / already released
     if (!BrakeAxisOnLongEnough(alias)) return false;
-    if (GEM_EMGPressed || Sen[SnMotorPower].IsOff()) return false;
+    if (GEM_EMGPressed || Sen[SnMotorPower].IsOff() || !(bMotorPowerState && MotorPowerOnDelay == 0)) return false;   //AI(W906-BRAKE-BOOT) 20261003: + golden's motor power condition (see BrakeAxisTick)
     SW[sw].On();
     g_brakeAxis[alias].released = true;
     BrakeLog(alias + " SVON 0.5 s -> " + SW[sw].Name.c_str() + " ON (brake released per axis; golden group " + (group ? group : "?") +
@@ -211,7 +211,13 @@ void BrakeAxisTick()
     //  waited for nothing. The drive reporting SVON is the proof of power; what is left is EMG / SnMotorPower off (EastSun 20260926).
     //  EMG is read from GEM_EMGPressed, the flag golden IsEMGPressed() leaves on every DoSystem pass (csystem.cpp): calling
     //  IsEMGPressed() here would repeat its servo-off / brake sweep and consume its release edge.
-    const bool emg = GEM_EMGPressed, powerOff = Sen[SnMotorPower].IsOff();
+    //AI(W906-BRAKE-BOOT) 20261003: EastSun「照BCB裡面方法修改」(laptop NB2-1 R200 / U17, dispatch 6 (B)): at start-up the 8 Z brakes were
+    //  released on a STALE SVON (the 1203's SVON does not drop with the motor power: 11 power-offs on 10-03, svo never fell) BEFORE the
+    //  motor relay was on, then DoMotorPowerOn held them and they were released again ~4 s later -- the "excited then released" EastSun saw.
+    //  golden releases the brakes only with the motor power up and its delay over (ckernel.cpp:2910 / :2976 `bMotorPowerState &&
+    //  MotorPowerOnDelay==0`); the 0929 reason for dropping it (G31a needed ~100 passes) expired with 0930 G31A-TIME. Same condition here.
+    const bool goldenPower = bMotorPowerState && MotorPowerOnDelay == 0;
+    const bool emg = GEM_EMGPressed, powerOff = Sen[SnMotorPower].IsOff() || !goldenPower;
     const bool powerOk = !emg && !powerOff;
     for (std::size_t i = 0; i < sizeof(kBrakeAxes) / sizeof(kBrakeAxes[0]); ++i) {
         const std::string alias = kBrakeAxes[i].alias;
@@ -226,7 +232,7 @@ void BrakeAxisTick()
             if (!st.on) { st.on = true; st.onSince = now; st.released = false; st.waitLogged = false; }
             if (sw < 0 || st.released || (now - st.onSince) < kBrakeReleaseDelayMs || BrakeBlocked(st, now)) continue;
             if (!powerOk) {
-                if (!st.waitLogged) { st.waitLogged = true; BrakeLog(alias + " SVON 0.5 s, " + SW[sw].Name.c_str() + " NOT released yet: " + (emg ? "EMG pressed" : "SnMotorPower off") + " -- released as soon as it clears"); }
+                if (!st.waitLogged) { st.waitLogged = true; BrakeLog(alias + " SVON 0.5 s, " + SW[sw].Name.c_str() + " NOT released yet: " + (emg ? "EMG pressed" : (!goldenPower ? "motor power not up yet (golden bMotorPowerState / MotorPowerOnDelay)" : "SnMotorPower off")) + " -- released as soon as it clears"); }
                 continue;
             }
             st.released = true;
@@ -1591,7 +1597,13 @@ bool W906_MotorAccessArmCellBlocked(const char* what, std::string& why)
 //  log (BRAKE line channel). Called from W906_BrakeAxisTick (after every monitor Poll). Only MLoaderZ for now; add aliases here.
 void W906_BootInitMotorTick()
 {
-    static const char* const kBootInitAxes[] = { "MLoaderZ" };
+    //AI(W906-BOOT-SERVOALL) 20261003: EastSun「照BCB裡面方法修改」(laptop NB2-1 R200 (1)): golden's boot InitMotor runs for EVERY EtherCAT axis
+    //  (SetServoOn(true) each) -- not only MLoaderZ. All HT9050 1203 rows of Mot_Table; a row that is not an enabled, opened PCI1203 axis is
+    //  skipped with the reason logged (unchanged). MTestZ1 stays out: Galil-routed Index Z, golden servos it ON through the Galil path
+    //  (uhome case 5 "SH"), not EtherCAT InitMotor.
+    static const char* const kBootInitAxes[] = { "MLoaderZ", "MInArmX", "MInArmY", "MInArmZA", "MInShuttle1", "MOutShuttle1", "MOutShuttle2",
+                                                 "MOutArmX", "MOutArmY", "MOutArmZA", "MTrayX", "MEmptyZ", "MAuto1Z", "MAuto2Z", "MAuto3Z",
+                                                 "MInRotate", "MOutRotate", "MCCDY" };
     const std::size_t n = sizeof(kBootInitAxes) / sizeof(kBootInitAxes[0]);
     static bool done[sizeof(kBootInitAxes) / sizeof(kBootInitAxes[0])] = {};
     static DWORD powerSince = 0;
diff --git a/uhome.cpp b/uhome.cpp
index e3d915c..34c1b70 100644
--- a/uhome.cpp
+++ b/uhome.cpp
@@ -2312,9 +2312,22 @@ bool ProcessMotorHome(bool Flag2)
             //  SVON / alarm check below runs. Power not back within 20 s = HOME stops with the reason in the op log.
             {
                 const bool pwr = SW[SwMotorRelay].Status() && (Sen[SnMotorPower].Enable==false || Sen[SnMotorPower].IsOn());
+                if(!pwr && s_W906HomePowerOk)                                   //AI(W906-HOME-POWERDROP) 20261003: EastSun「照BCB裡面方法修改」(laptop St01 M-a):
+                {                                                               //  the power had been stable and dropped (EMG / door / safety loop) -- golden never
+                    W906_HomeNote("STOP: the motor power dropped after it had been stable (EMG / door / safety loop?) -- no automatic re-energise (golden)");   //  re-energises by itself: stop like golden's EMG flow
+                    { extern std::string g_W906MotorErrorReason; g_W906MotorErrorReason.clear(); }
+                    fHome->ListBox1->Items->Insert(0, "Motor power dropped during HOME -- HOME stopped");
+                    StopAllMotor();
+                    SystemStart=false;
+                    ShowMyMessage("Motor power dropped during HOME!", "回原點中馬達電源中斷，已停止回原點！", "ProcessMotorHome");
+                    fHome->fAbort=false;
+                    fHome->iHomeStep=1;
+                    SoftStop=true;
+                    return true;
+                }
                 if(!pwr)
                 {
-                    if(s_W906HomePowerOk || s_W906HomePowerOffTicks==0)
+                    if(s_W906HomePowerOffTicks==0)
                         W906_HomeNote(std::string("waiting for the motor power: SwMotorRelay=") + (SW[SwMotorRelay].Status() ? "1" : "0") +
                                       " SnMotorPower=" + (Sen[SnMotorPower].Enable ? (Sen[SnMotorPower].IsOn() ? "1" : "0") : "n/a"));
                     s_W906HomePowerOk=false;
@@ -2383,7 +2396,7 @@ bool ProcessMotorHome(bool Flag2)
                 //  1->0 and came back 0->1 at 18:36:57 (DoMotorPowerOn, case 1), so a single check at 0.5 s saw every drive unexcited and
                 //  stopped HOME with "Motor not home yet". Now: re-send Alarm Reset + Servo ON to the abnormal axes every 1 s and only
                 //  after 20 retries (~20 s) count them abnormal.
-                if(iBad>=0 && s_W906HomeResetTries<20)
+                if(iBad>=0 && s_W906HomeResetTries<1)   //AI(W906-HOME-1RETRY) 20261003: EASTSUN「照BCB裡面方法修改」(laptop St01 M-b): golden resets once (InitMotor) -- one more Alarm Reset + Servo ON after 1 s, then HOME stops (was 20 x 1 s)
                 {
                     ++s_W906HomeResetTries;
                     for(int i=0; i<TOTAL_MOTOR; i++)
@@ -2397,10 +2410,10 @@ bool ProcessMotorHome(bool Flag2)
                             fHome->ShowLed(i, 3);                               //  back to "in progress" while it is retried
                         }
                     }
-                    if(s_W906HomeResetTries==1 || s_W906HomeResetTries%5==0)
+                    if(true)
                     {
                         fHome->ListBox1->Items->Insert(0, AnsiString(("Waiting for alarm reset / servo on: " + sBad).c_str()));
-                        W906_HomeNote("retry " + std::to_string(s_W906HomeResetTries) + "/20 alarm reset + servo on: " + sBad);   //AI(W906-HOME-ALMRESET-3) 20261003: which axis, in the op log
+                        W906_HomeNote("retry " + std::to_string(s_W906HomeResetTries) + "/1 alarm reset + servo on: " + sBad);   //AI(W906-HOME-ALMRESET-3) 20261003: which axis, in the op log
                     }
                     s_W906HomeResetWait.SetMSAndOn(1000);
                     break;
