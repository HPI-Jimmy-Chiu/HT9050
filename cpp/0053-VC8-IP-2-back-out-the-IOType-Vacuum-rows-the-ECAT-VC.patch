-//  BTestSuck* 80 / 81). A row in the table's own format (EastSun 20261001「要照表照格式 照架構 轉成IP 160」)
-//      IOType,Alias,Lane,ModuleType,IP,Port,Bit,InType,ISABase,Enable
-//      Vacuum,InArm,1,2,160,0,0,1,3,1          Alias InArm|OutArm|Index|Index2|Index3|Index4; IP decimal (160 = 0xA0)
-//  moves the module golden has at 0x20 / 0x30 / 0x40 / 0x41 / 0x50 / 0x51 (ring 1) to that ring (Lane) / station (IP).
-//  database.cpp W906_ApplyVacuumStations() (end of LoadIoData) fills this table and moves every Sucker / Sucker_On /
-//  Sucker_Off row of IO_Table.csv on the old station, BEFORE InitSucker binds them -- so the engine's suckers, the
-//  IO page, golden's SetIOTableByECAT_VC8_Sucker copy, the sucker gate and the Vacuum Unit page all use the new
-//  station; TMyVacuumPanel's ctor asks W906_Vc8StationMap for the panels' own numbers. Only on HT9050 (general.ini
-//  [Version] Model=9050GPIB); elsewhere the table stays empty and golden's numbers stand. The identity check
-//  (EtherCAT/Pci1203Vc8.h) still decides whether anything is read or written there.
-// ---------------------------------------------------------------------------
-struct TVc8Station {
-    int         goldenIp;      // golden's station on ring 1
-    const char* alias;         // the IO_Table.csv Alias of its IOType=Vacuum row (case-insensitive)
-    bool        set;           // a valid row moved it
-    int         ring, ip;      // where it is now
-};
-inline TVc8Station* W906_Vc8Stations_(int* n)
-{
-    static TVc8Station s[] = {
-        { 0x20, "InArm",  false, 0, 0 },    // golden MyVacuumPanel.cpp iKind 2
-        { 0x30, "OutArm", false, 0, 0 },    //   iKind 3
-        { 0x40, "Index",  false, 0, 0 },    //   iKind 0 cols 0..3 (Aa-Ad / Ba-Bd), iKind 4
-        { 0x41, "Index2", false, 0, 0 },    //   iKind 0 cols 4..7
-        { 0x50, "Index3", false, 0, 0 },    //   iKind 1 cols 0..3, iKind 5
-        { 0x51, "Index4", false, 0, 0 },    //   iKind 1 cols 4..7
-    };
-    if (n) *n = (int)(sizeof(s) / sizeof(s[0]));
-    return s;
-}
-inline void W906_Vc8StationsClear()
-{
-    int n = 0;
-    TVc8Station* s = W906_Vc8Stations_(&n);
-    for (int i = 0; i < n; ++i) { s[i].set = false; s[i].ring = 0; s[i].ip = 0; }
-}
-// The slot of an IOType=Vacuum row's Alias, -1 if it names no module.
-inline int W906_Vc8StationSlot(const char* alias)
-{
-    int n = 0;
-    const TVc8Station* s = W906_Vc8Stations_(&n);
-    for (int i = 0; alias && i < n; ++i) {
-        int k = 0;
-        for (;; ++k) {
-            char a = alias[k], b = s[i].alias[k];
-            if (a >= 'a' && a <= 'z') a = (char)(a - 'a' + 'A');
-            if (b >= 'a' && b <= 'z') b = (char)(b - 'a' + 'A');
-            if (a != b) break;
-            if (a == '\0') return i;
-        }
-    }
-    return -1;
-}
-// golden's (ring, station) -> where that module is now. false = not moved (golden's number stands).
-inline bool W906_Vc8StationMap(int goldenRing, int goldenIp, int* ring, int* ip)
-{
-    int n = 0;
-    const TVc8Station* s = W906_Vc8Stations_(&n);
-    for (int i = 0; goldenRing == 1 && i < n; ++i) {
-        if (!s[i].set || s[i].goldenIp != goldenIp) continue;
-        if (ring) *ring = s[i].ring;
-        if (ip)   *ip   = s[i].ip;
-        return true;
-    }
-    return false;
-}
-
 #endif  // VACUUMUNIT_VC8ROUTE_H
