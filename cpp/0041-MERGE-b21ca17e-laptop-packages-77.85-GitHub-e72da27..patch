+static DWORD WINAPI ProbeFaultFor(LPVOID)
+{
+    std::string t;
+    Pci1203GaliRouteFaultFor(14, 0, t);                    // must wait for the route's lock
+    ::InterlockedExchange(&g_probeDone, 1);
