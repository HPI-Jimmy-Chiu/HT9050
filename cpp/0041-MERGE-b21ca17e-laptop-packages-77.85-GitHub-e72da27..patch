+    if (bMouseDown) {
+        if (X < 0 || X >= mtLoaderBuffer.xItem || Y < 0 || Y >= mtLoaderBuffer.yItem) return;   // :325-326
+        iEndX = X;
+        iEndY = Y;
+        ShowTray();                                                              // :329
+    }
+}
