+            {"fCleaning",       true,  "fCleaning->ShowModal() main.cpp:29674"},
+        };
+        const std::size_t n = sizeof(k) / sizeof(k[0]);
+        CHECK(n == 14 && evb10a::kRowCount == 5 + n, "B10c adds 14 rows after the 5 B10a rows");
