+void TGaliRouteCore::HomeFail(const std::string& why)
+{
+    homeActive_ = false;
+    if (haltHome_) { halted_ = false; haltHome_ = false; }
+    LatchMotionFailure("home: " + why);
+    Poison("home:" + why, "home failed: " + why);
+}
