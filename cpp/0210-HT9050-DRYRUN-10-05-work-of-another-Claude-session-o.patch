+#ifndef W906_HT9050_DRYRUN_Z1_HOME_TOL
+#define W906_HT9050_DRYRUN_Z1_HOME_TOL 20
+#endif
+bool W906_Ht9050IndexZ1AtHome()
+{
+    if(W906_ShtAxisOff(MTestZ1)) return true;
+    return MOT[MTestZ1].HomeFlag==1 && MOT[MTestZ1].Motor->MotionDone() && abs(MOT[MTestZ1].ReadEncoderPos())<=W906_HT9050_DRYRUN_Z1_HOME_TOL;
+}
+// Out Shuttle 2 to its Left (Tech.iOutShuttle2Left = Prod.OutSHT[1].iLeft, cinitial.cpp:6225) = the safe point for Out Shuttle 1
+// going in / out of the Index area. true = there; false = not yet (moving it, or waiting for the Out Arm ZA at home; *why says which).
+bool W906_Ht9050OutSht2ToLeft(std::string *why)
+{
+    if(W906_ShtAt(MOutShuttle2, Prod.OutSHT[1].iLeft)) return true;
+    if(!W906_ShtOutArmZAHome())
+    {
+        W906_ShtStopIfMoving(MOutShuttle2);
+        if(why) *why="Out Arm ZA not at home / Out Arm ZA 不在原點";
+        return false;
+    }
+    MOT[MOutShuttle2].MotorMove(Prod.OutSHT[1].iLeft);
+    if(why) *why="Out Shuttle 2 moving to Left / Out Shuttle 2 移往 Left";
+    return false;
+}
+// Out Shuttle 1 out of the Index area to its Right (Prod.OutSHT[0].iRight = Tech.iOutShuttle1Right, cinitial.cpp:6222): only with the
+// Out Arm ZA at home, the Index Z1 safe and Out Shuttle 2 at Left (moved there first). true = there.
+bool W906_Ht9050OutSht1ToRight(std::string *why)
+{
+    if(W906_ShtAt(MOutShuttle1, Prod.OutSHT[0].iRight)) return true;
+    if(!W906_ShtOutArmZAHome())
+    {
+        W906_ShtStopIfMoving(MOutShuttle1);
+        if(why) *why="Out Arm ZA not at home / Out Arm ZA 不在原點";
+        return false;
+    }
+    if(!W906_ShtIndexZ1Safe())
+    {
+        W906_ShtStopIfMoving(MOutShuttle1);
+        if(why) *why="Index Z1 not safe (not up / HOME lamp off) / Index Z1 不在安全高度";
+        return false;
+    }
+    if(!W906_Ht9050OutSht2ToLeft(why))
+    {
+        W906_ShtStopIfMoving(MOutShuttle1);
+        return false;
+    }
+    MOT[MOutShuttle1].MotorMove(Prod.OutSHT[0].iRight);
+    if(why) *why="Out Shuttle 1 moving to Right / Out Shuttle 1 移往 Right";
+    return false;
+}
+// Called next to IsTestZ1NotSafeShuttle1CanNotMove before every In Shuttle 1 move toward the Index (Do_Auto_SHT1 cases 140 / 210 / 220 /
+// 230 / 300). true = In Shuttle 1 must not move this tick (it is stopped, as golden's guard does); Out Shuttle 1 is being cleared.
+// Own counter (the callers zero iRetryCT right after the Z1 guard passes): about 1000 blocked ticks -> one message, as :3196.
+bool W906_Ht9050OutSht1NotClearShuttle1CanNotMove()
+{
+    static int s_iRetryCT=0;
+    if(!W906_ShtIsHT9050()) return false;
+    if(W906_ShtAt(MOutShuttle1, Prod.OutSHT[0].iRight)) { s_iRetryCT=0; return false; }
