+            if (!s_xyDone[1] || !cylDone) break;
+            Go(101);
+            break;
+        }
+        case 101:
+            if (Blocked(HomeLamp(MOutArmZA), "Out Arm ZA HOME lamp off / Out Arm ZA 原點燈沒亮", MOutArmX)) break;
+            if (Move(MOutArmX, Tech.iOutArmAuto1X)) Go(102);
+            break;
