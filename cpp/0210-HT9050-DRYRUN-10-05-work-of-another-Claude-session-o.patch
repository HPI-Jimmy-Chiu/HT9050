+            if (Blocked(HomeLamp(MOutArmZA), "Out Arm ZA HOME lamp off / Out Arm ZA 原點燈沒亮", MOutShuttle2)) break;
+            if (Move(MOutShuttle2, Prod.OutSHT[1].iLeft)) { ++s_cycles; Go(10); }
