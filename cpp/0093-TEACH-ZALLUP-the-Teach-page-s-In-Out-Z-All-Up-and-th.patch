+//                if(bflag==false) {   MOT[MTestZ1].Gali_Command("MOY", __FUNC__);  btnZ1Servo->Caption="Server OFF";   }
+//                else             {   MOT[MTestZ1].Gali_Command("SHY", __FUNC__);  btnZ1Servo->Caption="Server ON";    }
