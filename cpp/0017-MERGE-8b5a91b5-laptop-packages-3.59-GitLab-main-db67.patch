+
+def L(meth, text, nth=1):
+    """golden 行號（1 起）：meth 本體裡第 nth 個含 text 的行。行號漂了就中止（不蓋錯地方）。"""
+    a, b = SPANS[meth]
+    k = 0
+    for gl in range(a, b + 1):
+        if text in _cpp[gl - 1]:
+            k += 1
+            if k == nth:
+                return gl
+    raise SystemExit('Rotate.py: L(%s, %r) not found' % (meth, text))
+
+
+def _expect(gl, text):
+    if _cpp[gl - 1].strip() != text:
