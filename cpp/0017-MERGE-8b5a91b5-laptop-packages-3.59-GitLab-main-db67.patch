+# ---------------------------------------------------------------- operator policy for alarms / YES-NO
+PRIO = ['HOME', 'RETRY', 'SKIP', 'CLEAN_OUT', 'TRAY_FEED', 'TRAY_END', 'RESET', 'ONECYCLE', 'TRAIN']
