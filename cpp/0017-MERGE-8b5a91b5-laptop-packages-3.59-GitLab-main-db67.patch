+    CHECK(::FindWindowA("TfESDMain", "ESD_Monitor") == NULL);   // nothing came up (no launch path exists)
+
+    // the stand-in ESD program comes up
+    WNDCLASSA wc;
+    std::memset(&wc, 0, sizeof(wc));
+    wc.lpfnWndProc = EsdWndProc;
+    wc.hInstance = ::GetModuleHandleA(0);
