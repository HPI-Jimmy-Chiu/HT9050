+    else if(cbParity->ItemIndex==3)
+        CommTester->Parity=Spcomm::TParity(3);
+    else if(cbParity->ItemIndex==4)
+        CommTester->Parity=Spcomm::Space;
+
+    SaveSetupData(CommTester);
+}
