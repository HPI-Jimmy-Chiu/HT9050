+void Hub::Entry(void* self)
+{
+    Hub* h = static_cast<Hub*>(self);
+    // golden TAnalysisProcessThread::Execute (:208-215): do { job; SleepEx(500, true); } while(!Terminated)
+    do
+    {
+        h->RunOnce();
+        ::SleepEx(500, TRUE);
+    } while (!h->stop_.load());
+}
+
+bool Hub::Start()
+{
+    stop_.store(false);
+    return thread_.start(&Hub::Entry, this);
+}
+
+void Hub::Stop()
+{
+    if (!thread_.joinable()) return;
+    stop_.store(true);
+    thread_.join();
+}
