+        pfn_l122_open                  = (_l122_open)                  GetProcAddress(hPCI_L122CDll,   ("_l122_open"));
+        pfn_l112_open                  = (_l112_open)                  GetProcAddress(hPCI_L112CDll,   ("_l112_open"));
+        //=========L112/L122 open
