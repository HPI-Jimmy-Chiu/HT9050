+        LastSet.iStartMode=1;                                                   //kevin 20180907 add
+
+    if(bCanRunSCKART)                                                           //Steven 20161214 (wei) : For SCK ART
+    {
+    }
+    else
+    {
+        cbRunStartMode->Items->Add(StartModeName[rsmContinuStart]);
+        if(LastSet.iStartMode>0)
+        {
+            cbRunStartMode->Items->Add(StartModeName[rsmInitialStart]);
+            if(LastSet.iStartMode>1)
+            {
+                cbRunStartMode->Items->Add(StartModeName[rsmContinuRetest]);
+                cbRunStartMode->Items->Add(StartModeName[rsmCInitialRetest]);
+            }
+        }
+    }
+
+    if(IniConfig.bUseAutoSiteMapping && IniConfig.bI21EnableASM)                //jou 2011-03-24 start : Auto Site Mapping
+    {
+        cbRunStartMode->Items->Add(StartModeName[rsmAutoSiteMap]);
+    }
+
+    if(IniConfig.bQAMode)                                                       //Steven 20111005
+    {
+        if((CosFunction.bCanDisableQAMode && IniConfig.bA51EnableEQCMode) ||    //JerryYang 20200312 EQC mode新增function on/off，功能關閉時無法切EQC mode
+            CosFunction.bCanDisableQAMode==false)
+        {
+            if(CosFunction.bUseSCKART && bCanRunSCKART &&
+               IniConfig.bSPILFunction==true)                                   //JerryYang 20220923 : SECS GEM版本ART不show QA mode
+            {
+            }
+            else
+            {
+                cbRunStartMode->Items->Add(StartModeName[rsmQAMode]);
+                if(IniConfig.bShowFTandRTButtonCanClick &&
+                   IniConfig.bSPILFunction==true)                               //JerryYang 20190701 SPIL要求主畫面可切換EQC mode
+                {
+                    cbbRunModeSel->Items->Add(StartModeName[rsmQAMode]);
+                }
+            }
+        }
+    }
+
+    if(CosFunction.bUseSCKART)
+    {
+        if(bCanRunSCKART)
+        {
+            cbRunStartMode->Items->Add(StartModeName[rsmInitial_ART]);
+            cbbRunModeSel->Items->Add(StartModeName[rsmInitial_ART]);
+        }
+    }
+    else
+    {
+        if(USE_AUTO_RETEST==eartInstall &&
+           (IniConfig.bA10_AutoReTest ||                                        //kevin 20150720
+            bAutoReTest_ART))                                                   //Steven 20140331 : Auto Retest
+        {
+            cbRunStartMode->Items->Add(StartModeName[rsmInitial_ART]);          //ChungHung 20141002 add for KYEC AutoRetest
+            if(CUSTOMER_CODE==CC_ASE_KaohSiung)
+                cbRunStartMode->Items->Add(StartModeName[rsmContinuRetest_ART]);                                        //kevin 20150717
+        }
+    }
+
+    if(IniConfig.bI37_EnableFIFOMode)                                           //Steven 20160303 : FIFO Mode
+        cbRunStartMode->Items->Add(StartModeName[rsmFIFOMode]);
+
+    if(CosFunction.bUseMRTMode==true && TestIF_File.bEnableMRTMode==true)       //Ifor 20170316 (wei) add KYEC MRT Mode
+    {
+        if(LastSet.iStartMode>0)
+        {
+            cbRunStartMode->Items->Add(StartModeName[rsmInitial_MRT]);
+            if(LastSet.iStartMode>1)
+            {
+                cbRunStartMode->Items->Add(StartModeName[rsmContinuStart_MRT]);
+                cbRunStartMode->Items->Add(StartModeName[rsmRetest_MRT]);
+            }
+        }
+    }
+
+    if(bCanRunSCKART)                                                           //Steven 20170513 (jou) : For SCK ART can do manual RT
+    {
+        cbRunStartMode->Items->Add(StartModeName[rsmCInitialRetest]);
+    }
+
+    if(HasICUnderMachine() || HasAnyICInMachine())                              //Steven 20250930 : fixed for ART
+    {
+        if(bCanRunSCKART)                                                       //Steven 20251020 : for Hana ART
+        {
+            SetRunStartMode(eRunStartMode(LastSet.iRunStartMode));
+        }
+        else if(LastSet.iRunStartMode==rsmContinuStart_ART)
+        {
+            SetRunStartMode(eRunStartMode(rsmContinuStart));
+        }
+        else if(LastSet.iRunStartMode==rsmContinuRetest_ART)
+        {
+            SetRunStartMode(eRunStartMode(rsmContinuRetest));
+        }
+        else
+        {
+            SetRunStartMode(eRunStartMode(LastSet.iRunStartMode));
+        }
+    }
+    else
+    {
+        SetRunStartMode(eRunStartMode(LastSet.iRunStartMode));
+    }
+}
