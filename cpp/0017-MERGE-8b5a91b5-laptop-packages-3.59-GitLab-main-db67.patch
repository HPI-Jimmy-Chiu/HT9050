+                    Str.sprintf("TTL2 RS232 : %s comport error, %s", ComNameTTL_2, GetErrorMessage(iErr));
+                    //AI(W906-GB-P4) 20260926: rule 15 -- golden strcpy's Str into cStr[50], but GetErrorMessage alone is
