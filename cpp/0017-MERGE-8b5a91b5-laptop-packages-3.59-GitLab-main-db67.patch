+// golden TfWinway 建構（HT9045.cpp:272 CreateForm）：收養門面元件 → DFM 設計期 Items／狀態 → 存檔流程讀的替身 → 容器替身與父子
+// → 建構子（:12；讀＋寫 D:\HT9045\config\ATCWinWay.ini）。冪等。
+void FileRW_Winway_Boot()
+{
+    if (g_booted) return;
+    WW_AdoptPortWidgets();
+    WW_DfmItems();
+    WW_DfmState();
+    WW_CreateSaveProxies();
+    WW_CreateContainerProxies();
+    WW_TfWinway();
+    g_booted = true;
