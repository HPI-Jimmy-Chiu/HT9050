+void TfMain::AddShuttleMessage(int iWhichSht, AnsiString Msg)                   //Steven 20130614 : 紀錄Shuttle Latch的位置
+{
+    if(iWhichSht==0)
+    {
+        if(fMain->meShuttle1->Lines->Count>2048)
+        {
+            fMain->meShuttle1->Clear();
+        }
