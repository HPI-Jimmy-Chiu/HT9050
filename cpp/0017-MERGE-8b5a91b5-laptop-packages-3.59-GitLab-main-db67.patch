+        }
+        else if(str.AnsiPos("Jam counter:")==1)
+        {
+        }
+        else if(str.AnsiPos("MUBJ:")==1)
+        {
+        }
+        else
+        {
+            sList->Clear();
+            sList->CommaText=str;
+            JAM_COUNT Temp;
+            Temp.JamCode=sList->Strings[1];
