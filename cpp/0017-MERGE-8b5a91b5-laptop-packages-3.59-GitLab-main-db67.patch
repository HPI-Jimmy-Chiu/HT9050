+void W906_ListDioIni(std::vector<std::string>* out)
+{
+    WIN32_FIND_DATA fd;
+    HANDLE h = FindFirstFile((DIOCFGPath + "*.ini").c_str(), &fd);
+    if (h == INVALID_HANDLE_VALUE) return;
+    do {
+        if ((fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0 ||
