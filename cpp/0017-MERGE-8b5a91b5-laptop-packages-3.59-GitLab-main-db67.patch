+//     caps anyway.
+//   - Add / Clear stay virtual: TfLotInfoLogMemo(Lines) (forms/fLotInfo.h:2324-2336) derives and keeps its own vector.
+#include <vector>
+#include <fstream>
 class TfMainMemoLines : public vclcompat::TObject
 {
 public:
+    enum { kLineCap = 4096 };
     int Count;
     TfMainMemoLines() : Count(0) {}
     virtual ~TfMainMemoLines() {}
-    virtual void Add(AnsiString /*s*/) {}
+    virtual void Add(AnsiString s)
+    {
+        if ((int)items_.size() >= kLineCap)
+            items_.erase(items_.begin(), items_.begin() + ((int)items_.size() - kLineCap + 1));
+        items_.push_back(s);
+        Count = (int)items_.size();
+    }
+    virtual void SaveToFile(AnsiString path)
+    {
+        std::ofstream out(path.c_str(), std::ios::binary);
+        if (!out)
+            return;
+        for (size_t n = 0; n < items_.size(); ++n)
+            out << items_[n].c_str() << "\r\n";
+    }
+    virtual void ClearLines() { items_.clear(); Count = 0; }
+    AnsiString Get(int n) const { return (n >= 0 && n < (int)items_.size()) ? items_[n] : AnsiString(""); }
+protected:
+    std::vector<AnsiString> items_;
 };
 class TfMainMemo : public vclcompat::TObject
 {
@@ -362,7 +395,7 @@ public:
