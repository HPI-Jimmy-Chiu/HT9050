+bool ReadRaw(std::string* out)
+{
+    FILE* fp = std::fopen(kLevelSetPath, "rb");
+    if (!fp) return false;
+    out->clear();
+    char buf[2048];
+    std::size_t n;
+    while ((n = std::fread(buf, 1, sizeof(buf), fp)) > 0) out->append(buf, n);
+    std::fclose(fp);
+    return true;
+}
