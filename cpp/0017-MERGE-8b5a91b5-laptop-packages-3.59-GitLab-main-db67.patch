+        LastSet.GpibAddress=GpibAddress;
+        StatusBar1->Panels->Items[2]->Text=" Address: "+AnsiString(LastSet.GpibAddress);
+        WriteLastDataFile();
+    }
+    dwStart=GetTickCount();
+    lstRecord->SetFocus();                                                      //kevin 20140307
+}
