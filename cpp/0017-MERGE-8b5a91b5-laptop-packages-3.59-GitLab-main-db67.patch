+            sList->Delete(2);
+            sList->Delete(1);
+            sList->Delete(0);
+            str=StringReplace(AnsiString(sList->Text), "\r\n", " ", TReplaceFlags()<<rfReplaceAll);
+            Temp.Message=str;
+            RunInfo.vDailyJam[Temp.JamCode]=Temp;
+        }
+    }
+
+    sList->Clear();
+    slReport->Clear();
+    delete slReport;
+    delete sList;
