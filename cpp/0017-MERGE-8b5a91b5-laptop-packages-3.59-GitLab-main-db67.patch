+bool InCsv(const char* csv, const std::string& name) {
+    std::string cur;
+    for (const char* p = csv ? csv : "";; ++p) {
+        if (*p == ',' || *p == '\0') {
+            if (!cur.empty() && cur == name) return true;
+            cur.clear();
+            if (!*p) break;
+        } else {
+            cur += *p;
+        }
+    }
+    return false;
+}
