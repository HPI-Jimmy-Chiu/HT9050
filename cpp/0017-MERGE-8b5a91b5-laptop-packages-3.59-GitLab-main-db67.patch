+//---------------------------------------------------------------------------
+//  清除ALARM                                                       golden :139-200
+//---------------------------------------------------------------------------
+bool HAlarm::Clear(int iECode)
+{
+    bool Flag=false;
+
+    MutexUse();                                     // 申請使用Mutex
+    for(int iP=0; iP<(int)ErrNoList.size(); iP++)
+    {
+        if(ErrNoList[iP]==iECode)                   // 如果串列中的錯誤碼相同
+        {
+            ErrNoList.erase(ErrNoList.begin() + iP);    // 刪除該節點
+            Flag=true;
