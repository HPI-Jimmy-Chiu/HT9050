+    else if(LastSet.MachName=="9046_32GPIB")
+    {
+       LastSet.MachineType=2;
+//       Application->Title="H9046GPIB";
+    }
+    else if(LastSet.MachName=="2601GPIB")                                       //2012-03-02    Dell for HT-2601
+    {
