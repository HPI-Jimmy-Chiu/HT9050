+// ---- golden ainarm9045.cpp:3209-3307 DoInArmAdditionalFunction ----
+bool DoInArmAdditionalFunction()                                                //Steven 20210609 : 整合Precisor, Rotator, Bottom CCD, Die Clean
+{
+    bool bResult=false;
+    bool flag;
+
+    int &Task=iInArmAdditionalFunctionTask;
