+static bool Has(const std::string& s, const char* t) { return s.find(t) != std::string::npos; }       // AnsiPos()!=0
+static bool StartsWith(const std::string& s, const char* t) { return s.compare(0, std::strlen(t), t) == 0; }   // Pos()==1
