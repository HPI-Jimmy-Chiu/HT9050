+void TfMain::SetStartModeData()
+{
+    cbRunStartMode->Clear();
+    cbbRunModeSel->Clear();                                                     //JerryYang 20190701 SPIL要求主畫面可切換EQC mode
+    cbbRunModeSel->Items->Add(StartModeName[0]);
