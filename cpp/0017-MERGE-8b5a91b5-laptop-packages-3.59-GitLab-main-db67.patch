+
+def _span(meth):
+    for i, l in enumerate(_cpp):
+        if re.match(r'^[^\n/]*\bTFrmRotate::' + meth + r'\s*\(', l):
+            d, seen = 0, False
+            for j in range(i, len(_cpp)):
+                s = _cpp[j].split('//')[0]
+                d += s.count('{') - s.count('}')
+                seen = seen or '{' in s
+                if seen and d == 0:
+                    return i + 1, j + 1
+    raise SystemExit('Rotate.py: span %s' % meth)
+
+
+SPANS = {m: _span(m) for m in METHODS}
