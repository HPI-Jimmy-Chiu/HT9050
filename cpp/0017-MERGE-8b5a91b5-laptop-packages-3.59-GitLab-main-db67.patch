+        std::fprintf(stderr, "無法配置清除系統錯誤訊息\n");   // golden :193 ShowMessage("無法配置清除系統錯誤訊息");
+        MutexRelease();              // Release Mutex
+        std::abort();
+    }
+
+    MutexRelease();
+    UpdateSystemNG();
+
+    return true;
+}
+//---------------------------------------------------------------------------
+//  清除所有ALARM                                                   golden :201-211
+//---------------------------------------------------------------------------
+void HAlarm::Clear()
+{
+    for(int iP=0; iP<(int)ErrNoList.size(); iP=0)
