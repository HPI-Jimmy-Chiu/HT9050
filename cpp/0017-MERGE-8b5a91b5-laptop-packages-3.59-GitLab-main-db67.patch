+// double -> JSON number（LeftAxis 的 Minimum／Maximum、Series 點的值；golden 寫進去的都是整數，"%.10g" 印出來就是整數）
+std::string W906Obs_Num(double v)
+{
+    if (!(v == v) || v > 1e300 || v < -1e300) return "null";              // NaN／Inf 不是合法 JSON
+    char b[32];
+    std::snprintf(b, sizeof(b), "%.10g", v);
+    return b;
+}
