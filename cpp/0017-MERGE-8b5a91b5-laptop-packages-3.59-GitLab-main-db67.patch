+
+// =============================================================================
+//  AI(W906-RECIPE-BCB-R13) 20260926: group 14 -- the "bcb" field (RULINGS_20260926 #13, WebBridgeRecipeBcb.h).
+//  (a) edge cases through the full reader: quotes, pad, inner-blank quotes, unmatched quotes, lone quote,
+//      in-line ';', the 2047 cut, and a quoted number that BCB6 reads as an int.
+//  (b) differential against the REAL kernel32 (Windows only): randomised files; for every key the reader's store
+//      enumerates, RecipeBcbValue(store raw) must equal GetPrivateProfileStringA(sec, key, "", buf, 2048, abs path).
+//  (c) control: the raw text itself must DISAGREE with kernel32 on some keys, or (b) could not fail.
+//  Generator excludes what the header documents as a known gap: section names with ']' , NUL bytes, non-ASCII.
+// =============================================================================
+#include "WebBridgeRecipeBcb.h"
+#include "vclcompat/IniFiles.h"
+#include "vclcompat/TStringList.h"
+#if defined(_WIN32)
+#include <windows.h>
+#endif
+
+void Group14Bcb()
+{
+    std::string big(3000, 'x');
+    CHECK(WriteRaw(kTmp, std::string("[Q]\r\n"
+        "  N=\"12\"\r\n"
+        "  S='abc'\r\n"
+        "  P=  pad  \r\n"
+        "  QS= \" a \" \r\n"
+        "  M=\"a'\r\n"
+        "  One=\"\r\n"
+        "  C=1 ; note\r\n"
+        "  T=\t7\t\r\n"
+        "  L=") + big + "\r\n"));
+    {
+        const std::string j = Read(kTmp);
+        CHECK(Contains(j, "\"N\":{\"value\":12,\"type\":\"int\",\"raw\":\"\\\"12\\\"\",\"bcb\":\"12\"}"));
+        CHECK(Contains(j, "\"S\":{\"value\":\"abc\",\"type\":\"string\",\"raw\":\"'abc'\",\"bcb\":\"abc\"}"));
+        CHECK(Contains(j, "\"P\":{\"value\":\"pad\",\"type\":\"string\",\"raw\":\"  pad  \",\"bcb\":\"pad\"}"));
+        CHECK(Contains(j, "\"QS\":{\"value\":\" a \",\"type\":\"string\",\"raw\":\" \\\" a \\\" \",\"bcb\":\" a \"}"));
+        CHECK(Contains(j, "\"M\":{\"value\":\"\\\"a'\",\"type\":\"string\",\"raw\":\"\\\"a'\",\"bcb\":\"\\\"a'\"}"));
+        CHECK(Contains(j, "\"One\":{\"value\":\"\\\"\",\"type\":\"string\",\"raw\":\"\\\"\",\"bcb\":\"\\\"\"}"));
+        CHECK(Contains(j, "\"C\":{\"value\":\"1 ; note\",\"type\":\"string\",\"raw\":\"1 ; note\",\"bcb\":\"1 ; note\"}"));
+        CHECK(Contains(j, "\"T\":{\"value\":7,\"type\":\"int\""));
+        CHECK(Contains(j, ("\"bcb\":\"" + std::string(2047, 'x') + "\"}").c_str()));
+        CHECK(!Contains(j, ("\"bcb\":\"" + std::string(2048, 'x')).c_str()));
+        CHECK(Contains(j, ("\"raw\":\"" + big + "\"").c_str()));          // raw stays verbatim
+    }
+    CHECK(ht9045::RecipeBcbValue("") == "");
+    CHECK(ht9045::RecipeBcbValue("\x01\x1f 5 \x02") == "5");
+    CHECK(ht9045::RecipeBcbValue("''") == "");
+    CHECK(ht9045::RecipeBcbValue("\"'") == "\"'");
+
+#if defined(_WIN32)
+    unsigned long long st = 20260926ULL;
+    auto rnd = [&](unsigned n) -> unsigned { st = st * 6364136223846793005ULL + 1442695040888963407ULL; return (unsigned)((st >> 33) % n); };
+    const char* secPool[] = {"S", "Test Arm1", "s", "Q R", "AMR"};
+    const char* keyPool[] = {"K", "Up Speed", "k", "A B", "Pick Up", "x1", "Val"};
+    char full[MAX_PATH] = {0};
+    GetFullPathNameA(kTmp, MAX_PATH, full, 0);
+    int keysChecked = 0, bcbDiff = 0, rawDiff = 0;
+    for (int f = 0; f < 200; ++f) {
+        std::string file;
+        const unsigned nsec = 1 + rnd(4);
+        for (unsigned si = 0; si < nsec; ++si) {
+            const char* eolPick[] = {"\r\n", "\n", "\r"};
+            const char* eol = eolPick[rnd(3)];
+            file += std::string(rnd(3) ? "" : "  ") + "[" + (rnd(4) ? "" : " ") + secPool[rnd(5)] + "]" + eol;
+            const unsigned nl = 1 + rnd(8);
+            for (unsigned li = 0; li < nl; ++li) {
+                const unsigned kind = rnd(12);
+                if (kind == 0) { file += "; comment=1"; file += eol; continue; }
+                if (kind == 1) { file += "#hash=2"; file += eol; continue; }
+                std::string v;
+                const unsigned nv = rnd(6);
+                for (unsigned c = 0; c < nv; ++c) {
+                    const char* pieces[] = {" ", "\t", "\x01", "\x1f", "\"", "'", "=", ";", "#", "a", "7", "1.5", "b c"};
+                    v += pieces[rnd(13)];
+                }
+                if (rnd(20) == 0) v += std::string(2100 + rnd(50), 'z');
+                if (rnd(5) == 0) v = "\"" + v + "\"";
+                if (rnd(7) == 0) v = " '" + v + "' ";
+                file += std::string(rnd(2) ? "" : " \t") + keyPool[rnd(7)] + (rnd(3) ? "" : " ") + "=" + v + eol;
+            }
+        }
+        CHECK(WriteRaw(kTmp, file));
+        vclcompat::TIniStore store;
+        store.LoadFromFile(vclcompat::AnsiString(kTmp));
+        vclcompat::TStringList secs;
+        store.FillSectionNames(&secs);
+        for (int si = 0; si < secs.GetCount(); ++si) {
+            const vclcompat::AnsiString sec = secs.GetString(si);
+            vclcompat::TStringList keys;
+            store.FillSectionKeys(sec, &keys);
+            for (int ki = 0; ki < keys.GetCount(); ++ki) {
+                const vclcompat::AnsiString key = keys.GetString(ki);
+                bool found = false;
+                const std::string raw = store.ReadRaw(sec, key, found).c_str();
+                char buf[2048];
+                GetPrivateProfileStringA(sec.c_str(), key.c_str(), "", buf, sizeof(buf), full);
+                const std::string k32(buf);
+                ++keysChecked;
+                if (ht9045::RecipeBcbValue(raw) != k32) {
+                    if (bcbDiff < 5) std::printf("  bcb != kernel32  file %d [%s] %s  raw=<%s> bcb=<%s> k32=<%s>\n", f, sec.c_str(), key.c_str(),
+                                                 raw.c_str(), ht9045::RecipeBcbValue(raw).c_str(), k32.c_str());
+                    ++bcbDiff;
+                }
+                if (raw != k32) ++rawDiff;
+            }
+        }
+    }
+    std::printf("  group 14 differential: %d keys, bcb!=kernel32 %d, raw!=kernel32 %d (control)\n", keysChecked, bcbDiff, rawDiff);
+    CHECK(keysChecked > 500);
+    CHECK(bcbDiff == 0);
+    CHECK(rawDiff > 0);
+#endif
+}
