+struct Meta { bool exists; long long size; long long mtime; };
+static Meta MetaOf(const std::string& p)
+{
+    struct stat st;
+    Meta m = { false, 0, 0 };
+    if (stat(p.c_str(), &st) == 0) { m.exists = true; m.size = (long long)st.st_size; m.mtime = (long long)st.st_mtime; }
