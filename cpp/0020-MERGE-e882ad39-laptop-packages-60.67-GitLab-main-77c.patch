+            else:
+                p = pseq(t)
+                rec['port_cycle'] = steady_loop(p)
+                rec['port_head'] = p[:40]
+                rec['port_n'] = pinfo_t['n']
+                if p == efull:
+                    rec.update(verdict='EQUAL', first_diff=None)
+                elif rot_equal(rec['ref_cycle'], rec['port_cycle']) and cyc:
+                    rec.update(verdict='EQUAL-mod-AL', first_diff=None, al=[cyc[0]['id']])
+                else:
