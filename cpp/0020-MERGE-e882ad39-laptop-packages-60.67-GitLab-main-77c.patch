+                    else:
+                        rec['note'].append('steady loops differ')
+            full.append(rec)
+        elif len(eraw) > 1:
+            rec = {'task': t, 'kind': 'moved', 'ref_seq': eraw, 'al': [], 'note': note}
+            seqr = rules_of(t, SEQ_KINDS)
+            rec['al_available'] = [e['id'] for e in seqr]
+            if pinfo_t is None:
