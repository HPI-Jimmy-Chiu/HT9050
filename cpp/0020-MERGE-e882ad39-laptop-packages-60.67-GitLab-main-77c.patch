+    }
+    int want = 0;
+    bool any = false;
+    for (int i = 0; i < g_icNEvents && !any; ++i) any = IC_EvPageDiffers(root, g_icEvents[i].control, &want);
+    if (!any) {                             // 頁面有送 form.event（或沒改這幾格）：filtered／ignored 不動，行為與原本相同
+        cJSON_Delete(root);
+        return true;
+    }
+    g_saveBefore = cJSON_Parse(filerw::ProxyStateJson("TfConfiguration").c_str());
