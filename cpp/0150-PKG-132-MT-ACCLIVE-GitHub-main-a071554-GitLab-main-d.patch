+        for (int j = 0; j < g.maxCol; ++j) w.Key(kZdEdit[arm][i][j]).Number((wb_int64)E[i][j]);
+    if (!ep4 && !baseIn) w.Key(baseEdit.c_str()).Number((wb_int64)0);         // :4363 / :4433 -- golden writes 0 into it even off the grid
