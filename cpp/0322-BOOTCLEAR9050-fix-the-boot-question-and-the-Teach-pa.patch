+// ===========================================================================
+//  PART 3 -- AI(W906-BOOTCLEAR9050) 20261008: the boot "machine has material -- clear it?" box must come up while IDLE.
+//  It was first called from DoAllProcess, which MainProc runs only while SystemStart, so on the machine the box never showed
+//  (EastSun 1008「沒出現視窗詢問」) although the function's own tests were green. This drives the real MainProc with
+//  SystemStart==false, the way PART 1 does, and counts the box by its own question text.
+// ===========================================================================
+#include "canary_support.h"     // W906_ShowMyMessageBoxYesNo_Hook
+extern AnsiString W906_GpibModel;
+void W906_BootAskClearMachineReset();
+static int s_mpAsked = 0;
+static int MpFakeNo(const char* s1, const char*, const char*)
+{
+    if (s1 && std::string(s1).find("是否清除") != std::string::npos) ++s_mpAsked;
+    return 2;                                                                   // No = keep: the fixture is not wiped
+}
+void W906_MainProcBootAskPart()
+{
+    std::printf("\n-- PART 3: BOOTCLEAR9050 -- idle MainProc asks once --\n");
+    const AnsiString savedModel = W906_GpibModel;
+    int (*savedHook)(const char*, const char*, const char*) = W906_ShowMyMessageBoxYesNo_Hook;
+    const bool savedTray = MOT[MMTrayY].fHasTray;
+    ArmRunState();
+    SystemStart = false;
+    W906_GpibModel = "9050GPIB";
+    MOT[MMTrayY].fHasTray = true;                                               // what machinerecord.dat restored at 10:27
+    W906_BootAskClearMachineReset();
+    W906_ShowMyMessageBoxYesNo_Hook = &MpFakeNo;
+    s_mpAsked = 0;
+    MainProc();
+    CHECK(s_mpAsked == 1, "★ SystemStart==false: the first MainProc pass asks whether to clear (EastSun 1008)");
+    MainProc(); MainProc();
+    CHECK(s_mpAsked == 1, "and only once");
+    W906_ShowMyMessageBoxYesNo_Hook = savedHook;
+    W906_GpibModel = savedModel;
+    MOT[MMTrayY].fHasTray = savedTray;
+    W906_BootAskClearMachineReset();
+    SystemStart = false;
+    iHome       = 0;
+}
