 //------------------------------------------------------------------------------
 
 //<== Eastsun 20260515 F011
+//==============================================================================
+//AI(W906-TRAYFLOW9050) 20261007: EastSun 1007 "Empty does not refill Auto 1" -> "fix it now". HT9050 Empty stack counted, probed, picked
+//  from (DoCatchTray 500/600) and reset on HOME/START. iEmptyLayerCount_9050 = trays in the Empty stack: 0 empty, -1 unknown -> probe
+//  before the next pick or place. DoPlaceTrayToEmpty_9050 hands in at Up[n]+lift and makes n+1; DoCatchFromEmpty_9050 takes the top
+//  tray at Up[n-1]+lift and makes n-1. Type_HT9050 paths only; golden untouched.
+//==============================================================================
+int W906_TrayZ9050Home(int zone);
+static int s_iEmptyProbeTask9050 = 1, s_iEmptyProbeLayer9050 = 0, s_iEmptyProbeFirst9050 = 0, s_iEmptyNoTray9050 = 0;
+void W906_InitProbeEmpty9050()
+{
+    s_iEmptyProbeTask9050 = 1;
+    s_iEmptyNoTray9050    = 0;
+}
+//  Probe (MEmptyZ): Home, then Up[L] from the deepest layer not below Home, one layer up per step, until SenEmptySelectHasTray => L+1 trays.
+int W906_ProbeEmpty9050()
+{
+    int &Task = s_iEmptyProbeTask9050, &L = s_iEmptyProbeLayer9050;
+    if(iEmptyLayerCount_9050 >= 0)
+    {
+        Task = 1;
+        return 1;
+    }
+    switch(Task)
+    {
+        case 1:
+            if(MOT[MEmptyZ].MotorMove(W906_TrayZ9050Home(1)) == 1)
+            {
+                #ifdef SOFT_SIMULTE
+                iEmptyLayerCount_9050 = 5;                                      // as DoLoad_9050 case 1000 (Loader 5)
+                return 1;
+                #else
+                L = MAX_LOADER_LAYER_9050 - 1;
+                while(L > 0 && W906_TrayZ9050(1, 1, L) < W906_TrayZ9050Home(1))  // never below Home
+                    L--;
+                s_iEmptyProbeFirst9050 = L;
+                Task = 100;
+                #endif
+            }
+            break;
+        case 100:
+            if(Cylinder[C_EmptyEdgeClip].Pop() &&
+               Cylinder[C_EmptyEdgePush].Pop() &&
+               Cylinder[C_EmptyLoaderZ_Select].Push())
+            {
+                if(MOT[MEmptyZ].MotorMove(W906_TrayZ9050(1, 1, L)) == 1)
+                {
+                    if(Sen[SenEmptySelectHasTray].IsOn())
+                    {
+                        if(L == s_iEmptyProbeFirst9050)                         // a tray even at the deepest layer
+                        {
+                            ShowErrorMessage("MES1022", K_RETRY, MMEmpty, false, "W906_ProbeEmpty9050");
+                            Task = 1;
+                            break;
+                        }
+                        iEmptyLayerCount_9050 = L + 1;
+                        Task = 1;
+                        return 1;
+                    }
+                    if(--L < 0)                                                 // no tray at any layer
+                    {
+                        if(Sen[SnEmptyDrawerHasTray].IsOn())                    // but the drawer sees one: the sensors disagree
+                        {
+                            ShowErrorMessage("MES1024", K_RETRY, MMEmpty, false, "W906_ProbeEmpty9050");
+                            Task = 1;
+                            break;
+                        }
+                        iEmptyLayerCount_9050 = 0;
+                        Task = 1;
+                        return 1;
+                    }
+                }
+            }
+            break;
+    }
+    return 0;
+}
+//  DoCatchTray 500/600 on Type_HT9050 (Empty is the only buffer, Frank 1006): 0 busy, 1 tray on Tray X, 2 no tray (-> case 1).
+int W906_CatchFromEmpty9050(int iWhichAuto)
+{
+    (void)iWhichAuto;
+    if(iCatchFromEmpty9050Task == 1)
+    {
+        if(W906_ProbeEmpty9050() != 1)
+            return 0;
+        if(iEmptyLayerCount_9050 <= 0)
+        {
+            if(++s_iEmptyNoTray9050 >= 100)                                     // golden CatchNewTrayFromBuffer's MES1021 cadence
+            {
+                s_iEmptyNoTray9050 = 0;
+                if(ShowErrorMessage("MES1021", K_RETRY, MMEmpty, false, "W906_CatchFromEmpty9050") == K_RETRY)
+                    iEmptyLayerCount_9050 = -1;                                 // refilled: probe again
+            }
+            return 2;
+        }
+        s_iEmptyNoTray9050 = 0;
+    }
+    const int ret = DoCatchFromEmpty_9050();
+    if(ret == 3)                                                                // Tray X may not move (stopped, cursor 1)
+    {
+        Cylinder[C_TrayX_UpDown].Pop();                                         // as CatchNewTrayFromBuffer case 2150
+        return 0;
+    }
+    return ret;
+}
+void InitLoadNewICTrayTask_9050();                                              // asendic_Loader.cpp
+//  InitAllProcessTask (HOME / START), Type_HT9050 only.
+void W906_InitTrayTasks9050()
+{
+    InitialCatchFromLoader_9050();
+    InitialCatchFromEmpty_9050();
+    InitialPlaceToBuffer_9050();                                                // + InitialPlaceToEmpty_9050 / InitialPlaceToAuto_9050
+    InitLoadNewICTrayTask_9050();
+    W906_InitProbeEmpty9050();
+    iEmptyLayerCount_9050 = -1;                                                 // the operator may have touched the Empty stack: re-probe
+}
