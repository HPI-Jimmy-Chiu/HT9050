+// =============================================================================
+//  AI(W906-PASSPROF) 20261006: EastSun 1006「請最佳化下去」-- which phase made a slow pass. W906_PassProfBegin (top of
+//  the serve-loop pass, before the fast clock) and this function (the sleep block, where the FASTCLK pass meter ends) bracket
+//  one pass on the tick thread; every WdMark in between closes the previous phase (QPC). A pass of 100 ms or more writes one
+//  op-log SLOW line: the pass time and its biggest phases. The phase names are the WdMark names ("PumpTick", "apiCache+SrDiag",
+//  "publish", "dispatch: <cmd>", "1203 Poll", ...); "FastClock jobs" = the shared fast clock's jobs at the top of the pass.
+//  Cost when no pass is slow: one QueryPerformanceCounter per WdMark (~30 per pass). The review asked for exactly this breadcrumb
+//  (IOTHREAD_REVIEW_20261006 Q4: "a one-line breadcrumb for any pass over 100 ms, so the next log names the phase").
+// =============================================================================
+namespace {
+unsigned long long g_ppCyc0 = 0, g_ppTsc0 = 0;                                  // the pass start: the tick thread's CPU cycles, the TSC (W906_PassProfBegin)
+void W906_PassProfEnd()
+{
+    if (!g_ppOn || ::GetCurrentThreadId() != g_ppTid) return;
+    const long long now = W906PpNow();
+    W906PpAttr(now);
+    g_ppOn = false;
+    if (g_ppF <= 0) return;
+    const double totalMs = (double)(now - g_ppT0) * 1000.0 / (double)g_ppF;
+    static const double s_slowMs = []() { const char* e = std::getenv("W906_SLOWPASS_MS"); const double v = e ? std::atof(e) : 0.0; return v >= 5.0 ? v : 100.0; }();   // env W906_SLOWPASS_MS = the threshold (default 100 ms; >= 5)
+    if (totalMs < s_slowMs) return;
+    int order[64];
+    for (int i = 0; i < g_ppN; ++i) order[i] = i;
+    for (int i = 0; i < g_ppN; ++i)                                             // biggest first (at most 64 phases)
+        for (int j = i + 1; j < g_ppN; ++j)
+            if (g_pp[order[j]].q > g_pp[order[i]].q) { const int x = order[i]; order[i] = order[j]; order[j] = x; }
+    double cpuMs = -1.0;                                                        // the tick thread's own CPU time in this pass (QueryThreadCycleTime,
+    {                                                                           //   converted with the TSC rate measured over the same pass)
+        ULONG64 c = 0;
+        ::QueryThreadCycleTime(::GetCurrentThread(), &c);
+        const unsigned long long tsc = __builtin_ia32_rdtsc();
+        const double tscPerMs = (double)(tsc - g_ppTsc0) / totalMs;
+        if (tscPerMs > 0.0) cpuMs = (double)(c - g_ppCyc0) / tscPerMs;
+    }
+    char b[512];
+    int k = std::snprintf(b, sizeof(b), "pass %.1f ms (tick thread CPU %.1f ms):", totalMs, cpuMs);
+    for (int i = 0; i < g_ppN && i < 10 && k > 0 && k < (int)sizeof(b); ++i)
+        k += std::snprintf(b + k, sizeof(b) - (std::size_t)k, " %s %.1f ms;", g_pp[order[i]].n, (double)g_pp[order[i]].q * 1000.0 / (double)g_ppF);
+    OpLine("SLOW", b);
+}
