+{
+    for(int i=0; i<iMaxRow; i++)
+    {
+        for(int j=0; j<iMaxCol; j++)
+        {
+            if(bLed[i][j]==true)
+            {
+                if(Item[i][j]==NULL_IC && pLed[i][j]->Value==true)
+                    return false;
+                if(Item[i][j]!=NULL_IC && pLed[i][j]->Value==false)
