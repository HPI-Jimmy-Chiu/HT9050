+                        if (AnsiString(tsRow->Strings[iJamCol]).AnsiPos(Str) == 1)   // Strings[] is a StringsProxy -- explicit convert before .AnsiPos()
+                        {
+                            strngrdEventLog->RowCount = strngrdEventLog->RowCount + 1;   // RowCountProxy has no operator++
