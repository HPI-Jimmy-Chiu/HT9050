+# ============================================================================ JS text: strip comments, keep strings
+def strip_js_comments(t):
+    out = []
+    i, n = 0, len(t)
+    while i < n:
+        c = t[i]
+        if c in '"\'`':
+            j = i + 1
+            while j < n and t[j] != c:
+                if t[j] == BS:
+                    j += 1
+                elif t[j] == '\n' and c != '`':
+                    break
+                j += 1
+            out.append(t[i:j + 1])
+            i = j + 1
+            continue
+        if c == '/' and i + 1 < n and t[i + 1] == '/':
+            j = t.find('\n', i)
+            j = n if j < 0 else j
+            i = j
+            continue
+        if c == '/' and i + 1 < n and t[i + 1] == '*':
+            j = t.find('*/', i + 2)
+            j = n if j < 0 else j + 2
+            out.append('\n' * t.count('\n', i, j))           # keep line numbers
+            i = j
+            continue
+        out.append(c)
+        i += 1
+    return ''.join(out)
+
