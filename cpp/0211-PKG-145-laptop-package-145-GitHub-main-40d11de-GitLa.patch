+    iWhichAuto[TargetR][TargetC]    =Source.iWhichAuto[SourceR][SourceC];
+    iCurrRotAng[TargetR][TargetC]   =Source.iCurrRotAng[SourceR][SourceC];      //Steven 20170425 (wei) : Add rotate motor
