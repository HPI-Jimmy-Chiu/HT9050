+void TfObserver::mtRowAMouseUp(void *Sender, int X, int Y)
+{
+    TfObserverTray *Ptr=(TfObserverTray *)Sender;                               // M1
+    Ptr->Core.ConvertIndexCells(X, Y);                                          // M2
+
+    if(Y>0)
+    {
+        int iRow=Ptr->Tag;
+        int iCol=Y-1;
+        bShowYieldSeries[iRow][iCol]=!bShowYieldSeries[iRow][iCol];
