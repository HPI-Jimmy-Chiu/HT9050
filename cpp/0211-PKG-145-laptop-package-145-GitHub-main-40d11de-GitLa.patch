+//-----------------------------------------------------------------
+//PTP motion(unit: 1/100mm)
+//-----------------------------------------------------------------
+bool TMyEtherCatMotor::G00(int iPos)
+{
+    int p;
+    double r;
+    p=iPos;
+    r=GearRatio;
+    if(r==0)
+        return false;
+    int p1,p2;
+    p1=p/r;        // unit: 1/100mm -> pulse
+    p2=p1*r;
+    if(p2<p){      //Compensate
+        while(1){
+            p1++;
+            p2=p1*r;
+            if(p2>=p) break;
+        }
+    }
+    else if(p2>p){
+        while(1){
+            p1--;
+            p2=p1*r;
+            if(p2<=p) break;
+        }
+    }
+    return RealG00(p1);
+}
