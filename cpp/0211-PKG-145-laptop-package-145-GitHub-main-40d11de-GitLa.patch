+    const bool eligible = ht9045::e044::Eligible(SystemStart, SoftStop, fAllMotorHome, iHome);
+    return ht9045::e044::Step(g_wait[arm == 1 ? 1 : 0], newWait, pass, waiting, eligible, now);
