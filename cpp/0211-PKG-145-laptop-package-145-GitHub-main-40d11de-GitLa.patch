+    }
+    else if (iShowYieldChart == 2)
+    {
+        if (bStartShowYieldChart)
+        {
+            iSystemSec = SystemSec;
+            iSystemMin = SystemMin;
+            bStartShowYieldChart = false;
+        }
+        else
+        {
+            if (SystemMin != iSystemMin)
+            {
+                if ((SystemSec + 60 - iSystemSec) > 60)
+                {
+                    iSystemSec = SystemSec;
+                    iSystemMin = SystemMin;
+                    iCT++;
+                }
+            }
+
+            if (iCT >= 2)
+            {
+                iCT = 0;
+                Close();
+            }
+        }
+    }
+    //Steven 20100818 End
+}
