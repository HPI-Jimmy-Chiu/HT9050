+//-----------------------------------------------------------------
+//Getting signal of org/home
+//-----------------------------------------------------------------
+bool TMyEtherCatMotor::GetHomeIO(void)
+{
+#if HAVE_PCI1203
+    unsigned long Status = 0;
+    U32 Result;
+    AnsiString strError;
+
+    Result=Acm_AxGetMotionIO(m_Axishand[MotorID],&Status);   //Get current command position of the specified axis
+    if(Result!=SUCCESS)
