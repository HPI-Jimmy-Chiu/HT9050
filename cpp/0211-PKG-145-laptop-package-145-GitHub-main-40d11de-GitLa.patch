+TStringList* ItemsOf(TControl* c) {
+    if (TComboBox* x = dynamic_cast<TComboBox*>(c)) return x->Items;
+    if (TRadioGroup* x = dynamic_cast<TRadioGroup*>(c)) return x->Items;
+    return nullptr;
