+                    if(IniConfig.bUseTrayBlockMode)                             //2014-03-04    Dell    for SPIL WLP Add Tray Block
+                        OutArmAddBlockPitch(iXPos, iYPos, iR, iC);
+
+                    TransferAutoRatio(iOutPutTray, &iXPos, &iYPos);             //Steven 20141029 : Auto的軟體齒輪比
