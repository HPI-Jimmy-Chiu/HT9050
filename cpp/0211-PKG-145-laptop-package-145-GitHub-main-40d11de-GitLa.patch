+void W906Obs_YieldSiteClick(TfObserver *f, int tray, const std::string &text)
+{
+    if (tray < 0 || tray >= MAX_SOCKET_ROW)
+        throw std::invalid_argument("yieldSite: arg must be 0..3 (mtRowA..mtRowD = mtRow[0..3], Tag 0..3)");
