+
+    Result=Acm_SetF64Property(m_Axishand[MotorID], PAR_AxHomeVelHigh, PHomeHighSpeed);
+    if(Result!=SUCCESS)
+    {
+        strError="Mot MotorID-" + IntToStr(MotorID) + " HomeVelHigh," + IntToHex((int)Result,8);
+        ShowErrorMessage("WAR16122", 0, MMSystem, 0, strError);
+    }
