+void TfObserver::UpdateYieldChart()
+{
+    int iLast, iSeries;
+    AnsiString str;
+    RUN_INFO *RIF;
+    RIF = &RunInfo;
+
+    for (int iRow = 0; iRow < MAX_SOCKET_TOTAL; iRow++)   //Steven 20100126 : 將全部的線都清空
+        ChartYield->Series[iRow]->Clear();
