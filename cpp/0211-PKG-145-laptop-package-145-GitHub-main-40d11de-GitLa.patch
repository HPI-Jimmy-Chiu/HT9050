-
-    ss = Sec % 60;
-    i_mm = Sec / 60;
-    if (i_mm > 60)
-    {
-        mm = i_mm % 60;
-        hh = i_mm / 60;
-        if (mm.Length() == 1) mm = "0" + mm;
-        AS_Time = hh + ":" + mm + ":" + ss;
-    }
-    else
