+        Led[iCcwLed]=false;
+        Led[iCwLed]=false;
+        Led[iHomeLed]=false;
+        Led[iSoftcwLed]=false;
+        Led[iSoftccwLed]=false;
+        Led[iAlarmLed]=false;
