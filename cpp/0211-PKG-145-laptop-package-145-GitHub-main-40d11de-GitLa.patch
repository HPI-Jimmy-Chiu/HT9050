+def rd(path, enc='utf-8'):
+    with open(path, 'rb') as f:
+        b = f.read()
+    try:
+        return b.decode(enc)
+    except UnicodeDecodeError:
+        return b.decode('cp950' if enc == 'utf-8' else 'utf-8', 'replace')
+
+
+def relp(path, root):
+    return os.path.relpath(path, root).replace(BS, '/')
+
