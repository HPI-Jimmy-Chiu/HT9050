+    j += ",\"rows\":" + W906Obs_Int(rows) + ",\"cols\":" + W906Obs_Int(cols) + ",\"fixedRows\":" + W906Obs_Int(rows > 1 ? 1 : 0);
+    j += ",\"colWidth\":68,\"color\":" + W906Obs_Rgb(14670284) + ",\"fixedColor\":" + W906Obs_Rgb(9534289) + ",\"cells\":[";
