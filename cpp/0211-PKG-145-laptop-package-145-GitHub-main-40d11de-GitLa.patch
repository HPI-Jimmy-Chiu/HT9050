+GENERIC_CLS = {'btn3d', 'btn', 'button', 'ed', 'pnl', 'tab', 'act', 'down', 'up', 'flat', 'small', 'big', 'wide', 'grid'}
+UNWIRED_FILE = re.compile(r'unwired|unported')            # ht9045_unported_form_c.js, ht9045_iosetview_unwired_c.js: grey + reason
