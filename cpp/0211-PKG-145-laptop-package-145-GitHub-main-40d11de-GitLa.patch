+    iArmsitecount[0]=0;
+    for(int i=0; i<FTestSuck.iShtRow; i++)
+    {
+        for(int j=0; j<FTestSuck.iShtCol; j++)
+        {
+            if(FTestSuck.Item[i][j]==HAS_IC ||
+               FTestSuck.Item[i][j]==HAS_HOT_IC)
+            {
+                iCount++;
+            }
+            iUseSiteCount++;
+        }
+    }
+
+    if(iCount!=0)
+    {
+        iArmsitecount[0]=iUseSiteCount-iCount;
