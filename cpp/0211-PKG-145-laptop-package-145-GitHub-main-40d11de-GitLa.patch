+bool W906_TimeDataHourEdge(int iNowTime, bool* pbPerHours)   // golden HS_Function.cpp:4312-4328 (iClock==60)
+{
+    bool bResult=false;
+    int iTime=10000;
+    if(*pbPerHours)
+    {
+        if(iNowTime%iTime>3)
+        {
+            *pbPerHours=false;
+            bResult=true;
+        }
+    }
+    else
+    {
+        if(iNowTime%iTime<3)
+            *pbPerHours=true;
+    }
+    return bResult;
+}
