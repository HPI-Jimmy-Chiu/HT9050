+//--------------------------------------------------------------------------
+void TMyEtherCatMotor::Close_Card()
+{
+    if(uiDevhand==0) //避免重負關
+        return;
+
+#if HAVE_PCI1203
+    U32 Result;
+    AnsiString strError;
+
+    Result=Acm_DevClose(&uiDevhand);
+    if(Result!=SUCCESS)
+    {
+        strError="Close Card," + IntToHex((int)Result,8);
+        ShowErrorMessage("WAR16122", 0, MMSystem, 0, strError);
+    }
+    else
+    {
+        uiDevhand=0;
+    }
+#endif
+}
