+            std::vector<unsigned char> r = s.OnTx(tx);
+            if (!r.empty()) { COM2->Comm1->SimInjectReceive(&r[0], (Spcomm::Word)r.size()); ::Sleep(130); }
+        } else ::Sleep(5);
+    }
+    return COM2->GetReadTorueTask() == 999;
+}
