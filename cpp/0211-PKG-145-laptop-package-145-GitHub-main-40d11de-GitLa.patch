+def refs_in(text, ident):
+    """line numbers (1-based) where ident appears as a string literal / #selector / object key."""
+    pat = re.compile(r'''(['"`])%s\1|#%s(?![\w-])|(?<![\w$.])%s\s*:(?!:)|\[id=['"]?%s['"\]]''' % ((re.escape(ident),) * 4))
+    out = []
+    for m in pat.finditer(text):
