+static void ParseEventLogLine(const AnsiString &asLine, TStringList *tsRow)
+{
+    if(IniConfig.bSPILFunction==true)                                           // SPIL log 欄位配置不同且手上無樣本可驗，維持原解析
+        tsRow->CommaText=asLine;
+    else
+        SplitEventLogCsvLine(asLine, tsRow);
+}
