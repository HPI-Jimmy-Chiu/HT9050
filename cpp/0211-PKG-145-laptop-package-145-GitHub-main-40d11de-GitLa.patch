+                    Error=true;
+                    iNozzleEvent=0;                                             //Klutter 20210817 修改屬性方便修正吸嘴回home異常事件     //Steven 20210825 : 吹氣完成才可以歸零
+                    bDestroyOK=true;                                            //ChungHung 20110901 add
