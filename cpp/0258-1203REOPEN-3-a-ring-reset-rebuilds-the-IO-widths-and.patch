 EtherCAT/Pci1203Monitor.cpp | 25 +++++++++++++++++--------
 EtherCAT/Pci1203Monitor.h   |  2 +-
 docs/WORKLOG_MACHINE.md     |  1 +
 3 files changed, 19 insertions(+), 9 deletions(-)

diff --git a/EtherCAT/Pci1203Monitor.cpp b/EtherCAT/Pci1203Monitor.cpp
index cc19845..0d3b249 100644
--- a/EtherCAT/Pci1203Monitor.cpp
+++ b/EtherCAT/Pci1203Monitor.cpp
@@ -121,8 +121,8 @@ struct TPci1203Monitor::Impl {
     bool        gearReadDue;
     bool        gearReadForce;  std::vector<unsigned> cfgDue; std::vector<unsigned> cfgFailed; std::vector<int> cfgTries; std::vector<Pci1203CfgExpect> cfgExpect; std::vector<unsigned> cfgWritten; bool inPoll; bool cfgRetryDue; bool retryArmed; unsigned long retryTick; void (*yieldHook)(); bool inYield; unsigned long yieldMs;   //AI(W906-IOWEB-P25) 20260925: per-axis configuration groups still to read (cfgDue, armed by OpenAxes_ = open / rescan / re-attach, and by a write), groups whose last read failed (cfgFailed, retried on the 30 s window at most 3 times), written values awaiting agreement (cfgExpect), and the output-first yield hook. Same line, no line below moves
     unsigned    maxAxes;  struct Pci1203IoSnap* ioPub = 0; struct Pci1203IoSnap* ioStaged = 0;  int cfgRetryAxis = -1; bool cfgRoundOn = false; std::size_t cfgRoundNext = 0; unsigned long cfgRoundTick = 0;   //AI(W906-CFGRETRY) 20261006: the failed-group retry round (EastSun 1006 「參數重試一定要一直重試 只是秒數可以拉長」→ 1 分鐘): which axis retries THIS Poll (-1 none), whether a round is open, the next axis to look at, when the last round opened; same line   // maxAxes: remembered so a re-attach can redo them   //AI(W906-IOTHREAD) 20261005: the published copy the main thread reads (ioPub) and the one the IO thread fills at the end of every poll (ioStaged); 0 until the IO thread's first poll. Same line, no line below moves
-    unsigned    diPorts;
-    unsigned    doPorts;              //AI(W906-1203MON-18) 20260910
+    unsigned    diPorts;  unsigned diPortsReq = 0;   //AI(W906-1203REOPEN-3) 20261007: + the width Open() was ASKED for (diPorts is later clamped to what the card reported then); same line
+    unsigned    doPorts;  unsigned doPortsReq = 0;   //AI(W906-1203MON-18) 20260910   //AI(W906-1203REOPEN-3) 20261007: + the same for DO
     //AI(W906-1203COLD-2) 20260924: when the last ring sweep ran, so a zero scan
     //  can be retried on a LATER tick instead of on every tick. GetTickCount
     //  wraps after 49 days; the comparison below is written as a subtraction of
@@ -360,8 +360,8 @@ bool TPci1203Monitor::Open(unsigned maxAxes, unsigned diPorts, std::string& why,
     if (diPorts > static_cast<unsigned>(kPci1203MaxDiPorts)) diPorts = kPci1203MaxDiPorts;
     if (doPorts > static_cast<unsigned>(kPci1203MaxDoPorts)) doPorts = kPci1203MaxDoPorts;
     impl_->maxAxes = maxAxes;
-    impl_->diPorts = diPorts;
-    impl_->doPorts = doPorts;
+    impl_->diPorts = diPorts;  if (impl_->diPortsReq == 0) impl_->diPortsReq = diPorts;   //AI(W906-1203REOPEN-3) 20261007: remember the FIRST request (a later Rescan re-opens with it, so the width can grow back when a module returns); same line
+    impl_->doPorts = doPorts;  if (impl_->doPortsReq == 0) impl_->doPortsReq = doPorts;
 
     //AI(W906-1203MON-8) 20260907: ATTACHED vs OWNED. Read uiDevhand ONCE here
     // and branch; Poll() re-reads it every time to catch production closing or
@@ -623,7 +623,7 @@ bool TPci1203Monitor::Open(unsigned maxAxes, unsigned diPorts, std::string& why,
     ScanSlaves_();
     g_openPhase = "opening axis handles (up to 4 s)";
     OpenAxes_();
-    g_openPhase = "reading the IO map";
+    g_openPhase = "reading the IO map";  return OpenIoLayout_(diPorts, why, doPorts); }  bool TPci1203Monitor::OpenIoLayout_(unsigned diPorts, std::string& why, unsigned doPorts) {   //AI(W906-1203REOPEN-3) 20261007: EastSun「2.請你想辦法」(review P2: RescanRing did not rebuild the IO widths / IO map). Open() is SPLIT here, on this line: everything below -- DI/DO widths, ring status, DI/DO station maps + attribution, DiBatchOpen_, opened=true / disabled=false -- is the body of OpenIoLayout_, unchanged, so RescanRing (end of file) runs the very same code after a ring reset. No line below moves.
 
     //AI(W906-1203MON-18) 20260910: ask the CARD how wide its IO image is, once,
     //  here in Open() and never in a tick. Four properties, all verified to
@@ -1857,8 +1857,8 @@ bool TPci1203Monitor::Rescan(std::string& why)
     //  Remembered from the original Open(), so a rescan cannot quietly change
     //  the shape of the published data underneath a page that is bound to it.
     const unsigned ax = impl_->maxAxes;
-    const unsigned di = impl_->diPorts;
-    const unsigned dou = impl_->doPorts;
+    const unsigned di = impl_->diPortsReq ? impl_->diPortsReq : impl_->diPorts;   //AI(W906-1203REOPEN-3) 20261007: was impl_->diPorts -- the width CLAMPED at the last open, so a module missing then could never get its ports back by a rescan
+    const unsigned dou = impl_->doPortsReq ? impl_->doPortsReq : impl_->doPorts;
 
     Close();
     const bool ok = Open(ax, di, why, dou);
@@ -4698,7 +4698,16 @@ bool TPci1203Monitor::RescanRing(std::string& why)
     CloseAxes_();
     ScanSlaves_();
     OpenAxes_();
+    //AI(W906-1203REOPEN-3) 20261007: EastSun「2.請你想辦法」(review P2) -- then the SAME second half of Open(): DI/DO widths, ring
+    //  status, the DI/DO station maps and their ring / station / channel attribution, DiBatchOpen_, opened=true / disabled=false.
+    //  A module that came back after the reset is in the IO map again (was: DI/DO left mapped as at the first open), and a monitor
+    //  that had auto-disabled itself is enabled again. Same widths as the original Open() (impl_->diPorts / doPorts, like Rescan()).
+#if HAVE_PCI1203
+    const bool ok = OpenIoLayout_(impl_->diPortsReq ? impl_->diPortsReq : impl_->diPorts, why, impl_->doPortsReq ? impl_->doPortsReq : impl_->doPorts);
+#else
+    const bool ok = false;  why = "not linked: built without HAVE_PCI1203";
+#endif
     if (Pci1203OnIoThread()) W906IoStage_(impl_->ioStaged, impl_->ioPub, impl_->cardS, impl_->axes, impl_->dis, impl_->dos, impl_->slaves, impl_->opened, impl_->disabled, impl_->disabledWhy);
-    return true;
+    return ok;
 }
 }  // namespace ht9045
