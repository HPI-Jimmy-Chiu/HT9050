diff --git a/acatchtray.cpp b/acatchtray.cpp
index b7f4c725..976a4bd4 100644
--- a/acatchtray.cpp
+++ b/acatchtray.cpp
@@ -2623,10 +2623,10 @@ int DoCatchFromLoader_9050()
 //AI(W906-F9050-BD) 20261004: 910 :2529-2531 verbatim.  iEmptyLayerCountDetect_9050 is never used (910 as written).
 int iEmptyLayerCount_9050        = -1;
 int iEmptyLayerCountDetect_9050  = 0;
-int iCatchFromEmpty9050Task      = 1;  int W906_ProbeEmpty9050(); int W906_CatchFromEmpty9050(int iWhichAuto);   //AI(W906-TRAYFLOW9050) 20261007: both at acatchtray.cpp EOF
+int iCatchFromEmpty9050Task      = 1;  int W906_ProbeEmpty9050(); int W906_CatchFromEmpty9050(int iWhichAuto);  static int s_iEmptyCatchCylOk9050 = 0;   /* AI(W906-CATCHCYL9050) 20261010: = the step (10 / 20) whose cylinder chain is in place; that step then only moves Z (see case 10) */   //AI(W906-TRAYFLOW9050) 20261007: both at acatchtray.cpp EOF
 void InitialCatchFromEmpty_9050()
 {
-    iCatchFromEmpty9050Task = 1;
+    iCatchFromEmpty9050Task = 1;  s_iEmptyCatchCylOk9050 = 0;   /* AI(W906-CATCHCYL9050) 20261010: HOME / START sets the cylinders again */
 }
 //AI(W906-F9050-BD) 20261004: NO CALLER, as in 910 (910 defect (c); Frank 1001 17:1x 「暫時先不動」): 9050 Empty picks still go through golden
 //  CatchNewTrayFromBuffer, and golden DoAutoEmpty still runs -- two models of one Empty area.  Note: no iEmptyLayerCount_9050
@@ -2647,20 +2647,20 @@ int DoCatchFromEmpty_9050()
                 Task=10;
             break;
         case 10:                                                                //Step 2: Edge Pop + Select Push + MZ 到交接位
-            if(Cylinder[C_EmptyEdgeClip].Pop() &&
+            if(s_iEmptyCatchCylOk9050 == Task || Cylinder[C_EmptyEdgeClip].Pop() &&   /* AI(W906-CATCHCYL9050) 20261010: EastSun 1010「改」-- these four cylinders have no sensor (IO_Table _On / _Off rows empty), so a Pop / Push that completed starts its 1 s delay again on the next call; in one && chain the links kept restarting each other (~2^4 delays) and MotorMove ran only on the rare scan where all four passed: 1010 17:39 case 10 7 s, case 20 8 s+ with MEmptyZ never commanded. As PROBECYL9050: once the chain passed, this step skips it (&& binds before ||) */
                Cylinder[C_EmptyEdgePush].Pop() &&
                Cylinder[C_MobileTrayTableSelect].Push())
-            {
+            {   s_iEmptyCatchCylOk9050 = Task;   /* AI(W906-CATCHCYL9050) 20261010: chain in place -- from now on this step only moves Z */
                 if(MOT[MEmptyZ].MotorMove(W906_TrayZ9050(1, 1, iEmptyLayerCount_9050-1))==1)   //AI(W906-TRAYZ-PITCH) 20261006: was Prod.EmptyZ_Up[iEmptyLayerCount_9050]
                     Task=20;
             }
             break;
         case 20:                                                                //Step 3: Selector Push + MZ 再上升
-            if(Cylinder[C_EmptyEdgeClip].Pop() &&
+            if(s_iEmptyCatchCylOk9050 == Task || Cylinder[C_EmptyEdgeClip].Pop() &&   /* AI(W906-CATCHCYL9050) 20261010: as case 10 */
                Cylinder[C_EmptyEdgePush].Pop() &&
                Cylinder[C_EmptyLoaderZ_Select].Push() &&
                Cylinder[C_MobileTrayTableSelect].Push())
-            {
+            {   s_iEmptyCatchCylOk9050 = Task;   /* AI(W906-CATCHCYL9050) 20261010: as case 10 */
                 if(MOT[MEmptyZ].MotorMove(W906_TrayZ9050(1, 1, iEmptyLayerCount_9050-1) + W906_TrayZ9050Lift(1))==1)   //AI(W906-TRAYZ-PITCH) 20261006: was Prod.EmptyZ_Up[..] + Prod.iEmptyCatchExtraLift_9050
                     Task=30;
             }
