+            Stop();
+
+            InitMotor(Address);
+            Task=10;
+            break;
+        case 10:
+//            Status=mn_get_mdio_status(iBoardID, iPortID, &MotionIO);    //wei 20161020 MN200 Home遮板已被遮住，需往反方向走離開
+//            GetMN200ErrorMessage(Status, "mn_get_mdio_status");
