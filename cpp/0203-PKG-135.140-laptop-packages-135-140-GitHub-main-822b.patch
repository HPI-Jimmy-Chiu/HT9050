+// XPitchMouseDown above except the CheckRange bounds (-4000..4000).
+void TfSetup::XShiftPitchMouseDown(TEdit *Sender)
+{
+    // GATE (E-B2) OPENED 20260825 (FW-BARCODE2) -- see E-B1 above.
+    if(Barcode_Reader(bcSetup)==0)
+    {
+        return;
