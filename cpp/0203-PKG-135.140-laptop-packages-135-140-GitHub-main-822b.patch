+//AI(W906-S17A) 20261003 (St01): any other command a wait loop does not serve.  A modal.answer / dialog.response whose tag no
+//  wait holds is an answer to a box C++ has left behind (replaced / superseded modeless message, answered elsewhere, closed
+//  by IO) -- the same "no query pending" the main dispatch gives it (the pages close on /no query pending/:
+//  ht9045_dialog_host.js show-my-message + alarm, ht9045_modal.js).  Before: "modal-pending", the box stayed and the box
+//  this wait shows, queued behind it, never rendered.  The open modeless box is answered by W906_MsgBoxModelessAnswer first.
+inline std::string WaitOtherReply(const std::string& cmd, const std::string& tag, const std::string& own)
+{
+    if ((cmd == "modal.answer" || cmd == "dialog.response") && !tag.empty() && tag != own && !TagWaiting(tag))
+        return "no query pending:superseded-by=" + own;
+    return "modal-pending";
+}
