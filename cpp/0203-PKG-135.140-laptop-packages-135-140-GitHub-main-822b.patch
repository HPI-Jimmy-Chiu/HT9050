+void TfSetup::CheckSTMMode()
+{
+    iCloseSiteModeFor2x8=e2x8Standard;                                         //JerryYang 20191122 STM 8 site Auto clean支援前後排一起收
+    iCloseSiteModeFor2x6=e2x6Standard;                                         //Steven 20240417 : 12site分成前後4site
