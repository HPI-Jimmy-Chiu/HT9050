+    }
+    g_issuedPoll[a.axis] = be.Pci1203PollCount();
+    g_encBase.erase(a.axis);
+    note = "命令位置＝編碼器 " + std::to_string((int)act) + "（golden ServoOnOff → PCIL132_ResetPos）";
+    return true;
+}
