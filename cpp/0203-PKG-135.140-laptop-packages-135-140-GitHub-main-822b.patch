+        Lst->Add("");
+
+        Lst->Add("Channel & Bit Length  : "+TIF_DIOFrom()->rgBinBitLength->Items->Strings[T.iCateBitLength]);
+        Lst->Add("Data Type                    : "+TIF_DIOFrom()->rgBinDataType->Items->Strings[T.iCateDataType]);
