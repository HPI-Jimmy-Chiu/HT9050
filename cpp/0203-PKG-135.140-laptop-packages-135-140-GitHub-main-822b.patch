+    std::vector<std::string> out;
+    std::string::size_type i = 0;
+    const std::string::size_type n = sCsv.size();
+
+    while (i <= n)
+    {
+        // skip leading blanks (<= ' ') before a token
+        while (i < n && static_cast<unsigned char>(sCsv[i]) <= ' ' && sCsv[i] != cDelim)
