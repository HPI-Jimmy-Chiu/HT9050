+            else    //CHBinary
+            {
+                //5BitBinary
+                if(TestIF.iTestMode<=_8Site2X4)     //Isaac 20210309 :TTL RS232兩塊板子
+                {
+                    HHandler2Gpib.bSupport32Bin=false;//true : use two TTL board
+                }
