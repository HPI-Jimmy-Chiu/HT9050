+            bCooling=false;
+        }
+        else
+        {
+            if(W906_FormShowing("fiosetview", fiosetview->fShow)==false)        // AI(W906-TP1): golden fiosetview->fShow==false
+            {
+                if(SW[SwCCDCooling].Enable==true)
