+                {
+                    if(IniConfig.sN28_IP!="")
+                        Str.sprintf("OEE ON(%s)", IniConfig.sN28_IP);
+                    else
+                        Str.sprintf("OEE ON(-)");
+                    strShowYield[i].UsePanel->Caption=Str;
+                    strShowYield[i].UsePanel->Color=clLime;
+                }
+                else
+                {
+                    Str.sprintf("OEE OFF");
+                    strShowYield[i].UsePanel->Caption=Str;
+                    strShowYield[i].UsePanel->Color=clRed;
+                }
