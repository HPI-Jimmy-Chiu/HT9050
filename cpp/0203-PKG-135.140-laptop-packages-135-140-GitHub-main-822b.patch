+}
+//---------------------------------------------------------------------------
+void TfTemperFrom::RecordTemp()                                                 // golden :1975-1990
+{
+    AnsiString sFileName;
+    if(iStartMin!=SystemMin)
+    {
+        iStartMin=SystemMin;
+        sFileName.sprintf("%02d:%02d:%02d", SystemHour, SystemMin, SystemSec);
