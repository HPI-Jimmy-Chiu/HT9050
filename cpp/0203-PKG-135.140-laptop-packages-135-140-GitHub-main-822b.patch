+//--------------------------------------------------------------------------
+bool TMyMN200Motor::MoveToPos(int Tar)                                          // Move to //
+{
+    int iRet=0;
+    if(Enable==false)
+        return true;
+
+    if(!MotionDone())
+        return false;
+
+    int iPos;
+    iPos=ReadPos();
+
+    SetSpeed(iSpeed);
+    iRet=mn_fix_move(iBoardID, iPortID, MN200SpeedPar, Tar, FIX_MOVE_MODE_ABS_BY_OUTPLS);
+
+    if(iRet!=0)
+    {
+        GetMN200ErrorMessage(iRet, "mn_fix_move");
+    }
+
+    if(MotionDone() && Tar==iPos)
+        return true;
+    else
+        return false;
+}
