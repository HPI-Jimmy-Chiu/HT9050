+    if (d <  40.0) return 1.0;      // BCB6 L316/407/1548 -- note: <40 (strictly less)
+    if (d <  50.0) return 2.0;      // BCB6 L317/408/1549
+    if (d <  60.0) return 4.0;      // BCB6 L318/409/1550
+    return 8.0;                     // BCB6 L319/410/1551
+}
