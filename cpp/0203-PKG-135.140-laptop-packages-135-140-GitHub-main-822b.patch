-                  d.routeWrites, d.issued, d.dry, d.refused, d.vendorErr);
-    std::string s(b);
-    for (std::size_t i = 0; i < d.lines.size() && i < 12; ++i) s += "｜" + d.lines[i];
-    if (d.lines.size() > 12) s += "｜…";
-    return s;
-}
