+AnsiString DelDot(AnsiString asBuffer)
+{
+    AnsiString asReturn;
+    int iBegin = 0;
+    for (int i = 0; i < iTestBinCount; i++)   // kevin 20140317: 256 bin
+    {
+        if (i == 1)
+        {
+            iBegin = asBuffer.Pos(AnsiString(i) + " ");
+            if (iBegin != 1)
+                continue;
+        }
+        else
+            iBegin = asBuffer.Pos(" " + AnsiString(i) + " ");
+        if (iBegin > 0)
+        {
+            break;
+        }
+    }
+
+    if (iBegin == 0)
+    {
+        iBegin = asBuffer.Pos(AnsiString("E"));
+    }
+
+    asReturn = asBuffer.Delete(1, iBegin - 1);
+    return asReturn;
