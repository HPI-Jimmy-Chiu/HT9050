+bool TIF_Q41_W6Editable(const char* n)
+{
+    if (!TIF_Q41_IsW6(n)) return false;
+    TTabSheet* ts = EL<TTabSheet>("TFTestIF", "tsRs232");
+    const bool keep = ts->TabVisible;
+    ts->TabVisible = true;
