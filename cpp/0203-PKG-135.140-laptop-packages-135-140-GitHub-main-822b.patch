+        T.iDutType             =ReadIniData(S, "DUT Signal",    "Type", 0);
+        if(T.iDutType<0)   //Steven 20110105
+            T.iDutType=0;
+
+        T.iDutBfOnTime         =ReadIniData(S, "DUT Signal",    "Before On", 0);
+        T.iDutAfOffTime        =ReadIniData(S, "DUT Signal",    "After Off", 0);
