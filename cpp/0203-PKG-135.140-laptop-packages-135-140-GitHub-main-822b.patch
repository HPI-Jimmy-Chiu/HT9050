+//---------------------------------------------------------------------------
+//  AI(W906-TP1): the port's two entry points.
+//
+//  W906_TemperFromBootShow -- golden TfMain::DoShowUserDefFrom :8731-8732 (`fTemperFrom->Close();
+//    fTemperFrom->Show();`), which golden FormShow :10161 runs at boot before the SortCT / TestCategory /
+//    ContactCT windows. tools/wb_serve.cpp:4162 calls it right before W906_BootTestCategory (the port's
+//    fTestCategory branch of the same function). golden's CreateForm(TfTemperFrom) happens earlier, but its
+//    ctor reads CUSTOMER_CODE, so the port creates the form here, after boot has read Gerneral.ini (the
+//    values the golden ctor saw). golden runs DoShowUserDefFrom a second time from Timer1 :3212 (Counter
+//    Selection NeedRef); the port runs that function's other branches at boot only
+//    (FileRW/IniConfig_CounterSel.cpp:29), and a second Close / Show changes no state here.
+//  ht9045::W906_TemperFromTimer1Tick -- golden TTimer Timer1 (cTemperFrom.dfm:3285-3289, Interval 100),
+//    called every PumpTick (WebBridgeTags.cpp:601; ~500 ms until the shared fast clock of RULINGS_20261002
+//    #7, and the TTimer schedule table of RULINGS_20261001 #39 takes it over once on main). VCL deadline
+//    style, as MainTimersSt02.cpp / forms/fDTME08.cpp: the first fire one Interval after enable, no catch-up.
+//    Not called inside the blocking boxes (tools/wb_serve.cpp:7621 is the laptop's) -- a known gap shared
+//    with the Timer2 heater segment.
+//---------------------------------------------------------------------------
+void W906_TemperFromBootShow()
+{
+    if(fTemperFrom==NULL)
+        { fTemperFrom=new TfTemperFrom(); if(INSTALL_OCR!=eocrUninstal) fTemperFrom->SetShowYield(fTemperFrom->esytOcrOn, TestIF_File.bOcrFunction); }   // golden Application->CreateForm(__classid(TfTemperFrom), &fTemperFrom)  //AI(W906-ST02-S09B) 20261004 (St02-E, claim OKed TO_STEVEN 1004 02:3x): golden 0618 cSetUp.cpp:2850-2852 replayed once -- golden creates TfSetup / TfTemperFrom (HT9045.cpp:183 / :185) before any ReadFile, so the boot TfSetup::ReadFile sets the OCR slot; here the boot ReadFile (tools/wb_serve.cpp:3202 / :3270) runs before this boot show, its call is skipped by the NULL guard at cSetUp.cpp:1116, so it is replayed here, before FormClose / FormShow (ctest St02_S09SetupTemperFrom [5])
+    fTemperFrom->FormClose();                                                   // golden :8731 fTemperFrom->Close()
+    fTemperFrom->FormShow();                                                    // golden :8732 fTemperFrom->Show()
+}
+
+namespace ht9045 {
+void W906_TemperFromTimer1Tick()
+{
+    static unsigned long ulNext=0;
+    if(fTemperFrom==NULL || fTemperFrom->Timer1->Enabled==false || bSystemClose)
+    {
+        ulNext=0;
+        return;
+    }
+    const unsigned long ulNow=::GetTickCount();
+    if(ulNext==0)
+    {
+        ulNext=ulNow+100;
+        return;
+    }
+    if((long)(ulNow-ulNext)<0)
+        return;
+    ulNext=((ulNow-ulNext)>=100)?(ulNow+100):(ulNext+100);
+    fTemperFrom->Timer1Timer();
+}
+} // namespace ht9045
