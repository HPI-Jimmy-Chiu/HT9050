+                              dTemptureRangeBelow=Temperature.iTempReadyRange;
+                              dTemptureRangeOver=Temperature.iTempReadyRange;
+                          }
+                          else
+                          {
+                                dTemptureRangeBelow=1;
+                                dTemptureRangeOver=1;
+                          }
