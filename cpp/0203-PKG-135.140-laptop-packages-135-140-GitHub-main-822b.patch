+    //AI(W906-ENG1203) 20260929: ---- L: MEDIUM-1 a failed stop is latched and never dropped from the console ----
+    {
+        FakeEnv e; Fresh(e);
+        e.AddAxis(30, 0); e.AddAxis(31, 0);
