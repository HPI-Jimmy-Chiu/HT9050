+            ChStr->sprintf("MNet系統 Ring %d IP %d 錯誤, CPU emulation 的處理模式參數的設定不為CPU_EMU_CMD_PROCESS_WRITE和CPU_EMU_CMD_PROCESS_READ。", iRing, iIP);
