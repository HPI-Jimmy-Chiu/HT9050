+    //Data[34-37] SOT Width (MS, 最大1000)
+    Str.sprintf("%04d", Prod.DIOCfg.iSTPluseWidth);
+    asBuffer->Add(Str);
+
+    //Data[38-41] Dut Width (MS, 最大1000)
+    Str.sprintf("%04d", 200);
+    asBuffer->Add(Str);
+
+    //Data[42-47] BIN Time Out (MS, 最大500000)
+    Str.sprintf("%06d", 0);
