+        Pci1203MotorRouteFault f;
+        CHECK(Pci1203MotorRouteAxisFault(30, 0, f) && f.stopFailed == 0 && f.motionFailed == 0 && Pci1203MotorRouteFaultText(f).empty());
+        CHECK(!Pci1203MotorRouteAxisFault(99, 0, f) && f.stopFailed == 0);
+        e.ret = 0x80005111ul;
