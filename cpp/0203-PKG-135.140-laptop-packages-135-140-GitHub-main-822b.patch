+// alarm ids are g_nextQid++ (wb_serve.cpp ForwardShowErrorMessage, notices and blocking alarms alike): "older" = a smaller
+// decimal.  Anything that is not a plain decimal (a "msg-<N>", empty) is never older.
+inline bool AlarmIdOlder(const std::string& tag, const std::string& cur)
+{
+    if (tag.empty() || cur.empty() || tag.size() > 19 || cur.size() > 19) return false;
+    for (size_t i = 0; i < tag.size(); ++i) if (tag[i] < '0' || tag[i] > '9') return false;
+    for (size_t i = 0; i < cur.size(); ++i) if (cur[i] < '0' || cur[i] > '9') return false;
+    const size_t a = tag.find_first_not_of('0'), b = cur.find_first_not_of('0');
+    const std::string t = (a == std::string::npos) ? std::string("0") : tag.substr(a);
+    const std::string c = (b == std::string::npos) ? std::string("0") : cur.substr(b);
+    return t.size() != c.size() ? t.size() < c.size() : t < c;
+}
