+// (vclcompat/Controls.h, this wave).
+void TfSetup::cbAaDropDown(TComboBox *Sender)
+{
+    if(IniConfig.bG09NeedPasswordWhenEditSiteMap==true)                         //Alick 20160603 Site Map 需要密碼
+    {
+        if(bNeedEnterPassword==true)
