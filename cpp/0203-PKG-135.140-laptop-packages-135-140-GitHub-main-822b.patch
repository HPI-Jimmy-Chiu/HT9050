+inline std::string Fmt(const char* f, ...)
+{
+    char b[512];
+    va_list ap;
+    va_start(ap, f);
+    std::vsnprintf(b, sizeof(b), f, ap);
+    va_end(ap);
+    return std::string(b);
+}
