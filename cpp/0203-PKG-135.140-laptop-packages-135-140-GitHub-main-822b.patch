+    unsigned long PollCount() override
+    {
+        TPci1203Monitor* m = Pci1203Monitor();
+        return m ? m->card().pollCount : 0ul;
+    }
+    unsigned long ExecCount() override { return Pci1203MotorRouteExecCountOf(Pci1203Control()); }
+    int AxisCount() override
