-#
-#  用法：
-#      build\wb_serve.exe --allow-cmd --root D:\HT9045\web --seconds 25 --port 8192
-#      python tools\webprobe\s7_thermo_probe.py --port 8192
-#
-#  Exit 0 = 每一項期望都達成。
-# =============================================================================
-import argparse
-import json
