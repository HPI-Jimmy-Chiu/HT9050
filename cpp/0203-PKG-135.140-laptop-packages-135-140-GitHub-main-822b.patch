+inline bool ReadWholeFile(const std::string& path, std::string& out)
+{
+    out.clear();
+    FILE* f = ::fopen(path.c_str(), "rb");
+    if (!f) return false;
+    char buf[4096];
+    std::size_t n;
+    while ((n = ::fread(buf, 1, sizeof(buf), f)) > 0) out.append(buf, n);
+    ::fclose(f);
+    return true;
+}
