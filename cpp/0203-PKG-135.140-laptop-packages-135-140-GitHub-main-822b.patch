+// --- the tags the wait loops are holding (AI(W906-S17) 20261003, St01, laptop card S-17) ----------------------------
+//   C++ keeps ONE slot per mailbox while the page QUEUES every request (dialog-bridge.js queueStop, FIFO, never dropped).
+//   A box the page still shows can belong to a request C++ has already left behind (overwritten, replaced, answered
+//   elsewhere, closed by IO).  Its answer must CLOSE it, or the box C++ is waiting on now -- queued behind it -- never
+//   shows and the wait never ends (INBOX 137 / S-17).  "Left behind" = no wait loop holds that tag any more: every wait
+//   (ForwardShowErrorMessage, ForwardShowMyMessageBoxYesNo, MbWait in tools/wb_serve.cpp) registers its own qid here
+//   for its whole life, innermost last, so a nested wait never makes an outer one look stale.  The tick thread only.
+inline std::vector<std::string>& WaitingTags() { static std::vector<std::string> v; return v; }
+inline bool TagWaiting(const std::string& tag)
+{
+    const std::vector<std::string>& v = WaitingTags();
+    for (size_t i = 0; i < v.size(); ++i) if (v[i] == tag) return true;
+    return false;
+}
+struct WaitTagScope {
+    explicit WaitTagScope(const std::string& tag) : tag_(tag) { WaitingTags().push_back(tag_); }
+    ~WaitTagScope()
+    {
+        std::vector<std::string>& v = WaitingTags();
+        for (size_t i = v.size(); i-- > 0; ) if (v[i] == tag_) { v.erase(v.begin() + (long)i); break; }
+    }
+private:
+    std::string tag_;
+    WaitTagScope(const WaitTagScope&);
+    WaitTagScope& operator=(const WaitTagScope&);
+};
