-        if (*Src != Quote) break;                               //   if Src^ <> Quote then Break;
-        ++Src;                                                  //   Inc(Src);
-        ++DropCount;                                            //   Inc(DropCount);
-        Src = CtScan(Src, Quote);                               //   Src := AnsiStrScan(Src, Quote);
-    }
-    if (Src == nullptr) Src = CtStrEnd(P);                      // if Src = nil then Src := StrEnd(P);
