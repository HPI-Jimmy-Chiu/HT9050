+std::string ThermoSchemaJson() {
+    webbridge::JsonWriter w;
+    w.BeginObject();
+    w.Key("binding").String("temp.zone");
+    w.Key("channels").Number((wb_int64)kThermoChannelCount);
+    w.Key("fmt").String(kThermoFmt);
+
+    // ⚠ anyLive 放在最前面附近是刻意的：瀏覽器應該先看這一欄再看任何值。
