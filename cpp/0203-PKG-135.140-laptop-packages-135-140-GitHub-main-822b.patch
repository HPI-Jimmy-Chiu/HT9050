-import time
-import urllib.request
-
-sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
-from cmd_probe import ws_handshake, read_frames   # noqa: E402
-
-FAILED = []
-PASSED = [0]
-
-
-def check(cond, what):
