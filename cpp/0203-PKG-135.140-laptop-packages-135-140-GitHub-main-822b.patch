-//    Port     (empty -> -1 + bHasNullData;
-//              non-empty: if ISABase in {1,2,4} -> HexStrToInt(.c_str())
-//                         else atoi)
-//    Bit      (empty -> -1 + bHasNullData)
-//    InType   (empty -> 0, NOT -1)
