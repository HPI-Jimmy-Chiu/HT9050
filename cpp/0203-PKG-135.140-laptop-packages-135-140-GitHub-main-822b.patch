+        CHECK(Pci1203MotorRouteExecCountOf(0) == 0ul);
+        TPci1203Control ctl;                                                 // never opened: Execute refuses, and counts
+        Pci1203Cmd c; c.kind = kCmdAxStop; c.axis = 0;
