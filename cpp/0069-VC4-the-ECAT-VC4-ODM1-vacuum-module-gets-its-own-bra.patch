 namespace ht9045 {
 
+// AI(W906-VC4) 20261001: the vacuum-unit MODEL a station's identity names. The value is the VC count.
+enum { kPci1203VacNone = 0, kPci1203VacVc4 = 4, kPci1203VacVc8 = 8 };
