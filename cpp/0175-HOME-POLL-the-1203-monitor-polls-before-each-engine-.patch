+void (*g_W906MonitorPollNow)() = 0;           //AI(W906-HOME-POLL) 20261003: one 1203 monitor poll now, rate-limited by its owner (tools/wb_serve.cpp registers it); 0 = nothing (tests)
+void (*g_W906RouteNote)(const char*) = 0;    //AI(W906-ECAT-RECLAIM) 20261003: the op log's ROUTE line (tools/wb_serve.cpp W906_OpLogInit registers it); 0 = console only
 
 namespace ht9045 {
 
@@ -548,6 +549,11 @@ bool RouteInitCfg(int board, int port, int motorClass, bool sensorType, bool in1
 //   AI(W906-ENG1203) 20260929: pinned by the route test (review R7 / R19); every "home not sent" is latched (MEDIUM-1).
 int RouteHomeStart(int board, int port, bool homeDir, double hi, double lo, double acc, double dec)
 {
+    //AI(W906-HOME-POLL) 20261003: EastSun 1003「又失敗了」「明明都可以單軸回原點了」-- 19:54 the HOME-SEEN fix did not help: the monitor
+    //  polls on the SAME thread as the engine, and one engine pass issued 14 homes in ~8 s (InitMotor + speed writes each), so no poll ran
+    //  in between and every short home had ended unseen. A monitor poll before each home start (rate-limited ~150 ms by the owner) samples
+    //  the axes started earlier in the pass while they are HOMING (Pci1203AxisSample::homingSeenPoll).
+    if (::g_W906MonitorPollNow) ::g_W906MonitorPollNow();
     NoteForeign();
     ++s_stats.calls;
     AxisRec* rec = 0;
diff --git a/tools/wb_serve.cpp b/tools/wb_serve.cpp
index 5e6f735..201626e 100644
--- a/tools/wb_serve.cpp
+++ b/tools/wb_serve.cpp
@@ -7618,6 +7618,18 @@ W906ModalWaitScope::~W906ModalWaitScope()
     if (kind != 2) W906_ModalOutputsRefresh();                                  // kind 2：MbFormClose 尾做（它在 MbWait 回來之後才跑）
 }
 
+//AI(W906-HOME-POLL) 20261003: one 1203 monitor poll from inside the engine (EtherCAT/Pci1203MotorRoute.cpp RouteHomeStart), at most every
+//  150 ms -- the full HOME issues all homes of a phase in one ~8 s engine pass and the monitor (same thread) never sampled them HOMING.
+//  Same call shape as W906_ModalWaitTick's poll below (yield hook off around it, the per-axis brake tick after it).
+void W906_MonitorPollNowFromEngine()
+{
+    static unsigned long long last = 0;
+    const unsigned long long now = W906_TickMs64();
+    if (last != 0 && now - last < 150ull) return;
+    last = now;
+    if (ht9045::TPci1203Monitor* mon = ht9045::Pci1203Monitor()) { mon->SetYieldHook(0); mon->Poll(); mon->SetYieldHook(&W906_OutputYieldHook); { extern void W906_BrakeAxisTick(); W906_BrakeAxisTick(); } }
+}
+
 void W906_ModalWaitTick(int kind, int kcode)
 {  { extern void W906_Q44ConsoleServiceTick(); W906_Q44ConsoleServiceTick(); }  { extern void W906_A01AutoLogoutTick(); W906_A01AutoLogoutTick(); }  { extern void W906_St02TimersTickFromModal(); W906_St02TimersTickFromModal(); }  /*AI(W906-D015-A01b) 20260930 [W906]（St01，Jimmy 20260930 答覆）: [A01] 閒置計數在阻塞框開著時照數、時間到照樣登出 —— golden VCL Timer3 在 ShowModal 的訊息迴圈裡照跑（V912 main.cpp:26022-26072）；本體 FileRW/Main_A01AutoLogout.cpp 自己限成每秒一次、有重入保險；同一行，不移動行號*/   //AI(W906-D012) 20260929 [W906] Q44 A3: a blocking box is open (the main loop cannot reach W906_ServeQuitDue) -- console Ctrl-C / X still gets the stop commands sent from here (tick thread); body FileRW/MainClose.cpp; AI(W906-S13) 20261001 (St02-E, claim): + St02 timers in modal waits (golden VCL timers keep firing during ShowModal), MainTimersSt02.cpp
     { extern void W906_NativeFormsPump(int); W906_NativeFormsPump(1); }  /* AI(W906-NATIVE-PROTO) 20260928 [W906]: 告警／是否／ShowMyMessage 三個阻塞等待框期間主迴圈停住，這裡照樣泵原生視窗（否則 5 秒後 Windows 標「沒有回應」）；site 1＝拖曳時只保活 Index 煞車保護（檔尾 W906_NativeKeepaliveModal）。OFF＝空函式 */  {                                                                           // 1203 DI 樣本（見檔頭）
@@ -8338,7 +8350,7 @@ void W906_OpLogInit(int port)
                   (int)(W906_WEB_TOKEN_ENFORCE != 0));
     OpLine("START", std::string(head) + built + "  " + exe);
     webbridge::g_W906OpLogHook = &W906_OpHook;
-    { extern void (*g_W906StateRecordNote)(const char*); g_W906StateRecordNote = &W906_OpSrNote; }  { extern void (*g_W906BrakeNote)(const char*); g_W906BrakeNote = &W906_OpBrakeNote; }  { extern void (*g_W906HomeNote)(const char*); g_W906HomeNote = &W906_OpHomeNote; }  { extern void (*g_W906RouteNote)(const char*); g_W906RouteNote = &W906_OpRouteNote; }  { extern void (*g_W906MotorHomeNote)(const char*); g_W906MotorHomeNote = &W906_OpHomeNote; }  ht9045::StreamSetSink(&W906_OpStreamNote);  { extern void (*g_W906VacuumNote)(const char*); g_W906VacuumNote = &W906_OpVacuumNote; }   //AI(W906-VACUNIT-1203) 20260930: + the ECAT-VC8 writes   //AI(W906-SR-HANG) 20260929; AI(W906-BRAKE-AXIS) 20260929 (2nd fix: the registration sat behind this comment) ; //AI(W906-STREAM-S1) 20260930
+    { extern void (*g_W906StateRecordNote)(const char*); g_W906StateRecordNote = &W906_OpSrNote; }  { extern void (*g_W906BrakeNote)(const char*); g_W906BrakeNote = &W906_OpBrakeNote; }  { extern void (*g_W906HomeNote)(const char*); g_W906HomeNote = &W906_OpHomeNote; }  { extern void (*g_W906RouteNote)(const char*); g_W906RouteNote = &W906_OpRouteNote; }  { extern void (*g_W906MotorHomeNote)(const char*); g_W906MotorHomeNote = &W906_OpHomeNote; }  { extern void (*g_W906MonitorPollNow)(); extern void W906_MonitorPollNowFromEngine(); g_W906MonitorPollNow = &W906_MonitorPollNowFromEngine; }  ht9045::StreamSetSink(&W906_OpStreamNote);  { extern void (*g_W906VacuumNote)(const char*); g_W906VacuumNote = &W906_OpVacuumNote; }   //AI(W906-VACUNIT-1203) 20260930: + the ECAT-VC8 writes   //AI(W906-SR-HANG) 20260929; AI(W906-BRAKE-AXIS) 20260929 (2nd fix: the registration sat behind this comment) ; //AI(W906-STREAM-S1) 20260930
