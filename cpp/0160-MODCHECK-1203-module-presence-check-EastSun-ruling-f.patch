+static std::string W906_Pci1203ModuleIniPath()
+{
+    const std::string g = asGeneralPath.c_str();
+    const std::size_t k = g.find_last_of("\\/");
+    return (k == std::string::npos ? std::string() : g.substr(0, k + 1)) + "Pci1203Modules.ini";
+}
+
+static ht9045::Pci1203ModuleIniLoad W906_Pci1203ModuleIniLoad(const std::string& path)
+{
+    ht9045::Pci1203ModuleIniLoad L;
+    HANDLE h = ::CreateFileA(path.c_str(), GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
+    if (h == INVALID_HANDLE_VALUE) {
+        const DWORD e = ::GetLastError();
+        if (e == ERROR_FILE_NOT_FOUND) { L.status = ht9045::Pci1203ModuleIniLoad::kMissing; return L; }
+        char b[64]; std::snprintf(b, sizeof(b), "open failed (err %lu)", (unsigned long)e);   // PATH_NOT_FOUND / ACCESS_DENIED / sharing:
+        L.status = ht9045::Pci1203ModuleIniLoad::kBad; L.why = b;                             //   NOT "missing" -- never record over it
+        return L;
+    }
+    std::string text;
+    char buf[4096];
+    DWORD got = 0;
+    bool ok = true;
+    for (;;) {
+        if (!::ReadFile(h, buf, sizeof(buf), &got, NULL)) { ok = false; break; }
+        if (got == 0) break;
+        text.append(buf, got);
+        if (text.size() > (1u << 20)) { ok = false; break; }   // 1 MB: not a module list
+    }
+    ::CloseHandle(h);
+    if (!ok) { L.status = ht9045::Pci1203ModuleIniLoad::kBad; L.why = "read failed / too large"; return L; }
+    std::string why;
+    if (ht9045::Pci1203ModuleIniParse(text, L.entries, why)) L.status = ht9045::Pci1203ModuleIniLoad::kOk;
+    else { L.status = ht9045::Pci1203ModuleIniLoad::kBad; L.why = why; }
+    return L;
+}
+
+// kWriteIni: "<ini>.tmp" then a no-replace rename. "" = written; else why not.
+static std::string W906_Pci1203ModuleIniCreate(const std::string& path, const std::string& text)
+{
+    const std::string tmp = path + ".tmp";
+    char b[96];
+    HANDLE h = ::CreateFileA(tmp.c_str(), GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+    if (h == INVALID_HANDLE_VALUE) {
+        std::snprintf(b, sizeof(b), "create %s.tmp failed (err %lu)", "Pci1203Modules.ini", (unsigned long)::GetLastError());
+        return b;
+    }
+    DWORD put = 0;
+    const BOOL w = ::WriteFile(h, text.data(), (DWORD)text.size(), &put, NULL);
+    const BOOL f = w ? ::FlushFileBuffers(h) : FALSE;
+    const DWORD we = ::GetLastError();
+    ::CloseHandle(h);
+    if (!w || !f || put != (DWORD)text.size()) {
+        ::DeleteFileA(tmp.c_str());
+        std::snprintf(b, sizeof(b), "write .tmp failed (err %lu)", (unsigned long)we);
+        return b;
+    }
+    if (!::MoveFileExA(tmp.c_str(), path.c_str(), MOVEFILE_WRITE_THROUGH)) {    // NO MOVEFILE_REPLACE_EXISTING: never overwrite
+        const DWORD me = ::GetLastError();
+        ::DeleteFileA(tmp.c_str());
+        if (me == ERROR_ALREADY_EXISTS || me == ERROR_FILE_EXISTS)
+            std::snprintf(b, sizeof(b), "the ini already exists (err %lu) - left as it is", (unsigned long)me);
+        else
+            std::snprintf(b, sizeof(b), "rename .tmp -> ini failed (err %lu)", (unsigned long)me);
+        return b;
+    }
+    return std::string();
+}
+
+void W906_Pci1203ModuleCheckTick()
+{
+    ht9045::TPci1203Monitor* mon = ht9045::Pci1203Monitor();
+    if (!mon) return;
+    static ht9045::Pci1203ModuleCheck s_check;
+    static unsigned long s_restoreSeen = 0;
+    if (s_restoreSeen != g_w906Pci1203LinkRestoreGen) { s_restoreSeen = g_w906Pci1203LinkRestoreGen; s_check.OnLinkRestored(); }
+    SYSTEMTIME st;
+    ::GetLocalTime(&st);
+    char clock[32];
+    std::snprintf(clock, sizeof(clock), "%04d-%02d-%02d %02d:%02d:%02d", st.wYear, st.wMonth, st.wDay, st.wHour, st.wMinute, st.wSecond);
+    const std::string path = W906_Pci1203ModuleIniPath();
+    const ht9045::Pci1203ModuleInput in = ht9045::Pci1203ModuleInputFromMonitor(*mon,
+        [](const ht9045::Pci1203SlaveSample& s) { std::string why; return ht9045::Pci1203Vc8IdentityOk(s, why); },
+        g_w906Pci1203LinkLost);
+    const ht9045::Pci1203ModuleCheck::Result r =
+        s_check.Step(in, (unsigned long)::GetTickCount(), clock, [&path]() { return W906_Pci1203ModuleIniLoad(path); });
+    const std::string sec = std::to_string((int)(ht9045::kPci1203ModCheckMs / 1000));   // the header's one constant
+    if (!r.startText.empty()) {
+        std::printf("[1203-mod] %s\n", r.startText.c_str());
+        OpLine("LINK", "1203 模組檢查開始（" + sec + " 秒內比對 " + path + "） / " + r.startText);
+    }
+    switch (r.event) {
+    case ht9045::Pci1203ModuleCheck::kWriteIni: {
+        const std::string err = W906_Pci1203ModuleIniCreate(path, r.iniText);
+        if (err.empty()) {
+            std::printf("[1203-mod] %s -> %s written\n", r.text.c_str(), path.c_str());
+            OpLine("LINK", "1203 第一次連線，模組清單已建立（之後只讀不寫） " + path + " / " + r.text);
+        } else {
+            std::printf("[1203-mod] %s -> NOT written: %s\n", r.text.c_str(), err.c_str());
+            OpLine("LINK", "1203 模組清單沒有寫入（" + err + "） / " + r.text);
+        }
+        break;
+    }
+    case ht9045::Pci1203ModuleCheck::kWriteSkipped:
+        std::printf("[1203-mod] %s\n", r.text.c_str());
+        OpLine("LINK", "1203 模組清單不寫（掃描不完整，下次連線再試） / " + r.text);
+        break;
+    case ht9045::Pci1203ModuleCheck::kIniBad:
+        std::printf("[1203-mod] %s\n", r.text.c_str());
+        OpLine("LINK", "1203 模組清單讀不懂，這次不檢查（不會覆寫它） / " + r.text);
+        break;
+    case ht9045::Pci1203ModuleCheck::kPass:
+        std::printf("[1203-mod] %s\n", r.text.c_str());
+        OpLine("LINK", "1203 模組檢查通過 / " + r.text);
+        break;
+    case ht9045::Pci1203ModuleCheck::kAlarm:
+        std::printf("[1203-mod] ALARM WAR16154: %s\n", r.text.c_str());
+        std::fflush(stdout);
+        OpLine("LINK", "1203 模組檢查不符（缺少／未進 OP／站號變更／多出）-> 跳 WAR16154 / " + r.text);
+        WdMark("1203 module check -> ShowErrorMessage(WAR16154)");
+        ShowErrorMessage("WAR16154", 0, MMSystem, false, AnsiString(r.text.c_str()));   // same shape as WAR16152 above
+        break;
+    case ht9045::Pci1203ModuleCheck::kAbandoned:
+        std::printf("[1203-mod] %s\n", r.text.c_str());
+        OpLine("LINK", "1203 檢查中斷線，這次不判（恢復後重查） / " + r.text);
+        break;
+    default:
+        break;
+    }
+}
