+    CHECK(fProductionInfo->iLastArmSiteBinQty[1][3][7][8] == 0,
+          "ClearData (Greatek+IPSC): CalculateNowArmSiteBinQty(true) zeroed iLastArmSiteBinQty (golden :894)");
+
+    CUSTOMER_CODE = CC_Greatek + 1;                                            // not Greatek: both bodies are no-ops
+    std::memset(&OldControlBinCategory, 0x5A, sizeof(OldControlBinCategory));
+    static TEST_CATEGORY sentinel;                                             // large struct: not on the stack
+    std::memset(&sentinel, 0x5A, sizeof(sentinel));
+    fProductionInfo->iLastArmSiteBinQty[1][3][7][8] = 7;
+    f.ClearData(0, 0);
+    CHECK(std::memcmp(&OldControlBinCategory, &sentinel, sizeof(TEST_CATEGORY)) == 0, "ClearData (not Greatek): Old left untouched");
+    CHECK(fProductionInfo->iLastArmSiteBinQty[1][3][7][8] == 7, "ClearData (not Greatek): iLastArmSiteBinQty left untouched");
+
+    CUSTOMER_CODE = savedCC;
+    IniConfig.bN14_1_EnableOEEFunction = savedOEE;
+    IniConfig.bN14_16_EnableIPSC = savedIPSC;
+    fProductionInfo->iLastArmSiteBinQty[1][3][7][8] = 0;
+    for (int k = 0; k < 3; k++) ArmData[k]->ClearALLCT();
