+        GetStaTable_HeaterInsOpt(g_StaTable_HeaterInsOpt, bJustForShowItem);  //fix: arg order (int*, bool)
+        g_bGetStaTable_HeaterInsOpt_Already = true;
+    }
+    return (g_StaTable_HeaterInsOpt[iHeaterInsOpt_Cmp]>0);
+}
