+    }
+    HGem = savedGem;
+    CosFunction.bEnable_SECS_GEM = savedSecs;
+
+    // ---- 5. source pins ------------------------------------------------------
+    if (argc > 1) {
+        const std::string src = argv[1];
+        const std::vector<std::string> sl = LiveLines(Read(src + "/forms/fMain_SetLotState.cpp"));
