+        MotorAccessOutcome o = mm[i].a.Is1203() ? Move1203(r2, wireId, be, mm[i], target, true, goPct)   //AI(W906-TEACHGO-SPD) 20261007: the page's speed, was 20.  // Steven 20210723 : Go按鈕速度提升到20%
+                                                : MoveGolden(r2, be, mm[i], target, true, goPct);
         if (!o.ok) return RefuseT(who + ": " + o.ackJson + moving, ec);
         done += "; axis " + std::to_string(i + 1) + " -> " + std::to_string(target);
     }
