diff --git a/EtherCAT/Pci1203Monitor.cpp b/EtherCAT/Pci1203Monitor.cpp
index 35402f6..1779b4a 100644
--- a/EtherCAT/Pci1203Monitor.cpp
+++ b/EtherCAT/Pci1203Monitor.cpp
@@ -4524,7 +4524,7 @@ void Pci1203IoThreadRunSync(void (*fn)(void*), void* arg, bool boundaryOnly)
     //  frozen kW906IoStallMs = the thread is stuck (a vendor call that does not return): take the request back and refuse it, so
     //  the caller fails visibly instead of freezing the tick loop. Already taken = the thread is running THIS request (its data is
     //  on this stack frame), so keep waiting -- and say so every 5 s.
-    const DWORD t0 = ::GetTickCount();
+    const DWORD t0 = ::GetTickCount();  LARGE_INTEGER w906Q0; ::QueryPerformanceCounter(&w906Q0);   //AI(W906-IOWAIT) 20261008: the wait is timed for the pass profiler (end of file)
     long hb0 = g_w906IoHeart;
     DWORD hbAt = t0, noteAt = t0;   //AI(W906-IOFIX-3) 20261007: back to the request time (IOFIX-2 started it at the last heartbeat; review 20261007: a long but alive Poll then refused queued STOPs)
     for (;;) {
@@ -4559,7 +4559,7 @@ void Pci1203IoThreadRunSync(void (*fn)(void*), void* arg, bool boundaryOnly)
             std::fflush(stdout);
         }
     }
-    ::CloseHandle(r.done);
+    ::CloseHandle(r.done);  { void W906IoWaitNote_(const LARGE_INTEGER&); W906IoWaitNote_(w906Q0); }   //AI(W906-IOWAIT) 20261008: every way out of the wait above ends here (end of file)
 }
 
 bool Pci1203IoThreadAdopt()
@@ -4763,4 +4763,21 @@ void W906IoAfterSuspendWait_()
                 (unsigned long)(now - last), (unsigned long)(t1 - t0), got ? "got one, carrying on" : "none came, the stale rule applies");
     std::fflush(stdout);
 }
+}  // namespace ht9045
+
+//AI(W906-IOWAIT) 20261008: EastSun 1008「請你繼續優化執行續」-- how long the main thread waits for the IO thread. oplog 1008: PumpTick
+//  (MainProc) 621.9 ms in a pass whose tick-thread CPU was 18.9 ms, MotorAccessPollTick 89.2 ms in another -- waiting, not computing.
+//  Every card request from the main thread (TPci1203Control::Execute -- DO writes, motion; Vc8SdoReadI16; SetTorqueFocusAxis) waits in
+//  Pci1203IoThreadRunSync until the IO thread has run it. Each such wait is timed (QPC) and handed to g_W906IoWaitHook, which
+//  wb_serve's pass profiler sets (tools/wb_serve.cpp W906PpIoWait): the SLOW line then shows per phase how much of it was this wait
+//  and how many requests. Nothing else changes; no hook (ctests, tools) = nothing is done.
+namespace ht9045 {
+void (*g_W906IoWaitHook)(long long qpcTicks) = 0;
+void W906IoWaitNote_(const LARGE_INTEGER& q0)
+{
+    if (g_W906IoWaitHook == 0) return;
+    LARGE_INTEGER q1;
+    ::QueryPerformanceCounter(&q1);
+    g_W906IoWaitHook((long long)(q1.QuadPart - q0.QuadPart));
+}
 }  // namespace ht9045
\ No newline at end of file
