+//---------------------------------------------------------------------------
+// AI(W906-W187) 20261009: golden 913 SECSGEM/uHGemClass.cpp:2216-2235 (Ifor 20260625: SEMI E5 conformant
+// S9Fx sender), declared at :915, called by S9F1/S9F3/S9F5/S9F7/S9F9 above.  The S9Fx body is <B[10]> = the
+// 10-byte header of the message being rejected (DeviceID, S with the W-bit, F, PType, SType, SystemByte).
+// Golden takes `THGem *p` (HGemPtr); the port's handlers compose on ActiveWire (the codec that holds
+// Remote and Local), so p is that codec -- same calls, same order.
+//---------------------------------------------------------------------------
+static void SendS9FxEchoHeader(SecsWireCodec *p, int FCode, AnsiString LogMsg)
+{
+    if(p==NULL)
+        return;
+    p->StringOut(LogMsg);
+    p->InitLocalHead(9, FCode, 0);
+    unsigned char hdr[10];
+    hdr[0] = (unsigned char)((p->Remote.DeviceID >> 8) & 0xff);
+    hdr[1] = (unsigned char)( p->Remote.DeviceID       & 0xff);
+    hdr[2] = (unsigned char)(p->Remote.MessageID_S | (p->Remote.W_Bit ? 0x80 : 0));
+    hdr[3] = (unsigned char) p->Remote.MessageID_F;
+    hdr[4] = (unsigned char) p->Remote.PType;
+    hdr[5] = (unsigned char) p->Remote.SType;
+    hdr[6] = (unsigned char)((p->Remote.SystemByte >> 24) & 0xff);
+    hdr[7] = (unsigned char)((p->Remote.SystemByte >> 16) & 0xff);
+    hdr[8] = (unsigned char)((p->Remote.SystemByte >>  8) & 0xff);
+    hdr[9] = (unsigned char)( p->Remote.SystemByte        & 0xff);
+    p->DataItemOut(10, HType.BINARY_TYPE, hdr);
+    p->SendLocalData();
+}
