+void W906_DoCleanOutWatchdog913()
+{
+    //AI(ht9045-staterecord-analysis) 20260811 (RogerYang) : clean-out watchdog 只做診斷, 不報警/不停機/不存 state record
+    //  A: 用 gap 偵測, PAUSE/開門/alarm dialog 期間 MainProc 不會呼叫本函式, 那段時間不計入
+    //  B: 門檻改用 soak time 動態算, hot 模式最後一批 hotplate 料本來就要等滿 soak
+    //  C: 只寫 EventLog, 不再自動存 state record
+    static HTimer hCleanOutWD;
+    static HTimer hCleanOutWDGap;                                               //距上次進入本函式的間隔
+    static bool   bCleanOutWDArmed=false;
+
+    int iCleanOutWDSec=300;                                                     //常溫 5 分鐘
+    if(LastSet.iTemperature==Tempture_Hot)
+        iCleanOutWDSec=Prod.iHotTime+300;                                       //Hot: soak time + 5 分鐘邊際
+
+    if(iCleanOut!=1)
+    {
+        bCleanOutWDArmed=false;                                                 //不在 clean out -> 解除
+    }
+    else if(bCleanOutWDArmed==false)
+    {
+        hCleanOutWD.SetSecAndOn(iCleanOutWDSec);                                //clean out 開始 -> 開始計時
+        bCleanOutWDArmed=true;
+    }
+    else if(hCleanOutWDGap.Off())                                               //超過 5 秒沒進來過 = 機台沒在跑, 重新計時
+    {
+        hCleanOutWD.SetSecAndOn(iCleanOutWDSec);
+    }
+    else if(hCleanOutWD.Off())                                                  //機台持續在跑 但 clean out 一直沒完成
+    {
+        MOT[MTestZ1].ScanMotorStatus(); MOT[MTestZ2].ScanMotorStatus(); MOT[MOutArmY].ScanMotorStatus();
+        AnsiString sDiag;
+        sDiag.sprintf("CleanOut STUCK cyc=%d wd=%d | TZ1 enc=%d cmd=%d safe=%d inpos=%d alm=%d mov=%d | "
+                      "TZ2 enc=%d cmd=%d safe=%d inpos=%d alm=%d mov=%d | OutY enc=%d cmd=%d inpos=%d alm=%d mov=%d | EPflow=%d",
+            iCleanOutCycleTask, iCleanOutWDSec,
+            MOT[MTestZ1].ReadPos(),MOT[MTestZ1].Gali_ReadPos(),Prod.TestZ1_Safe,(int)MOT[MTestZ1].Led[iInposLed],(int)MOT[MTestZ1].Led[iAlarmLed],(int)MOT[MTestZ1].MovFlag,
+            MOT[MTestZ2].ReadPos(),MOT[MTestZ2].Gali_ReadPos(),Prod.TestZ2_Safe,(int)MOT[MTestZ2].Led[iInposLed],(int)MOT[MTestZ2].Led[iAlarmLed],(int)MOT[MTestZ2].MovFlag,
+            MOT[MOutArmY].ReadPos(),MOT[MOutArmY].Gali_ReadPos(),(int)MOT[MOutArmY].Led[iInposLed],(int)MOT[MOutArmY].Led[iAlarmLed],(int)MOT[MOutArmY].MovFlag,
+            (int)Sen[SnEPDetect].IsOn());
+        NewRecordProcess("", sDiag, "CleanOutWatchdog");                        //只寫 EventLog, 不存 state record
+        hCleanOutWD.SetSecAndOn(iCleanOutWDSec);
+    }
+    hCleanOutWDGap.SetSecAndOn(5);                                              //每次進來服務一次, 重設 gap 計時
+}
+
+void W906_CleanOutResetPickHPRec913()
+{
+        //AI(ht9045-inarm-flow) 20260831 (RogerYang) : 原本無條件 ResetFile -- 前提「Clean Out 完成=熱盤已空」在被 One Cycle/ASM 提前結束時不成立,
+        //AI : 盤上還有料卻把帳清光, 那些料就變孤兒 -> GetHPFirstTeamPlate 空轉500 -> No GetHPFirstTeamMotUse 停機(HHT-76)
+        if(MOT[MMPlate1].Tray.HasRealIC()==false &&
+           MOT[MMPlate2].Tray.HasRealIC()==false)                                   //AI : HasRealIC 排除 HAS_NULL_IC 佔位符, 不可用 HasIC()(它把佔位符當有料)
+        {
+            PickFromHPList->ResetFile(sHPPickRec);                                  //Jimmychiu 20250220 : 避免重新開機後Hotplate rec有殘留資料
+            RecordProcess("CleanOut finish : HP empty, ResetFile PickHPRec", "DoCleanOutFinishCheck");   //AI : if分支也要留痕, 否則看到0命中無法區分「沒執行到」與「執行了且盤是空的」
+        }
+        else
+        {
+            AnsiString StrHPKeep;                                                   //AI : 盤上還有真料 -> 清帳本會製造孤兒, 保留帳本並留痕
+            StrHPKeep.sprintf("CleanOut finish : HP still has real IC (P0=%d P1=%d), keep PickHPRec to avoid orphan",
+                              MOT[MMPlate1].Tray.HowManyIC(), MOT[MMPlate2].Tray.HowManyIC());
+            RecordProcess(StrHPKeep, "DoCleanOutFinishCheck");
+        }
+}
