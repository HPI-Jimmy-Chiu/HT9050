---
 uhome.cpp | 28 +++++++++++++++++++++++++++-
 1 file changed, 27 insertions(+), 1 deletion(-)

diff --git a/uhome.cpp b/uhome.cpp
index 37d960e..9a654bc 100644
--- a/uhome.cpp
+++ b/uhome.cpp
@@ -705,6 +705,7 @@ void TfHome::InitGali_HomeTask()
 //AI(W906-HOME-ALMRESET) 20261003: case 300 -> 302 (alarm reset + servo ON of every enabled motor, then the check); see case 302
 static TQPF_Timer s_W906HomeResetWait;
 static int        s_W906HomeAfterReset = 310;
+static int        s_W906HomeResetTries = 0;   //AI(W906-HOME-ALMRESET-2) 20261003: 1 s retries before an axis counts as abnormal (the motor power relay comes back ~4 s after HOME starts)
 bool ProcessMotorHome(bool Flag2)
 {
 #ifndef SOFT_SIMULTE
@@ -2270,6 +2271,7 @@ bool ProcessMotorHome(bool Flag2)
             s_W906HomeAfterReset=fHome->iHomeStep;                              //AI(W906-HOME-ALMRESET) 20261003: golden's next step, taken after the check
             fHome->iHomeStep=302;
             s_W906HomeResetWait.SetMSAndOn(500);                                //  0.5 s: the drives answer the reset / Servo ON (also the brakes' servo-ON 0.5 s rule)
+            s_W906HomeResetTries=0;
             MotorTask=FIRST_HOME;                                               //第一階段回Home
             for(int i=0; i<TOTAL_MOTOR; i++)
             {
@@ -2298,6 +2300,7 @@ bool ProcessMotorHome(bool Flag2)
                     if(fHome->HomeClass[i]->THomeFlag==0 || MOT[i].Motor==NULL || MOT[i].Motor->Enable==false)
                         continue;
                     MOT[i].ScanMotorStatus();
+                    { extern bool W906_GaliRouteOwns(int); if(W906_GaliRouteOwns(MOT[i].Mot_Name)) MOT[i].Gali_ScanMotStatusTIMO(); }   //AI(W906-HOME-ALMRESET-2) 20261003: EastSun「M14 沒有 ALARM 阿」-- the Galil-routed Index Z (M14 MTestZ1) never gets Led[iServoOn] from ScanMotorStatus (Gali_ScanMotStatus has no servo bit); golden's own Galil home reads it with Gali_ScanMotStatusTIMO (MG_MOY, myGALILmotor.cpp case 8), so this check does too
                     const bool alm  = MOT[i].GetMotorAlarm();
                     const bool svOn = MOT[i].Led[iServoOn];
                     if(alm || !svOn)
@@ -2311,7 +2314,30 @@ bool ProcessMotorHome(bool Flag2)
                         sBad += one;
                     }
                 }
-                if(iBad>=0)                                                     //  an axis still in alarm / not excited after the reset: HOME stops,
+                //AI(W906-HOME-ALMRESET-2) 20261003: EastSun「你alarm 全機歸原點就要停了」-- 18:36:53 HOME started, the motor power relay went
+                //  1->0 and came back 0->1 at 18:36:57 (DoMotorPowerOn, case 1), so a single check at 0.5 s saw every drive unexcited and
+                //  stopped HOME with "Motor not home yet". Now: re-send Alarm Reset + Servo ON to the abnormal axes every 1 s and only
+                //  after 20 retries (~20 s) count them abnormal.
+                if(iBad>=0 && s_W906HomeResetTries<20)
+                {
+                    ++s_W906HomeResetTries;
+                    for(int i=0; i<TOTAL_MOTOR; i++)
+                    {
+                        if(fHome->HomeClass[i]->THomeFlag==0 || MOT[i].Motor==NULL || MOT[i].Motor->Enable==false)
+                            continue;
+                        if(MOT[i].GetMotorAlarm() || !MOT[i].Led[iServoOn])
+                        {
+                            MOT[i].Motor->ResetState();
+                            MOT[i].ServoOnOff(true);
+                            fHome->ShowLed(i, 3);                               //  back to "in progress" while it is retried
+                        }
+                    }
+                    if(s_W906HomeResetTries==1 || s_W906HomeResetTries%5==0)
+                        fHome->ListBox1->Items->Insert(0, AnsiString(("Waiting for alarm reset / servo on: " + sBad).c_str()));
+                    s_W906HomeResetWait.SetMSAndOn(1000);
+                    break;
+                }
+                if(iBad>=0)                                                     //  an axis still in alarm / not excited after the retries: HOME stops,
                 {                                                               //  the first one gets golden's motor jam popup, the list goes to the listbox
                     std::printf("[HOME] after Alarm Reset + Servo ON, %d motor(s) abnormal: %s\n", nBad, sBad.c_str());
                     fHome->ListBox1->Items->Insert(0, AnsiString(("Abnormal after alarm reset / servo on: " + sBad).c_str()));
