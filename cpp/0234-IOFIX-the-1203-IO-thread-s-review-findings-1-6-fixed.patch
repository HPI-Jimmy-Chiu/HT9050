@@ -1867,7 +1867,7 @@ bool TPci1203Monitor::Rescan(std::string& why)
     //  handles is not possible -- they were closed -- and pretending the old
     //  scan is still valid would leave the page describing a ring that is no
     //  longer there, which is exactly what this call exists to prevent.
-    return ok;
+    if (Pci1203OnIoThread()) W906IoStage_(impl_->ioStaged, impl_->ioPub, impl_->cardS, impl_->axes, impl_->dis, impl_->dos, impl_->slaves, impl_->opened, impl_->disabled, impl_->disabledWhy);  return ok;   //AI(W906-IOFIX) 20261006: review #1 / #5 -- publish the new map (or the closed card) at once; Pci1203Control::Execute adopts it before returning
 }
 
 void TPci1203Monitor::Close()
@@ -2058,7 +2058,7 @@ int TPci1203Monitor::slaveCount() const { if (const Pci1203IoSnap* v = W906IoVie
 // ---------------------------------------------------------------------------
 bool TPci1203Monitor::Poll()
 {
-    if (Pci1203IoThreadRunning() && !Pci1203OnIoThread()) { Pci1203IoThreadAdopt(); return true; }  if (!impl_ || !impl_->opened || impl_->disabled) return false;   //AI(W906-IOTHREAD) 20261005: while the IO thread runs it is the only poller -- a Poll() from any other thread takes the newest published poll instead of reading the card. Same line
+    if (Pci1203IoThreadRunning() && !Pci1203OnIoThread()) { Pci1203IoThreadAdopt(); return true; }  if (!impl_ || !impl_->opened || impl_->disabled) { if (impl_ && Pci1203OnIoThread()) W906IoStage_(impl_->ioStaged, impl_->ioPub, impl_->cardS, impl_->axes, impl_->dis, impl_->dos, impl_->slaves, impl_->opened, impl_->disabled, impl_->disabledWhy); return false; }   /*AI(W906-IOFIX) 20261006: review #1 -- the closed / disabled card is published too (a failed Rescan left the old "open" copy for good: WAR16152 blinded)*/   //AI(W906-IOTHREAD) 20261005: while the IO thread runs it is the only poller -- a Poll() from any other thread takes the newest published poll instead of reading the card. Same line
 
 #if !HAVE_PCI1203
     return false;
@@ -3125,6 +3125,7 @@ bool Pci1203MonitorEnable(unsigned maxAxes, unsigned diPorts, std::string& why,
 
 void Pci1203MonitorDisable()
 {
+    if (g_monitor && Pci1203IoThreadAlive()) { std::printf("[IOTHREAD] Pci1203MonitorDisable: the IO thread is still alive -- the monitor is left open (the process exit releases the card)\n"); std::fflush(stdout); return; }   //AI(W906-IOFIX) 20261006: review #4 -- never Close / delete under a live IO thread
     if (g_monitor) {
         g_monitor->Close();
         delete g_monitor;
@@ -4409,6 +4410,11 @@ Pci1203IoSnap*   g_w906IoStagedP = 0;             // registered by the first sta
 Pci1203IoSnap*   g_w906IoPubP = 0;
 unsigned long    g_w906IoStagedSeq = 0;
 unsigned long    g_w906IoPubSeq = 0;
+volatile long    g_w906IoStagedTick = 0;          //AI(W906-IOFIX) 20261006: review #3 -- GetTickCount of the newest stage (0 = none yet)
+volatile long    g_w906IoAbandoned = 0;           //AI(W906-IOFIX) 20261006: review #4 -- Stop timed out with the thread still alive: proxies refuse
+bool             g_w906IoStaleMarked = false;     //AI(W906-IOFIX) 20261006: review #3 -- the published copy is marked "card not open" because nothing new came
+const unsigned long kW906IoStallMs = 5000;        //AI(W906-IOFIX) 20261006: review #2 -- a queued request with the heartbeat frozen this long is refused
+const unsigned long kW906IoStaleMs = 3000;        //AI(W906-IOFIX) 20261006: review #3 -- no publish this long = the IO image is stale (one poll is ~0.1 s)
 
 void W906IoCsInit_()
 {
@@ -4432,6 +4438,12 @@ DWORD WINAPI W906IoThreadMain_(void*)
         ::WaitForSingleObject(g_w906IoWake, (DWORD)g_w906IoGapMs);
     }
     W906IoServe_(true);                                // nobody is left waiting on a request
+    //AI(W906-IOFIX) 20261006: review #4 -- the thread leaves the card to the main thread ITSELF, before it returns: a RunSync that
+    //  wakes on the thread handle then runs its request inline on the direct path (it used to re-enter the proxy without end when
+    //  Stop had timed out), and the readers go back to the monitor, which nobody writes any more.
+    ::InterlockedExchange(&g_w906IoPubReady, 0);
+    ::InterlockedExchange(&Pci1203IoState().running, 0);
+    g_w906IoTid = 0;
     return 0;
 }
 }  // namespace
@@ -4455,6 +4467,7 @@ void W906IoStage_(Pci1203IoSnap*& staged, Pci1203IoSnap*& pub, const Pci1203Card
     ++g_w906IoStagedSeq;
     g_w906IoStagedP = staged;
     g_w906IoPubP = pub;
+    ::InterlockedExchange(&g_w906IoStagedTick, (long)::GetTickCount());   //AI(W906-IOFIX) 20261006: review #3 -- when it was published
     ::LeaveCriticalSection(&g_w906IoScs);
 }
 
@@ -4489,52 +4502,107 @@ void Pci1203IoThreadRunSync(void (*fn)(void*), void* arg, bool boundaryOnly)
 {
     if (fn == 0) return;
     if (!Pci1203IoThreadRunning() || Pci1203OnIoThread() || !g_w906IoCsInit || g_w906IoThread == 0) { fn(arg); return; }
+    //AI(W906-IOFIX) 20261006: review #4 -- Stop timed out and the thread is still alive: refuse (no queue, no re-entry); the
+    //  caller's result stays its default "not accepted". Once the thread really ends it clears `running` itself (thread main).
+    if (g_w906IoAbandoned) {
+        static unsigned long s_said = 0;
+        if (s_said++ == 0) std::printf("[IOTHREAD] card request refused: the IO thread did not stop in time and still owns the card\n");
+        return;
+    }
     W906IoReq r;
     r.fn = fn;  r.arg = arg;  r.boundaryOnly = boundaryOnly;
     r.done = ::CreateEventA(NULL, TRUE, FALSE, NULL);
-    if (r.done == 0) { std::printf("[IOTHREAD] CreateEvent failed -- request run on the IO thread by polling\n"); }
+    if (r.done == 0) {                                 //AI(W906-IOFIX) 20261006: review (low) -- no polling fallback any more (its "not queued and
+        std::printf("[IOTHREAD] CreateEvent failed -- card request refused, not run\n");   //  not serving" test could return before the request ran)
+        return;
+    }
     ::EnterCriticalSection(&g_w906IoQcs);
     g_w906IoQ.push_back(&r);
     ::LeaveCriticalSection(&g_w906IoQcs);
     ::SetEvent(g_w906IoWake);
+    //AI(W906-IOFIX) 20261006: review #2 -- wait in 500 ms slices, watching the IO thread's heartbeat. Still queued with the heartbeat
+    //  frozen kW906IoStallMs = the thread is stuck (a vendor call that does not return): take the request back and refuse it, so
+    //  the caller fails visibly instead of freezing the tick loop. Already taken = the thread is running THIS request (its data is
+    //  on this stack frame), so keep waiting -- and say so every 5 s.
+    const DWORD t0 = ::GetTickCount();
+    long hb0 = g_w906IoHeart;
+    DWORD hbAt = t0, noteAt = t0;
     for (;;) {
-        if (r.done != 0) {
-            HANDLE hs[2] = { r.done, g_w906IoThread };
-            const DWORD w = ::WaitForMultipleObjects(2, hs, FALSE, INFINITE);
-            if (w == WAIT_OBJECT_0) break;
-        } else {
-            bool queued = false;
+        HANDLE hs[2] = { r.done, g_w906IoThread };
+        const DWORD w = ::WaitForMultipleObjects(2, hs, FALSE, 500);
+        if (w == WAIT_OBJECT_0) break;
+        if (w == WAIT_OBJECT_0 + 1) {
+            //  The IO thread ended (it cleared `running` before it returned). If it never took the request, run it here: the card
+            //  has one caller again and fn takes the direct path.
+            bool mine = false;
             ::EnterCriticalSection(&g_w906IoQcs);
-            for (std::size_t i = 0; i < g_w906IoQ.size(); ++i) if (g_w906IoQ[i] == &r) { queued = true; break; }
+            for (std::size_t i = 0; i < g_w906IoQ.size(); ++i) if (g_w906IoQ[i] == &r) { g_w906IoQ.erase(g_w906IoQ.begin() + (std::ptrdiff_t)i); mine = true; break; }
             ::LeaveCriticalSection(&g_w906IoQcs);
-            if (!queued && g_w906IoServingMain == 0) break;
-            if (::WaitForSingleObject(g_w906IoThread, 1) != WAIT_OBJECT_0) continue;
+            if (mine) fn(arg);
+            break;                                     // otherwise it was served before the thread returned (the drain on exit)
         }
-        //  The IO thread ended. If it never took the request, run it here: the card has one caller again.
-        bool mine = false;
+        const DWORD now = ::GetTickCount();
+        if (g_w906IoHeart != hb0) { hb0 = g_w906IoHeart; hbAt = now; }
+        bool queued = false, refused = false;
         ::EnterCriticalSection(&g_w906IoQcs);
-        for (std::size_t i = 0; i < g_w906IoQ.size(); ++i) if (g_w906IoQ[i] == &r) { g_w906IoQ.erase(g_w906IoQ.begin() + (std::ptrdiff_t)i); mine = true; break; }
+        for (std::size_t i = 0; i < g_w906IoQ.size(); ++i) if (g_w906IoQ[i] == &r) { queued = true; if ((DWORD)(now - hbAt) >= kW906IoStallMs) { g_w906IoQ.erase(g_w906IoQ.begin() + (std::ptrdiff_t)i); refused = true; } break; }
         ::LeaveCriticalSection(&g_w906IoQcs);
-        if (mine) fn(arg);
-        break;                                         // otherwise it was served before the thread returned (the drain on exit)
+        if (refused) {
+            std::printf("[IOTHREAD] the IO thread made no poll for %lu ms (heartbeat frozen) -- card request refused, not run\n", (unsigned long)(now - hbAt));
+            std::fflush(stdout);
+            break;
+        }
+        if ((DWORD)(now - noteAt) >= 5000) {
+            noteAt = now;
+            std::printf("[IOTHREAD] still waiting %lu ms for a card request (%s; heartbeat %s)\n", (unsigned long)(now - t0),
+                        queued ? "queued" : "being run by the IO thread", (DWORD)(now - hbAt) >= 1000 ? "frozen" : "moving");
+            std::fflush(stdout);
+        }
     }
-    if (r.done != 0) ::CloseHandle(r.done);
+    ::CloseHandle(r.done);
 }
 
 bool Pci1203IoThreadAdopt()
 {
     if (!Pci1203IoThreadRunning() || !g_w906IoCsInit || Pci1203OnIoThread()) return false;
-    bool fresh = false;
+    bool fresh = false, staleNow = false;
+    unsigned long ageMs = 0;
     ::EnterCriticalSection(&g_w906IoScs);
     if (g_w906IoStagedP != 0 && g_w906IoPubP != 0 && g_w906IoStagedSeq != g_w906IoPubSeq) {
-        *g_w906IoPubP = *g_w906IoStagedP;               // copy-assign: same vectors, element references stay put
+        *g_w906IoPubP = *g_w906IoStagedP;               // copy-assign: same vectors, element references stay put (a stale mark is overwritten too)
         g_w906IoPubSeq = g_w906IoStagedSeq;
         fresh = true;
+        g_w906IoStaleMarked = false;
+    } else if (g_w906IoPubP != 0 && g_w906IoStagedTick != 0 && !g_w906IoStaleMarked) {
+        //AI(W906-IOFIX) 20261006: review #3 -- nothing new for kW906IoStaleMs: the IO image is frozen. Mark the copy the main thread
+        //  reads "card not open" (LinkWatch case 3 -> WAR16152 after 10 s; routes refuse); the next real publish replaces it whole.
+        ageMs = (unsigned long)((DWORD)::GetTickCount() - (DWORD)g_w906IoStagedTick);
+        if (ageMs >= kW906IoStaleMs) {
+            g_w906IoPubP->cardS.open = false;
+            g_w906IoPubP->opened = false;
+            char b[160];
+            std::snprintf(b, sizeof(b), "1203 IO thread: no new poll for %lu ms (IO image frozen)", ageMs);
+            g_w906IoPubP->cardS.lastErrorText = b;
+            g_w906IoStaleMarked = true;
+            staleNow = true;
+        }
     }
     ::LeaveCriticalSection(&g_w906IoScs);
+    if (staleNow) { std::printf("[IOTHREAD] no new poll for %lu ms -- the published IO image is marked 'card not open' (WAR16152 follows)\n", ageMs); std::fflush(stdout); }
     return fresh;
 }
 
+unsigned long Pci1203IoThreadPublishAgeMs()             //AI(W906-IOFIX) 20261006: review #3 -- 0 when not running / nothing published yet
+{
+    if (!Pci1203IoThreadRunning() || g_w906IoStagedTick == 0) return 0;
+    return (unsigned long)((DWORD)::GetTickCount() - (DWORD)g_w906IoStagedTick);
+}
+
+bool Pci1203IoThreadAlive()                              //AI(W906-IOFIX) 20261006: review #4 -- the thread exists and has not ended
+{
+    return g_w906IoThread != 0 && ::WaitForSingleObject(g_w906IoThread, 0) != WAIT_OBJECT_0;
+}
+
 bool Pci1203IoThreadSnapshotReady()
 {
     if (!Pci1203IoThreadRunning() || !g_w906IoCsInit) return false;
@@ -4589,10 +4657,14 @@ void Pci1203IoThreadStop(unsigned long waitMs)
     ::InterlockedExchange(&g_w906IoStop, 1);
     ::SetEvent(g_w906IoWake);
     if (::WaitForSingleObject(g_w906IoThread, (DWORD)waitMs) != WAIT_OBJECT_0) {
-        std::printf("[IOTHREAD] stop: the IO thread did not end within %lu ms -- left as it is (the process exit ends it)\n", waitMs);
+        ::InterlockedExchange(&g_w906IoAbandoned, 1);  //AI(W906-IOFIX) 20261006: review #4 -- card requests are refused from now on (no queue, no
+                                                       //  re-entry); the readers keep the published copy; Pci1203MonitorDisable / ControlDisable
+                                                       //  leave the objects alone while the thread is alive (Pci1203IoThreadAlive)
+        std::printf("[IOTHREAD] stop: the IO thread did not end within %lu ms -- abandoned: card requests refused, the monitor is not closed (the process exit ends it)\n", waitMs);
         std::fflush(stdout);
