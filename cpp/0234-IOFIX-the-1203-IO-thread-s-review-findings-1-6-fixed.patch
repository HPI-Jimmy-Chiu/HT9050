@@ -574,7 +574,7 @@ bool IsMotion(Pci1203CmdKind k)
 //  refused ones worked.
 Pci1203CmdResult TPci1203Control::Execute(const Pci1203Cmd& c)
 {
-    if (Pci1203IoThreadRunning() && !Pci1203OnIoThread()) { struct A_ { TPci1203Control* self; const Pci1203Cmd* c; Pci1203CmdResult r; } a_ = { this, &c, Pci1203CmdResult() }; Pci1203IoThreadRunSync([](void* p) { A_* q = static_cast<A_*>(p); q->r = q->self->Execute(*q->c); }, &a_, c.kind == kCmdCardRescan); return a_.r; }   //AI(W906-IOTHREAD) 20261005: while the IO thread runs it is the card's only caller -- the command runs there (at the next Poll yield point, i.e. within one vendor call; a card rescan only between two polls) and this thread waits for the same result as before. Same line
+    if (Pci1203IoThreadRunning() && !Pci1203OnIoThread()) { struct A_ { TPci1203Control* self; const Pci1203Cmd* c; Pci1203CmdResult r; } a_ = { this, &c, Pci1203CmdResult() }; Pci1203IoThreadRunSync([](void* p) { A_* q = static_cast<A_*>(p); q->r = q->self->Execute(*q->c); }, &a_, c.kind == kCmdCardRescan); if (c.kind == kCmdCardRescan) Pci1203IoThreadAdopt(); /*AI(W906-IOFIX) 20261006: review #5 -- Rescan published its new map (or the closed card) on the IO thread; take it before returning, so the next DO slot comes from the NEW map*/ return a_.r; }   //AI(W906-IOTHREAD) 20261005: while the IO thread runs it is the card's only caller -- the command runs there (at the next Poll yield point, i.e. within one vendor call; a card rescan only between two polls) and this thread waits for the same result as before. Same line
     const Pci1203CmdResult r = Run_(c);
     Pci1203LastCmd& L = impl_->last;
     L.valid     = true;
@@ -3014,7 +3014,7 @@ bool Pci1203ControlEnable(bool dryRun, std::string& why)
 
 void Pci1203ControlDisable()
 {
-    if (!g_control) return;
+    if (!g_control) return;  if (Pci1203IoThreadAlive()) { std::printf("[IOTHREAD] Pci1203ControlDisable: the IO thread is still alive -- the control object is left in place\n"); std::fflush(stdout); return; }   //AI(W906-IOFIX) 20261006: review #4
     g_control->Close();
     delete g_control;
     g_control = 0;
