+// =============================================================================
+//  AI(W906-1203REOPEN) 20261007: the 1203 RE-OPEN FLOW (stage 3). EastSun 1007「只要開卡異常或是 有沒有偵測到的模組 需要加個
+//  重新開卡流程 可能需要用到reset ring」; rulings (AskUserQuestion 1007): automatic while the machine is stopped + an operator
+//  button ("兩種都要"), reset only the ring with the problem, EVERY module-check problem retries ("所有問題都重開"), 10 s apart,
+//  3 tries per fault, the button gives 3 more, WAR16150 open card fail / WAR16157 re-open failed, simulation first.
+//  Plan D:\HT9045\_reopen_1007\PLAN_1203_REOPEN.md. The decision is EtherCAT/Pci1203Reopen.h (tests/test_pci1203_reopen.cpp);
+//  this is the host:
+//    * boot open failure (the "card NOT opened" branch)  -> W906_Pci1203ReopenOpenFailed: fault + WAR16150 at the next tick
+//    * module check kAlarm (after its WAR16154)            -> W906_Pci1203ReopenModules(ring mask of the problems)
+//    * module check kPass                                  -> W906_Pci1203ReopenPassed: recovered
+//    * main loop, next to the link watch                   -> W906_Pci1203ReopenTick: does what Step() asks --
+//        reset ring(s): Pci1203Control kCmdRingReset (Acm_MasResetRing, falling back to the whole-card Rescan)
+//        re-open card : Pci1203Control kCmdCardRescan (Close + Open)
+//      then fAllMotorHome = false (the drives lost power / their handles), the IO thread is started if it was not running
+//      (a boot that failed to open never started it), and a new module-check generation is armed (++LinkRestoreGen).
+//    * the 1203 page button "pci1203.card.reopen"          -> W906_Pci1203ReopenOperator (refused while running)
+//  "Stopped" = not SystemStart, no HOME step, no web HOME job, no 1203 axis in a motion state. Nothing is attempted otherwise.
+//  ⚠ Not done here (reported to EastSun): after a ring-1 reset the IO modules' outputs restart at 0 and stay there until the
+//  engine next writes them; there is no "resend every output" path in this tree yet.
+// =============================================================================
+#include "EtherCAT/Pci1203Reopen.h"
+namespace ht9045 { bool MotorAccessHomingActive(); }   // WebMotorAccess.h:531 (the web HOME job)
+namespace {
+ht9045::Pci1203Reopen g_w906Reopen;
+bool                  g_w906ReopenOpenAlarmPending = false;
+std::string           g_w906ReopenOpenWhy;
+std::string           g_w906ReopenLast = "no re-open attempted";
+}
+static bool W906_ReopenMachineStopped(std::string& why)
+{
+    if (SystemStart) { why = "machine running (SystemStart)"; return false; }
+    if (fHome != 0 && fHome->iHomeStep != 1) { why = "HOME running"; return false; }
+    if (ht9045::MotorAccessHomingActive()) { why = "a web HOME job is running"; return false; }
+    if (ht9045::TPci1203Monitor* m = ht9045::Pci1203Monitor()) {
+        if (m->Open_()) {
+            for (int i = 0; i < m->axisCount(); ++i) {
+                const unsigned short s = m->axis(i).state;
+                if (s == 2 || (s >= 4 && s <= 14)) { why = "a 1203 axis is moving"; return false; }
+            }
+        }
+    }
+    return true;
+}
+void W906_Pci1203ReopenOpenFailed(const std::string& why)
+{
+    g_w906Reopen.Fault(ht9045::kRfOpenFail);
+    g_w906ReopenOpenAlarmPending = true;
+    g_w906ReopenOpenWhy = why;
+}
+void W906_Pci1203ReopenModules(unsigned ringMask)
+{
+    g_w906Reopen.Fault(ht9045::kRfModules, ringMask);
+    std::printf("[1203-reopen] module check problems on ring mask %u -> re-open queued (try %d of %d so far)\n",
+                ringMask, g_w906Reopen.Tries(), ht9045::Pci1203Reopen::kTries);
+    std::fflush(stdout);
+}
+void W906_Pci1203ReopenPassed()
+{
+    g_w906Reopen.Recovered();
+}
+std::string W906_Pci1203ReopenOperator()
+{
+    std::string why;
+    if (!W906_ReopenMachineStopped(why)) return "refused: " + why + " -- stop the machine first";
+    g_w906Reopen.OperatorRetry();
+    OpLine("LINK", "1203 重新開卡：操作員按下（再試 3 次）");
+    return std::string();
+}
+static ht9045::Pci1203CmdResult W906_ReopenExecute(ht9045::Pci1203CmdKind kind, double value)
+{
+    ht9045::Pci1203CmdResult r;
+    ht9045::TPci1203Control* ctl = ht9045::Pci1203Control();
+    if (ctl == 0) { r.why = "1203 control is not armed in this binary"; return r; }
+    ht9045::Pci1203Cmd c;
+    c.kind = kind; c.value = value;
+    //  Open() waits up to WB_1203_OPEN_WAIT_SEC (default 90 s) while Acm_DevOpen answers 0x83000002 -- on the tick thread / inside
+    //  RunSync, i.e. the whole serve loop. An automatic re-open (and a ring reset that falls back to Rescan) waits 5 s at most;
+    //  the variable is read at every Open() (Pci1203Monitor.cpp), so it is set for this call and put back after.
+    const char* old = std::getenv("WB_1203_OPEN_WAIT_SEC");
+    const std::string oldVal = old ? std::string(old) : std::string();
+    const bool hadOld = (old != 0);
+    _putenv("WB_1203_OPEN_WAIT_SEC=5");
+    const ht9045::Pci1203CmdResult rr = ctl->Execute(c);
+    _putenv((std::string("WB_1203_OPEN_WAIT_SEC=") + (hadOld ? oldVal : std::string())).c_str());
+    return rr;
+}
+void W906_Pci1203ReopenTick()
+{
+    if (g_w906ReopenOpenAlarmPending) {
+        g_w906ReopenOpenAlarmPending = false;
+        const std::string t = "1203 open card fail: " + g_w906ReopenOpenWhy;
+        OpLine("LINK", "1203 開卡失敗 -> 跳 WAR16150，停機時自動重新開卡 / " + g_w906ReopenOpenWhy);
+        ShowErrorMessage("WAR16150", 0, MMSystem, false, AnsiString(t.c_str()));
+    }
+    std::string notWhy;
+    const bool stopped = W906_ReopenMachineStopped(notWhy);
+    unsigned rings = 0;
+    const int act = g_w906Reopen.Step(stopped, (unsigned long)::GetTickCount(), &rings);
+    if (act == ht9045::kRaNone) return;
+    char b[320];
+    if (act == ht9045::kRaRecovered) {
+        g_w906ReopenLast = "recovered";
+        OpLine("LINK", "1203 重新開卡後恢復正常（模組檢查通過）");
+        std::printf("[1203-reopen] recovered (module check passed)\n");  std::fflush(stdout);
+        return;
+    }
+    if (act == ht9045::kRaAlarm) {
+        std::snprintf(b, sizeof(b), "1203 re-open failed %d times (%s) -- check the EtherCAT cables / module power, then press 重新開卡 on the 1203 page",
+                      ht9045::Pci1203Reopen::kTries, g_w906ReopenLast.c_str());
+        OpLine("LINK", std::string("1203 重新開卡 3 次都失敗 -> 跳 WAR16157 / ") + b);
+        std::printf("[1203-reopen] ALARM WAR16157: %s\n", b);  std::fflush(stdout);
+        ShowErrorMessage("WAR16157", 0, MMSystem, false, AnsiString(b));
+        return;
+    }
+    const bool ringReset = (act == ht9045::kRaResetRing);
+    std::snprintf(b, sizeof(b), "[1203-reopen] try %d of %d: %s", g_w906Reopen.Tries(), ht9045::Pci1203Reopen::kTries,
+                  ringReset ? (rings == 1 ? "reset ring 0" : rings == 2 ? "reset ring 1" : "reset rings 0+1") : "re-open the card");
+    std::printf("%s\n", b);  std::fflush(stdout);
+    OpLine("LINK", std::string("1203 重新開卡 ") + b);
+    const ht9045::Pci1203CmdResult r = ringReset ? W906_ReopenExecute(ht9045::kCmdRingReset, (double)rings)
+                                                 : W906_ReopenExecute(ht9045::kCmdCardRescan, 0.0);
+    fAllMotorHome = false;                                             // drives lost power / their handles: HOME again before running
+    ht9045::TPci1203Monitor* m = ht9045::Pci1203Monitor();
+    const bool open = (m != 0 && m->Open_());
+    if (open && !ht9045::Pci1203IoThreadRunning()) { extern void W906_IoThreadBoot(); W906_IoThreadBoot(); }
+    std::snprintf(b, sizeof(b), "%s: %s%s%s", ringReset ? "ring reset" : "card re-open", (r.accepted && r.issued) ? "issued" : "not issued",
+                  r.why.empty() ? "" : " -- ", r.why.c_str());
+    g_w906ReopenLast = b;
+    std::printf("[1203-reopen] %s; card %s\n", b, open ? "open" : "NOT open");  std::fflush(stdout);
+    OpLine("LINK", std::string("1203 重新開卡結果 ") + b + (open ? "；卡已開" : "；卡沒開"));
+    g_w906Reopen.AttemptDone((unsigned long)::GetTickCount());
+    if (!open) g_w906Reopen.Fault(ht9045::kRfOpenFail);                // still closed: the next try re-opens the whole card
+    else { extern unsigned long g_w906Pci1203LinkRestoreGen; ++g_w906Pci1203LinkRestoreGen; }   // a new module-check generation decides recovery
+}
