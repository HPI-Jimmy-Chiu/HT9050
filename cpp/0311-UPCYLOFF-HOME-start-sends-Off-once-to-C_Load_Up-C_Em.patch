+//==============================================================================
+//AI(W906-UPCYLOFF) 20261007: EastSun 1007 "C_Load_Up / C_Empty_Up / C_Auto1_Up / C_Auto2_Up / C_Auto3_Up: at Initial (= HOME start,
+//  AskUserQuestion) trigger Off once". On HT9050 these are double-solenoid valves: the Cylinder[] object drives only the On coil
+//  (C_xxx_Up); the Off coil (C_xxx_UpOff) is an IO_Table row with no engine object (header DEVIATION c). So "Off" = On coil off +
+//  Off coil pulsed for kW906UpOffPulseMs, then released (a later On must not find both coils energised). uhome.cpp TfHome HOME
+//  calls the hook: phase 0 at step 1 (start), phase 1 on every HOME pass (ends the pulse). HT9050 (9050GPIB or Type_HT9050) only.
+extern void (*g_W906UpCylOffHook)(int);   // uhome.cpp (global: a block-scope extern inside the unnamed namespace would name a different object)
+extern AnsiString W906_GpibModel;
+namespace {
+const unsigned long kW906UpOffPulseMs = 500;
+unsigned long s_w906UpOffSince = 0;
+bool W906_UpCylWrite(const char* alias, bool energise)
+{
+    HSys.mapIOTableIter = HSys.mapIOTable.find(AnsiString(alias));
+    if (HSys.mapIOTableIter == HSys.mapIOTable.end()) return false;
+    const int idx = std::atoi(HSys.mapIOTableIter->second.c_str());
+    if (idx < 0 || idx >= (int)HSys.IOTable.size() || HSys.IOTable[idx] == 0) return false;
+    const TIODATA* r = HSys.IOTable[idx];
+    if (r->iEnable == 0) return false;
+    const bool on = energise ? (r->iInType == 1) : (r->iInType == 0);         // the same OutType rule as io.btnPanelClick
+    if (on) MyLaneIO.IOBitOn (r->iLane, r->iIP, r->iPort, r->iBit, r->iISABase, r->Alias);
+    else    MyLaneIO.IOBitOff(r->iLane, r->iIP, r->iPort, r->iBit, r->iISABase, r->Alias);
+    return true;
+}
+void W906_UpCylOffHookFn(int phase)
+{
+    if (!(W906_GpibModel == "9050GPIB" || MachineTypeChoice == Type_HT9050)) return;
+    static const char* const kUp[5]  = { "C_Load_Up",    "C_Empty_Up",    "C_Auto1_Up",    "C_Auto2_Up",    "C_Auto3_Up"    };
+    static const char* const kOff[5] = { "C_Load_UpOff", "C_Empty_UpOff", "C_Auto1_UpOff", "C_Auto2_UpOff", "C_Auto3_UpOff" };
+    static const int kCyl[5] = { C_Load_Up, C_Empty_Up, C_Auto1_Up, C_Auto2_Up, C_Auto3_Up };
+    if (phase == 0) {
+        for (int i = 0; i < 5; ++i) {
+            if (Cylinder[kCyl[i]].Enable) Cylinder[kCyl[i]].Off();               // keep the engine's own state in step
+            W906_UpCylWrite(kUp[i], false);                                       // On coil off (also when the engine row is disabled, e.g. C_Empty_Up with AUTO_EMPTY_COLOR=0)
+            W906_UpCylWrite(kOff[i], true);                                       // Off coil on
+        }
+        s_w906UpOffSince = ::GetTickCount(); if (s_w906UpOffSince == 0) s_w906UpOffSince = 1;
+        std::printf("[UPCYLOFF] HOME start: C_Load/Empty/Auto1~3_Up Off (Off coil pulse %lu ms)\n", kW906UpOffPulseMs); std::fflush(stdout);
+    } else if (s_w906UpOffSince != 0 && (unsigned long)(::GetTickCount() - s_w906UpOffSince) >= kW906UpOffPulseMs) {
+        for (int i = 0; i < 5; ++i) W906_UpCylWrite(kOff[i], false);            // Off coil released
+        s_w906UpOffSince = 0;
+    }
+}
+struct W906UpCylOffReg { W906UpCylOffReg() { g_W906UpCylOffHook = &W906_UpCylOffHookFn; } } s_w906UpCylOffReg;
+}  // namespace
