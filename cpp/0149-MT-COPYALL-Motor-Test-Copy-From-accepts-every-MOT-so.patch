From 71a45c02328fb2b126214b992c91a2466f0ac91a Mon Sep 17 00:00:00 2001
From: "HT9045 Machine (V906)" <Claude_RDBC_02@honprec.com>
Date: Sat, 3 Oct 2026 13:48:56 +0800
Subject: [PATCH] MT-COPYALL: Motor Test Copy From accepts every MOT[] source
 (golden BitBtn1Click :1392 'Source>24 return' let only M00..M24; HT9050 has
 M35..M42) -- EastSun 1003 'I copied M35's parameters, why no effect'

---
 WebMotorAccess.cpp              | 6 ++++--
 tests/test_web_motor_access.cpp | 6 +++++-
 2 files changed, 9 insertions(+), 3 deletions(-)

diff --git a/WebMotorAccess.cpp b/WebMotorAccess.cpp
index 295c4b0..f9f16c4 100644
--- a/WebMotorAccess.cpp
+++ b/WebMotorAccess.cpp
@@ -2152,8 +2152,10 @@ MotorAccessOutcome DoCopyFrom(const MotorAccessReq& r, long long wireId, IMotorA
     double sD = 0.0;
     if (!ParamNum(r, "source", sD)) return Refuse(who + ": 缺 source（golden cbbMotorName 第 2、3 個字元算出的編號）");
     char b[200];
-    if (!(sD >= 0.0 && sD <= 24.0) || sD != (double)(int)sD) {                 // range first: (int) of a huge double is undefined
-        std::snprintf(b, sizeof(b), ": Source=%g —— golden BitBtn1Click :1392 `if(ActiveIndex==-1 || Source>24 || Source<0) return;`（只抄得到 M00..M24）", sD);
+    //AI(W906-MT-COPYALL) 20261003: EastSun「我複製M35的參數但是為啥沒作用」-- golden BitBtn1Click :1392 `Source>24 return` lets only
+    //  M00..M24 be a source; HT9050 has M35..M42 (and M108), so the range is every MOT[] index (GoldenMotor below refuses a missing one).
+    if (!(sD >= 0.0 && sD < 2560.0) || sD != (double)(int)sD) {                // range first: (int) of a huge double is undefined
+        std::snprintf(b, sizeof(b), ": Source=%g —— 不是馬達編號（0~2559）", sD);
         return Refuse(who + b);
     }
     const int src = (int)sD;
diff --git a/tests/test_web_motor_access.cpp b/tests/test_web_motor_access.cpp
index 0283a1e..07c285d 100644
--- a/tests/test_web_motor_access.cpp
+++ b/tests/test_web_motor_access.cpp
@@ -2202,7 +2202,11 @@ int main(int argc, char** argv)
               "copyFrom leaves HomeFlag and LoopMove alone (golden), the ack's cur shows the copied values");
         cq.num["source"] = 25;
         o = MotorAccessDispatch(cq, 1, be);
-        CHECK(!o.ok && Has(o.ackJson, "Source>24") && be.params.size() == np + 6, "source 25 -> refused, golden `Source>24 -> return` (M108 parses to 10, so M25+ can never be a source)");
+        //AI(W906-MT-COPYALL) 20261003: golden's `Source>24 return` dropped (HT9050 has M35..M42): 25 is refused only because MOT[25] has no
+        //  motor in this fake; a number beyond the MOT[] range is refused by the range check.
+        CHECK(!o.ok && Has(o.ackJson, "NULL") && be.params.size() == np + 6, "source 25 (no MOT[25] motor here) -> refused, nothing copied (golden's Source>24 limit is gone: M35 copies on HT9050)");
+        cq.num["source"] = 3000;  o = MotorAccessDispatch(cq, 1, be);
+        CHECK(!o.ok && be.params.size() == np + 6, "source 3000 -> refused (not a MOT[] index)");
         cq.num["source"] = -1;  CHECK(!MotorAccessDispatch(cq, 1, be).ok, "source -1 -> refused (golden Source<0)");
         cq.num["source"] = 10;
         o = MotorAccessDispatch(cq, 1, be);
-- 
