+             "[CylinderResetCount]\r\nW208_A_ResetCount=3\r\n"
+             "[CylinderResetTime]\r\nW208_A_ResetTime=2026-10-01 08:00:00\r\n"
+             "[OnTimeRecord]\r\nW208_A_OnTime_0=0.111\r\nW208_A_OnTime_1=0.222\r\n"
