+//  SmartDiagnostic.cpp -- Steven 20260925 (Data.SmartDiagnostic web page)
+//
+//  golden: HT9011UC_Code_V3.33.912.0_20260908_Jimmy\SmartDiagnostic.cpp (cp950),
