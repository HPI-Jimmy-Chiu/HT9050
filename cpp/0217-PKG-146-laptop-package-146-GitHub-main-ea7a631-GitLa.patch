+                }
+            }
+        }
+
+        //==> Eastsun 20260515 F012 整合:KYEC AMR Magazine full-IC scan, return cover-tray request
+        if(bMagGetNewTrayflag==false &&
+           bChaneMagTrayflag==false &&
