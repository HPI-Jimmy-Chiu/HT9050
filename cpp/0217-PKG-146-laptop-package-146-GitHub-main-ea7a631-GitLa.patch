+// ---- 12. AI(W906-ST02-C912) 20261003 (St02-E helper): back to golden 906_0625 main.cpp:15847-15858 (RULINGS_20261002 #20 / #23-6) ----
+static int g_rrStart = 0, g_rrPause = 0;
