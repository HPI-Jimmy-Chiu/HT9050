+            if(bMotOk && bCynOk)
+            {
+                tNFCDelay.SetSecAndOn(0.1);
+                if(bReadOK==true)
+                {
+                    fTrayMapping->btnLdRFIDReadBlock1->Click();
+                    Task=4100;
+                }
