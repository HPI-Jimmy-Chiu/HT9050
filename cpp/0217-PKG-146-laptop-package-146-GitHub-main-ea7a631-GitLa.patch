+        r = op(cdp, "HT9045SmartDiag.save(%s,{answer:true})" % json.dumps(edits))
+        check(r.get('executed') is True, 'C  save 確認段 executed（guard=%r detail=%r）' % (r.get('guard'), r.get('detail')))
