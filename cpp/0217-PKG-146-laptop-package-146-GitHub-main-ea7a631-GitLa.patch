+        _dup2(g_savedFd, kStdoutFd);
+        _close(g_savedFd);
+        g_savedFd = -1;
+    }
+}
+
+static AnsiString capEnd()
+{
+    std::fflush(stdout);
+    if (g_savedFd >= 0)
+    {
+        _dup2(g_savedFd, kStdoutFd);
+        _close(g_savedFd);
+        g_savedFd = -1;
+    }
+    std::clearerr(stdout);
+
+    AnsiString out = "";
+    FILE* f = std::fopen(capPath().c_str(), "rb");
+    if (f)
+    {
+        char buf[2048];
+        size_t n;
+        while ((n = std::fread(buf, 1, sizeof(buf) - 1, f)) > 0)
+        {
+            buf[n] = '\0';
