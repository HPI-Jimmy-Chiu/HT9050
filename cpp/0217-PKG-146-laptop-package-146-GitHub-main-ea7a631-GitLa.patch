+static std::string Packet(unsigned cmd, const char* ret)
+{
+    VM vm;
+    std::memset(&vm, 0, sizeof(vm));
+    vm.iCommand = cmd;
+    if (ret)
+        std::strncpy(vm.cReturn, ret, sizeof(vm.cReturn) - 1);
+    return std::string(reinterpret_cast<const char*>(&vm), sizeof(vm));
+}
