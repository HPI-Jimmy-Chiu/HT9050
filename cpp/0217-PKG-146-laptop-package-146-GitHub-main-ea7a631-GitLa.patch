+    TestIF_File.iGpibMode = 0;                 // not InterfaceType_SPEA_Type: that arm hands the packet to _OnMyCopyMsg_Interface
+    W906_RemoteRun.Start = &RrStart;  W906_RemoteRun.Pause = &RrPause;   // installed, so a start or a pause would be counted
+    g_rrStart = g_rrPause = 0;
+    const unsigned codes[2] = { 204u, 205u };  // golden 912 MSG_CMD_RemoteStart / MSG_CMD_RemoteStop (912 MessageDef.h:231-232); not in 906
+    CHECK(fMain != 0);
+    for (int run = 0; run < 2; ++run)
+    {
+        SystemStart = (run == 1);              // stopped (where 912's START acted) and running (where 912's STOP acted)
+        for (int k = 0; k < 2; ++k)
+        {
+            bSECSGEMAlarm = true;  bHasSaveSet = true;
+            HHandler2Gpib.iSendCommand = MSG_CMD_NONE;
+            const int pause0 = fMain ? fMain->W906_BtnPauseClickCallCount : 0;
+            const unsigned long before = side.sinkMessages;
+            CHECK(THandlerTesterSide::Sink(Packet(codes[k], ""), &side) == 0);
+            CHECK(side.sinkMessages == before + 1);
+            CHECK(g_rrStart == 0 && g_rrPause == 0);                                  // nothing started or paused
+            CHECK(fMain != 0 && fMain->W906_BtnPauseClickCallCount == pause0);       // 912's STOP called BtnPauseClick
+            CHECK(bSECSGEMAlarm == true && bHasSaveSet == true);                     // 912's START cleared both
+            CHECK(HHandler2Gpib.iSendCommand == MSG_CMD_NONE);                       // no SendMSG_CMD reply (912: SETTINGOK / SETTINGNG)
+            CHECK(side.depth == 0);
+        }
+    }
+
+    W906_RemoteRun = sTable;
+    TestIF_File.iGpibMode = sFileGpibMode;
+    CosFunction.bGPIBUseSECSGENData = sSecsData;
+    SystemStart = sStart;  bSECSGEMAlarm = sAlarm;  bHasSaveSet = sSave;
+}
