+        mc = s['management']['cells']
+        check(all(mc[r][0] == sc[r][1] and mc[r][1] == '0' for r in named), 'C  create：Management 同名＋"0"（:619-620）')
+        verify_dom(cdp, s, 'create 後')
+
+        # ---- reset -----------------------------------------------------------------
+        items = s['combo']['items']
