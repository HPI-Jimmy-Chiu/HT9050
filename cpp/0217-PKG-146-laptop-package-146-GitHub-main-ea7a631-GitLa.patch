+               fTrayMapping->ldRFID->bClearCmd1==true)
+            {
+                fTrayMapping->ldRFID->sBlockID1="";
+                fTrayMapping->ldRFID->sUID1="";
+                fTrayMapping->ldRFID->bReadUID1=false;
