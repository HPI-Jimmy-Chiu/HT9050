+    int iC_SepaRR=iC_SeparateRR[iWhichAuto];                                    //Ztex 2023.12.13 Add Double Belt Mode
+    int iC_SepaFR=iC_SeparateFR[iWhichAuto];                                    //Ztex 2023.12.13 Add Double Belt Mode
