-    if ($lfanew -lt 0 -or ($lfanew + 24) -gt $len) {
-      return @{ Verdict = 'SHORT-HDR'; Need = $lfanew + 24; Len = $len }
-    }
-    $fs.Position = $lfanew
-    if ($br.ReadUInt32() -ne 0x00004550) {  # "PE\0\0"
-      return @{ Verdict = 'NOT-PE'; Need = 0; Len = $len }
