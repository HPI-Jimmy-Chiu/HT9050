+// ===========================================================================
+//  Harness
+// ===========================================================================
+static int g_total = 0;
+static int g_fail = 0;
+
+static void check(bool ok, const char* expr, const char* file, int line)
+{
+    ++g_total;
+    if (!ok) {
+        ++g_fail;
+        std::printf("FAIL [%s:%d]  %s\n", file, line, expr);
