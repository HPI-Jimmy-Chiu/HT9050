+    return AnsiString(t) + AnsiString("\\") + AnsiString(W906_TestTmpName(leaf).c_str());   // AI(W906-ST02-C17) 20261005 (St02-E): per-process scratch name (St01 E-039; tests/w906_test_tmpname.h)
