+def split_golden(line):
+    """golden SmartDiagnostic.cpp:386-431 SplitStrByDotSpaceOnly 的連續呼叫：分隔字元 , \\t \\r :，前導分隔略過。"""
+    return [t for t in re.split(r'[,\t\r:]+', line) if t != '']
