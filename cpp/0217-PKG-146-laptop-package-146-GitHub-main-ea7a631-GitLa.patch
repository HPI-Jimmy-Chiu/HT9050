+// =============================================================================
+//  cprod_9050.inc -- HT9050 tray-stack teach fields of PROD_INFO_ST (textually included by cprod.h inside the struct).
+//
+//  AI(W906-F9050-BD) 20261004: F9050-BD batch B (ledger H087) -- 910 cprod.h:490-516 (Eastsun 0819), verbatim, at 910's
+//  place: cprod.h:490 includes this file right after TrayZ_Mid and before iBS1Right_Half, and 910's TrayZ_Down (910
+//  cprod.h:488) is cprod.h:488, between TrayZ_Up and TrayZ_Mid.  So iTemperature .. iBS2Right_Half are in 910's order (all
+//  int, no padding; tests/test_flow9050_tray.cpp pins it with offsetof), and the out-of-bounds layer reads of 910 defect (a)
+//  (below) hit the same neighbours as in 910.  Prod is never written to a file (no binary dump, no ini key: boot rebuilds it
+//  from Tech + offsets, e.g. the TrayZ_Up / TrayZ_Mid assignments at cinitial.cpp:6009-6020) and every reader names its
+//  field, so moving every field behind TrayZ_Up changes no file format; tests/test_globals.cpp's anchors (cFileName @0,
+//  LastEditDate @256, sizeof > 50000) still hold.
+//  910 defect (a) (pending Frank/Jimmy, TO_FRANK s4 1001 18:1x), translated as written: TrayZ_Up / TrayZ_Down are
+//  [MAX_TRACK]=9 but DoLoad_9050 / DoLoadNewICTray_9050 / DoCatchFromLoader_9050 index them with the Loader layer count
+//  (from -1 up; the probe alone walks to 19), and the Empty / Auto1-3 arrays below are [MAX_LOADER_LAYER_9050]=20 and are
+//  first read at [-1].  As in 910: TrayZ_Up[9..17] reads TrayZ_Down[0..8] and [18..19] TrayZ_Mid[0..1]; TrayZ_Down[-1]
+//  reads TrayZ_Up[8], [9..17] TrayZ_Mid[0..8], [18] TrayZ_Home, [19] iLoaderInitDetectLayer; EmptyZ_Up[-1] reads
+//  iCatchExtraLift_9050; every other [-1] / [20..] read lands on the field before / after it in 910's order, and past
+//  iAuto3CatchExtraLift_9050 come iBS1Right_Half / iBS2Right_Half.
+//  HAZARD (pending Frank/Jimmy, ledger s0 #2): 910 assigns NONE of the fields in this file, nor TrayZ_Down -- they stay 0
+//  (global zero-init), so on a real HT9050 HOME sends MLoaderZ to TrayZ_Home = 0 and every Down / Home move and every
+//  Empty / Auto1-3 Z move goes to 0.  TrayZ_Up[0..8] are NOT 0: SetTechDataToProd_TrayArm (cinitial.cpp:6009-6020, as 910)
+//  fills them with golden teach values + 200 (Tech.iTrayLoaderZ[0..5], Tech.iTrayAuto4Z[0..2] for 6..8), so the Loader "Up"
+//  moves of layers 0..8 go to those positions.
+// =============================================================================
+    int TrayZ_Home;                                                             //Eastsun 20260819
+    int iLoaderInitDetectLayer;                                                     //Eastsun 20260819 : 9050 case 1100 探測層數的起始猜測值 (e.g. 10)
+    int iCatchExtraLift_9050;                                                    //Eastsun 20260819 : 9050 TrayArm catch-from-loader 交接時 MLoaderZ 額外抬升距離
+    // Eastsun 20260819 : 9050 Empty 區 TrayArm catch 教值
+    int EmptyZ_Up[MAX_LOADER_LAYER_9050];
+    int EmptyZ_Down[MAX_LOADER_LAYER_9050];
+    int EmptyZ_Home;
+    int iEmptyInitDetectLayer;
+    int iEmptyCatchExtraLift_9050;
+    // Eastsun 20260819 : 9050 Auto1 區 TrayArm catch 教值
+    int Auto1Z_Up[MAX_LOADER_LAYER_9050];
+    int Auto1Z_Down[MAX_LOADER_LAYER_9050];
+    int Auto1Z_Home;
+    int iAuto1InitDetectLayer;
+    int iAuto1CatchExtraLift_9050;
+    // Eastsun 20260819 : 9050 Auto2 區 TrayArm catch 教值
+    int Auto2Z_Up[MAX_LOADER_LAYER_9050];
+    int Auto2Z_Down[MAX_LOADER_LAYER_9050];
+    int Auto2Z_Home;
+    int iAuto2InitDetectLayer;
+    int iAuto2CatchExtraLift_9050;
+    // Eastsun 20260819 : 9050 Auto3 區 TrayArm catch 教值
+    int Auto3Z_Up[MAX_LOADER_LAYER_9050];
+    int Auto3Z_Down[MAX_LOADER_LAYER_9050];
+    int Auto3Z_Home;
+    int iAuto3InitDetectLayer;
+    int iAuto3CatchExtraLift_9050;
diff --git a/csystem.cpp b/csystem.cpp
index 2d7368e..376b103 100644
--- a/csystem.cpp
+++ b/csystem.cpp
@@ -285,7 +285,10 @@ void SetInitialICCheck()
 // ===========================================================================
 void InitAllProcessTask()
 {
-    InitLoadTask();                                                            // shim (golden asendic_Loader.cpp)
+    if(MachineTypeChoice==Type_HT9050)                                         //AI(W906-F9050-BD) 20261004: H090, 910 csystem.cpp:5836-5839 verbatim; today 9050GPIB decodes as Type_HT9046_LS (database.cpp:517) => InitLoadTask() as before
+        InitLoadTask_9050();
+    else
+        InitLoadTask();                                                        // shim (golden asendic_Loader.cpp)
     InitInArmTask();                                                           // aHotPlateSubstrate.cpp
 //#ifdef Carry4
 //    Initial_Auto_InSHT_Task();
@@ -11891,6 +11894,116 @@ void WriteATKLog(AnsiString sMsg)
         SystemHour, SystemMin, SystemSec, SystemMSec);
     WriteDataToFile(sFile, sTime + " " + sMsg, false);                            //AI(W906-PT-W6-g3) 20260809: bOverWrite passed explicitly -- see g3-B note (same value as golden default)
 }
+//AI(W906-F9050-BD) 20261004: F9050-BD batch D (ledger H091) -- 910 csystem.cpp:7611-7714 (Eastsun 0820), line by line.  Called ONLY from the
+//  Type_HT9050 arm of DoTrayFeed's flag3 block => never called today.  910 places it after DoTrayFeed's own banner; here it
+//  sits before that banner so the banner stays with DoTrayFeed.  910 defect (d): the header below says Task 20 = 'Selector Off'
+//  and lists a Task 40, the code does `On()` and has no 40 -- both kept verbatim.  Layer counters are set to -1 at the end of
+//  each area's sequence (W-01 Q2 pending).
+//==============================================================================
+// Eastsun 20260820 : 9050 專用 - TrayFeed 收盤 + 回最底端
+//   5 個區並行 FSM (Loader/Empty/Auto1/Auto2/Auto3):
+//     Task 1   : 檢查 MMxxx.fHasTray
+//                  false → 直接 Task=90 (無盤,直接回 Home)
+//                  true  → Task=10 (跑收盤序列)
+//     Task 10  : Edge Pop + Selector Push + MotZ 上升到 Up[iLayer]+ExtraLift  (壓入 stack)
+//     Task 20  : Selector Off + InitNewTray(NULL_IC) + iLayer++
+//     Task 30  : MotZ 下降到 Down[iLayer] (待命位)
+//     Task 40  : Edge Push + Selector Pop  (夾住 stack 邊緣)
+//     Task 90  : MotZ 回 Home
+//     Task 100 : done
+//   return true 當 5 個區都完成
+//==============================================================================
+
+bool DoReceiveAllToBottom_9050()
+{
+    //Per-area FSM state (idx 0=Loader, 1=Empty, 2=Auto1, 3=Auto2, 4=Auto3)
+    static int iRecvTask[5] = {1, 1, 1, 1, 1};
+
+    //IO 陣列 (compile-time enum,可 static const)
+    static const int aMotZ[5]     = { MLoaderZ,               MEmptyZ,               MAuto1Z,               MAuto2Z,               MAuto3Z              };
+    static const int aMMMot[5]    = { MMTrayZ,                MMEmpty,               MMAuto1,               MMAuto2,               MMAuto3              };
+    static const int aEdgeClip[5] = { C_LoaderEdgeClip,       C_EmptyEdgeClip,       C_Auto1EdgeClip,       C_Auto2EdgeClip,       C_Auto3EdgeClip      };
+    static const int aEdgePush[5] = { C_LoaderEdgePush,       C_EmptyEdgePush,       C_Auto1EdgePush,       C_Auto2EdgePush,       C_Auto3EdgePush      };
+    static const int aSel[5]      = { C_TrayZ_Selector,       C_EmptyLoaderZ_Select, C_Auto1LoaderZ_Select, C_Auto2LoaderZ_Select, C_Auto3LoaderZ_Select};
+
+    //Prod 陣列 (runtime teach 值,不能 static)
+    int* pUp[5]        = { Prod.TrayZ_Up,   Prod.EmptyZ_Up,   Prod.Auto1Z_Up,   Prod.Auto2Z_Up,   Prod.Auto3Z_Up   };
+    int* pDown[5]      = { Prod.TrayZ_Down, Prod.EmptyZ_Down, Prod.Auto1Z_Down, Prod.Auto2Z_Down, Prod.Auto3Z_Down };
+    int  aHome[5]      = { Prod.TrayZ_Home, Prod.EmptyZ_Home, Prod.Auto1Z_Home, Prod.Auto2Z_Home, Prod.Auto3Z_Home };
+    int  aExtraLift[5] = { Prod.iCatchExtraLift_9050,
+                           Prod.iEmptyCatchExtraLift_9050,
+                           Prod.iAuto1CatchExtraLift_9050,
+                           Prod.iAuto2CatchExtraLift_9050,
+                           Prod.iAuto3CatchExtraLift_9050 };
+    (void)aExtraLift;                                                           //AI(W906-F9050-BD) 20261004: 910 declares aExtraLift and never reads it (Task 10 rises to Up[iLayer] only, though the header says +ExtraLift -- part of defect (d), pending Frank); the cast only keeps -Wunused-variable quiet, no behaviour.
+    int* pLayer[5]     = { &iLoaderLayerCount_9050,
+                           &iEmptyLayerCount_9050,
+                           &iAuto1LayerCount_9050,
+                           &iAuto2LayerCount_9050,
+                           &iAuto3LayerCount_9050 };
+
+    bool bAllDone = true;
+
+    //5 個區並行推進
+    for(int idx = 0; idx < 5; idx++)
+    {
+        int &Task   = iRecvTask[idx];
+        int &iLayer = *pLayer[idx];
+
+        switch(Task)
+        {
+            case 1:                                                             //檢查有無盤
+                if(MOT[aMMMot[idx]].fHasTray == false)
+                    Task = 90;                                                  //無盤 → 直接回 Home
+                else
+                    Task = 10;                                                  //有盤 → 收盤序列
+                break;
+            case 10:                                                            //Edge Pop + Selector Push + MotZ 上升壓入 stack
+                if(Cylinder[aEdgeClip[idx]].Pop() &&
+                   Cylinder[aEdgePush[idx]].Pop())
+                {
+                    if(MOT[aMotZ[idx]].MotorMove(pUp[idx][iLayer]) == 1)
+                        Task = 20;
+                }
+                break;
+            case 20:                                                            //Selector Off + InitNewTray(NULL_IC) + iLayer++
+                Cylinder[aSel[idx]].On();
+                MOT[aMMMot[idx]].InitNewTray(NULL_IC, false, __FUNC__);
+                MOT[aMMMot[idx]].fHasTray = false;
+                iLayer++;
+                Task = 30;
+                break;
+            case 30:
+                if(Cylinder[aEdgeClip[idx]].Pop() &&
+                   Cylinder[aEdgePush[idx]].Pop() &&
+                   Cylinder[aSel[idx]].Push())
+                {
+                    if(MOT[aMotZ[idx]].MotorMove(pDown[idx][iLayer]) == 1)
+                    {
+                        iLayer=-1;
+                        Task = 90;
+                    }
+                }
+                break;
+            case 90:                                                            //MotZ 回 Home
+                if(MOT[aMotZ[idx]].MotorMove(aHome[idx]) == 1)
+                    Task = 100;
+                break;
+            case 100:                                                           //done (等其他區)
+                break;
+        }
+
+        if(Task != 100) bAllDone = false;
+    }
+
+    if(bAllDone)
