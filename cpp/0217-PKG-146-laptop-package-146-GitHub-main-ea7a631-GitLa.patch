+void __fastcall TfSmartDiagnostic::SmartDiagnosticTimerTimer(TObject *Sender)
+{
+    static int Task=1, iAlarmOnIndex=0, iAlarmOffIndex=0;
+    int i, iOnCount, iOffCount;
