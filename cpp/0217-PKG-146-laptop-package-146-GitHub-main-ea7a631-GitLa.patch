+        bSeparateHasTray=Sen[iSeparate].IsOff();
+
+    switch(Task)
+    {
+        case 1:                                                                 //Y推&後牙刷 開 分離 開
+            if(bSOFT_SIMULTE)                                                   //Ztex Add SOFT_SIMULTE Pass
+            {
+                htSupportUnderTrayTimeDelay.SetSecAndOn(5);                     //Ztex 2025.04.01 Add bCheckSnTrayDetect
+                Task=110;
+                break;
