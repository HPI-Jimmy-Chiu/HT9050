+                MOT[MMColor].sTrayID            =MOT[MTrayX].sTrayID;
+                MOT[MMColor].iIsCoverTray       =MOT[MTrayX].iIsCoverTray;
+                fSortCT->pnlCoverTrayD->Caption =MOT[MTrayX].sTrayID;
+            }
+            else                                                                //if(iAuto==etAuto2)
