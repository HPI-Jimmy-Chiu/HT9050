From 6559a5b4b93d1e3085722d80639977f2193c88da Mon Sep 17 00:00:00 2001
From: "HT9045 Machine (V906)" <Claude_RDBC_02@honprec.com>
Date: Wed, 7 Oct 2026 12:11:04 +0800
Subject: [PATCH] PARAMSYNC-3: the parameter sync no longer waits for ever on
 an un-homed machine (found checking the 11:21 run's op log).
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

W906_ParamSyncTick's busy test used `iHome != 0`; iHome is 1 whenever the machine is NOT homed yet (csystem.cpp DoHomeProcess sets 0
only after CheckMotorHome), so an un-homed machine deferred every sync: the 11:22:20 Teach-page request logged "機台運轉／歸零中，
先不寫" and never ran (12:10 snapshot: SystemStart 0, SoftStart 0, Home Monitor closed, fAllMotorHome 0). Homing in progress = the
Home Monitor open (fHome->fShow), as ShowRunLabel's "Homing"; iHome dropped (WebMotorAccessLive.cpp, same line).
Also checked in the same log: the boot InitMotor now goes one axis per pass (11:22:12 .. 11:22:29, ~1 s apart), no pass >= 1 s.
wb_serve compiled; the link waits for EastSun's running program. Scan 0.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 WebMotorAccessLive.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/WebMotorAccessLive.cpp b/WebMotorAccessLive.cpp
index 8b7a269..f55e0bf 100644
--- a/WebMotorAccessLive.cpp
+++ b/WebMotorAccessLive.cpp
@@ -1710,7 +1710,7 @@ void W906_ParamSyncTick()
     s_mtPrev = mt; s_tePrev = te;
     const DWORD now = ::GetTickCount();
     if (s_state == 0 && s_pending && (s_bootDone || s_reason != "開軟體（開機 InitMotor 都做完）")) {   //AI(W906-PARAMSYNC-2) 20261007: review of 4e3f1bf -- a page-open request no longer waits for the boot InitMotor (motor power off at start, or a slave that never reports, swallowed every Motor Test / Teach sync); same line
-        const bool busy = SystemStart || SoftStart || iHome != 0 || (fHome != 0 && fHome->fShow);
+        const bool busy = SystemStart || SoftStart || (fHome != 0 && fHome->fShow);   //AI(W906-PARAMSYNC-3) 20261007: `iHome != 0` dropped -- iHome is 1 whenever the machine is NOT homed yet (csystem.cpp DoHomeProcess sets 0 only after CheckMotorHome), so an un-homed machine deferred every sync for ever (11:22:20 Teach request never ran; 12:10 snapshot: SystemStart 0, Home Monitor closed, fAllMotorHome 0). Homing in progress = the Home Monitor open (fHome->fShow), as ShowRunLabel's "Homing"; same line
         if (busy) {
             if (!s_waitSaid) { ht9045::BrakeLog("PARAMSYNC " + s_reason + "：機台運轉／歸零中，先不寫，停下來再寫"); s_waitSaid = true; }
             return;
-- 
