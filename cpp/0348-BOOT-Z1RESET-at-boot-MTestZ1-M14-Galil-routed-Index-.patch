     if (!powerSeen) { powerSeen = true; powerSince = now; return; }
-    if (now - powerSince < 1000) return;
+    if (now - powerSince < 1000) return;  { void W906_BootResetIndexZ1_(ht9045::IMotorAccessBackend&, DWORD); W906_BootResetIndexZ1_(be, now - powerSince); }   //AI(W906-BOOT-Z1RESET) 20261009: MTestZ1 alarm reset only (end of file)
     for (std::size_t i = 0; i < n; ++i) {
         if (done[i]) continue;
         const std::string alias = kBootInitAxes[i];
@@ -1749,3 +1749,50 @@ void W906_ParamSyncTick()
         ht9045::BrakeLog(line);
     }
 }
+
+//------------------------------------------------------------------------------
+//AI(W906-BOOT-Z1RESET) 20261009: EastSun 1009「M14 現在跳神麼異常」→「請持續處理」. MTestZ1 (M14, PCI1203 station 14, the Galil-routed
+//  Index Z1) is left out of kBootInitAxes above on purpose -- golden's InitMotor on it is TMyGALILMotor::InitMotor, which does nothing
+//  (Motor/myGALILmotor.cpp:130-133), and golden servos it ON through the Galil path (uhome case 5 "SH"). But on the HT9050 it is an
+//  EtherCAT drive: after a power cycle / a master that went away it comes up with drive alarm A.A12 (EtherCAT Output Data
+//  Synchronization Error, 10:30:15 today), ERROR_STOP, and nothing cleared it until EastSun pressed Reset on the 1203 page (10:32:34).
+//  Here, ONCE per run, after the same 1 s motor-power gate as the boot InitMotor: if MTestZ1 is an enabled, opened PCI1203 axis and its
+//  sample shows an alarm (MotionIO ALM bit or state ERROR_STOP), send ONE Acm_AxResetError -- the same command as the Motor Test /
+//  1203 page Alarm Reset (WebMotorAccess.cpp DoResetAlarm). No servo-ON, no CFG write, no motion: the Galil route still owns the servo
+//  ("SH" at HOME). The result goes to the op log (BRAKE line).
+void W906_BootResetIndexZ1_(ht9045::IMotorAccessBackend& be, DWORD sincePower)
+{
+    static bool s_done = false;
+    if (s_done) return;
+    ht9045::MotorAccessAxis a;
+    if (!be.Resolve("MTestZ1", a) || !a.Is1203() || a.axis < 0 || !a.tableEnable) {
+        s_done = true;
+        ht9045::BrakeLog("MTestZ1 boot alarm reset: skipped -- " + (a.why.empty() ? std::string("not an enabled PCI1203 axis the monitor opened") : a.why));
+        return;
+    }
+    unsigned st = 0;
+    unsigned long io = 0;
+    const bool hasSt = be.Pci1203AxisState(a.axis, st), hasIo = be.Pci1203MotionIO(a.axis, io);
+    if (!hasSt && !hasIo) {
+        if (sincePower < 20000) return;                                         // no sample yet: next Poll
+        s_done = true;
+        ht9045::BrakeLog("MTestZ1 boot alarm reset: skipped -- no sample from the card 20 s after motor power");
+        return;
+    }
+    s_done = true;
+    const bool alarm = (hasIo && (io & 0x00000002ul) != 0) || (hasSt && (st & 0xFFu) == 3u);
+    char b[240];
+    if (!alarm) {
+        std::snprintf(b, sizeof(b), "MTestZ1 boot alarm reset: not needed (state=%s ALM=%s)", hasSt ? std::to_string(st & 0xFFu).c_str() : "?",
+                      hasIo ? ((io & 0x00000002ul) ? "1" : "0") : "?");
+        ht9045::BrakeLog(b);
+        return;
+    }
+    ht9045::Pci1203Cmd c;
+    c.kind = ht9045::kCmdAxResetError; c.wireId = 0; c.axis = a.axis;
+    const ht9045::Pci1203CmdResult res = be.Pci1203Execute(c);
+    std::snprintf(b, sizeof(b), "MTestZ1 boot alarm reset: Acm_AxResetError(ax=%d) -> accepted=%d issued=%d ret=0x%08lX%s%s (before: state=%s ALM=%s)",
+                  a.axis, res.accepted ? 1 : 0, res.issued ? 1 : 0, (unsigned long)res.ret, res.why.empty() ? "" : " -- ", res.why.c_str(),
+                  hasSt ? std::to_string(st & 0xFFu).c_str() : "?", hasIo ? ((io & 0x00000002ul) ? "1" : "0") : "?");
+    ht9045::BrakeLog(b);
+}
\ No newline at end of file
