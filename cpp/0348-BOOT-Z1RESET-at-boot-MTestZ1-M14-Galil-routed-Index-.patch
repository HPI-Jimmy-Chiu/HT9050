 WebMotorAccessLive.cpp  | 49 ++++++++++++++++++++++++++++++++++++++++-
 docs/WORKLOG_MACHINE.md |  1 +
 2 files changed, 49 insertions(+), 1 deletion(-)

diff --git a/WebMotorAccessLive.cpp b/WebMotorAccessLive.cpp
index 4a9aa9d4..fe83cb4e 100644
--- a/WebMotorAccessLive.cpp
+++ b/WebMotorAccessLive.cpp
@@ -1630,7 +1630,7 @@ void W906_BootInitMotorTick()
