+++ b/cinitial.cpp
@@ -3229,7 +3229,7 @@ void InitialSafeDoor()
     {
         IniConfig.bP35TrayArm=Sen[SnTrayArmSafePos].Enable;
     }
-//#endif
+    { void W906_SafeDoorPlcEnable(); W906_SafeDoorPlcEnable(); }   //#endif   //AI(W906-PLCDOOR-2) 20261006: re-enable the PLC-wired doors after the temporary MARK above (cinitial.cpp EOF); the //#endif comment kept on this line
 }
