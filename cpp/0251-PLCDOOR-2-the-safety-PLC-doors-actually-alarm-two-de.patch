--- a/MyLaneIo.cpp
+++ b/MyLaneIo.cpp
@@ -523,7 +523,7 @@ bool TLaneIO::IOInputBit(int Ring, int IP, int Port, int Bit, int iISABase, Ansi
     // Translated faithfully; fires only when iISABase==ePLCbase.
     if(bPLCIO[Port][Bit] && iISABase == ePLCbase)
     {
-        if(Port >= PLCIO_INPUT_START_PORT_NUMBER && Port <= 0x303)
+        if(Port >= PLCIO_INPUT_START_PORT_NUMBER && Port <= (iSafePlcModel == 1 ? 0x310 : 0x303))   //AI(W906-PLCDOOR-2) 20261006: model 1 (Reer M1S, MyPLC_IO_Modbus.cpp W906_PlcM1SFill) lays Input bytes 0..15 at Ports 0x300..0x30F and the made all-doors bit at 0x310 -- golden's 0x303 cap answered `true` (= closed) for SnAllSafeDoor 0x310 for ever (IO audit 20261006). Model 0 = golden's 0x303
         {
             if(iPLCSafetyVer == 202204)
                 return bPLCInData[0][Port - PLCIO_INPUT_START_PORT_NUMBER + 2][Bit];  // joe 20220406.01
