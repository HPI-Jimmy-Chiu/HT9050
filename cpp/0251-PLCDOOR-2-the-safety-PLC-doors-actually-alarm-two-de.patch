@@ -19426,3 +19426,24 @@ int W906_TrayZ9050ProbeLimit()
 {
     return (Tech.iTrayZ9050ProbeLimit > 0) ? Tech.iTrayZ9050ProbeLimit : MAX_LOADER_LAYER_9050;
 }
+//==============================================================================
+//AI(W906-PLCDOOR-2) 20261006: the safety-PLC doors actually alarm. IO audit 20261006 found that, with SafePlcIO=1 / SafePlcModel=1 and
+//  the IO table's doors on the PLC (ISABase 4), InitialSafeDoor still switched them off: JerryYang 20260926「安全門還沒好, 暫時MARK掉」
+//  (cinitial.cpp:3044-3050, SnSafeDoor1/2/3/6/7/8/9) and SAFE_DOOR_AMOUNT=1 (SnSafeDoor4/5) run AFTER the PLC force-enable at
+//  :2792-2797, so Sen[].IsOff() answered false and CheckSafeDoorIsClosed never raised MES1611+N-1. EastSun 1006「門警報不用看其他地方
+//  看PLC通訊就好 ... 功能要齊全」: called at the end of InitialSafeDoor, this re-enables (Type 1, as golden's PLC rule) every door of
+//  golden's iSafeDoor[] list that the IO table puts on the PLC -- only with SafePlcIO=1 and the Reer model (SafePlcModel=1). Doors not
+//  on the PLC, and every other configuration, keep the temporary MARK exactly as before.
+void W906_SafeDoorPlcEnable()
+{
+    if(!Enable_PLCSafety_IO || iSafePlcModel != 1)
+        return;
+    for(int i=0; i<MAX_SAFE_DOOR_CNT; i++)
+    {
+        const int s = iSafeDoor[i];
+        if(s < 0 || s >= MAX_SENSOR_ITEM || Sen[s].ISABase != ePLCbase)
+            continue;
+        Sen[s].Enable = true;
+        Sen[s].Type   = 1;
+    }
+}
