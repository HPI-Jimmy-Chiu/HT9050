+        H += ['', 'namespace ht9045 {', 'namespace formbridge {', '']
+        T = ['}  // namespace formbridge', '}  // namespace ht9045', '']
+        open(os.path.join(out, '%s.cpp' % st), 'w', encoding='utf-8', newline='\n').write('\n'.join(H + body + T))
+
+    if only:
