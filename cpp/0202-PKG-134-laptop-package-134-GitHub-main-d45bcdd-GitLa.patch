+#if 0 // TODO(W906-GB-P2a): G13 -- iLOTSTATUS_T is not a TfSCKART member (forms/fSCKART.h; golden SCK_ART.cpp:45 sets 2) -- golden main.cpp:19068
+            fSCKART->SetLotStatus(fSCKART->iLOTSTATUS_T);
