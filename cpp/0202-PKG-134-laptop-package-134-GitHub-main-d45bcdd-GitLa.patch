+        if q:
+            if c == '\\': i += 1
+            elif c == q: q = None
+        elif cpp.startswith('//', i):
+            i = cpp.find('\n', i); continue
+        elif c in '"\'': q = c
+        elif c == '{': d += 1
+        elif c == '}': d -= 1
+        i += 1
+    return m.group(1), cpp[m.end():i - 1], cpp.count('\n', 0, m.end()) + 1, cpp.count('\n', 0, m.start()) + 1
