+int HexData[5]={0x01, 0x02, 0x04, 0x08, 0x10};
+//------------------------------------------------------------------------------
+int IOCT[]={4,                                                                  //_4Bit=0
+            8,                                                                  //_8Bit=1
+            4,                                                                  //_5BitPE
+            9,                                                                  //_10BitPE
+            5,                                                                  //_5Bit
