+int ArrayConvertSite(int X, int Y)
+{
+    int Site=-1;
+
+    if(TestIF.iTestMode>=_6Site2X3)                                             //Alick 20161011 (Steven) : TTL支援8Site
+    {
+        Site=X*4+Y+1;
+    }
+    else if(TestIF.iTestMode>=DualSite2x1)
+    {
+        Site=X*2+Y+1;
+    }
+    else
+    {
+        Site=Y+1;
+    }
+    return Site-1;
+}
