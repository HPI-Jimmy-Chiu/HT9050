+TfLotInfoLogMemo::TfLotInfoLogMemo()
+{
+    delete Lines;                                                               // TfMainMemo() 建的 no-op 那一份
+    Log=new TfLotInfoLogMemoLines();
+    Lines=Log;
+    Log->Add("");                                                               // dfm :11283-11284 Lines.Strings=('')
+}
+
+void TfLotInfoLogMemo::Clear()
+{
+    Log->L.clear();
+    Log->Count=0;
+}
