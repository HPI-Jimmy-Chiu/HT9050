+                             'kBridge_%s' % (cpp, cls))
+        src = os.path.join(WRITEFILE, cpp)   # 一律看移植樹的 FileRW/（--out 只改輸出寫到哪裡）
+        if not os.path.isfile(src):
+            raise SystemExit('_hand_kept.py: FileRW/%s (kBridge_%s) does not exist' % (cpp, cls))
+        if not re.search(r'\bextern\s+const\s+BridgeDesc\s+kBridge_%s\s*=' % re.escape(cls),
+                         open(src, encoding='utf-8', errors='replace').read()):
+            raise SystemExit('_hand_kept.py: FileRW/%s does not define kBridge_%s' % (cpp, cls))
+    return kept, count_note
