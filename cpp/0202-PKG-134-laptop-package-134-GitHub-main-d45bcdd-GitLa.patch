+
+    if(!OffLineGpibWay() && TestIF.iTestType==RS232_MODE && TestIF.iRs232Mode==eRs23232Bin)   //AI(W906-GB-P2d) 20260926: as above  //Steven 20121116 : RS232回傳的最大Bin數
+    {
