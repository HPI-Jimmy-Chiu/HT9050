+def main():
+    # --only <Class|struct>：只重產那一個結構的 cpp（其餘表單設定不轉、_registry.cpp／README 不動）。
+    # 多位工程師同時改不同表單時用；最後由整合的人不帶 --only 跑一次。
+    only = sys.argv[sys.argv.index('--only') + 1] if '--only' in sys.argv else None
