+        //  (&& binds tighter), only silences -Wparentheses.
+        if(IndexStatus==Z1_Z2_Down)
+            myIAR_Test.SetStartTest(3);                                         //Steven 20250102 : fixed for [I54]
+        else if(IndexStatus==Z1Down_Z2Up || (iContactMode==CONTACT_TEST && iIndexArm==0))
