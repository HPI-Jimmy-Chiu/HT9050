diff --git a/EtherCAT/Pci1203MotorRoute.cpp b/EtherCAT/Pci1203MotorRoute.cpp
index d2c804a..f6d917a 100644
--- a/EtherCAT/Pci1203MotorRoute.cpp
+++ b/EtherCAT/Pci1203MotorRoute.cpp
@@ -43,7 +43,8 @@
 static_assert(W906_ENG1203_GATE == 4, "ht9045_engine_route_armed_probe must compile the ARMED installer branch");
 #endif
 
-void (*g_W906MonitorPollNow)() = 0;           //AI(W906-HOME-POLL) 20261003: one 1203 monitor poll now, rate-limited by its owner (tools/wb_serve.cpp registers it); 0 = nothing (tests)
+void (*g_W906MonitorPollAfterHome)() = 0;     //AI(W906-HOME-WATCH) 20261003: ~40 ms pause + one 1203 monitor poll, not rate-limited (tools/wb_serve.cpp); 0 = nothing (tests)
+void (*g_W906MonitorPollNow)() = 0;          //AI(W906-HOME-POLL) 20261003: one 1203 monitor poll now, rate-limited by its owner (tools/wb_serve.cpp registers it); 0 = nothing (tests)
 void (*g_W906RouteNote)(const char*) = 0;    //AI(W906-ECAT-RECLAIM) 20261003: the op log's ROUTE line (tools/wb_serve.cpp W906_OpLogInit registers it); 0 = console only
 
 namespace ht9045 {
@@ -663,7 +664,18 @@ int RouteHomeStart(int board, int port, bool homeDir, double hi, double lo, doub
         Exec(board, port, *rec, c, "HomeStart card-side", true, true, &ok);
     }
     rec->homeSent = ok;
-    rec->homeCmdPoll = Env().PollCount();                             //AI(W906-HOME-SEEN) 20261003: a HOMING sample from a poll that ENDS after this counts (RouteHomeDone)
+    rec->homeCmdPoll = Env().PollCount();
+    //AI(W906-HOME-WATCH) 20261003: EastSun「我剛剛回inshuttle1 是正常的」-- 20:20:47 his single home of MInShuttle1 (already at its origin)
+    //  lasted 0.6 s; in the 20:18 full HOME the next monitor poll came 0.9 s after its Acm_AxHome, so the home was over unseen again.
+    //  Right after an issued home: up to 12 short polls (~40 ms apart) until the monitor samples this axis HOMING (or it left READY),
+    //  as the single-axis home sees it with its fast tick. At most ~0.5 s per axis; nothing in tests (hook unset).
+    if (ok && ::g_W906MonitorPollAfterHome) {
+        for (int w = 0; w < 12; ++w) {
+            ::g_W906MonitorPollAfterHome();
+            const Pci1203AxisSample& a = Env().Axis(slot);
+            if (a.homingSeenPoll > rec->homeCmdPoll) break;
+        }
+    }                            //AI(W906-HOME-SEEN) 20261003: a HOMING sample from a poll that ENDS after this counts (RouteHomeDone)
     if (ok) rec->stuck = false;      // Exec() re-marks it when the home command itself was not issued OK
     return ok ? 1 : 0;
 }
diff --git a/tools/wb_serve.cpp b/tools/wb_serve.cpp
index 201626e..9c464b9 100644
--- a/tools/wb_serve.cpp
+++ b/tools/wb_serve.cpp
@@ -7630,6 +7630,14 @@ void W906_MonitorPollNowFromEngine()
     if (ht9045::TPci1203Monitor* mon = ht9045::Pci1203Monitor()) { mon->SetYieldHook(0); mon->Poll(); mon->SetYieldHook(&W906_OutputYieldHook); { extern void W906_BrakeAxisTick(); W906_BrakeAxisTick(); } }
 }
 
+//AI(W906-HOME-WATCH) 20261003: right after an engine Acm_AxHome (Pci1203MotorRoute.cpp RouteHomeStart): 40 ms, then one monitor poll,
+//  not rate-limited -- a home of an axis already at its origin lasts ~0.6 s (MInShuttle1 20:20:47) and must be sampled HOMING.
+void W906_MonitorPollAfterHomeFromEngine()
+{
+    ::Sleep(40);
+    if (ht9045::TPci1203Monitor* mon = ht9045::Pci1203Monitor()) { mon->SetYieldHook(0); mon->Poll(); mon->SetYieldHook(&W906_OutputYieldHook); }
+}
