+    { extern void (*g_W906StateRecordNote)(const char*); g_W906StateRecordNote = &W906_OpSrNote; }  { extern void (*g_W906BrakeNote)(const char*); g_W906BrakeNote = &W906_OpBrakeNote; }  { extern void (*g_W906HomeNote)(const char*); g_W906HomeNote = &W906_OpHomeNote; }  { extern void (*g_W906RouteNote)(const char*); g_W906RouteNote = &W906_OpRouteNote; }  { extern void (*g_W906MotorHomeNote)(const char*); g_W906MotorHomeNote = &W906_OpHomeNote; }  { extern void (*g_W906MonitorPollNow)(); extern void W906_MonitorPollNowFromEngine(); g_W906MonitorPollNow = &W906_MonitorPollNowFromEngine; }  { extern void (*g_W906MonitorPollAfterHome)(); extern void W906_MonitorPollAfterHomeFromEngine(); g_W906MonitorPollAfterHome = &W906_MonitorPollAfterHomeFromEngine; }  ht9045::StreamSetSink(&W906_OpStreamNote);  { extern void (*g_W906VacuumNote)(const char*); g_W906VacuumNote = &W906_OpVacuumNote; }   //AI(W906-VACUNIT-1203) 20260930: + the ECAT-VC8 writes   //AI(W906-SR-HANG) 20260929; AI(W906-BRAKE-AXIS) 20260929 (2nd fix: the registration sat behind this comment) ; //AI(W906-STREAM-S1) 20260930
     std::printf("oplog: %s\\oplog_<yyyymmdd>.txt\n", g_opDir.c_str());
