+//AI(W906-F9050-FIX2) 20261006: Frank 本人 1006 的兩題（FROM_FRANK §3 08bffcb3），HT9050 正式流程（Do_Auto_InSH／Do_Auto_OutSH 只給 Type_HT9050）：
+//  (1)「也是給他的Range可以，約略正負10」：飛梭 case 1 等 Index Z1 在安全高度，910 是 ReadPos()==Prod.TestZ1_Safe 精確相等（差 1 count 就一直等）。
+#ifndef W906_HT9050_Z1_SAFE_TOL
+#define W906_HT9050_Z1_SAFE_TOL 10
+#endif
+bool W906_Ht9050Z1AtSafe()
+{
+    const int d=MOT[MTestZ1].ReadPos()-Prod.TestZ1_Safe;
+    return d<=W906_HT9050_Z1_SAFE_TOL && -d<=W906_HT9050_Z1_SAFE_TOL;
+}
+//  (2)「Out Shuttle Y 要在右邊才能讓Out Arm取到料」「要的」（W-92 ①，NB2-1 設計 B1）：910 的 Do_Auto_OutSH 只動 MOutShuttle1；Out Shuttle 的
+//  Y 軸（MOutShuttle2，M18）要推到 Prod.OutSHT[1].iRight（Out Arm 取料位）。推之前 Out Shuttle 1 要在 Right（已退出 Index）、Out Arm ZA 在原點
+//  （同 W906_Ht9050OutSht2ToLeft 的規則）。推回 Left 不用另外寫：Out Shuttle 1 要再進 Index 前，W906_Ht9050OutSht1MoveBlocked 會先把它推回 Left。
+//  true = Y 已在 Right。HT9050 以外一律 true（呼叫端只有 Type_HT9050 的流程）。
+bool W906_Ht9050OutShtYToRight(std::string *why)
+{
+    if(MachineTypeChoice!=Type_HT9050) return true;
+    if(W906_ShtAt(MOutShuttle2, Prod.OutSHT[1].iRight)) return true;
+    if(!W906_ShtAt(MOutShuttle1, Prod.OutSHT[0].iRight))
+    {
+        W906_ShtStopIfMoving(MOutShuttle2);
+        if(why) *why="Out Shuttle 1 not at Right / Out Shuttle 1 不在右邊";
+        return false;
+    }
+    if(!W906_ShtOutArmZAHome())
+    {
+        W906_ShtStopIfMoving(MOutShuttle2);
+        if(why) *why="Out Arm ZA not at home / Out Arm ZA 不在原點";
+        return false;
+    }
+    MOT[MOutShuttle2].MotorMove(Prod.OutSHT[1].iRight);
+    if(why) *why="Out Shuttle Y moving to Right / Out Shuttle Y 移往 Right";
+    return false;
+}
+//  Out Arm 從 Out Shuttle 1 取料前（aoutarm9045_All_1Picker.cpp DoPickFromShuttle_9045_All_1Pick）：HT9050 時 Y 也要在 Right。其他機種一律 true。
+bool W906_Ht9050OutShtYReadyForPick()
+{
+    if(MachineTypeChoice!=Type_HT9050) return true;
+    return W906_ShtAt(MOutShuttle2, Prod.OutSHT[1].iRight);
+}
