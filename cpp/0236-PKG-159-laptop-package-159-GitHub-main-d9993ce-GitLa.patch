+    //  判斷：InArmZSafe／OutArmZSafe(DETECT_POS_FLAG)＝每支吸嘴 Z 的 ReadPos()>=0（沒有低於原點）。不用原點燈：全機 HOME 完 Out Arm ZA 停在 0、燈是
+    //  滅的（Ht9050DryRun.cpp AI(W906-HT9050-DRYRUN-2)），而 HOME 第 1310 步會移 Tray 臂、不會先升 ZA，用燈的話 HOME 會卡在 1310。
+    //  不在上位 ⇒ Tray 臂停下來、回 false（呼叫端照常當「還沒到」重叫，ZA 上來後繼續）。只對 Type_HT9050；其他機種照舊。
+    if(MachineTypeChoice==Type_HT9050 &&
+       (InArmZSafe(DETECT_POS_FLAG)!=-1 || OutArmZSafe(DETECT_POS_FLAG)!=-1))
+    {
+        if(MOT[MTrayX].Motor!=NULL && MOT[MTrayX].Motor->Enable && MOT[MTrayX].Motor->MotionDone()==false)
+            MOT[MTrayX].PCIL132_StopMotor();
+        return false;
+    }
+
     #ifdef SOFT_SIMULTE
         bResult=MOT[MTrayX].MotorMove(p);
     #else
