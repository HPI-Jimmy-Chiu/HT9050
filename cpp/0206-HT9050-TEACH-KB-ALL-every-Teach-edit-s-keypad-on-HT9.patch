diff --git a/FileRW/TeachKb.cpp b/FileRW/TeachKb.cpp
index 329c182..78a9682 100644
--- a/FileRW/TeachKb.cpp
+++ b/FileRW/TeachKb.cpp
@@ -28,15 +28,21 @@
 #include "WebBridge/JsonWriter.h"
 #include "database.h"                                                     // W906_GpibModel（HT9050 分支）
 
-//AI(W906-TEACH-KB-9050) 20261004: HT9050 的 Loader Y（setEditLoaderY）先不卡上下限 —— 使用者 1004「開個9050的分支，
-//  然後先不要卡控上下限，若要卡控請將值給設定到最大」。golden 9046LS 臂是 -70000～-74000（uteach.cpp:3781），
-//  這台 Loader Y 教導值 -70000 已在邊上、只能往一邊調 4000。
-//  0 ＝ 開小鍵盤、不夾（不顯示 Max／Min，Abort 放回原值）；1 ＝ 夾在下面兩個值（golden setEditLimitClick 最寬的 else 臂 :4249）。
-#ifndef W906_HT9050_LOADERY_KB_CHECK
-#define W906_HT9050_LOADERY_KB_CHECK 0
+//AI(W906-TEACH-KB-9050) 20261004: HT9050 的 Teach 欄位先不卡上下限 —— 使用者 1004「開個9050的分支，
+//  然後先不要卡控上下限，若要卡控請將值給設定到最大」（先只做 Loader Y：golden 9046LS 臂 -70000～-74000，uteach.cpp:3781，
+//  這台教導值 -70000 已在邊上），同日「請將Teach裡面全部的上下限都以此例做修正」⇒ 全部欄位。
+//  做法：W906_TeachKbRange 先照 golden 算（下面 GoldenRange，其他機種原樣），HT9050 上凡是「有範圍」的結果
+//  （1 固定範圍／3 edtMoveTo 用選取馬達的軟體極限／4 開機前的軟體極限）一律改成：
+//    W906_HT9050_TEACH_KB_CHECK 0 ＝ 5（開小鍵盤、不夾；不顯示 Max／Min，Abort 放回原值）；
+//                               1 ＝ 夾在下面兩個值（golden setEditLimitClick 最寬的 else 臂 :4249）。
+//  golden 本來就不開小鍵盤的欄位（2）不變 —— 那不是上下限。
+#ifndef W906_HT9050_TEACH_KB_CHECK
+#define W906_HT9050_TEACH_KB_CHECK 0
 #endif
-#define W906_HT9050_LOADERY_KB_MAX  200000
-#define W906_HT9050_LOADERY_KB_MIN -200000
+#define W906_HT9050_TEACH_KB_MAX  200000
+#define W906_HT9050_TEACH_KB_MIN -200000
+
+bool W906_TeachKbIsHT9050() { return W906_GpibModel == "9050GPIB" || MachineTypeChoice == Type_HT9050; }   // 判法同 W906_MainCaption
 
 namespace {
 
@@ -254,8 +260,19 @@ const Row kRows[] = {
 
 // kind：0 不是 Teach 小鍵盤欄位；1 範圍 a／b（golden ShowQwertyKey 的 min／max 兩個參數，原樣、不排序）；
 //       2 golden 處理器不開小鍵盤（直接 return）；3 用目前選取的馬達（edtMoveTo）；4 那一軸的 Motor 還沒建（開機前）；
-//       5 開小鍵盤但不卡上下限（AI(W906-TEACH-KB-9050) 20261004，HT9050 Loader Y）
+//       5 開小鍵盤但不卡上下限（AI(W906-TEACH-KB-9050) 20261004，HT9050，見檔頭）
+static int GoldenRange(const std::string& edit, double* a, double* b);
 int W906_TeachKbRange(const std::string& edit, double* a, double* b)
+{
+    const int k = GoldenRange(edit, a, b);
+    if ((k == 1 || k == 3 || k == 4) && W906_TeachKbIsHT9050()) {              //AI(W906-TEACH-KB-9050) 20261004: 見檔頭
+        if (!W906_HT9050_TEACH_KB_CHECK) return 5;
+        *a = W906_HT9050_TEACH_KB_MIN; *b = W906_HT9050_TEACH_KB_MAX;
+        return 1;
+    }
+    return k;
+}
+static int GoldenRange(const std::string& edit, double* a, double* b)
 {
     const Row* r = nullptr;
     for (std::size_t i = 0; i < sizeof(kRows) / sizeof(kRows[0]); ++i)
@@ -278,8 +295,6 @@ int W906_TeachKbRange(const std::string& edit, double* a, double* b)
         if (n == "setEditLoaderX" || n == "setEditOcrX")
             return bLS ? rg(29000, 19000) : rg(23000, 19000);                                                          // :3760-3767
         if (n == "setEditLoaderY" || n == "setEditOcrY") {                                                             // :3771-3795
-            if (n == "setEditLoaderY" && (W906_GpibModel == "9050GPIB" || MachineTypeChoice == Type_HT9050))         //AI(W906-TEACH-KB-9050) 20261004: HT9050 分支（見檔頭）；判法同 W906_MainCaption
-                return W906_HT9050_LOADERY_KB_CHECK ? rg(W906_HT9050_LOADERY_KB_MIN, W906_HT9050_LOADERY_KB_MAX) : 5;
             if (bLS) return bYVar ? rg(-60000, -68000) : rg(-70000, -74000);
             return bYVar ? rg(-45000, -100000) : rg(-53000, -100000);
         }
@@ -448,11 +463,13 @@ std::string FileRW_Teach_KbExtraJson()
     }
     w.EndObject();
     w.Key("motorSoft").BeginObject();
-    for (int m = 0; m < MAX_TRAY_MOTOR; ++m) {
+    const bool b9050 = W906_TeachKbIsHT9050();                                   //AI(W906-TEACH-KB-9050) 20261004: edtMoveTo 也不卡 ——
+    for (int m = 0; m < MAX_TRAY_MOTOR; ++m) {                                   //  不卡＝不送（頁面改走沒有範圍的小鍵盤）；要卡＝送最寬的那組
         if (MOT[m].Motor == nullptr) continue;
+        if (b9050 && !W906_HT9050_TEACH_KB_CHECK) continue;
         w.Key(std::to_string(m)).BeginArray();
-        w.Number((wb_int64)MOT[m].Motor->PSoftLimitP);
-        w.Number((wb_int64)MOT[m].Motor->PSoftLimitN);
+        w.Number((wb_int64)(b9050 ? W906_HT9050_TEACH_KB_MAX : MOT[m].Motor->PSoftLimitP));
+        w.Number((wb_int64)(b9050 ? W906_HT9050_TEACH_KB_MIN : MOT[m].Motor->PSoftLimitN));
         w.EndArray();
     }
     w.EndObject();
