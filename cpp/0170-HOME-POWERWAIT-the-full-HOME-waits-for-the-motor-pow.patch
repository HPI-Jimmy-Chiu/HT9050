diff --git a/uhome.cpp b/uhome.cpp
index 2bd67c1..84f789f 100644
--- a/uhome.cpp
+++ b/uhome.cpp
@@ -708,7 +708,11 @@ static int        s_W906HomeAfterReset = 310;
 void (*g_W906HomeNote)(const char*) = 0;      //AI(W906-HOME-ALMRESET-3) 20261003: the op log's HOME line (tools/wb_serve.cpp W906_OpLogInit registers it); 0 = console only
 static void W906_HomeNote(const std::string& s) { std::printf("[HOME] %s\n", s.c_str()); if(g_W906HomeNote) g_W906HomeNote(s.c_str()); }
 static int        s_W906HomeResetTries = 0;
-static std::string s_W906HomeSent;            //AI(W906-HOME-ALMRESET-3) 20261003: the axes case 300 sent Alarm Reset + Servo ON to   //AI(W906-HOME-ALMRESET-2) 20261003: 1 s retries before an axis counts as abnormal (the motor power relay comes back ~4 s after HOME starts)
+static TQPF_Timer s_W906HomePowerStable;      //AI(W906-HOME-POWERWAIT) 20261003: motor power ON 1 s in a row before the SVON check
+static TQPF_Timer s_W906HomePowerTimeout;     //  20 s for the motor power to come back
+static bool       s_W906HomePowerOk = false;
+static int        s_W906HomePowerOffTicks = 0;
+static std::string s_W906HomeSent;           //AI(W906-HOME-ALMRESET-3) 20261003: the axes case 300 sent Alarm Reset + Servo ON to   //AI(W906-HOME-ALMRESET-2) 20261003: 1 s retries before an axis counts as abnormal (the motor power relay comes back ~4 s after HOME starts)
 bool ProcessMotorHome(bool Flag2)
 {
 #ifndef SOFT_SIMULTE
@@ -2277,6 +2281,9 @@ bool ProcessMotorHome(bool Flag2)
             fHome->iHomeStep=302;
             s_W906HomeResetWait.SetMSAndOn(500);                                //  0.5 s: the drives answer the reset / Servo ON (also the brakes' servo-ON 0.5 s rule)
             s_W906HomeResetTries=0;
+            s_W906HomePowerOk=false;                                            //AI(W906-HOME-POWERWAIT) 20261003: the power must read ON 1 s in a row first
+            s_W906HomePowerOffTicks=0;
+            s_W906HomePowerStable.SetMSAndOn(1000);
             W906_HomeNote("step 300: alarm reset + servo on sent to " + s_W906HomeSent);   //AI(W906-HOME-ALMRESET-3) 20261003
             MotorTask=FIRST_HOME;                                               //第一階段回Home
             for(int i=0; i<TOTAL_MOTOR; i++)
@@ -2296,6 +2303,56 @@ bool ProcessMotorHome(bool Flag2)
                 SoftStop=true;
                 break;
             }
+            //AI(W906-HOME-POWERWAIT) 20261003: EastSun「你沒有等servo on 訊號回來 就直接全部歸原點?」-- 19:07:48.6 the motor relay read 1->0
+            //  and came back 0->1 at 19:07:52.6, yet the 0.5 s check let HOME go on (the drive's SVON bit is no proof the motor power is there)
+            //  and the homes timed out ("Motor not home yet" 19:08:35). Now: the motor power (SW[SwMotorRelay] + Sen[SnMotorPower] when
+            //  enabled) must read ON for 1 s in a row; every OFF->ON re-sends Alarm Reset + Servo ON to every enabled motor, then the
+            //  SVON / alarm check below runs. Power not back within 20 s = HOME stops with the reason in the op log.
+            {
+                const bool pwr = SW[SwMotorRelay].Status() && (Sen[SnMotorPower].Enable==false || Sen[SnMotorPower].IsOn());
+                if(!pwr)
+                {
+                    if(s_W906HomePowerOk || s_W906HomePowerOffTicks==0)
+                        W906_HomeNote(std::string("waiting for the motor power: SwMotorRelay=") + (SW[SwMotorRelay].Status() ? "1" : "0") +
+                                      " SnMotorPower=" + (Sen[SnMotorPower].Enable ? (Sen[SnMotorPower].IsOn() ? "1" : "0") : "n/a"));
+                    s_W906HomePowerOk=false;
+                    s_W906HomePowerStable.SetMSAndOn(1000);
+                    if(++s_W906HomePowerOffTicks==1) s_W906HomePowerTimeout.SetSecAndOn(20);
+                    if(s_W906HomePowerTimeout.Off())
+                    {
+                        W906_HomeNote("STOP: the motor power did not come back within 20 s");
+                        fHome->ListBox1->Items->Insert(0, "Motor power is not on (SwMotorRelay / SnMotorPower)");
+                        StopAllMotor();
+                        SystemStart=false;
+                        ShowMyMessage("Motor power is not on!", "馬達電源沒有開!", "ProcessMotorHome");
+                        fHome->fAbort=false;
+                        fHome->iHomeStep=1;
+                        SoftStop=true;
+                        return true;
+                    }
+                    break;
+                }
+                if(!s_W906HomePowerOk)
+                {
+                    if(!s_W906HomePowerStable.Off())                            //  ON, but not yet 1 s in a row
+                        break;
+                    s_W906HomePowerOk=true;
+                    if(s_W906HomePowerOffTicks>0)                               //  it was OFF: the drives lost their Servo ON -- send it again
+                    {
+                        for(int i=0; i<TOTAL_MOTOR; i++)
+                        {
+                            if(fHome->HomeClass[i]->THomeFlag==0 || MOT[i].Motor==NULL || MOT[i].Motor->Enable==false)
+                                continue;
+                            MOT[i].Motor->ResetState();
+                            MOT[i].ServoOnOff(true);
+                        }
+                        W906_HomeNote("motor power back (on for 1 s): alarm reset + servo on sent again to " + s_W906HomeSent);
+                        s_W906HomeResetTries=0;
+                        s_W906HomeResetWait.SetMSAndOn(1000);
+                    }
+                    s_W906HomePowerOffTicks=0;
+                }
+            }
             if(!s_W906HomeResetWait.Off())
                 break;
             {
