From 3c2771cb5e99f2528d78f40ba81f1ad0e91feb54 Mon Sep 17 00:00:00 2001
From: "HT9045 Machine (V906)" <Claude_RDBC_02@honprec.com>
Date: Sat, 3 Oct 2026 17:53:18 +0800
Subject: [PATCH] MODCHECK-2: unaddressable stations (the ring junctions,
 EastSun 1003 'station numbers cannot conflict or you could not read them;
 what you see is the relay station, just look at the motors') no longer block
 the first-connect write of Pci1203Modules.ini -- 17:19 it was refused for '3
 station(s) unaddressable'; ctest Pci1203ModuleCheck [3g] now expects the
 write

---
 EtherCAT/Pci1203ModuleCheck.h      | 5 ++++-
 tests/test_pci1203_modulecheck.cpp | 2 +-
 2 files changed, 5 insertions(+), 2 deletions(-)

diff --git a/EtherCAT/Pci1203ModuleCheck.h b/EtherCAT/Pci1203ModuleCheck.h
index 493ab8f..0c31166 100644
--- a/EtherCAT/Pci1203ModuleCheck.h
+++ b/EtherCAT/Pci1203ModuleCheck.h
@@ -331,7 +331,10 @@ inline std::string Pci1203ModuleWriteBlock(const Pci1203ModuleInput& in)
     if (!in.open || in.disabled)  return "card not open / monitor disabled";
     if (in.scanTruncated)         return "the scan was truncated (wall-clock budget)";
     if (in.slavesFound <= 0 || in.stations.empty()) return "the scan found no station";
-    if (in.unaddressable > 0) { std::snprintf(b, sizeof(b), "%d station(s) unaddressable (SubDevice ID conflict)", in.unaddressable); return b; }
+    //AI(W906-MODCHECK-2) 20261003: EastSun「站號一定不衝突 不然你不會讀得到 你看到衝突的 是中繼站 你單純看馬達就好」-- the unaddressable
+    //  stations are the ring's junctions (no IO / motor module), so they no longer block the first-connect write (17:19 it was refused for
+    //  "3 station(s) unaddressable"). They were never listed anyway (InputFromMonitor skips them).
+    (void)b;
     for (std::size_t i = 0; i < in.stations.size(); ++i) {
         const Pci1203ModuleStation& s = in.stations[i];
         if (!s.infoValid || s.position < 0) {
diff --git a/tests/test_pci1203_modulecheck.cpp b/tests/test_pci1203_modulecheck.cpp
index 40fe36e..66f505d 100644
--- a/tests/test_pci1203_modulecheck.cpp
+++ b/tests/test_pci1203_modulecheck.cpp
@@ -244,7 +244,7 @@ int main()
         Pci1203ModuleCheck c; FakeIni ini; Run run;
         FakeMon m = Healthy(); m.s[6] = m.s[3]; m.s[6].unaddressable = true;
         Feed(c, m, ini, 0, 12000, 200, run);
-        check(run.write == 0 && run.skip == 1 && has(run.lastSkip, "unaddressable"), "[3g] an unaddressable station -> not written");
+        check(run.write == 1 && run.skip == 0, "[3g] AI(W906-MODCHECK-2) 20261003: an unaddressable station (a ring junction, EastSun) no longer blocks the write");
     }
     {
         Pci1203ModuleCheck c; FakeIni ini; Run run;
-- 
