diff --git a/tests/test_flow9050_tray.cpp b/tests/test_flow9050_tray.cpp
index 9cd4cdb..c38b6f7 100644
--- a/tests/test_flow9050_tray.cpp
+++ b/tests/test_flow9050_tray.cpp
@@ -723,6 +723,20 @@ int main(int argc, char** argv)
         Sen[SnLoaderTrayHasTray].Type = 0;
         W906_ShowErrorMessage_Reset();
     }
+    {   // AI(W906-PROBESENSOR9050) 20261008: EastSun 1008 -- HT9050's layer probe reads SnLoaderDrawerHasTray, Off = a tray found
+        extern bool W906_LoaderProbeSeesTray();
+        const int mt = MachineTypeChoice;
+        MachineTypeChoice = Type_HT9050;
+        Sen[SnLoaderDrawerHasTray].Enable = true;  Sen[SnLoaderDrawerHasTray].Type = 1;     // reads OFF (fixture as above)
+        CHECK(Sen[SnLoaderDrawerHasTray].IsOff() && W906_LoaderProbeSeesTray(), "[PS] HT9050: SnLoaderDrawerHasTray OFF while probing = a tray at this layer");
+        Sen[SnLoaderDrawerHasTray].Type = 0;                                               // reads ON
+        CHECK(Sen[SnLoaderDrawerHasTray].IsOn() && !W906_LoaderProbeSeesTray(), "[PS] HT9050: SnLoaderDrawerHasTray ON while probing = no tray");
+        MachineTypeChoice = Type_HT9046_LS;  Sen[SnLoaderTrayHasTray].Enable = true;  Sen[SnLoaderTrayHasTray].Type = 0;   // ON
+        CHECK(W906_LoaderProbeSeesTray(), "[PS] other machines: SnLoaderTrayHasTray ON = a tray (910)");
+        Sen[SnLoaderTrayHasTray].Enable = false;  Sen[SnLoaderTrayHasTray].Type = 0;
+        Sen[SnLoaderDrawerHasTray].Enable = false;  Sen[SnLoaderDrawerHasTray].Type = 0;
+        MachineTypeChoice = mt;
+    }
 
