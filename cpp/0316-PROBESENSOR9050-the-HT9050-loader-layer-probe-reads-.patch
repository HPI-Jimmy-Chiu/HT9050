From ff9bb8522ef158784076c2a7571ea7668b5d4879 Mon Sep 17 00:00:00 2001
From: "HT9045 Machine (V906)" <Claude_RDBC_02@honprec.com>
Date: Thu, 8 Oct 2026 01:14:21 +0800
Subject: [PATCH] PROBESENSOR9050: the HT9050 loader layer probe reads
 SnLoaderDrawerHasTray, Off = a tray found -- EastSun 1008 (01:03 MES0924
 DoLoad_9050_1110: SnLoaderTrayHasTray on at layers 2-4, limit 5 reached) ->
 'C_TrayZ_Select open, and SnLoaderDrawerHasTray goes Off when a tray is found
 while probing, On when not'.

asendic_Loader.cpp DoLoad_9050 cases 1100 / 1115 / 1125 ask W906_LoaderProbeSeesTray (end of file): HT9050 (9050GPIB or Type_HT9050) = Sen[SnLoaderDrawerHasTray].IsOff(); other machines = Sen[SnLoaderTrayHasTray].IsOn() (910). The selector is already Push (open) at case 1100 -- unchanged. Same lines + end of file. tests/test_flow9050_tray.cpp: + [PS] 3 checks. Flow9050_Tray 119/119. Debug and release linked. WORKLOG row 198.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 asendic_Loader.cpp           | 19 +++++++++++++++----
 docs/WORKLOG_MACHINE.md      |  1 +
 tests/test_flow9050_tray.cpp | 14 ++++++++++++++
 3 files changed, 30 insertions(+), 4 deletions(-)

diff --git a/asendic_Loader.cpp b/asendic_Loader.cpp
index 0e7bc56..88b3713 100644
--- a/asendic_Loader.cpp
+++ b/asendic_Loader.cpp
@@ -2802,7 +2802,7 @@ int W906_TrayZ9050(int zone, int up, int layer); int W906_TrayZ9050Home(int zone
     return false;
 }
 
-int  LoadTask_9050 = 1;
+int  LoadTask_9050 = 1;  bool W906_LoaderProbeSeesTray();   //AI(W906-PROBESENSOR9050) 20261008: end of file
 void InitLoadTask_9050()
 {
     LoadTask_9050 = 1;
@@ -2910,7 +2910,7 @@ void DoLoad_9050()
             {
                 if(MOT[MLoaderZ].MotorMove(W906_TrayZ9050(0, 1, iLoaderLayerCountDetect_9050)) == 1)   //AI(W906-TRAYZ-PITCH) 20261006: probe = Up of the layer (EastSun「探測就是上位 加層數」); was Prod.TrayZ_Up[..]
                 {
-                    if(Sen[SnLoaderTrayHasTray].IsOn())
+                    if(W906_LoaderProbeSeesTray())   /* AI(W906-PROBESENSOR9050) 20261008: was Sen[SnLoaderTrayHasTray].IsOn() */
                         Task = 1110;                                                    // 往上探
                     else
                         Task = 1120;                                                    // 往下探
@@ -2941,7 +2941,7 @@ void DoLoad_9050()
         case 1115:
             if(MOT[MLoaderZ].MotorMove(W906_TrayZ9050(0, 1, iLoaderLayerCountDetect_9050)) == 1)   //AI(W906-TRAYZ-PITCH) 20261006: was Prod.TrayZ_Up[..]
             {
-                if(Sen[SnLoaderTrayHasTray].IsOn())
+                if(W906_LoaderProbeSeesTray())   /* AI(W906-PROBESENSOR9050) 20261008 */
                 {
                     // 這層還 ON → 下次 poll 再 ++
                     Task = 1110;
@@ -2975,7 +2975,7 @@ void DoLoad_9050()
         case 1125:
             if(MOT[MLoaderZ].MotorMove(W906_TrayZ9050(0, 1, iLoaderLayerCountDetect_9050)) == 1)   //AI(W906-TRAYZ-PITCH) 20261006: was Prod.TrayZ_Up[..]
             {
-                if(Sen[SnLoaderTrayHasTray].IsOn())
+                if(W906_LoaderProbeSeesTray())   /* AI(W906-PROBESENSOR9050) 20261008 */
                 {
                     // 這層 ON → 就是答案
                     iLoaderLayerCount_9050=iLoaderLayerCountDetect_9050;
@@ -3882,3 +3882,14 @@ bool DoKnockBeforeRemainICCheck(bool bIsFirst)
     return false;
 }
 //---------------------------------------------------------------------------
+//==============================================================================
+//AI(W906-PROBESENSOR9050) 20261008: EastSun 1008 "while probing the layers SnLoaderDrawerHasTray goes Off when a tray is found and On when not" --
+//  DoLoad_9050 cases 1100 / 1115 / 1125 ask this instead of Sen[SnLoaderTrayHasTray].IsOn(). HT9050 (9050GPIB or Type_HT9050): the
+//  drawer sensor, inverted (Off = a tray at this layer). Other machines: SnLoaderTrayHasTray on, as 910.
+bool W906_LoaderProbeSeesTray()
+{
+    extern AnsiString W906_GpibModel;
+    if(W906_GpibModel=="9050GPIB" || MachineTypeChoice==Type_HT9050)
+        return Sen[SnLoaderDrawerHasTray].IsOff();
+    return Sen[SnLoaderTrayHasTray].IsOn();
+}
