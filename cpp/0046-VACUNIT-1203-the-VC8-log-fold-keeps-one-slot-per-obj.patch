From 57c3d45f180a5fad6cafd0b3b09cdfd133dd5891 Mon Sep 17 00:00:00 2001
From: "HT9045 Machine (V906)" <Claude_RDBC_02@honprec.com>
Date: Wed, 30 Sep 2026 21:05:52 +0800
Subject: [PATCH] VACUNIT-1203: the VC8 log fold keeps one slot per object (32
 thrashed)

EtherCAT/Pci1203Vc8Route.inc folds a repeated, not-issued VC8 write to one console / oplog
line a minute per object. The key table had 32 slots, but with no ECAT-VC8 on the ring
golden's tmr1Timer retries the threshold MODE write on every visible panel every second
(~48 distinct objects on HT9050): the least-recent slot was evicted every write, so every
refusal printed every second. 256 slots (> 6 stations x (16 DO + 8 VC x 2 subs) = 192).

build_integ_ship_x86_o2: wb_serve + test_vacuum_vc8 rebuilt, VacuumVc8 passes, control gate
unchanged (the slot writer is now Pci1203Vc8Route.inc:391), pe_truncation_check PASS,
production_audit 0 changes.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 EtherCAT/Pci1203Vc8Route.inc | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/EtherCAT/Pci1203Vc8Route.inc b/EtherCAT/Pci1203Vc8Route.inc
index 8dc2de4..d2fb1be 100644
--- a/EtherCAT/Pci1203Vc8Route.inc
+++ b/EtherCAT/Pci1203Vc8Route.inc
@@ -148,7 +148,8 @@ TVc8Write& Vc8NewWrite_(int kind, int ring, int ip, int chan, int sub, int value
 //  The write is still refused, kept in the ring and shown on the page each time; only the console / oplog line is
 //  folded, with the count. An ISSUED write is always printed.
 struct Vc8LogKey_ { int kind, ring, ip, chan, sub, rc; unsigned long tick; unsigned long folded; };
-Vc8LogKey_ s_vc8Log[32];
+const int kVc8LogKeys = 256;   // > every object a tick can refuse (6 stations x (16 DO + 8 VC x 2 subs) = 192); 32 thrashed at ~48 a tick
+Vc8LogKey_ s_vc8Log[kVc8LogKeys];
 
 bool Vc8LogDue_(const TVc8Write& w, int rc, unsigned long* folded)
 {
@@ -156,7 +157,7 @@ bool Vc8LogDue_(const TVc8Write& w, int rc, unsigned long* folded)
     if (w.issued) return true;
     const unsigned long now = (unsigned long)::GetTickCount();
     int freeSlot = -1, oldest = 0;
-    for (int i = 0; i < 32; ++i) {
+    for (int i = 0; i < kVc8LogKeys; ++i) {
         Vc8LogKey_& k = s_vc8Log[i];
         if (k.tick == 0) { if (freeSlot < 0) freeSlot = i; continue; }
         if (k.kind == w.kind && k.ring == w.ring && k.ip == w.ip && k.chan == w.chan && k.sub == w.sub && k.rc == rc) {
