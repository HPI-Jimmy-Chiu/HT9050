 }
 
@@ -8483,6 +8483,7 @@ void ForwardShowMotorErrorMessage(const char* code, int keyCode, int pos, const
     g_w906MotorNoteUnit = unitName ? unitName : "";
     g_w906MotorNoteMsg  = message ? message : "";
     std::printf("  [motor-note] %s unit=%s pos=%d: %s\n", code ? code : "", g_w906MotorNoteUnit, pos, g_w906MotorNoteMsg);
+    { char b[512]; std::snprintf(b, sizeof(b), "%s unit=%s pos=%d: %s", code ? code : "", g_w906MotorNoteUnit, pos, g_w906MotorNoteMsg); OpLine("JAM", b); }   //AI(W906-HOME-ALMRESET-3) 20261003: the motor jam note in the op log too (the 1003 HOME stops showed only "Motor not home yet" there, not WHICH motor)
     ForwardShowErrorMessage(code, 0, pos);
     g_w906MotorNoteUnit = 0;
     g_w906MotorNoteMsg  = 0;
diff --git a/uhome.cpp b/uhome.cpp
index 9a654bc..2bd67c1 100644
--- a/uhome.cpp
+++ b/uhome.cpp
@@ -705,7 +705,10 @@ void TfHome::InitGali_HomeTask()
 //AI(W906-HOME-ALMRESET) 20261003: case 300 -> 302 (alarm reset + servo ON of every enabled motor, then the check); see case 302
 static TQPF_Timer s_W906HomeResetWait;
 static int        s_W906HomeAfterReset = 310;
-static int        s_W906HomeResetTries = 0;   //AI(W906-HOME-ALMRESET-2) 20261003: 1 s retries before an axis counts as abnormal (the motor power relay comes back ~4 s after HOME starts)
+void (*g_W906HomeNote)(const char*) = 0;      //AI(W906-HOME-ALMRESET-3) 20261003: the op log's HOME line (tools/wb_serve.cpp W906_OpLogInit registers it); 0 = console only
+static void W906_HomeNote(const std::string& s) { std::printf("[HOME] %s\n", s.c_str()); if(g_W906HomeNote) g_W906HomeNote(s.c_str()); }
+static int        s_W906HomeResetTries = 0;
+static std::string s_W906HomeSent;            //AI(W906-HOME-ALMRESET-3) 20261003: the axes case 300 sent Alarm Reset + Servo ON to   //AI(W906-HOME-ALMRESET-2) 20261003: 1 s retries before an axis counts as abnormal (the motor power relay comes back ~4 s after HOME starts)
 bool ProcessMotorHome(bool Flag2)
 {
 #ifndef SOFT_SIMULTE
@@ -2194,6 +2197,7 @@ bool ProcessMotorHome(bool Flag2)
             }
             SetCylinderResetStateHomeBegin();
             fHome->ResetAllMotorLed();
+            s_W906HomeSent.clear();                                             //AI(W906-HOME-ALMRESET-3) 20261003
             for(int i=0; i<TOTAL_MOTOR; i++)
             {
                 MOT[i].MotorInitial();
@@ -2215,6 +2219,7 @@ bool ProcessMotorHome(bool Flag2)
                 {                                                               //  ＋「檢查最開始時有沒有把所有馬達都激磁」-- NOT golden (golden resets / servos ON
                     MOT[i].Motor->ResetState();                                 //  per axis inside each home, InitMotor in EtherCatMotHome Task 1): every enabled
                     MOT[i].ServoOnOff(true);                                    //  motor gets its Alarm Reset (Acm_AxResetError via the route) and Servo ON here;
+                    s_W906HomeSent += std::string(s_W906HomeSent.empty() ? "" : ", ") + MOT[i].Alias.c_str();   //AI(W906-HOME-ALMRESET-3) 20261003: EastSun「ROTATE 你有先激磁嗎?」-- the list goes to the op log
                 }                                                               //  case 302 checks the result after 0.5 s
             }
             MOT[MTrayX].TrayArmInitial();
@@ -2272,6 +2277,7 @@ bool ProcessMotorHome(bool Flag2)
             fHome->iHomeStep=302;
             s_W906HomeResetWait.SetMSAndOn(500);                                //  0.5 s: the drives answer the reset / Servo ON (also the brakes' servo-ON 0.5 s rule)
             s_W906HomeResetTries=0;
+            W906_HomeNote("step 300: alarm reset + servo on sent to " + s_W906HomeSent);   //AI(W906-HOME-ALMRESET-3) 20261003
             MotorTask=FIRST_HOME;                                               //第一階段回Home
             for(int i=0; i<TOTAL_MOTOR; i++)
             {
@@ -2333,13 +2339,16 @@ bool ProcessMotorHome(bool Flag2)
                         }
                     }
                     if(s_W906HomeResetTries==1 || s_W906HomeResetTries%5==0)
+                    {
                         fHome->ListBox1->Items->Insert(0, AnsiString(("Waiting for alarm reset / servo on: " + sBad).c_str()));
+                        W906_HomeNote("retry " + std::to_string(s_W906HomeResetTries) + "/20 alarm reset + servo on: " + sBad);   //AI(W906-HOME-ALMRESET-3) 20261003: which axis, in the op log
+                    }
                     s_W906HomeResetWait.SetMSAndOn(1000);
                     break;
                 }
                 if(iBad>=0)                                                     //  an axis still in alarm / not excited after the retries: HOME stops,
                 {                                                               //  the first one gets golden's motor jam popup, the list goes to the listbox
-                    std::printf("[HOME] after Alarm Reset + Servo ON, %d motor(s) abnormal: %s\n", nBad, sBad.c_str());
+                    W906_HomeNote("STOP: after Alarm Reset + Servo ON, " + std::to_string(nBad) + " motor(s) abnormal: " + sBad);   //AI(W906-HOME-ALMRESET-3) 20261003: was printf only (not in the op log)
                     fHome->ListBox1->Items->Insert(0, AnsiString(("Abnormal after alarm reset / servo on: " + sBad).c_str()));
                     StopAllMotor();
                     SystemStart=false;
@@ -2353,6 +2362,7 @@ bool ProcessMotorHome(bool Flag2)
                     return true;
                 }
                 fHome->ListBox1->Items->Insert(0, "All motors: alarm reset + servo on OK");
+                W906_HomeNote("all motors alarm reset + servo on OK after " + std::to_string(s_W906HomeResetTries) + " retr(ies) -> step " + std::to_string(s_W906HomeAfterReset));   //AI(W906-HOME-ALMRESET-3) 20261003
                 fHome->iHomeStep=s_W906HomeAfterReset;                          //  golden's next step (305 / 310)
             }
             break;
