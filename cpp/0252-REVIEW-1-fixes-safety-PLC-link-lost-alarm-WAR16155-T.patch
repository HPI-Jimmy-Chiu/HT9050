+//------------------------------------------------------------------------------
+//AI(W906-PLCLOST) 20261007: EastSun 1006 (asked whether a PLC link loss should clear the door data) 「Plc斷線額外寫異常」.
+//  Review 20261006: after a link loss golden keeps the last frame (its clear block in PLCStatusCheck is commented out, Ken 20250428),
+//  so doors / EMG keep reading "closed", and bCheckPLCConnet only notices once the socket itself is down -- a pulled cable can stay
+//  "connected" for tens of seconds. This is the separate alarm: the link is LOST when SafePlcIO=1 and either the socket is not
+//  connected or no reply frame has arrived for kW906PlcLostMs (from the first ask, so "never answered since boot" counts too).
+//  csystem.cpp DoSystem raises WAR16155 on it while running (same place as golden's G12 check). The door / EMG data are not touched.
+#include <chrono>
+static const long kW906PlcLostMs = 2000;
+static long long s_w906PlcFrameAt = 0, s_w906PlcSince = 0;
+static long long W906_PlcNowMs()
+{
+    return (long long)std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+void W906_SafePlcFrameMark()
+{
+    s_w906PlcFrameAt = W906_PlcNowMs();
+}
+bool W906_SafePlcLinkLost()
+{
+    if(!Enable_PLCSafety_IO)
+        return false;
+    const long long now = W906_PlcNowMs();
+    if(s_w906PlcSince == 0)
+        s_w906PlcSince = now;
+    const long long ref = s_w906PlcFrameAt ? s_w906PlcFrameAt : s_w906PlcSince;
+    return !PlcComm.IsConnected() || (now - ref) > kW906PlcLostMs;
+}
