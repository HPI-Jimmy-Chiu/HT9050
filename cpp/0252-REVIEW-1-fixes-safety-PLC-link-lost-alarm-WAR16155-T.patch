+                bPLCIOEffect=true;                                              //完成過一次 (completed at least once)   { void W906_SafePlcFrameMark(); W906_SafePlcFrameMark(); }   //AI(W906-PLCLOST) 20261007: frame time for the link-lost alarm (end of file)
                 iSlave++;
