+    DWORD hbAt = (g_w906IoHeartAt != 0) ? (DWORD)g_w906IoHeartAt : t0, noteAt = t0;   //AI(W906-IOFIX-2) 20261007: the freeze clock starts at the last heartbeat, not at this request (was hbAt = t0)
