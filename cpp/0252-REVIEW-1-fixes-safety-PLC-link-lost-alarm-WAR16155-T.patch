         if (reg.T[i].setBtn == btn || reg.T[i].goBtn == btn) {
             own = &reg.T[i]; t.ownList = 'T'; t.ownIndex = (int)i;
             if (reg.T[i].seq > lastSeq) { lastSeq = reg.T[i].seq; regVis = reg.T[i].vis; }
-        }
+        }   { bool W906_TeachTypedOnly(const std::string&); if (own && W906_TeachTypedOnly(own->edit0)) return btn + ": " + own->edit0 + " 不是位置（pitch／抬升量／探測層數是手動輸入的數值），沒有 Set／GO"; }   //AI(W906-TRAYZ-PITCH-2) 20261007: review 20261006 -- these 12 HT9050 Tray Z rows' registry buttons were live server-side (EOF)
     std::map<std::string, TeachBtnInfo>::const_iterator bi = reg.btns.find(btn);
     const TeachBtnInfo* info = (bi != reg.btns.end()) ? &bi->second : 0;
     if (info) {
@@ -8976,3 +8976,21 @@ bool ServoOnEncSync(IMotorAccessBackend& be, long long wireId, const MotorAccess
 }
 }  // namespace
 }  // namespace ht9045
+//AI(W906-TRAYZ-PITCH-2) 20261007: review 20261006 (Tray Z): the HT9050 Tray Z typed rows (pitch / hand-over lift / Loader probe start /
+//  probe limit; tools/gen_teach_registry.py EXT_ROWS) are TECH_PARA rows, so their registry Set / Go buttons resolved like any
+//  position: a hand-made WS teachGo btn=btnGoTZ9050LoaderPitch would drive MLoaderZ to the pitch value, a teachSet would write an
+//  encoder position into the probe limit. The page shows no such buttons; MotorAccessResolveTeachButton now refuses them here.
+namespace ht9045 {
+bool W906_TeachTypedOnly(const std::string& edit)
+{
+    if (edit.compare(0, 13, "setEditTZ9050") != 0)
+        return false;
+    static const char* const tails[] = { "Pitch", "Lift", "ProbeStart", "ProbeLimit" };
+    for (const char* t : tails) {
+        const std::string s(t);
+        if (edit.size() > s.size() && edit.compare(edit.size() - s.size(), s.size(), s) == 0)
+            return true;
+    }
+    return false;
+}
+}  // namespace ht9045
