+//  (Timer1Timer :159-173, Interval = 50 in iosetview.dfm). Here: the click picks it (Click_), wb_serve's loop
+//  calls W906_IoTestSuckTick() every pass (~50 ms). Both on the tick thread: no lock.
+// ---------------------------------------------------------------------------
+TMySucker*  s_suckerTemp = 0;
+int         s_changeSuckStatus = SStatusOff;   // MachineType.h eSuckerStatus: SStatusOff / SStatusSuck / SStatusDestory
+std::string s_suckAlias;
+
 // ---------------------------------------------------------------------------
 //  AI(W906-IOWEB-P21) 20260925: CLICK-LATENCY LOG. User: "我點擊按鈕 有時候需要等上
 //  2秒線圈才會有反應 這是json 的問題 還是1203的問題?" / "你寫個LOG 給我測測看不就知道了?"
@@ -285,9 +300,48 @@ static bool Click_(const std::string& alias, int desiredDown, std::string& out,
         }
     }
     const bool indexHasIC = IndexHasIC();
-    if (indexHasIC && alias.find("TestSuck") != std::string::npos && W906_IO_PAGE_NO_GUARDS) bypassed.push_back("Index 上有 IC（TestSuck 走 Suck()/Destroy()）");  else if (indexHasIC && alias.find("TestSuck") != std::string::npos) {   // golden :1040, DEVIATION (b)   //AI(W906-IO-NOGUARD) 20260929
-        out = "Index 上有 IC：golden 對 TestSuck 走 Suck()／Destroy() 流程（iosetview.cpp:1040-1083），這條還沒移植，所以不送";
-        return false;
+    if (indexHasIC && alias.find("TestSuck") != std::string::npos) {   // golden :1040-1083 -- AI(W906-IOWIDGET-3) 20261001: ported (was DEVIATION (b), refused / with NO_GUARDS a raw write)
+        //  not a guard (it is golden's OTHER way to do the click), so W906_IO_PAGE_NO_GUARDS does not skip it.
