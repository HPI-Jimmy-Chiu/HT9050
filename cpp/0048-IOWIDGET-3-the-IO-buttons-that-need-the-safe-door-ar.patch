 //  "modal-pending" (golden's ShowModal made the IO form unreachable). 0 in W906_IO_PAGE_NO_GUARDS restores that.
 bool W906_IoPageNoGuards() { return W906_IO_PAGE_NO_GUARDS != 0; }
+
+// ---------------------------------------------------------------------------
+//  AI(W906-IOWIDGET-3) 20261001: golden Tfiosetview::Timer1Timer :159-173, the TestSuck part -- every pass of
+//  wb_serve's loop (golden: the IO form's 50 ms timer). Idle = one compare.
+//    SStatusSuck:    Suck() done or Error -> off
+//    SStatusDestory: Sensor() on -> off; else Destroy() done or Error -> off
+//  The sucker's own Suck() / Destroy() write its coils through MyLaneIO as the engine does (source "engine": a
+//  write of the value the card already reads back is skipped, so the coil is not re-sent every 50 ms).
+//  ⚠ NOT PORTED from the same timer: CheckIndexSuck / ProcessIndexSuckDestroy1/2 (INDEX_SUCKER_TYPE==1) and
+//    CheckIndexAllSuckICFallDown -- golden runs them only while the IO form is shown; the web IO page is never
+//    "closed" (the iframe is hidden), so running them here would run them all the time.
+// ---------------------------------------------------------------------------
+void W906_IoTestSuckTick()
+{
+    if (s_changeSuckStatus == SStatusOff || s_suckerTemp == 0) return;
+    const int was = s_changeSuckStatus;
+    if (s_changeSuckStatus == SStatusSuck) {                                   // golden :159 手動開啟Index吸嘴
+        if (s_suckerTemp->Suck() == true || s_suckerTemp->Error == true)
+            s_changeSuckStatus = SStatusOff;
+    } else if (s_changeSuckStatus == SStatusDestory) {                         // golden :164 手動吹氣
+        if (s_suckerTemp->Sensor() == true)
+            s_changeSuckStatus = SStatusOff;
+        else if (s_suckerTemp->Destroy() == true || s_suckerTemp->Error == true)
+            s_changeSuckStatus = SStatusOff;
+    }
+    if (s_changeSuckStatus == SStatusOff)
+        std::printf("io.btnPanelClick %s -> TestSuck %s finished on %s%s\n", s_suckAlias.c_str(),
+                    was == SStatusSuck ? "Suck()" : "Destroy()", s_suckerTemp->SuckerName.c_str(),
+                    s_suckerTemp->Error ? " (Error)" : "");
+}
