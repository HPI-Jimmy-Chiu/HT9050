+                else if ((FTestSuck.Suck[i][j].SuckerName + "_Off") == a) { pick = &FTestSuck.Suck[i][j]; bOk = true; status = SStatusDestory; }
+                else if ((BTestSuck.Suck[i][j].SuckerName + "_Off") == a) { pick = &BTestSuck.Suck[i][j]; bOk = true; status = SStatusDestory; }
