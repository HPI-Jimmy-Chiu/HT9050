diff --git a/uhome.cpp b/uhome.cpp
index 958b48d..424e7e6 100644
--- a/uhome.cpp
+++ b/uhome.cpp
@@ -2420,6 +2420,23 @@ bool ProcessMotorHome(bool Flag2)
                     return true;
                 }
                 fHome->ListBox1->Items->Insert(0, "All motors: alarm reset + servo on OK");
+                //AI(W906-HOME-BRAKE) 20261003: EastSun「我發現你 激磁 煞車都沒放」-- golden releases the brake groups at case 20; with the
+                //  0926 ruling (release only while the group's 1203 axes are servo-ON, W906_BrakeReleaseOK) that release was skipped there --
+                //  the motor power had just come back (case 2/3 relay cycle, DoMotorPowerOn holds the brakes) and nothing was servo-ON yet --
+                //  and nobody released them later: DoSystem's idle pass does not run during HOME and the per-axis brake tick only acts on a
+                //  servo OFF->ON edge (SVON never dropped in the monitor). Now that every motor is confirmed servo-ON, the same five groups
+                //  in golden's case-20 order, same rule; each group's result goes to the op log.
+                {
+                    std::string sBrk;
+                    const bool bI = W906_BrakeReleaseOK("Index",        "HOME after servo on");  if(bI) IndexMotorBreakerON();
+                    const bool bM = W906_BrakeReleaseOK("Magazine",     "HOME after servo on");  if(bM) MagazineBreakerON();
+                    const bool bA = W906_BrakeReleaseOK("InOutArmZ",    "HOME after servo on");  if(bA) InOutArmZBreakerON();
+                    const bool bL = W906_BrakeReleaseOK("LDCarRotArmZ", "HOME after servo on");  if(bL) LDCarRotArmZBreakerOn();
+                    const bool bC = W906_BrakeReleaseOK("Cassette",     "HOME after servo on");  if(bC) CassetteBreakerON();
+                    sBrk = std::string("brakes released after servo on: Index=") + (bI ? "yes" : "NO") + " Magazine=" + (bM ? "yes" : "NO") +
+                           " InOutArmZ=" + (bA ? "yes" : "NO") + " LDCarRotArmZ=" + (bL ? "yes" : "NO") + " Cassette=" + (bC ? "yes" : "NO");
+                    W906_HomeNote(sBrk);
+                }
                 W906_HomeNote("all motors alarm reset + servo on OK after " + std::to_string(s_W906HomeResetTries) + " retr(ies) -> step " + std::to_string(s_W906HomeAfterReset));   //AI(W906-HOME-ALMRESET-3) 20261003
                 fHome->iHomeStep=s_W906HomeAfterReset;                          //  golden's next step (305 / 310)
             }
