+                   'WB_PUMP_1203_START_RING'   = $true; 'WB_ENGINE_IO_1203' = $true; 'WB_ENGINE_MOTOR_1203' = $true <#AI(W906-ENGHOME) 20261002: EastSun 1002 both on#>; 'WB_ENGINE_INDEXZ_1203' = $false }   #AI(W906-INDEXZ) 20260930: + the Index Z1 Gali_* -> 1203 route (MachineType.h EOF, EtherCAT/Pci1203GaliRoute.cpp), OFF by default (INBOX 113). To arm: $true here AND uncomment it in MachineType.h -- both   # AI(W906-IOWEB-P17) 20260925: + the engine IO route (MachineType.h EOF), user ruling "請幫我接上1203"   # AI(W906-ECAT-ROUTE) 20260929: + the ENGINE MOTOR route (MachineType.h EOF, EtherCAT/Pci1203MotorRoute.cpp), OFF by default (design 7.1 "預設關"). To arm: $true here AND uncomment it in MachineType.h -- both
