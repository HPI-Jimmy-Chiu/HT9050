index 31759b9..2c338b4 100644
--- a/tools/wb_serve.cpp
+++ b/tools/wb_serve.cpp
@@ -6402,7 +6402,7 @@ void W906_OutputYieldHook()
 void W906_OpLogMotorRuntime(const std::string& json);  namespace {   //AI(W906-OPLOG) 20260928: declared at global scope HERE (a block-scope extern inside the unnamed namespace would name a different function); defined at the end of the file
 CRITICAL_SECTION g_apiCacheLock;
 bool             g_apiCacheReady = false;
-std::string      g_apiCache[4];
+std::string      g_apiCache[4];  volatile LONG g_apiIoGetMs = 0;  bool g_apiIoGetEver = false;   //AI(W906-IOTUNE-D) 20261006: when the socket thread last served /api/struct/io/runtime (W906_ApiCacheGet) -- PLAN_IOTUNE.md D; same line
 
 std::string W906_ApiCacheBuild(int which)
 {
@@ -6439,7 +6439,7 @@ void W906_ApiCacheRefresh()
     std::string fresh[4];
     bool built[4] = { false, false, false, false };
     for (int i = 0; i < 4; ++i) {
-        if ((i == 0 || i == 2) && !schemas) continue;
+        if ((i == 0 || i == 2) && !schemas) continue;  { static const bool s_ioAlways = [](){ const char* e = std::getenv("W906_APICACHE_IO_ALWAYS"); return e != 0 && e[0] == '1'; }();  if (i == 1 && !s_ioAlways && !g_apiCache[1].empty() && (!g_apiIoGetEver || (DWORD)(::GetTickCount() - (DWORD)g_apiIoGetMs) > 3000u)) continue; }   //AI(W906-IOTUNE-D) 20261006: the io runtime body (148 KB, ~2/3 of the 18 ms rebuild, 10 per second) only while a page read it in the last 3 s (10-06 idle: http io=0 reads); env W906_APICACHE_IO_ALWAYS=1 = every time; same line
         fresh[i] = W906_ApiCacheBuild(i);   // built outside the lock: the socket thread never waits on JSON generation
         built[i] = true;
         W906_ServiceOutputs(5);
@@ -6462,7 +6462,7 @@ std::string W906_ApiCacheGet(int which)
     if (!g_apiCacheReady || which < 0 || which > 3)
         return std::string("{\"error\":\"api cache not ready\"}");
     ::EnterCriticalSection(&g_apiCacheLock);
-    const std::string copy = g_apiCache[which];
+    const std::string copy = g_apiCache[which];  if (which == 1) { ::InterlockedExchange(&g_apiIoGetMs, (LONG)::GetTickCount()); g_apiIoGetEver = true; }   //AI(W906-IOTUNE-D) 20261006: a page reads the io runtime -> keep rebuilding it (W906_ApiCacheRefresh); same line
     ::LeaveCriticalSection(&g_apiCacheLock);
     return copy;
 }
