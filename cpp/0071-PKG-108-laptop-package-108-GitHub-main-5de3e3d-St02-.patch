+  check(says.length > saysBefore && /sbNormalTest/.test(says[says.length - 1]) && /改回/.test(says[says.length - 1]), 'status line says why');
+
+  console.log('[6] not operable (events.operable=false) -> nothing sent, put back');
+  const B = arrows(sbB);
