 uhome.cpp | 36 ++++++++++++------------------------
 1 file changed, 12 insertions(+), 24 deletions(-)

diff --git a/uhome.cpp b/uhome.cpp
index 0156972..8ee97ad 100644
--- a/uhome.cpp
+++ b/uhome.cpp
@@ -729,6 +729,10 @@ static bool W906_HomeTwoZ(int p, int sp, AnsiString s)
     return MOT[MTestZ1].Gali_Two_ZAxis_Move(p, sp, s);
 }
 #define W906_HomePos(x) (W906_IsHT9050() ? 0 : (x))
+//AI(W906-HOME-TRAYWAIT) 20261003: EastSun「他這個東西應該都寫到一個define 而不是 值寫在兩個地方」-- the Tray Arm's wait position after the
+//  full HOME, in one place: golden picks Color (tray OCR) or Empty (uhome.cpp steps 1310 move / 1310 safe check / 1530 check all repeated
+//  that choice), then W906_HomePos (0 on HT9050 until the points are taught). The 23:31 loop came from one copy not matching the others.
+#define W906_TrayArmHomeWaitPos() W906_HomePos((INSTALL_OCR!=eocrUninstal && CosFunction.bTrayOCR) ? Prod.iXTrayColor : Prod.iXTrayEmpty)
 static TQPF_Timer s_W906HomeResetWait;
 static int        s_W906HomeAfterReset = 310;
 void (*g_W906HomeNote)(const char*) = 0;      //AI(W906-HOME-ALMRESET-3) 20261003: the op log's HOME line (tools/wb_serve.cpp W906_OpLogInit registers it); 0 = console only
@@ -3968,10 +3972,7 @@ bool ProcessMotorHome(bool Flag2)
 
             if(flag2==false)
             {
-                if(INSTALL_OCR!=eocrUninstal && CosFunction.bTrayOCR)
-                    flag2=W906_HomeTrayArm(W906_HomePos(Prod.iXTrayColor));
-                else
-                    flag2=W906_HomeTrayArm(W906_HomePos(Prod.iXTrayEmpty));
+                flag2=W906_HomeTrayArm(W906_TrayArmHomeWaitPos());            //AI(W906-HOME-TRAYWAIT) 20261003: golden's Color / Empty choice is in the define
             }
 
             if(flag3==false)
@@ -4197,10 +4198,7 @@ bool ProcessMotorHome(bool Flag2)
             {
                 bIsYCarMoving=false;                                            //RogerYang 20251029 : 修正Loader Y motor判斷有無tray可能被機構誤觸發
                 #ifndef SOFT_SIMULTE
-                if(INSTALL_OCR!=eocrUninstal && CosFunction.bTrayOCR)
-                    iTrayArmPos=Prod.iXTrayColor;
-                else
-                    iTrayArmPos=Prod.iXTrayEmpty;
+                iTrayArmPos=W906_TrayArmHomeWaitPos();                          //AI(W906-HOME-TRAYWAIT) 20261003: the same wait position as the move above
 
                 MOT[MTrayX].ScanMotorStatus();
                 if(MOT[MTrayX].Motor->Enable)
@@ -4289,23 +4287,13 @@ bool ProcessMotorHome(bool Flag2)
             }
             break;
         case 1530:                                                              //Steven 20200206 : 增加歸零的保護機制
-            if(INSTALL_OCR!=eocrUninstal && CosFunction.bTrayOCR)
+            //AI(W906-HOME-1530POS) 20261003: EastSun「我又hang 了」-- 23:31 HOME looped 1300 -> 1520 -> 1530 -> 1300: step 1310 sent the Tray Arm
+            //  to 0 on HT9050 but this check compared with the raw Prod.iXTrayEmpty (6800). Now the one wait position (W906_TrayArmHomeWaitPos,
+            //  golden's Color / Empty choice inside it).
+            if(MOT[MTrayX].ReadEncoderPos()<=W906_TrayArmHomeWaitPos()-100)
             {
-                if(MOT[MTrayX].ReadEncoderPos()<=W906_HomePos(Prod.iXTrayColor)-100)   //AI(W906-HOME-1530POS) 20261003: the same target step 1310 sent it to
-                {
-                    fHome->iHomeStep=1300;
-                    break;
-                }
-            }
-            else
-            {
-                if(MOT[MTrayX].ReadEncoderPos()<=W906_HomePos(Prod.iXTrayEmpty)-100)   //AI(W906-HOME-1530POS) 20261003: EastSun「我又hang 了」-- 23:31 HOME looped
-                //  1300 -> 1520 -> 1530 -> 1300: on HT9050 step 1310 sends the Tray Arm to 0 (W906_HomePos) but this check compared with the raw
-                //  Prod.iXTrayEmpty (6800), so 0 <= 6700 always sent HOME back to 1300. Now the same target as step 1310 (HT9050 0, others golden).
-                {
-                    fHome->iHomeStep=1300;
-                    break;
-                }
+                fHome->iHomeStep=1300;
+                break;
             }
             //AI(W906-HOME-C2) 20260920: GATE (W906-HOME-C2-MAGAZINE)
             // 缺相依：`InitialMagazineUpDown()` / `DoMagazineUpDown(int,int)`
