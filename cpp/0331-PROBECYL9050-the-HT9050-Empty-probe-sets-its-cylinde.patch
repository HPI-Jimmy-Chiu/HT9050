diff --git a/tests/test_flow9050_tray.cpp b/tests/test_flow9050_tray.cpp
index 6bf7891..3e2cac4 100644
--- a/tests/test_flow9050_tray.cpp
+++ b/tests/test_flow9050_tray.cpp
@@ -1146,4 +1146,60 @@ void FlowTraceTail()
     iPickFromLoadStageTask = sPick; CatchTrayTask = sCatch; iCatchFromEmpty9050Task = sEmp;
     for (int i = 0; i < MAX_ARM_Row; ++i) for (int j = 0; j < MAX_ARM_Col; ++j) InArmSuckUse[i][j] = sUse[i][j];
     iLoaderLayerCount_9050 = -1; iEmptyLayerCount_9050 = -1; iAuto1LayerCount_9050 = 0; iAuto2LayerCount_9050 = 0; iAuto3LayerCount_9050 = 0;
+    { void ProbeCylOnce(); ProbeCylOnce(); }   // [PC] AI(W906-PROBECYL9050) 20261008, below
+}
+
+// ===========================================================================
+//  [PC] AI(W906-PROBECYL9050) 20261008: EastSun 1008「empty 的部分怎麼動作那麼遲緩」-- the Empty probe satisfies its cylinder chain
+//       (EdgeClip / EdgePush / LoaderZ_Select Pop, C_Empty_Up Push) ONCE, then each layer only moves MEmptyZ. A cylinder whose
+//       Pop can never finish (a huge delay) stops the probe before the first move (control), and no longer stops it once set.
+// ===========================================================================
+extern int W906_ProbeEmpty9050(); extern void W906_InitProbeEmpty9050();
+void ProbeCylOnce()
+{
+    printf("[PC] Empty probe: the cylinder chain once, then each layer only moves Z\n");
+    const int savedMt = MachineTypeChoice;  MachineTypeChoice = Type_HT9050;
+    const int cyl[4] = { C_EmptyEdgeClip, C_EmptyEdgePush, C_EmptyLoaderZ_Select, C_Empty_Up };
+    bool sEn[4], sOnS[4], sOffS[4]; int sOnD[4], sOffD[4];
+    for (int k = 0; k < 4; ++k) {
+        TMyCylinder& c = Cylinder[cyl[k]];
+        sEn[k] = c.Enable; sOnS[k] = c.OnSenEnable; sOffS[k] = c.OffSenEnable; sOnD[k] = c.OnDelayTime; sOffD[k] = c.OffDelayTime;
+        c.Enable = true; c.OnSenEnable = false; c.OffSenEnable = false; c.OnDelayTime = 1; c.OffDelayTime = 1; c.Reset();
+    }
+    double sDepth[4]; for (int k = 0; k < 4; ++k) { sDepth[k] = UserDefForm_File[k].ZDepth; UserDefForm_File[k].ZDepth = 0; }   // the taught pitch
+    const int sUp = Tech.iTrayZ9050UpBase[1], sPitch = Tech.iTrayZ9050Pitch[1], sHome = Tech.iTrayZ9050Home[1];
+    Tech.iTrayZ9050UpBase[1] = 21000; Tech.iTrayZ9050Pitch[1] = 2300; Tech.iTrayZ9050Home[1] = 0;
+    const bool sSelEn = Sen[SenEmptySelectHasTray].Enable, sDrwEn = Sen[SnEmptyDrawerHasTray].Enable;
+    const int  sSelTy = Sen[SenEmptySelectHasTray].Type,   sDrwTy = Sen[SnEmptyDrawerHasTray].Type;
+    Sen[SenEmptySelectHasTray].Enable = true; Sen[SenEmptySelectHasTray].Type = 1;   // reads OFF at the fixture's all-zero address: no tray
+    Sen[SnEmptyDrawerHasTray].Enable  = true; Sen[SnEmptyDrawerHasTray].Type  = 1;   // the drawer agrees: count 0 at the end
+    CHECK(Sen[SenEmptySelectHasTray].IsOff() && Sen[SnEmptyDrawerHasTray].IsOff(), "[PC] fixture: no tray seen anywhere");
+    FreeAxis(MEmptyZ);  SetMotPos(MEmptyZ, 0);
+    iEmptyLayerCount_9050 = -1;  W906_InitProbeEmpty9050();
+
+    // control: EdgeClip's Pop can never finish -> the probe never moves
+    Cylinder[C_EmptyEdgeClip].OffDelayTime = 100000;
+    for (int i = 0; i < 60; ++i) { W906_ProbeEmpty9050(); Sleep(2); }
+    CHECK(Pos(MEmptyZ) == 0 && iEmptyLayerCount_9050 == -1, "[PC] control: a cylinder not yet in place stops the probe before its first move");
+
+    // the chain completes once -> the first (deepest usable) layer, Up[9] = 21000 - 9*2300 = 300
+    Cylinder[C_EmptyEdgeClip].OffDelayTime = 1;  Cylinder[C_EmptyEdgeClip].Reset();
+    for (int i = 0; i < 600 && Pos(MEmptyZ) != W906_TrayZ9050(1, 1, 9); ++i) { W906_ProbeEmpty9050(); Sleep(5); }
+    CHECK(Pos(MEmptyZ) == W906_TrayZ9050(1, 1, 9), "[PC] chain satisfied: MEmptyZ at the first probe layer (Up[9] = 300)");
+
+    // now EdgeClip would wait forever again -- the next layers must not ask it
+    Cylinder[C_EmptyEdgeClip].OffDelayTime = 100000;  Cylinder[C_EmptyEdgeClip].Reset();
+    for (int i = 0; i < 3000 && iEmptyLayerCount_9050 < 0; ++i) W906_ProbeEmpty9050();
+    CHECK(iEmptyLayerCount_9050 == 0 && Pos(MEmptyZ) == W906_TrayZ9050(1, 1, 0),
+          "[PC] the remaining layers 8..0 ran without the cylinder chain: count 0 (no tray), MEmptyZ at Up[0] = 21000");
+
+    for (int k = 0; k < 4; ++k) {
+        TMyCylinder& c = Cylinder[cyl[k]];
+        c.Enable = sEn[k]; c.OnSenEnable = sOnS[k]; c.OffSenEnable = sOffS[k]; c.OnDelayTime = sOnD[k]; c.OffDelayTime = sOffD[k]; c.Reset();
+    }
+    for (int k = 0; k < 4; ++k) UserDefForm_File[k].ZDepth = sDepth[k];
+    Tech.iTrayZ9050UpBase[1] = sUp; Tech.iTrayZ9050Pitch[1] = sPitch; Tech.iTrayZ9050Home[1] = sHome;
+    Sen[SenEmptySelectHasTray].Enable = sSelEn; Sen[SenEmptySelectHasTray].Type = sSelTy;
+    Sen[SnEmptyDrawerHasTray].Enable = sDrwEn;  Sen[SnEmptyDrawerHasTray].Type = sDrwTy;
+    iEmptyLayerCount_9050 = -1;  W906_InitProbeEmpty9050();  MachineTypeChoice = savedMt;
 }
