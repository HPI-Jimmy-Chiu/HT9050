--- a/acatchtray.cpp
+++ b/acatchtray.cpp
@@ -9910,11 +9910,11 @@ bool DoCoverTray(int iAuto)
 //  tray at Up[n-1]+lift and makes n-1. Type_HT9050 paths only; golden untouched.
 //==============================================================================
 int W906_TrayZ9050Home(int zone);
-static int s_iEmptyProbeTask9050 = 1, s_iEmptyProbeLayer9050 = 0, s_iEmptyProbeFirst9050 = 0, s_iEmptyNoTray9050 = 0;
+static int s_iEmptyProbeTask9050 = 1, s_iEmptyProbeLayer9050 = 0, s_iEmptyProbeFirst9050 = 0, s_iEmptyNoTray9050 = 0, s_iEmptyProbeCylOk9050 = 0;   /* AI(W906-PROBECYL9050) 20261008: EastSun 1008 'Empty moves so slowly' -- the probe sets its cylinders ONCE (1 = done), then each layer only moves Z; the sensorless EdgeClip / EdgePush (1.5 s delay, IO_Table row 207) restarted their delay on every scan of the && chain, 27-38 s per layer */
 void W906_InitProbeEmpty9050()
 {
     s_iEmptyProbeTask9050 = 1;
-    s_iEmptyNoTray9050    = 0;
+    s_iEmptyNoTray9050    = 0;  s_iEmptyProbeCylOk9050 = 0;   /* AI(W906-PROBECYL9050) 20261008 */
 }
 //  Probe (MEmptyZ): Home, then Up[L] from the deepest layer not below Home, one layer up per step, until SenEmptySelectHasTray => L+1 trays.
 int W906_ProbeEmpty9050()
@@ -9937,16 +9937,16 @@ int W906_ProbeEmpty9050()
                 L = MAX_LOADER_LAYER_9050 - 1;
                 while(L > 0 && W906_TrayZ9050(1, 1, L) < W906_TrayZ9050Home(1))  // never below Home
                     L--;
-                s_iEmptyProbeFirst9050 = L;
+                s_iEmptyProbeFirst9050 = L;  s_iEmptyProbeCylOk9050 = 0;   /* AI(W906-PROBECYL9050) 20261008: a new probe sets the cylinders again */
                 Task = 100;
                 #endif
             }
             break;
         case 100:
-            if(Cylinder[C_EmptyEdgeClip].Pop() &&
+            if(s_iEmptyProbeCylOk9050 || Cylinder[C_EmptyEdgeClip].Pop() &&   /* AI(W906-PROBECYL9050) 20261008: set already -> skip the chain (&& binds before ||) */
                Cylinder[C_EmptyEdgePush].Pop() &&
                Cylinder[C_EmptyLoaderZ_Select].Push())
-            {
+            {   s_iEmptyProbeCylOk9050 = 1;   /* AI(W906-PROBECYL9050) 20261008: cylinders in place -- the next layers only move Z */
                 if(MOT[MEmptyZ].MotorMove(W906_TrayZ9050(1, 1, L)) == 1)
                 {
                     if(Sen[SenEmptySelectHasTray].IsOn())
