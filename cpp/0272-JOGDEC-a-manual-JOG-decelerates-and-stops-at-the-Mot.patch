+// =============================================================================
+//  AI(W906-JOGDEC) 20261007: EastSun「我有的時候JOG 放開後 沒有馬上停 一直過去」; ruling 1007「JOG 一律用 Mot_Table 加減速 100%」.
+//  11:41 MOutArmZA jogged at 33 % with acc / dec 80 (= 1 % of Mot_Table 8000, the speed table's %): the stop reached the card in
+//  30 ms but the axis slid 2.6 s / ~7700 counts. Now the jog family's Acc / Dec = Mot_Table Acc / Dec, and the release stops an
+//  axis this page jogged with Acm_AxStopDecEx at that Dec. Same numbers as 11:41; through MotorAccessDispatch (the page's path).
+// =============================================================================
+void test_jog_dec_100pct()
+{
+    printf("\n[JOGDEC] manual JOG: jog Acc / Dec = Mot_Table (100 %%), the release stops at Mot_Table Dec (Acm_AxStopDecEx)\n");
+    MotorAccessResetJobs();
+    MotorGolden g;
+    g.valid = true; g.enable = true; g.gearRatio = 1.0; g.softP = 1000000; g.softN = -1000000;
+    g.jogHigh = 80000; g.jogLow = 10000; g.initSpeed = 10000; g.acc = 80; g.dec = 80; g.homeFlag = 1;   // runtime dAcc / dDec at 1 %
+    g.homeHigh = 100000; g.homeLow = 10000; g.accDb = 8000; g.decDb = 8000; g.range = 100; g.rate = 100;  // Mot_Table Acc / Dec
+    g.motorClass = 0; g.sensorType = true; g.in1Logic = false;
+    FakeBackend be;
+    be.table["MOutArmZA"] = Axis1203(0, 0, 0, 6);
+    be.table["B"] = Axis1203(21, 21, 0, 7);                                    // axis 7: never jogged anywhere in this test binary (g_jogStopDec is per process)
+    be.aliasOf[0] = "MOutArmZA"; be.aliasOf[21] = "B";
+    be.golden[0] = g; be.golden[21] = g;
+    be.opened.assign(8, true);
+    for (int ax = 0; ax < 8; ++ax) { be.cmdPos[ax] = 0.0; be.state[ax] = 1; }
+    be.executed.clear();
+    MotorAccessReq r = Req("uMotorTest", "jogN", "MOutArmZA"); r.button = "sbMotorTest_JogN";
+    MotorAccessOutcome o = MotorAccessDispatch(r, 41, be);
+    double jAcc = -1, jDec = -1;
+    for (std::size_t i = 0; i < be.executed.size(); ++i) {
+        if (be.executed[i].kind != kCmdAxSetSpeed || be.executed[i].axis != 6) continue;
+        if (be.executed[i].speed == kSpeedJogAcc) jAcc = be.executed[i].value;
+        if (be.executed[i].speed == kSpeedJogDec) jDec = be.executed[i].value;
+    }
+    CHECK(o.ok && jAcc == 8000.0 && jDec == 8000.0,
+          "jog family Acc / Dec = Mot_Table 8000 (was 80 = the speed table's 1 % -> 11:41 slid 2.6 s after release)");
+    be.executed.clear();
+    MotorAccessReq rel = Req("uMotorTest", "stop", "MOutArmZA"); rel.button = "sbMotorTest_JogN";
+    o = MotorAccessDispatch(rel, 41, be);
+    double stopDec = -1;
+    for (std::size_t i = 0; i < be.executed.size(); ++i) if (be.executed[i].kind == kCmdAxStop && be.executed[i].axis == 6) stopDec = be.executed[i].value;
+    CHECK(o.ok && stopDec == 8000.0, "the jog release stops the axis with Acm_AxStopDecEx at Mot_Table Dec 8000 (kCmdAxStop value)");
+    be.executed.clear();
+    MotorAccessReq relB = Req("uMotorTest", "stop", "B"); relB.button = "sbMotorTest_JogN";
+    (void)MotorAccessDispatch(relB, 42, be);
+    double stopB = -1;
+    for (std::size_t i = 0; i < be.executed.size(); ++i) if (be.executed[i].kind == kCmdAxStop && be.executed[i].axis == 7) stopB = be.executed[i].value;
+    CHECK(stopB == 0.0, "an axis this page never jogged: plain Acm_AxStopDec (value 0), as before");
+}
