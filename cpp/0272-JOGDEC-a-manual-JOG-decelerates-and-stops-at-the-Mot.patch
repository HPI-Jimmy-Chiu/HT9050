+        { kSpeedJogInit, sp.velLow }, { kSpeedJogRun, sp.velHigh }, { kSpeedJogAcc, jAcc }, { kSpeedJogDec, jDec } };   //AI(W906-JOGDEC) 20261007: jog Acc / Dec = Mot_Table (was sp.acc / sp.dec = the speed table's %); same line
