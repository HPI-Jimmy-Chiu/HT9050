         case kCmdAxStop:
             if (!ValidateAxis(c.axis, r.why)) break;
-            std::snprintf(call, sizeof(call), "Acm_AxStopDec(ax=%d)", c.axis);
+            if (c.value > 0) std::snprintf(call, sizeof(call), "Acm_AxStopDecEx(ax=%d, dec=%.1f)", c.axis, c.value); else std::snprintf(call, sizeof(call), "Acm_AxStopDec(ax=%d)", c.axis);   //AI(W906-JOGDEC) 20261007: value > 0 = stop with that deceleration (Acm_AxStopDecEx, vendor AdvMotApi.h); 0 = as before (every engine / Galil / page stop leaves value 0). Same line
             r.accepted = true;
