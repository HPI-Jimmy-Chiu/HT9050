@@ -1764,7 +1765,13 @@ bool TMyEtherCatMotor::EtherCatMotHome()
         SetSoftLimit(999999,-999999); W906_EcHomeStart(iBoardID, iPortID, HomeDirection, PHomeHighSpeed, PHomeLowSpeed, dAcc, dDec); Task=10; break;   // result ignored like golden's MoveHome WAR16122: Task 10 regardless
       case 10: if(W906_EcHomeDone(iBoardID, iPortID)==1) { HomeDelay.SetSecAndOn(0.3); Task=20; } break;   // a HOMING sample, then a READY one, both after the command
       case 20: if(HomeDelay.Off()) { LastHomePos=-ReadPos(); if(W906_EcHomeCardSide(iBoardID, iPortID)) { SetCommand(0); MySleep(10); SetPosition(0); }   // DS402: no zeroing (EastSun)
+            //AI(W906-ZHOME-200) 20261002: EastSun「Z軸歸原點 ... 往回 200 就好」-- a Z axis then moves iW906ZHomeBackoff pulses (+ = the home
+            //  direction, his pick) at PHomeLowSpeed through the route's MoveRel, and the home ends when that move is done (Task 30).
+            //  golden's own home pitch (mySYNTEKmotor.cpp:684-692, iHomePitch=200 from TMyMotor::Home) moves the OPPOSITE way.
+            if(iW906ZHomeBackoff!=0) { W906_EcSetSpeed(iBoardID, iPortID, PHomeLowSpeed, PHomeLowSpeed, dAcc, dDec, false);
+                W906_EcCall(iBoardID, iPortID, kEcMoveRel, 0, (double)(HomeDirection ? iW906ZHomeBackoff : -iW906ZHomeBackoff)); Task=30; break; }
             SetSpeed(OldSpeed); SetSoftLimit(PSoftLimitP, PSoftLimitN); Task=1; return true; } break;
+      case 30: if(MotionDone()) { SetSpeed(OldSpeed); SetSoftLimit(PSoftLimitP, PSoftLimitN); Task=1; return true; } break;   //AI(W906-ZHOME-200) 20261002: MotionDone never answers from a pending sample (design 4.2); golden MotorHome's 90 s ResetTime bounds it
       default: Task=1; return false; }
     return false;
 #endif
