+                }
                 if (h.g.armZ) {                                                 // golden ProcessSingleMotorHome case 500：MotorMove(ZSafePos)（下一段）
                     h.phase = 1; h.elapsedMs = 0; h.zIssued = false;
                     continue;
@@ -2342,6 +2350,45 @@ void TickHomes(IMotorAccessBackend& be, int ms)
                 continue;
             }
             if (h.elapsedMs > kHomeTimeoutMs) { be.GoldenSetHomeFlag(h.mi, 2); CancelHome(be, h, true, "home timeout -> HomeFlag=2"); }
+        } else if (h.phase == 2) {
+            //AI(W906-ZHOME-200) 20261002: EastSun 1002 -- after the drive home a Z axis moves g_W906ZHomeBackoff pulses (+ = the home
+            //  direction, his pick; golden's own home pitch mySYNTEKmotor.cpp:684-692 goes the other way) at HomeLowSpeed, kCmdAxMoveRel.
+            //  Done = READY on a fresh sample with the command position at the target (±2); then an arm Z goes to ZSafePos (phase 1)
+            //  as before, any other Z is homed. Door open -> stop, HomeFlag=2. Bounded move: a cancel without stop still ends 200 pulses on.
+            if (be.GoldenSafeDoorOpen(h.mi)) { Stop1203(be, h.axis, -1); be.GoldenSetHomeFlag(h.mi, 2); CancelHome(be, h, false, "Z back-off: safe door open -> stopped, HomeFlag=2"); continue; }
+            if (!h.zBackIssued) {
+                double card0 = 0;
+                if (!IsReadyState(st) || SampleStale(be, h.axis) || !be.Pci1203CmdPos(h.axis, card0)) {
+                    if (h.elapsedMs > kZSafeTimeoutMs) { be.GoldenSetHomeFlag(h.mi, 2); CancelHome(be, h, true, "Z back-off: never READY -> HomeFlag=2"); }
+                    continue;
+                }
+                const struct { Pci1203SpeedParam which; double v; } seq[2] = { { kSpeedInit, (double)h.g.homeLow }, { kSpeedRun, (double)h.g.homeLow } };
+                bool spdOk = true;
+                for (int k = 0; k < 2 && spdOk; ++k) {
+                    Pci1203Cmd sc; sc.kind = kCmdAxSetSpeed; sc.axis = h.axis; sc.speed = seq[k].which; sc.value = seq[k].v;
+                    const Pci1203CmdResult sr = be.Pci1203Execute(sc);
+                    if (CmdFailed(sr)) { spdOk = false; be.GoldenSetHomeFlag(h.mi, 2); CancelHome(be, h, false, "Z back-off: speed write failed -- " + CmdWhy(sr)); }
+                }
+                if (!spdOk) continue;
+                const double dist = (h.g.homeDirection ? 1.0 : -1.0) * (double)g_W906ZHomeBackoff;
+                Pci1203Cmd c; c.kind = kCmdAxMoveRel; c.axis = h.axis; c.value = dist;
+                const Pci1203CmdResult res = be.Pci1203Execute(c);
+                if (CmdFailed(res)) { be.GoldenSetHomeFlag(h.mi, 2); CancelHome(be, h, false, "Z back-off move failed: " + CmdWhy(res)); continue; }
+                NoteIssued(be, h.axis);
+                h.zBackTarget = card0 + dist; h.zBackIssued = true;
+                continue;
+            }
+            double card = 0;
+            if (IsReadyState(st) && !SampleStale(be, h.axis) && be.Pci1203CmdPos(h.axis, card) && card - h.zBackTarget <= 2.0 && h.zBackTarget - card <= 2.0) {
+                Pci1203Cmd sc; sc.kind = kCmdAxSetSpeed; sc.axis = h.axis; sc.speed = kSpeedRun; sc.value = (double)h.g.homeHigh;   // the home seed again (StartHome1203), so ZSafePos runs as before
