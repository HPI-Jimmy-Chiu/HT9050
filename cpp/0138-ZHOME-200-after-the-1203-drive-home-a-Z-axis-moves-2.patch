@@ -2333,6 +2336,11 @@ void TickHomes(IMotorAccessBackend& be, int ms)
                 //  —— 在 ProcessSingleMotorHome 的 case 500（arm Z 去 ZSafePos）之前，所以每一軸都設（旋轉站的背隙補償讀它，:2012-2045）
                 //AI(W906-MERGE-56bbf785) 20260926: machine's card-side block + LastHomePos above, then the laptop's line (both kept).
                 be.GoldenSetRotatorLastDirP(h.mi, true);
+                //AI(W906-ZHOME-200) 20261002: EastSun「Z軸歸原點 ... 往回 200 就好」-- a Z axis first moves g_W906ZHomeBackoff pulses (phase 2), then as before
+                if (g_W906ZHomeBackoff != 0 && !h.zBackDone && W906_IsZAxisAlias(h.motorId.c_str())) {
