+                be.GoldenSetHomeFlag(h.mi, 1); SingleHomeSucceeded();
+                CancelHome(be, h, false, "home done, Z back-off done -> HomeFlag=1");
+                continue;
+            }
+            if (h.elapsedMs > kZSafeTimeoutMs) { be.GoldenSetHomeFlag(h.mi, 2); CancelHome(be, h, true, "Z back-off timeout -> HomeFlag=2"); }
         } else {
             // NB2 R23 W4C-2：golden uhome.cpp:597-603 case 500 `if(MOT[Index].MotorMove(ZSafePos)) { HomeFlag=true; … }`，每拍重呼叫。
