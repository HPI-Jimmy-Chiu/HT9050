+static bool ReadFile(const std::string& p, std::string* out)
+{
+    std::ifstream f(p.c_str(), std::ios::binary);
+    if (!f) return false;
+    std::stringstream ss;
+    ss << f.rdbuf();
+    *out = ss.str();
