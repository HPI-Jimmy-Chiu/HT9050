+    bool gSafe = false, gAlarm = false;
+    for (size_t i = 0; i < globals.size(); ++i) { if (globals[i] == "SafePlcIOInstall.cpp") gSafe = true; if (globals[i] == "SecsAlarmForm.cpp") gAlarm = true; }
