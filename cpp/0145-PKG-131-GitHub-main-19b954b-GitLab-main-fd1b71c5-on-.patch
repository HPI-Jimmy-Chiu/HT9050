+static std::string Lower(std::string s) { for (size_t i = 0; i < s.size(); ++i) if (s[i] >= 'A' && s[i] <= 'Z') s[i] = (char)(s[i] - 'A' + 'a'); return s; }
+static std::string Slashes(std::string s) { for (size_t i = 0; i < s.size(); ++i) if (s[i] == '/') s[i] = '\\'; return s; }
