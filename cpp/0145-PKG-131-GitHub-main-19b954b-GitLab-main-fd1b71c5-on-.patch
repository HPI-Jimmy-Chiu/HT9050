+    bOK &= HANARMS_CmpEq("FT.SB_ARM", HANARMS_StripSpace(sv), bF, hb, asFail);
+    sv = HANARMSGetKV(asLine, "FT.SB_ARM_CNT", bF);
+    bOK &= HANARMS_CmpEq("FT.SB_ARM_CNT", HANARMS_StripSpace(sv), bF, hc, asFail);
