@@ -24,6 +24,9 @@
 #include "aHotPlateSubstrate.h"
 #include "Motor/mymotor.h"
 #include "database.h"         // W906_GpibModel (review M1: the run-time HT9050 test)
+#include "forms/fNote.h"      //AI(W906-ARMCELL2) 20261002: fNote->fShow / MyMessageBox->fShow (NB2 R165: HT160 IsFaultPopupShowing, EOF)
+#include "mymessbox_shim.h"
