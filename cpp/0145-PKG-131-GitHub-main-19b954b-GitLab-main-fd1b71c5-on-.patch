+            bOK = false;
+            if(asFail.Length()) asFail += " ; ";
+            asFail += "TEMP(S=" + sv + "/H=RoomTemp)";
+        }
+    }
+
+    sv = HANARMSGetKV(asLine, "PIN_CNT", bF);
+    bOK &= HANARMS_CmpNum("PIN_CNT", sv, bF, (double)DeviceForm_File.iPinCT, asFail);
