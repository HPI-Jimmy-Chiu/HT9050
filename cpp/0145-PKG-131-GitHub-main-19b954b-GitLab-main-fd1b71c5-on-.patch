+bool THanaRmsMembers::HANARMSCheckRecipe(AnsiString &asFail)                    // golden :3117-3134
+{
+    bool bRet;
+    if(sHANARMSJobInfoLine == "")
+    {
+        asFail = "RMS JOB_INFO not received";
+        bRet = false;
+    }
+    else
+    {
+        bRet = HANARMSCompare(sHANARMSJobInfoLine, asFail);
+    }
