@@ -257,8 +260,24 @@ bool ArmCellLiveInputs(ArmCellInputs& in, std::string& why)
     return true;
 }
 
+//AI(W906-ARMCELL2) 20261002: NB2 R165 (1) -- the live state half of HT160 uteach IsFaultPopupShowing (fNote / MyMessageBox
+//  visible -> StopAllAdvancedTests): golden's own show flags, read through W906_FormShowing like every fShow read of this tree.
+//  fNote->fShow is set for a blocking alarm while it waits (wb_serve W906ModalWaitScope); MyMessageBox->fShow for ShowMyMessage /
+//  YES_NO while they wait and for ShowUnloaderTrayMessage's box until it is answered (MbFormShow / MbFormClose). Not seen here: a
+//  kcode==0 notice still waiting for its acknowledgement (the port shows it without fNote -- ruling 20260923 "not blocking") -- the
+//  edge (W906_MotorAccessArmCellOnPopup) catches it when it is posted. Installed by both entries below (the catalog is built on
+//  every tick, so it is in place before the first job).
+bool ArmCellPopupUpLive(std::string& what)
+{
+    if (fNote != 0 && W906_FormShowing("fNote", fNote->fShow)) { what = "告警框（golden fNote）還開著"; return true; }
+    if (MyMessageBox != 0 && W906_FormShowing("MyMessageBox", MyMessageBox->fShow)) { what = "訊息框（golden MyMessageBox）還開著"; return true; }
+    what.clear();
+    return false;
+}
+
 bool ArmCellLiveCatalog(ArmCellCatalog& out, std::string& why)
 {
+    g_W906ArmCellPopupUp = &ArmCellPopupUpLive;                                //AI(W906-ARMCELL2) 20261002
     ArmCellInputs in;
     if (!ArmCellLiveInputs(in, why)) { out = ArmCellCatalog(); return false; }
     ArmCellBuildCatalog(in, out);
@@ -267,9 +286,20 @@ bool ArmCellLiveCatalog(ArmCellCatalog& out, std::string& why)
 
 bool ArmCellLivePlan(const ArmCellRequest& q, ArmCellPlan& out, std::string& why)
 {
+    g_W906ArmCellPopupUp = &ArmCellPopupUpLive;                                //AI(W906-ARMCELL2) 20261002
     ArmCellInputs in;
     if (!ArmCellLiveInputs(in, why)) { out = ArmCellPlan(); return false; }
     return ArmCellBuildPlan(in, q, out, why);
 }
 
 }  // namespace ht9045
+
+//AI(W906-ARMCELL2) 20261002: NB2 R165 (1) -- the edge, for wb_serve's popup hosts (tools/wb_serve.cpp, each on the line where it
+//  shows its box): W906_AlarmStopLikeGolden (ShowErrorMessage: the blocking alarm and the kcode==0 notice), ForwardShowMotorErrorMessage
+//  (ShowMotorErrorMessage's note), ForwardShowMyMessageBoxYesNo, W906MbShowMyMessage (ShowMyMessage), W906MbShowUnloaderTray
+//  (ShowUnloaderTrayMessage). kind = what kind of box (Chinese, for the page), what = its code / first line. A running Teach Arm
+//  Cell job is cancelled and stops its own axes (WebMotorAccess.cpp MotorAccessArmCellOnPopup); nothing else changes. true = it was.
+bool W906_MotorAccessArmCellOnPopup(const char* kind, const char* what)
+{
+    return ht9045::MotorAccessArmCellOnPopup(ht9045::MotorAccessLiveBackend(), kind ? kind : "", what ? what : "");
