+    for(int iRow=0; iRow<FTestSuck.iMaxRow; iRow++) for(int iCol=0; iCol<FTestSuck.iMaxCol; iCol++) { if(iCol>=TOTAL_VACUUM_UNIT || iRow>=2 || myPalArm2[iCol][iRow]==NULL || myPalArm1[iCol][iRow]==NULL) { AnsiString t; t.sprintf("golden VacuumUnit.cpp:170-186 ShowSuckMode: FTestSuck %dx%d but only %d index columns were created (iIndexColMax) -- golden would access-violate on myPalArm[%d][%d]; skipped", FTestSuck.iMaxRow, FTestSuck.iMaxCol, iIndexColMax, iCol, iRow); filerw::ELTodo(t.c_str()); continue; } if(iRow<FTestSuck.iShtRow && iCol<FTestSuck.iShtCol) { myPalArm2[iCol][iRow]->GroupBox->Visible=true; myPalArm1[iCol][iRow]->GroupBox->Visible=true; } else { myPalArm2[iCol][iRow]->GroupBox->Visible=false; myPalArm1[iCol][iRow]->GroupBox->Visible=false; }  { extern AnsiString W906_GpibModel; if(W906_GpibModel=="9050GPIB" || MachineTypeChoice==Type_HT9050) { extern bool FileRW_TestSuckEnabled(int, int, int); myPalArm1[iCol][iRow]->GroupBox->Visible=FileRW_TestSuckEnabled(0, iRow, iCol); myPalArm2[iCol][iRow]->GroupBox->Visible=FileRW_TestSuckEnabled(1, iRow, iCol); } }   /* AI(W906-VU9050) 20261007: EastSun 1007「有4組就顯示4組」-- HT9050: an Index panel shows when its nozzle is enabled in IO_Table (A2 VC0-3 = Aa/Ba/Ab/Bb), not by the recipe's site grid (Single Site = 1x1); every other machine: golden */ }   // golden VacuumUnit\VacuumUnit.cpp:170-186 取代：golden 原句＋陣列邊界／NULL 守衛（golden 會 access violation 的情形改成跳過＋todo，見本檔 _SUCK 註解）
