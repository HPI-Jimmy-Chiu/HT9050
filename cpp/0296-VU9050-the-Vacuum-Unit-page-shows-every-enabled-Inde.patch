diff --git a/FileRW/_KitSuck.cpp b/FileRW/_KitSuck.cpp
index cbf2d0e..8cc7f2d 100644
--- a/FileRW/_KitSuck.cpp
+++ b/FileRW/_KitSuck.cpp
@@ -251,3 +251,11 @@ int FileRW_InArmSuckShtRow()
 {
     return InArmSuck.iShtRow;
 }
+
+// AI(W906-VU9050) 20261007: EastSun 1007 「有4組就顯示4組」-- is FTestSuck (which 0) / BTestSuck (which 1) .Suck[row][col] enabled (IO_Table);
+//   FileRW/TestIF_File_VacuumUnit.gen.inc VU_ShowSuckMode uses it on HT9050. Out of range = false.
+bool FileRW_TestSuckEnabled(int which, int row, int col)
+{
+    if(row<0 || col<0 || row>=FTestSuck.iMaxRow || col>=FTestSuck.iMaxCol) return false;
+    return which == 0 ? FTestSuck.Suck[row][col].Enable : BTestSuck.Suck[row][col].Enable;
+}
