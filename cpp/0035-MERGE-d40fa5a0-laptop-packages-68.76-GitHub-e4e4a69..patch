+static std::string J(const std::string& s)
+{
+    std::string o = "\"";
+    for (size_t i = 0; i < s.size(); ++i)
+    {
+        const unsigned char c = (unsigned char)s[i];
+        if (c == '"') o += "\\\"";
+        else if (c == '\\') o += "\\\\";
+        else if (c < 0x20)
+        {
+            char b[8];
+            std::snprintf(b, sizeof(b), "\\u%04x", c);
+            o += b;
+        }
+        else o += (char)c;
+    }
+    return o + "\"";
+}
