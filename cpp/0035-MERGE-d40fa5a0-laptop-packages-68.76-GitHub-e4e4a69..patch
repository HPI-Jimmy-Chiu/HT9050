+        } else if (!f.cardUsable) {
+            it.state  = kBlocked;
+            it.reason = "1203 卡失聯：這次開機開過卡，現在讀不到" + Paren(f.cardWhy) + "——無法確認 1203 軸已停";
+        } else if (f.axes.empty()) {
+            it.state  = kAbsent;
+            it.reason = "1203 卡開著，但監看器沒有開成功任何軸：沒有 1203 軸要停";
+        } else {
+            std::string cmd;
+            bool cannot = true;                                                 // 停止命令到不了卡
