+        }
+
+        for (int i = 0; i < 8; i++)                                             // golden :1080  ChungHung 20141002 3->5 / Ifor 20170418 MRT Mode 5 -> 8
+        {
+            BinSelect_NET[i]    = BinSelect[i];                                 // golden :1082
+        }
