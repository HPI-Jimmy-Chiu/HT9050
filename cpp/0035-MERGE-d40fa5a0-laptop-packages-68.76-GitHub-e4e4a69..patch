+std::wstring TrayLayout(int x, int y)
+{
+    if (x <= 0 || y <= 0) return L"—";
+    if (x > 16) x = 16;
+    std::wstring out;
+    for (int r = 0; r < y; ++r) {
+        if (r) out += L" / ";
+        out.append((std::size_t)x, L'□');
+    }
+    return out;
