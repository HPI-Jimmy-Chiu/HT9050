+    const DWORD n = ::GetFullPathNameA(p.c_str(), sizeof(buf), buf, 0);
+    std::string s = (n > 0 && n < sizeof(buf)) ? std::string(buf, n) : p;
+    for (size_t i = 0; i < s.size(); ++i)
+    {
+        if (s[i] >= 'A' && s[i] <= 'Z') s[i] = (char)(s[i] - 'A' + 'a');
+        if (s[i] == '/') s[i] = '\\';
+    }
+    return s;
+}
