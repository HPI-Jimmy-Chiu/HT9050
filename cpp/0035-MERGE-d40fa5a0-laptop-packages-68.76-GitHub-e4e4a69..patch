+# =============================================================================
+import argparse
+import json
+import os
+import sys
+import time
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import formevent_probe as fp   # noqa: E402  Ws／check／err_code／FAILS
+
+check, err_code = fp.check, fp.err_code
+
+
+def ok_c(r):
