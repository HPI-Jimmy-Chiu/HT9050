+                it.state  = kWait;
+                it.reason = cmd + "；等監看器讀回停止之後的狀態";
+            } else if (nMov == 0 && nUnk == 0) {
+                it.state  = kOk;
+                it.reason = Fmt("%d 軸讀回都已停（READY／DISABLE／ERROR_STOP，命令速度 0）；", (int)f.axes.size()) + cmd;
+            } else if (nMov > 0 && cannot) {
