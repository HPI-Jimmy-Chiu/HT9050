+bool Q44CardUsable(ht9045::TPci1203Monitor* m)                                  // 同 Pci1203IoRoute.cpp CheckWrite_ 的「卡沒開」判斷
+{
+    return m != 0 && m->Open_() && !m->Disabled() && m->card().open;
+}
