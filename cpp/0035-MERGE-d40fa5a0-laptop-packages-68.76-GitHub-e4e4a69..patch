+bool IsAllEventLogPath(const std::string& path)
+{
+    // golden MyStringList MySaveToFile_1 writes the copy into "<HTPath>\AllEventLog" (V906 Public/MyStringList.cpp:586)
+    size_t b = 0;
+    while (b <= path.size())
+    {
