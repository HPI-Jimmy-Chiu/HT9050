+bool PageFormAnswer(const char* form)
+{
+    const int i = PageTableFind(form);
+    if (i >= 0) return RowAnswer((std::size_t)i);
+    SayUnknown(form, "PageFormAnswer");
+    return WebRules(form);
+}
