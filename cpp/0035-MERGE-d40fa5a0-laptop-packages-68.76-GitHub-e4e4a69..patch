+    b[15] = " 5.630";
+    b[16] = "1";
+    b[17] = "1";
+    b[18] = "O1-13";
+    b[19] = one;
+    b[20] = one;
+    b[21] = A8At(t.arm + 25);
+    b[22] = "-46288";
+    b[23] = "-72427";
+    b[24] = A8At(t.arm + 25);
+    b[25] = "na";
+    b[26] = "na";
+    b[27] = t.testTime;                              // eTestTime
+    b[29] = t.eot >= 0 ? A8Sot(t.eot) : "";          // eEOTTime
+    b[30] = "A";
+    b[31] = b[32] = b[33] = "A-1";
+    b[34] = "Aa";                                    // eOutArmShuttlePick (Greatek col 27)
+    b[35] = "1";
+    b[36] = "A";                                     // eInArmHotplatePick (Greatek col 13)
+    b[37] = "2x4";                                   // eTestMode (Greatek col 23; default col 37)
