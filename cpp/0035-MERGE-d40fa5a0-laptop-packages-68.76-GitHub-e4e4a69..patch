+        "D:\\HT9045_Log\\TestLog", "D:\\HT9045_Log\\TorqueLog", "D:\\HT9045_log\\HPCARD", "D:\\HT9045_log\\GroundManLog" };
+    const int kRealN = (int)(sizeof(kReal) / sizeof(kReal[0]));
