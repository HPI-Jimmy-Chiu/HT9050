+bool MotorViewOpen(bool show)
+{
+    if (g.hwnd) {
+        if (show) {
+            ::ShowWindow(g.hwnd, ::IsIconic(g.hwnd) ? SW_RESTORE : SW_SHOW);
+            ::SetForegroundWindow(g.hwnd);
+        }
