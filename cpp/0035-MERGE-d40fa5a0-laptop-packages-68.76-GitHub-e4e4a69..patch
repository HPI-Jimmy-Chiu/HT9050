+        if (cond) { std::printf("  PASS: %s\n", msg); ++g_pass; }                 \
+        else      { std::printf("  FAIL: %s  (line %d)\n", msg, __LINE__); ++g_fail; } \
+    } while (0)
+
+// ---- 假的 WebSocket 數、時鐘、host callback ------------------------------------
