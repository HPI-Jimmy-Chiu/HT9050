+              'C3 sbTrayAssign → todo main:AutoCleanStringGrid：%s' % dump(r))
+        time.sleep(a.gap)
+    else:
+        skip('C3', 'sbTrayAssign（CosFunction.bAutoCleanAutoSelIndexArm）')
+    if a.allow_write:
