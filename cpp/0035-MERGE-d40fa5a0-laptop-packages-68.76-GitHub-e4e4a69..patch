+std::string FmtDT(double t)
+{
+    int y, m, d, h, n, s, ms;
+    DecodeDateTime(t, &y, &m, &d, &h, &n, &s, &ms);
+    char b[40];
+    std::snprintf(b, sizeof(b), "%04d/%02d/%02d %02d:%02d:%02d", y, m, d, h, n, s);
+    return b;
+}
