+    const std::string f = form ? form : "";
+    if (said.count(f)) return;
+    said.insert(f);
+    std::printf("[PAGETAB] unknown form \"%s\" (%s) -- not in the 90-row table; answered by the web rules 3-7\n",
+                f.c_str(), where);
+    std::fflush(stdout);
+}
