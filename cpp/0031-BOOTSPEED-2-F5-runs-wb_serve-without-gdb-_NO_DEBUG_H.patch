From 5761489af1aaa5ae71815241a04cd8f2fbb4e882 Mon Sep 17 00:00:00 2001
From: "HT9045 Machine (V906)" <Claude_RDBC_02@honprec.com>
Date: Tue, 29 Sep 2026 20:55:06 +0800
Subject: [PATCH] BOOTSPEED-2: F5 runs wb_serve without gdb; _NO_DEBUG_HEAP=1
 for the gdb entries; builds at -j 6
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

EastSun 20260929: "都先照你說的改 目前我不用除錯".
- launch.json: new "IOWEB(這台): wb_serve 出貨組態（不接除錯器，較快）" = the ship entry with "noDebug": true
  (cpptools 1.34 RunWithoutDebuggingAdapter: the exe runs in a VS Code terminal, no gdb, no debug heap). The ★★
  compound (F5) now names it; the gdb entry stays in the dropdown (order 3) for debugging.
  Consequences written at the entry: output in the TERMINAL panel, STOP does not end the program (HMI Exit / Ctrl+C).
- Both gdb IOWEB entries: _NO_DEBUG_HEAP=1 (gdb's debug heap measured 2.5-4.6x slower on small alloc/free).
- tasks.json: the two IOWEB builds -j 6 (was NUMBER_OF_PROCESSORS = 28 on 7.7 GB RAM); new task
  "IOWEB(這台): 檢查舊程式還在不在" (tools/check_wb_serve_not_running.ps1, read-only, exit 1 + PID while a wb_serve.exe
  runs) first in the no-debugger F5's preLaunchTask sequence.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 .vscode/launch.json                  | 44 ++++++++++++++++++++++++++--
 .vscode/tasks.json                   | 22 ++++++++++++--
 tools/check_wb_serve_not_running.ps1 | 18 ++++++++++++
 3 files changed, 79 insertions(+), 5 deletions(-)
 create mode 100644 tools/check_wb_serve_not_running.ps1

diff --git a/.vscode/launch.json b/.vscode/launch.json
index 5a38950..ea925f4 100644
--- a/.vscode/launch.json
+++ b/.vscode/launch.json
@@ -118,7 +118,7 @@
         { "name": "W906_BINCOUNT_PATH",    "value": "${workspaceFolder}\\..\\runcfg\\logs\\BinCount.ini" },
         { "name": "W906_PWBOOK_PATH",      "value": "${workspaceFolder}\\..\\runcfg\\logs\\pwbook.ini" },
         { "name": "W906_TEACH_INI_PATH",   "value": "${workspaceFolder}\\..\\runcfg\\system\\teach.ini" },
-        { "name": "W906_IOTIMING_LOG",     "value": "${workspaceFolder}\\..\\runcfg\\logs\\io_click_timing.csv" }, { "name": "W906_OPLOG_DIR", "value": "${workspaceFolder}\\..\\runcfg\\logs" }, { "name": "W906_HMI_URL", "value": "http://127.0.0.1:8055/background.html?mode=debug&machine=HT9050" }
+        { "name": "W906_IOTIMING_LOG",     "value": "${workspaceFolder}\\..\\runcfg\\logs\\io_click_timing.csv" }, { "name": "W906_OPLOG_DIR", "value": "${workspaceFolder}\\..\\runcfg\\logs" }, { "name": "W906_HMI_URL", "value": "http://127.0.0.1:8055/background.html?mode=debug&machine=HT9050" }, { "name": "_NO_DEBUG_HEAP", "value": "1" }   // AI(W906-BOOTSPEED-2) 20260929: EastSun「都先照你說的改」-- under gdb Windows turns on its debug heap (small alloc/free 2.5-4.6x slower, measured); off like the machine runs without a debugger
       ],
       "MIMode": "gdb",
       "miDebuggerPath": "${env:LOCALAPPDATA}\\Programs\\ht9045-nonoracle-toolchain\\mingw32\\bin\\gdb.exe",
@@ -130,6 +130,44 @@
       // AI(W906-BOOTWAIT) 20260929: serverReadyAction removed -- the preLaunchTask opens web/boot_wait.html at once, and that page
       //   switches itself to http://127.0.0.1:8055/background.html?mode=debug&machine=HT9050 when wb_serve answers (a second tab
       //   from serverReadyAction would be a duplicate). It used to open only after the ~1 min boot printed the URL.
+      "presentation": { "group": "0_f5", "order": 3 }   // AI(W906-BOOTSPEED-2) 20260929: was 2 -- the no-debugger entry below is F5 now
+    },
+    {
+      // AI(W906-BOOTSPEED-2) 20260929: EastSun「都先照你說的改 目前我不用除錯」-- the SAME program, arguments and environment as the
+      //   entry above, but "noDebug": true: cpptools 1.34 (RunWithoutDebuggingAdapter) starts wb_serve.exe straight in a VS Code
+      //   terminal, no gdb (no debug heap, no debug events). What that changes for the operator:
+      //     * the output is in the TERMINAL panel (tab named after the exe), not in the Debug Console;
+      //     * the red STOP button does NOT end the program -- close it the usual way (the HMI's Exit, or Ctrl+C in that terminal);
+      //     * breakpoints / F6 pause do nothing -- pick "IOWEB(這台): wb_serve 出貨組態（1203 唯讀）" (gdb) when debugging is needed.
+      //   The preLaunchTask first refuses to start while an old wb_serve still runs (tools/check_wb_serve_not_running.ps1):
+      //   without a debugger nothing ends it, and a second one could neither link its exe nor bind port 8055.
+      "name": "IOWEB(這台): wb_serve 出貨組態（不接除錯器，較快）",
+      "type": "cppdbg",
+      "request": "launch",
+      "noDebug": true,
+      "ignoreRunWithoutDebuggingWarnings": true,
+      "preLaunchTask": "IOWEB(這台): 檢查舊程式 + 等待畫面 + build wb_serve（出貨組態）",
+      "program": "${workspaceFolder}/build_integ_ship_x86/wb_serve.exe",
+      "args": ["--root", "${workspaceFolder}\\..\\web", "--port", "8055"],
+      "cwd": "${workspaceFolder}",
+      "environment": [
+        { "name": "W906_GENERAL_INI_PATH", "value": "D:\\HT9045\\system\\Gerneral.ini" },
+        { "name": "W906_SETUPINF_PATH",    "value": "${workspaceFolder}\\..\\runcfg\\SetUp.inf" },
+        { "name": "W906_IOTABLE_PATH",     "value": "D:\\HT9045\\system\\IO_Table.csv" },
+        { "name": "W906_MOTTABLE_PATH",    "value": "D:\\HT9045\\system\\Mot_Table.csv" },
+        { "name": "W906_AUTH_PATH",        "value": "${workspaceFolder}\\..\\runcfg\\config\\" },
+        { "name": "W906_E84DATA_ROOT",     "value": "${workspaceFolder}\\..\\runcfg\\logs\\E84DataTxt" },
+        { "name": "W906_TCPDATA_ROOT",     "value": "${workspaceFolder}\\..\\runcfg\\logs\\TCP_Data" },
+        { "name": "W906_SUMMARYLOT_ROOT",  "value": "${workspaceFolder}\\..\\runcfg\\logs\\Summary_Lot" },
+        { "name": "W906_EVENTLOG_ROOT",    "value": "${workspaceFolder}\\..\\runcfg\\logs\\EventLogTxt" },
+        { "name": "W906_BINCOUNT_PATH",    "value": "${workspaceFolder}\\..\\runcfg\\logs\\BinCount.ini" },
+        { "name": "W906_PWBOOK_PATH",      "value": "${workspaceFolder}\\..\\runcfg\\logs\\pwbook.ini" },
+        { "name": "W906_TEACH_INI_PATH",   "value": "${workspaceFolder}\\..\\runcfg\\system\\teach.ini" },
+        { "name": "W906_IOTIMING_LOG",     "value": "${workspaceFolder}\\..\\runcfg\\logs\\io_click_timing.csv" }, { "name": "W906_OPLOG_DIR", "value": "${workspaceFolder}\\..\\runcfg\\logs" }, { "name": "W906_HMI_URL", "value": "http://127.0.0.1:8055/background.html?mode=debug&machine=HT9050" }
+      ],
+      "MIMode": "gdb",
+      "miDebuggerPath": "${env:LOCALAPPDATA}\\Programs\\ht9045-nonoracle-toolchain\\mingw32\\bin\\gdb.exe",
+      "externalConsole": false,
       "presentation": { "group": "0_f5", "order": 2 }
     },
     {
@@ -156,7 +194,7 @@
         { "name": "W906_BINCOUNT_PATH",    "value": "${workspaceFolder}\\..\\runcfg\\logs\\BinCount.ini" },
         { "name": "W906_PWBOOK_PATH",      "value": "${workspaceFolder}\\..\\runcfg\\logs\\pwbook.ini" },
         { "name": "W906_TEACH_INI_PATH",   "value": "${workspaceFolder}\\..\\runcfg\\system\\teach.ini" },
-        { "name": "W906_IOTIMING_LOG",     "value": "${workspaceFolder}\\..\\runcfg\\logs\\io_click_timing.csv" }, { "name": "W906_OPLOG_DIR", "value": "${workspaceFolder}\\..\\runcfg\\logs" }, { "name": "W906_HMI_URL", "value": "http://127.0.0.1:8055/background.html?mode=debug&machine=HT9050" }
+        { "name": "W906_IOTIMING_LOG",     "value": "${workspaceFolder}\\..\\runcfg\\logs\\io_click_timing.csv" }, { "name": "W906_OPLOG_DIR", "value": "${workspaceFolder}\\..\\runcfg\\logs" }, { "name": "W906_HMI_URL", "value": "http://127.0.0.1:8055/background.html?mode=debug&machine=HT9050" }, { "name": "_NO_DEBUG_HEAP", "value": "1" }   // AI(W906-BOOTSPEED-2) 20260929: see the ship entry
       ],
       "MIMode": "gdb",
       "miDebuggerPath": "${env:LOCALAPPDATA}\\Programs\\ht9045-nonoracle-toolchain\\mingw32\\bin\\gdb.exe",
@@ -439,7 +477,7 @@
       // (the member has its own -- a second one here would build twice, the same
       // defect AI(W906-DOUBLEBUILD) records below).
       "name": "★★ IOWEB(這台): build + IO web（1203 唯讀，port 8055）",
-      "configurations": [ "IOWEB(這台): wb_serve 出貨組態（1203 唯讀）" ],
+      "configurations": [ "IOWEB(這台): wb_serve 出貨組態（不接除錯器，較快）" ],   // AI(W906-BOOTSPEED-2) 20260929: EastSun「目前我不用除錯」-- was the gdb entry (still in the dropdown for debugging)
