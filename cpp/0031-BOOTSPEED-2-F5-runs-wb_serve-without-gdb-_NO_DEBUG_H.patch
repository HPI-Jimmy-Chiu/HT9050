+++ b/.vscode/tasks.json
@@ -67,7 +67,7 @@
       "detail": "cmake --build build_integ_ship_x86 --target wb_serve  (-DW906_NO_SOFT_SIMULTE=ON, C++14, -static)",
       "type": "process",
       "command": "cmake",
-      "args": ["--build", "${workspaceFolder}/build_integ_ship_x86", "--target", "wb_serve", "-j", "${env:NUMBER_OF_PROCESSORS}"],
+      "args": ["--build", "${workspaceFolder}/build_integ_ship_x86", "--target", "wb_serve", "-j", "6"],   // AI(W906-BOOTSPEED-2) 20260929: was -j NUMBER_OF_PROCESSORS (28): 28 compilers on 7.7 GB RAM page the whole PC, the boot after it too
       "options": {
         "cwd": "${workspaceFolder}",
         "env": { "PATH": "${env:LOCALAPPDATA}\\Programs\\ht9045-nonoracle-toolchain\\mingw32\\bin;${env:PATH}" }
@@ -90,7 +90,7 @@
       "detail": "cmake --build build_integ_dbg_x86 --target wb_serve  (Debug = -g, shipping config)",
       "type": "process",
       "command": "cmake",
-      "args": ["--build", "${workspaceFolder}/build_integ_dbg_x86", "--target", "wb_serve", "-j", "${env:NUMBER_OF_PROCESSORS}"],
+      "args": ["--build", "${workspaceFolder}/build_integ_dbg_x86", "--target", "wb_serve", "-j", "6"],   // AI(W906-BOOTSPEED-2) 20260929: see above
       "options": {
         "cwd": "${workspaceFolder}",
         "env": { "PATH": "${env:LOCALAPPDATA}\\Programs\\ht9045-nonoracle-toolchain\\mingw32\\bin;${env:PATH}" }
@@ -126,6 +126,24 @@
       "dependsOn": ["IOWEB(這台): 開啟等待畫面", "IOWEB(這台): build wb_serve（出貨組態, WinLibs 32-bit）"],
       "problemMatcher": []
     },
+    {
+      // AI(W906-BOOTSPEED-2) 20260929: the no-debugger F5 ("目前我不用除錯") has no STOP that ends the program, so it first refuses
+      //   while an old wb_serve.exe still runs (its exe could not be linked and port 8055 is taken). Exit 1 + the PID and how to close it.
+      "label": "IOWEB(這台): 檢查舊程式還在不在",
+      "detail": "fails when a wb_serve.exe is still running (close it first: the HMI's Exit, or Ctrl+C in its terminal)",
+      "type": "process",
+      "command": "powershell",
+      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\tools\\check_wb_serve_not_running.ps1"],
+      "presentation": { "reveal": "always", "panel": "shared" },
+      "problemMatcher": []
+    },
+    {
+      // AI(W906-BOOTSPEED-2) 20260929: the no-debugger ship F5's preLaunchTask: the check, the wait page, the build (sequence).
+      "label": "IOWEB(這台): 檢查舊程式 + 等待畫面 + build wb_serve（出貨組態）",
+      "dependsOrder": "sequence",
+      "dependsOn": ["IOWEB(這台): 檢查舊程式還在不在", "IOWEB(這台): 開啟等待畫面", "IOWEB(這台): build wb_serve（出貨組態, WinLibs 32-bit）"],
+      "problemMatcher": []
+    },
     {
       // AI(W906-BOOTWAIT) 20260929: the same for the -g F5.
       "label": "IOWEB(這台): 等待畫面 + build wb_serve DEBUG（-g）",
diff --git a/tools/check_wb_serve_not_running.ps1 b/tools/check_wb_serve_not_running.ps1
new file mode 100644
index 0000000..6b82ff0
--- /dev/null
+++ b/tools/check_wb_serve_not_running.ps1
@@ -0,0 +1,18 @@
+﻿# AI(W906-BOOTSPEED-2) 20260929: preLaunchTask step of the no-debugger F5 ("IOWEB(這台): wb_serve 出貨組態（不接除錯器，較快）").
+# Without gdb the red STOP button does not end wb_serve, so pressing F5 again while it runs would fail late and unclearly
+# (the build cannot replace the running exe, the new one cannot bind port 8055). This step fails early and says so.
+# Read-only: it lists processes and never stops one.
+$ErrorActionPreference = 'Stop'
+$procs = @(Get-Process -Name 'wb_serve' -ErrorAction SilentlyContinue)
+if ($procs.Count -eq 0) {
+    Write-Output 'OK: no wb_serve.exe running'
+    exit 0
+}
+foreach ($p in $procs) {
+    $path = ''
+    try { $path = $p.Path } catch { $path = '' }
+    Write-Output ("wb_serve.exe is still running: PID {0}, started {1}, {2}" -f $p.Id, $p.StartTime, $path)
+}
+Write-Output 'Close it first: the HMI Exit button, or Ctrl+C in its terminal tab (named after the exe). Then press F5 again.'
+Write-Output '舊的 wb_serve 還在跑：請先關掉（HMI 的 Exit，或在它的終端機分頁按 Ctrl+C），再按 F5。'
+exit 1
-- 
