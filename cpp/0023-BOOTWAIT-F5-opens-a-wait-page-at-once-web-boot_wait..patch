From 68f0a210cc8ed7013b5177efccc1c26fb10fb53c Mon Sep 17 00:00:00 2001
From: "HT9045 Machine (V906)" <Claude_RDBC_02@honprec.com>
Date: Tue, 29 Sep 2026 18:16:59 +0800
Subject: [PATCH] BOOTWAIT: F5 opens a wait page at once (web/boot_wait.html)
 that switches to the HMI when wb_serve answers
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

EastSun 20260929: "軟體開起來時 請你先把操作頁面HTML 開起來 不然我按F5後 又等你非常久 才會把畫面開起來 我根本不知道軟體有沒有執行".
The browser used to open only via serverReadyAction, i.e. after the ~1 min boot printed the URL.
- .vscode/tasks.json: "IOWEB(這台): 開啟等待畫面" (Start-Process ../web/boot_wait.html, default browser) and two sequence tasks
  "IOWEB(這台): 等待畫面 + build ..." (wait page first, then the existing ship / -g build).
- .vscode/launch.json: both IOWEB configurations use them as preLaunchTask; their serverReadyAction is removed (the wait page
  redirects itself; a second tab would be a duplicate).
The page (web commit) polls http://127.0.0.1:8055/ every second (fetch no-cors + an existing image), shows the elapsed time,
switches to background.html?mode=debug&machine=HT9050 on the first answer, and warns instead when something already answers
at open (an old wb_serve still holding the port). Tested in headless Edge over CDP with a throw-away server on 18055: server up
after 5 s -> switched within 1 s; server already up -> warning. JSONC of both files parsed; every referenced task exists.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 .vscode/launch.json | 20 ++++++++------------
 .vscode/tasks.json  | 28 ++++++++++++++++++++++++++++
 2 files changed, 36 insertions(+), 12 deletions(-)

diff --git a/.vscode/launch.json b/.vscode/launch.json
index c4a17a8..b9e83e1 100644
--- a/.vscode/launch.json
+++ b/.vscode/launch.json
@@ -101,7 +101,7 @@
       "name": "IOWEB(這台): wb_serve 出貨組態（1203 唯讀）",
       "type": "cppdbg",
       "request": "launch",
-      "preLaunchTask": "IOWEB(這台): build wb_serve（出貨組態, WinLibs 32-bit）",
+      "preLaunchTask": "IOWEB(這台): 等待畫面 + build wb_serve（出貨組態）",   // AI(W906-BOOTWAIT) 20260929: wait page first (tasks.json), then the build
       "program": "${workspaceFolder}/build_integ_ship_x86/wb_serve.exe",
       "args": ["--root", "${workspaceFolder}\\..\\web", "--port", "8055"],
       "cwd": "${workspaceFolder}",
@@ -127,11 +127,9 @@
         { "description": "Pretty-print STL containers", "text": "-enable-pretty-printing", "ignoreFailures": true },
         { "description": "Load HT9045 pretty-printers (AnsiString / TStringList)", "text": "source ${workspaceFolder}/.vscode/ht9045_printers.py", "ignoreFailures": true }
       ],
-      "serverReadyAction": {
-        "pattern": "http://127\\.0\\.0\\.1:([0-9]+)/",
-        "uriFormat": "http://127.0.0.1:%s/background.html?mode=debug&machine=HT9050",
-        "action": "openExternally"
-      },
+      // AI(W906-BOOTWAIT) 20260929: serverReadyAction removed -- the preLaunchTask opens web/boot_wait.html at once, and that page
+      //   switches itself to http://127.0.0.1:8055/background.html?mode=debug&machine=HT9050 when wb_serve answers (a second tab
+      //   from serverReadyAction would be a duplicate). It used to open only after the ~1 min boot printed the URL.
       "presentation": { "group": "0_f5", "order": 2 }
     },
     {
@@ -141,7 +139,7 @@
       "name": "IOWEB(這台): wb_serve DEBUG 可下中斷點（1203 唯讀）",
       "type": "cppdbg",
       "request": "launch",
-      "preLaunchTask": "IOWEB(這台): build wb_serve DEBUG（-g, 出貨組態）",
+      "preLaunchTask": "IOWEB(這台): 等待畫面 + build wb_serve DEBUG（-g）",   // AI(W906-BOOTWAIT) 20260929
       "program": "${workspaceFolder}/build_integ_dbg_x86/wb_serve.exe",
       "args": ["--root", "${workspaceFolder}\\..\\web", "--port", "8055"],
       "cwd": "${workspaceFolder}",
@@ -167,11 +165,9 @@
         { "description": "Pretty-print STL containers", "text": "-enable-pretty-printing", "ignoreFailures": true },
         { "description": "Load HT9045 pretty-printers (AnsiString / TStringList)", "text": "source ${workspaceFolder}/.vscode/ht9045_printers.py", "ignoreFailures": true }
       ],
-      "serverReadyAction": {
-        "pattern": "http://127\\.0\\.0\\.1:([0-9]+)/",
-        "uriFormat": "http://127.0.0.1:%s/background.html?mode=debug&machine=HT9050",
-        "action": "openExternally"
-      },
+      // AI(W906-BOOTWAIT) 20260929: serverReadyAction removed -- the preLaunchTask opens web/boot_wait.html at once, and that page
+      //   switches itself to http://127.0.0.1:8055/background.html?mode=debug&machine=HT9050 when wb_serve answers (a second tab
+      //   from serverReadyAction would be a duplicate). It used to open only after the ~1 min boot printed the URL.
       "presentation": { "group": "0_f5", "order": 3 }
     },
     {
diff --git a/.vscode/tasks.json b/.vscode/tasks.json
index b78d5f9..9f77437 100644
--- a/.vscode/tasks.json
+++ b/.vscode/tasks.json
@@ -105,6 +105,34 @@
         }
       }
     },
+    {
+      // AI(W906-BOOTWAIT) 20260929: EastSun「軟體開起來時 請你先把操作頁面HTML 開起來 不然我按F5後 又等你非常久 才會把畫面開起來
+      // 我根本不知道軟體有沒有執行」。F5 的第一步：用預設瀏覽器開 ../web/boot_wait.html（file://，還不需要伺服器）。那一頁每秒問
+      // http://127.0.0.1:8055/，一回應就切到 background.html?mode=debug&machine=HT9050；開啟時就已經有東西在回應 = 舊的 wb_serve
+      // 沒關，會警告不切。所以兩個 IOWEB 設定的 serverReadyAction 拿掉了（否則開兩個分頁）。實測（headless Edge + CDP）：
+      // 伺服器 5 秒後才起來 → 1 秒內切到目標頁；一開就有回應 → 顯示警告。
+      "label": "IOWEB(這台): 開啟等待畫面",
+      "detail": "opens ../web/boot_wait.html in the default browser (it switches to the HMI when wb_serve answers on 8055)",
+      "type": "process",
+      "command": "powershell",
+      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", "Start-Process -FilePath (Join-Path '${workspaceFolder}' '..\\web\\boot_wait.html')"],
+      "presentation": { "reveal": "silent", "panel": "shared" },
+      "problemMatcher": []
+    },
+    {
+      // AI(W906-BOOTWAIT) 20260929: the ship F5's preLaunchTask -- wait page FIRST, then the build (sequence).
+      "label": "IOWEB(這台): 等待畫面 + build wb_serve（出貨組態）",
+      "dependsOrder": "sequence",
+      "dependsOn": ["IOWEB(這台): 開啟等待畫面", "IOWEB(這台): build wb_serve（出貨組態, WinLibs 32-bit）"],
+      "problemMatcher": []
+    },
+    {
+      // AI(W906-BOOTWAIT) 20260929: the same for the -g F5.
+      "label": "IOWEB(這台): 等待畫面 + build wb_serve DEBUG（-g）",
+      "dependsOrder": "sequence",
+      "dependsOn": ["IOWEB(這台): 開啟等待畫面", "IOWEB(這台): build wb_serve DEBUG（-g, 出貨組態）"],
+      "problemMatcher": []
+    },
     {
       // AI(W906-ZEROARG) 20260918: the F5 build. Only wb_serve.
       //
-- 
2.55.0.windows.5

