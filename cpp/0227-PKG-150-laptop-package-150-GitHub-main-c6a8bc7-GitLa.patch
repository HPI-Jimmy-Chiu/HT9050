+    out.pollCount = c.pollCount;
+    out.pollErrors = c.pollErrors;
+    out.pollMs = c.pollMs;
+    out.axesOpened = c.axesOpened;
+    out.lastError = c.lastError;
+    out.lastErrorText = c.lastErrorText;
+    out.idConflict = c.idConflict;
