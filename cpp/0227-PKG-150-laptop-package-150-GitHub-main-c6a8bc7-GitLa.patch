+bool CrlfOnly(const std::string& s)
+{
+    for (std::size_t i = 0; i < s.size(); ++i) {
+        if (s[i] == '\n' && (i == 0 || s[i - 1] != '\r')) return false;
+        if (s[i] == '\r' && (i + 1 >= s.size() || s[i + 1] != '\n')) return false;
+    }
+    return !s.empty() && s.size() >= 2 && s.compare(s.size() - 2, 2, "\r\n") == 0;
+}
