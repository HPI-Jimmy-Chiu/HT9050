+std::vector<std::string> CsvSplit(const std::string& line)
+{
+    std::vector<std::string> f;
+    std::string cur;
+    bool q = false;
+    for (std::size_t i = 0; i < line.size(); ++i) {
+        const char ch = line[i];
+        if (q) {
+            if (ch == '"') {
+                if (i + 1 < line.size() && line[i + 1] == '"') { cur += '"'; ++i; }
+                else q = false;
+            } else {
+                cur += ch;
+            }
+        } else if (ch == '"') {
+            q = true;
+        } else if (ch == ',') {
+            f.push_back(cur);
+            cur.clear();
+        } else {
+            cur += ch;
+        }
+    }
+    f.push_back(cur);
+    return f;
+}
