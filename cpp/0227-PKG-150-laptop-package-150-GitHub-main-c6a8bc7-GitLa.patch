+int FindLine(const std::vector<std::string>& ls, const char* a, const char* b)
+{
+    for (std::size_t i = 0; i < ls.size(); ++i)
+        if (Contains(ls[i], a) && (b == 0 || Contains(ls[i], b))) return (int)i + 1;
+    return 0;
+}
