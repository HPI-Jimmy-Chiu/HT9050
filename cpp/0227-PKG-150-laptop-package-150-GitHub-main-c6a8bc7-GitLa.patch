+//AI(W906-DROPCYL) 20261005: NB2-1 R229 (laptop W-64; Steven W-56; St01 docs/handoff/ST01_W_ANSWERS_20261004.md W-56). HT9050's In / Out
+//  Arm anti-drop rotary cylinders (C_InPnPDrop1-4 / C_OutPnPDrop1-4, SMC CRJB1-180; Push = On = closed, Pop = Off = open) follow the
+//  nozzle's has-IC state -- Steven: "有ic狀態下要夾起來（關, push） 無ic狀態下要開(pop)". Not golden (golden and 910 have no flow for
+//  them). Each arm behind its own Gerneral.ini [System] key, read once (at boot, from InitCylinder), never written: IN_ARM_DROP_CYL /
+//  OUT_ARM_DROP_CYL, 1 = on; default 0 = every function below answers true at once and touches no IO (today's behaviour).
+//  * W906_DropCylNames (cinitial.cpp InitCylinder, right after InitialCylinderName): gives an ON arm's four cylinders their IO-table
+//    names so InitCylinder binds them (F9050-BD names them only for Type_HT9050, and 9050GPIB decodes as Type_HT9046_LS).
+//    C_OutArmSmallY is never named here (purpose unknown; its live-table sensors share ports with C_InPnPDrop1, St01 W-56).
+//  * W906_DropCylOpen(arm) -- first statement of InArmZMoveDown / OutArmZMoveDown (Motor/mymotor.cpp) and of the two In Arm Z-downs
+//    that do not go through InArmZMoveDown (MoveInArmZToLoaderPick, MoveInArmZToHotPlatePick): false until every bound cylinder of
+//    that arm is open (output off + _Off sensor; Pop() drives it, golden's own alarm on its timeout). St01: "四顆任一顆 _Off 沒到位不准 Z
+//    下降". A cylinder already open is not driven again (no extra delay per Z-down).
+//  * W906_DropCylClose(arm) -- after a pick with Z back at the safe height: In Arm loader pick case 2100 (ainarm9045.cpp, after case
+//    2000's Z-safe + fall-down check), hot-plate pick case 340 (ainarm_SearchPickPlate.cpp), Out Arm case 3010 after its HasIC check
+//    (aoutarm9045_All_1Picker.cpp, after case 3000's Z-safe). The arm holds an IC -> false until every bound cylinder is closed (Push(),
+//    _On sensor); no IC -> true (they stay open). St01: "Z 低於安全高度時不准 Push()" -- only those three sites call it.
+//  * HOME: the eight are in CynNeedHome (cmydef.cpp), reset to Pop (open) like any golden cylinder; unnamed (switch off) = Enable=false
+//    = skipped there. A switch ON with a cylinder the IO table does not have: that cylinder is skipped (Enable=false), logged once.
+//  ctest DropCyl (tests/test_drop_cyl.cpp).
+#include "mycylin.h"                // Cylinder[] (golden), C_InPnPDrop1.. via cmydef.h
+static int s_W906DropCylSw[2] = { -1, -1 };                                      // -1 = not read yet; 0 / 1
+static bool s_W906DropCylLogged[2] = { false, false };
+static bool W906_DropCylSwitch(int arm)
+{
+    if(arm < 0 || arm > 1) return false;
+    if(s_W906DropCylSw[0] < 0 || s_W906DropCylSw[1] < 0)
+    {
+        TIniFile ini(asGeneralPath);
+        s_W906DropCylSw[0] = (ini.ReadInteger("System", "IN_ARM_DROP_CYL",  0) == 1) ? 1 : 0;
+        s_W906DropCylSw[1] = (ini.ReadInteger("System", "OUT_ARM_DROP_CYL", 0) == 1) ? 1 : 0;
+    }
+    return s_W906DropCylSw[arm] == 1;
+}
+static int W906_DropCylIndex(int arm, int k)                                    // k = 0..3
+{
+    if(arm == 0) return k == 0 ? C_InPnPDrop1  : k == 1 ? C_InPnPDrop2  : k == 2 ? C_InPnPDrop3  : C_InPnPDrop4;
+    return              k == 0 ? C_OutPnPDrop1 : k == 1 ? C_OutPnPDrop2 : k == 2 ? C_OutPnPDrop3 : C_OutPnPDrop4;
+}
+static void W906_DropCylLogSkipped(int arm)
+{
+    if(s_W906DropCylLogged[arm]) return;
+    s_W906DropCylLogged[arm] = true;
+    for(int k = 0; k < 4; ++k)
+    {
+        const int c = W906_DropCylIndex(arm, k);
+        if(!Cylinder[c].Enable)
+            std::printf("[dropcyl] %s Arm: %s is not bound (no IO-table row or no output) -- skipped\n",
+                        arm == 0 ? "In" : "Out", Cylinder[c].CylinderName.c_str());
+    }
+}
+void W906_DropCylReread()                                                        // ctest only: forget the switches and the log
+{
+    s_W906DropCylSw[0] = s_W906DropCylSw[1] = -1;
+    s_W906DropCylLogged[0] = s_W906DropCylLogged[1] = false;
+}
+void W906_DropCylNames()
+{
+    static const char* const inNames[4]  = { "C_InPnPDrop1",  "C_InPnPDrop2",  "C_InPnPDrop3",  "C_InPnPDrop4"  };
+    static const char* const outNames[4] = { "C_OutPnPDrop1", "C_OutPnPDrop2", "C_OutPnPDrop3", "C_OutPnPDrop4" };
+    for(int arm = 0; arm < 2; ++arm)
+    {
+        if(!W906_DropCylSwitch(arm)) continue;
+        for(int k = 0; k < 4; ++k)
+        {
+            const int c = W906_DropCylIndex(arm, k);
+            if(Cylinder[c].CylinderName == "")
+                Cylinder[c].CylinderName = arm == 0 ? inNames[k] : outNames[k];
+        }
+        std::printf("[dropcyl] %s Arm anti-drop cylinders ON (Gerneral.ini [System] %s_ARM_DROP_CYL=1)\n",
+                    arm == 0 ? "In" : "Out", arm == 0 ? "IN" : "OUT");
+    }
+}
+bool W906_DropCylOpen(int arm)
+{
+    if(!W906_DropCylSwitch(arm)) return true;
+    W906_DropCylLogSkipped(arm);
+    bool all = true;
+    for(int k = 0; k < 4; ++k)
+    {
+        TMyCylinder& c = Cylinder[W906_DropCylIndex(arm, k)];
+        if(!c.Enable) continue;
+        if(!c.GetOutBit() && (!c.OffSenEnable || c.OffStatus())) continue;       // already open
+        if(!c.Pop()) all = false;
+    }
+    return all;
+}
+bool W906_DropCylClose(int arm)
+{
+    if(!W906_DropCylSwitch(arm)) return true;
+    TMyKitSuck& kit = arm == 0 ? InArmSuck : OutArmSuck;
+    if(!kit.HasIC()) return true;                                                // no IC = open (Steven); nothing to close
+    W906_DropCylLogSkipped(arm);
+    bool all = true;
+    for(int k = 0; k < 4; ++k)
+    {
+        TMyCylinder& c = Cylinder[W906_DropCylIndex(arm, k)];
+        if(!c.Enable) continue;
+        if(c.GetOutBit() && (!c.OnSenEnable || c.OnStatus())) continue;          // already closed
+        if(!c.Push()) all = false;
+    }
+    return all;
+}
