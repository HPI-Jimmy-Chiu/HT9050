+    WIN32_FIND_DATAA fd;
+    HANDLE h = ::FindFirstFileA(Join(dir, "*").c_str(), &fd);
+    if (h == INVALID_HANDLE_VALUE) return v;
+    do {
+        const std::string n = fd.cFileName;
+        if (n != "." && n != "..") v.push_back(n);
+    } while (::FindNextFileA(h, &fd));
+    ::FindClose(h);
+    return v;
