+bool W906_StateRecordDialogTakes(const std::string& cmd) { return cmd == "act.main.stateRecord"; }
+void W906_StateRecordAutoTestReset() { g_autoDone = false; g_autoForPass = 0; ::InterlockedExchange(&g_autoCount, 0); }
