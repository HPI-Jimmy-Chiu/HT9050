+    if (s.seq == 0 || !s.ioList) return o;
+    const std::vector<W906SrDiagIoPoint>& pts = s.ioList->points;
+    for (std::size_t i = 0; i < pts.size() && i < s.ioValues.size(); ++i)
+        Line(o, IoCsvLine(pts[i], s.ioValues[i]));
