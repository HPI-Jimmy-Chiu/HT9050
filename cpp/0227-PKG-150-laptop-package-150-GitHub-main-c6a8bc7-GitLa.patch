+std::vector<std::string> SrcLines(const std::string& path)
+{
+    std::string s;
+    ReadAll(path, s);
+    std::vector<std::string> v;
+    std::size_t p = 0;
+    while (p < s.size()) {
+        std::size_t e = s.find('\n', p);
+        if (e == std::string::npos) e = s.size();
+        std::string l = s.substr(p, e - p);
+        if (!l.empty() && l[l.size() - 1] == '\r') l.erase(l.size() - 1);
+        v.push_back(l);
+        p = e + 1;
+    }
+    return v;
+}
