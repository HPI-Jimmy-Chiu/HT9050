+const std::vector<std::string>* IoRowByName(const std::vector<std::vector<std::string> >& rows, const std::string& name)
+{
+    for (std::size_t i = 0; i < rows.size(); ++i)
+        if (rows[i].size() > 3 && rows[i][3] == name) return &rows[i];
+    return 0;
+}
