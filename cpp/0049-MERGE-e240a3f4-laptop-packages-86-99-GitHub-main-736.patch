+    // ---- [L] ------------------------------------------------------------------------------------------------
+    std::printf("[L] never blocks: slowest call %lu ms\n", (unsigned long)g_slowestMs);
+    // No wait for anybody: the only delay is w906dlg::AtomicWrite's own sharing-violation retry, at most 20 x 50 ms per file,
