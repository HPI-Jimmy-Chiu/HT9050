+// =============================================================================
+//  AI(W906-STREAM-2A) 20260930: the STREAM question (RULINGS_20260930 #12, user 20:4x 「有開的網頁才能更新資料」).
+//  Not fShow. fShow errs towards "open" for SAFETY (a gate must not open by mistake); the stream errs towards "send" for
+//  CORRECTNESS of the picture (a page must not freeze on an old value): the only NO is "every fresh report explicitly says
+//  closed or never". Unknown (no frame yet, the window not in any frame, only stale reports) = YES. Keyed by the
+//  background.html id (pci1203, motionview ... have form:null and never reach byForm). Same fresh-over-stale union as
+//  WebWindowRegistryQuery. Minimized counts as open (golden: a minimized form keeps fShow and its timers).
+//  The "no browser connected at all" case is the page table's (W906_PageStreamWanted, WebPageTable.cpp EOF).
+// =============================================================================
+namespace ht9045 {
+bool WebWindowRegistryStreamWanted(const std::string& webId)
+{
+    if (!g_everAnyFrame) return true;                          // never received a table: unknown -> send
+    const std::int64_t now = NowMs();
+    bool freshSeen = false, freshOpen = false, staleSeen = false;
+    for (std::map<std::uint64_t, ConnFrame>::const_iterator it = Store().begin(); it != Store().end(); ++it) {
+        std::map<std::string, WinEntry>::const_iterator w = it->second.byId.find(webId);
+        if (w == it->second.byId.end()) continue;
+        if ((now - it->second.recvMs) > g_staleMs) { staleSeen = true; continue; }
+        freshSeen = true;
+        if (IsOpenLike(w->second.state) || w->second.state == kWinUnknown) freshOpen = true;
+    }
+    if (freshSeen) return freshOpen;                           // fresh reports decide (union: any open -> send)
+    (void)staleSeen;
+    return true;                                               // only stale reports, or the window in no frame -> send
+}
+} // namespace ht9045
