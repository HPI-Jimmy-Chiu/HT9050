+    //   counts are re-read only when the staged total of the last main-loop publish changed or the last read is >= 60 s old.
+    CHECK(Has(l1, "(read, last read "));
+    StreamNotePublish(5, 1000);                                   // staged 5 != 300 at l1's read
+    const std::string p1 = StreamTick(41000, &snap, 0);
+    CHECK(Has(p1, "| tags=5 pci1203=2 secs.sv=1 motionView=1 other=1 (read, last read "));
+    StreamNotePublish(5, 1000);
+    const std::string p2 = StreamTick(51000, &snap, 0);
+    CHECK(Has(p2, "| tags=5 pci1203=2 secs.sv=1 motionView=1 other=1 (cached, last read "));   // same total, 10 s later
+    snap.beginPublish();                                          // the tag set grows but the staged total says the same
+    snap.stage("pci1203.axis.0.cmdPos", webbridge::TagValue::makeInt(2));
+    snap.stage("pci1203.di.0", webbridge::TagValue::makeBool(false));
+    snap.stage("pci1203.di.1", webbridge::TagValue::makeBool(true));
+    snap.stage("secs.sv.1001", webbridge::TagValue::makeString("x"));
+    snap.stage("motionView.trays.loader", webbridge::TagValue::makeString("y"));
+    snap.stage("machine.state", webbridge::TagValue::makeString("idle"));
+    snap.commitPublish();
+    StreamNotePublish(5, 1000);
+    const std::string p3 = StreamTick(61000, &snap, 0);
+    CHECK(Has(p3, "| tags=5 ") && Has(p3, "(cached, "));          // stale by design until the safety re-read
+    const std::string p4 = StreamTick(101000, &snap, 0);          // 60 s after the read at 41000
+    CHECK(Has(p4, "| tags=6 pci1203=3 ") && Has(p4, "(read, "));
+    StreamNotePublish(6, 1000);
+    const std::string p5 = StreamTick(111000, &snap, 0);
+    CHECK(Has(p5, "| tags=6 ") && Has(p5, "(read, "));            // staged 6 != 5 at the last read
+    const std::string p6 = StreamTick(121000, &snap, 0);
+    CHECK(Has(p6, "(cached, "));
+
+    // the sink (the console copy also prints here; _putenv is not declared by MinGW.org under -std=c++17, so the
+    // W906_STREAM_STATS=0 switch is not exercised by this test)
+    StreamSetSink(&Sink);
+    StreamEmit("[STREAM] probe");
+    CHECK(g_sinkCalls == 1 && g_sunk == "[STREAM] probe");
+    StreamSetSink(0);
+    StreamEmit("[STREAM] probe 2");
+    CHECK(g_sinkCalls == 1);
+
+    std::printf("test_webstreamstats: %d/%d checks passed\n", g_total - g_fail, g_total);
+    if (g_fail) { std::printf("FAILED: %d checks\n", g_fail); return 1; }
+    std::printf("PASS\n");
+    return 0;
+}
