+            }
+            // 只切「字串外」的 //（引號裡的 // 例 "http://" 不算註解）
+            bool inStr = false;
+            std::size_t cut = std::string::npos;
+            for (std::size_t k = 0; k + 1 < line.size(); ++k) {
