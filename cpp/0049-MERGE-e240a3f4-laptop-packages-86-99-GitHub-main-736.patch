+        CHECK(ConsoleDecide((unsigned long)SessionEndConsoleEvent(true, kEndSessionLogoff), nth) == kConSessionEnd);
+        CHECK(ConsoleDecide((unsigned long)SessionEndConsoleEvent(true, 0), nth) == kConSessionEnd);
