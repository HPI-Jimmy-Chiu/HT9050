+            }
+            out->push_back(cut == std::string::npos ? line : line.substr(0, cut));
+            line.clear();
+        } else {
+            line += all[i];
+        }
+    }
+    return true;
+}
+static int FindLine(const std::vector<std::string>& v, const char* needle, int from = 0)
