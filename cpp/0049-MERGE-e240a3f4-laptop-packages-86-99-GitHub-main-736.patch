+    }
+
+    // ---- [B] ------------------------------------------------------------------------------------------------
+    std::printf("[B] a kcode==0 notice posts the mailbox pending\n");
+    RecordLike("JAM0508", 1, true);
+    StoppedLikeNotice();
+    PostNotice("17", "JAM0508", false);
+    CHECK(g_slot.kind == w906dlg::AlarmSlot::kNotice && g_slot.requestId == "17");
