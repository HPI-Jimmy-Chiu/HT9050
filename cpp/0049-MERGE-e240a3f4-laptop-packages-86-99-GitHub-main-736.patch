+    // ---- [E] ------------------------------------------------------------------------------------------------
+    std::printf("[E] the same id again: no-pending-notice, nothing applied twice\n");
+    {
+        SoftStop = false;
+        ResetSimEventReport();
+        const int jam0 = JamCount();
