+    e.htWin(true, 'open');
+    eq(e.fetches(), 1, 'immediate fetch when the window opens (no tick yet)');
+    await flush();
+    for (let i = 0; i < 3; i++) { e.tick(); await flush(); }
+    eq(e.fetches(), 4, 'fetches after 3 ticks while open');
+    eq(e.live()[0].ms, 200, 'IO poll interval (C++ reports 200)');
