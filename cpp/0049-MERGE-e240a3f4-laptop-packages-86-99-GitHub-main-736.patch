+                                                              s.msg ? s.msg : s.code, true);
+            CHECK(neu == OldPostAlarmJson(s.seq, s.id, s.code, s.k, s.pos, s.unit, s.msg));
+            cJSON* r = cJSON_Parse(neu.c_str());
+            CHECK(r != 0);
+            if (r) { CHECK(JsonStr(r, "state") == "pending"); CHECK(JsonStr(r, "requestId") == s.id); cJSON_Delete(r); }
