+int CountOn(const int* ids, int n) { int c = 0; for (int i = 0; i < n; ++i) if (SW[ids[i]].Status()) ++c; return c; }
+int CountFlags(const bool* f) { return (f[0] ? 1 : 0) + (f[1] ? 1 : 0) + (f[2] ? 1 : 0); }
