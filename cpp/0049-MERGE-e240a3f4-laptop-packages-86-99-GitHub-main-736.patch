+        RecordLike("JAM0508", 1, true);
+        StoppedLikeNotice();
+        PostNotice("21", "JAM0508", false);
+        CUSTOMER_CODE = CC_ASE_SG; bTesterSendPause = true;
+        const std::string ji = Slurp(aJson);
+        const int jam0 = JamCount();
+        std::string ack;
+        CHECK(Ack("21", &ack, g_dir) == false);
