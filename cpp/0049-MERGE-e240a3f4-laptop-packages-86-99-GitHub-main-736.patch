+    CHECK(SessionEndConsoleEvent(true, kEndSessionLogoff | kEndSessionCloseApp) == 5);
+    CHECK(SessionEndConsoleEvent(true, 0) == 6);                          // 關機／重開機
+    CHECK(SessionEndConsoleEvent(true, kEndSessionCloseApp) == 6);        // Restart Manager 要關這個程式
+    CHECK(SessionEndConsoleEvent(true, kEndSessionCritical) == 6);        // 強制
