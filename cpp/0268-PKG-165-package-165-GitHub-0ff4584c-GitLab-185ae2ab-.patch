+    if (cJSON_IsArray(cmds)) cJSON_ArrayForEach(c, cmds) {
+        ++rows;
+        const cJSON* a = cJSON_GetObjectItemCaseSensitive(c, "action");
+        const cJSON* s = cJSON_GetObjectItemCaseSensitive(c, "source");
+        const cJSON* b = cJSON_GetObjectItemCaseSensitive(c, "button");
+        const cJSON* k = cJSON_GetObjectItemCaseSensitive(c, "kind");
+        const cJSON* t = cJSON_GetObjectItemCaseSensitive(c, "trigger");
+        const cJSON* p = cJSON_GetObjectItemCaseSensitive(c, "params");
+        bool ok = cJSON_IsString(a) && cJSON_IsString(s) && cJSON_IsString(b) && cJSON_IsString(k) && cJSON_IsString(t) && cJSON_IsArray(p);
+        if (ok) {
+            const std::string src = s->valuestring, kind = k->valuestring;
+            ok = (src == "uMotorTest" || src == "uteach") && (kind == "motion" || kind == "control" || kind == "edit") && a->valuestring[0] != 0;
+            const cJSON* e = 0;
+            cJSON_ArrayForEach(e, p) ok = ok && cJSON_IsString(e);
+        }
+        if (!ok) { ++bad; printf("    catalog row %d: missing / wrong field (action / source / button / kind / trigger / params)\n", rows); continue; }
+        const std::string key = std::string(s->valuestring) + "|" + b->valuestring + "|" + t->valuestring;
+        if (!seen.insert(key).second) { ++dup; printf("    catalog row %d: %s twice\n", rows, key.c_str()); }
+    }
+    cJSON_Delete(cat);
+    printf("    (catalog: %d command rows, %d bad, %d twice)\n", rows, bad, dup);
+    return cJSON_IsArray(cmds) && rows > 0 && bad == 0 && dup == 0;
+}
+
+// the catalog's action set == WebMotorAccess.cpp kActions (file-local, read from the source next to this test)
+bool W906Pool5CatalogEqualsTable(const std::set<std::string>& acts)
+{
+    std::string self(__FILE__);
+    for (std::size_t i = 0; i < self.size(); ++i) if (self[i] == '\\') self[i] = '/';
+    const std::size_t t = self.rfind("/tests/");
+    const std::string path = (t == std::string::npos ? std::string(".") : self.substr(0, t)) + "/WebMotorAccess.cpp";
+    std::ifstream f(path.c_str(), std::ios::binary);
+    std::stringstream ss; ss << f.rdbuf();
+    const std::string src = ss.str();
+    const std::size_t i0 = src.find("const ActionRow kActions[] = {");
+    const std::size_t i1 = i0 == std::string::npos ? std::string::npos : src.find("\n};", i0);
+    std::set<std::string> table;
+    if (i1 != std::string::npos) {
+        std::istringstream in(src.substr(i0, i1 - i0));
+        std::string line;
+        while (std::getline(in, line)) {
+            const std::size_t cm = line.find("//");
+            if (cm != std::string::npos) line.erase(cm);                     // rows are packed after each other on one line; comments trail
+            for (std::size_t p = line.find('{'); p != std::string::npos; p = line.find('{', p + 1)) {
+                std::size_t q = p + 1;
+                while (q < line.size() && line[q] == ' ') ++q;
+                if (q >= line.size() || line[q] != '"') continue;
+                const std::size_t qe = line.find('"', q + 1);
+                if (qe == std::string::npos) continue;
+                const std::string name = line.substr(q + 1, qe - q - 1);
+                const std::size_t s0 = line.find('"', qe + 1);
+                const std::size_t s1 = s0 == std::string::npos ? std::string::npos : line.find('"', s0 + 1);
+                if (s1 == std::string::npos) continue;
+                const std::string st = line.substr(s0 + 1, s1 - s0 - 1);
+                if (st == "live" || st == "ui" || st == "queued" || st == "blocked") table.insert(name);
+            }
+        }
+    }
+    int onlyCat = 0, onlyTable = 0;
+    for (const std::string& a : acts) if (!table.count(a)) { ++onlyCat; printf("    catalog action %s is not in kActions\n", a.c_str()); }
+    for (const std::string& a : table) if (!acts.count(a)) { ++onlyTable; printf("    kActions row %s is not a catalog action\n", a.c_str()); }
+    printf("    (%s: %u catalog actions, %u kActions rows)\n", path.c_str(), (unsigned)acts.size(), (unsigned)table.size());
+    return !table.empty() && onlyCat == 0 && onlyTable == 0;
+}
