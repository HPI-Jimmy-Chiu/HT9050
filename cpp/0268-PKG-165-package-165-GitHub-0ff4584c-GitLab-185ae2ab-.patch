+bool W906Pool5CatalogRows(const std::string& json)
+{
+    cJSON* cat = cJSON_Parse(json.c_str());
+    const cJSON* cmds = cat ? cJSON_GetObjectItemCaseSensitive(cat, "commands") : 0;
