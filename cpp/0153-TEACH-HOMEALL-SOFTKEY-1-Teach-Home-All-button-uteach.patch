+// AI(W906-SOFTKEY) 20261003: EastSun 「你可以幫我圖片上 紅框內做出按鈕嗎 因為我現在實體按鈕沒辦法通訊 需要在軟體上 按按鈕做動」.
+// Screen panel keys: WS panel.key (tools/wb_serve.cpp) pushes one key id here; ScanPannelKey (ckernel.cpp, the W906_VirtualPanelKeyHook
+// line after golden's SystemInitialOK / SafeLock / employee-ID refusals) hands it to whichever key reader asks first -- TfMain::ScanKey
+// above, the Home hook (PAUSE aborts a home), the alarm / message waits (RETRY / SKIP / PAUSE / ALARM RESET) -- exactly like one
+// physical press.  [W906] A key nobody reads within kSoftKeyLifeMs is dropped (a guard such as an open dialog kept every reader from
+// scanning), so a press can never fire long after the operator made it; at most kSoftKeyMax are queued.  Front-pad ids (SnFK*).
+#include <deque>
+#include <windows.h>
+extern int (*W906_VirtualPanelKeyHook)();                // ckernel.cpp EOF
+namespace {
+const unsigned long kSoftKeyLifeMs = 3000;
+const std::size_t   kSoftKeyMax    = 4;
+struct MskSoftKey { int id; unsigned long t; std::string name; };
+std::deque<MskSoftKey> s_softKeys;
+int MskSoftKeyPop()
+{
+    const unsigned long now = ::GetTickCount();
+    while (!s_softKeys.empty()) {
+        const MskSoftKey k = s_softKeys.front();
+        s_softKeys.pop_front();
+        if ((unsigned long)(now - k.t) <= kSoftKeyLifeMs) {
+            std::printf("[SOFTKEY] %s read by the key scan\n", k.name.c_str());
+            return k.id;
+        }
+        std::printf("[SOFTKEY] %s dropped: not read within %lu ms (a dialog / guard kept the key scan away)\n", k.name.c_str(), kSoftKeyLifeMs);
+    }
+    return -1;
+}
+}  // namespace
+bool W906_SoftPanelKeyPush(const std::string& name, std::string& why)
+{
+    static const struct { const char* n; const int* id; } kKeys[] = {
+        { "START", &SnFKStart }, { "PAUSE", &SnFKPause }, { "HOME", &SnFKHome }, { "RESET", &SnFKReset },
+        { "ONECYCLE", &SnFKOneCycle }, { "CLEANOUT", &SnFKCleanOut }, { "TRAYFEED", &SnFKTrayFeed }, { "TRAYEND", &SnFKTrayEnd },
+        { "ALARMRESET", &SnFKAlarmReset }, { "RETRY", &SnFKRetry }, { "SKIP", &SnFKSkip } };
+    for (std::size_t i = 0; i < sizeof(kKeys) / sizeof(kKeys[0]); ++i) {
+        if (name != kKeys[i].n) continue;
+        if (s_softKeys.size() >= kSoftKeyMax) { why = "panel.key " + name + ": 前面還有 " + std::to_string(s_softKeys.size()) + " 個按鍵沒被讀走，這一下不收"; return false; }
+        W906_VirtualPanelKeyHook = &MskSoftKeyPop;
+        MskSoftKey k; k.id = *kKeys[i].id; k.t = ::GetTickCount(); k.name = name;
+        s_softKeys.push_back(k);
+        std::printf("[SOFTKEY] %s pushed (key id %d)\n", name.c_str(), k.id);
+        why = "panel.key " + name + "：已送出，等同按一下實體面板鍵（原版 TfMain::ScanKey 照樣判斷要不要動作）";
+        return true;
+    }
+    why = "panel.key: 不認得的按鍵 '" + name + "'（START／PAUSE／HOME／RESET／ONECYCLE／CLEANOUT／TRAYFEED／TRAYEND／ALARMRESET／RETRY／SKIP）";
+    return false;
+}
+
+// AI(W906-TEACH-HOMEALL) 20261003: EastSun 「請你先幫我在 teach 做一個全機回 home 的按鈕 我需要做測試 因為現在實體按鈕沒作用」.
+// The panel HOME key's arm above (golden main.cpp:2545-2563), for a screen button (WebMotorAccessLive.cpp GoldenHomeAll ->
+// motor.access uteach btnHomeAll / teachHomeAll). Same checks, same order, same TfMain::Home -- only the caller differs.
+// Returns 0 = BtnHome disabled (SystemStart), 1 / 2 = a bin check refused (its message is shown), 3 = TfMain::Home refused,
+// 4 = armed (SoftStart / iHome set; MainProc runs the home on the following beats).
+int W906_PanelHomeKeyArm(const char* who, std::string& why)
+{
+    if(!MskBtnHomeEnabled())
+    {
+        why = "SystemStart==true（運轉中）—— golden BtnHome->Enabled=false（ProcessKeyFlush main.cpp:4107-4111）";
+        return 0;
+    }
+    if(IniConfig.bG06HomeinitialCheckZ1 &&bHomeUnlock==false)                   //kevin 20131218
+        bHomeinitialCheckPushZ1=true;
+    if(MskCheckAutoOnlySetOneBin())
+    {
+        why = "golden CheckAutoOnlySetOneBin 擋下（訊息已顯示，main.cpp:32544）";
+        return 1;
+    }
+    if(IniConfig.bP28Auto1OnlyBin1==true && MskCheckAuto1OnlyBin1())
+    {
+        why = "golden CheckAuto1OnlyBin1 擋下（訊息已顯示，main.cpp:32511／:32516）";
+        return 2;
+    }
+    bHomeByStart=false;
+    if(!fMain->Home(who))
+    {
+        why = "golden TfMain::Home 回 false（SoftStart 已經設了，或它自己的檢查擋下：測試機未完成／OLP bin／Out Arm 破真空檢查）";
+        return 3;
+    }
+    why = "全機回原點已啟動（SoftStart／iHome 已設）";
+    return 4;
+}
