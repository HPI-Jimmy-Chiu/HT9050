+//  AI(W906-TEACH-HOMEALL) 20261003: EastSun 「請你先幫我在 teach 做一個全機回 home 的按鈕 我需要做測試 因為現在實體按鈕沒作用」.
+//  uteach btnHomeAll -> teachHomeAll.  NOT a golden button: golden homes the machine from the panel HOME key (TfMain::ScanKey
+//  main.cpp:2545-2563; the main-screen HOME does nothing on a real machine, main.cpp:7127-7143).  This runs exactly that arm
+//  (IMotorAccessBackend::GoldenHomeAll -> WebMainScanKey.cpp W906_PanelHomeKeyArm), so the home sequence itself is golden's
+//  (Z first, then XY, then TrayX / CCDY -- forms/fHome.cpp THomeOrder).
+//  Guards before it, besides the dispatcher's (SystemStart, manual teach, Arm Cell): no Teach / Motor Test HOME job and no jog may
+//  still be running -- the full HOME would command the same axes.  On "armed" the live backend closes the Teach page: golden MainProc
+//  returns every beat while fTeach is shown (csystem.cpp, the VerifyMotorAction arm), so the home only starts once it is closed.
+//  No confirm dialog (EastSun: a button golden runs on press is sent on press).
+// =============================================================================
+namespace ht9045 {
+MotorAccessOutcome TeachHomeAllDispatch(const MotorAccessReq& r, long long wireId, IMotorAccessBackend& be)
+{
+    (void)wireId;
+    const std::string who = "全機回原點（Teach btnHomeAll = 面板 HOME 鍵 golden main.cpp:2545）";
+    if (r.source != "uteach" || r.button != "btnHomeAll")
+        return Refuse("teachHomeAll: 只收教導頁的 btnHomeAll（來源 " + r.source + "，按鈕 " + r.button + "）");
+    if (AnyJobActive() || !g_jogs.empty())
+        return Refuse(who + ": 還有單軸回原點／JOG／迴圈在跑 —— 先等它結束或按 STOP，全機回原點會動到同一批軸");
+    std::string why;
+    const int rc = be.GoldenHomeAll("Teach btnHomeAll", why);
+    if (rc != 4) return Refuse(who + ": " + why);
+    webbridge::JsonWriter w;
+    w.BeginObject();
+    AckHead(w, r, "homeArmed", "uteach", who + ": " + why + "；教導頁關閉後開始（Z 先回完再回 XY），進度看 Home Monitor");
+    w.Key("closeTeach").Bool(true);
+    MotorAccessOutcome o; o.ok = true; o.ackJson = Finish(w); return o;
+}
+}  // namespace ht9045
