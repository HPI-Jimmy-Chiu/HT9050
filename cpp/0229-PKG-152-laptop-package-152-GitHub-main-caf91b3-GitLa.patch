+//  AI(W906-E042) 20261005 (B4, St01; ST01-M 1005: FYI claim, EOF only): the contact-mode SINGLE ENTRY for the translated
+//  contact state machine (forms/fContact_ContactSM.cpp DoTestContactFunction case 1, golden 0618 :11790).
+//  [906] golden 0618 case 1 calls TfContact::SetContactMode (0618 :15341-15434) on the form's own radios.
+//  [V912] the web drives the C-route copy DF_SetContactMode (generated from V912 cContact.cpp:15566-15696, incl. mode 12
+//         VISUAL_DETECTION_TEST) through g_ct3aRb (the radio the operator picked); that copy is `static` in the .gen.inc.
+//  [why] Steven 1003 standing rule (V912 better -> keep V912 + 906 notes) and ST01-M 1005: one entry, so the run uses
+//        exactly the mode the web picked.  This wrapper runs DF_SetContactMode on the C-route radios, then mirrors the
+//        picked radio onto the TfContact facade radios and copies what DF_SetContactMode set that case 1 / P8 read next
+//        from the facade (chkDailyCorrelation, cbOneTouchAutoContactHight, chk_K_Temperature).  No caller until step B6.
+//  rbForTest >= 0: test seam only (ctest IndexZAutoHeight1203) -- selects the radio as g_ct3aRb would.
+// =============================================================================================
+void FileRW_Contact_SetContactModeSingleEntry(int rbForTest)
+{
+    if (rbForTest >= 0 && rbForTest < 11) g_ct3aRb = rbForTest;
+    Ct3aImpose();
+    DF_SetContactMode();
+    TfContact* F = fContactForm;
+    if (!F) return;
+    TRadioButton* fr[11] = { F->rbModeNormal, F->rbAutoHeight, F->rbManualHeight, F->rbContactTest, F->rbAutoContactTest, F->rbStepContactTest,
+                             F->rbDeviceMapping, F->rbLoadCellAutoHigh, F->rbKTempIndexMove, F->rbDeviceLoopTest, nullptr };   // kCt3aRb order; rbVisualDetectionTest is not on the 0618 facade
+    for (int k = 0; k < 11; ++k) if (fr[k]) fr[k]->Checked = (k == g_ct3aRb);
+    F->chkDailyCorrelation->Enabled        = EL<TCheckBox>(kForm, "chkDailyCorrelation")->Enabled;
+    F->chkDailyCorrelation->Checked        = EL<TCheckBox>(kForm, "chkDailyCorrelation")->Checked;
+    F->cbOneTouchAutoContactHight->Visible = EL<TCheckBox>(kForm, "cbOneTouchAutoContactHight")->Visible;
+    F->cbOneTouchAutoContactHight->Checked = EL<TCheckBox>(kForm, "cbOneTouchAutoContactHight")->Checked;
+    F->chk_K_Temperature->Checked          = EL<TCheckBox>(kForm, "chk_K_Temperature")->Checked;
+}
+extern void (*W906_ContactModeSingleEntryHook)(int rbForTest);   // IndexZTorque1203.h (ht9045_sm): registered here, called by DoTestContactFunction case 1
+static const bool s_e042SingleEntryReg = (W906_ContactModeSingleEntryHook = &FileRW_Contact_SetContactModeSingleEntry, true);
