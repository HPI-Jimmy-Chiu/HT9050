+const long kW44HomeTolCounts = 100;
+struct ShuttleHomeIn {
+    bool inPresent, outPresent;
+    long inPos, outPos;
+    long inTarget, outTarget;       // Prod.InSHT[0].iLeft / Prod.OutSHT[0].iRight
