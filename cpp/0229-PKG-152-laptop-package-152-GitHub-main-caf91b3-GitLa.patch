+        size_t e = text.find('\n', p);
+        if (e == std::string::npos) e = text.size();
+        std::string l = text.substr(p, e - p);
+        if (!l.empty() && l[l.size() - 1] == '\r') l.erase(l.size() - 1);
+        v.push_back(l);
+        p = e + 1;
+    }
+    return v;
+}
