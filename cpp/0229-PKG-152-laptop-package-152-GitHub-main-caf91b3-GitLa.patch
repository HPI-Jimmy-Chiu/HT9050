+    why += ", Out shuttle 1 ";
+    why += s.outPresent ? ("at " + std::to_string(s.outPos)) : std::string("missing");
+    why += " / OutSHT[0].iRight " + std::to_string(s.outTarget);
+    why += outHome ? " ok)" : " NOT home)";
