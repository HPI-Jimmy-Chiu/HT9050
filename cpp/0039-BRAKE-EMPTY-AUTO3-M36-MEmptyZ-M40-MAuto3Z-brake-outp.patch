+    SW[SwCassetteEmptyMotBreaker  ].Name="SwCassetteEmptyMotBreaker";           //AI(W906-BRAKE-EMPTY-AUTO3) 20260930: HT9050 M36（cmydef.cpp）
+    SW[SwCassetteAuto3MotBreaker  ].Name="SwCassetteAuto3MotBreaker";           //AI(W906-BRAKE-EMPTY-AUTO3) 20260930: HT9050 M40
 
