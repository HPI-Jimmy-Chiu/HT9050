+    for (int i = 0; i < nSoft; ++i) {
+        const int m = *kSoft[i].motor;
+        if (!MOT[m].Motor) { MOT[m].Motor = new TMySimMotor(); MOT[m].Motor->PSoftLimitP = 1000 + m; MOT[m].Motor->PSoftLimitN = -(2000 + m); }
+    }
+    int badS = 0;
+    for (int i = 0; i < nSoft; ++i) {
+        const int m = *kSoft[i].motor;
+        const double wa = 1000 + m, wb = kSoft[i].trayX ? -5000 : -(2000 + m);
+        if (W906_TeachKbRange(kSoft[i].edit, &a, &b) != 1 || a != wa || b != wb) { ++badS; std::printf("    soft %s: (%g, %g) want (%g, %g)\n", kSoft[i].edit, a, b, wa, wb); }
+    }
+    checkLoud(badS == 0, "all 294 soft-limit rows -> MOT[axis].Motor->PSoftLimitP / PSoftLimitN (TrayX: P, -5000 :5273)");
+
+    // ---- 6. the extra JSON ----
+    machine();
+    const std::string js = FileRW_Teach_KbExtraJson();
+    if (argc > 2) { std::ofstream o(argv[2], std::ios::binary); o << js; }   // argv[2]: dump this machine's extra (sim motors) for the web probe
+    cJSON* root = cJSON_Parse(js.c_str());
+    cJSON* kb = root ? cJSON_GetObjectItem(root, "kb") : nullptr;
+    cJSON* ms = root ? cJSON_GetObjectItem(root, "motorSoft") : nullptr;
+    checkLoud(root && kb && ms, "extra JSON parses: {kb, motorSoft}");
+    if (kb && ms) {
+        cJSON* e = cJSON_GetObjectItem(kb, "setEditAuto1Y");
+        checkLoud(e && cJSON_GetArraySize(e) == 5 && std::strcmp(cJSON_GetArrayItem(e, 0)->valuestring, "INTEGER") == 0 &&
+                  cJSON_GetArrayItem(e, 1)->valuedouble == 0 && cJSON_IsTrue(cJSON_GetArrayItem(e, 2)) &&
+                  cJSON_GetArrayItem(e, 3)->valuedouble == -60000 && cJSON_GetArrayItem(e, 4)->valuedouble == -74000,
+                  "kb.setEditAuto1Y = [\"INTEGER\",0,true,-60000,-74000]");
+        cJSON* f4 = cJSON_GetObjectItem(kb, "setEditFix4X");
+        checkLoud(f4 && cJSON_IsNull(f4), "kb.setEditFix4X = null (golden opens no keypad)");
+        checkLoud(cJSON_GetObjectItem(kb, "edtMoveTo") == nullptr, "edtMoveTo is not in kb (the page uses motorSoft for the selected axis)");
+        int nkb = cJSON_GetArraySize(kb);
+        checkLoud(nkb == 522, "kb has 522 entries: every row but edtMoveTo (5 of them null) -> " + std::to_string(nkb));
+        cJSON* mx = cJSON_GetObjectItem(ms, std::to_string(MInArmX).c_str());
+        checkLoud(mx && cJSON_GetArraySize(mx) == 2 && cJSON_GetArrayItem(mx, 0)->valuedouble == 1000 + MInArmX &&
+                  cJSON_GetArrayItem(mx, 1)->valuedouble == -(2000 + MInArmX), "motorSoft[MInArmX] = [PSoftLimitP, PSoftLimitN]");
+    }
+    if (root) cJSON_Delete(root);
+
+    // ---- 7. source pins ----
+    if (argc > 1) {
+        const std::string root_ = argv[1];
+        const std::string teach = readAll(root_ + "/FileRW/Teach.cpp");
+        const std::string call = "w.Key(\"extra\").RawValue(FileRW_Teach_KbExtraJson());";
+        const std::size_t c = teach.find(call);
+        const std::size_t ls = (c == std::string::npos) ? 0 : teach.rfind('\n', c);
+        const std::string before = (c == std::string::npos) ? "" : teach.substr(ls + 1, c - ls - 1);
+        checkLoud(c != std::string::npos && before.find("//") == std::string::npos,
+                  "FileRW/Teach.cpp: the extra call is live code (not after a // on its line)");
+        checkLoud(teach.find("\nstd::string FileRW_Teach_KbExtraJson();") != std::string::npos, "FileRW/Teach.cpp: the declaration is at file scope (not on an #include line)");
+        const std::string html = readAll(root_ + "/../web/page/HW.teach.html");
+        const std::size_t eng = html.find("<script src=\"ht9045_wire_engine.js\"></script>");
+        const std::size_t kbs = html.find("<script src=\"ht9045_teach_kb_c.js\"></script>");
+        checkLoud(eng != std::string::npos && kbs != std::string::npos && eng < kbs, "HW.teach.html loads ht9045_teach_kb_c.js after the engine");
+        const std::string wjs = readAll(root_ + "/../web/page/ht9045_teach_kb_c.js");
+        checkLoud(wjs.find("onAbort") != std::string::npos && wjs.find("checkRange(atof(orig)") != std::string::npos,
+                  "ht9045_teach_kb_c.js: Abort clamps the restored value (golden :364 -> :285-291)");
+    } else {
+        checkLoud(false, "argv[1] (the port root) missing: source pins not run");
+    }
+    std::printf("RESULT: %d passed, %d failed\n", g_pass, g_fail);
+    return g_fail ? 1 : 0;
+}
