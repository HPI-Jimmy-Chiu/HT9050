+int g_fail = 0, g_pass = 0;
+void check(bool ok, const std::string& what) {
+    if (!ok) std::printf("  FAIL  %s\n", what.c_str());
+    if (ok) ++g_pass; else ++g_fail;
+}
+void checkLoud(bool ok, const std::string& what) { std::printf("  %s  %s\n", ok ? "PASS" : "FAIL", what.c_str()); if (ok) ++g_pass; else ++g_fail; }
+
+void machine() {                       // this machine (measured 20261002)
+    MachineTypeChoice = Type_HT9046_LS;  SubMachineType = Type_None;  CUSTOMER_CODE = CC_PTI;
+    AUTO_EMPTY_COLOR = 0;  USE_IN_OUT_ARM_Y_PITCH = iXPitch60;  HOT_PLATE_POSITION = 0;  USE_HOTPLATE_TYPE = 0;
+    FIX3_FULL_PLACE = 0;  USE_PICKER_COUNT = 1;  USE_INDEX_ARM_AXES = IndexArm_4_Axis;  USE_Top_Scanner_AOI_Inspection = 0;
+    CosFunction.bLimitMaxSpeed = false;  CosFunction.iLimitMaxSpeed = 0;  fIndexDownPos = -148.0;
+}
+int table(const Exp* t, int n, const char* label) {
+    int bad = 0;
+    for (int i = 0; i < n; ++i) {
+        double a = 0, b = 0;
+        const int k = W906_TeachKbRange(t[i].edit, &a, &b);
+        const bool ok = (k == t[i].kind) && (k != 1 || (a == t[i].a && b == t[i].b));
+        if (!ok) { ++bad; std::printf("    %s %s: got kind %d (%g, %g), want %d (%g, %g)\n", label, t[i].edit, k, a, b, t[i].kind, t[i].a, t[i].b); }
+    }
+    return bad;
+}
+bool one(const char* edit, double wa, double wb) { double a = 0, b = 0; return W906_TeachKbRange(edit, &a, &b) == 1 && a == wa && b == wb; }
+bool none(const char* edit) { double a = 0, b = 0; return W906_TeachKbRange(edit, &a, &b) == 2; }
+std::string readAll(const std::string& p) { std::ifstream f(p.c_str(), std::ios::binary); std::stringstream ss; ss << f.rdbuf(); return ss.str(); }
+}  // namespace
