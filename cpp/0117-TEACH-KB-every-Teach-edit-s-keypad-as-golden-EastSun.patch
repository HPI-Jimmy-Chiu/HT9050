+int W906_TeachKbRowCount() { return (int)(sizeof(kRows) / sizeof(kRows[0])); }
+const char* W906_TeachKbRowEdit(int i) { return (i >= 0 && i < W906_TeachKbRowCount()) ? kRows[i].edit : ""; }
+
+// editlist.get tag=Teach 的 "extra"：
+//   kb：{ 欄位: ["INTEGER",0,true,a,b] ＝ golden ShowQwertyKey(Sender, N_INTEGER, 0, true, a, b)；null ＝ golden 處理器不開小鍵盤 }
+//   motorSoft：{ "<MOT 編號>": [PSoftLimitP, PSoftLimitN] }（edtMoveTo 用頁面選取的那一軸，golden :5164）
+//   開機前（Motor 還沒建）的軟體極限欄位不送 ⇒ 頁面照舊（引擎的通用小鍵盤）。
+std::string FileRW_Teach_KbExtraJson()
+{
+    webbridge::JsonWriter w;
+    w.BeginObject();
+    w.Key("kb").BeginObject();
+    for (int i = 0; i < W906_TeachKbRowCount(); ++i) {
+        double a = 0, b = 0;
+        const int k = W906_TeachKbRange(kRows[i].edit, &a, &b);
+        if (k == 1) {
+            w.Key(kRows[i].edit).BeginArray();
+            w.String("INTEGER");
+            w.Number((wb_int64)0);
+            w.Bool(true);
+            w.Number(a);
+            w.Number(b);
+            w.EndArray();
+        } else if (k == 2) {
+            w.Key(kRows[i].edit).Null();
+        }
+    }
+    w.EndObject();
+    w.Key("motorSoft").BeginObject();
+    for (int m = 0; m < MAX_TRAY_MOTOR; ++m) {
+        if (MOT[m].Motor == nullptr) continue;
+        w.Key(std::to_string(m)).BeginArray();
+        w.Number((wb_int64)MOT[m].Motor->PSoftLimitP);
+        w.Number((wb_int64)MOT[m].Motor->PSoftLimitN);
+        w.EndArray();
+    }
+    w.EndObject();
+    w.EndObject();
+    return w.Ok() ? w.Str() : std::string("{}");
+}
