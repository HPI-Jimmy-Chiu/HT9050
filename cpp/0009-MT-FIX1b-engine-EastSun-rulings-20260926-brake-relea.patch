+//AI(W906-MT-FIX1) 20260926: the servo-ON guard in front of golden's brake releases (EastSun ruling 20260926, csystem.h).
+//  Tick thread only (DoSystem / CountMotorPowerDelay / uhome all run there).  The log line is printed only when a group's
+//  answer changes, so the G05 idle pass (every DoSystem pass) does not flood the console.
+bool W906_BrakeReleaseOK(const char* group, const char* site)
+{
+    if (W906_BrakeServoOnHook == 0) return true;                                // ctest / no wb_serve side: golden
+    static const char* const kGroups[5] = { "Index", "Magazine", "InOutArmZ", "LDCarRotArmZ", "Cassette" };
+    static int s_last[6] = { -1, -1, -1, -1, -1, -1 };                          // 1 allowed / 0 held / -1 never asked; [5] = unknown name
+    int gi = 5;
+    for (int i = 0; i < 5; ++i) if (group && std::strcmp(group, kGroups[i]) == 0) { gi = i; break; }
+    AnsiString why;
+    bool ok = true;
+    if (bMotorPowerState == false) { ok = false; why = "bMotorPowerState=false (motor power off / just cut; SnMotorPower lags)"; }
+    else ok = W906_BrakeServoOnHook(group, &why);
+    const int now = ok ? 1 : 0;
+    if (s_last[gi] != now) {
+        std::printf("brake release %s: %s (%s)%s%s\n", ok ? "ALLOWED" : "HELD", group ? group : "?", site ? site : "",
+                    ok ? "" : " -- ", ok ? "" : why.c_str());
+        s_last[gi] = now;
+    }
+    return ok;
+}
