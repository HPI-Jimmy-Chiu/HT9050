From c09bb8bab3a83ac7696158af14965e514f42f7e0 Mon Sep 17 00:00:00 2001
From: "HT9045 Machine (V906)" <Claude_RDBC_02@honprec.com>
Date: Thu, 8 Oct 2026 15:37:53 +0800
Subject: [PATCH] IORESUME: after a debugger break, wait for one fresh 1203 IO
 poll before judging the image stale -- EastSun 1008 'pause all counters while
 stopped at a breakpoint' -> 'do it the most reasonable way'.

gdb on Windows stops every thread (non-stop mode: "The target does not support running in non-stop mode", gdb 17.2, measured), so
on resume the main thread reached Pci1203IoThreadAdopt before the IO thread finished a new poll, saw a 21 s old sample and marked
the image 'card not open' -> LINK lost, routes refused, IsIndexMotorOutOfPower -> 'EMG/Servo sensor error' (14:32).
EtherCAT/Pci1203Monitor.cpp: Pci1203IoThreadAdopt calls W906IoAfterSuspendWait_ (end of file, same line): when the main thread itself
  did not run for kW906IoStaleMs (the whole process was stopped, not an IO thread hung on its own) it waits up to kW906IoStaleMs for
  one poll completed after the resume, then Adopt runs as before. No check is relaxed and no decision runs on the old image; a dead
  IO thread publishes nothing and the stale rule marks it as before. Console line '[IOTHREAD] resume: ...'.
Not covered: other wall-clock timeouts (cylinder / sucker) still run through a break.
tests: Pci1203Seam / Pure / MotorRoute / LinkWatch / ModuleCheck / Reopen, Idx1203GaliBranch, IndexZTorque1203 / AutoHeight1203
  passed (none starts the IO thread: the new path is verified on the machine). Release and Debug linked.
WORKLOG row 208.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 EtherCAT/Pci1203Monitor.cpp | 46 ++++++++++++++++++++++++++++++++++++-
 docs/WORKLOG_MACHINE.md     |  1 +
 2 files changed, 46 insertions(+), 1 deletion(-)

diff --git a/EtherCAT/Pci1203Monitor.cpp b/EtherCAT/Pci1203Monitor.cpp
index d662960..35402f6 100644
--- a/EtherCAT/Pci1203Monitor.cpp
+++ b/EtherCAT/Pci1203Monitor.cpp
@@ -4565,7 +4565,7 @@ void Pci1203IoThreadRunSync(void (*fn)(void*), void* arg, bool boundaryOnly)
 bool Pci1203IoThreadAdopt()
 {
     if (!Pci1203IoThreadRunning() || !g_w906IoCsInit || Pci1203OnIoThread()) return false;
-    bool fresh = false, staleNow = false;
+    { void W906IoAfterSuspendWait_(); W906IoAfterSuspendWait_(); }   /* AI(W906-IORESUME) 20261008: the whole process was stopped (debugger break) -> wait for one fresh poll before judging staleness (end of file) */  bool fresh = false, staleNow = false;
     unsigned long ageMs = 0;
     ::EnterCriticalSection(&g_w906IoScs);
     if (g_w906IoStagedP != 0 && g_w906IoPubP != 0 && g_w906IoStagedSeq != g_w906IoPubSeq) {
@@ -4720,3 +4720,47 @@ static bool s_w906StartRingSkip = false;
 bool W906_Pci1203StartRingSkip() { return s_w906StartRingSkip; }
 void W906_Pci1203StartRingSkipSet(bool b) { s_w906StartRingSkip = b; }
 }  // namespace ht9045
+//==============================================================================
+//AI(W906-IORESUME) 20261008: EastSun 1008「請改中斷的時候 所有計數 暫停 直到中段再次啟動」→「你幫我用最合理的方式改」→「想辦法啊」.
+//  A debugger break (gdb on Windows has no non-stop mode: "The target does not support running in non-stop mode", measured
+//  20261008 with gdb 17.2) freezes EVERY thread, the IO thread too. On resume the main thread reached Pci1203IoThreadAdopt before the
+//  IO thread had finished one new poll, saw the newest sample 21 s old and marked the image "card not open" (14:32:36: LINK lost ->
+//  routes refused -> IsIndexMotorOutOfPower -> "EMG/Servo sensor error"), though no EMG was pressed and nothing was wrong.
+//  What changes: when the MAIN thread itself did not run for kW906IoStaleMs (so the whole process was stopped -- a debugger break or
+//  a whole-process stall -- not an IO thread that hung on its own), the main thread first waits up to kW906IoStaleMs for ONE new poll
+//  that completed after the resume, then Adopt carries on exactly as before. Nothing is skipped or relaxed:
+//    * no judgement is made on the old image: the main thread waits instead of running on it;
+//    * every check after it (LinkWatch, IsIndexMotorOutOfPower, EMG) runs on the fresh poll -- an EMG pressed during the break is seen;
+//    * an IO thread that really is dead publishes nothing, the wait ends, and the stale rule marks the image as before (WAR16152,
+//      EMG/Servo), only up to kW906IoStaleMs later.
+//  Only the main thread calls Adopt (Pci1203IoMark.h); the first call (thread start) has no previous time and never waits.
+namespace ht9045 {
+static DWORD s_w906AdoptLastAt = 0;
+void W906IoAfterSuspendWait_()
+{
+    const DWORD now = ::GetTickCount();
+    const DWORD last = s_w906AdoptLastAt;
+    s_w906AdoptLastAt = now ? now : 1u;
+    if (last == 0 || (DWORD)(now - last) < kW906IoStaleMs)
+        return;                                        // the main thread kept running: nothing to wait for
+    if (!g_w906IoCsInit || g_w906IoStagedP == 0 || !Pci1203IoThreadAlive())
+        return;
+    ::EnterCriticalSection(&g_w906IoScs);
+    const unsigned long seq0 = g_w906IoStagedSeq;
+    ::LeaveCriticalSection(&g_w906IoScs);
+    const DWORD t0 = ::GetTickCount();
+    bool got = false;
+    while ((DWORD)(::GetTickCount() - t0) < kW906IoStaleMs) {
+        ::EnterCriticalSection(&g_w906IoScs);
+        got = (g_w906IoStagedSeq != seq0);
+        ::LeaveCriticalSection(&g_w906IoScs);
+        if (got) break;
+        ::Sleep(5);
+    }
+    const DWORD t1 = ::GetTickCount();
+    s_w906AdoptLastAt = t1 ? t1 : 1u;
+    std::printf("[IOTHREAD] resume: the main thread itself did not run for %lu ms (debugger break / whole-process stop) -- waited %lu ms for a fresh IO poll: %s\n",
+                (unsigned long)(now - last), (unsigned long)(t1 - t0), got ? "got one, carrying on" : "none came, the stale rule applies");
+    std::fflush(stdout);
+}
+}  // namespace ht9045
\ No newline at end of file
