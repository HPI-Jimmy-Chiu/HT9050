diff --git a/Motor/myGALILmotor.cpp b/Motor/myGALILmotor.cpp
index 3af78a96..7f9aa0b4 100644
--- a/Motor/myGALILmotor.cpp
+++ b/Motor/myGALILmotor.cpp
@@ -5772,7 +5772,7 @@ void StopAllMotor(bool bIndexCanStop)
 
         if(MOT[i].Motor->Enable==true)
         {
-            if(MOT[i].Motor->PServoAlarmOn==1)                                  //jou 2014-07-02 retrun to V2.12R 修正立即停止造成步進馬達失步
+            if(MOT[i].Motor->PServoAlarmOn==1 || MOT[i].CardType=="PCI1203")   /*AI(W906-PAUSESTOP1203) 20261010: EastSun「目前動作過程中按Pause步進馬達不會停止，會走到目標位置」→「照A改」-- PAUSE calls this while SystemStart is still true, so golden stops a ServoAlarmOn=0 axis only later (the stepper step-loss guard below); a PCIE-1203 axis is stopped by the card's decelerated stop (Acm_AxStopDec) on a closed-loop EtherCAT drive, nothing to lose -- stop it now like a servo. PCIL132_StopMotor clears fCMD, so the next MotorMove(target) after START re-issues the move from where it stopped. Other machines: golden. Same line*/   //jou 2014-07-02 retrun to V2.12R 修正立即停止造成步進馬達失步
             {
                 MOT[i].PCIL132_StopMotor();
             }
