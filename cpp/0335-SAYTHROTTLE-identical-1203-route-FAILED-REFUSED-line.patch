+//AI(W906-SAYTHROTTLE) 20261008: EastSun 1008 screenshot of the console「這邊在做什麼 也太誇張」→「請一直優化執行續」. Common Motion Utility
+//  held the card's authority, so every engine stop failed with 0x800000D3 GetAuthorityFailed; a failed stop is a `force` line (never
+//  dropped by the 30 / 500 budget) and every FAILED / REFUSED line also goes to the op log, so the same few lines were written 29690
+//  times in 8 minutes -- console and op-log writes on the tick thread. Now an identical FAILED / REFUSED line (same station, axis, call, verdict and
+//  reason) within 5 s of the last one shown is counted instead of written; the next one shown carries "(+N identical, suppressed)".
+//  Nothing else changes: the stop is still issued every time, LatchFault / the stats / golden's WAR16122 path still see each one, and
+//  a line that differs in anything is written at once.
+#include <chrono>
+namespace ht9045 {
+namespace {
+struct W906SayRep { long long lastMs; unsigned long suppressed; };
+std::map<std::string, W906SayRep> s_w906SayRep;
+}  // namespace
+namespace {
+bool W906_SayRepeatGate_(int board, int port, const char* what, const char* verdict, const std::string& why)
+{
+    if (!verdict || (std::strstr(verdict, "FAIL") == 0 && std::strcmp(verdict, "REFUSED") != 0)) return false;   // only the lines that are forced / op-logged every time
+    const long long now = (long long)std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+    char k[32];
+    std::snprintf(k, sizeof(k), "%d/%d|", board, port);
+    const std::string key = std::string(k) + (what ? what : "") + "|" + (verdict ? verdict : "") + "|" + why;
+    std::map<std::string, W906SayRep>::iterator it = s_w906SayRep.find(key);
+    if (it == s_w906SayRep.end()) {
+        if (s_w906SayRep.size() > 4000) s_w906SayRep.clear();
+        W906SayRep r; r.lastMs = now; r.suppressed = 0;
+        s_w906SayRep.insert(std::make_pair(key, r));
+        return false;
+    }
+    if (now - it->second.lastMs < 5000) { ++it->second.suppressed; ++s_stats.linesDropped; return true; }
+    if (it->second.suppressed != 0) {
+        char b[160];
+        std::snprintf(b, sizeof(b), "st %d ax %d: +%lu identical lines suppressed in the last %lld ms (AI W906-SAYTHROTTLE)", board, port,
+                      it->second.suppressed, now - it->second.lastMs);
+        if (::g_W906RouteNote) ::g_W906RouteNote(b);
+        std::printf("engine motor -> 1203: %s\n", b);
+    }
+    it->second.lastMs = now;
+    it->second.suppressed = 0;
+    return false;
+}
+}  // namespace
+void W906_SayRepeatReset_() { s_w906SayRep.clear(); }   // Pci1203MotorRouteResetForTest
+}  // namespace ht9045
