+        if ($a[3] -ne $vc8Spelling) { continue }
+        $sites++
+        if ($a[1] -ne '(U16)v.ring' -or $a[2] -ne '(U16)v.addr') { $bad += (":" + ($i + 1) + " ring/station are '" + $a[1] + "', '" + $a[2] + "' -- must be (U16)v.ring, (U16)v.addr") }
+        if ($a[4] -ne '0x02' -and $a[4] -ne '0x13') { $bad += (":" + ($i + 1) + " subindex '" + $a[4] + "' -- must be the literal 0x02 or 0x13") }
