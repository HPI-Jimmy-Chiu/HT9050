+    if (n) *n = (int)(sizeof(k) / sizeof(k[0]));
+    return k;
+}
+inline int W906_VuSetAllTag(const char* arm)
+{
+    int n = 0;
+    const TVuSetAllArm* k = W906_VuSetAllArms(&n);
+    for (int i = 0; arm && i < n; ++i)
+        if (std::strcmp(k[i].arm, arm) == 0) return k[i].tag;
