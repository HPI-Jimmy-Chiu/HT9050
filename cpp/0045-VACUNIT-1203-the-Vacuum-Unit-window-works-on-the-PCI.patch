+struct VuLiveRef_ { TMyVacuumPanel* p; int arm; int col; int row; };
+VuLiveRef_    g_vu[4 * TOTAL_VACUUM_UNIT * 2];   // at most 8+8 Index + 4+4 In/Out columns, 2 rows
