 #include "forms/fDTME08.h"         //AI(W906-I03) 20261002 (Ifor01): G29 opened, frmDTME08 is ported (I-03 phase 2); the NOT-included list goes on: uTemp_Set.h / cConfiguration.h / HS_Function.h / ProductionInfo.h /
 //   uLotInfo.h  -- unported; every symbol they supplied is gated (G02, G03, G14,
 //   G15-G18, G19, G25, G26, G27, G28, G29) or mirrored below.
@@ -1333,6 +1334,74 @@ void DoThermo()
 //---------------------------------------------------------------------------
 TQPF_Timer tThermoAlarmTimer;
 //---------------------------------------------------------------------------
+//AI(W906-I03b) 20261005 (Ifor01): the DTM transport of a channel the DTM channel map serves (EJ1N/DtmChannelMap.h; NEW
+//  DESIGN, docs/I03B_HT9050_DTM_CHANNEL_MAP.md option A, Ifor 1005 13:4x).  DoThermoReal case 100 has computed Temp exactly
+//  as golden's serial path (staged Hotplate / Shuttle heating, DUT fixed temperature, heat modes, ...); only the serial
+//  write / read and their reply cases (200 / 250 / 255 / 2500) are replaced -- the same place V912 switches the protocol per
+//  channel (V912 bthermo.cpp:2520-2595 IsValEqual_HeaterInsOpt(Addr, ...)).
+//  * SV: golden's write-branch bookkeeping when Temp changed (HeaterSVLog + OldTemp + ClearHotBuffer, this file's
+//    `if(Temp!=OldTemp[Addr] ...)` branch, golden :2334-2370), then the DTM panel's setting SV on EVERY visit, so the panel
+//    converges whatever the DTM did meanwhile (golden's own DTM writer DoSetSVOfDTME08 also pushes on every pass).
+//    An unarmed channel (HT9050 SLK-1..8, wiring order not confirmed) always gets 0 = heater off.
+//  * PV: the panel's PV (the DTM cycle reads it), stored as golden case 2500 does (Delta DTK4848, golden :2798 on; this
+//    file's case 2500).  Not installed -> no read (golden's read branch goes to case 300).  The DTM not connected for more
+//    than 5 visits -> 999 + UN150CommError, as case 2500's CommunCTErr>5.
+//  The caller goes to case 300 (next channel): nothing waits for a serial reply.
+static void W906_DtmMapExchange(int Addr, double Temp, double& dOldTemp, int& iCommErr)
+{
+    const int iCh=DtmMap_ChannelOf(Addr);
+    if(Temp!=dOldTemp)
+    {
+        HeaterSVLog(Addr, Temp);
+        dOldTemp=Temp;
+        ClearHotBuffer(Addr);
+    }
+    const bool bForm=(frmDTME08!=NULL && frmDTME08->W906_Control()!=NULL);
+    if(bForm)
+        frmDTME08->W906_DtmMapSetSV(iCh, DtmMap_ArmedCh(iCh) ? Temp : 0.0);
+    if(bUT150Install[Addr]==false)
+        return;
+    if(!bForm || !frmDTME08->W906_DtmConnected())
+    {
+        iCommErr++;
+        if(iCommErr>5)
+        {
+            UN150CommError[Addr]=true;
+            UN150Read[Addr]=999;
+        }
+        return;
+    }
+    const double Read=frmDTME08->GetPalGroup(iCh)->GetPV();
+    UN150CommError[Addr]=false;
+    iCommErr=0;
+    UN150ReadReal[Addr]=Read;
+    // golden case 2500 from here (this file's case 2500, the block after `UN150ReadReal[Addr]=Read;`), verbatim
+    if(Addr==tcCCD || (RTC_TemperNumber==2 && Addr==tcCCD_2))
+    {
+        dCCDTemperature=Read;
+        UN150Read[Addr]=ReadAverageBuffer(Addr, Read);
+    }
+    else if(Addr==tcChamber)
+    {
+        UN150Read[Addr]=Read;
+    }
+    else
+    {
+        if(Tri_Temp_Machine==1)
+        {
+            UN150Read[Addr]=Read-Temperature.fTempOffSet[UserOffSet][Addr];
+        }
+        else if(LastSet.iTemperature!=Tempture_Hot)
+        {
+            UN150Read[Addr]=GetConvertTemp(Addr, Read)-SHUTTLE_COOLING;
+        }
+        else
+        {
+            UN150Read[Addr]=ReadAverageBuffer(Addr, GetConvertTemp(Addr, Read));
+        }
+    }
+}
