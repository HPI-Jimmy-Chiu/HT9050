+    if (leaving) {                                                              //AI(W906-HOME-STEPLEAVE) 20261003
+        AckHead(w, r, "homing", "pci1203", "步進軸在原點上：先往回原點的反方向移 1000（最多 3 次），離開原點後才開始回原點（EastSun 1003 規則）");
+        w.Key("homeActive").Bool(true);
