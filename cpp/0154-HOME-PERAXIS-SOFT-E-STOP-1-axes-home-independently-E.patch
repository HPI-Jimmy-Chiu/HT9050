+// alarm stops the machine (note.cpp:795-801 StopAllMotor(true); SoftStop=SoftStart=SystemStart=false -- tools/wb_serve.cpp
+// W906_AlarmStopLikeGolden) plus the 1203 half golden's StopAllMotor cannot reach (W906_MotorAccessOnAlarm: every opened 1203 axis gets
+// the stop, every Teach / Motor Test job ends), and a running full HOME is aborted the way the panel PAUSE does it (golden
+// TfHome::ScanKey uhome.cpp:4878-4882: sbAbortHomeClick + Close).  Queued soft keys are dropped (nothing may fire after a stop).
+void W906_SoftEmergencyStop(std::string& why)
+{
+    extern void StopAllMotor(bool bIndexCanStop);                               // Motor/myGALILmotor.cpp (golden :4712)
+    extern void W906_MotorAccessOnAlarm(const char* code);                      // WebMotorAccessLive.cpp (1203 axes + jobs)
+    s_softKeys.clear();
+    StopAllMotor(true);                                                         // golden note.cpp:796
+    W906_MotorAccessOnAlarm("SOFT-ESTOP");
+    SoftStop    = false;                                                        // golden note.cpp:799
+    SoftStart   = false;                                                        // golden note.cpp:800
+    SystemStart = false;                                                        // golden note.cpp:801
+    bool homeAborted = false;
+    if (fHome && fHome->fShow) { fHome->sbAbortHomeClick(fHome); fHome->Close(); homeAborted = true; }   // golden uhome.cpp:4880-4881
+    RecordProcess("W906 SOFTKEY: EMERGENCY STOP pressed on the screen", homeAborted ? "home aborted" : "");
+    std::printf("[SOFTKEY] EMERGENCY STOP: StopAllMotor(true) + every 1203 axis stopped; SoftStop=SoftStart=SystemStart=0%s\n",
+                homeAborted ? "; full HOME aborted" : "");
+    why = std::string("緊急停止：所有馬達已送停止（含 1203 全軸）、運轉旗標已清") + (homeAborted ? "、回原點已中止" : "") +
+          "。⚠ 這是軟體停止，不是硬體急停迴路";
+}
