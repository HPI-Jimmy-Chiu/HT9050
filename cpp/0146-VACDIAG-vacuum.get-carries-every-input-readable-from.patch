From 9868761f144a4f8c65b131826710358f41a88ed9 Mon Sep 17 00:00:00 2001
From: "HT9045 Machine (V906)" <Claude_RDBC_02@honprec.com>
Date: Sat, 3 Oct 2026 11:37:52 +0800
Subject: [PATCH] VACDIAG: vacuum.get carries every input readable from each
 vacuum station (raw process-image bytes 0..15, each pair as kPa = VC n, OK
 bits DI 64..71 / 128..135) -- EastSun 1003 'panel G never changes ... list
 every readable position on top'

---
 FileRW/TestIF_File_VacuumUnit.cpp | 32 +++++++++++++++++++++++++++++++
 1 file changed, 32 insertions(+)

diff --git a/FileRW/TestIF_File_VacuumUnit.cpp b/FileRW/TestIF_File_VacuumUnit.cpp
index d721b20..7e3f0ed 100644
--- a/FileRW/TestIF_File_VacuumUnit.cpp
+++ b/FileRW/TestIF_File_VacuumUnit.cpp
@@ -164,6 +164,7 @@ const char* FileRW_VacuumUnit_WindowEdge(bool open)
 // ===========================================================================
 #include "VacuumUnit/VacuumUnitLive.h"
 #include "VacuumUnit/Vc8Route.h"
+#include "cpublic.h"                   //AI(W906-VACDIAG) 20261003: VC8ToKpa (the stations' raw-input diagnostic)
 #include "EtherCAT/Pci1203Control.h"
 #include "WebBridge/JsonWriter.h"
 #include "Public/cJSON.h"
@@ -322,6 +323,37 @@ void VuSnapshot_(webbridge::JsonWriter& j)
         j.Key("vc8").Bool(st[k].readOk);
         j.Key("writable").Bool(st[k].writeOk);
         j.Key("why").String(st[k].writeOk ? std::string() : st[k].writeWhy);
+        //AI(W906-VACDIAG) 20261003: EastSun「我G的數值 都不會變動 … 不然幫我可讀取的位置數值 都列出來顯示在上面」-- every input the
+        //  page can read from this station, raw: process-image bytes 0..15 (Vc8ReadAi; a VC4 answers 0..7, the rest refused = null),
+        //  each pair as golden ReadVaccumCurrect computes it (MyLaneIo.cpp:808-818: hi*256+lo -> VC8ToKpa; pair n = VC n), and the
+        //  OK bits DI 64..71 (VC4) / 128..135 (VC8). Read-only (the route's per-poll monitor sample, no vendor call of its own).
+        if (st[k].readOk) {
+            int raw[16];
+            j.Key("raw").BeginArray();
+            for (int b = 0; b < 16; ++b) {
+                unsigned char v = 0;
+                raw[b] = (W906_Vc8ReadAi(st[k].ring, st[k].ip, b, &v) == 0) ? (int)v : -1;
+                if (raw[b] < 0) j.Null(); else j.Number((wb_int64)raw[b]);
+            }
+            j.EndArray();
+            j.Key("kpa").BeginArray();
+            for (int p = 0; p < 8; ++p) {
+                if (raw[p * 2] < 0 || raw[p * 2 + 1] < 0) { j.Null(); continue; }
+                char kb[24]; std::snprintf(kb, sizeof(kb), "%.1f", VC8ToKpa(raw[p * 2 + 1] * 256 + raw[p * 2]));
+                j.String(kb);
+            }
+            j.EndArray();
+            j.Key("okBits").BeginArray();
+            const int okFirst[2] = { 64, 128 };
+            for (int g = 0; g < 2; ++g)
+                for (int c = 0; c < 8; ++c) {
+                    unsigned char v = 0;
+                    j.BeginObject(); j.Key("ch").Number((wb_int64)(okFirst[g] + c));
+                    j.Key("v"); if (W906_Vc8ReadDi(st[k].ring, st[k].ip, okFirst[g] + c, &v) == 0) j.Number((wb_int64)v); else j.Null();
+                    j.EndObject();
+                }
+            j.EndArray();
+        }
         j.EndObject();
     }
     j.EndArray();
-- 
