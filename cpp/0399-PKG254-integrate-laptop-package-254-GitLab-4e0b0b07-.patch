+//---------------------------------------------------------------------------
+//AI(ht9045-auto-temp-offset) 20260909 (RogerYang) : NN_1Row(2x2N/2x3N/2x4N) 的 site -> 加熱頭對照
+//  三個 NN 分支原本都回 iTempKit0_Arm1 / iTempKit0_Arm2, 但那兩個變數只在下方「非 NN」的通用
+//  迴圈才被賦值, NN 分支走不到, 因此永遠回宣告初值 0(=tcHotPlate1) 且完全忽略 iSite。
+//  0 不落在 tcAa1~tcBd2 / tcAe1~tcBh2, 使 SaveRemoteTempOffset() 的 head 範圍判斷不成立,
+//  而該層沒有 else, 於是不寫入也不記 log, 造成 NN mode 的 N31 FTP / SECS / GPIB 溫度 offset 全失效。
+//  對應關係與下方填 asTempArmOrder 的那幾行完全一致 : Arm1 對應 row1(下排), Arm2 對應 row0(上排)。
+//  iColCount     : 該模式的欄數 (2x2N=2, 2x3N=3, 2x4N=4)
+//  iHeadSplitCol : 非 16/32 加熱器機型時, 欄 < 此值用第一顆 head, 其餘用第二顆 (2x2N=1, 2x3N=2, 2x4N=2)
+//  該 site 不屬於這支 arm 時回 -1, 讓 SaveRemoteTempOffset() 走既有的 channel is -1 log。
+// AI(W906-L08) 20261010 (Ifor01) (L08): golden 913 Command.cpp:86-153 word for word; golden has it right above RefreshTempData, here at the end of
+//   the file (forward declaration next to asTempArmOrder) so no line moves.
+//---------------------------------------------------------------------------
+static int GetNNHeadBySite(int iArm, int iSite, int iColCount, int iHeadSplitCol)
+{
+    if(iArm<1 || iArm>2 || iSite<=0 || iColCount<1 || iColCount>4)
+        return -1;
+
+    int iRow=(iArm==1)?1:0;
+    int iFindCol=-1;
+    for(int c=0; c<iColCount; c++)
+    {
+        if(TestIF_File.iSiteMap[iRow][c]==iSite)
+        {
+            iFindCol=c;
+            break;
+        }
+    }
+
+    if(iFindCol<0)
+        return -1;
+
+    if(USE_16_HEATER==eht16Heater       ||
+       USE_16_HEATER==eht16HeaterEJ1N   ||
+       USE_16_HEATER==eht32HeaterEJ1N   ||
+       USE_16_HEATER==eht32HeaterKT4H   ||
+       USE_16_HEATER==eht16HeaterDTME08 ||
+       USE_16_HEATER==eht32HeaterDTME08 )
+    {
+        if(iArm==1)
+        {
+            if(iFindCol==0)
+                return tcAa1;
+            else if(iFindCol==1)
+                return tcAb1;
+            else if(iFindCol==2)
+                return tcAc1;
+            else
+                return tcAd1;
+        }
+        else
+        {
+            if(iFindCol==0)
+                return tcAa2;
+            else if(iFindCol==1)
+                return tcAb2;
+            else if(iFindCol==2)
+                return tcAc2;
+            else
+                return tcAd2;
+        }
+    }
+    else
+    {
+        if(iArm==1)
+            return (iFindCol<iHeadSplitCol)?tcHead1:tcHead2;
+        else
+            return (iFindCol<iHeadSplitCol)?tcHead3:tcHead4;
+    }
+}
