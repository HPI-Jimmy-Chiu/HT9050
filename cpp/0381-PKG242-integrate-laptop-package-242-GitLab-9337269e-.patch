 void W906_StartConditionTimer1Tick();       // AI(W906-W208) 20261009 (Ifor01): golden 913 main.cpp:3278 `fStartCondition->UpdateCylinderScreen();` -- called from tools/wb_serve.cpp: main loop right after W906_MainRecordTimer1Tick, W906_ModalWaitTick right after W906_ModalTimer1Segments
 // (these two lines were: "integration-pending -- NO extern here", AI(W906-FW3-StartCond-WA) 20260819; retired by W-208)
 
+// AI(W906-W208) 20261009 (Ifor01) -- the Cylinder page backend, step-wise like FileRW/CfgTrayPlate.cpp:349 (no modal wait on the tick thread).
+//   golden: click a cell (OnSelectCell :1626 decides which of the 7 pmCylinder items shows), right-click, pick the item: all 7 run
+//   mniResetOnOffCountClick (:1495), which asks YES/NO (Reset Count) or opens the keypad (the four "Set ... alarm"), or acts at once
+//   (the two "Set ... standard").  Here: step 0 = W906_SC_CylinderMenuProbe (what the click would ask; changes nothing),
+//   step 1 = W906_SC_CylinderMenuAnswer (the same click with the operator's answer).  The web page itself is a separate card.
+struct W906CylPrompt
+{
+    int        item;          // the pmCylinder item OnSelectCell made visible: 0 Reset Count, 1 on/off count alarm, 2 on time alarm,
+                             //   3 off time alarm, 4 time out count alarm, 5 on time standard, 6 off time standard; -1 = none
+    int        kind;          // 0 = no question (the click acts at once), 1 = YES/NO, 2 = keypad
+    AnsiString sEn, sCh;      // kind 1: golden's two texts
+    int        iFunction, iDP;   // kind 2: golden's ShowQwertyKey arguments ...
+    bool       bCheckRange;
+    double     min, max;
+    AnsiString current;       // ... and the box text the keypad opens with
+};
+bool W906_SC_CylinderMenuProbe(int ACol, int ARow, W906CylPrompt *out);   // step 0: false = no item for that cell
+bool W906_SC_CylinderMenuAnswer(int ACol, int ARow, bool yes, const char *text, bool cancel);   // step 1: false = no item / keypad text refused
+
 #endif // FORMS_FSTARTCONDITION_H
