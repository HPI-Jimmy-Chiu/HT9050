+    InArmSiteMapData.UpdateData(1, 2, 3, 0, 1);
+    bAutoSiteMapHotplateSave = true; bAutoSiteMapHasPickHP = true; iResetSiteMappingStep = 1; ExString = "";
+    W906_AsmHomeReleaseBorrow_St02();
