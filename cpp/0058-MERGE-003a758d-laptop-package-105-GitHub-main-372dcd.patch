+// ===========================================================================
+//  AI(W906-H008) 20261001 (St02-E): POLLED mode for TClientSocket -- H-008, the Handler's TCP/IP tester channel
+//  (golden TfTesterTCP ClientSocket_TCPIP, ClientType = ctNonBlocking: golden 906_0625_Steven
+//  Interface/TesterTCP.dfm:2936-2943).  Additive and OFF by default: Sim, and the thread-per-connection Real mode
+//  above, behave exactly as before unless the owner calls SetPolled(true).  Same shape as TServerSocket's POLLED mode
+//  (ServerSocket.cpp, W10).
+//
+//  Why: the Real mode above connects synchronously (::connect on a blocking socket) on the caller's thread, fires no
+//  OnDisconnect when the peer closes (and keeps the handle until the next connect), and drops a recv error silently.
+//  Golden's VCL socket was non-blocking: Open() returned at once, and the connect / read / close came back as window
+//  messages on the main thread.  Polled mode does the same with no thread: Open() starts a non-blocking connect and
+//  returns; Poll(), called by the owner on ITS thread (every tick), finishes it and fires the events right there.
+//
+//  Contract
+//    SetPolled(true) + SetSimMode(false)  Open() / Active=true start a non-blocking connect and return at once.
+//                                         Active stays false until Poll() sees the connect finish (VCL sets Active on
+//                                         the connect event).  Open() while a connect is pending does nothing.
+//    Poll(), connecting                   connected -> OnConnect.  Failed (refused, unreachable, the OS timeout) ->
+//                                         handle closed, OnError(eeConnect, WSA code).  An Open() that fails at once
+//                                         (no socket, bad address) reports the same OnError from the next Poll().
+//    Poll(), connected                    non-blocking recv into the receive queue (at most kW906CPolledQueueCap bytes
+//                                         wait; TCP flow control holds the rest), then OnRead once.  Peer closed ->
+//                                         Close(): handle closed, OnDisconnect.  A recv error -> OnError(eeReceive,
+//                                         code), then Close() unless the handler already closed it.
+//    Close() / Active=false               closes a pending or live handle; OnDisconnect only if it was connected.
+//    SendBuf / SendText                   the Real path above on a non-blocking socket: never blocks (a full send
+//                                         buffer returns -1 / a short count, like VCL ctNonBlocking).
+//    Send error                           DEVIATION: VCL fired OnError(eeSend) and disconnected on a send error
+//                                         [inferred]; here SendBuf only returns -1.  The next Poll()'s recv sees the
+//                                         reset -> OnError(eeReceive) -> Close(): the same end state one tick later
+//                                         (golden's handler ignores ErrorEvent, TesterTCP.cpp:615-633).
+//    SetPolled(true), Sim                 nothing changes: Open() is the Sim connect above; Poll() does nothing.
+//    Threads                              Open / Close / Poll / SendBuf on ONE thread (the owner's).  No reader thread.
+//    Name lookup                          a non-numeric Address still resolves with gethostbyname (blocking), as the
+//                                         Real path above; golden's TesterIF Address is an IP (cTesterIF.cpp:778).
+// ===========================================================================
+namespace Scktcomp {
+
+static const int kW906CPolledQueueCap = 64 * 1024;
+
+struct W906CPollState_ {
+    bool bPolled;
+    bool bConnecting;    // a non-blocking connect is pending on Socket->pImpl_->sock
+    int  pendingError;   // an Open() that failed at once: reported by the next Poll()
+    W906CPollState_() : bPolled(false), bConnecting(false), pendingError(0) {}
+};
+
+static void W906CPollStateDelete_(W906CPollState_* p) { delete p; }
+
+static W906CPollState_& W906CPollOf_(W906CPollState_*& p)
+{
+    if (p == 0)
+        p = new W906CPollState_();
+    return *p;
+}
+
+void TClientSocket::SetPolled(bool bPolled) { W906CPollOf_(pImpl_->pPoll).bPolled = bPolled; }
+bool TClientSocket::IsPolled() const        { return pImpl_->pPoll != 0 && pImpl_->pPoll->bPolled; }
+
+// DoConnect_'s first step.  true = handled here; false = not polled-Real -> DoConnect_'s original paths, unchanged.
+bool TClientSocket::PolledConnect_()
+{
+    W906CPollState_* ps = pImpl_->pPoll;
+    if (ps == 0 || !ps->bPolled || Socket->pImpl_->bSim)
+        return false;
+#if defined(_WIN32)
+    if (Socket->pImpl_->bConnected || ps->bConnecting)
+        return true;                                   // connected, or a connect is pending: nothing to do
+    ps->pendingError = 0;
+    if (!EnsureWinsockInit_())
+    {
+        ps->pendingError = WSANOTINITIALISED;
+        return true;
+    }
+    SOCKET s = ::socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
+    if (s == INVALID_SOCKET)
+    {
+        ps->pendingError = ::WSAGetLastError();
+        return true;
+    }
+    sockaddr_in addr;
+    std::memset(&addr, 0, sizeof(addr));
+    addr.sin_family = AF_INET;
+    addr.sin_port   = ::htons(static_cast<u_short>(Port));
+    addr.sin_addr.s_addr = ::inet_addr(Address.c_str());
+    if (addr.sin_addr.s_addr == INADDR_NONE)
+    {
+        struct hostent* he = ::gethostbyname(Address.c_str());   // see "Name lookup" above
+        if (he == 0 || he->h_length != sizeof(addr.sin_addr))
+        {
+            ps->pendingError = WSAHOST_NOT_FOUND;
+            ::closesocket(s);
+            return true;
+        }
+        std::memcpy(&addr.sin_addr, he->h_addr, sizeof(addr.sin_addr));
+    }
+    u_long nb = 1;
+    if (::ioctlsocket(s, FIONBIO, &nb) != 0)
+    {
+        ps->pendingError = ::WSAGetLastError();
+        ::closesocket(s);
+        return true;
+    }
+    if (::connect(s, reinterpret_cast<sockaddr*>(&addr), sizeof(addr)) != 0)
+    {
+        const int e = ::WSAGetLastError();
+        if (e != WSAEWOULDBLOCK)
+        {
+            ps->pendingError = e;
+            ::closesocket(s);
+            return true;
+        }
+    }
+    Socket->pImpl_->sock = s;          // connect() == 0 (loopback can finish at once) is finished by Poll() too,
+    ps->bConnecting = true;            // so OnConnect always comes from Poll(), never from inside Open()
+    return true;
+#else
+    return false;                      // no WinSock: DoConnect_'s original paths (as PolledClose_ below)
+#endif
+}
+
+// DoClose_'s first step.  true = handled here; false = not polled-Real -> DoClose_'s original paths, unchanged.
+bool TClientSocket::PolledClose_()
+{
+    W906CPollState_* ps = pImpl_->pPoll;
+    if (ps == 0 || !ps->bPolled || Socket->pImpl_->bSim)
+        return false;
+#if defined(_WIN32)
+    const bool wasConnected = Socket->pImpl_->bConnected;
+    ps->bConnecting  = false;
+    ps->pendingError = 0;
+    if (Socket->pImpl_->sock != INVALID_SOCKET)
+    {
+        ::closesocket(Socket->pImpl_->sock);
+        Socket->pImpl_->sock = INVALID_SOCKET;
+    }
+    Socket->pImpl_->bConnected = false;
+    Socket->Connected = false;
+    Socket->pImpl_->bSim = pImpl_->bSimRequested;   // as DoClose_ above
+    if (wasConnected && OnDisconnect)
+        OnDisconnect(this, Socket);
+    return true;
+#else
+    return false;
+#endif
+}
+
+int TClientSocket::Poll()
+{
+    W906CPollState_* ps = pImpl_->pPoll;
+    if (ps == 0 || !ps->bPolled || Socket->pImpl_->bSim)
+        return 0;
+    int events = 0;
+#if defined(_WIN32)
+    if (ps->pendingError != 0)
+    {
+        int code = ps->pendingError;
+        ps->pendingError = 0;
+        if (OnError)
+            OnError(this, Socket, eeConnect, code);
+        return 1;
+    }
+    if (ps->bConnecting)
+    {
+        const SOCKET s = Socket->pImpl_->sock;
+        fd_set w, x;
+        FD_ZERO(&w);
+        FD_ZERO(&x);
+        FD_SET(s, &w);
+        FD_SET(s, &x);
+        timeval tv;
+        tv.tv_sec  = 0;
+        tv.tv_usec = 0;
+        const int r = ::select(0, 0, &w, &x, &tv);
+        if (r == 0)
+            return 0;                                  // still connecting
+        int err = 0;
+        if (r == SOCKET_ERROR)
+            err = ::WSAGetLastError();
+        else if (FD_ISSET(s, &x) || !FD_ISSET(s, &w))
+        {
+            int len = sizeof(err);
+            ::getsockopt(s, SOL_SOCKET, SO_ERROR, reinterpret_cast<char*>(&err), &len);
+            if (err == 0)
+                err = WSAECONNREFUSED;
+        }
+        ps->bConnecting = false;
+        if (err != 0)
+        {
+            ::closesocket(s);
+            Socket->pImpl_->sock = INVALID_SOCKET;
+            Socket->pImpl_->bSim = pImpl_->bSimRequested;
+            int code = err;
+            if (OnError)
+                OnError(this, Socket, eeConnect, code);
+            return 1;
+        }
+        Socket->pImpl_->bConnected = true;
+        Socket->RemotePort = Port;
+        Socket->Connected  = true;
+        ++events;
+        if (OnConnect)
+            OnConnect(this, Socket);
+    }
+    if (!Socket->pImpl_->bConnected || Socket->pImpl_->sock == INVALID_SOCKET)
+        return events;                                 // not connected, or a handler closed it
+    const SOCKET s = Socket->pImpl_->sock;
+    std::vector<char> got;
+    bool closed = false;
+    int err = 0;
+    char buf[4096];
+    for (;;)
+    {
+        const int room = kW906CPolledQueueCap - Socket->ReceiveLength() - static_cast<int>(got.size());
+        if (room <= 0)
+            break;                                     // queue full: leave the rest in the OS buffer
+        const int want = room < static_cast<int>(sizeof(buf)) ? room : static_cast<int>(sizeof(buf));
+        const int n = ::recv(s, buf, want, 0);
+        if (n > 0)
+        {
+            got.insert(got.end(), buf, buf + n);
+            continue;
+        }
+        if (n == 0)
+        {
+            closed = true;                             // peer closed
+            break;
+        }
+        const int e = ::WSAGetLastError();
+        if (e != WSAEWOULDBLOCK)
+        {
+            err = e;
+            closed = true;
+        }
+        break;
+    }
+    if (!got.empty())
+    {
+        Socket->SimPushReceive(&got[0], static_cast<int>(got.size()));   // -> OnRead(this, Socket), on this thread
+        ++events;
+    }
+    if (closed && Socket->pImpl_->bConnected && Socket->pImpl_->sock == s)
+    {
+        if (err != 0 && OnError)
+        {
+            int code = err;
+            OnError(this, Socket, eeReceive, code);   // golden TesterTCP.cpp:615-633 closes the socket itself
+        }
+        if (Socket->pImpl_->bConnected && Socket->pImpl_->sock == s)
+            DoClose_();                                // -> PolledClose_: closesocket + OnDisconnect
+        ++events;
+    }
+#endif
+    return events;
+}
+
+} // namespace Scktcomp
