+// =============================================================================
+//  P  AI(W906-PARAMSYNC) 20261007: EastSun「有時候根本還沒寫進去」. A fake card that behaves like the real one on ceilings
+//     (measured 1007: PAR_AxAcc above CFG_AxMaxAcc -> 0x80000013, Dec -> 14, VelLow / VelHigh above CFG_AxMaxVel -> 11 / 12),
+//     driven through the REAL route (R()->call -> RouteCall -> SetSpeedParam). The plain FakeEnv above accepts everything, so no
+//     ceiling test could ever fail there. Numbers = MInArmX on 1007: boot left CFG_AxMaxAcc 1000 (1 %), HOME pushed Acc 91000.
+// =============================================================================
+namespace ht9045 { std::string Pci1203MotorRouteSpeedVerify(int* okN, int* badN, int* unverN); }
+class CeilingEnv : public FakeEnv {
+public:
+    Pci1203CmdResult Execute(const Pci1203Cmd& c) override
+    {
+        Pci1203CmdResult r = FakeEnv::Execute(c);
+        if (c.kind != kCmdAxSetSpeed || !r.issued || c.axis < 0 || c.axis >= (int)axes.size()) return r;
+        Pci1203AxisSample& a = axes[(std::size_t)c.axis];
+        const int s = (int)c.speed;
+        double cap = -1.0; unsigned long code = 0;   // a ceiling this fake was never given (speedValid false) = no limit
+        if ((s == (int)kSpeedAcc || s == (int)kSpeedJogAcc) && a.speedValid[kSpeedMaxAcc]) { cap = a.speed[kSpeedMaxAcc]; code = 0x80000013ul; }
+        if ((s == (int)kSpeedDec || s == (int)kSpeedJogDec) && a.speedValid[kSpeedMaxDec]) { cap = a.speed[kSpeedMaxDec]; code = 0x80000014ul; }
+        if (s == (int)kSpeedInit && a.speedValid[kSpeedMaxVel]) { cap = a.speed[kSpeedMaxVel]; code = 0x80000011ul; }
+        if (s == (int)kSpeedRun  && a.speedValid[kSpeedMaxVel]) { cap = a.speed[kSpeedMaxVel]; code = 0x80000012ul; }
+        if (cap >= 0 && c.value > cap) { r.ret = code; return r; }   // the card refuses, nothing changes on it
+        a.speed[s] = c.value; a.speedValid[s] = true;                 // accepted: the monitor reads it back
+        return r;
+    }
+};
+void test_paramsync_ceiling()
+{
+    CeilingEnv e; Fresh(e);
+    e.axes.reserve(4);                                                         // AddAxis below must not move the sample `a` refers to
+    const int k = e.AddAxis(5, 0); e.AddSlave(5, true);
+    CHECK(R()->bind(5, 0, 50, false));
+    Pci1203AxisSample& a = e.axes[(std::size_t)k];
+    a.speed[kSpeedMaxAcc] = 1000.0;  a.speedValid[kSpeedMaxAcc] = true;   // boot InitMotor at 1 %
+    a.speed[kSpeedMaxDec] = 1000.0;  a.speedValid[kSpeedMaxDec] = true;
+    a.speed[kSpeedMaxVel] = 10000.0; a.speedValid[kSpeedMaxVel] = true;   // JogHighSpeed
+    e.poll++;
+    const unsigned long failed0 = Pci1203MotorRouteStatsNow().failed;
+    std::size_t n0 = e.sent.size();
+    CHECK(Call(5, 0, kEcSetSpeed, kEcSpdAcc, 91000.0) == 0ul);                 // P1: raised first, then written
+    CHECK(e.sent.size() == n0 + 2 && e.sent[n0].speed == kSpeedMaxAcc && e.sent[n0].value == 91000.0 &&
+          e.sent[n0 + 1].speed == kSpeedAcc && e.sent[n0 + 1].value == 91000.0);
+    CHECK(Call(5, 0, kEcSetSpeed, kEcSpdDec, 91000.0) == 0ul);
+    CHECK(a.speed[kSpeedAcc] == 91000.0 && a.speed[kSpeedDec] == 91000.0 && a.speed[kSpeedMaxDec] == 91000.0);
+    CHECK(Pci1203MotorRouteStatsNow().failed == failed0);                      // P2: today's 0x80000013/14 lines -> none
+    n0 = e.sent.size();
+    CHECK(Call(5, 0, kEcSetSpeed, kEcSpdAcc, 500.0) == 0ul);                   // P3: below the ceiling: no raise, never lowered
+    CHECK(e.sent.size() == n0 + 1 && e.sent[n0].speed == kSpeedAcc && a.speed[kSpeedMaxAcc] == 91000.0);
+    n0 = e.sent.size();
+    CHECK(Call(5, 0, kEcSetSpeed, kEcSpdRun, 40000.0) == 0x80000012ul);        // P4: velocity ceiling NOT raised (ruling 1007:
+    CHECK(e.sent.size() == n0 + 1 && a.speed[kSpeedMaxVel] == 10000.0);        //     InitSpeed > JogHigh is fixed in Mot_Table)
+    CHECK(Pci1203MotorRouteStatsNow().failed == failed0 + 1);
+    // P5: unknown ceiling -> written as before (no raise invented)
+    const int k2 = e.AddAxis(6, 0); e.AddSlave(6, true);
+    CHECK(R()->bind(6, 0, 60, false));
+    n0 = e.sent.size();
+    Call(6, 0, kEcSetSpeed, kEcSpdAcc, 7000.0);
+    CHECK(e.sent.size() == n0 + 1 && e.sent[n0].speed == kSpeedAcc && e.axes[(std::size_t)k2].speed[kSpeedAcc] == 7000.0);
+    // P6: read-back verify -- a fresh sample after the writes
+    e.poll++;
+    int ok = 0, bad = 0, unv = 0;
+    std::string items = Pci1203MotorRouteSpeedVerify(&ok, &bad, &unv);
+    CHECK(bad == 0 && ok >= 5 && items.empty());
+    a.speed[kSpeedDec] = 1234.0;                                               // the card holds something else
+    items = Pci1203MotorRouteSpeedVerify(&ok, &bad, &unv);
+    CHECK(bad == 1 && items.find("st 5 ax 0 Dec want 91000 card 1234") != std::string::npos);
+    Call(5, 0, kEcSetSpeed, kEcSpdDec, 91000.0);                              // a write just now, no newer sample: unverified, not ok
+    items = Pci1203MotorRouteSpeedVerify(&ok, &bad, &unv);
+    CHECK(unv > 0 && bad == 0);
+    std::printf("P paramsync ceiling: done\n");
+}
