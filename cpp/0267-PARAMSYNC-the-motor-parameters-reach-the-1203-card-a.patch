@@ -965,3 +966,49 @@ void W906_InstallPci1203MotorRoute()
 }
 //AI(W906-BRAKE-SERVOFIRST) 20261004: NB2-1 task (m) -- see Pci1203MotorRoute.h (NULL unless wb_serve's WebMotorAccessLive installs it)
 void (*W906_Pci1203CmdNote)(const ht9045::Pci1203Cmd& c, const ht9045::Pci1203CmdResult& r) = 0;
+//------------------------------------------------------------------------------
+//AI(W906-PARAMSYNC) 20261007: EastSun「請你開軟體 或是開啟馬達相關畫面都先寫入 圖片上對應馬達的參數 有時候根本還沒寫進去」-- the read-back
+//  half of the parameter sync (WebMotorAccessLive.cpp EOF, W906_ParamSyncTick). For every axis this route has claimed, each speed
+//  parameter whose last write SUCCEEDED (rec.spd / spdOk) is compared with the monitor's read-back (Pci1203AxisSample::speed, read
+//  after every write, Pci1203Monitor.cpp config poll) once a sample newer than the route's last command on the axis exists:
+//      ok   = card == written (|diff| <= 0.5 + 1e-6 * |value|)
+//      bad  = a fresh read-back that differs        -> one "st S ax A <param> want X card Y" item each
+//      unver= no fresh sample / no read-back for it   (reported as unverified, never as ok)
+//  Read only: nothing is written here.
+namespace ht9045 {
+std::string Pci1203MotorRouteSpeedVerify(int* okN, int* badN, int* unverN)
+{
+    static const char* const kNm[13] = { "VelLow", "VelHigh", "Acc", "Dec", "JogVelLow", "JogVelHigh", "JogAcc", "JogDec",
+                                         "Jerk", "JerkFactor", "CFG_AxMaxVel", "CFG_AxMaxAcc", "CFG_AxMaxDec" };
+    int ok = 0, bad = 0, unv = 0;
+    std::string items;
+    Pci1203MotorRouteEnv& e = Env();
+    const unsigned long pc = e.PollCount();
+    for (std::map<long, AxisRec>::const_iterator it = s_axes.begin(); it != s_axes.end(); ++it) {
+        const AxisRec& rec = it->second;
+        if (!rec.claimed) continue;
+        const int board = (int)(it->first / 1000L), port = (int)(it->first % 1000L);
+        int hits = 0, amb = 0;
+        const int slot = Pci1203MotorRouteFindSlot(e, board, port, &hits, &amb);
+        const bool fresh = slot >= 0 && (!rec.haveCmd || pc > rec.lastCmdPoll);
+        for (int q = 0; q < kSpd && q < 13; ++q) {
+            if (!rec.spdOk[q]) continue;
+            if (!fresh) { ++unv; continue; }
+            const Pci1203AxisSample& a = e.Axis(slot);
+            if (!a.valid || !a.speedValid[q]) { ++unv; continue; }
+            const double want = rec.spd[q], card = a.speed[q];
+            const double tol = 0.5 + 1e-6 * (want < 0 ? -want : want);
+            if ((card - want) > tol || (want - card) > tol) {
+                ++bad;
+                char b[160];
+                std::snprintf(b, sizeof(b), "%sst %d ax %d %s want %.0f card %.0f", items.empty() ? "" : "; ", board, port, kNm[q], want, card);
+                items += b;
+            } else ++ok;
+        }
+    }
+    if (okN) *okN = ok;
+    if (badN) *badN = bad;
+    if (unverN) *unverN = unv;
+    return items;
+}
+}  // namespace ht9045
