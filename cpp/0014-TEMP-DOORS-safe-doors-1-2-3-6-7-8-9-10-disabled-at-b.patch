From 0b3344b44064f204d8a4bed37eea1631a166acbd Mon Sep 17 00:00:00 2001
From: "HT9045 Machine (V906)" <Claude_RDBC_02@honprec.com>
Date: Sat, 26 Sep 2026 12:24:09 +0800
Subject: [PATCH 14/14] TEMP-DOORS: safe doors 1,2,3,6,7,8,9,10 disabled at
 boot for motor testing -- TEMPORARY, revert before production
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

EastSun 20260926 (edit by the user, comment "//JerryYang 20260926 安全門還沒好, 暫時MARK掉"): the door wiring is not confirmed yet
(the safety doors go through the safety PLC, 172.16.8.120, point list pending), so InitialSafeDoor() sets Sen[SnSafeDoor1/2/3/6/7/8/9]
.Enable=false after golden enables them, and SnSafeDoor10 in the SAFE_DOOR_AMOUNT==1 arm (this machine). With Enable==false the
door sensors read "not open", so CheckSafeDoorIsClosed never stops the machine for these doors. Jimmy 20260926: "是對的，暫時先這樣",
revert before going live. The heater doors SnHeaterDoor / SnHeaterDoor2 are still enabled by InitialHeaterDoor() (MES1625/MES1626
may still appear). The AI only fixed the typo "fasle" -> false (it did not compile).
REVERT THIS COMMIT before the "opening a door stops the machine" verification and before production (ONSITE_CHECKLIST 7b).

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 cinitial.cpp | 14 +++++++++++++-
 1 file changed, 13 insertions(+), 1 deletion(-)

diff --git a/cinitial.cpp b/cinitial.cpp
index afde9d3..04681cb 100644
--- a/cinitial.cpp
+++ b/cinitial.cpp
@@ -2955,6 +2955,16 @@ void InitialSafeDoor()
     Sen[SnSafeDoor8].Enable=true;
     Sen[SnSafeDoor9].Enable=true;
 
+    Sen[SnSafeDoor1].Enable=false;  //JerryYang 20260926 安全門還沒好, 暫時MARK掉
+    Sen[SnSafeDoor2].Enable=false;
+    Sen[SnSafeDoor3].Enable=false;
+    Sen[SnSafeDoor6].Enable=false;
+    Sen[SnSafeDoor7].Enable=false;
+    Sen[SnSafeDoor8].Enable=false;
+    Sen[SnSafeDoor9].Enable=false;
+
+
+
     if(MachineTypeChoice!=Type_HT7080)                                          //Nickliu 20230321 add 70XX safe door type
     {
         Sen[SnSafeDoor1].Type=1;                                                //JerryYang 20160720 補上安全門不能Disable的漏洞
@@ -2980,7 +2990,7 @@ void InitialSafeDoor()
     {
         Sen[SnSafeDoor4 ].Enable=false;
         Sen[SnSafeDoor5 ].Enable=false;
-        Sen[SnSafeDoor10].Enable=false;
+        Sen[SnSafeDoor10].Enable=false; //JerryYang 20260926 安全門還沒好, 暫時MARK掉
     }
     else if(SAFE_DOOR_AMOUNT==1)                                                //8扇門
     {
@@ -2988,6 +2998,8 @@ void InitialSafeDoor()
         Sen[SnSafeDoor5 ].Enable=false;
         Sen[SnSafeDoor10].Enable=true;
         Sen[SnSafeDoor10].Type=1;
+
+        Sen[SnSafeDoor10].Enable=false; //JerryYang 20260926 安全門還沒好, 暫時MARK掉  //AI(W906-TEMP-DOORS) 20260926: 原寫 fasle（編譯不過），改成 false；本段是上機測試用的暫時關門，上線前要還原
     }
     else if(SAFE_DOOR_AMOUNT==2)                                                //9扇門
     {
