+             readOnly: !!el.readOnly, src: el.getAttribute('data-src'), value: el.value, x: c.x, y: c.y, hitOk: h.ok, hit: h.what,
+             why: why, tabs: chain.map(function (c) { return c.tab ? name(c.tab) : '?'; }) };
+  };
+  T.track = function (id) {
