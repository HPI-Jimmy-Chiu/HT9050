+# ----------------------------------------------------------------------------- the keypad sequences
+SEQS = [('S1', ['1', '2', '3', 'OK'], 'open on v, 1 2 3, OK'),
+        ('S2', ['Del', '4', '5', '6', '-', 'OK'], 'open, Del, 4 5 6, -, OK'),
+        ('S3', ['%', 'OK'], 'open, %, OK'),
+        ('S4', ['Del', '-', '7', '8', '9', 'OK'], 'open, Del, -, 7 8 9, OK (workaround)')]
+RESULTS = []
