+                iN07SecCounter  = 0;
+            }
+        }
+        else                                                                    //already alarming : check ONLY every 10 seconds
+        {
+            iN07SecCounter++;
+            if(iN07SecCounter>=10)
+            {
+                iN07SecCounter = 0;
+                if(HGem->IsConnect()==true)
+                    bN07AlarmActive = false;                                    //link restored -> release
+            }
+        }
+
+        //--- 2. presentation : level / falling edge ---
