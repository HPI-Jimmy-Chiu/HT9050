+{
+    const std::size_t q = u.find(L"port=");
+    if (q != std::wstring::npos && (q == 0 || u[q - 1] == L'?' || u[q - 1] == L'&')) { const int p = F5Digits(u, q + 5); if (p) return p; }
+    if (u.compare(0, 7, L"http://") == 0) {
+        const std::size_t h = 7, slash = u.find(L'/', h), colon = u.find(L':', h);
+        if (colon != std::wstring::npos && (slash == std::wstring::npos || colon < slash)) { const int p = F5Digits(u, colon + 1); if (p) return p; }
+        return 80;
+    }
+    return 8055;                                              // web/boot_wait.html's default port
+}
+std::wstring F5FlagPath(int port)
+{
+    const std::wstring::size_type k = g_logPath.find_last_of(L"\\/");
+    const std::wstring dir = (k == std::wstring::npos) ? std::wstring(L".") : g_logPath.substr(0, k);
+    return dir + L"\\f5_close_" + std::to_wstring(port) + L".flag";
+}
+void F5WriteFlag(int port, const wchar_t* why)
+{
+    const std::wstring path = F5FlagPath(port);
+    HANDLE h = ::CreateFileW(path.c_str(), GENERIC_WRITE, 0, 0, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, 0);
+    if (h == INVALID_HANDLE_VALUE) { Log(L"f5-close: flag NOT written %ls (error %lu)", path.c_str(), ::GetLastError()); return; }
+    SYSTEMTIME t; ::GetLocalTime(&t);
+    char b[512];
+    const int n = std::snprintf(b, sizeof(b), "port=%d pid=%lu time=%04d-%02d-%02d %02d:%02d:%02d why=%ls\r\n", port,
+                                (unsigned long)::GetCurrentProcessId(), t.wYear, t.wMonth, t.wDay, t.wHour, t.wMinute, t.wSecond, why);
+    DWORD w = 0;
+    if (n > 0) ::WriteFile(h, b, (DWORD)std::min(n, (int)sizeof(b) - 1), &w, 0);
+    ::CloseHandle(h);
+    Log(L"f5-close: flag written %ls (%ls)", path.c_str(), why);
+}
+void F5ClearFlag(const std::wstring& url)
+{
+    if (!F5IsBootWait(url)) return;
+    const std::wstring path = F5FlagPath(F5PortOf(url));
+    if (::DeleteFileW(path.c_str())) Log(L"f5-close: flag cleared (a new F5 opened the wait page) %ls", path.c_str());
+}
+std::wstring F5CurrentSource()
+{
+    if (!g_web) return g_url;
+    LPWSTR s = 0;
+    if (FAILED(g_web->get_Source(&s)) || !s) return g_url;
+    const std::wstring r(s);
+    ::CoTaskMemFree(s);
+    return r;
+}
+// the close question was answered YES and the page did not run the main Exit (no "exit"): was it an F5 start being closed?
+void F5OnCloseAnswer(HRESULT e, const std::wstring& r)
+{
+    const std::wstring cur = F5CurrentSource();
+    const std::size_t b = SUCCEEDED(e) ? r.find(L"boot") : std::wstring::npos;
+    if (b != std::wstring::npos) {
+        int p = F5Digits(r, b + 5);
+        if (!p) p = F5PortOf(cur);
+        F5WriteFlag(p, L"the F5 wait page was closed");
+        return;
+    }
+    if (!F5IsBootWait(g_f5SrcAtAsk)) return;                  // the HMI itself: its own answer ("none" = not connected) as before
+    if (!F5IsBootWait(cur) && cur.compare(0, 7, L"http://") == 0) { F5WriteFlag(F5PortOf(cur), L"the wait page switched to the HMI during the close question"); return; }
+    if (FAILED(e) && F5IsBootWait(cur)) F5WriteFlag(F5PortOf(cur), L"the wait page did not answer the close question");
+}
+}  // namespace
