+              SoftStart == false && iHome == 0 && NoRow());                     // refused: no MES2112, nothing armed
+        CHECK(g_homeLockDepth == 0 && g_lockDepth == 0);                         // ADAPTED: no FormLock around HOME (WebMainScanKey.cpp:19)
+        IdleHomed();
+        fAllMotorHome = false;
+        Press(SnFKHome);                                                         // not blocked: golden goes on (= [6])
