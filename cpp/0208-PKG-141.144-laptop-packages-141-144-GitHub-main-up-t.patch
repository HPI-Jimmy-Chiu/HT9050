+// placed at the end of the file (V912: right after WriteTargetCount) so no port line above moves.
+// Must stay identical to the DoCycleTFT priority loop (A8), or a dirty flag that can never be sent makes case 500 spin.
+//------------------------------------------------------------------------------
+bool TMyBinDispCtrl::IsAnyCountDirty(void)
+{
+    for(int i=eBinDispAuto1; i<MAX_BIN_UNIT; i++)
+    {
+        if(i>=eBinDispMag1 && i<=eBinDispMag14)                                 // V912 :680 (20260823b): Magazine units use another frame set; never dirty-sendable
