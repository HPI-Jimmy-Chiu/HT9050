+    }
+
+    IdleHomed();
+    InitialOK = false;  SystemInitialOK = false;
+    AllKeysUnknown();
+    RestoreBins();
+    W906_RemoteRun = savedRun;
+    std::printf("%s: %d/%d checks passed\n", g_fail ? "FAIL" : "PASS", g_total - g_fail, g_total);
+    return g_fail ? 1 : 0;
+}
