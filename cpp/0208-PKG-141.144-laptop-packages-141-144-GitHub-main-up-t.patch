+    def press(self, label):
+        r = self.js('key', label, self.clicks == 'dom')
+        if 'err' in r:
+            return r
+        if r.get('disabled'):
+            r['err'] = 'button "%s" is disabled' % label
+            return r
+        if self.clicks == 'cdp':
+            if not r.get('hitOk'):
+                r['err'] = 'button "%s" is covered by %s' % (label, r.get('hit'))
+                return r
+            self.cdp.click(r['x'], r['y'])
+        time.sleep(0.03)
+        return r
