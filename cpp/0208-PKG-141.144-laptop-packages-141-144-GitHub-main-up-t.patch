+// ===========================================================================
+//  AI(W906-F5-CLOSE) 20261004: NB2-1 (i), machine dispatch 4 (EastSun 1003: "closing the HMI window during F5 does not stop F5"; the
+//  machine's hmi_shell.log 18:20:48 F5 opened the wait page, 18:21:32 X + YES -> the page answered "none", only the window
+//  closed; the build went on, this program started after it and HMI-KEEP reopened the window, as logged 10-03 15:20:39).
+//  tools/hmi_shell writes %LOCALAPPDATA%\HT9045_HMI_Shell\f5_close_<port>.flag when the operator closes an F5 start (the wait
+//  page answers 'boot <port>'). Only a start that carries W906_F5_OPERATOR_CLOSE=1 (the F5 entries of .vscode/launch.json)
+//  reads it -- HT9045_Web.cmd, tests and every other start never do:
+//    * at start (main, before LoadMachineConfig: no config written, no 1203 card opened, no motor power): a fresh flag ->
+//      print why, one oplog STOP line, delete the flag, exit 0 (no wb_serve, no window); older than 60 min -> deleted, ignored;
+//    * while running: a fresh flag and !SystemStart -> HMI-KEEP does not reopen the window, and once no web page has been
+//      there for 2 s the main loop leaves through the normal close (W906_ExternalQuitDue, the STOPBTN path); flag deleted.
+//  MODAL-WAKE (a blocking box) still opens a window -- a box nobody can see would hold the machine.
+//  Decisions: tools/F5CloseDecide.h (ctest F5CloseDecide). Removing the variable from launch.json = the old behaviour.
+// ===========================================================================
+#include "F5CloseDecide.h"
+namespace {
+bool F5CloseMarker()
+{
+    const char* m = std::getenv("W906_F5_OPERATOR_CLOSE");
+    return m && m[0] == '1';
+}
+std::string F5CloseFlagPath(int port)
+{
+    const char* lad = std::getenv("LOCALAPPDATA");
+    char b[MAX_PATH + 64];
+    std::snprintf(b, sizeof(b), "%s\\HT9045_HMI_Shell\\f5_close_%d.flag", (lad && *lad) ? lad : ".", port);
+    return b;
+}
+// seconds since the flag was written, < 0 = no flag
+double F5CloseFlagAge(int port)
+{
+    WIN32_FILE_ATTRIBUTE_DATA fa;
+    if (!::GetFileAttributesExA(F5CloseFlagPath(port).c_str(), GetFileExInfoStandard, &fa)) return -1.0;
+    FILETIME now; ::GetSystemTimeAsFileTime(&now);
+    ULARGE_INTEGER a, b; a.LowPart = fa.ftLastWriteTime.dwLowDateTime; a.HighPart = fa.ftLastWriteTime.dwHighDateTime;
+    b.LowPart = now.dwLowDateTime; b.HighPart = now.dwHighDateTime;
+    return b.QuadPart > a.QuadPart ? (double)(b.QuadPart - a.QuadPart) / 1.0e7 : 0.0;
+}
+int F5ClosePort() { return g_modalServer ? (int)g_modalServer->BoundPort() : 0; }
+}  // namespace
+
+bool W906_F5CloseBeforeStart(int port)
+{
+    const double age = F5CloseFlagAge(port);
+    const ht9045::F5CloseStart d = ht9045::F5CloseAtStart(F5CloseMarker(), age);
+    if (d == ht9045::kF5StartNormally) return false;
+    const std::string path = F5CloseFlagPath(port);
+    ::DeleteFileA(path.c_str());
+    if (d == ht9045::kF5StaleFlag) {
+        std::printf("[f5-close] a flag %.0f min old (%s) was left over -> deleted, normal start\n", age / 60.0, path.c_str());
+        return false;
+    }
+    std::printf("[f5-close] the operator closed this F5's wait page %.0f s ago (%s) -> wb_serve does NOT start: no config loaded,"
+                " no 1203 card opened, no motor power, no window\n", age, path.c_str());
+    std::fflush(stdout);
+    W906_OpLogInit(port);
+    OpLine("STOP", "F5 wait page closed by the operator before start -> wb_serve did not start (W906-F5-CLOSE)");
+    return true;
+}
+
+bool W906_F5ClosePending()
+{
+    static unsigned long long s_last = 0;
+    static bool s_pending = false, s_said = false;
+    if (!F5CloseMarker()) return false;
+    const unsigned long long now = W906_TickMs64();
+    if (s_last == 0 || now - s_last >= 500ULL) {                      // a file stat at most every 0.5 s
+        s_last = now;
+        const int port = F5ClosePort();
+        s_pending = port > 0 && ht9045::F5ClosePending(true, F5CloseFlagAge(port), SystemStart);
+    }
+    if (s_pending && !s_said) {
+        s_said = true;
+        std::printf("[f5-close] the operator closed this F5's wait page -> HMI-KEEP does not reopen the window; normal close when no page is there\n");
+        OpLine("HMI", "F5 wait page closed by the operator during start-up -> the window is not reopened (W906-F5-CLOSE)");
+    }
+    return s_pending;
+}
+
+bool W906_F5CloseQuitDue()
+{
+    static unsigned long long s_noPage = 0;
+    static bool s_due = false;
+    if (s_due) return true;
+    const bool pending = W906_F5ClosePending();
+    const int pages = pending ? W906_PagesPresent() : 0;
+    if (!pending || pages > 0) { s_noPage = 0; return false; }
+    const unsigned long long now = W906_TickMs64();
+    if (s_noPage == 0) { s_noPage = now; return false; }
+    if (!ht9045::F5CloseQuitNow(pending, pages, now - s_noPage)) return false;
+    s_due = true;
+    ::DeleteFileA(F5CloseFlagPath(F5ClosePort()).c_str());
+    std::printf("[f5-close] no web page for 2 s after the operator closed the F5 wait page -> normal close\n");
+    std::fflush(stdout);
+    OpLine("STOP", "F5 wait page closed by the operator during start-up -> normal close: W906_ProdCloseSave + W906_ProdCloseShutdown, Program Close=1 (W906-F5-CLOSE)");
+    return true;
+}
