+  const c = [process.env.W906_EDGE, 'C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe', 'C:/Program Files/Microsoft/Edge/Application/msedge.exe'];
+  for (const p of c) if (p && fs.existsSync(p)) return p;
