+              "[5] RunTestProgram: SetLotStatus(iLOTSTATUS_T) is live under if(bNeedTest) (golden 913 main.cpp:19211-19212)");
+        const std::string gm = Slurp(root + "/TesterComm/Handler/HandlerGpibMsg.cpp");
