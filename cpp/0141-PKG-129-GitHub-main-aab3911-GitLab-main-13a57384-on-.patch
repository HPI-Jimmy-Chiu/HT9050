+}
+static size_t Count(const std::string& prefix)
+{
+    size_t n = 0;
+    for (size_t i = 0; i < g_f.log.size(); ++i)
+        if (g_f.log[i].compare(0, prefix.size(), prefix) == 0) ++n;
