+        Check(!Exec(r) && Has(r, "\"guard\":\"gated\"") && Has(r, "\"branch\":3") && Has(r, "GATE (W906-E020-LI11-3)"), "CCD mode + sub job: branch 3 refused with GATE (W906-E020-LI11-3)");
