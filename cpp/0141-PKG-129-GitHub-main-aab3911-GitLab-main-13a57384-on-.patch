+}
+std::string Click(const char* b, int seq) { return Act("palSecsGemMouseDown", std::string("{\"button\":\"") + b + "\",\"seq\":" + std::to_string(seq) + "}"); }
+bool Exec(const std::string& r) { return Has(r, "\"executed\":true"); }
+
+void RunActs(const std::string& root)
