+
+// ---------------------------------------------------------------- fake clock
+let clock = 1000000, timers = [], tid = 1;
+function addTimer(fn, ms, every) { const id = tid++; timers.push({ id, due: clock + Math.max(0, ms | 0), fn, every: every ? Math.max(1, ms | 0) : 0 }); return id; }
