+        Check(h >= 0 && Has(hc, "void RTCChangeFile(bool bNeedDelete=true);") && Has(hc, "void Timer1Timer();") && Has(hc, "TfLotInfoTimer *Timer1 = new TfLotInfoTimer();"),
