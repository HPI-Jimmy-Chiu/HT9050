+
+    str=W906_ExtractFileDir(IniConfig.N06_TasterListMap);                       // :1936 取出資料夾
+    if(W906_SimNetPathBlocked(IniConfig.N06_TasterListMap))                     // [W906] W58 Q5: the SIM build skips a save under a network path
