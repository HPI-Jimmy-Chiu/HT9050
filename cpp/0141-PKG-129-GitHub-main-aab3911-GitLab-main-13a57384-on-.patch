+//    Not called inside the blocking boxes (tools/wb_serve.cpp:7621 is the laptop's) -- a known gap shared
+//    with the Timer2 heater segment.
+//---------------------------------------------------------------------------
+void W906_TemperFromBootShow()
+{
+    if(fTemperFrom==NULL)
+        fTemperFrom=new TfTemperFrom();                                         // golden Application->CreateForm(__classid(TfTemperFrom), &fTemperFrom)
+    fTemperFrom->FormClose();                                                   // golden :8731 fTemperFrom->Close()
+    fTemperFrom->FormShow();                                                    // golden :8732 fTemperFrom->Show()
+}
+
+namespace ht9045 {
+void W906_TemperFromTimer1Tick()
+{
+    static unsigned long ulNext=0;
+    if(fTemperFrom==NULL || fTemperFrom->Timer1->Enabled==false || bSystemClose)
+    {
+        ulNext=0;
+        return;
+    }
+    const unsigned long ulNow=::GetTickCount();
+    if(ulNext==0)
+    {
+        ulNext=ulNow+100;
+        return;
+    }
+    if((long)(ulNow-ulNext)<0)
+        return;
+    ulNext=((ulNow-ulNext)>=100)?(ulNow+100):(ulNext+100);
+    fTemperFrom->Timer1Timer();
+}
