+        Check(u1 > 0 && u2 == u1 + 2 && Has(U[u1 + 1], "#if 0 // GATE (W906-HOME-C2-RTCINIT)"), "uhome.cpp: call, then the narrowed gate, then InitRealTimeCCDPara");
