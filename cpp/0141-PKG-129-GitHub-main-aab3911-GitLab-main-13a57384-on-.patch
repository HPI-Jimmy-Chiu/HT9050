+        BAR_CODE_INSTALL = 0;
+        std::string r = Act("changeFile", "{}");
+        Check(!Exec(r) && Has(r, "\"guard\":\"tab-hidden\""), "no barcode installed: tsBarCode hidden (FormShow :571) -> tab-hidden");
+        BAR_CODE_INSTALL = ebctUseCCDMode; CosFunction.b2DUseSubJobFunction = false;
