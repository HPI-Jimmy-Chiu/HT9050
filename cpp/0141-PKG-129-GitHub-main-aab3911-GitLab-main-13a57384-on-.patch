+
+        if(bAlreadyIn==false)
+        {
+            cbTesterType->Items->Add(W906_Str(sListX, 0));                      // :2181
+        }
+    }
+    sListY.Clear();    //Ifor 20170603 (wei) TStringList 刪除前先 Clean
