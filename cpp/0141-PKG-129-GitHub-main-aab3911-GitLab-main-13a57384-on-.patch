+// ---- the formulas (single nozzle r, c) ----
+int ZSub(const ArmCellArmInputs& a, int r, int c) { return (r >= 0 && r < 2 && c >= 0 && c < 8) ? a.zHeightSub[r][c] : 0; }
+bool IsBase(const ArmCellArmInputs& a, int r, int c) { return r == a.yBase && c == a.xBase; }
