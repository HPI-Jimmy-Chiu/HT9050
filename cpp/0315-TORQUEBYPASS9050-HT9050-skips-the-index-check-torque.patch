             fMain->lbArm0Torque->Caption="1:Reading";  { if(W906_Ht9050TorqueWaitTimedOut(0, bFirstTime && DoTestHeadMotorDelay.Off()==false, fMain->edTorue0->Text=="")) { W906_Ht9050TorqueWaitAlarm(0); fAllMotorHome=false; Task=1; return; } }   //AI(W906-ST01C) 20261005 E-044 NOT 910 (SAFETY; same form as atester.cpp DoTestHeadMotor 12110): 910 waits here until edTorue0 has a value, its only error exit (below) needs GetReadTorueTask()==999 = a SUCCESSFUL read; after 5 s without a value, while auto-run drives the wait: disarm the reader + golden alarm-stop (WAR0361) + 910's own exit fAllMotorHome=false; Task=1. Never P5 here (one alarm). No card test on this line (Steven 1005 23:2x Q-R5); the reused E-044 helper keeps its own PCI1203 key (Ht9050TorqueWait.cpp, follow-up card)
 
             if(DoTestHeadMotorDelay.Off()==false)
