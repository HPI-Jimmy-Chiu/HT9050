+// ---------------------------------------------------------------------------
+// PORT-ONLY: the Timer2 heater tick (I-01 phase 2; TO_IFOR.md §4 12:0x ②).
+// Golden runs the segment above from TfMain::Timer2Timer, a 1000 ms VCL timer
+// (main.dfm:17279 `object Timer2: TTimer` has no Interval = the VCL default;
+// FormShow :10179 enables it). wb_serve's only periodic entry is PumpTick
+// (WebBridgeTags.cpp), one beat per 500 ms; its line 601 calls this, so the
+// 1000 ms is kept here by elapsed time. Timer2Timer's guards before the segment:
+//   :20860 fShow       -- TfMain is always shown while wb_serve runs (same note
+//                         as MainTimerSegments.cpp:74, W906_Timer2FanTick);
+//   :20863 InitialOK   -- WebBridgeTags.cpp:601 sits after `if (!g_pumpActive)
+//                         return;` (the pump is armed by PumpInit only);
+//   :20866 bTimer2Run  -- re-entry flag; one thread here, nothing to keep;
+//   :21382 SystemStart -- `if(SystemStart==true){ bTimer2Run=false; return; }`:
+//                         the segment never runs while the machine runs. KEPT.
+// An exception must not take the publisher down (PumpTick's try/catch covers
+// MainProc only), so it is swallowed here, like W906_CounterRefreshTick.
+// ---------------------------------------------------------------------------
+namespace ht9045 {
+
+void W906_Timer2HeaterTick()
+{
+    static bool bHasRun=false;
+    static std::chrono::steady_clock::time_point tLastRun;
+    const std::chrono::steady_clock::time_point tNow=std::chrono::steady_clock::now();
+    if(bHasRun && tNow-tLastRun<std::chrono::milliseconds(1000))                // golden Timer2: 1000 ms
+        return;
+    bHasRun=true;
+    tLastRun=tNow;
+
+    if(SystemStart==true)                                                       // golden :21382-21386
+        return;
+    if(fMain==0)
+        return;
+    try
+    {
+        fMain->W906_Timer2HeaterSegment();                                      // golden :21528-21643
+    }
+    catch(...)
+    {
+    }
+}
+
+}  // namespace ht9045
