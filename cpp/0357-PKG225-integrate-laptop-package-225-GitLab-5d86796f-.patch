+//AI(rf360-yield-count) 20260814 (RogerYang) : RF360以不良品增量觸發Yield檢查
+//每秒由Timer3呼叫;前置條件與各Check函式一致,不滿足時凍結基準(暫停),恢復後補檢查
+//  AI(W906-W195) 20261009 (St02-E) Qualcomm: golden 913 uYieldMonitoring.cpp:6097-6128 (= 912), verbatim but for [W906] fContact->fShow
+//  -> W906_FormShowing (the page table, as :205 / :375 / :608 here).  Caller MainTimer3.cpp:553 (golden 913 main.cpp:26378); only
+//  CC_QUALCOMM sets CosFunction.bYieldAlarmCheckByCount (CosFunction.cpp:2753).  依 W-195 卡，S25 不適用（Steven 1009 13:2x）.
+//---------------------------------------------------------------------------
+void TfYieldMonitoring::UpdateYieldCountCheckTick()
+{
+    unsigned long ulFailNow;
+
+    bYieldCountCheckTick=false;
+
+    if(CosFunction.bYieldAlarmCheckByCount==false)
+        return;
+
+    if(TestIF_File.iYieldAlarmCheckIntervalByCount<=0)                          //0=不檢查,防呆
+        return;
+
+    if(SystemStart==false || W906_FormShowing("fContact", fContact->fShow)==true || iHome!=0 ||   // [W906] golden fContact->fShow==true
+       bRunAutoClean==true || bZ1PickShuttle || bZ2PickShuttle ||
+       LastSet.iRunStartMode==rsmAutoSiteMap)
+        return;
+
+    ulFailNow=ArmData[0]->GetFailCT()+ArmData[1]->GetFailCT();
+
+    if(ulFailNow<ulYieldFailBase)                                               //清計數/換批歸零後重定基準
+        ulYieldFailBase=ulFailNow;
+
+    if(ulFailNow-ulYieldFailBase>=(unsigned long)TestIF_File.iYieldAlarmCheckIntervalByCount)
+    {
+        ulYieldFailBase=ulFailNow;
+        bYieldCountCheckTick=true;
+    }
+}
