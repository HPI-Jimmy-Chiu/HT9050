+//AI(W906-VC8-IP) 20261001: HT9050 + PCIE-1203 -- IO_Table.csv IOType=Vacuum rows say where each ECAT-VC8 is.
+//  EastSun 20261001 (quoted in VacuumUnit/Vc8Route.h): InArm 0xA0, OutArm 0xA1, Index 0xA2 -- kept in IO_Table.csv
+//  so that the next change needs no code. One row per module, IN THE TABLE'S OWN FORMAT (EastSun 20261001
+//  「你不能直接填0xA0 要照表照格式 照架構 轉成IP 160」): read through TIODATA like every other row, IP decimal
+//  as the sucker rows (InArmSuck* IP 32 = 0x20), Port / Bit filled (TIODATA forces iEnable=0 when they are blank):
+//      IOType,Alias,Lane,ModuleType,IP,Port,Bit,InType,ISABase,Enable
+//      Vacuum,InArm,1,2,160,0,0,1,3,1         (Alias InArm|OutArm|Index|Index2|Index3|Index4, IP 160 = 0xA0)
+//  Lane = the ring, IP = the station, ISABase must be 3 (ePCI1203), Enable must be 1; ModuleType / Port / Bit /
+//  InType / the times are not used.
+//  Only when general.ini [Version] Model=9050GPIB (W906_GpibModel, read at :318 before LoadIoData runs):
+//    1. VacuumUnit/Vc8Route.h's station table is filled -- TMyVacuumPanel's ctor asks it for the panels' numbers;
+//    2. every Sucker / Sucker_On / Sucker_Off row with ISABase ePCI1203 on ring 1 at a moved module's golden station
+//       is moved to the new ring / station IN HSys.IOTable -- InitSucker (cinitial.cpp:559-591) binds the suckers
+//       from these rows later, the IO page and its buttons read them, golden's SetIOTableByECAT_VC8_Sucker copies
+//       them into the panels and the sucker gate registers them there: one station everywhere.
+//  A row that cannot be used (unknown Alias, IP / Lane not a number, ISABase not 3, Enable not 1, a second row for
+//  one module, two modules on one station) is skipped with a console line; that module keeps golden's station,
+//  where the identity check (EtherCAT/Pci1203Vc8.h) refuses everything unless an ECAT-VC8 really answers there.
+//  Not HT9050: the table stays empty and nothing moves (golden). LoadIoData's last step, every time it runs.
+// ===========================================================================
+#include "VacuumUnit/Vc8Route.h"
+#include <cstdio>
+
+int W906_ApplyVacuumStations()
+{
+    W906_Vc8StationsClear();
+    int nSt = 0;
+    TVc8Station* st = W906_Vc8Stations_(&nSt);
+    const bool ht9050 = (W906_GpibModel == "9050GPIB");
+    int rows = 0;
+    for (int i = 0; i < (int)HSys.IOTable.size(); i++)
+    {
+        const TIODATA* r = HSys.IOTable[i];
+        if (r == 0 || r->Type.Trim().UpperCase() != "VACUUM") continue;
+        ++rows;
+        if (!ht9050) continue;
+        const int line = i + 2;                                   // the file's line: the header is line 1
+        const int k = W906_Vc8StationSlot(r->Alias.Trim().c_str());
+        if (k < 0) {
+            std::printf("IO_Table line %d: IOType=Vacuum Alias \"%s\" is not InArm / OutArm / Index / Index2 / Index3 / Index4 -- skipped\n",
+                        line, r->Alias.c_str());
+            continue;
+        }
+        const char* bad = 0;
+        if (r->iISABase != ePCI1203) bad = "ISABase is not 3 (ePCI1203)";
+        else if (r->iEnable != 1)    bad = "Enable is not 1 (a blank Port / Bit also makes it 0, as on every row)";
+        else if (r->iLane < 0)       bad = "Lane (the ring) is blank";
+        else if (r->iIP <= 0 || r->iIP > 0xFFFF) bad = "IP is not a station number (decimal, as the table: 160 = 0xA0)";
+        else if (st[k].set)          bad = "a second row for this module";
+        for (int j = 0; bad == 0 && j < nSt; j++)
+            if (j != k && st[j].set && st[j].ring == r->iLane && st[j].ip == r->iIP) bad = "another module is already on that station";
+        if (bad) {
+            std::printf("IO_Table line %d: IOType=Vacuum %s: %s -- skipped, golden's station 0x%02X stays\n",
+                        line, st[k].alias, bad, st[k].goldenIp);
+            continue;
+        }
+        st[k].set = true; st[k].ring = r->iLane; st[k].ip = r->iIP;
+    }
+    if (!ht9050) {
+        if (rows)
+            std::printf("IO_Table: %d IOType=Vacuum row(s) not used -- general.ini Model=%s is not 9050GPIB; golden's ECAT-VC8 stations\n",
+                        rows, W906_GpibModel.c_str());
+        return 0;
+    }
+    int moved = 0, per[8] = { 0, 0, 0, 0, 0, 0, 0, 0 };
+    for (int i = 0; i < (int)HSys.IOTable.size(); i++)
+    {
+        TIODATA* r = HSys.IOTable[i];
+        if (r == 0 || r->iISABase != ePCI1203) continue;
+        if (r->Type != "Sucker" && r->Type != "Sucker_On" && r->Type != "Sucker_Off") continue;
+        int ring = 0, ip = 0;
+        if (!W906_Vc8StationMap(r->iLane, r->iIP, &ring, &ip)) continue;
+        for (int k = 0; k < nSt && k < 8; k++) if (st[k].set && st[k].goldenIp == r->iIP) ++per[k];
+        r->iLane = ring; r->iIP = ip;
+        ++moved;
+    }
+    for (int k = 0; k < nSt && k < 8; k++)
+        if (st[k].set)
+            std::printf("IO_Table: IOType=Vacuum %s (HT9050 + PCIE-1203): the ECAT-VC8 golden has at ring 1 0x%02X is at ring %d 0x%02X -- "
+                        "%d sucker row(s) moved, the Vacuum Unit panels follow\n",
+                        st[k].alias, st[k].goldenIp, st[k].ring, st[k].ip, per[k]);
+    if (rows == 0)
+        std::printf("IO_Table: no IOType=Vacuum row -- golden's ECAT-VC8 stations (InArm 0x20, OutArm 0x30, Index 0x40/0x41/0x50/0x51)\n");
+    return moved;
+}
