@@ -129,6 +129,28 @@ std::uint32_t ClampTickDeadline(std::uint32_t nextTick, std::uint32_t nowTick, s
     return ((std::int32_t)(mine - nextTick) < 0) ? mine : nextTick;   // the earlier of the two, wrap-safe like the loop's (long)(a-b)
 }
 
+// AI(W906-FASTCLK-MODAL) 20261003: see FastClock.h (E-FT1-001).
+bool WaitServicing(FastClock* clock, unsigned long capMs, WaitFn wait, void* ctx)
+{
+    if (clock == 0)
+        return wait(ctx, capMs);                                   // the clock has not started: the box's plain wait
+    const std::uint64_t end = clock->NowUs() + (std::uint64_t)capMs * 1000ull;
+    for (;;) {
+        const std::uint64_t now = clock->NowUs();
+        if (now >= end)
+            return false;
+        std::uint64_t until = clock->NextDueUs();                  // kNever with no job (or only running ones)
+        if (until > end)
+            until = end;
+        if (until > now) {
+            const std::uint64_t ms = (until - now + 999ull) / 1000ull;   // round UP, as ClampTickDeadline: an early wake only spins once more
+            if (wait(ctx, (unsigned long)ms))
+                return true;                                       // woken (a command): the box's loop handles it now, as before
+        }
+        clock->Service();                                          // every job that is due (none if the wait came back early)
+    }
+}
+
 PassMeter::PassMeter(NowUsFn now) : now_(now ? now : &DefaultNowUs) {}
 
 void PassMeter::Begin()
