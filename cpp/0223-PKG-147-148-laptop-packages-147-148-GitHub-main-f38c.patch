+    }
+    else
+        std::printf("  sandbox kept for inspection: %s\n", g_root.c_str());
+    std::printf("%s: %d/%d checks passed\n", g_fail ? "FAIL" : "PASS", g_pass, g_pass+g_fail);
+    return g_fail ? 1 : 0;
+}
