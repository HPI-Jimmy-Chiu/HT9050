 // of the two, in the tick domain (wrap-safe, DWORD arithmetic).  dueUs <= nowUs -> nowTick (sleep the loop's 1 ms floor).
 std::uint32_t ClampTickDeadline(std::uint32_t nextTick, std::uint32_t nowTick, std::uint64_t nowUs, std::uint64_t dueUs);
 
+// AI(W906-FASTCLK-MODAL) 20261003: a blocking box's wait (NIGHT_REPORT E-FT1-001).  The box's loop waits `wait(ctx, capMs)`
+// (tools/wb_serve.cpp: g_pumpQueue->waitForPush(100), woken at once by a pushed command); this waits the same way, at most
+// capMs in all, but never past the clock's next due job: it wakes for it, Service()s it and waits on for the rest.  So the
+// jobs keep their own period while the box is up (golden: the heater's Synchronize and the TTimers are served by ShowModal's
+// message loop) and everything else in the box's loop keeps its <= capMs pass.  true = `wait` reported a wake-up (the
+// caller's loop goes round at once, as before); false = capMs passed.  clock 0 (not started yet) = one plain wait(capMs).
+// A job that is on the stack (its body opened this box) is not due here (NextDueUs skips it; Service skips it, POLICY).
+typedef bool (*WaitFn)(void* ctx, unsigned long ms);
+bool WaitServicing(FastClock* clock, unsigned long capMs, WaitFn wait, void* ctx);
+
 // One serve-loop pass, for the measurement the ruling asks for ("先在模擬組態量一拍的時間"): Begin() right after the sleep,
 // End() when the loop starts computing its next sleep.  busy = End - Begin; the gap from End to the next Begin is the sleep.
 class PassMeter {
