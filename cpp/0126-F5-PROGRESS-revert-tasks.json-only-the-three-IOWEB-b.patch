From 0192f29dbc917b54655f5e3b9f4b30d9ed15534b Mon Sep 17 00:00:00 2001
From: "HT9045 Machine (V906)" <Claude_RDBC_02@honprec.com>
Date: Fri, 2 Oct 2026 09:40:31 +0800
Subject: [PATCH] F5-PROGRESS revert (tasks.json only): the three IOWEB build
 tasks call cmake directly again
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

EastSun 20261002 09:3x: 「F5無法運作，這台是實際機台」.  The 09:33 F5 opened the wait page but the build never started (no cmake
process, the wrapper never wrote its status file), while the 08:16 F5 (old tasks) and the 09:10 build_dbg_nonoracle start worked.
.vscode/tasks.json is byte-identical to before a87f2a5 again.  tools/build_with_status.ps1 stays in the tree unused; boot_wait.html
shows the old text when no status file exists.  Cause to be found offline before anything goes back on the F5 path.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 .vscode/tasks.json | 12 ++++++------
 1 file changed, 6 insertions(+), 6 deletions(-)

diff --git a/.vscode/tasks.json b/.vscode/tasks.json
index 51b30ca..f5463d3 100644
--- a/.vscode/tasks.json
+++ b/.vscode/tasks.json
@@ -66,8 +66,8 @@
       "label": "IOWEB(這台): build wb_serve（出貨組態, WinLibs 32-bit）",
       "detail": "cmake --build build_integ_ship_x86 --target wb_serve  (-DW906_NO_SOFT_SIMULTE=ON, C++14, -static)",
       "type": "process",
-      "command": "powershell",
-      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\tools\\build_with_status.ps1", "-BuildDir", "${workspaceFolder}/build_integ_ship_x86", "-Target", "wb_serve", "-Jobs", "6"],   // AI(W906-F5-PROGRESS) 20261002: same cmake --build, plus progress for boot_wait.html (tools/build_with_status.ps1)   // AI(W906-BOOTSPEED-2) 20260929: was -j NUMBER_OF_PROCESSORS (28): 28 compilers on 7.7 GB RAM page the whole PC, the boot after it too
+      "command": "cmake",
+      "args": ["--build", "${workspaceFolder}/build_integ_ship_x86", "--target", "wb_serve", "-j", "6"],   // AI(W906-BOOTSPEED-2) 20260929: was -j NUMBER_OF_PROCESSORS (28): 28 compilers on 7.7 GB RAM page the whole PC, the boot after it too
       "options": {
         "cwd": "${workspaceFolder}",
         "env": { "PATH": "${env:LOCALAPPDATA}\\Programs\\ht9045-nonoracle-toolchain\\mingw32\\bin;${env:PATH}" }
@@ -89,8 +89,8 @@
       "label": "IOWEB(這台): build wb_serve DEBUG（-g, 出貨組態）",
       "detail": "cmake --build build_integ_dbg_x86 --target wb_serve  (Debug = -g, shipping config)",
       "type": "process",
-      "command": "powershell",
-      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\tools\\build_with_status.ps1", "-BuildDir", "${workspaceFolder}/build_integ_dbg_x86", "-Target", "wb_serve", "-Jobs", "6"],   // AI(W906-F5-PROGRESS) 20261002: same cmake --build, plus progress for boot_wait.html (tools/build_with_status.ps1)   // AI(W906-BOOTSPEED-2) 20260929: see above
+      "command": "cmake",
+      "args": ["--build", "${workspaceFolder}/build_integ_dbg_x86", "--target", "wb_serve", "-j", "6"],   // AI(W906-BOOTSPEED-2) 20260929: see above
       "options": {
         "cwd": "${workspaceFolder}",
         "env": { "PATH": "${env:LOCALAPPDATA}\\Programs\\ht9045-nonoracle-toolchain\\mingw32\\bin;${env:PATH}" }
@@ -173,8 +173,8 @@
       "label": "IOWEB(這台): build wb_serve -O2（出貨組態）",
       "detail": "cmake --build build_integ_ship_x86_o2 --target wb_serve (-O2 + the -O0-behaviour flags, shipping config)",
       "type": "process",
-      "command": "powershell",
-      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\tools\\build_with_status.ps1", "-BuildDir", "${workspaceFolder}/build_integ_ship_x86_o2", "-Target", "wb_serve", "-Jobs", "6"],   // AI(W906-F5-PROGRESS) 20261002: same cmake --build, plus progress for boot_wait.html (tools/build_with_status.ps1)
+      "command": "cmake",
+      "args": ["--build", "${workspaceFolder}/build_integ_ship_x86_o2", "--target", "wb_serve", "-j", "6"],
       "options": {
         "cwd": "${workspaceFolder}",
         "env": { "PATH": "${env:LOCALAPPDATA}\\Programs\\ht9045-nonoracle-toolchain\\mingw32\\bin;${env:PATH}" }
-- 
