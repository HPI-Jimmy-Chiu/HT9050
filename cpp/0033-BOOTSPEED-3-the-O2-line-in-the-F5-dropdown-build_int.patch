From: "HT9045 Machine (V906)" <Claude_RDBC_02@honprec.com>
Date: Tue, 29 Sep 2026 21:38:26 +0800
Subject: [PATCH] =?UTF-8?q?=EF=BB=BFBOOTSPEED-3:=20the=20-O2=20line=20in?=
 =?UTF-8?q?=20the=20F5=20dropdown=20(build=5Finteg=5Fship=5Fx86=5Fo2,=20no?=
 =?UTF-8?q?=20debugger)?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

EastSun 20260929 "都先照你說的改": separate build dir configured with -O2 -fno-strict-aliasing -fwrapv
-fno-delete-null-pointer-checks -ffloat-store -fexcess-precision=standard -fno-finite-loops (same defines as the ship
build; no empty busy-wait loops found in the tree). First build EXIT 0 (21:04, incremental 21:30), MZ/PE header ok.
tasks.json: "IOWEB(這台): build wb_serve -O2（出貨組態）" + its check/wait/build sequence; launch.json: the no-debugger
entry on the -O2 exe + compound "★ IOWEB(這台): -O2 快速版" under ★★. Not yet proven on the machine.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 .vscode/launch.json | 40 ++++++++++++++++++++++++++++++++++++++++
 .vscode/tasks.json  | 30 ++++++++++++++++++++++++++++++
 2 files changed, 70 insertions(+)

diff --git a/.vscode/launch.json b/.vscode/launch.json
index ea925f4..4c6d170 100644
--- a/.vscode/launch.json
+++ b/.vscode/launch.json
@@ -170,6 +170,39 @@
       "externalConsole": false,
       "presentation": { "group": "0_f5", "order": 2 }
     },
+    {
+      // AI(W906-BOOTSPEED-2) 20260929: the entry above on the -O2 build (tasks.json "IOWEB(這台): build wb_serve -O2（出貨組態）").
+      //   Same program arguments, environment, no debugger. ⚠ NOT yet proven on the machine: -O2 can expose undefined
+      //   behaviour that -O0 hides; if anything behaves differently, go back to the ★★ entry (the -O0 build).
+      "name": "IOWEB(這台): wb_serve -O2 快速版（不接除錯器）",
+      "type": "cppdbg",
+      "request": "launch",
+      "noDebug": true,
+      "ignoreRunWithoutDebuggingWarnings": true,
+      "preLaunchTask": "IOWEB(這台): 檢查舊程式 + 等待畫面 + build wb_serve -O2",
+      "program": "${workspaceFolder}/build_integ_ship_x86_o2/wb_serve.exe",
+      "args": ["--root", "${workspaceFolder}\\..\\web", "--port", "8055"],
+      "cwd": "${workspaceFolder}",
+      "environment": [
+        { "name": "W906_GENERAL_INI_PATH", "value": "D:\\HT9045\\system\\Gerneral.ini" },
+        { "name": "W906_SETUPINF_PATH",    "value": "${workspaceFolder}\\..\\runcfg\\SetUp.inf" },
+        { "name": "W906_IOTABLE_PATH",     "value": "D:\\HT9045\\system\\IO_Table.csv" },
+        { "name": "W906_MOTTABLE_PATH",    "value": "D:\\HT9045\\system\\Mot_Table.csv" },
+        { "name": "W906_AUTH_PATH",        "value": "${workspaceFolder}\\..\\runcfg\\config\\" },
+        { "name": "W906_E84DATA_ROOT",     "value": "${workspaceFolder}\\..\\runcfg\\logs\\E84DataTxt" },
+        { "name": "W906_TCPDATA_ROOT",     "value": "${workspaceFolder}\\..\\runcfg\\logs\\TCP_Data" },
+        { "name": "W906_SUMMARYLOT_ROOT",  "value": "${workspaceFolder}\\..\\runcfg\\logs\\Summary_Lot" },
+        { "name": "W906_EVENTLOG_ROOT",    "value": "${workspaceFolder}\\..\\runcfg\\logs\\EventLogTxt" },
+        { "name": "W906_BINCOUNT_PATH",    "value": "${workspaceFolder}\\..\\runcfg\\logs\\BinCount.ini" },
+        { "name": "W906_PWBOOK_PATH",      "value": "${workspaceFolder}\\..\\runcfg\\logs\\pwbook.ini" },
+        { "name": "W906_TEACH_INI_PATH",   "value": "${workspaceFolder}\\..\\runcfg\\system\\teach.ini" },
+        { "name": "W906_IOTIMING_LOG",     "value": "${workspaceFolder}\\..\\runcfg\\logs\\io_click_timing.csv" }, { "name": "W906_OPLOG_DIR", "value": "${workspaceFolder}\\..\\runcfg\\logs" }, { "name": "W906_HMI_URL", "value": "http://127.0.0.1:8055/background.html?mode=debug&machine=HT9050" }
+      ],
+      "MIMode": "gdb",
+      "miDebuggerPath": "${env:LOCALAPPDATA}\\Programs\\ht9045-nonoracle-toolchain\\mingw32\\bin\\gdb.exe",
+      "externalConsole": false,
+      "presentation": { "group": "0_f5", "order": 4 }
+    },
     {
       // AI(W906-IOWEB-F5) 20260925: identical to the entry above but runs the -g
       // build (build_integ_dbg_x86), so breakpoints bind. First build is long
@@ -481,6 +514,13 @@
       "stopAll": true,
       "presentation": { "group": "0_f5", "order": 1 }
     },
+    {
+      // AI(W906-BOOTSPEED-2) 20260929: the -O2 line in the dropdown, right under ★★ (pick it once; F5 then repeats it).
+      "name": "★ IOWEB(這台): -O2 快速版（不接除錯器，1203 唯讀，port 8055）",
+      "configurations": [ "IOWEB(這台): wb_serve -O2 快速版（不接除錯器）" ],
+      "stopAll": true,
+      "presentation": { "group": "0_f5", "order": 2 }
+    },
     // AI(W906-T4-RETIRE) 20260919: 這裡本來有一個 compound
     //   「HT9045: build + Web HMI + browser  (HT9050 HMI)」，成員是
     //   wb_publish --pump + wb_gateway + browser。前兩支已退役
diff --git a/.vscode/tasks.json b/.vscode/tasks.json
index 07fc1d8..59b7eac 100644
--- a/.vscode/tasks.json
+++ b/.vscode/tasks.json
@@ -144,6 +144,36 @@
       "dependsOn": ["IOWEB(這台): 檢查舊程式還在不在", "IOWEB(這台): 開啟等待畫面", "IOWEB(這台): build wb_serve（出貨組態, WinLibs 32-bit）"],
       "problemMatcher": []
     },
+    {
+      // AI(W906-BOOTSPEED-2) 20260929: EastSun「都先照你說的改」-- the separate -O2 line (build_integ_ship_x86_o2; configured with
+      //   CMAKE_CXX_FLAGS/CMAKE_C_FLAGS = -O2 -fno-strict-aliasing -fwrapv -fno-delete-null-pointer-checks -ffloat-store
+      //   -fexcess-precision=standard -fno-finite-loops, i.e. -O0's aliasing / overflow / null-check / x87 rounding behaviour
+      //   kept; same defines as build_integ_ship_x86). First build 20260929 21:04 + 21:30, EXIT 0.
+      "label": "IOWEB(這台): build wb_serve -O2（出貨組態）",
+      "detail": "cmake --build build_integ_ship_x86_o2 --target wb_serve (-O2 + the -O0-behaviour flags, shipping config)",
+      "type": "process",
+      "command": "cmake",
+      "args": ["--build", "${workspaceFolder}/build_integ_ship_x86_o2", "--target", "wb_serve", "-j", "6"],
+      "options": {
+        "cwd": "${workspaceFolder}",
+        "env": { "PATH": "${env:LOCALAPPDATA}\\Programs\\ht9045-nonoracle-toolchain\\mingw32\\bin;${env:PATH}" }
+      },
+      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
+      "problemMatcher": {
+        "owner": "cpp",
+        "fileLocation": "absolute",
+        "pattern": {
+          "regexp": "^(.*?):(\\d+):(\\d+):\\s+(warning|error|note|fatal error):\\s+(.*)$",
+          "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5
+        }
+      }
+    },
+    {
+      "label": "IOWEB(這台): 檢查舊程式 + 等待畫面 + build wb_serve -O2",
+      "dependsOrder": "sequence",
+      "dependsOn": ["IOWEB(這台): 檢查舊程式還在不在", "IOWEB(這台): 開啟等待畫面", "IOWEB(這台): build wb_serve -O2（出貨組態）"],
+      "problemMatcher": []
+    },
     {
       // AI(W906-BOOTWAIT) 20260929: the same for the -g F5.
       "label": "IOWEB(這台): 等待畫面 + build wb_serve DEBUG（-g）",
-- 
