+    if(W906_IsHT9050())
+    {
+        static int s_W906LastStep=-1;
+        static std::chrono::steady_clock::time_point s_W906StepSince;
+        static bool s_W906StepNoted=false;
+        const std::chrono::steady_clock::time_point w906Now=std::chrono::steady_clock::now();
+        if(fHome->iHomeStep!=s_W906LastStep)
