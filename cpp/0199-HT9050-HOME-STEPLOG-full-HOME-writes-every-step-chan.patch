+            s_W906StepSince=w906Now;
+            s_W906StepNoted=false;
+        }
+        else if(!s_W906StepNoted && fHome->iHomeStep>1 &&
+                std::chrono::duration_cast<std::chrono::seconds>(w906Now-s_W906StepSince).count()>=20)
+        {
+            s_W906StepNoted=true;
+            const bool f[10]={flag1,flag2,flag3,flag4,flag5,flag6,flag7,flag8,flag9,flag10};
+            std::string w906F;
+            for(int j=0; j<10; j++) w906F+=" flag"+std::to_string(j+1)+"="+(f[j]?"1":"0");
+            for(int j=0; j<4; j++) w906F+=std::string(" bCyflag")+std::to_string(j)+"="+(bCyflag[j]?"1":"0");
+            W906_HomeNote("step " + std::to_string(fHome->iHomeStep) + " held 20 s:" + w906F);
+        }
