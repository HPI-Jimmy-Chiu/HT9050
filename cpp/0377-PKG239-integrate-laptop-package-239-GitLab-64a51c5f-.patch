+//AI(W906-W188) 20261010 (NB2-1): W-188 #6 -- golden 913 Public/HTEditList.cpp:2820-2878 verbatim.
+//---------------------------------------------------------------------------
+//AI(ht9045-inarm-flow) 20260831f (RogerYang) : 清掉「借了沒還」的暫停帳(bSuck=false但座標仍在) --
+//AI : 借料只是SetPlateSuck(false)暫停, 正常補回會復活成原本那個4格team;
+//AI : ASM被One Cycle/關站打斷就會留下暫停帳, 那些格的料實體上已不在盤上,
+//AI : 帳留著就是幽靈帳 -> 取料對不到料 -> Pattern #22 死結
+//AI : 只在ASM邊界(ReStartAutoSiteMapping)呼叫, 此時不會有in-flight借料
+//---------------------------------------------------------------------------
+int uPlateInfo::PurgePausedBookings()
+{
+    int iWiped=0;
+    for(int ig=HPSuckGroupList->Count-1; ig>=0; ig--)
+    {
+        uHPSuckGroup* HPGroup=ExtractSuckGroup(ig);
+        if(HPGroup==NULL)
+            continue;
+
+        for(int it=HPGroup->GetTeamCount()-1; it>=0; it--)
+        {
+            uHPSuckTeam* HPTeam=HPGroup->ExtractSuckTeam(it);
+            if(HPTeam==NULL)
+                continue;
+
+            bool bAnySuck=false;
+            for(int i=0; i<MAX_ARM_Row; i++)
+            {
+                for(int j=0; j<MAX_ARM_Col; j++)
+                {
+                    if(HPTeam->bSuck[i][j]==false &&
+                       HPTeam->iPlateR[i][j]>=0 &&
+                       HPTeam->iPlateC[i][j]>=0)                                //AI : 未使用的吸嘴座標=-1, 不會被誤清
+                    {
+                        HPTeam->iPlateR[i][j]=-1;
+                        HPTeam->iPlateC[i][j]=-1;
+                        HPTeam->iSite[i][j]  =-1;
+                        iWiped++;
+                    }
+
+                    if(HPTeam->bSuck[i][j]==true)
+                        bAnySuck=true;
+                }
+            }
+
+            if(bAnySuck==false)                                                 //AI : team全空 -> 刪除
+            {
+                uHPSuckTeam* HPDel=HPGroup->RemoveSuckTeam(it);
+                if(HPDel!=NULL)
+                    delete HPDel;
+            }
+        }
+
+        if(HPGroup->GetTeamCount()==0 &&
+           ig!=HPSuckGroupList->Count-1)                                        //AI : 隊尾open group要留
+        {
+            DelHPSuckGroup(ig);
+            delete HPGroup;
+        }
+    }
+    return iWiped;
+}
+//---------------------------------------------------------------------------
+//AI(W906-W188) 20261010 (NB2-1): W-188 #6 -- the purge block at the head of golden 913 main.cpp TfMain::ReStartAutoSiteMapping (:29258-29275,
+//   RogerYang 20260831f / 20260914), verbatim.  The port's TfMain::ReStartAutoSiteMapping (forms/fMain.cpp:248) is still the empty
+//   stub and calls this on the same line; forms/fMain.cpp cannot see the real uPlateInfo, this TU can.  The rest of the 913 body
+//   (ASM step / cursor reset, DoInArm_9045_SuckerMap, ASM-end orphan placeholder clear) is NOT ported here -- follow-up.
+void W906_ReStartASMPurge913()
+{
+    //AI(ht9045-inarm-flow) 20260831f (RogerYang) : ASM邊界清掉「借了沒還」的暫停帳 --
+    //AI : 借料=SetPlateSuck(false)暫停(座標保留,4格team不拆), 正常補回會復活;
+    //AI : 被One Cycle/關站打斷時暫停帳不會復活, 留著就是幽靈帳 -> 取料對不到料 -> Pattern #22 死結
+    //AI(ht9045-inarm-flow) 20260914 (RogerYang) : 20260831f 原註解「進入本函式不會有in-flight借料」已被 log 推翻(偉測 HHT-83) --
+    //AI : One Cycle 打斷借料時 csystem 會先設 iResetSiteMappingStep=1 再呼叫本函式, 補回還排在後面;
+    //AI : 這時清掉暫停帳, 補回會查無帳而補登成單格 group -> 該格脫離原 team -> 熱盤孤島 -> 找不到 2x4 落點 -> WAR0150
+    //AI : Home 不會設 iResetSiteMappingStep, 所以 Home 照清(借走那顆不會回熱盤), 一個旗標就分得乾淨
+    if(PickFromHPList!=NULL &&
+       iResetSiteMappingStep==0)                                                //AI : >0 = 補回還沒做, 這一輪不可清
+    {
+        int iPurged=PickFromHPList->PurgePausedBookings();
+        if(iPurged>0)
+        {
+            AnsiString StrPurge;
+            StrPurge.sprintf("ASM boundary : purge %d paused booking slot(s), grp=%d", iPurged, PickFromHPList->GetHPSuckGroupCount());
+            RecordProcess(StrPurge, "ReStartAutoSiteMapping");
+        }
+    }
+}
