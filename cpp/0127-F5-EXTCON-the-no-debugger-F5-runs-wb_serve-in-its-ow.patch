From 8b266d618d65b26828bd1d930bebde7dd478a3df Mon Sep 17 00:00:00 2001
From: "HT9045 Machine (V906)" <Claude_RDBC_02@honprec.com>
Date: Fri, 2 Oct 2026 10:03:34 +0800
Subject: [PATCH] F5-EXTCON: the no-debugger F5 runs wb_serve in its own
 console window, not a VS Code terminal

EastSun 20261002: F5 does not work.  Measured: the F5 starts at 09:41:50, 09:45:58 and 09:53:23 (the starred IOWEB compound -> the
no-debugger member, cpptools RunWithoutDebuggingAdapter = a VS Code terminal) each ended 10-20 s in -- no STOP line, no crash report,
port 8055 gone -- while VS Code's pty host kept logging 'Could not find pty N on pty host'; the same exe, arguments and environment
started outside VS Code at 09:49:56 and 10:01:45 ran normally (HMI connected, closed by the operator's Exit).  externalConsole true on
both no-debugger members (ship, -O2); the gdb entry is unchanged.  Close the program with the HMI's Exit.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 .vscode/launch.json | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/.vscode/launch.json b/.vscode/launch.json
index 4bd51cf..f7e0e18 100644
--- a/.vscode/launch.json
+++ b/.vscode/launch.json
@@ -145,7 +145,7 @@
       "type": "cppdbg",
       "request": "launch",
       "noDebug": true,
-      "ignoreRunWithoutDebuggingWarnings": true,
+      "ignoreRunWithoutDebuggingWarnings": true,  "externalConsole": true,   // AI(W906-F5-EXTCON) 20261002: EastSun「F5無法運作」-- run wb_serve in its own console window, not a VS Code terminal: today every F5 start ended 10-20 s in with no crash and no log while VS Code's pty host kept failing ("Could not find pty N on pty host"); the same exe + environment started outside VS Code ran normally. Close it with the HMI's Exit (closing that window ends the program)
       "preLaunchTask": "IOWEB(這台): 檢查舊程式 + 等待畫面 + build wb_serve（出貨組態）", "postDebugTask": "IOWEB(這台): 停止鈕 -> 關閉程式",   // AI(W906-STOPBTN) 20260929: the red STOP button now closes wb_serve (normal close)
       "program": "${workspaceFolder}/build_integ_ship_x86/wb_serve.exe",
       "args": ["--root", "${workspaceFolder}\\..\\web", "--port", "8055"],
@@ -178,7 +178,7 @@
       "type": "cppdbg",
       "request": "launch",
       "noDebug": true,
-      "ignoreRunWithoutDebuggingWarnings": true,
+      "ignoreRunWithoutDebuggingWarnings": true,  "externalConsole": true,   // AI(W906-F5-EXTCON) 20261002: EastSun「F5無法運作」-- run wb_serve in its own console window, not a VS Code terminal: today every F5 start ended 10-20 s in with no crash and no log while VS Code's pty host kept failing ("Could not find pty N on pty host"); the same exe + environment started outside VS Code ran normally. Close it with the HMI's Exit (closing that window ends the program)
       "preLaunchTask": "IOWEB(這台): 檢查舊程式 + 等待畫面 + build wb_serve -O2", "postDebugTask": "IOWEB(這台): 停止鈕 -> 關閉程式",   // AI(W906-STOPBTN) 20260929: the red STOP button now closes wb_serve (normal close)
       "program": "${workspaceFolder}/build_integ_ship_x86_o2/wb_serve.exe",
       "args": ["--root", "${workspaceFolder}\\..\\web", "--port", "8055"],
-- 
2.55.0.windows.5

