 tools/vscode-htdesigner/CHANGELOG.md      | 2 ++
 tools/vscode-htdesigner/HANDOVER.md       | 6 +++++-
 tools/vscode-htdesigner/lib/aliasedit.js  | 4 +++-
 tools/vscode-htdesigner/test/run_tests.js | 8 ++++++++
 4 files changed, 18 insertions(+), 2 deletions(-)

diff --git a/tools/vscode-htdesigner/CHANGELOG.md b/tools/vscode-htdesigner/CHANGELOG.md
