 module.exports = {
   Source, scriptRanges, readText, samePath, findAll, idMentionRe, identRe, locateFn,
-  extractCmds, calledNames, findFnDefs, traceCmds, findCmdSend, braceEnd,
-  mapFrameUrl, idAtOffset, findIdAttr, titleOf, mentionsClass, escRe,
