+/* AI(W906-HTDESIGNER) 20260929: 屬性與事件 panel. VS Code theme variables only. */
+body {
+  margin: 0;
+  padding: 0 0 12px;
+  color: var(--vscode-foreground);
+  background: var(--vscode-sideBar-background);
+  font-family: var(--vscode-font-family);
+  font-size: var(--vscode-font-size);
+}
+.empty { padding: 10px 14px; color: var(--vscode-descriptionForeground); line-height: 1.6; }
+.empty p { margin: 0 0 8px; }
+.head { padding: 8px 12px 6px; border-bottom: 1px solid var(--vscode-panel-border, rgba(128,128,128,.3)); }
+.title { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px; }
+.name { font-weight: 600; font-size: 1.15em; font-family: var(--vscode-editor-font-family); }
+.cls { color: var(--vscode-symbolIcon-classForeground, var(--vscode-descriptionForeground)); font-family: var(--vscode-editor-font-family); }
+.sub { margin-top: 2px; color: var(--vscode-descriptionForeground); }
+.path { margin-top: 2px; font-family: var(--vscode-editor-font-family); font-size: .92em; color: var(--vscode-descriptionForeground); word-break: break-all; }
+.bar { margin-top: 6px; display: flex; gap: 6px; flex-wrap: wrap; }
+button {
+  font: inherit; color: var(--vscode-button-secondaryForeground); background: var(--vscode-button-secondaryBackground);
+  border: none; padding: 2px 8px; border-radius: 2px; cursor: pointer;
+}
+button:hover { background: var(--vscode-button-secondaryHoverBackground); }
+.sec { border-bottom: 1px solid var(--vscode-panel-border, rgba(128,128,128,.2)); }
+.sec > summary {
+  cursor: pointer; padding: 4px 12px; font-weight: 600; text-transform: none; user-select: none;
+  color: var(--vscode-sideBarSectionHeader-foreground, var(--vscode-foreground));
+}
+.count {
+  margin-left: 6px; padding: 0 6px; border-radius: 8px; font-weight: normal; font-size: .85em;
+  background: var(--vscode-badge-background); color: var(--vscode-badge-foreground);
+}
+.body { padding: 0 0 6px; }
+.row { padding: 2px 12px; cursor: default; outline: none; line-height: 1.45; }
+.row:hover { background: var(--vscode-list-hoverBackground); }
+.row.sel, .row:focus { background: var(--vscode-list-inactiveSelectionBackground); }
+.row.ind, .ind { padding-left: 28px; }
+.event { display: flex; align-items: center; gap: 8px; margin-top: 4px; }
+.evn { min-width: 92px; color: var(--vscode-symbolIcon-eventForeground, var(--vscode-foreground)); font-family: var(--vscode-editor-font-family); }
+.evh { font-family: var(--vscode-editor-font-family); font-weight: 600; flex: 1; word-break: break-all; }
+.chip {
+  display: inline-block; padding: 0 5px; margin-right: 6px; border-radius: 3px; font-size: .82em; line-height: 1.5;
+  color: #fff; vertical-align: baseline;
+}
+.chip.mini { margin: 0; font-size: .75em; padding: 0 4px; }
+.chip.off { opacity: .25; }
+.k-web { background: #1f6fbf; }
+.k-port { background: #2e7d32; }
+.k-golden { background: #b0600a; }
+.k-html { background: #6a4fa3; }
+.loc { font-family: var(--vscode-editor-font-family); color: var(--vscode-textLink-foreground); }
+.note { margin-left: 8px; color: var(--vscode-descriptionForeground); font-size: .92em; }
+.warn .note { color: var(--vscode-editorWarning-foreground); }
+.weak .loc { opacity: .85; }
+.snip {
+  font-family: var(--vscode-editor-font-family); font-size: .9em; color: var(--vscode-descriptionForeground);
+  white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding-left: 0; margin-top: 1px;
+}
+.lst { margin: 4px 0 2px; }
+.lhead { padding: 1px 12px; display: flex; gap: 8px; align-items: baseline; flex-wrap: wrap; }
+.ltype { font-family: var(--vscode-editor-font-family); font-weight: 600; }
+.lwhere { color: var(--vscode-descriptionForeground); }
+.lfn { font-family: var(--vscode-editor-font-family); font-size: .9em; color: var(--vscode-descriptionForeground); }
+.cmd { margin-top: 4px; }
+.more { margin: 4px 0 0; }
+.more > summary { cursor: pointer; padding: 2px 12px; color: var(--vscode-descriptionForeground); }
+.dim { color: var(--vscode-descriptionForeground); }
+.pad { padding: 2px 12px; }
+.ind.pad { padding-left: 28px; }
+.small { font-size: .88em; }
+.filter {
+  display: block; box-sizing: border-box; width: calc(100% - 24px); margin: 4px 12px 4px;
+  font: inherit; color: var(--vscode-input-foreground); background: var(--vscode-input-background);
+  border: 1px solid var(--vscode-input-border, transparent); padding: 2px 6px;
+}
+.filter:focus { outline: 1px solid var(--vscode-focusBorder); }
+table.kv { border-collapse: collapse; width: 100%; table-layout: fixed; }
+table.kv td { padding: 1px 12px; vertical-align: top; border-bottom: 1px solid var(--vscode-panel-border, rgba(128,128,128,.12)); }
+table.kv tr:hover td { background: var(--vscode-list-hoverBackground); }
+table.kv td.k { width: 40%; color: var(--vscode-symbolIcon-propertyForeground, var(--vscode-foreground)); font-family: var(--vscode-editor-font-family); word-break: break-all; }
+table.kv td.v { font-family: var(--vscode-editor-font-family); word-break: break-all; }
+.sw { display: inline-block; width: 11px; height: 11px; margin-right: 5px; vertical-align: -1px; border: 1px solid rgba(128,128,128,.7); }
+.hint { margin-left: 6px; color: var(--vscode-descriptionForeground); }
+.subhead { padding: 6px 12px 2px; color: var(--vscode-descriptionForeground); font-weight: 600; }
+.foot { padding: 8px 12px; color: var(--vscode-descriptionForeground); font-size: .9em; line-height: 1.5; }
+.fname { font-family: var(--vscode-editor-font-family); color: var(--vscode-foreground); }
+.fnote { margin-top: 2px; }
