+        const defs = hits.filter(h => h.def).slice(0, 3);
+        (defs.length ? defs : hits.slice(0, 1)).forEach(h => ev.targets.push(T(this.cppTarget('golden', h))));
+      }
+      ev.cppPending = false;
+    }
+    const cmdNames = [];
+    for (const l of listeners) if (l.relevant) for (const c of l.cmds) if (!cmdNames.includes(c)) cmdNames.push(c);
+    for (const m of mentions) for (const c of web.extractCmds(m.snippet)) if (!cmdNames.includes(c)) cmdNames.push(c);
+    if (port) {
+      for (const c of cmdNames.slice(0, 8)) {
+        const hits = await port.findString(c);
