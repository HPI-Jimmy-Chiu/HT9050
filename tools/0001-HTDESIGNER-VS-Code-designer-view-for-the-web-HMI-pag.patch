+    if (!t) {
+      t = new SourceTree(root, kind);
+      this.trees.set(key, t);
+      this.log('建立索引：' + (kind === 'port' ? 'C++ 移植樹 ' : 'BCB6 原始碼 ') + root);
+      t.ensure().then(() => {
