+/**
+ * 1009 CSV walkthrough #1: the machine data folders (the five live links, the 9045 / 9050 roots) -- open documents under
+ * them. A switch re-points the links under an open tab: its text is the OTHER machine's, and a save wrote it over this one.
+ */
+function machineDocs() {
+  const c = vscode.workspace.getConfiguration('ht9045Designer');
+  const roots = ['D:\\HT9045\\system', 'D:\\HT9045\\config', 'D:\\HT9045\\IniData', 'D:\\HT9045_Log', 'D:\\GPIB9045\\system',
+    String(c.get('hp9050Root') || '').trim(), String(c.get('hp9045Root') || 'D:\\HP9045').trim()].filter(Boolean).map(r => path.resolve(r).toLowerCase());
+  return (vscode.workspace.textDocuments || []).filter(x => x && x.uri && x.uri.scheme === 'file' && (() => { const p = path.resolve(x.uri.fsPath).toLowerCase(); return roots.some(r => p === r || p.startsWith(r + path.sep)); })());
+}
+/** an unsaved machine data file open -- refused (said) -> true; nothing switched, nothing closed */
+function dirtyMachineDocsRefused(cfg) {
+  try {
+    if (cfg && !machineroot.runsMachine(cfg)) return false;
+    // (1009 review of 0.379 C: only where this start can switch the folders -- the machine itself (hp9050Root empty, no links)
+    //  or machineSwitch off never switches, and an unsaved Gerneral.ini there refused F5 for nothing)
+    const c0 = vscode.workspace.getConfiguration('ht9045Designer');
+    let linked = false; try { linked = fs.lstatSync('D:\\HT9045\\system').isSymbolicLink(); } catch (e) { linked = false; }
+    if (c0.get('machineSwitch', true) === false || !(String(c0.get('hp9050Root') || '').trim() || linked)) return false;
+    const dirty = machineDocs().filter(x => x.isDirty);
+    if (!dirty.length) return false;
+    vscode.window.showWarningMessage('沒有啟動：機台資料夾裡有沒存的檔（' + dirty.slice(0, 4).map(x => path.basename(x.uri.fsPath)).join('、') + (dirty.length > 4 ? '…' : '') + '）。切換機台時那些分頁會變成另一台的檔，存下去就把另一台蓋掉。先存好或放棄修改，再按一次。執行中的程式沒有動。');
+    return true;
+  } catch (e) { return false; }
+}
