From 6c14bb42fd609f7839f1c97800d50cd81724ce6e Mon Sep 17 00:00:00 2001
From: "HT9045 Machine (V906)" <Claude_RDBC_02@honprec.com>
Date: Tue, 6 Oct 2026 19:08:21 +0800
Subject: [PATCH] HTDESIGNER (tools 0169): the Debug / Release button on the
 Solution Explorer toolbar stands out
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

EastSun 1006 (a screenshot of the Release button): "這圖示 可以明顯一點?"
- media/solution.css .tbb.cfg: the icon 18px, the word bold; Release = bright
  orange (#ffa726) icon and word, an orange-tinted button with an orange border;
  Debug = red (#f46a6a) the same way; darker shades in a light theme.
- test/panels_render.ps1: the computed icon size, colours and background checked.

Tests: run_all 3/3 layers; real VS Code 159/159.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 tools/vscode-htdesigner/CHANGELOG.md           |  1 +
 tools/vscode-htdesigner/HANDOVER.md            |  1 +
 tools/vscode-htdesigner/media/solution.css     | 10 ++++++++++
 tools/vscode-htdesigner/test/panels_render.ps1 |  3 ++-
 4 files changed, 14 insertions(+), 1 deletion(-)

diff --git a/tools/vscode-htdesigner/CHANGELOG.md b/tools/vscode-htdesigner/CHANGELOG.md
index 673df9f..48d3fdb 100644
--- a/tools/vscode-htdesigner/CHANGELOG.md
+++ b/tools/vscode-htdesigner/CHANGELOG.md
@@ -3,6 +3,7 @@
 每一版多了什麼。怎麼操作看 [操作一覽](CHEATSHEET.md)，詳細說明看 README。
 
 ## 0.197.0
+- 機台端補丁（tools 0169，20261006，版本號不變）：**方案總管工具列的 Debug／Release 鈕更顯眼**（EastSun 1006：「這圖示可以明顯一點？」）：圖示放大到 18px，圖示和字都用亮色（Release 亮橘、Debug 紅），按鈕帶同色的底和框。
 - 機台端補丁（tools 0168，20261006，版本號不變）：**屬性面板分頁那一行右邊的「DFM／HTML／複製」三顆按鈕拿掉了**（EastSun 1006：「這邊不要有」）。跳到 DFM／HTML 照樣可以：雙擊那一列、那一列的選單、Shift+F7。
 - 機台端補丁（tools 0167，20261006，版本號不變）：**屬性面板上方那條「⚠ N 項和 DFM 不同／全部改回 DFM」拿掉了**（EastSun 1006：「圖片上的功能我不需要」）。和 DFM 不同的列照樣標色、寫 DFM 的值，每一列右邊的小方塊和右鍵的「改回 DFM」照舊。
 - 機台端合併（tools 0166，20261006）：筆電包 158／159／160／161（ES02 0.177–0.197）依序合進機台，機台自己的功能（▶＝F5、跟著捷徑找 BCB6、停止、F5 自動關舊程式／沒改過不編、LOG、版面…）都在。`test/smoke_extension.js` 在 158／159 合併衝突，改用包 161 的整份（逐項比過：機台的 89 個測試標題、22 段機台測試都在裡面）。⚠ 新的 `test/e2e_all.js` 會改樹並建置 9050，**機台上不跑**。
diff --git a/tools/vscode-htdesigner/HANDOVER.md b/tools/vscode-htdesigner/HANDOVER.md
index 577f4ee..9f62b44 100644
--- a/tools/vscode-htdesigner/HANDOVER.md
+++ b/tools/vscode-htdesigner/HANDOVER.md
@@ -152,6 +152,7 @@
     - 同一顆：`media/csv.js` 捲動重畫加 40 ms 後備（rAF 不來就直接 draw）。這台無畫面 Edge 的 rAF 一直不來，凍結欄測試 A 欄 52→-248；等待改長、改輪詢都沒用（一直輪詢反而更不來），是頁面本身要有後備。ES02 請收。⚠ `test/e2e_all.js`（改樹＋建 9050）、`test/vscode_run_it.ps1`（建置＋啟動 wb_serve）機台不跑；`vscode_props_it`／`vscode_wpf_it`／`vscode_dbg_it` 不碰機台（dbg 那支自己編一支小程式）。
     - 機台補丁 tools 0167（20261006）：`media/props.js` 的 diffnote（「⚠ N 項和 DFM 不同」＋「全部改回 DFM」）不畫了（`if (diffs && false)`，EastSun 1006「圖片上的功能我不需要」）；`test/panels_render.ps1` 兩項改成檢查它不在。列上的 DFM 值、小方塊、右鍵「改回 DFM」、多選時對齊區的「全部改回 DFM（n 個）」都沒動。ES02 請收。
     - 機台補丁 tools 0168（20261006）：`media/props.js` 分頁列尾的 `.vtools`（DFM／HTML／複製）不放進畫面（`if (false) vw.appendChild(bar)`，EastSun 1006「這邊不要有」）；panels 加一項檢查它不在。ES02 請收。
+    - 機台補丁 tools 0169（20261006）：`media/solution.css` `.tbb.cfg`（Debug／Release 鈕）：`.ci` 18px、字粗體、`.rel` 亮橘 #ffa726＋淡橘底框、`.dbg` 紅 #f46a6a＋淡紅底框、亮色主題用深一點的顏色；panels 加一項量計算後的大小、顏色、底色。EastSun 1006「這圖示可以明顯一點?」。ES02 請收。
     - ⚠ **只有包裡改的檔、新檔要「原樣複製位元組」**（`[IO.File]::ReadAllBytes`／`WriteAllBytes`），不要讀成文字再寫：讀成文字會把 BOM 拿掉，而 `test\panels_render.ps1` 有中文，PowerShell 5.1 沒有 BOM 就讀錯。兩邊都改的才用 `git merge-file` 的結果（那幾個是 .md／.js）。
     - 操作員在跑 `wb_serve` 的時候也可以跑外掛的測試：測試頁有 CSP 封網路（探針測試會驗證），只用隨機的 DevTools 埠。會連 `wb_serve` 的只有 `e2e_*`，不跑。
   - **機台要新版的時候**：這台聯絡不到筆電端的工作階段（`ListAgents` 看不到），也讀不到 GitLab。
diff --git a/tools/vscode-htdesigner/media/solution.css b/tools/vscode-htdesigner/media/solution.css
index 2c4ed5e..a7eea65 100644
--- a/tools/vscode-htdesigner/media/solution.css
+++ b/tools/vscode-htdesigner/media/solution.css
@@ -79,6 +79,16 @@ body { padding: 2px 4px 4px 4px; box-sizing: border-box; }
 .tbb.chk.on { background: var(--htd-on); border-color: var(--htd-onb); }
 /* 1005: Debug / Release -- one button, the word is what it is now (Release in its own colour) */
 .tbb.cfg.rel .ci { color: var(--vscode-charts-orange, #d18616); }
+/* 1006 (EastSun: "這圖示 可以明顯一點?"): the Debug / Release button stands out -- a bigger icon, the icon and the word in a
+   bright colour (Release orange, Debug red), the button tinted with it */
+.tbb.cfg .ci { font-size: 18px; }
+.tbb.cfg .tx { font-weight: bold; }
+.tbb.cfg.rel { background: rgba(255, 159, 26, .18); border-color: rgba(255, 159, 26, .75); }
+.tbb.cfg.rel .ci, .tbb.cfg.rel .tx { color: #ffa726; }
+.tbb.cfg.dbg { background: rgba(241, 76, 76, .16); border-color: rgba(241, 76, 76, .75); }
+.tbb.cfg.dbg .ci, .tbb.cfg.dbg .tx { color: #f46a6a; }
+.vscode-light .tbb.cfg.rel .ci, .vscode-light .tbb.cfg.rel .tx { color: #c25e00; }
+.vscode-light .tbb.cfg.dbg .ci, .vscode-light .tbb.cfg.dbg .tx { color: #c62828; }
 .tbb.cfg.dbg .ci { color: var(--vscode-debugIcon-startForeground, #89d185); }
 .tbb.busy .ci { animation: htdspin 1s linear infinite; display: inline-block; }
 /* 1003: building / running in their own colour, not greyed (EastSun 「請用不同顏色 不要反灰」) */
diff --git a/tools/vscode-htdesigner/test/panels_render.ps1 b/tools/vscode-htdesigner/test/panels_render.ps1
index da805d8..6f1d7bb 100644
--- a/tools/vscode-htdesigner/test/panels_render.ps1
+++ b/tools/vscode-htdesigner/test/panels_render.ps1
@@ -944,7 +944,7 @@ window.dispatchEvent(new MessageEvent('message', { data: { type: 'run', s: { st:
 var tbs = Array.prototype.slice.call(document.querySelectorAll('#tb .tbb'));
 R.tbKeys = tbs.map(function (b) { return b.dataset.key + (b.disabled ? '-' : '+'); }).join(',');
 var goB = document.querySelector('#tb .tbb.go'); R.goColor = goB ? getComputedStyle(goB.querySelector('.ci')).color : '';
-R.simOn = !!document.querySelector('#tb .tbb[data-key="sim"].on'); R.dbgOn = ((document.querySelector('#tb .tbb[data-key="dbg"] .tx') || {}).textContent || '') === 'Debug'; R.dbgText = ((document.querySelector('#tb .tbb[data-key="dbg"] .tx') || {}).textContent || '');
+(function () { var d = document.querySelector('#tb .tbb[data-key="dbg"]'); if (!d) return; var ci = d.querySelector('.ci'), tx = d.querySelector('.tx'); R.cfgIcon = parseFloat(getComputedStyle(ci).fontSize); R.cfgColor = getComputedStyle(tx).color; R.cfgIconColor = getComputedStyle(ci).color; R.cfgBg = getComputedStyle(d).backgroundColor; })(); R.simOn = !!document.querySelector('#tb .tbb[data-key="sim"].on'); R.dbgOn = ((document.querySelector('#tb .tbb[data-key="dbg"] .tx') || {}).textContent || '') === 'Debug'; R.dbgText = ((document.querySelector('#tb .tbb[data-key="dbg"] .tx') || {}).textContent || '');
 window.__out.length = 0; if (goB) goB.click(); var pz = document.querySelector('#tb .tbb[data-key="pause"]'); if (pz) pz.click();
 R.tbClick = window.__out.map(function (m) { return m.type + ':' + m.id; }).join(',');
 var wb = document.querySelector('.win'); R.frame = wb ? getComputedStyle(wb).borderTopWidth : '';
@@ -1049,6 +1049,7 @@ if ($rSln) {
 } else { Write-Host '[solution] no data (smoke_extension.js writes solution_rows.json)'; $script:bad++ }
 if ($rSln) {
   Check ($rSln.tbKeys -eq 'start+,pause-,stop-,restart-,sim+,dbg+,sync+,refresh+,collapse+' -and $rSln.goColor -eq 'rgb(78, 201, 78)' -and $rSln.simOn -and -not $rSln.dbgOn -and $rSln.dbgText -eq 'Release' -and $rSln.tbClick -eq 'cmd:ht9045Designer.run.buildAndStart' -and $rSln.frame -eq '2px' -and $rSln.winFill -ge 0 -and $rSln.winFill -le 6) 'Solution Explorer toolbar (0.151): green start, pause / stop / restart off when idle, the two checkboxes, sync / refresh / collapse; a click = its command, an off one nothing; a 2px frame down to the bottom (0.159)' "fill=$($rSln.winFill) keys=$($rSln.tbKeys) go=$($rSln.goColor) sim=$($rSln.simOn) dbg=$($rSln.dbgOn)/$($rSln.dbgText) click=$($rSln.tbClick) frame=$($rSln.frame)"
+  Check ($rSln.cfgIcon -ge 18 -and $rSln.cfgColor -eq 'rgb(255, 167, 38)' -and $rSln.cfgIconColor -eq 'rgb(255, 167, 38)' -and $rSln.cfgBg -ne 'rgba(0, 0, 0, 0)') 'Debug / Release button stands out (EastSun 1006): an 18px icon, icon and word bright orange for Release, the button tinted' "icon=$($rSln.cfgIcon) text=$($rSln.cfgColor) iconColor=$($rSln.cfgIconColor) bg=$($rSln.cfgBg)"
 }
 # the properties panel with REAL input (20261001): the wheel over a focused number field, Up / Down on a focused
 # drop-down, a real double click on a True / False box -- synthetic events cannot show these
-- 
2.55.0.windows.5

