+/* (every name | value table the same as the property grid: the name column 38 %, one line, where the grid's start) */
+table.kv td.k { width: 38%; padding-left: 14px; color: var(--vscode-symbolIcon-propertyForeground, var(--vscode-foreground)); font-family: var(--vscode-editor-font-family);
+  white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
 table.kv td.v { font-family: var(--vscode-editor-font-family); word-break: break-all; }
 .sw { display: inline-block; width: 11px; height: 11px; margin-right: 5px; vertical-align: -1px; border: 1px solid rgba(128,128,128,.7); }
 .hint { margin-left: 6px; color: var(--vscode-descriptionForeground); }
 .subhead { padding: 6px 12px 2px; color: var(--vscode-descriptionForeground); font-weight: 600; }
+/* the DFM list's categories and the HTML's parts: the same bands as the grid's categories */
+details.sec[data-key="props"] .subhead, details.sec[data-key="html"] .subhead { padding: 3px 6px; margin-top: 2px; color: var(--vscode-foreground);
