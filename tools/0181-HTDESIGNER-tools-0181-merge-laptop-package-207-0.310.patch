+/**
+ * 1008 review: why a name cannot be a C++ member of a form class ('' = it can). The characters alone let "delete", "new",
+ * "class" through -- the generated part file (written to disk at once) then had "o->delete(...)" and the build broke even
+ * after Ctrl+Z; and a form's own base members ("Close", "Show") were hidden by a new member, every Close(); of the class broken.
+ */
+const CPP_KEYWORDS = new Set(('alignas alignof and and_eq asm auto bitand bitor bool break case catch char char16_t char32_t class compl ' +
+  'const constexpr const_cast continue decltype default delete do double dynamic_cast else enum explicit export extern false float for ' +
+  'friend goto if inline int long mutable namespace new noexcept not not_eq nullptr operator or or_eq private protected public register ' +
+  'reinterpret_cast return short signed sizeof static static_assert static_cast struct switch template this thread_local throw true try ' +
+  'typedef typeid typename union unsigned using virtual void volatile wchar_t while xor xor_eq __fastcall __published __property __closure NULL').split(' '));
+const FORM_BASE = new Set('Close Show Hide ShowModal Free Release Repaint Refresh Invalidate Update SetFocus BringToFront SendToBack Perform Owner Parent Name Tag Caption Visible Enabled Left Top Width Height Color Font Handle Components ComponentCount Controls ControlCount ModalResult Action Hint OnClick OnShow OnClose OnCreate OnDestroy'.split(' '));
+function cppNameWhy(s) {
+  if (CPP_KEYWORDS.has(s)) return '「' + s + '」是 C++ 的保留字，不能當名稱';
+  if (/^__/.test(s) || /^_[A-Z]/.test(s)) return '「' + s + '」是 C++ 保留給編譯器的寫法（__ 開頭，或 _ 加大寫開頭）';
+  if (FORM_BASE.has(s)) return '「' + s + '」是表單本身已經有的成員（TForm／TControl），用了會把它蓋掉，類別裡原本的 ' + s + ' 會編不過';
+  return '';
