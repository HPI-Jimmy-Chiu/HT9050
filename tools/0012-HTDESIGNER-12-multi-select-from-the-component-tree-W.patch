@@ -190,9 +190,9 @@ exports.run = async function () {
 
       // multi-select + align top = ONE undo step
       await sleep(800);
-      d.post({ type: 'selectIds', ids: ['sbtExit', 'spbSave'] });
+      d.post({ type: 'selectIds', ids: ['sbtExit', 'spbSave'], origin: 'tree' });   // as the outline sends it
