+  // --- WPF-style editing: the probe changed the DOM, now write it into the source ---
+  refuseEdit(d, why) {
+    vscode.window.setStatusBarMessage('$(warning) ' + why, 6000);
+    this.log('[' + path.basename(d.file) + '] 沒有寫回：' + why);
+  }
+
+  /**
+   * m = { what:'style'|'attr'|'caption', id, target:'self'|'parent', style:{…}, attr:{…},
+   *       capKind, value }. One WorkspaceEdit = one undo step; nothing is saved to disk.
+   */
+  async applySourceEdit(d, m) {
+    const text = d.doc.getText();
+    const tag = m.id ? htmledit.startTagOf(text, m.id) : null;
+    if (!tag) {
+      this.refuseEdit(d, '原始碼裡找不到 id="' + (m.id || '') + '"（可能是頁面 JS 產生的元件），只改到畫面、沒有寫回。');
+      d.render();
+      return false;
+    }
+    let range = null, repl = null;
+    if (m.what === 'style' || m.what === 'attr') {
+      const target = m.target === 'parent' ? htmledit.wrapperTagOf(text, tag.start) : tag;
+      if (!target) {
+        this.refuseEdit(d, '「' + m.id + '」的位置由外層元素決定，但原始碼裡找不到緊鄰的外層標籤，沒有寫回。');
+        d.render();
+        return false;
+      }
+      let t = target.text;
+      if (m.what === 'style') t = htmledit.setStyle(t, m.style || {});
+      else for (const [k, v] of Object.entries(m.attr || {})) t = htmledit.setAttr(t, k, v);
+      range = [target.start, target.end];
+      repl = t;
+    } else if (m.what === 'caption') {
+      if (m.capKind === 'value') {
+        range = [tag.start, tag.end];
+        repl = htmledit.setAttr(tag.text, 'value', String(m.value));
+      } else {
+        const r = htmledit.captionRange(text, tag, m.capKind);
+        if (!r) { this.refuseEdit(d, '找不到「' + m.id + '」的文字在原始碼的位置，沒有寫回。'); d.render(); return false; }
+        range = r;
+        repl = htmledit.escText(m.value);
+      }
+    } else {
+      return false;
+    }
+    if (text.slice(range[0], range[1]) === repl) return true;
+    const we = new vscode.WorkspaceEdit();
+    we.replace(d.doc.uri, new vscode.Range(d.doc.positionAt(range[0]), d.doc.positionAt(range[1])), repl);
+    d.selfEdits++;
+    const ok = await vscode.workspace.applyEdit(we);
+    if (!ok) { d.selfEdits--; this.refuseEdit(d, '寫回原始碼失敗。'); d.render(); return false; }
+    if (!this.warnedEdit) {
+      this.warnedEdit = true;
+      const auto = vscode.workspace.getConfiguration('files', d.doc.uri).get('autoSave');
+      const autoNote = auto && auto !== 'off' ? '⚠ 你開了自動存檔（files.autoSave = ' + auto + '），改動會自動寫到磁碟。' : '還沒存檔；Ctrl+Z 復原、Ctrl+S 存檔。';
+      vscode.window.showInformationMessage(
+        '已改到 ' + path.basename(d.file) + ' 的 HTML 原始碼。' + autoNote +
+        '這一頁由 sync_web.py 從網頁作者那邊同步，--apply 會整份覆蓋：存檔前請確認，並告訴網頁作者。');
+    }
+    return true;
+  }
+
+  /** From the properties panel: ask the probe to apply (it then reports an 'edit'). */
+  forwardEdit(d, key, m) {
+    if (!d || key == null) return;
+    if (m.type === 'setLayout') d.post({ type: 'setLayout', key, left: m.left, top: m.top, width: m.width, height: m.height });
+    else if (m.type === 'setCaption') d.post({ type: 'setCaption', key, value: m.value });
+    else if (m.type === 'setLook') d.post({ type: 'setLook', key, prop: m.prop, value: m.value });
+  }
