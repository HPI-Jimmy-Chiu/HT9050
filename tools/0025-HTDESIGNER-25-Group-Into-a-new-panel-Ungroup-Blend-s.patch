-      if (n) return n.class;
-      const row = d.treeData.find(r => r[2] === id);
-      return row ? row[4] : '';
-    };
-    const container = selId === '@form' || toolbox.CONTAINERS.test(clsOf(selId));
+    const container = selId === '@form' || toolbox.CONTAINERS.test(this.classOf(d, pi, selId, text));
     const used = new Set(pageinfo.collectIds(text).concat(d.treeData.map(r => r[2]).filter(Boolean)));
     const id = toolbox.newName(item.base, used);
     let at, x = 8, y = 8, lineOf, into = null;
@@ -1443,8 +1538,7 @@ class Hub {
     const pi = await d.info;
     const info = d.sel && d.sel.info;
     const selId = info && info.id ? info.id : '@form';
-    const node = pi.ir && selId !== '@form' ? pi.ir.byName.get(selId) : null;
-    const container = selId === '@form' || !!(node && /^(TPanel|TGroupBox|TTabSheet|TScrollBox|TFrame)$/.test(node.class));
+    const container = selId === '@form' || toolbox.CONTAINERS.test(this.classOf(d, pi, selId, text));
     let at;
     let lineOf;
     if (container) {
diff --git a/tools/vscode-htdesigner/lib/htmlblock.js b/tools/vscode-htdesigner/lib/htmlblock.js
index 9be96d7..340547d 100644
--- a/tools/vscode-htdesigner/lib/htmlblock.js
+++ b/tools/vscode-htdesigner/lib/htmlblock.js
@@ -129,6 +129,19 @@ function offsetBlock(html, dx, dy) {
   return he.setStyle(tag, ch) + html.slice(e + 1);
 }
 
+/** left / top / width / height (px numbers, null when not px) of a block's first start tag. */
+function firstPx(html) {
+  const e = he.tagEnd(html, 0);
+  if (e < 0) return null;
+  const st = he.styleOf(html.slice(0, e + 1));
+  const px = name => {
+    const d = st.decls.filter(x => x.name === name).pop();
+    const m = d ? /^(-?\d+(?:\.\d+)?)px$/.exec(d.value) : null;
+    return m ? parseFloat(m[1]) : null;
+  };
+  return { left: px('left'), top: px('top'), width: px('width'), height: px('height') };
+}
+
 /** The indentation of the line `at` is on. */
 function indentAt(text, at) {
   const ls = text.lastIndexOf('\n', at - 1) + 1;
@@ -274,4 +287,4 @@ function reorder(text, unit, how) {
   return { parts: [del, { range: [ins.at, ins.at], repl: ins.repl }], from: idx, to, of: kids.length };
 }
 
-module.exports = { nameOf, elementRange, unitOf, idsIn, freshName, renameIds, offsetBlock, indentAt, insideEnd, removeRange, parentOf, childrenOf, reorder };
+module.exports = { nameOf, elementRange, unitOf, idsIn, freshName, renameIds, offsetBlock, firstPx, indentAt, insideEnd, removeRange, parentOf, childrenOf, reorder };
