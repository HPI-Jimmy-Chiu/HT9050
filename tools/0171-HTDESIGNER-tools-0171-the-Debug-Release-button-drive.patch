+  /** AI(W906-HTDESIGNER) 20261008 (machine; EastSun「連動F5 release 和debug」): the launch configuration F5 / ▶ should run for
+   *  the Debug / Release button. A cppdbg configuration whose program sits in a build folder named with a "dbg" or "ship"
+   *  part (build_integ_dbg_x86 / build_integ_ship_x86) is paired with the configuration whose program is in the folder with
+   *  the other part; run.debug picks the one. Several candidates (a read-only variant on the same program): the one whose
+   *  arguments and environment match the selected one best. -> null (not a paired configuration), { same } (already the one
+   *  wanted), { cfg } (run this one instead) or { missing } (the other folder has no configuration). */
+  pairedConfig(cfg, folder) {
+    if (!cfg || cfg.type !== 'cppdbg' || typeof cfg.program !== 'string') return null;
+    const m = cfg.program.replace(/\\/g, '/').match(/^(.*\/)([^/]+)(\/[^/]+)$/);
+    if (!m) return null;
+    const dir = m[2];
+    const tok = t => new RegExp('(^|[_-])' + t + '(?=[_-]|$)', 'i');
+    const isDbg = tok('dbg').test(dir), isShip = tok('ship').test(dir);
+    if (isDbg === isShip) return null;
+    const wantDbg = this.opt('run.debug');
+    if (wantDbg === isDbg) return { same: true, wantDbg };
+    const otherDir = dir.replace(tok(isDbg ? 'dbg' : 'ship'), (a, p) => p + (isDbg ? 'ship' : 'dbg'));
+    const want = (m[1] + otherDir + m[3]).toLowerCase();
+    const lc = vscode.workspace.getConfiguration('launch', folder && folder.uri);
+    const list = (lc && lc.get('configurations')) || [];
+    const envOf = c => { const o = {}; for (const e of (Array.isArray(c.environment) ? c.environment : [])) if (e && e.name) o[e.name] = String(e.value); return o; };
+    const e0 = envOf(cfg), a0 = JSON.stringify(cfg.args || []);
+    const score = c => {
+      const e = envOf(c);
+      let s = JSON.stringify(c.args || []) === a0 ? 100 : 0;
+      for (const k of new Set(Object.keys(e0).concat(Object.keys(e)))) s += e0[k] === e[k] ? 1 : -1;
+      return s;
+    };
+    const cands = list.filter(c => c && c.type === 'cppdbg' && (c.request || 'launch') === (cfg.request || 'launch') &&
+      typeof c.program === 'string' && c.program.replace(/\\/g, '/').toLowerCase() === want);
+    if (!cands.length) return { missing: otherDir, wantDbg };
+    cands.sort((x, y) => score(y) - score(x));
+    return { cfg: cands[0], wantDbg };
+  }
   /** What the next ▶ builds and starts: the C++ tree, the build dir of the two checkboxes. */
   plan() {
     const sim = this.opt('run.simulation'), dbg = this.opt('run.debug');
