+  let standard = '';
+  const abs = p => path.resolve(cwd || '.', String(p).replace(/^"(.*)"$/, '$1'));
+  for (let i = 0; i < words.length; i++) {
+    const w = words[i];
+    let m;
+    if ((m = /^-(I|isystem|iquote|idirafter)(.*)$/.exec(w))) { const p = m[2] || words[++i]; if (p) includePath.push(abs(p)); continue; }
