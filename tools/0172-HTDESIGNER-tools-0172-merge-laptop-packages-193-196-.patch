+    add('${CMAKE_CURRENT_SOURCE_DIR}/' + inner, n => '${CMAKE_CURRENT_SOURCE_DIR}/' + (n.startsWith(d + '/') ? n.slice(d.length + 1) : up + n));
+  } else {
+    add(up + r, n => up + n);
+    add('${CMAKE_CURRENT_SOURCE_DIR}/' + up + r, n => '${CMAKE_CURRENT_SOURCE_DIR}/' + up + n);
+  }
