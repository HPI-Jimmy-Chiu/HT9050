+  }
+  return out.sort((a, b) => a.s - b.s).filter((r, i, a) => !i || r.s >= a[i - 1].e);
+}
+
+module.exports = { targets, targetsFor, insertSource, refsOf, removeSource, spellings, refsAll, refsUnder };
