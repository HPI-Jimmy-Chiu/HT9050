+  const end = Date.now() + ms;
+  for (;;) {
+    let v = null;
+    try { v = await fn(); } catch (e) { v = null; }
+    if (v) return v;
+    if (Date.now() > end) return null;
+    await sleep(step || 250);
+  }
+}
+
