new file mode 100644
index 0000000..489b9a2
--- /dev/null
+++ b/tools/vscode-htdesigner/snippets/cpp.json
@@ -0,0 +1,52 @@
+{
+  "AI change note (W906)": {
+    "prefix": ["//ai", "ainote"],
+    "description": "這棵樹規定的 AI 修改註解：//AI(W906-<工作代號>) YYYYMMDD: 描述",
+    "body": ["//AI(W906-${1:TAG}) ${CURRENT_YEAR}${CURRENT_MONTH}${CURRENT_DATE}: ${2:描述}"]
+  },
+  "for (int i = 0; i < n; i++)": {
+    "prefix": ["fori", "for"],
+    "description": "BCB 範本 forb：for 迴圈",
+    "body": ["for (int ${1:i} = 0; ${1:i} < ${2:n}; ${1:i}++)", "{", "\t$0", "}"]
+  },
+  "if / else": {
+    "prefix": ["ife", "ifb"],
+    "description": "BCB 範本 ife：if ... else",
+    "body": ["if (${1:cond})", "{", "\t$2", "}", "else", "{", "\t$0", "}"]
+  },
+  "try / catch (Exception &e)": {
+    "prefix": ["tryc", "trycf"],
+    "description": "BCB 範本 tryc：try ... catch (Exception &e)",
+    "body": ["try", "{", "\t$1", "}", "catch (Exception &e)", "{", "\t${2:ShowMessage(e.Message);}", "}"]
+  },
+  "try / __finally": {
+    "prefix": ["tryf"],
+    "description": "BCB 範本 tryf：try ... __finally（g++ 沒有 __finally：用 RAII 或 catch(...) 重拋）",
+    "body": ["try", "{", "\t$1", "}", "catch (...)", "{", "\t${2:/* cleanup */}", "\tthrow;", "}", "${2:/* cleanup */}"]
+  },
+  "event handler (TObject *Sender)": {
+    "prefix": ["evt", "onclick"],
+    "description": "VCL 事件處理函式：void __fastcall TfX::NameClick(TObject *Sender)",
+    "body": ["void __fastcall ${1:TfForm}::${2:Button1Click}(TObject *Sender)", "{", "\t$0", "}"]
+  },
+  "for each line of a TStringList": {
+    "prefix": ["forsl", "strings"],
+    "description": "逐行處理 TStringList（Count／Strings[i]）",
+    "body": ["for (int ${1:i} = 0; ${1:i} < ${2:sl}->Count; ${1:i}++)", "{", "\tAnsiString ${3:line} = ${2:sl}->Strings[${1:i}];", "\t$0", "}"]
+  },
+  "TStringList new / delete": {
+    "prefix": ["newsl"],
+    "description": "建立 TStringList，用完 delete",
+    "body": ["TStringList *${1:sl} = new TStringList();", "try", "{", "\t$0", "}", "catch (...)", "{", "\tdelete ${1:sl};", "\tthrow;", "}", "delete ${1:sl};"]
+  },
+  "switch / case": {
+    "prefix": ["switchb", "casec"],
+    "description": "BCB 範本 casec：switch ... case",
+    "body": ["switch (${1:value})", "{", "\tcase ${2:0}:", "\t\t$0", "\t\tbreak;", "\tdefault:", "\t\tbreak;", "}"]
+  },
+  "#if 0 gate with reason": {
+    "prefix": ["gate", "if0"],
+    "description": "這棵樹的 #if 0 閘門：寫明原因與日期（中斷點不會停在裡面）",
+    "body": ["#if 0   // AI(W906-${1:TAG}) ${CURRENT_YEAR}${CURRENT_MONTH}${CURRENT_DATE}: ${2:為什麼先不編譯}", "$TM_SELECTED_TEXT$0", "#endif"]
+  }
+}
