From b970c1ac28e4f87d9b818b81ddca974bec00bc6a Mon Sep 17 00:00:00 2001
From: "HT9045 Machine (V906)" <Claude_RDBC_02@honprec.com>
Date: Tue, 29 Sep 2026 22:54:46 +0800
Subject: [PATCH] HTDESIGNER-39: the 16 standard TColor swatches under
 Font.Color / Color (0.39.0)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

BCB6's Object Inspector offers clBlack ... clWhite for a TColor. The properties
panel now has the same 16 colours as small swatches under Font.Color and
Color: one click sets that colour (the same setLook path as the colour box,
so with several selected it goes to all of them), hovering shows the name,
and when the current colour is one of them its name follows the hex
("#ff0000（clRed）") and its swatch is outlined.

Test: panels_render (32 swatches, clRed posts color #ff0000, titled clRed).

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 tools/vscode-htdesigner/CHEATSHEET.md         |  1 +
 tools/vscode-htdesigner/README.md             |  2 ++
 tools/vscode-htdesigner/media/props.css       |  4 ++++
 tools/vscode-htdesigner/media/props.js        | 24 ++++++++++++++++++-
 tools/vscode-htdesigner/package.json          |  2 +-
 .../vscode-htdesigner/test/panels_render.ps1  |  8 +++++++
 6 files changed, 39 insertions(+), 2 deletions(-)

diff --git a/tools/vscode-htdesigner/CHEATSHEET.md b/tools/vscode-htdesigner/CHEATSHEET.md
index 46e20b9..5e921e1 100644
--- a/tools/vscode-htdesigner/CHEATSHEET.md
+++ b/tools/vscode-htdesigner/CHEATSHEET.md
@@ -31,6 +31,7 @@
 | 輸入數字 | 屬性面板的 Left／Top／Width／Height |
 | 對齊／同大小 | 多選後右鍵「對齊與間距」（以最後點的為準） |
 | 等距排列 | 選 3 個以上 → 右鍵「對齊與間距 → 水平等距／垂直等距」 |
+| 換成 BCB6 標準色（clRed…） | 屬性面板 Font.Color／Color 下面的 16 個色塊，點一下 |
 | 好幾個一起改字型／顏色／寬度 | 多選後在屬性面板「外觀與版面」改（全部一起改，一個 Ctrl+Z 復原） |
 | 放到容器正中間 | 右鍵「對齊與間距 → 在容器中水平置中／垂直置中」（多選＝整組一起） |
 | 吸到格線 | 標題列的 `#`（格線大小：設定 `ht9045Designer.gridSize`） |
diff --git a/tools/vscode-htdesigner/README.md b/tools/vscode-htdesigner/README.md
index 554c4a3..adc6569 100644
--- a/tools/vscode-htdesigner/README.md
+++ b/tools/vscode-htdesigner/README.md
@@ -103,6 +103,8 @@ code --install-extension tools\vscode-htdesigner\dist\ht9045-html-designer-<版
 `Font.Name`、`Font.Size`、`Font.Bold`、`Font.Italic`、`Font.Color`、`Color`。
 表單本身（元件樹最上面那一個）可以改 `Width`／`Height`，跟 WPF 拉 Window 的大小一樣，但不能移動。
 輸入後按 Enter 或離開欄位就生效（跟 WPF 的屬性視窗一樣），畫面和 HTML 原始碼同時改。
+`Font.Color`／`Color` 下面有 BCB6 的 **16 個標準色**（`clBlack` … `clWhite`，滑鼠停上去看名稱），點一下就套用；
+目前的顏色剛好是其中一個時，後面會寫出名稱（例如 `#ff0000（clRed）`）。要別的顏色就按色塊左邊的顏色框自己選。
 
 **跟 DFM 比對、重設為 DFM 值**（WPF 的「重設值」）：每個欄位旁邊灰字 `DFM …` 是 BCB6 `.dfm` 裡的原值。
 網頁的值跟它**不一樣**時，那一列會標成警告色，旁邊出現 **↺**，按下去就改回 DFM 的值（一樣是一個復原步驟）。
diff --git a/tools/vscode-htdesigner/media/props.css b/tools/vscode-htdesigner/media/props.css
index 693462b..44a6684 100644
--- a/tools/vscode-htdesigner/media/props.css
+++ b/tools/vscode-htdesigner/media/props.css
@@ -109,6 +109,10 @@ table.edit tr.diff td.k { color: var(--vscode-editorWarning-foreground); }
 table.edit tr.diff .dfmv { color: var(--vscode-editorWarning-foreground); }
 table.edit button.reset { margin-left: 4px; padding: 0 5px; line-height: 1.3; }
 .diffnote { color: var(--vscode-editorWarning-foreground); }
+.pal { display: flex; flex-wrap: wrap; gap: 2px; margin-top: 3px; max-width: 150px; }
+.pal .sw { width: 14px; height: 14px; min-width: 0; padding: 0; margin: 0; border: 1px solid rgba(128,128,128,.7); border-radius: 2px; cursor: pointer; }
+.pal .sw.cur { outline: 2px solid var(--vscode-focusBorder, #007fd4); outline-offset: 1px; }
+.pal .sw:disabled { opacity: .35; cursor: default; }
 table.edit td.v input.col { width: 34px; height: 18px; padding: 0; border: 1px solid var(--vscode-input-border, rgba(128,128,128,.5)); vertical-align: middle; }
 .foot { padding: 8px 12px; color: var(--vscode-descriptionForeground); font-size: .9em; line-height: 1.5; }
 .fname { font-family: var(--vscode-editor-font-family); color: var(--vscode-foreground); }
diff --git a/tools/vscode-htdesigner/media/props.js b/tools/vscode-htdesigner/media/props.js
index 89c94d3..21812bb 100644
--- a/tools/vscode-htdesigner/media/props.js
+++ b/tools/vscode-htdesigner/media/props.js
@@ -19,6 +19,11 @@
     return e;
   }
   function base(p) { return String(p || '').split(/[\\/]/).pop(); }
+  /* BCB6's 16 standard TColor values (lib/format.js CL has the same) */
+  var VCL16 = [['clBlack', '#000000'], ['clMaroon', '#800000'], ['clGreen', '#008000'], ['clOlive', '#808000'],
+    ['clNavy', '#000080'], ['clPurple', '#800080'], ['clTeal', '#008080'], ['clGray', '#808080'],
+    ['clSilver', '#c0c0c0'], ['clRed', '#ff0000'], ['clLime', '#00ff00'], ['clYellow', '#ffff00'],
+    ['clBlue', '#0000ff'], ['clFuchsia', '#ff00ff'], ['clAqua', '#00ffff'], ['clWhite', '#ffffff']];
 
   var KIND = {
     web: { chip: '網頁', title: '網頁 JS：瀏覽器實際執行的程式' },
@@ -350,8 +355,25 @@
             c.setAttribute('data-field', p[0]); c.disabled = !ed.inSource;
             c.addEventListener('change', function () { vscode.postMessage({ type: 'setLook', prop: p[0], value: c.value }); });
             var sys = dfm[p[0] + 'Sys'];
-            row(p[1], c, lk[p[0]] ? lk[p[0]] : '（未設定）', dfm[p[0]], lk[p[0]], setLook(p[0]),
+            var named = VCL16.filter(function (x) { return x[1] === String(lk[p[0]] || '').toLowerCase(); })[0];
+            row(p[1], c, lk[p[0]] ? lk[p[0]] + (named ? '（' + named[0] + '）' : '') : '（未設定）', dfm[p[0]], lk[p[0]], setLook(p[0]),
               sys ? { text: 'DFM ' + sys + '（系統色）', title: '系統色的實際顏色看 Windows 佈景，不比對' } : null);
+            /* BCB6's TColor list: the 16 standard colours, one click each */
+            var td2 = tb.lastChild && tb.lastChild.lastChild;
+            if (td2) {
+              var pal = el('div', 'pal');
+              pal.setAttribute('data-for', p[0]);
+              VCL16.forEach(function (x) {
+                var sw = el('button', 'sw' + (named && named[0] === x[0] ? ' cur' : ''));
+                sw.style.backgroundColor = x[1];
+                sw.title = x[0] + '　' + x[1];
+                sw.setAttribute('data-color', x[1]);
+                sw.disabled = !ed.inSource;
+                sw.addEventListener('click', function () { vscode.postMessage({ type: 'setLook', prop: p[0], value: x[1] }); });
+                pal.appendChild(sw);
+              });
+              td2.appendChild(pal);
+            }
           });
         }
         if (diffs) body.appendChild(el('div', 'pad small diffnote', '有 ' + diffs + ' 項和 BCB6 .dfm 的值不同（標色的列）；按 ↺ 改回 DFM 的值。'));
