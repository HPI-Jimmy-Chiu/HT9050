diff --git a/tools/vscode-htdesigner/test/panels_render.ps1 b/tools/vscode-htdesigner/test/panels_render.ps1
index 16d716d..3654ed1 100644
--- a/tools/vscode-htdesigner/test/panels_render.ps1
+++ b/tools/vscode-htdesigner/test/panels_render.ps1
@@ -462,9 +462,15 @@ if ($r9) {
   Check ($r9.hasButtons -and (($r9.dfmOrder | Select-Object -First 5) -join ',') -eq 'Left,Top,Width,Height,Caption' -and $r9.dfmOrder.Count -eq $r9.byName.Count) 'DFM order: as BCB6 wrote them (Left, Top, Width, Height, Caption ...)' (($r9.dfmOrder | Select-Object -First 6) -join ',')
   Check ($r9.cats -ge 2 -and ($r9.layoutRows -contains 'Left') -and ($r9.layoutRows -contains 'Width') -and $r9.catCount -eq $r9.byName.Count -and $r9.backToName) 'by category: groups (layout first, with Left / Width), no row lost; back to by name' "groups=$($r9.cats) layout=$($r9.layoutRows -join ',')"
 } else { $script:bad++ }
+$propsChecks = $propsChecks + @'
+/* (a component without the editable grid: its DFM list open -- the properties list is never empty-looking) */
+R.dfmOpenNoGrid = !document.querySelector('table.edit') ? !!(document.querySelector('details.sec[data-key="props"]') || {}).open : 'grid';
+R.dfmClosedWithGrid = document.querySelector('table.edit') ? !(document.querySelector('details.sec[data-key="props"]') || { open: true }).open : 'nogrid';
+'@
 $r2 = Render 'props_XST1' 'props.css' 'props.js' 'show' (Join-Path $dump 'props_XST1.json') $propsChecks
 if ($r2) {
   Check ($r2.errors.Count -eq 0 -and $r2.hasField -and $r2.hasXStart) 'props panel (XST1) renders the data field [Hotplate Form] X Start' ($r2.errors -join ' / ')
+  Check (($r2.dfmOpenNoGrid -eq $true) -or ($r2.dfmClosedWithGrid -eq $true)) 'the DFM list folded only behind the editable grid (without it: open, the properties list never empty)' "noGrid=$($r2.dfmOpenNoGrid) withGrid=$($r2.dfmClosedWithGrid)"
 } else { $script:bad++ }
 $ovChecks = @'
 R.rows = document.querySelectorAll('table.grid tbody tr').length;
