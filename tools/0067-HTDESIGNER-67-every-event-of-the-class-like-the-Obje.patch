+    row.handler = name;
+    if (this.props && this.props.data === data) this.props.show(data);
+    // what else it takes for the page's control to reach it (said, not written)
+    const left = [];
+    if (row.fe && !row.web) left.push('網頁：這一頁的 *_ev.js 事件清單（CTLS）加 [\'' + g.name + '\', \'' + row.fe + '\']');
+    if (row.fe && !row.server) left.push('伺服器：form.event 事件表（tools/editlist 或 tools/formbridge 的 \'events\'，再跑產生器）');
+    if (!row.fe) left.push('網頁不會送 ' + row.name + '（form.event 只接 OnClick／OnChange）');
+    vscode.window.showInformationMessage('已新增 ' + cls + '::' + name + '（' + path.basename(hFile) + ' 宣告、' + path.basename(cppFile) + ' 空的本體；都還沒存檔，Ctrl+Z 可以復原）。' +
+      (left.length ? '還要接上：' + left.join('；') + '。' : ''));
+    return { h: hFile, cpp: cppFile, name, left };
+  }
