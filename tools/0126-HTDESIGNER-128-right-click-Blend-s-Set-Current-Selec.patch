+    if (host) host.style.display = hd;
+    var fr = formRoot(), seen = [], out = [];
+    for (var i = 0; i < list.length; i++) {
+      var c = pick(list[i], false);
+      if (!c || c === host || seen.indexOf(c) >= 0 || (fr && c !== fr && !fr.contains(c))) continue;
