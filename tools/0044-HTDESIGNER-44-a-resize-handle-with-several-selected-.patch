+          var rg = hb && !hb.root ? allSel().map(function (x) { return { el: x, bx: boxOf(x) }; }).filter(function (g) { return g.bx && !g.bx.root; }) : [];
+          if (hb) startDrag(selEl, hb, dir, e, rg.length > 1 ? rg : null);
