+        const c0 = (fake._calls || []).length;
+        let r = null;
+        try { r = await hub.cmdAdd(it.cls, { into: '@form', x: 8, y }); } catch (e) { report.errors.push(page + ' add ' + it.cls + ': ' + (e && e.stack || e)); }
