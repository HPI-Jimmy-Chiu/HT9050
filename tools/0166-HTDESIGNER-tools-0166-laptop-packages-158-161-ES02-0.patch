+    panel.recv({ __htd: 1, type: 'ready', url: 'vscode-webview://x/index.html' });
+    for (let i = 0; i < 100 && !panel.posted.some(m => m.type === 'init'); i++) await sleep(50);
+    const d = hub.active;
