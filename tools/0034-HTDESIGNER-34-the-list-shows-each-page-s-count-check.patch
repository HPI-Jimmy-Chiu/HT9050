@@ -501,6 +501,9 @@ exports.run = async function () {
       const dgs = ours();
       ok(sumL && sumL.error === 1 && dgs.length === 1 && dgs[0].code === 'quote-cut', 'lint: HotPlate\'s cut style in the real Problems panel',
         dgs.map(x => x.code + '@' + (x.range.start.line + 1)).join(','));
