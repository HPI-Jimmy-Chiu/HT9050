           "type": "boolean",
           "default": true,
diff --git a/tools/vscode-htdesigner/test/smoke_extension.js b/tools/vscode-htdesigner/test/smoke_extension.js
index 0a1851e..70bffd6 100644
--- a/tools/vscode-htdesigner/test/smoke_extension.js
+++ b/tools/vscode-htdesigner/test/smoke_extension.js
@@ -841,6 +841,7 @@ async function main() {
       const rb = api.hub.runBar, rbCmds = () => Object.keys(rb.items).filter(k => k !== 'sim' && k !== 'dbg').map(k => {
         const c = rb.items[k].command; return k + '=' + (c ? (typeof c === 'string' ? c : c.command) : '-').replace('workbench.action.debug.', '').replace('ht9045Designer.run.', 'run.');
       }).join(' ');
+      fake._config['run.likeF5'] = false;   // (1006: ▶ = F5 by default -- this block tests the extension's own build, run.likeF5 off)
       const dbg0 = fake.debug;
       // (not the machine's real process list: a wb_serve running here would light ⏹ in the idle check)
       clearInterval(rb.procTimer); rb.procsAlive = false;
@@ -986,7 +987,29 @@ async function main() {
         ok(g1 && g1.refused === 'gdb' && !rb.building && warn && /gdb/.test(warn.args[0]) && /0xE0000027/.test(warn.args[0]) && g2 && g2.again && tgl.join() === 'run.debug',
           'Debug ▶ when gdb cannot start a program here: said why (nothing built, not "started"); 改用 Release 啟動 = Release, then ▶ again', JSON.stringify({ g1, g2, tgl, warn: warn && warn.args[0].slice(0, 50) }));
       }
-      ok(restartOk, '↺ restart (like Visual Studio): stop all -> rebuild -> start; lit while this tree\'s wb_* runs; nothing during a build', rsSeq.join(','));
+      // 1006 (EastSun: "方案總管那邊的 啟動按鈕 建置時 和我按F5 時好像不太一樣" + "我需要跟F5一樣"): ▶ by default = F5 -- the
+      // configuration picked in 執行與偵錯 (workbench.action.debug.start), nothing of its own built; a run going on stopped first
+      {
+        delete fake._config['run.likeF5'];
+        const ex0 = fake.commands.executeCommand, ran = [], sa0 = rb.stopAll, stops = [];
+        fake.commands.executeCommand = (id, ...a) => { ran.push(id); return ex0(id, ...a); };
+        rb.stopAll = async () => { stops.push(1); return { did: [] }; };
+        const sp0 = rb.spawn; let spawned = 0; rb.spawn = () => { spawned++; throw new Error('no'); };
+        const dbgF = fake.debug;
+        fake.debug = {};
+        const f1 = await fake._cmds['ht9045Designer.run.buildAndStart']();
+        fake.debug = { activeDebugSession: { configuration: {} } };
+        const f2 = await rb.buildAndStart();
+        fake.debug = dbgF; rb.update();
+        const tipF5 = /＝ F5/.test(rb.items.start.tooltip || '');
+        fake.commands.executeCommand = ex0; rb.stopAll = sa0; rb.spawn = sp0;
+        const pkgF5 = JSON.parse(fs.readFileSync(path.join(__dirname, '..', 'package.json'), 'utf8')).contributes.configuration.properties['ht9045Designer.run.likeF5'];
+        const got = { f1, f2, starts: ran.filter(x => x === 'workbench.action.debug.start').length, stops: stops.length, spawned, tipF5, cfg: !!(pkgF5 && pkgF5.default === true) };
+        ok(f1 && f1.likeF5 && f2 && f2.likeF5 && got.starts === 2 && got.stops === 1 && spawned === 0 && got.cfg,
+          '▶ = F5 by default: it starts the configuration picked in 執行與偵錯 (its own preLaunchTask builds), builds nothing of its own; a run going on is stopped first; run.likeF5 = false = the old ▶',
+          JSON.stringify(got));
+        fake._config['run.likeF5'] = false;
+      }      ok(restartOk, '↺ restart (like Visual Studio): stop all -> rebuild -> start; lit while this tree\'s wb_* runs; nothing during a build', rsSeq.join(','));
       // 1005 (WPF / Blend audit): Ctrl+D = duplicate the selection (10, 10 down-right), in the designer only (the CSV table keeps its own Ctrl+D)
       {
         const kb = JSON.parse(fs.readFileSync(path.join(__dirname, '..', 'package.json'), 'utf8')).contributes.keybindings.filter(k => k.key === 'ctrl+d');
