 var evClick = evSec && evSec.querySelector('.row.evg[data-event="OnClick"]');
 var evUp = evSec && evSec.querySelector('.row.evg[data-event="OnMouseUp"]');
 R.evClickTip = evClick ? evClick.title : '';
