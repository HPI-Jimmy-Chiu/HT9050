 tools/vscode-htdesigner/CHEATSHEET.md         |  1 +
 tools/vscode-htdesigner/README.md             |  2 +
 tools/vscode-htdesigner/media/props.css       |  2 +
 tools/vscode-htdesigner/media/props.js        | 44 +++++++++++++++++--
 tools/vscode-htdesigner/package.json          |  2 +-
 .../vscode-htdesigner/test/panels_render.ps1  | 26 +++++++++++
 6 files changed, 73 insertions(+), 4 deletions(-)

diff --git a/tools/vscode-htdesigner/CHEATSHEET.md b/tools/vscode-htdesigner/CHEATSHEET.md
index b25c8a3..1093d42 100644
--- a/tools/vscode-htdesigner/CHEATSHEET.md
