+/** 1010 review of 0.398 D1: the text reads as JSONC -- comments out (strings kept), trailing commas out, then JSON.parse */
+function validJsonc(text) {
+  const t = String(text || '').replace(/^\uFEFF/, '');
+  let out = '', i = 0;
+  while (i < t.length) {
+    const c = t[i];
+    if (c === '"') { let j = i + 1; while (j < t.length && t[j] !== '"') { if (t[j] === '\\') j++; j++; } out += t.slice(i, j + 1); i = j + 1; continue; }
+    if (c === '/' && t[i + 1] === '/') { while (i < t.length && t[i] !== '\n') i++; continue; }
+    if (c === '/' && t[i + 1] === '*') { const e = t.indexOf('*/', i + 2); i = e < 0 ? t.length : e + 2; out += ' '; continue; }
+    out += c; i++;
+  }
+  out = out.replace(/,(\s*[\]}])/g, '$1');
+  if (!out.trim()) return true;
+  try { JSON.parse(out); return true; } catch (e) { return false; }
+}
 
