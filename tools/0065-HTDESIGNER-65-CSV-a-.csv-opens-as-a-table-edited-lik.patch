+    var s = selRect(), ch = [];
+    for (var r = s.r0; r <= s.r1; r++) for (var c = s.c0; c <= s.c1; c++) if (D.rows[r] && c < D.rows[r].length && D.rows[r][c] !== '') ch.push({ r: r, c: c, v: '' });
