+  });
+
+  function insRow() {
+    if (D.readOnly) { showWarn(D.why || '這個檔案現在不能編輯。'); return; }
+    var s = selRect();
+    send({ type: 'insertRows', r: s.r0, count: s.r1 - s.r0 + 1 });
+  }
+  function delRow() {
+    if (D.readOnly) { showWarn(D.why || '這個檔案現在不能編輯。'); return; }
+    var s = selRect();
