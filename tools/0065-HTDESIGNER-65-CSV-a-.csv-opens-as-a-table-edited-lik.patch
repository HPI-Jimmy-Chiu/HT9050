+      for (var r = 0; r < nrows(); r++) {
+        var row = D.rows[r];
+        for (var c = 0; c < row.length; c++) if (row[c].toLowerCase().indexOf(find.q) >= 0) find.hits.push({ r: r, c: c });
+      }
+    }
+    var n = document.getElementById('findN');
