 tools/vscode-htdesigner/CHANGELOG.md          |  4 ++
 tools/vscode-htdesigner/HANDOVER.md           |  2 +
 tools/vscode-htdesigner/WPF_DIFF_LOG.md       |  1 +
 tools/vscode-htdesigner/extension.js          | 32 ++++++-------
 tools/vscode-htdesigner/package.json          | 34 +++++++++++---
 .../vscode-htdesigner/test/smoke_extension.js | 45 +++++++++++++------
 6 files changed, 84 insertions(+), 34 deletions(-)

