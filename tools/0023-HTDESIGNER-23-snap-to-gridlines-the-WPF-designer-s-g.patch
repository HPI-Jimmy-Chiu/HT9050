+  var host = null, sh = null, bH, bS, tH, tS, badge, handles = [], gX = null, gY = null, extraBoxes = [], grEl = null;
+  /* WPF "snap to gridlines": positions and sizes land on multiples of GRID.size (Alt = free) */
+  var GRID = { on: false, size: 8 };
