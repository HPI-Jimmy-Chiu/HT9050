 每一版多了什麼。怎麼操作看 [操作一覽](CHEATSHEET.md)，詳細說明看 README。
 
 ## 0.297.0
+- 機台端補丁（tools 0175，20261008）：**出貨組態不再另外整包重編**（EastSun 1008「編譯速度實在太慢 是不是有些編譯是不必要的?」）。工具列選過「模擬」或「Debug／Release」之後，F5 一律改建 build_f5_<模式>__… 自己的資料夾：出貨＋Debug 的 build_f5_ship_debug__build_integ_dbg_x86 跟現成的 build_integ_dbg_x86 設定完全相同（Debug、出貨），等於同一份程式再整包編一次（4 分鐘、73 個檔起跳）；出貨＋Release 還是 -O3 最佳化，比機台平常的出貨版更慢。現在只有「模擬」選開時才用自己的資料夾；出貨（模擬關）的 F5、▶、建置（Ctrl+F9）、全部重建都照 Debug／Release 鈕用現成的 build_integ_dbg_x86／build_integ_ship_x86（launch.json 的配對設定），已經編過的檔不再重編。
 - 機台端補丁（tools 0174，20261008）：**建置時依這台電腦當下可用的記憶體自動決定同時編譯幾個（-j）**（EastSun 1008「外掛可以自動偵測編譯記憶體 不要超過最大值嗎?」「可以自動偵測該電腦記憶體 編譯自動配置?」）。原本每條建置路徑都是 min(6, 核心數 − 2)，機台 28 核＝一律 6，跟記憶體無關（-j 4 全部重建把 7.7 GB 的機台弄當）。現在＝（可用記憶體 − 保留 1200 MB）÷ 每個 700 MB，再以「核心數 − 2」和上限 6 封頂，至少 1；機台實測一個 g++ -g 最多約 360 MB（wb_serve.cpp）。F5（模式建置）、▶、建置（Make, Ctrl+F9）、全部重建都照這個；tasks.json 的 IOWEB 建置工作改成 `${command:ht9045Designer.build.safeJobs}`。每次建置在 LOG 寫「可用記憶體 … → 同時 N 個編譯」。設定：build.autoJobs（關掉＝舊做法）、build.memPerJobMB、build.memReserveMB、build.maxJobs。
 - 機台端補丁（tools 0173，20261008）：合併筆電套件 202（0.293 → 0.297：啟動／暫停／停止／重新啟動移到新的大按鈕列）。只有測試檔 panels_render.ps1 有 2 處衝突：用筆電版的大按鈕列檢查，另外保留機台的「Debug／Release 鈕顯眼（18px、亮橘）」檢查（EastSun 1006）。機台自己的功能都還在。
 - **修正：上方執行列跑進檔案那一組、按鈕不見**（EastSun 1008「我畫面 按鈕不見了」）
diff --git a/tools/vscode-htdesigner/extension.js b/tools/vscode-htdesigner/extension.js
index 9d56175..1e8f000 100644
--- a/tools/vscode-htdesigner/extension.js
+++ b/tools/vscode-htdesigner/extension.js
@@ -251,7 +251,10 @@ class Hub {
           // wins): the Debug / Release button decides which of a Debug / Release pair of launch configurations F5 and ▶ run
           // (RunBar.pairedConfig: the build folder's "dbg" / "ship"); before variables are substituted, so the swapped
           // configuration's own preLaunchTask builds its own folder. 模擬 chosen on the toolbar = the F5 mode build as before.
-          if (!this.runBar.explicit('run.simulation')) {
+          // (1008 machine, EastSun「編譯速度實在太慢 是不是有些編譯是不必要的?」: a SHIPPING choice -- 模擬 off -- takes the pair too:
+          //  build_f5_ship_debug__* was a whole second compile of build_integ_dbg_x86 (same Debug + shipping), build_f5_ship_
+          //  release__* a whole -O3 one; only 模擬 chosen ON needs the mode build's own folder -- RunBar.useModeBuild)
+          if (!this.runBar.useModeBuild()) {
             let p = null;
             try { p = this.runBar.pairedConfig(cfg, folder); } catch (e) { this.logErr('F5 Debug／Release 配對', e); }
             if (p && p.cfg) {
@@ -8011,6 +8014,16 @@ class RunBar {
     const i = vscode.workspace.getConfiguration('ht9045Designer').inspect ? vscode.workspace.getConfiguration('ht9045Designer').inspect(k) : null;
     return !!i && [i.globalValue, i.workspaceValue, i.workspaceFolderValue].some(v => v !== undefined && v !== null);
   }
+  /** AI(W906-HTDESIGNER) 20261008 (machine; EastSun「編譯速度實在太慢 是不是有些編譯是不必要的?」): the F5 mode build -- its own
+   *  build_f5_<mode>__<folder>, a whole compile of its own -- only for 模擬 chosen ON. Shipping (Debug or Release) uses the
+   *  tree's Debug / Release pair of launch configurations and their folders, already built (pairedConfig). */
+  useModeBuild() { return this.explicit('run.simulation') && this.opt('run.simulation'); }
+  /** the program a shipping Make / Rebuild builds: the selected launch's, or its Debug / Release partner as the button says */
+  shipProgram(L, p) {
+    let pc = null;
+    try { pc = this.pairedConfig(L.cfg, L.folder); } catch (e) { pc = null; }
+    return pc && pc.cfg && typeof pc.cfg.program === 'string' ? pc.cfg.program.split('${workspaceFolder}').join(p.tree) : L.baseProgram;
+  }
   async selectedF5(folder, cfg) {
     if (!vscode.Task || !vscode.ProcessExecution) return cfg;
     // (1007, EastSun's ruling: the boxes never ticked = F5 starts the 執行與偵錯 configuration as it is -- the machine's
@@ -8159,7 +8172,7 @@ class RunBar {
     if (!p.tree) { vscode.window.showErrorMessage('找不到 C++ 移植樹（要建置的那棵）。'); return null; }
     const L = this.launchFor(p);
     if (!L.cfg || !L.baseProgram) { vscode.window.showErrorMessage(L.file + ' 裡沒有 wb_serve 的啟動設定，不知道要建哪一個。'); return null; }
-    const dir = (this.explicit('run.simulation') || this.explicit('run.debug')) ? path.join(p.tree, p.dir) : path.dirname(L.baseProgram);
+    const dir = this.useModeBuild() ? path.join(p.tree, p.dir) : path.dirname(this.shipProgram(L, p));   // (1008 machine: shipping = the pair's folder, no second compile)
     if (/^build$/i.test(path.basename(dir))) { vscode.window.showErrorMessage('build\\ 是 oracle 線的基準資料夾，不清除也不重建（CLAUDE.md 硬約束）。'); return null; }
     let cache = '';
     try { cache = fs.readFileSync(path.join(dir, 'CMakeCache.txt'), 'utf8'); } catch (e) { cache = ''; }
@@ -8194,9 +8207,9 @@ class RunBar {
     if (!p.tree) { vscode.window.showErrorMessage('找不到 C++ 移植樹（要建置的那棵）。'); return null; }
     const L = this.launchFor(p);
     if (!L.cfg || !L.baseProgram) { vscode.window.showErrorMessage(L.file + ' 裡沒有 wb_serve 的啟動設定，不知道要建哪一個。'); return null; }
-    const base = Object.assign({}, L.cfg, { program: L.baseProgram });
+    const base = Object.assign({}, L.cfg, { program: this.useModeBuild() ? L.baseProgram : this.shipProgram(L, p) });   // (1008 machine: shipping = the pair's folder)
     delete base.__htdOwnBuild;
-    if (this.explicit('run.simulation') || this.explicit('run.debug')) {
+    if (this.useModeBuild()) {
       const out = await this.selectedF5(L.folder, base);
       const ok = !!out && out !== base;
       const dir = ok ? path.dirname(out.program) : '';
diff --git a/tools/vscode-htdesigner/test/smoke_extension.js b/tools/vscode-htdesigner/test/smoke_extension.js
index e118a3d..e4ce212 100644
--- a/tools/vscode-htdesigner/test/smoke_extension.js
+++ b/tools/vscode-htdesigner/test/smoke_extension.js
@@ -1815,6 +1815,36 @@ async function main() {
       'build -j from this PC\'s memory (1008): the tasks.json command answers a number >= 1, the maximum holds, autoJobs off = min(6, cores - 2)',
       JSON.stringify({ s1, s2, s3, old }));
   }
+  // 1008 machine (EastSun「編譯速度實在太慢 是不是有些編譯是不必要的?」): a shipping choice (模擬 chosen OFF) no longer builds
+  // its own build_f5_<mode> folder -- F5 / ▶ take the Debug / Release pair, Make / Rebuild its folder; only 模擬 ON does
+  {
+    const rb = api.hub.runBar;
+    const prov = (fake._debugProviders || []).find(p => p.type === 'cppdbg');
+    const env = [{ name: 'W906_A', value: '1' }];
+    const DBG = { name: 'IOWEB DEBUG', type: 'cppdbg', request: 'launch', program: '${workspaceFolder}/build_integ_dbg_x86/wb_serve.exe', environment: env };
+    const REL = { name: 'IOWEB Release', type: 'cppdbg', request: 'launch', noDebug: true, program: '${workspaceFolder}/build_integ_ship_x86/wb_serve.exe', environment: env };
+    const gc0 = fake.workspace.getConfiguration, ex0 = rb.explicit, sf0 = rb.selectedF5;
+    const k0 = { sim: fake._config['run.simulation'], dbg: fake._config['run.debug'] };
+    fake.workspace.getConfiguration = sec => sec !== 'launch' ? gc0(sec) : { get: k => (k === 'configurations' ? [DBG, REL] : undefined) };
+    let modeCalls = 0;
+    rb.explicit = () => true;                                            // both chosen on the toolbar
+    rb.selectedF5 = async (f, c) => { modeCalls++; return Object.assign({}, c, { program: 'MODE' }); };
+    fake._config['run.simulation'] = false; fake._config['run.debug'] = false;   // shipping / Release
+    const r1 = prov ? await prov.provider.resolveDebugConfiguration(undefined, Object.assign({}, DBG)) : null;
+    const m1 = modeCalls;
+    const ship = rb.shipProgram({ cfg: DBG, folder: undefined, baseProgram: 'BASE' }, { tree: 'T' });
+    const useShip = rb.useModeBuild();
+    fake._config['run.simulation'] = true;                                // 模擬 ON: the mode build
+    const r2 = prov ? await prov.provider.resolveDebugConfiguration(undefined, Object.assign({}, DBG)) : null;
+    const useSim = rb.useModeBuild();
+    fake.workspace.getConfiguration = gc0; rb.explicit = ex0; rb.selectedF5 = sf0;
+    for (const [k, v] of [['run.simulation', k0.sim], ['run.debug', k0.dbg]]) { if (v === undefined) delete fake._config[k]; else fake._config[k] = v; }
+    const got = { r1: r1 && r1.name, m1, ship: String(ship).replace(/\\/g, '/'), useShip, r2: r2 && r2.program, modeCalls, useSim };
+    ok(got.r1 === 'IOWEB Release' && got.m1 === 0 && got.ship === 'T/build_integ_ship_x86/wb_serve.exe' && got.useShip === false &&
+      got.r2 === 'MODE' && got.modeCalls === 1 && got.useSim === true,
+      'shipping chosen = the existing Debug / Release folders, no build_f5_* second compile (1008); 模擬 chosen ON = the mode build',
+      JSON.stringify(got));
+  }
   // 1007 audit (props M): a position typed in the properties panel is written as typed where the source has px -- not the
   // change worked out from what the page's JS moved it to; a right / bottom the source never had is not written
   {
