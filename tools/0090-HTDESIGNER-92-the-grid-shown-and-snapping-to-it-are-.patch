     var bx = selEl ? boxOf(selEl) : null;
     var c = bx && !bx.root ? bx.node.offsetParent : null;
     if (!c || c === document.body || c === document.documentElement) c = formRoot();
@@ -582,7 +587,8 @@
     add('fitAll', '全部', '符合視窗：整個表單放進畫面（Fit all）');
