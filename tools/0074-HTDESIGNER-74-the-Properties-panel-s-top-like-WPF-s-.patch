 .sortbar { margin-top: 0; gap: 2px; }
+/* WPF's Name box and the Properties / Events (lightning bolt) buttons */
+.title { align-items: center; }
+.title .nlabel { color: var(--vscode-descriptionForeground); }
+.title .namebox { flex: 1 1 120px; min-width: 0; font-weight: 600; font-family: var(--vscode-editor-font-family); }
+.views { margin-top: 6px; display: flex; gap: 0; }
+.views button { flex: 0 0 auto; border-radius: 0; padding: 2px 12px; background: var(--vscode-button-secondaryBackground); color: var(--vscode-button-secondaryForeground); }
+.views button:first-child { border-radius: 2px 0 0 2px; }
+.views button:last-child { border-radius: 0 2px 2px 0; }
+.views button.on { background: var(--vscode-button-background); color: var(--vscode-button-foreground); }
 .title button.rename { padding: 0 4px; margin: 0 4px; background: transparent; color: var(--vscode-descriptionForeground); }
 .title button.rename:hover { color: var(--vscode-foreground); background: var(--vscode-button-secondaryHoverBackground); }
 table.edit tr.mixed td.k { font-style: italic; }
