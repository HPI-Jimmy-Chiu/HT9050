+  /** A golden (Big5) file as lines, cached by mtime. */
+  goldenLines(file) {
+    let st;
+    try { st = fs.statSync(file); } catch (e) { return null; }
+    this._goldenLines = this._goldenLines || new Map();
+    const hit = this._goldenLines.get(file);
