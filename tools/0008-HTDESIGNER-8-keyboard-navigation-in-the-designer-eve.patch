+
+        /* keyboard: up = parent component, down = first child, right = next sibling, Enter = default event */
+        var key = function (k) {
+          window.dispatchEvent(new KeyboardEvent('keydown', { key: k, bubbles: true, cancelable: true }));
+          var s = msgs('select').pop();
+          return s && s.info ? s.info.id : null;
+        };
+        R.keyUp = key('ArrowUp');
+        R.keyDown = key('ArrowDown');
+        R.keyRight = key('ArrowRight');
+        R.keyLeft = key('ArrowLeft');
+        var before = msgs('dblclick').length;
+        key('Enter');
+        R.keyEnterOpens = msgs('dblclick').length === before + 1;
       }
 
