--- a/tools/vscode-htdesigner/extension.js
+++ b/tools/vscode-htdesigner/extension.js
@@ -263,7 +263,7 @@ class Hub {
     const seq = ++this.selSeq;
     if (!info) { d.sel = null; this.showProps(d, null); return; }
     if (origin !== 'tree') this.tree.reveal(info.key);
-    if (origin === 'click' || origin === 'tree' || origin === 'find') this.syncSource(d, info.id);
+    if (origin === 'click' || origin === 'tree' || origin === 'find' || origin === 'key') this.syncSource(d, info.id);
     const sel = { info, data: null, promise: null };
     d.sel = sel;
     sel.promise = this.resolve(d, info, partial => {
@@ -1155,11 +1155,17 @@ class Designer {
         // runtime, so the probe gets the VCL class of every name from the IR
         const send = pi => {
           const classes = {};
+          const events = {};
           if (pi && pi.ir) {
-            for (const [n, node] of pi.ir.byName) classes[n] = node.class;
+            for (const [n, node] of pi.ir.byName) {
+              classes[n] = node.class;
+              const ev = Object.keys(node.events || {});
+              if (ev.length && node !== pi.ir.root) events[n] = ev;
+            }
             if (pi.ir.formClass) classes['@form'] = pi.ir.formClass;
+            if (pi.ir.root && pi.ir.root.events) events['@form'] = Object.keys(pi.ir.root.events);
           }
-          this.post({ type: 'init', mode: this.mode, selectId: this.lastSelId, scroll: this.scroll, classes });
+          this.post({ type: 'init', mode: this.mode, selectId: this.lastSelId, scroll: this.scroll, classes, events });
         };
         this.info.then(send, () => send(null));
         clearTimeout(this.diagTimer);
diff --git a/tools/vscode-htdesigner/media/probe.js b/tools/vscode-htdesigner/media/probe.js
index baa2fb4..21eb06f 100644
--- a/tools/vscode-htdesigner/media/probe.js
+++ b/tools/vscode-htdesigner/media/probe.js
@@ -191,6 +191,7 @@
   function isTab(t) { return !!closestSafe(t, '.pcTabs > .tab, .tabs > .tab, [role="tab"]'); }
 
   var CLS = {};   /* name -> VCL class, from the IR (sent with 'init') */
+  var EVS = {};   /* name -> ["OnClick", ...], from the IR (sent with 'init') */
   function vclOf(el) {
     var t = (el && el.getAttribute && el.getAttribute('title')) || '';
     var m = /^\s*([A-Za-z_@][\w]*)\s*:\s*(T\w+)/.exec(t);
@@ -241,8 +242,11 @@
   }
   function labelOf(el, r) {
     var v = vclOf(el);
-    var name = idOf(el) || el.tagName.toLowerCase();
-    return name + (v.cls ? ' : ' + v.cls : '') + '   ' + Math.round(r.width) + '×' + Math.round(r.height);
+    var id = idOf(el);
+    var name = id || el.tagName.toLowerCase();
+    var ev = id && Object.prototype.hasOwnProperty.call(EVS, id) ? EVS[id] : null;
+    var evs = ev && ev.length ? '  · ' + ev.slice(0, 3).join(', ') + (ev.length > 3 ? ' …' : '') : '';
+    return name + (v.cls ? ' : ' + v.cls : '') + evs + '   ' + Math.round(r.width) + '×' + Math.round(r.height);
   }
   function place(box, tag, el) {
     if (!el || !el.isConnected) { box.style.display = 'none'; tag.style.display = 'none'; return; }
@@ -418,8 +422,43 @@
   origAdd.call(document, 'mouseleave', function () { hoverEl = null; scheduleDraw(); }, true);
   origAdd.call(window, 'scroll', scheduleDraw, { capture: true, passive: true });
   origAdd.call(window, 'resize', scheduleDraw, true);
+  /* keyboard, design mode, a component selected: move like the WPF document outline.
+     Only plain arrows / Enter / Esc -- every other key (VS Code shortcuts) is left alone. */
+  function compParent(el) {
+    var fr = formRoot();
+    for (var p = el.parentElement; p && p !== document.body && p !== document.documentElement; p = p.parentElement) {
+      if (p.id || p === fr) return p;
+    }
+    return null;
+  }
+  function compChildren(parent) {
+    var scope = parent || document.body;
+    var all = scope.querySelectorAll('[id]');
+    var out = [];
+    for (var i = 0; i < all.length; i++) {
+      var x = all[i];
+      if (/^(SCRIPT|STYLE|TEMPLATE|LINK|META)$/.test(x.tagName)) continue;
+      if (compParent(x) === (parent || null)) out.push(x);
+    }
+    return out;
+  }
   origAdd.call(window, 'keydown', function (e) {
-    if (e.key === 'Escape' && mode === 'design' && selEl) select(null, 'key', false);
+    if (mode !== 'design' || !selEl || e.ctrlKey || e.altKey || e.metaKey || e.shiftKey) return;
+    var t = e.target;
+    if (t && /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName)) return;
+    var next = null;
+    if (e.key === 'Escape') { select(null, 'key', false); return; }
+    if (e.key === 'Enter') { e.preventDefault(); post({ type: 'dblclick', key: keyOf(selEl) }); return; }
+    if (e.key === 'ArrowUp') next = compParent(selEl);
+    else if (e.key === 'ArrowDown') next = compChildren(selEl)[0] || null;
+    else if (e.key === 'ArrowLeft' || e.key === 'ArrowRight') {
+      var sib = compChildren(compParent(selEl));
+      var i = sib.indexOf(selEl);
+      if (i >= 0) next = sib[i + (e.key === 'ArrowRight' ? 1 : -1)] || null;
+    } else return;
+    e.preventDefault();
+    e.stopImmediatePropagation();
+    if (next) { selEl = null; select(next, 'key', true); }
   }, true);
   setInterval(function () { if (selEl) scheduleDraw(); }, 400);
 
@@ -486,6 +525,7 @@
     switch (m.type) {
       case 'init':
         if (m.classes && typeof m.classes === 'object') { CLS = m.classes; lastSig = ''; scheduleTree(); }
+        if (m.events && typeof m.events === 'object') EVS = m.events;
         if (m.mode) { mode = m.mode; drawBadge(); }
         if (m.scroll) { try { window.scrollTo(m.scroll.x || 0, m.scroll.y || 0); } catch (x) { /* ignore */ } }
         if (m.selectId) { var el0 = byId(m.selectId); if (el0) select(el0, 'init', !m.scroll); }
