diff --git a/tools/vscode-htdesigner/lib/cppstub.js b/tools/vscode-htdesigner/lib/cppstub.js
index 97070cd..2f06038 100644
--- a/tools/vscode-htdesigner/lib/cppstub.js
+++ b/tools/vscode-htdesigner/lib/cppstub.js
