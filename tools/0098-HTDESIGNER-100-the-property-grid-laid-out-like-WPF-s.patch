+/* WPF's property grid (EastSun 20260930: "像wpf讓使用者看起來條理分明"): three fixed columns -- the name (one line,
+   cut with …), the value (fills the rest, never wider than the panel), the property marker at the right edge;
+   category headings as bands; nothing under a value */
+table.kv.edit col.ck { width: 38%; }
+table.kv.edit col.cm { width: 20px; }
+table.kv.edit td { padding: 2px 6px; vertical-align: middle; }
+table.kv.edit td.k { width: 38%; padding-left: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; word-break: normal; }
+table.kv.edit td.v { white-space: nowrap; overflow: hidden; word-break: normal; }
+table.kv.edit td.m { width: 16px; padding: 2px 6px 2px 0; text-align: center; }
+table.kv.edit td.m button.reset.marker { margin: 0; }
+table.edit td.v input.txt, table.edit td.v select.txt { width: 100%; max-width: 100%; box-sizing: border-box; }
+table.edit td.v input.num { width: 72px; }
+table.edit td.v input.hex { width: 72px; margin-left: 4px; vertical-align: middle; font: inherit; font-family: var(--vscode-editor-font-family);
+  color: var(--vscode-input-foreground); background: var(--vscode-input-background); border: 1px solid var(--vscode-input-border, transparent); padding: 0 4px; }
+table.edit td.v input.hex.bad { border-color: var(--vscode-inputValidation-errorBorder, #be1100); }
+table.edit td.v button.paltog { margin-left: 2px; padding: 0 4px; vertical-align: middle; line-height: 1.2; }
+table.edit .pal { display: none; white-space: normal; }
+table.edit .pal.open { display: flex; }
+/* the DFM value only where it differs (the marker's tooltip always has it); a longer note behind ⓘ */
+table.edit .dfmv { display: none; }
+table.edit tr.diff .dfmv { display: inline; }
+table.edit .tip { margin-left: 6px; color: var(--vscode-descriptionForeground); cursor: help; font-size: .9em; }
+table.edit tr.cathead td.subhead { padding: 3px 6px; font-weight: 600; color: var(--vscode-foreground);
+  background: var(--vscode-sideBarSectionHeader-background, rgba(128,128,128,.12)); border-bottom: 1px solid var(--vscode-panel-border, rgba(128,128,128,.2)); }
+table.kv.edit tr.cathead:hover td { background: var(--vscode-sideBarSectionHeader-background, rgba(128,128,128,.16)); }
 .foot { padding: 8px 12px; color: var(--vscode-descriptionForeground); font-size: .9em; line-height: 1.5; }
