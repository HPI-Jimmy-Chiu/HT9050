 tools/vscode-htdesigner/extension.js          | 67 +++++++++++++++++--
 tools/vscode-htdesigner/package.json          |  2 +-
 .../test/integration/index.js                 | 27 ++++++++
 .../vscode-htdesigner/test/smoke_extension.js | 16 +++++
 5 files changed, 110 insertions(+), 8 deletions(-)

diff --git a/tools/vscode-htdesigner/CHANGELOG.md b/tools/vscode-htdesigner/CHANGELOG.md
index 51c9342..18289cd 100644
--- a/tools/vscode-htdesigner/CHANGELOG.md
