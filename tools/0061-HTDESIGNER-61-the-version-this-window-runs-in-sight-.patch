From 58cf527bf40cdae81c090e6669f7c2d14d279af1 Mon Sep 17 00:00:00 2001
From: "HT9045 Machine (V906)" <Claude_RDBC_02@honprec.com>
Date: Wed, 30 Sep 2026 08:38:35 +0800
Subject: [PATCH] HTDESIGNER-61: the version this window runs, in sight
 (0.61.0)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

EastSun's screenshot still showed "HT9045 設計檢視" with only 元件 and
屬性與事件: 0.60.0 was installed (extensions.json says so) but his VS Code
window, open since the day before, still ran a version from before the 頁面
list (0.16). A window keeps the extension it loaded until it is reloaded.
- the 頁面 view's title carries the running version ("頁面 v0.61.0")
- the status bar page switcher's tooltip and 顯示偵測到的資料夾 say it too
- README / CHANGELOG: every new install needs Developer: Reload Window

Tests: smoke (the view's description = v + the package version), real VS
Code (the same, read from vscode.extensions).

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 tools/vscode-htdesigner/CHANGELOG.md              | 4 ++++
 tools/vscode-htdesigner/README.md                 | 4 +++-
 tools/vscode-htdesigner/extension.js              | 8 ++++++--
 tools/vscode-htdesigner/package.json              | 2 +-
 tools/vscode-htdesigner/test/integration/index.js | 6 ++++--
 tools/vscode-htdesigner/test/smoke_extension.js   | 3 ++-
 6 files changed, 20 insertions(+), 7 deletions(-)

diff --git a/tools/vscode-htdesigner/CHANGELOG.md b/tools/vscode-htdesigner/CHANGELOG.md
index 3e8b711..3db943c 100644
--- a/tools/vscode-htdesigner/CHANGELOG.md
+++ b/tools/vscode-htdesigner/CHANGELOG.md
@@ -2,6 +2,10 @@
 
 每一版多了什麼。怎麼操作看 [操作一覽](CHEATSHEET.md)，詳細說明看 README。
 
+## 0.61.0
+- 「頁面」區塊標題旁邊顯示**這個視窗正在跑的版本**（例如「頁面 v0.61.0」），狀態列的換頁按鈕提示、「顯示偵測到的資料夾」也寫出來。
+  ⚠ 裝了新版之後，**已經開著的 VS Code 視窗要重新載入**（`Ctrl+Shift+P` →「Developer: Reload Window」）才會換成新版。
+
 ## 0.60.0
 - **改名「HTML 視覺設計工具」**：不只 HT9045，同架構（BCB6 → 網頁 HMI ＋ C++）的軟體都能用。命令面板的前綴是「HTML設計:」。
   資料夾改成**照結構自動找**（有 `page\` 的網頁資料夾、有 `tools\dfm2rc`＋`forms\` 的 C++ 移植樹、有 `main.dfm` 的 BCB6 原始碼），不必叫 HT9011UC_…。
diff --git a/tools/vscode-htdesigner/README.md b/tools/vscode-htdesigner/README.md
index eb4e902..16a98d2 100644
--- a/tools/vscode-htdesigner/README.md
+++ b/tools/vscode-htdesigner/README.md
@@ -26,7 +26,9 @@ powershell -NoProfile -ExecutionPolicy Bypass -File tools\vscode-htdesigner\pack
 code --install-extension tools\vscode-htdesigner\dist\ht9045-html-designer-<版本>.vsix --force
 ```
 
-裝好後在 VS Code 按 `Ctrl+Shift+P` →「Developer: Reload Window」。
+裝好後在 VS Code 按 `Ctrl+Shift+P` →「Developer: Reload Window」（中文介面「開發人員: 重新載入視窗」）。
+**⚠ 每次裝新版都要做這一步**：已經開著的視窗會一直跑舊版，直到重新載入或重開 VS Code。
+現在跑的是哪一版，看側邊欄「頁面」標題旁邊的版本號（例如 `v0.61.0`）。
 左邊活動列會多一個「HTML 視覺設計」圖示。這份說明隨時可以用「HTML設計: 設計檢視使用說明」（或元件樹標題列的 ? 圖示）打開。
 
 移除：延伸模組面板找「HTML 視覺設計工具」→ 解除安裝。
diff --git a/tools/vscode-htdesigner/extension.js b/tools/vscode-htdesigner/extension.js
index f9179b5..ef71d02 100644
--- a/tools/vscode-htdesigner/extension.js
+++ b/tools/vscode-htdesigner/extension.js
@@ -105,6 +105,9 @@ class Hub {
     this.pages = new PageTree(this);
     this.pageView = vscode.window.createTreeView('ht9045Designer.pages', { treeDataProvider: this.pages, showCollapseAll: true });
     if (this.pageView.onDidChangeVisibility) this.pageView.onDidChangeVisibility(e => { if (e.visible) this.pages.revealActive(); });
+    // the version this window runs, in sight: after installing a new one, a window not reloaded still runs the old
+    this.version = (ctx.extension && ctx.extension.packageJSON && ctx.extension.packageJSON.version) || '';
+    if (this.version) this.pageView.description = 'v' + this.version;
     // 工具箱: new components (the generator's markup)
     this.toolboxView = vscode.window.createTreeView('ht9045Designer.toolbox', { treeDataProvider: new ToolboxTree() });
     this.props = new PropsView(this);
@@ -484,7 +487,8 @@ class Hub {
     const d = this.active;
     if (this.pageStatus) {
       this.pageStatus.text = '$(file-code) ' + (d ? path.basename(d.file) : '選擇頁面') + ' $(chevron-down)';
-      this.pageStatus.tooltip = (d ? '目前：' + d.file + '\n' : '') + '按這裡：換一頁（選一個 HTML 頁面，用設計檢視開啟）';
+      this.pageStatus.tooltip = (d ? '目前：' + d.file + '\n' : '') + '按這裡：換一頁（選一個 HTML 頁面，用設計檢視開啟）' +
+        (this.version ? '\nHTML 視覺設計工具 v' + this.version : '');
     }
     if (!d) { this.status.hide(); return; }
     const g = this.gridState();
@@ -2345,7 +2349,7 @@ class Hub {
   cmdShowInfo() {
     const r = this.active ? this.active.r : roots.resolveRoots(null, this.wsFolders(), this.over());
     this.out.appendLine('');
-    this.out.appendLine('=== HTML 視覺設計：偵測結果 ===');
+    this.out.appendLine('=== HTML 視覺設計：偵測結果 ===' + (this.version ? '（這個視窗跑的是 v' + this.version + '）' : ''));
     this.out.appendLine('web     ' + r.webRoot);
     this.out.appendLine('port    ' + r.portRoot);
     this.out.appendLine('ir      ' + r.irRoot);
