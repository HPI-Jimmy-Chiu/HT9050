diff --git a/tools/vscode-htdesigner/extension.js b/tools/vscode-htdesigner/extension.js
index e4e033d7..65600d2d 100644
--- a/tools/vscode-htdesigner/extension.js
+++ b/tools/vscode-htdesigner/extension.js
@@ -1368,6 +1368,36 @@ class Hub {
   markAll(key) {
     const SHARED = /^htd\.design(Hidden|Locked|Notes)$/;
     const ws = this.ctx.workspaceState, gs = this.ctx.globalState;
+    // (1010: the shared (global) state answered the value from BEFORE this window's own write once in a while (an echo / an
+    //  older snapshot written out by a window with another key) and "unlock all" left the page locked in the kept list.
+    //  Review of 0.400 / 0.401 / 0.402: told apart PER PAGE by the time each page was last written (key + '.rev' = { page:
+    //  { w, t } }) -- within 10 s of this window writing a page, a value of that page stamped earlier than that write (or not
+    //  stamped) is old: ours counts and is put back; a later stamp (another window wrote after us) is taken. Pages this
+    //  window did not write are always as the shared state has them; what is taken becomes the known value)
+    const mc = this._markCache && this._markCache[key];
+    if (mc && this.markMono() - mc.at < 10000 && mc.mine) {
+      const st0 = SHARED.test(key) && gs ? gs : ws;
+      const cur = Object.assign({}, (st0 && st0.get ? st0.get(key) : null) || {});
+      const rv0 = st0 && st0.get ? st0.get(key + '.rev') : null;
+      const rev = rv0 && typeof rv0 === 'object' && !('w' in rv0) ? Object.assign({}, rv0) : {};
+      let back = false;
+      for (const p of Object.keys(mc.mine)) {
+        const t = mc.mine[p], r = rev[p];
+        // written after ours: taken -- and the page moves on to that stamp (review of 0.403 #1: our own late echo, stamped
+        //  with our earlier time, then put the lock back over the other window's unlock)
+        const hs = (mc.won && mc.won[p]) || { w: this.markWin(), t };
+        if (r && typeof r.t === 'number' && (r.t > hs.t || (r.t === hs.t && String(r.w) > String(hs.w)))) { mc.mine[p] = r.t; (mc.won = mc.won || {})[p] = r; continue; }
+        if (r && r.t === hs.t && r.w === hs.w) continue;
+        const ours = mc.all[p];
+        if (JSON.stringify(cur[p] === undefined ? null : cur[p]) === JSON.stringify(ours === undefined ? null : ours)) continue;
+        if (ours === undefined) delete cur[p]; else cur[p] = JSON.parse(JSON.stringify(ours));
+        rev[p] = (mc.won && mc.won[p]) || { w: this.markWin(), t };
+        back = true;
+      }
+      if (back) { try { if (st0 && st0.update) { Promise.resolve(st0.update(key, cur)).catch(() => null); Promise.resolve(st0.update(key + '.rev', rev)).catch(() => null); } } catch (e) { /* answered anyway */ } }
+      mc.all = JSON.parse(JSON.stringify(cur));   // (review of 0.402 #2: the last known value -- another window's taken too)
