+// ---------------------------------------------------------------------------
+/** 工具箱 (WPF Toolbox): the component classes a page can get; a click adds one. */
+class ToolboxTree {
+  getChildren(n) { return n ? [] : toolbox.ITEMS; }
+  getTreeItem(it) {
+    const item = new vscode.TreeItem(it.label, vscode.TreeItemCollapsibleState.None);
+    item.id = 'tool:' + it.cls;
+    item.description = it.note + '　' + it.cls;
+    item.tooltip = it.cls + '：' + it.note + '\n\n點一下＝新增一個（名稱 ' + it.base + '1、' + it.base + '2…）：\n' +
+      '選了 Panel／GroupBox／分頁／表單 → 放進去（左上 8,8）\n選了其他元件 → 放在它下面\n\n寫進 HTML 原始碼，Ctrl+Z 復原。';
+    item.iconPath = new vscode.ThemeIcon(it.icon);
+    item.command = { command: 'ht9045Designer.toolboxAdd', title: '新增', arguments: [it.cls] };
+    item.contextValue = 'tool';
+    return item;
+  }
+}
