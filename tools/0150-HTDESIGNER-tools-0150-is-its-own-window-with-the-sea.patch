+/* AI(W906-HTDESIGNER) 20261003: the 尋找 window (Visual Studio's Find in Files + Find Results) */
+html, body { height: 100%; }
+body { margin: 0; padding: 8px 10px; box-sizing: border-box; display: flex; flex-direction: column; gap: 8px;
+  background: var(--vscode-editor-background); color: var(--vscode-foreground); font: var(--vscode-font-size) var(--vscode-font-family); }
+#top { display: flex; flex-direction: column; gap: 6px; flex: none; }
+.row { display: flex; align-items: center; gap: 8px; }
+.row > label { width: 64px; flex: none; }
+.row.opts { padding-left: 72px; gap: 16px; }
+.row.opts label { display: flex; align-items: center; gap: 4px; cursor: pointer; }
+input[type=text], select { flex: 1; min-width: 0; padding: 4px 6px; background: var(--vscode-input-background); color: var(--vscode-input-foreground);
+  border: 1px solid var(--vscode-input-border, var(--vscode-panel-border)); font: inherit; }
+input[type=text]:focus, select:focus { outline: 1px solid var(--vscode-focusBorder); outline-offset: -1px; }
+button { font: inherit; cursor: pointer; }
+button.pri { padding: 4px 14px; background: var(--vscode-button-background); color: var(--vscode-button-foreground); border: 0; }
+button.pri:hover { background: var(--vscode-button-hoverBackground); }
+button.lnk { margin-left: auto; background: none; border: 0; color: var(--vscode-textLink-foreground); padding: 0 2px; }
+#split { flex: 1; min-height: 0; display: flex; gap: 10px; }
+section { display: flex; flex-direction: column; min-height: 0; border: 2px solid var(--vscode-panel-border); }
+#hist { width: 34%; min-width: 160px; }
+#out { flex: 1; min-width: 0; }
+h3 { display: flex; align-items: center; margin: 0; padding: 4px 8px; font-size: inherit; font-weight: 600;
+  background: var(--vscode-sideBarSectionHeader-background, rgba(128,128,128,.15)); }
+ul { list-style: none; margin: 0; padding: 0; overflow: auto; flex: 1; }
+#hl li { display: flex; flex-direction: column; position: relative; padding: 4px 26px 4px 8px; cursor: pointer; border-bottom: 1px solid var(--vscode-panel-border); }
+#hl li:hover, .h:hover { background: var(--vscode-list-hoverBackground); }
+.hq { font-weight: 600; word-break: break-all; }
+.hm { opacity: .75; font-size: .92em; }
+.x { position: absolute; right: 4px; top: 4px; background: none; border: 0; color: var(--vscode-foreground); opacity: .6; }
+.x:hover { opacity: 1; }
+#rl { overflow: auto; flex: 1; font-family: var(--vscode-editor-font-family); font-size: var(--vscode-editor-font-size); }
+.f { padding: 4px 8px 2px; font-weight: 600; font-family: var(--vscode-font-family); position: sticky; top: 0; background: var(--vscode-editor-background); }
+.fa { margin-left: 8px; opacity: .6; font-weight: normal; }
+.h { padding: 1px 8px 1px 24px; white-space: pre; cursor: pointer; overflow: hidden; text-overflow: ellipsis; }
+.h.sel { background: var(--vscode-list-activeSelectionBackground); color: var(--vscode-list-activeSelectionForeground); }
+.ln { display: inline-block; min-width: 44px; margin-right: 8px; text-align: right; opacity: .6; }
+mark { background: var(--vscode-editor-findMatchHighlightBackground, #ea5c0055); color: inherit; }
+.none { padding: 6px 8px; opacity: .7; }
