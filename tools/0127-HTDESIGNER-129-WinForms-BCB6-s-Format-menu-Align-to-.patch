+    this.applyDesignLocked(d, Array.from(new Set([...(d.designLocked || []), ...top])));
+    vscode.window.setStatusBarMessage('$(lock) 全部鎖定：表單上的 ' + top.length + ' 個元件（和它們裡面的）在設計畫面不能移動、改大小、刪除；「全部解除鎖定」解開（原始碼沒改）', 6000);
+    return { locked: top };
+  }
