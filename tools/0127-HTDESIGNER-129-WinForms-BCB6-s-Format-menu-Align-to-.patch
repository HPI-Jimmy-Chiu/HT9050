+  designLockAll() {
+    const d = this.active;
+    if (!d || !d.treeData) return null;
+    const form = d.treeData.find(r => r[7]);
+    const top = form ? d.treeData.filter(r => r[1] === form[0] && r[2] && !r[7]).map(r => r[2]) : [];
