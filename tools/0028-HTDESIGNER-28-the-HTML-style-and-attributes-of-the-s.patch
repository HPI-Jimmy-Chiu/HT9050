+        i.addEventListener('keydown', function (e) {
+          if (e.key === 'Enter') finish(true);
+          else if (e.key === 'Escape') finish(false);
+        });
+        i.addEventListener('blur', function () { finish(true); });
+      });
+    }
+    tb.appendChild(tr);
+    return tr;
+  }
