+        canDel ? '・C++ 的 ' + cls + '::' + fn + '（' + path.basename(ff.hFile) + ' 的宣告、' + path.basename(ff.cppFile) + ' 的整個函式' + (bodyLines ? '——裡面有 ' + bodyLines + ' 行程式碼，會一起刪掉' : '，裡面是空的') + '）' : null].filter(Boolean);
