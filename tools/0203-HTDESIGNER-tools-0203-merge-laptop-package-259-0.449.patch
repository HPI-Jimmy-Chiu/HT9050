+  /**
+   * 1010 review of solution #1: a file moved / renamed in VS Code's own Explorer -- what still names it by the old path is
+   * said (CMakeLists, #include, the web's references): nothing was, and the next configure stopped at "Cannot find source file"
+   */
+  async warnMovedElsewhere(p, to) {
+    let isDir = false;
+    try { isDir = fs.statSync(to).isDirectory(); } catch (e) { return; }
+    const notes = [];
+    const tree = this.portTree();
+    if (!isDir && tree && this.inTreeOf(tree, p)) {
+      const relOld = path.relative(tree, p).split(path.sep).join('/');
+      let n = 0;
+      try { for (const cd of await this.cmakeDocs(tree)) n += cmakelists.refsAll(cd.doc.getText(), relOld, cd.dir).length; } catch (e) { /* not read */ }
