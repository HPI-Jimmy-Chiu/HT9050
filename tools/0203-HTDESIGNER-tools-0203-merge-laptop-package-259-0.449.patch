+      if (/\.(h|hh|hpp|hxx)$/i.test(p)) { let inc = 0; try { inc = await this.includesOf(tree, relOld, false); } catch (e) { inc = 0; } if (inc) notes.push(inc + ' 個檔的 #include 用到它'); }
     }
