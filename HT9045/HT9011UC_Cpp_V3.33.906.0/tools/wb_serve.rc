// Steven 20260925：wb_serve.exe 版本資源。golden 的 asHandlerVersion 讀 exe 的版本資源（BCB 專案 FileVersion，
// VerInfo::GetMainVersion／GetFileVersion，golden main.cpp:9759-9761）；這棵移植樹是 V3.33.906.0。
#include <winver.h>
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 3,33,906,0
 PRODUCTVERSION 3,33,906,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "HonPrec"
            VALUE "FileDescription", "HT9045 wb_serve (V906 C++ port)"
            VALUE "FileVersion", "3.33.906.0"
            VALUE "OriginalFilename", "wb_serve.exe"
            VALUE "ProductName", "HT9045"
            VALUE "ProductVersion", "3.33.906.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
