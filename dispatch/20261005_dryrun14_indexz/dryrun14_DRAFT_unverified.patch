+// ---- AI(W906-HT9050-DRYRUN-14) 20261005: vacuum (see the file header) ----
+enum { kVacOn = 1, kVacOff = 2, kBreakOff = 3 };
+TMySucker &Sucker(int head) { return head == 0 ? InArmSuck.Suck[0][0] : head == 1 ? FTestSuck.Suck[0][0] : OutArmSuck.Suck[0][0]; }
+const char *HeadName(int head) { return head == 0 ? "In Arm" : head == 1 ? "Index" : "Out Arm"; }
+bool HeadUsed(int head) { return head == 1 || W906_HT9050_DRYRUN_ARM_VACUUM; }
+void VacIo(int head, int op)
+{
+    if (!HeadUsed(head)) return;
+    if (g_W906DryRunVacIo) { g_W906DryRunVacIo(head, op); return; }
+    TMySucker &s = Sucker(head);
+    if (op == kVacOn) s.On(); else if (op == kVacOff) s.Off(); else s.OffDestroy();
+}
+bool VacMade(int head)
+{
+    if (!HeadUsed(head)) return true;
+    if (g_W906DryRunVacSensor) return g_W906DryRunVacSensor(head);
+    TMySucker &s = Sucker(head);
+    return s.Enable == false || s.W906_GetStatusAllOn();   // Enable=0: golden TMySucker::Sensor() answers true
+}
+// Pick: vacuum on (once per step entry), then its sensor. false = keep waiting, the reason in s_why (the Z stays where it is).
+bool VacPick(int head)
+{
+    if (!s_ioIssued) { VacIo(head, kVacOn); s_ioIssued = true; }
+    if (VacMade(head)) return true;
+    const unsigned long t = Elapsed();
+    const std::string h = HeadName(head);
+    if (t < (unsigned long)W906_HT9050_DRYRUN_VAC_WAIT_MS)
+        s_why = h + " vacuum on, waiting for its vacuum sensor / " + h + " 真空已開，等待真空感測器";
+    else
+    {
+        s_why = "NO IC: " + h + " vacuum sensor not on after " + std::to_string(W906_HT9050_DRYRUN_VAC_WAIT_MS) +
+                " ms -- the Z stays down, it is not raised without the IC (vacuum kept on; check the IC / the sensor, or PAUSE + HOME) / 沒吸到 IC：" +
+                h + " 真空感測器 " + std::to_string(W906_HT9050_DRYRUN_VAC_WAIT_MS) + " ms 內沒亮，Z 軸停在下面不上升（真空保持開啟；請確認 IC／感測器，或 PAUSE 後回原點）";
+        if (g_W906DryRunVacSensor == 0 && (LastSet.iRealDummy == DUMMY || LastSet.iRealDummy == HAS_TRAY))
+            s_why += " [run mode DUMMY / HAS_TRAY: golden TMySucker::On opens no vacuum / 執行模式 DUMMY／HAS_TRAY：原版 On() 不開真空]";
+    }
+    return false;
+}
+// Release: vacuum off + break on, W906_HT9050_DRYRUN_BLOW_MS, break off. true = done.
+bool VacRelease(int head)
+{
+    if (!HeadUsed(head)) return true;
+    if (!s_ioIssued) { VacIo(head, kVacOff); s_ioIssued = true; }
+    if (Elapsed() < (unsigned long)W906_HT9050_DRYRUN_BLOW_MS) return false;
+    VacIo(head, kBreakOff);
+    return true;
+}
