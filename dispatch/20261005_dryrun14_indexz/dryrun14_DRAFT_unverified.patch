+// ---- AI(W906-HT9050-DRYRUN-14) 20261005: Index Z1 (MTestZ1: a PCI-1203 axis behind the Galil route on HT9050) ----
+// Speed: the dry-run % of the axis's JogHighSpeed (the route runs min(SP, PJogHighSpeed), EtherCAT/Pci1203GaliRouteCore.h); 30000 (the
+// full HOME's Z1 speed, uhome.cpp ProcessMotorHome 700 / 1260 / 1520) when the table gives none.
+int Z1Speed()
+{
+    const int sp = (int)((long long)MOT[MTestZ1].Motor->PJogHighSpeed * W906_HT9050_DRYRUN_SPEED / 100);
+    return sp > 0 ? sp : 30000;
+}
+// The Galil move flags of MTestZ1 back to "no move pending" -- golden TfHome::InitGali_HomeTask (uhome.cpp) for Z1. Used after a stop the
+// dry run did not issue or did issue (PAUSE: StopAllMotor's VS0;SP0 / our ST): Gali_MotMove would otherwise keep its MovFlag, find the
+// axis still and short of the target and raise the Index position JAM instead of re-issuing the move.
+void Z1Rearm()
+{
+    IndexZCanMove[0] = IndexZCanMove[1] = true;
+    MOT[MTestZ1].MovFlag = false;
+    MOT[MTestZ1].bScanFlag = false;
+    MOT[MTestZ1].GaliSofDelayCount = 0;
+}
+// true = arrived (Gali_MotMove's own answer: issued once, then done when the encoder is in range).
+bool Z1Move(int pos)
+{
+    if (AxisOff(MTestZ1)) return true;
+    s_z1Busy = true;
+    const bool done = g_W906DryRunZ1Move ? g_W906DryRunZ1Move(pos, Z1Speed())
+                                         : MOT[MTestZ1].Gali_MotMove(pos, Z1Speed(), "W906_Ht9050DryRun");
+    if (done) s_z1Busy = false;
+    return done;
+}
+void Z1Stop()
+{
+    if (!s_z1Busy || AxisOff(MTestZ1)) return;
+    if (g_W906DryRunZ1Stop) g_W906DryRunZ1Stop(); else MOT[MTestZ1].Gali_Command("ST", "W906_Ht9050DryRun");
+    s_z1Busy = false;
+    Z1Rearm();
+}
+// Index Z1 up to its home (0, the HT9050 home position, myGALILmotor.cpp AI(W906-HT9050-HOMEPOS0)) and "at home" by the dry run's rule.
