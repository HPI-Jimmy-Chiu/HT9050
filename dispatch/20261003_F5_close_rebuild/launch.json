      //   而 page/theme.js:10-12 在沒有 query string 時預設 MODE='release'。
      //   ⇒ F5 開出來的頁面，**整組操作按鈕（含 START / PAUSE）是隱藏的**。
      //   使用者是手動在網址列補 ?mode=debug 才看得到那些鈕的。
      //   background.html:362-368 的 withMode() 會把 mode 傳播給每個 iframe，
      //   所以只要進入點帶了，子頁全部都會帶。
      "serverReadyAction": {
        "pattern": "http://127\\.0\\.0\\.1:([0-9]+)/",
        "uriFormat": "http://127.0.0.1:%s/background.html?mode=debug",
        "action": "openExternally"
      }
    },
    {
      // AI(W906-FW-C1WIRE) 20260911: the browser for the entry above. Lands on
