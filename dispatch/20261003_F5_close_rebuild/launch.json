      //   V906_BUILD_DIR. Change one without the other and WB_F5Contract fails.
      "preLaunchTask": "V906: Build wb_serve DEBUG (-g, build_dbg)",
      "program": "${workspaceFolder}/build_dbg/wb_serve.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "${workspaceFolder}/../install/mingw32-16.2.0/mingw32/bin/gdb.exe",
      "externalConsole": false,
