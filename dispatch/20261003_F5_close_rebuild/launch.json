      // wb_serve is the SINGLE-PROCESS shape: god-stack + HTTP/WS server in one
      // exe, no loopback hop. It does not pump yet (grep -c Pump tools/wb_serve.cpp
      // = 0), and it calls LoadMachineConfig unconditionally at :90 -- which SEEDS
      // KEYS INTO THE SHARED PRODUCTION system\Gerneral.ini. Left here because it
      // is the shape the architecture doc recommends, but do not run it casually.
      "name": "Web HMI: wb_serve (single process -- WRITES production ini, see comment)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/wb_serve.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "${workspaceFolder}/../install/mingw32-16.2.0/mingw32/bin/gdb.exe",
      "setupCommands": [
        {
          "description": "Pretty-print STL containers",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          // AI(W906-DBG-PRINTERS) 20260922: see the sibling config below.
          "description": "Load HT9045 pretty-printers (AnsiString / TStringList)",
          "text": "source ${workspaceFolder}/.vscode/ht9045_printers.py",
          "ignoreFailures": true
        }
      ],
      "externalConsole": false
    },
    {
      // AI(W906-FW2-WEBSYNC) 20260911: opens the HAND-BUILT HT9050 HMI.
      //
      // No new process and no new server. wb_gateway.cpp:64 already hardcodes
      // "D:\HT9045\web" as its document root, and websync now mirrors the
      // HT9050 HMI into exactly that directory -- so the gateway already in
      // the compound serves background.html with zero code change. Measured
      // 20260911 by starting the gateway and fetching: background.html 200 /
      // 48,136 bytes, page/HW.MotorTest.html 200 / 106,317, and
      // JSON/Machine-profile.json 200 / 3,333. Byte counts match the source.
      //
      // WHY http AND NOT file://. HT9045_Debug.cmd in the source tree opens
      // file:///D:/HT9045/debug.html, which does not exist and never did at
      // that path. Over http, dialog-bridge.js takes its fetch() branch and
      // reads JSON/<name>.json directly; the file: branch instead loads the
      // JSON/js/*.js JSONP shims, a second copy of the same data that only
      // stays correct while one generator writes both. Serving over http uses
      // the single-copy path.
      //
      // If the browser does not open, the run still works: the gateway prints
      // its URL and any browser can be pointed at it. Nothing about the C++
      // side depends on this entry.
      "name": "Web HMI: browser at background.html (HT9050 HMI)",
      "type": "msedge",
      "request": "launch",
      "url": "http://127.0.0.1:8045/background.html",
      "webRoot": "${workspaceFolder}/../web",
      "presentation": { "order": 4 }
    },
    {
      // AI(W906-FW-C1WIRE) 20260911: the recipe editor. ONE process, because a
