          // so you had to expand szDir.data_._M_dataplus._M_p by hand.
          // Needs BOTH this line and "-enable-pretty-printing" above it, and a
          // Python-enabled gdb: miDebuggerPath (mingw32-16.2.0, gdb 17.2) has
          // Python; C:/MinGW's gdb 7.6.1 does NOT, hence ignoreFailures.
          "description": "Load HT9045 pretty-printers (AnsiString / TStringList)",
          "text": "source ${workspaceFolder}/.vscode/ht9045_printers.py",
          "ignoreFailures": true
        }
      ],
      // AI(W906-BA0) 20260911: open the browser only AFTER the server says it
      // is listening. wb_serve prints "  http://127.0.0.1:<port>/?src=ws" once
      // the listener is bound, so this pattern fires at the right moment and
      // carries the real port through -- which matters because --port can move
      // it. Launching a browser config in parallel instead raced the server and
      // produced a connection error on a cold start.
      //
      // background.html rather than /?src=ws: that query string selects the FW
