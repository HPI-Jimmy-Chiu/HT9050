      //
      //   THE MEASUREMENT, NOT THE THEORY. build\ is configured with an EMPTY
      //   CMAKE_BUILD_TYPE, so build/CMakeFiles/wb_serve.dir/flags.make reads
      //   exactly "CXX_FLAGS = -std=c++1z". No -g anywhere. Confirmed at the
