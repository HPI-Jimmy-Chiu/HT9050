      "name": "Web HMI: browser at background.html (recipe-capable)",
      "type": "msedge",
      "request": "launch",
      "url": "http://127.0.0.1:8045/background.html",
      "webRoot": "${workspaceFolder}/../web",
      "presentation": { "order": 5 }
    },
    {
