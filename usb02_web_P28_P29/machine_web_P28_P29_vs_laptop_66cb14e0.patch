diff --git a/web/page/HW.IoSetView.html b/web/page/HW.IoSetView.html
index 4bc66d7..a606b8b 100644
--- a/web/page/HW.IoSetView.html
+++ b/web/page/HW.IoSetView.html
@@ -51,8 +51,8 @@
   .lledCap{line-height:1.3;}
   .io-on{box-shadow:0 0 0 1px #228b22 inset,0 0 6px rgba(34,139,34,.45);}
   .io-off{box-shadow:0 0 0 1px #b22222 inset,0 0 6px rgba(178,34,34,.35);}
-  .aled.io-on{background-color:#1e6fff !important;border-color:#228b22 !important;box-shadow:0 0 0 2px #228b22 inset,0 0 6px rgba(34,139,34,.55);}   /* 觸發 = 綠框、中間藍 */  /* AI(W906-IOLAMP) 20260925 P22: Jimmy 20260925 裁決 A：與機台 IOWEB-P22（360e223）一致。使用者原話：「sensor一開始沒有被觸發時 是原來的圖示(外框紅中間灰) 當被觸發時 請用外框綠 中間藍」。按鈕 .btnpanel 仍用自己的 golden 顏色（--bp-true／--bp-false）；底層 .io-on／.io-off 只畫邊框（ioPaintElement 會替 215 個標籤框 .lled 也加 class，填色會把整個框塗滿）。 */
-  .aled.io-off{box-shadow:0 0 0 1px #b22222 inset,0 0 6px rgba(178,34,34,.35);}   /* 沒觸發 = 原來的圖示（紅框、中間是燈原本的顏色：1379 顆灰、10 顆紅）；刻意不設 background-color */
+  .aled.io-on{background-color:#1e6fff !important;background-image:radial-gradient(ellipse at 50% 45%,#e8f4ff 0%,#8cc4ff 25%,#3a8cff 55%,#1e6fff 80%,#1552c8 100%) !important;border-color:#228b22 !important;box-shadow:0 0 0 2px #228b22 inset;}   /* 使用者 20260925：觸發 = 綠框、中間藍、像燈亮起來 —— 效果只在框內（不要占用框外，取消外圈光暈） */
