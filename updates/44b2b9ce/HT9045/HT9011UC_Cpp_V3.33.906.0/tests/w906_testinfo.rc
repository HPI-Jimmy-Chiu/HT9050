// AI(W906-AVFP) 20261005 (laptop; Jimmy 1005 12:1x "can we avoid it being mistaken for a Trojan"): a VERSIONINFO resource for the
// test executables F-Secure flags. F-Secure's generic detection Trojan.TR/W32.Evo quarantined test_cJSON.exe three times (event 25:
// 1004 08:23, 1004 21:37, 1005 11:31; accessor ld.exe) and then blocked every relink. A small static MinGW console exe with no
// version information is what that detection likes; with this resource linked in, the same objects are no longer deleted
// (laptop 1005 12:2x, scratch: the no-resource control was deleted at link time, the VERSIONINFO build stayed and ran 14 / 14).
// The scanner is not touched (its settings belong to IT). Used from tests/CMakeLists.txt (target_sources on the flagged targets).
#include <winver.h>

1 VERSIONINFO
FILEVERSION 3,33,906,0
PRODUCTVERSION 3,33,906,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "HONPREC RD5"
      VALUE "FileDescription", "HT9045 V906 C++ port - unit test"
      VALUE "FileVersion", "3.33.906.0"
      VALUE "InternalName", "ht9045_v906_test"
      VALUE "LegalCopyright", "HONPREC"
      VALUE "OriginalFilename", "ht9045_v906_test.exe"
      VALUE "ProductName", "HT9045 V906 tests"
      VALUE "ProductVersion", "3.33.906.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
