{
  // ==========================================================================
  //  V906 build tasks. AI(W906-GateA-vscode) 20260804.
  //
  //  Every task delegates to build.bat -- there is exactly ONE definition of
  //  each toolchain's rules, and it is not duplicated here. The value this
  //  file adds is the problemMatcher: compiler errors land in the Problems
  //  panel as clickable file:line entries instead of scrolling past in a
  //  parallel build's output.
  //
  //  WHICH TASK MAKES THE .exe?  AI(W906-DropMSVC) 20260817: this used to say
  //  "V906: Build UI exe (MSVC/MFC)", and that MinGW could not build an exe at
  //  all. Both are now false -- MSVC and the MFC UI are gone, and the MinGW
  //  build already produces build\wb_serve.exe, wb_publish.exe and
  //  wb_gateway.exe. The four MSVC tasks were removed with them.
  //
  //  ------------------------------------------------------------------------
  //  WHY THE COMMANDS ARE ABSOLUTE PATHS AND THE SHELL IS PINNED TO cmd.exe
  //  AI(W906-GateA-fix) 20260804: every task in this file used to be
  //  "command": "build.bat <mode>" with a cwd, and every single one failed
  //  instantly with:
  //      build.bat : The term 'build.bat' is not recognized ...
  //      CategoryInfo : ObjectNotFound: (build.bat:String) []
  //  Two independent reasons, both fixed below:
  //
  //   1. THE SHELL WAS PowerShell, NOT cmd.exe. PowerShell deliberately never
  //      resolves a bare command name from the current directory (it has no
  //      "." in its lookup), so a cwd does not help -- only ".\build.bat" or
  //      an absolute path runs. This folder's settings.json does ask for the
  //      "Command Prompt" profile, but "terminal.integrated.defaultProfile.
  //      windows" is a WINDOW-scoped setting, and window-scoped settings in a
  //      FOLDER's settings.json are silently ignored inside a multi-root
  //      workspace (HT9045.code-workspace). So the port's tasks inherited the
  //      repo root's PowerShell profile. Pinning options.shell here does not
  //      depend on any profile resolution at all.
  //   2. Even under cmd.exe, current-directory command resolution is not
  //      guaranteed: if NoDefaultCurrentDirectoryInExePath is set in the
  //      environment, cmd.exe refuses to run "build.bat" from the cwd too.
  //      An absolute ${workspaceFolder} path is immune to both.
  //
  //  cmd.exe is also the shell build.bat itself documents ("run it from
  //  cmd.exe, not PowerShell") and the one whose exit code propagates cleanly,
  //  which matters because launch.json gates F5 on the build task succeeding.
  //  ------------------------------------------------------------------------
  "version": "2.0.0",

  // Inherited by every task below; a task may still override it.
  "options": {
    "cwd": "${workspaceFolder}",
    "shell": {
      "executable": "cmd.exe",
      "args": ["/d", "/c"]
    }
  },

  "tasks": [
    {
      // AI(W906-IOWEB-F5) 20260925: THIS MACHINE's F5 build (the real HT9045/HT9050
      // controller with the PCIE-1203). The two V906 tasks below build with
      // build.bat = C:\MinGW 6.3.0 into build\ / build_dbg\ in SIMULATION config
      // (W906_NO_SOFT_SIMULTE defaults OFF). This one builds the SHIPPING config
      // with the field-proven WinLibs i686 16.2 toolchain (C++14, -static) into
      // build_integ_ship_x86 -- the dir already configured and verified on
      // 20260924 (ctest 157/166, 9 = environment/pre-existing, see
      // ../REPORT_IOWEB_20260924.md). Incremental: a few seconds when nothing changed.
      "label": "IOWEB(這台): build wb_serve（出貨組態, WinLibs 32-bit）",
      "detail": "cmake --build build_integ_ship_x86 --target wb_serve  (-DW906_NO_SOFT_SIMULTE=ON, C++14, -static)",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "${workspaceFolder}/build_integ_ship_x86", "--target", "wb_serve", "-j", "${env:NUMBER_OF_PROCESSORS}"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "PATH": "${env:LOCALAPPDATA}\\Programs\\ht9045-nonoracle-toolchain\\mingw32\\bin;${env:PATH}" }
      },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": {
        "owner": "cpp",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.*?):(\\d+):(\\d+):\\s+(warning|error|note|fatal error):\\s+(.*)$",
          "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5
        }
      }
    },
    {
      // AI(W906-IOWEB-F5) 20260925: same, with -g (CMAKE_BUILD_TYPE=Debug) into
      // build_integ_dbg_x86, so breakpoints bind. Separate dir on purpose: the
      // fast F5 above stays fast, and neither touches build\ or build_dbg\.
      "label": "IOWEB(這台): build wb_serve DEBUG（-g, 出貨組態）",
      "detail": "cmake --build build_integ_dbg_x86 --target wb_serve  (Debug = -g, shipping config)",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "${workspaceFolder}/build_integ_dbg_x86", "--target", "wb_serve", "-j", "${env:NUMBER_OF_PROCESSORS}"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "PATH": "${env:LOCALAPPDATA}\\Programs\\ht9045-nonoracle-toolchain\\mingw32\\bin;${env:PATH}" }
      },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": {
        "owner": "cpp",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.*?):(\\d+):(\\d+):\\s+(warning|error|note|fatal error):\\s+(.*)$",
          "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5
        }
      }
    },
    {
      // AI(W906-ZEROARG) 20260918: the F5 build. Only wb_serve.
      //
      // The task below builds the default `all` target: the libraries, ~60
      // test exes, and all three product exes. F5 launches exactly one of
      // them. Measured: no ctest depends on any of the three exes, and under
      // the 20260918 one-executable ruling wb_publish and wb_gateway have no
      // consumer -- so F5 was paying for the gate's build to open a web page.
      //
      // Kept as a SEPARATE task rather than changing the one below, because
      // "Debug one ctest binary" and the retired sidecar compound genuinely
      // need what the full build produces. Narrowing the shared task would
      // have handed those two a stale binary without saying so.
      //
      // Ctrl+Shift+B still runs the FULL build -- isDefault stays on the task
      // below, because "did it still compile" should mean the whole tree.
      "label": "V906: Build wb_serve only (MinGW)",
      "detail": "build.bat serve -- libs + wb_serve.exe only, no test exes. Used by the F5 compound.",
      "type": "shell",
      "command": "${workspaceFolder}\\build.bat",
      "args": ["serve"],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": {
        "owner": "cpp",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.*?):(\\d+):(\\d+):\\s+(warning|error|note|fatal error):\\s+(.*)$",
          "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5
        }
      }
    },
    {
      // AI(W906-F5DBG) 20260921: THE F5 build. Same as the task above in every
      // way except WHERE it builds -- and that one difference is the whole point.
      //
      //  WHY THIS EXISTS. build\ is configured with an EMPTY CMAKE_BUILD_TYPE,
      //  so its CXX_FLAGS are just "-std=c++1z" -- no -g, no line table. Measured
      //  20260921: `objdump -h build/CMakeFiles/wb_serve.dir/WebStart.cpp.obj`
      //  finds ZERO .debug_info sections. A breakpoint inside
      //  TfMainWeb::StartFromWeb therefore cannot bind, and gdb silently runs
      //  straight past it. That is what the user hit: "我在裡面攔中斷也沒有反應".
      //  It was never a wrong breakpoint -- there was nothing to bind to.
      //
      //  WHY NOT JUST ADD -g TO build\. Because build\ is the MEASUREMENT dir:
      //  every recorded baseline, every gate number and every byte-comparison in
      //  docs/ was taken there. Changing its flags invalidates all of them at
      //  once. launch.json has said "keep build\ byte-comparable with every
      //  recorded baseline" since 20260817; this task is how we obey that and
      //  still get breakpoints.
      //
      //  WHY IT STILL GOES THROUGH build.bat, AND MUST. There is exactly ONE
      //  definition of the toolchain rules and it lives in build.bat -- the FATAL
      //  MinGW guard, the tee/log handling, the ccache reset, the error summary.
      //  A task that called cmake directly would fork that. tools/webprobe/
      //  f5_contract_probe.cjs asserts `task.command === '${workspaceFolder}\\build.bat'`
      //  for exactly this reason, and that assertion is untouched.
      //
      //  HOW IT REDIRECTS WITHOUT EDITING build.bat: the V906_BUILD_DIR and
      //  V906_CMAKE_ARGS environment knobs (build.bat:55 / :139, added
      //  20260921 by the FASTBUILD work). V906_BUILD_DIR also gives this build
      //  its OWN log at build_dbg\build_last.log (build.bat:163), so an F5 build
      //  can no longer clobber the everyday build\ log.
      //
      //  ⚠ V906_CMAKE_ARGS is consulted ONLY on a dir's FIRST configure
      //  (build.bat:135 takes the else-branch once CMakeCache.txt exists). It is
      //  passed here so that deleting build_dbg and starting over still yields a
      //  Debug dir -- not because the existing cache needs it. If you ever see
      //  breakpoints stop binding again, check build_dbg\CMakeCache.txt really
      //  says CMAKE_BUILD_TYPE:STRING=Debug before touching anything else.
      //
      //  ⚠ Codegen is NOT changed by this. Debug means -g only; GCC defaults to
      //  -O0 and build\ has no -O flag either, so the machine code matches.
      //  Do NOT "improve" this to RelWithDebInfo -- but for the STEPPING reason,
      //  not the old one: -O3 inlines and reorders until line-stepping lands on
      //  the wrong statements, which defeats the entire point of this task.
      //  ⓘ The claim that -O3 "breaks MyPLCModbus and BarCodeBottom2DID" was
      //  RETRACTED in CMakeLists.txt:391-406 on 20260817 -- a fresh
      //  -DCMAKE_BUILD_TYPE=Release dir re-ran both, 2/2 Passed. Do not repeat
      //  it as a reason to avoid Release; re-measure instead.
      "label": "V906: Build wb_serve DEBUG (-g, build_dbg)",
      "detail": "build.bat serve into build_dbg\\ with -g. The ONLY build whose breakpoints bind. Used by THE F5.",
      "type": "shell",
      "command": "${workspaceFolder}\\build.bat",
      "args": ["serve"],
      "options": {
        // Repeated rather than inherited: a task's own "options" replaces the
        // file-level one wholesale, so dropping cwd/shell here would hand this
        // task back to PowerShell -- which cannot run a bare build.bat at all
        // (see this file's header for the full story).
        "cwd": "${workspaceFolder}",
        "shell": { "executable": "cmd.exe", "args": ["/d", "/c"] },
        "env": {
          "V906_BUILD_DIR": "build_dbg",
          "V906_CMAKE_ARGS": "-DCMAKE_BUILD_TYPE=Debug"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": {
        "owner": "cpp",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.*?):(\\d+):(\\d+):\\s+(warning|error|note|fatal error):\\s+(.*)$",
          "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5
        }
      }
    },
    {
      "label": "V906: Build (MinGW, quick)",
      // AI(W906-BA0) 20260911: the detail used to read "Incremental libs+tests.
      // NO exe." and that was FALSE -- it survived the 20260817 MSVC removal,
      // which is exactly when it stopped being true. build.bat with no args
      // runs `cmake --build build` with no --target, i.e. the default `all`
      // target, and wb_serve/wb_publish/wb_gateway are plain add_executable()
      // with no EXCLUDE_FROM_ALL (CMakeLists.txt:3002), so all three are in
      // `all`. Proof: a no-args run's build_last.log contains
      //     [ 60%] Built target wb_serve
      // and build.bat itself prints the three exe names when it finishes.
      // The header comment above (lines 14-17) already said this correctly;
      // this string was the one that disagreed, and it cost an F5 diagnosis
      // that chased a task defect that did not exist.
      "detail": "Incremental libs+tests AND wb_serve.exe. Default build task (Ctrl+Shift+B). AI(W906-T4-RETIRE) 20260919: said \"the three exes\" until wb_publish/wb_gateway were retired (plan 11.4 R2).",
      "type": "shell",
      "command": "${workspaceFolder}\\build.bat",
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      // g++ emits absolute paths here (verified), so anchor the matcher to them.
      "problemMatcher": {
        "owner": "cpp",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.*?):(\\d+):(\\d+):\\s+(warning|error|note|fatal error):\\s+(.*)$",
          "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5
        }
      }
    },
    {
      "label": "V906: Gate (MinGW build + ctest)",
      "detail": "The reportable gate. Baseline 2026-08-17: 127/133 pass; the 6 failures (config_db/IniFiles/ini_helpers/config_loaders/dfm2rc_idempotent/GA1_ReadGeneralIni) are environment drift, not regressions. Compare the LIST, never the count.",
      "type": "shell",
      "command": "${workspaceFolder}\\build.bat",
      "args": ["gate"],
      "group": "test",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": {
        "owner": "cpp",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.*?):(\\d+):(\\d+):\\s+(warning|error|note|fatal error):\\s+(.*)$",
          "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5
        }
      }
    },
    {
      "label": "V906: ctest only",
      "type": "shell",
      "command": "${workspaceFolder}\\build.bat",
      "args": ["test"],
      "group": "test",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "V906: Clean (MinGW build dir only)",
      "type": "shell",
      "command": "${workspaceFolder}\\build.bat",
      "args": ["clean"],
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    }
  ]
}
