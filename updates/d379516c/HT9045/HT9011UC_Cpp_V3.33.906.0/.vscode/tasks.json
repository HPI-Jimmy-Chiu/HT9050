      //
      // Kept as a SEPARATE task rather than changing the one below, because
      // "Debug one ctest binary" and the retired sidecar compound genuinely
      // need what the full build produces. Narrowing the shared task would
      // have handed those two a stale binary without saying so.
      //
      // Ctrl+Shift+B still runs the FULL build -- isDefault stays on the task
      // below, because "did it still compile" should mean the whole tree.
      "label": "V906: Build wb_serve only (MinGW)",
      "detail": "build.bat serve -- libs + wb_serve.exe only, no test exes. Used by the F5 compound.",
      "type": "shell",
      "command": "${workspaceFolder}\\build.bat",
      "args": ["serve"],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": {
        "owner": "cpp",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.*?):(\\d+):(\\d+):\\s+(warning|error|note|fatal error):\\s+(.*)$",
          "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5
        }
      }
    },
    {
      // AI(W906-F5DBG) 20260921: THE F5 build. Same as the task above in every
      // way except WHERE it builds -- and that one difference is the whole point.
      //
      //  WHY THIS EXISTS. build\ is configured with an EMPTY CMAKE_BUILD_TYPE,
      //  so its CXX_FLAGS are just "-std=c++1z" -- no -g, no line table. Measured
      //  20260921: `objdump -h build/CMakeFiles/wb_serve.dir/WebStart.cpp.obj`
      //  finds ZERO .debug_info sections. A breakpoint inside
      //  TfMainWeb::StartFromWeb therefore cannot bind, and gdb silently runs
      //  straight past it. That is what the user hit: "我在裡面攔中斷也沒有反應".
      //  It was never a wrong breakpoint -- there was nothing to bind to.
      //
      //  WHY NOT JUST ADD -g TO build\. Because build\ is the MEASUREMENT dir:
      //  every recorded baseline, every gate number and every byte-comparison in
      //  docs/ was taken there. Changing its flags invalidates all of them at
      //  once. launch.json has said "keep build\ byte-comparable with every
      //  recorded baseline" since 20260817; this task is how we obey that and
      //  still get breakpoints.
      //
      //  WHY IT STILL GOES THROUGH build.bat, AND MUST. There is exactly ONE
      //  definition of the toolchain rules and it lives in build.bat -- the FATAL
      //  MinGW guard, the tee/log handling, the ccache reset, the error summary.
      //  A task that called cmake directly would fork that. tools/webprobe/
      //  f5_contract_probe.cjs asserts `task.command === '${workspaceFolder}\\build.bat'`
      //  for exactly this reason, and that assertion is untouched.
      //
      //  HOW IT REDIRECTS WITHOUT EDITING build.bat: the V906_BUILD_DIR and
      //  V906_CMAKE_ARGS environment knobs (build.bat:55 / :139, added
      //  20260921 by the FASTBUILD work). V906_BUILD_DIR also gives this build
      //  its OWN log at build_dbg\build_last.log (build.bat:163), so an F5 build
      //  can no longer clobber the everyday build\ log.
      //
      //  ⚠ V906_CMAKE_ARGS is consulted ONLY on a dir's FIRST configure
      //  (build.bat:135 takes the else-branch once CMakeCache.txt exists). It is
      //  passed here so that deleting build_dbg and starting over still yields a
      //  Debug dir -- not because the existing cache needs it. If you ever see
      //  breakpoints stop binding again, check build_dbg\CMakeCache.txt really
      //  says CMAKE_BUILD_TYPE:STRING=Debug before touching anything else.
      //
      //  ⚠ Codegen is NOT changed by this. Debug means -g only; GCC defaults to
      //  -O0 and build\ has no -O flag either, so the machine code matches.
      //  Do NOT "improve" this to RelWithDebInfo -- but for the STEPPING reason,
      //  not the old one: -O3 inlines and reorders until line-stepping lands on
      //  the wrong statements, which defeats the entire point of this task.
      //  ⓘ The claim that -O3 "breaks MyPLCModbus and BarCodeBottom2DID" was
      //  RETRACTED in CMakeLists.txt:391-406 on 20260817 -- a fresh
      //  -DCMAKE_BUILD_TYPE=Release dir re-ran both, 2/2 Passed. Do not repeat
      //  it as a reason to avoid Release; re-measure instead.
      "label": "V906: Build wb_serve DEBUG (-g, build_dbg)",
      "detail": "build.bat serve into build_dbg\\ with -g. The ONLY build whose breakpoints bind. Used by THE F5.",
      "type": "shell",
      "command": "${workspaceFolder}\\build.bat",
      "args": ["serve"],
      "options": {
        // Repeated rather than inherited: a task's own "options" replaces the
        // file-level one wholesale, so dropping cwd/shell here would hand this
        // task back to PowerShell -- which cannot run a bare build.bat at all
        // (see this file's header for the full story).
        "cwd": "${workspaceFolder}",
        "shell": { "executable": "cmd.exe", "args": ["/d", "/c"] },
        "env": {
          "V906_BUILD_DIR": "build_dbg",
          "V906_CMAKE_ARGS": "-DCMAKE_BUILD_TYPE=Debug"
        }
      },
      // AI(W906-F5-ORDER) 20261003: + "focus": THE F5 now starts with this task (the sequence below), so its terminal is the
      //   first thing F5 shows -- "[build] Building ..." at once, no HMI window in front of it (Jimmy 1003 NB2「A (1)」).
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true, "focus": true },
      "problemMatcher": {
        "owner": "cpp",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.*?):(\\d+):(\\d+):\\s+(warning|error|note|fatal error):\\s+(.*)$",
          "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5
        }
      }
    },
    {
      // AI(W906-F5-HMI) 20261001: Jimmy 1001 15:2x「題2選甲」-- THE F5's first step, like the IOWEB entries' wait page, but
      //   for THE F5's port and screen: boot_wait.html polls 8045 and then opens background.html?mode=debug (the W906-OPBTN
      //   contract -- without mode=debug the START / PAUSE group is hidden). open_boot_wait.ps1 starts it in the HMI program
      //   window (ht9045_hmi.exe, built once into <tree>\build_hmi_shell\ when missing or older than its source) and only
      //   falls back to the default browser when that window cannot be built.
      // AI(W906-F5-ORDER) 20261003: now THE F5's SECOND step (after the build, sequence below); built=1 makes boot_wait.html
