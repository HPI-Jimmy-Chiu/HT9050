      "symbol": "SimGpibDriver::ibrd",
      "kind": "complete selected cpp function text",
      "text": "int SimGpibDriver::ibrd(int, void* buf, long cnt)\n{\n    cnt_ = 0;\n    if (!in_.empty() && cnt > 0)\n    {\n        std::string s = in_.front();\n        in_.pop_front();\n        long n = (long)s.size() < cnt ? (long)s.size() : cnt;\n        std::memcpy(buf, s.data(), (size_t)n);\n        cnt_ = n;\n    }\n    Recompute();\n    sta_ |= END;\n    return sta_;\n}",
      "sha256_utf8": "c86a55e619a5b8a4c79d667ed49702be58405f91c2e9307701dce6fc9db111a6"
    },
