      "symbol": "SimGpibDriver::ibwrt",
      "kind": "complete selected cpp function text",
      "text": "int SimGpibDriver::ibwrt(int, const void* buf, long cnt)\n{\n    if (!talk_)\n    {\n        err_ = 6;   // EABO-like: not addressed to talk\n        sta_ = ERR | TIMO;\n        cnt_ = 0;\n        return sta_;\n    }\n    out_.push_back(std::string(static_cast<const char*>(buf), static_cast<size_t>(cnt)));\n    cnt_ = cnt;\n    err_ = 0;\n    Recompute();\n    return sta_;\n}",
      "sha256_utf8": "81d8affcafa298ffd842614f744f01b76daadedd5f344319d641cb106d4ce533"
    },
