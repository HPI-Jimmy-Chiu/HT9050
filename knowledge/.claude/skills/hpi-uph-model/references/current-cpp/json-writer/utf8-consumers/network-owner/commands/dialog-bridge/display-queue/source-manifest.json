    {
      "symbol": "alreadySeen",
      "path": "web/page/dialog-bridge.js",
      "signature": "function alreadySeen(id)",
      "start_offset": 18236,
      "end_offset": 18486,
      "text": "function alreadySeen(id) {\n    if (!id) return false;                       // 沒有 requestId 就不去重，寧可重複也不要漏\n    if (seenIds.indexOf(id) >= 0) return true;\n    seenIds.push(id);\n    if (seenIds.length > SEEN_MAX) seenIds.shift();\n    return false;\n  }\n\n",
      "sha256": "73b6a1eb2d21c7ef58747b14f4578d5b448e46592b012245128319540f51653d",
