    {
      "symbol": "WebBridgeServer::Impl::Flush",
      "path": "HT9011UC_Cpp_V3.33.906.0/WebBridge/WebBridgeServer.cpp",
      "start_offset": 36045,
      "function_start_offset": 36045,
      "end_offset": 36509,
      "text": "void WebBridgeServer::Impl::Flush(Conn& c)\n{\n    while (!c.out.empty()) {\n        const int n = send(c.s, c.out.data(), static_cast<int>(c.out.size()), 0);\n        if (n > 0) {\n            c.out.erase(0, static_cast<size_t>(n));\n            continue;\n        }\n        const int e = WSAGetLastError();\n        if (e == WSAEWOULDBLOCK) return;    // stays buffered; write-set retries\n        closesocket(c.s);\n        c.s = INVALID_SOCKET;\n        return;\n    }\n}\n\n",
      "sha256": "ca29dbab8e1ca4808b3d718547db019c8d1b59baf63aa09351069caa8d1050e5",
