      "symbol": "WebBridgeServer::Impl::ReceiveInto",
      "path": "HT9011UC_Cpp_V3.33.906.0/WebBridge/WebBridgeServer.cpp",
      "start_offset": 35223,
      "function_start_offset": 35223,
      "end_offset": 35949,
      "text": "bool WebBridgeServer::Impl::ReceiveInto(Conn& c)\n{\n    for (;;) {\n        char buf[kRecvChunk];\n        const int n = recv(c.s, buf, static_cast<int>(sizeof(buf)), 0);\n        if (n > 0) {\n            c.in.append(buf, static_cast<size_t>(n));\n            c.lastRecvMs = NowMs();\n            if (n < static_cast<int>(sizeof(buf))) break;\n            continue;\n        }\n        if (n == 0) return false;                        // peer closed\n        const int e = WSAGetLastError();\n        if (e == WSAEWOULDBLOCK) break;\n        return false;\n    }\n\n    if (!c.isWs) {\n        if (c.in.size() > kMaxHttpHead) return false;    // head never terminated\n        return ProcessHttpHead(c);\n    }\n    return ProcessWsBytes(c);\n}\n\n",
