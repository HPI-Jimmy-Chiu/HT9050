    {
      "symbol": "TruncateUtf8",
      "path": "HT9011UC_Cpp_V3.33.906.0/WebBridge/WsFrame.cpp",
      "start_offset": 5368,
      "end_offset": 5824,
      "text": "// Truncate to at most `limit` bytes without splitting a UTF-8 sequence -- a\n// close reason that ends mid-code-point is invalid UTF-8 and the peer is\n// entitled to treat it as a 1007 protocol error.\nstatic std::string TruncateUtf8(const std::string& s, std::size_t limit) {\n    if (s.size() <= limit) return s;\n    std::size_t cut = limit;\n    while (cut > 0 && (static_cast<unsigned char>(s[cut]) & 0xC0) == 0x80) --cut;\n    return s.substr(0, cut);\n}\n\n",
      "sha256": "5036b7f7dbb6894d0860b5bf942cc37eaaedb67b3b0cfbed40c9838c85167a10",
      "original_lines": 7,
      "completion_credit": 1,
