      "symbol": "EncodePing",
      "path": "HT9011UC_Cpp_V3.33.906.0/WebBridge/WsFrame.cpp",
      "start_offset": 4780,
      "end_offset": 5158,
      "text": "std::string EncodePing(const std::string& payload) {\n    // Control frames carry at most 125 bytes and are never fragmented\n    // (RFC 6455 section 5.5), so an over-long ping payload is clamped rather\n    // than split.\n    std::string p = payload;\n    if (p.size() > kWsMaxControlPayload) p.resize(kWsMaxControlPayload);\n    return EncodeFrame(kWsPing, p, true, false, 0);\n}\n\n",
      "sha256": "a2c4a7f1790c2100873e8f09fb0cc9b5e35ec2022d4cbf0187edf30ef658c81c",
