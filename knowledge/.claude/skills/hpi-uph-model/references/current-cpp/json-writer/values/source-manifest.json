      "path": "HT9011UC_Cpp_V3.33.906.0/WebBridge/JsonWriter.cpp",
      "blob": "a6369df929aba32d3f59d294f14577afec95f467",
      "name": "JsonQuote",
      "signature": "std::string JsonQuote(const std::string& raw) {",
      "start_offset": 5020,
      "end_offset": 6294,
      "text": "std::string JsonQuote(const std::string& raw) {\n    const std::string s = SanitizeToUtf8(raw);\n    std::string out;\n    out.reserve(s.size() + 2);\n    out.push_back('\"');\n    for (std::size_t i = 0; i < s.size(); ++i) {\n        const unsigned char c = static_cast<unsigned char>(s[i]);\n        switch (c) {\n            case '\"':  out.append(\"\\\\\\\"\");  break;\n            case '\\\\': out.append(\"\\\\\\\\\");  break;\n            case '\\b': out.append(\"\\\\b\");   break;\n            case '\\f': out.append(\"\\\\f\");   break;\n            case '\\n': out.append(\"\\\\n\");   break;\n            case '\\r': out.append(\"\\\\r\");   break;\n            case '\\t': out.append(\"\\\\t\");   break;\n            default:\n                if (c < 0x20u) {\n                    // Remaining C0 controls -- RFC 8259 forbids them raw.\n                    static const char kHex[] = \"0123456789abcdef\";\n                    out.append(\"\\\\u00\");\n                    out.push_back(kHex[(c >> 4) & 0x0F]);\n                    out.push_back(kHex[c & 0x0F]);\n                } else {\n                    // >= 0x80 bytes are already known-valid UTF-8 at this point.\n                    out.push_back(static_cast<char>(c));\n                }\n                break;\n        }\n    }\n    out.push_back('\"');\n    return out;\n}\n\n",
      "sha256": "4f31f93c90842dddc0ee4cc0af2f33da5068c56a40df1f2bb4482539ade96ce6",
